// P9 标准库示例 — 演示所有 std 模块的用法

// 按需免import 设计：命名空间函数需要 import
import aura.io.*
import aura.math.*
import aura.string.*
import aura.collections.*
import aura.json.*
import aura.time.*
import aura.test.*
import aura.builtin.*
import aura.env.*
import aura.random.*
import aura.encoding.*
import aura.ascii.*
import aura.path.*
import aura.iter.*
import aura.net.*

// ════════════════════════════════════════════════════════════
// std.io — 标准输入输出
// ════════════════════════════════════════════════════════════
println("Hello from Aura std.io!")
print("Hello from Aura std.io (no newline)")
aura.io.println("print with newline via aura.io.println")

// ════════════════════════════════════════════════════════════
// std.math — 数学函数
// ════════════════════════════════════════════════════════════
println("aura.math.abs(-42) = " + aura.math.abs(-42).toString())
println("aura.math.min(3, 5) = " + aura.math.min(3, 5).toString())
println("aura.math.max(3, 5) = " + aura.math.max(3, 5).toString())
println("aura.math.sqrt(16) = " + aura.math.sqrt(16.0).toString())
println("aura.math.pow(2, 10) = " + aura.math.pow(2.0, 10.0).toString())
println("aura.math.PI = " + aura.math.PI().toString())
println("aura.math.sin(0) = " + aura.math.sin(0.0).toString())

// ════════════════════════════════════════════════════════════
// std.string — 字符串操作
// ════════════════════════════════════════════════════════════
val s = "Hello, Aura World!"
println("s.toUpperCase() = " + s.toUpperCase())
println("s.toLowerCase() = " + s.toLowerCase())
println("s.length() = " + s.length().toString())
println("s.trim() = " + "  hello  ".trim())
println("s.split(' ') = " + s.split(" ").join(", "))

// ════════════════════════════════════════════════════════════
// std.collections — 集合构造
// ════════════════════════════════════════════════════════════
val list = listOf(1, 2, 3, 4, 5)
val map = mapOf("name", "Aura", "version", 1)
val set = setOf(1, 2, 2, 3, 3, 3)

// ════════════════════════════════════════════════════════════
// std.json — JSON 解析与序列化
// ════════════════════════════════════════════════════════════
val jsonStr = "{\"name\": \"Aura\", \"version\": 1}"
val parsed = aura.json.parse(jsonStr)
println("JSON valid: " + aura.json.isValid(jsonStr).toString())

// ════════════════════════════════════════════════════════════
// std.time — 时间/日期
// ════════════════════════════════════════════════════════════
val now = aura.time.now()
println("Current timestamp: " + now.toString())
println("Epoch date: " + aura.time.toDateString(0))

// ════════════════════════════════════════════════════════════
// std.test — 测试断言
// ════════════════════════════════════════════════════════════
aura.test.assertTrue(true, "This should pass")
aura.test.assertEq(42, 42, "Numbers are equal")
aura.test.assertNotNull(1, "Value is not null")

// ════════════════════════════════════════════════════════════
// std.builtin — 编译期内建
// ════════════════════════════════════════════════════════════
val x = 42
println("typeof(42) = " + aura.builtin.typeof(x).toString())
println("aura.builtin.toInt(3.14) = " + aura.builtin.toInt(3.14).toString())

// ════════════════════════════════════════════════════════════
// std.env — 环境变量
// ════════════════════════════════════════════════════════════
println("Platform: " + aura.env.platform())
println("Home: " + aura.env.home())
println("Temp: " + aura.env.tmp())

// ════════════════════════════════════════════════════════════
// std.random — 随机数
// ════════════════════════════════════════════════════════════
val rand1 = aura.random.nextIntRange(1, 100)
val rand2 = aura.random.nextFloat()
println("Random int: " + rand1.toString())
println("Random float: " + rand2.toString())

// ════════════════════════════════════════════════════════════
// std.encoding — 编码/解码
// ════════════════════════════════════════════════════════════
val encoded = aura.encoding.base64Encode("Hello Aura")
val decoded = aura.encoding.base64Decode(encoded)
println("Base64 roundtrip: " + decoded)

// ════════════════════════════════════════════════════════════
// std.ascii — 字符工具
// ════════════════════════════════════════════════════════════
println("isAlpha('A'): " + aura.ascii.isAlpha("A").toString())
println("isDigit('5'): " + aura.ascii.isDigit("5").toString())
println("isUpper('a'): " + aura.ascii.isUpper("a").toString())

// ════════════════════════════════════════════════════════════
// std.path — 路径操作
// ════════════════════════════════════════════════════════════
println("basename: " + aura.path.basename("dir/file.txt"))
println("extname: " + aura.path.extname("dir/file.txt"))

// ════════════════════════════════════════════════════════════
// std.iter — 迭代器工具
// ════════════════════════════════════════════════════════════
val nums = listOf(1, 2, 3, 4, 5)
println("sum: " + aura.iter.sum(nums).toString())
println("avg: " + aura.iter.avg(nums).toString())
println("min: " + aura.iter.min(nums).toString())
println("max: " + aura.iter.max(nums).toString())

// ════════════════════════════════════════════════════════════
// std.net — 网络信息
// ════════════════════════════════════════════════════════════
println("Hostname: " + aura.net.getHostname())
println("Local IP: " + aura.net.getLocalIp())
