// ════════════════════════════════════════════════════════════
// Select 多路复用演示 — Channel 多路复用与竞争
// ════════════════════════════════════════════════════════════

import aura.concurrent.*

fun main() {
    // ── 1. 第一通道就绪 ──
    val ch1 = aura.concurrent.newChannel(0)
    val ch2 = aura.concurrent.newChannel(0)
    aura.concurrent.channelSend(ch1, 100)
    val result1 = aura.concurrent.select(ch1, ch2)
    println("Select 第一通道: " + result1.toString())

    // ── 2. 第二通道就绪 ──
    val ch3 = aura.concurrent.newChannel(0)
    val ch4 = aura.concurrent.newChannel(0)
    aura.concurrent.channelSend(ch4, 200)
    val result2 = aura.concurrent.select(ch3, ch4)
    println("Select 第二通道: " + result2.toString())

    // ── 3. 多通道竞争 ──
    val ch5 = aura.concurrent.newChannel(0)
    val ch6 = aura.concurrent.newChannel(0)
    val ch7 = aura.concurrent.newChannel(0)
    aura.concurrent.channelSend(ch5, 10)
    aura.concurrent.channelSend(ch7, 30)
    val r1 = aura.concurrent.select(ch5, ch7)
    val r2 = aura.concurrent.select(ch6, ch7)
    println("多通道竞争: r1=" + r1.toString() + ", r2=" + r2.toString())

    // ── 4. 生产者/Select/消费者模式 ──
    val producer = aura.concurrent.newChannel(0)
    val consumer = aura.concurrent.newChannel(0)
    aura.concurrent.channelSend(producer, 500)
    val dispatched = aura.concurrent.select(producer, consumer)
    println("生产者/Select/消费者: " + dispatched.toString())

    // ── 5. Select + Actor 协作 ──
    val actor = aura.concurrent.spawnActor("Dispatcher")
    val inputCh = aura.concurrent.newChannel(0)
    aura.concurrent.channelSend(inputCh, 777)
    val msg = aura.concurrent.select(inputCh, inputCh)
    aura.concurrent.send(actor, msg)
    println("Select + Actor 协作: " + msg.toString())

    // ── 6. 空通道 Select ──
    val empty1 = aura.concurrent.newChannel(0)
    val empty2 = aura.concurrent.newChannel(0)
    val emptyResult = aura.concurrent.select(empty1, empty2)
    println("空通道 Select: " + emptyResult.toString())

    // ── 7. 连续 Select ──
    val seqCh = aura.concurrent.newChannel(0)
    aura.concurrent.channelSend(seqCh, 1)
    val seq1: Int = aura.concurrent.select(seqCh, seqCh)
    aura.concurrent.channelSend(seqCh, 2)
    val seq2: Int = aura.concurrent.select(seqCh, seqCh)
    aura.concurrent.channelSend(seqCh, 3)
    val seq3: Int = aura.concurrent.select(seqCh, seqCh)
    val seqSum = seq1 + seq2 + seq3
    println("连续 Select: " + seqSum.toString())
}
