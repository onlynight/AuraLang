// aura:///examples/concurrency/sync_primitives_demo.aura
// aura.lang.concurrent 同步原语演示（纯 Aura 实现，底层原子指令走 @native）
//
// 运行：aura run examples/concurrency/sync_primitives_demo.aura

import aura.lang.concurrent.Atomic
import aura.lang.concurrent.Mutex
import aura.lang.concurrent.RwLock
import aura.lang.concurrent.Condvar
import aura.lang.concurrent.Barrier
import aura.lang.concurrent.Semaphore

fun main(): Int {
    // ── Atomic ──
    val a = Atomic.new(10)
    Atomic.store(a, 20)
    Atomic.add(a, 5)
    val av = Atomic.load(a)
    println("Atomic: 20 + 5 = " + av)
    val swapped = Atomic.cas(a, 25, 99)
    println("Atomic.cas(25 -> 99) = " + swapped + ", now = " + Atomic.load(a))

    // ── Mutex ──
    val m = Mutex.new()
    Mutex.lock(m)
    println("Mutex: locked, tryLock = " + Mutex.tryLock(m))
    Mutex.unlock(m)
    println("Mutex: unlocked, tryLock = " + Mutex.tryLock(m))
    Mutex.unlock(m)

    // ── RwLock ──
    val rw = RwLock.new()
    RwLock.readLock(rw)
    RwLock.readLock(rw)
    RwLock.readUnlock(rw)
    RwLock.readUnlock(rw)
    RwLock.writeLock(rw)
    RwLock.writeUnlock(rw)
    println("RwLock: read/write ok")

    // ── Semaphore ──
    val sem = Semaphore.new(2)
    Semaphore.acquire(sem)
    println("Semaphore: after acquire count = " + Semaphore.count(sem))
    Semaphore.release(sem)
    println("Semaphore: after release count = " + Semaphore.count(sem))

    // ── Barrier（单参与者：立即放行）──
    val bar = Barrier.new(1)
    println("Barrier: wait returned " + Barrier.wait(bar))

    // ── Condvar（先 signal 再使用，避免无谓等待）──
    val cv = Condvar.new()
    val cm = Mutex.new()
    Mutex.lock(cm)
    Condvar.signal(cv)
    Mutex.unlock(cm)
    println("Condvar: signal ok")

    // 释放
    Atomic.destroy(a)
    Mutex.destroy(m)
    RwLock.destroy(rw)
    Semaphore.destroy(sem)
    Barrier.destroy(bar)
    Condvar.destroy(cv)
    Mutex.destroy(cm)
    println("done")
    return 0
}
