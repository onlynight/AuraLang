// P9 标准库示例 - 所有标准库函数无需 import，直接使用！

// ════════════════════════════════════════════════════════════
// 数学函数 std.math
// ════════════════════════════════════════════════════════════
val abs_val = aura.math.abs(-42)
val min_val = aura.math.min(3, 5)
val max_val = aura.math.max(3, 5)
val sqrt_val = aura.math.sqrt(16.0)
val pow_val = aura.math.pow(2.0, 10.0)
val pi = aura.math.PI()
val e = aura.math.E()

aura.io.println("math.abs(-42) = " + abs_val)
aura.io.println("math.min(3, 5) = " + min_val)
aura.io.println("math.max(3, 5) = " + max_val)
aura.io.println("math.sqrt(16.0) = " + sqrt_val)
aura.io.println("math.pow(2.0, 10.0) = " + pow_val)
aura.io.println("math.PI() = " + pi)
aura.io.println("math.E() = " + e)

// ════════════════════════════════════════════════════════════
// 字符串函数 std.string
// ════════════════════════════════════════════════════════════
val hello = "Hello, Aura!"
val upper = aura.string.toUpperCase(hello)
val lower = aura.string.toLowerCase(hello)
val contains = aura.string.contains(hello, "Aura")
val split_parts = aura.string.split(hello, ",")

aura.io.println("string.toUpperCase() = " + upper)
aura.io.println("string.toLowerCase() = " + lower)
aura.io.println("string.contains() = " + contains)
aura.io.println("string.split() = " + split_parts)

// ════════════════════════════════════════════════════════════
// 集合函数 std.collections
// ════════════════════════════════════════════════════════════
val list = aura.collections.listOf(1, 2, 3, 4, 5)
val map = aura.collections.mapOf("name", "Aura", "version", 1)

aura.io.println("collections.listOf() = " + list)
aura.io.println("collections.mapOf() = " + map)

// ════════════════════════════════════════════════════════════
// JSON 函数 std.json
// ════════════════════════════════════════════════════════════
val json_str = "{\"name\": \"Aura\", \"version\": 1}"
val parsed = aura.json.parse(json_str)
val valid = aura.json.isValid(json_str)

aura.io.println("json.parse() = " + parsed)
aura.io.println("json.isValid() = " + valid)

// ════════════════════════════════════════════════════════════
// 时间函数 std.time
// ════════════════════════════════════════════════════════════
val now = aura.time.now()
val date_str = aura.time.toDateString(0)

aura.io.println("time.now() = " + now)
aura.io.println("time.toDateString(0) = " + date_str)

// ════════════════════════════════════════════════════════════
// 内建函数 std.builtin
// ════════════════════════════════════════════════════════════
val type_of = aura.builtin.typeof(42)
val is_null = aura.builtin.isNull(null)

aura.io.println("builtin.typeof(42) = " + type_of)
aura.io.println("builtin.isNull(null) = " + is_null)

// ════════════════════════════════════════════════════════════
// 环境函数 std.env
// ════════════════════════════════════════════════════════════
val platform = aura.env.platform()
val os = aura.env.os()
val arch = aura.env.arch()

aura.io.println("env.platform() = " + platform)
aura.io.println("env.os() = " + os)
aura.io.println("env.arch() = " + arch)

// ════════════════════════════════════════════════════════════
// 随机数函数 std.random
// ════════════════════════════════════════════════════════════
val rand_int = aura.random.nextIntRange(1, 100)
val rand_float = aura.random.nextFloat()

aura.io.println("random.nextIntRange(1, 100) = " + rand_int)
aura.io.println("random.nextFloat() = " + rand_float)

// ════════════════════════════════════════════════════════════
// 编码函数 std.encoding
// ════════════════════════════════════════════════════════════
val encoded = aura.encoding.base64Encode("Hello")
val decoded = aura.encoding.base64Decode(encoded)

aura.io.println("encoding.base64Encode() = " + encoded)
aura.io.println("encoding.base64Decode() = " + decoded)

// ════════════════════════════════════════════════════════════
// ASCII 函数 std.ascii
// ════════════════════════════════════════════════════════════
val is_alpha = aura.ascii.isAlpha("A")
val is_digit = aura.ascii.isDigit("5")
val code = aura.ascii.codeAt("A", 0)

aura.io.println("ascii.isAlpha('A') = " + is_alpha)
aura.io.println("ascii.isDigit('5') = " + is_digit)
aura.io.println("ascii.codeAt('A', 0) = " + code)

// ════════════════════════════════════════════════════════════
// 路径函数 std.path
// ════════════════════════════════════════════════════════════
val joined = aura.path.join("dir", "file.txt")
val basename = aura.path.basename("dir/file.txt")
val extname = aura.path.extname("dir/file.txt")

aura.io.println("path.join() = " + joined)
aura.io.println("path.basename() = " + basename)
aura.io.println("path.extname() = " + extname)

// ════════════════════════════════════════════════════════════
// 迭代器函数 std.iter
// ════════════════════════════════════════════════════════════
val nums = aura.collections.listOf(1, 2, 3, 4, 5)
val sum = aura.iter.sum(nums)
val avg = aura.iter.avg(nums)
val min_iter = aura.iter.min(nums)
val max_iter = aura.iter.max(nums)

aura.io.println("iter.sum() = " + sum)
aura.io.println("iter.avg() = " + avg)
aura.io.println("iter.min() = " + min_iter)
aura.io.println("iter.max() = " + max_iter)

// ════════════════════════════════════════════════════════════
// 测试函数 std.test
// ════════════════════════════════════════════════════════════
val assert_result = aura.test.assertEq(42, 42)

aura.io.println("test.assertEq(42, 42) = " + assert_result)

// ════════════════════════════════════════════════════════════
// 控制台函数 std.console
// ════════════════════════════════════════════════════════════
val red_text = aura.console.red("Error")
val green_text = aura.console.green("Success")

aura.io.println("console.red() = " + red_text)
aura.io.println("console.green() = " + green_text)

// ════════════════════════════════════════════════════════════
// 断言函数 std.assert
// ════════════════════════════════════════════════════════════
val assert_true = aura.assert.assertTrue(true, "always true")

aura.io.println("assert.assertTrue() = " + assert_true)

aura.io.println("=== 标准库示例完成 ===")
