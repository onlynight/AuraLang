// 包管理器示例
// P14.4: 示例项目 — 包管理

// 模拟包元数据
struct PackageInfo {
    val name: String
    val version: String
    val description: String
    val author: String
}

val packages = mutableListOf<PackageInfo>(
    PackageInfo("aura-json", "1.2.3", "JSON 解析库", "Aura Team"),
    PackageInfo("aura-http", "2.0.0", "HTTP 客户端", "Aura Team"),
    PackageInfo("aura-raylib", "5.5.0", "Raylib 绑定", "Aura Team"),
    PackageInfo("my-utils", "0.1.0", "工具函数", "Developer")
)

fun installPackage(name: String, version: String) {
    println("  ✓ 安装 $name v$version")
}

fun publishPackage(info: PackageInfo) {
    println("  ✓ 发布 ${info.name} v${info.version} (${info.description})")
}

fun showDependencies() {
    println("┌──────────────────────────────────────┐")
    println("│         依赖树                         │")
    println("├──────────────────────────────────────┤")
    for (pkg in packages) {
        println("│  ${pkg.name.padEnd(16)} v${pkg.version.padEnd(8)} │")
    }
    println("└──────────────────────────────────────┘")
}

fun main() {
    println("=== Aura 包管理器示例 ===")
    println()
    
    // 创建新包
    println("1. 创建新包 (aura new)")
    println("  项目: my-project")
    println("  文件: aura.toml, main.aura, .gitignore")
    println("  ✓ 已创建新包项目")
    println()
    
    // 安装依赖
    println("2. 安装依赖 (aura install)")
    installPackage("aura-json", "1.2.3")
    installPackage("aura-http", "2.0.0")
    installPackage("aura-raylib", "5.5.0")
    println("  ✓ 已安装 3 个依赖")
    println()
    
    // 显示依赖树
    println("3. 显示依赖树 (aura deps)")
    showDependencies()
    println()
    
    // 更新依赖
    println("4. 更新依赖 (aura update)")
    println("  ✓ 更新 aura-json: 1.2.3 → 1.3.0")
    println("  ✓ 更新 aura-http: 2.0.0 → 2.1.0")
    println("  ✓ 更新 aura-raylib: 5.5.0 → 5.6.0")
    println("  ✓ 已更新 3 个依赖")
    println()
    
    // 发布包
    println("5. 发布包 (aura publish)")
    publishPackage(packages[3])
    println("  ✓ 发布完成")
    println()
    
    // 包清单
    println("6. 包清单 (aura.toml)")
    println("""
    {
        "name": "my-project",
        "version": "1.0.0",
        "description": "我的项目",
        "authors": ["Developer"],
        "license": "MIT",
        "entry": "main.aura",
        "dependencies": [
            { "name": "aura-json", "version": ">= 1.0" },
            { "name": "aura-http", "version": "== 2.0" }
        ]
    }
    """)
    println()
    
    println("完成!")
}