// demo_aot_direct/src/main.aura — Demo 3: AOT 直调
//
// 架构：
//   demo_aot_direct/src/main.aura ──load_shared_library──→ utils.dll (Aura AOT + --shared)
//      │                                                │
//      └── call_func(module_id, 0, [3,4]) ──→ aura_aot_add!2!2!2!2
//
// 构建命令：
//   1. loom build --member utils --aot --shared
//   2. loom build --member demo-aot-direct
//   3. loom run --member demo-aot-direct
//
// 与 Demo 1/2 的关键差异：
//   - 编译参数：--shared（不带 --cabi），导出 JitValue ABI
//   - 导出符号：aura_aot_add!2!2!2!2（带类型签名编码）
//   - 调用声明：不需要 extern "C"，运行时自动发现
//   - 类型系统：Aura 自动处理，无需手动映射到 C 类型
//   - 函数索引：运行时枚举（func_idx 由符号扫描确定）
//
// 验证标准：
//   - 加载成功，枚举到 2+ 个导出函数
//   - call_func(module_id, 0, [3, 4]) → 7
//   - call_func(module_id, 1, [3, 4]) → 12
//   - call_func(module_id, 2, [5]) → 120
//   - call_func(module_id, 3, [2, 10]) → 1024

fun main() = {
    // 通过 load_shared_library 加载 Aura AOT 编译的共享库
    // 产物路径：target/build/libs/utils/utils.dll（Windows）
    //           target/build/libs/utils/utils.so（Linux）
    //           target/build/libs/utils/utils.dylib（macOS）
    val module_id = load_shared_library("target/build/libs/utils/utils.dll")
    println("loaded module_id = " + toString(module_id))

    // 通过 call_func 调用函数（func_idx 由运行时符号枚举确定）
    // 实际导出顺序（来自 PE export table）：
    // func_idx=0: add, func_idx=1: factorial, func_idx=2: multiply, func_idx=3: power

    val sum = call_func(module_id, 0, listOf(3, 4))
    println("add(3, 4) = " + toString(sum))

    val fact = call_func(module_id, 1, listOf(5))
    println("factorial(5) = " + toString(fact))

    val prod = call_func(module_id, 2, listOf(3, 4))
    println("multiply(3, 4) = " + toString(prod))

    val pw = call_func(module_id, 3, listOf(2, 10))
    println("power(2, 10) = " + toString(pw))

    // 清理
    unload_shared_library(module_id)
}
