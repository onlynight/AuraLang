// demo_aot_direct/src/main.aura — Demo 3: AOT 直调（extern object + @aot + import）
//
// 架构：
//   utils_interface.aura ──extern object + @aot──→ utils.dll (Aura AOT + --shared)
//        ↑
//   main.aura ────import "utils_interface.aura"
//        │
//        └── Utils.add(3, 4) ──→ aura_aot_add!2!0!0!0
//
// 构建命令：
//   1. aura build libs/utils/src/lib.aura --aot --shared --output target/build/libs/utils/utils.dll
//   2. aura run demo_aot_direct/src/main.aura
//
// 验证标准：
//   - Utils.add(3, 4) = 7
//   - Utils.multiply(3, 4) = 12
//   - Utils.factorial(5) = 120
//   - Utils.power(2, 10) = 1024

// 从独立文件导入 extern object 声明
import "utils_interface.aura"

fun main() = {
    // 直接调用接口函数
    val sum = Utils.add(3, 4)
    println("add(3, 4) = " + toString(sum))

    val prod = Utils.multiply(3, 4)
    println("multiply(3, 4) = " + toString(prod))

    val fact = Utils.factorial(5)
    println("factorial(5) = " + toString(fact))

    val pw = Utils.power(2, 10)
    println("power(2, 10) = " + toString(pw))
}
