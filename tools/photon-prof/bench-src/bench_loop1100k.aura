// tools/photon-prof/bench-src/bench_loop1100k.aura
// P0-2b 验证载体：1.1M 次 Long 累加。
//   期望输出: loop acc = 1209997800000   (Σ(2i-1) = N²-2N, N=1,100,000)
//   理论堆用量 ≈ 68MB > 64MiB 默认静态 arena。
//   - 无 AURA_HEAP_MB  → [OOM] HEAP FULL + exit 70（P0-2a）
//   - AURA_HEAP_MB=128 → loop acc = 1209997800000（P0-2b 扩容生效）
fun main() {
    var i: Int = 0
    var acc: Long = 0
    while (i < 1100000) {
        acc = acc + (i * 2 - 1) as Long
        i = i + 1
    }
    println("loop acc = " + toStr(acc))
}
