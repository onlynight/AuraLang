      push: struct-literal-element
    - match: ','
      scope: punctuation.separator.struct-literal.boxlang
    - match: '[:=]'
      scope: punctuation.separator.key-value.boxlang
      push: expression-no-comma
    - match: (?=\S)
      push: expression-no-comma

  struct-literal-element:
    - match: '{{identifier}}(?=\s*(?:[},]|$|//|/\*))'
      scope: variable.other.readwrite.boxlang
      pop: true
    - match: (?=["'])
      set:
        - struct-literal-meta-key
        - string
    - match: (?=\S)
      set:
        - struct-literal-meta-key
        - struct-literal-key

  struct-literal-key:
    - include: string
    - match: '[_$[:alnum:]]+'
      pop: true
    - include: else-pop

  struct-literal-meta-key:
    - meta_include_prototype: false
    - meta_scope: meta.struct-literal.key.boxlang
    - include: else-pop

  method-name:
    - match: '{{identifier}}'
      scope: entity.name.function.boxlang
      pop: true
    - match: \'
      scope: punctuation.definition.string.begin.boxlang
      set:
        - meta_include_prototype: false
        - meta_scope: string.quoted.single.boxlang
        - meta_content_scope: entity.name.function.boxlang
        - match: \'
          scope: punctuation.definition.string.end.boxlang
          pop: true
    - match: \"
      scope: punctuation.definition.string.begin.boxlang
      set:
        - meta_include_prototype: false
        - meta_scope: string.quoted.double.boxlang
        - meta_content_scope: entity.name.function.boxlang
        - match: \"
          scope: punctuation.definition.string.end.boxlang
          pop: true
    - include: else-pop

  array-literal:
    - match: (?=\[)
      pop: true
      branch_point: array-or-ordered-struct
      branch:
        - array-literal-base
        - struct-literal-ordered

  array-literal-base:
    - match: '\['
      scope: punctuation.section.sequence.begin.boxlang
      set:
        - array-literal-contents
        - array-literal-maybe-struct

  array-literal-contents:
    - meta_scope: meta.sequence.boxlang
    - match: '\]'
      scope: punctuation.section.sequence.end.boxlang
      pop: true
    - include: expression-break
    - match: \,
      scope: punctuation.separator.sequence.boxlang
    - include: expressions-no-comma

  array-literal-maybe-struct:
    - match: (?={{property_name}}\s*(?:=(?!=)|:(?!:)))
      fail: array-or-ordered-struct
    - match: (?=:)
      fail: array-or-ordered-struct
    - match: (?=\S)
      pop: true

  property-declaration:
    - match: \b(property)\b
      scope: keyword.declaration.property.boxlang
      push:
        - meta_scope: meta.property.declaration.boxlang
        - match: \;
          scope: punctuation.terminator.statement.boxlang
          pop: true
        - match: '{{access_modifier}}'
          scope: storage.modifier.boxlang
        - match: '{{storage_modifier}}'
          scope: storage.modifier.boxlang
        - match: '{{storage_types}}'
          scope: storage.type.boxlang
        - match: '{{identifier}}'
          scope: variable.other.property.boxlang
        - match: '='
          scope: keyword.operator.assignment.boxlang
          push: expression
