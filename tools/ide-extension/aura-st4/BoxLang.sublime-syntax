%YAML 1.2
---

name: BoxLang
scope: source.boxlang
version: 2

file_extensions:
  - bx

variables:
  identifier: '[_$[:alpha:]][_$[:alnum:]]*'
  dot_path_identifier: '[_$[:alnum:]][_$[:alnum:].]*'
  constant_identifier: '[[:upper:]][_$[:digit:][:upper:]]*\b'
  reserved_word: |-
    (?x:
      break|case|catch|continue|default|do|else|finally|for|function|if|import|in|new|return|
      super|switch|this|try|var|void|while|null|true|false|class|interface|extends|implements|
      attempt|retry|transaction|lock|abort|throw|rethrow|include|property|component|abstract|
      final|static|public|private|package|remote|annotation|assert
    )\b

  boxlang_scope: \b(this|variables|thread|session|client|server|cgi|form|url|cookie|application|request|arguments|super)\b

  non_reserved_identifier: (?:(?!{{reserved_word}}){{identifier}})

  access_modifier: \b(private|package|public|remote)\b
  storage_modifier: \b(static|final|abstract)\b
  storage_types: \b(?:any|array|binary|boolean|component|date|guid|numeric|query|string|struct|xml|uuid|void)\b
  function_declaration_lookahead: |-
    (?x:
      ({{access_modifier}}\s+)?
      ({{storage_modifier}}\s+)?
      ({{dot_path_identifier}}(\[\])?\s+)?
      \bfunction\b
    )
  function_lookahead: \s*\bfunction\b
  arrow_func_lookahead: |-
    (?x:
      (?:
        {{identifier}}
        | \( ( [^()] | \( [^()]* \) )* \)
      )
      \s*
      =>
    )
  either_function_lookahead: (?:{{function_lookahead}}|{{arrow_func_lookahead}})
  function_assignment_lookahead: |-
    (?x:(?=
      \s* = \s*
      {{either_function_lookahead}}
    ))
  function_call_after_lookahead: (?=\s*\()

  block_comment_contents: (?:(?:[^*]|\*(?!/))*)
  block_comment: (?:/\*{{block_comment_contents}}\*/)
  nothing: (?:(?:\s|{{block_comment}})*)
  line_ending_ahead: (?={{nothing}}(?:/\*{{block_comment_contents}}|//.*)?$)

  binding_pattern_lookahead: (?:{{identifier}}|\[|\{)
  property_name: >-
    (?x:
      {{identifier}}
      | [0-9]+
      | '(?:[^\\']|\\.)*'
      | "(?:[^\\"]|\\.)*"
    )

  bif_names: |-
    (?x:
      Abs | Acos | ApplicationRestart | ApplicationStartTime | ApplicationStop | ArrayAppend | ArrayAvg | ArrayChunk |
      ArrayClear | ArrayContains | ArrayContainsNoCase | ArrayDelete | ArrayDeleteAt | ArrayDeleteNoCase | ArrayEach | ArrayEvery |
      ArrayFilter | ArrayFind | ArrayFindAll | ArrayFindAllNoCase | ArrayFindFirst | ArrayFindNoCase | ArrayFirst | ArrayFlatMap |
      ArrayFlatten | ArrayGetMetadata | ArrayGroupBy | ArrayIndexExists | ArrayInsertAt | ArrayIsDefined | ArrayIsEmpty | ArrayLast |
      ArrayLen | ArrayMap | ArrayMax | ArrayMedian | ArrayMerge | ArrayMid | ArrayMin | ArrayNew |
      ArrayNone | ArrayPop | ArrayPrepend | ArrayPush | ArrayRange | ArrayReduce | ArrayReduceRight | ArrayReject |
      ArrayResize | ArrayReverse | ArraySet | ArrayShift | ArraySlice | ArraySome | ArraySort | ArraySplice |
      ArraySum | ArraySwap | ArrayToList | ArrayToStruct | ArrayTranspose | ArrayUnique | ArrayUnshift | ArrayZip |
      Ascii | Asin | AsyncAll | AsyncAllApply | AsyncAny | AsyncRun | Atn | Attempt |
      BinaryDecode | BinaryEncode | BitAnd | BitMaskClear | BitMaskRead | BitMaskSet | BitNot | BitOr |
      BitSh | BitShln | BitShrn | BitXor | BooleanFormat | BoxAnnounce | BoxAnnounceAsync | BoxAST |
      BoxLangBIFProxy | BoxModuleReload | BoxRegisterInterceptionPoints | BoxRegisterInterceptor | BoxRegisterRequestInterceptor | BoxUnregisterInterceptor | BoxUnregisterRequestInterceptor | Cache |
      CacheFilter | CacheNames | CacheProviders | CacheService | CallStackGet | CamelCase | Ceiling | Char |
      CharsetDecode | CharsetEncode | ClearLocale | ClearTimezone | CLIClear | CLIExit | CLIGetArgs | CLIRead |
      Compare | CompareNoCase | Compress | ContractPath | Cos | CreateDate | CreateDateTime | CreateDynamicProxy |
      CreateGUID | CreateObject | CreateODBCDate | CreateODBCDateTime | CreateODBCTime | CreateTempDirectory | CreateTempFile | CreateTime |
      CreateTimeSpan | CreateUUID | CurrencyFormat | DataNavigate | DateAdd | DateCompare | DateConvert | DateDiff |
      DateFormat | DatePart | DateTimeFormat | Day | DayOfWeek | DayOfWeekAsString | DayOfWeekShortAsString | DayOfYear |
      DaysInMonth | DaysInYear | DE | DebugBoxContexts | DecimalFormat | DecrementValue | Decrypt | DecryptBinary |
      DirectoryCopy | DirectoryCreate | DirectoryDelete | DirectoryExists | DirectoryList | DirectoryMove | DirectoryRename | DollarFormat |
      Dump | Duplicate | Echo | EncodeForHTML | Encrypt | EncryptBinary | ExecutorDelete | ExecutorGet |
      ExecutorHas | ExecutorList | ExecutorNew | ExecutorShutdown | ExecutorStatus | Exp | ExpandPath | Extract |
      FileAppend | FileClose | FileCopy | FileDelete | FileExists | FileGetMimeType | FileInfo | FileIsEOF |
      FileMove | FileOpen | FileRead | FileReadBinary | FileReadLine | FileSeek | FileSetAccessMode | FileSetAttribute |
      FileSetLastModified | FileSkipBytes | FileUpload | FileUploadAll | FileWrite | FileWriteLine | Find | FindNoCase |
      FindOneOf | FirstDayOfMonth | Fix | Floor | FormatBaseN | Forward | FutureNew | GeneratePBKDFKey |
      GenerateSecretKey | GetApplicationMetadata | GetBaseTagData | GetBaseTagList | GetBaseTemplatePath | GetBoxCache | GetBoxCacheFilter | GetBoxCacheNames |
      GetBoxCacheProviders | GetBoxCacheService | GetBoxContext | GetBoxRuntime | GetBoxVersionInfo | GetCanonicalPath | GetClassMetadata | GetComponentList |
      GetComponentMetadata | GetContextRoot | GetCurrentTemplatePath | GetDirectoryFromPath | GetFileFromPath | GetFileInfo | GetFunctionCalledName | GetFunctionList |
      GetHTTPRequestData | GetHTTPTimeString | GetLocale | GetLocaleDisplayName | GetLocaleInfo | GetMetaData | GetModuleInfo | GetModuleList |
      GetNumericDate | GetPageContext | GetRequestClassLoader | GetSemver | GetSystemSetting | GetTempDirectory | GetTempFile | GetTickCount |
      GetTime | GetTimezone | GetTimezoneInfo | GetToken | Hash | Hash40 | Hmac | Hour |
      HtmlEditFormat | HtmlFooter | HtmlHead | HTTP | IIF | IncrementValue | InputBaseN | Insert |
      Int | Invoke | IsArray | IsBinary | IsBoolean | IsClosure | IsCurrency | IsCustomFunction |
      IsDate | IsDateObject | IsDebugMode | IsDefined | IsEmpty | IsFileObject | IsInstanceOf | IsInThread |
      IsInTransaction | IsIPv6 | IsJSON | IsLeapYear | IsLocalHost | IsNull | IsNumeric | IsNumericDate |
      IsObject | IsQuery | IsSimpleValue | IsStruct | IsThreadAlive | IsThreadInterrupted | IsValid | IsWithinTransaction |
      IsXML | IsXmlAttribute | IsXMLDoc | IsXMLElem | IsXMLNode | IsXMLRoot | IsZipFile | JavaCast |
      JSONDeserialize | JSONPrettify | JSONSerialize | JSStringFormat | Justify | KebabCase | Key | LCase |
      Left | Len | ListAppend | ListAvg | ListChangeDelims | ListCompact | ListContains | ListContainsNoCase |
      ListDeleteAt | ListEach | ListEvery | ListFilter | ListFind | ListFindNoCase | ListFirst | ListGetAt |
      ListGetEndings | ListIndexExists | ListInsertAt | ListItemTrim | ListLast | ListLen | ListMap | ListNone |
      ListPrepend | ListQualify | ListReduce | ListReduceRight | ListRemoveDuplicates | ListRest | ListSetAt | ListSome |
      ListSort | ListToArray | ListTrim | ListValueCount | ListValueCountNoCase | LJustify | Location | Log |
      Log10 | LSCurrencyFormat | LSIsCurrency | LSIsNumeric | LSNumberFormat | LSParseCurrency | LSParseNumber | LTrim |
      Max | Mid | Millisecond | Min | Minute | Month | MonthAsString | MonthShortAsString |
      Nanosecond | Now | NullValue | NumberFormat | ObjectDeserialize | ObjectSerialize | Offset | PagePoolClear |
      ParagraphFormat | ParseCurrency | ParseDateTime | ParseNumber | PascalCase | Pi | PrecisionEvaluate | PreserveSingleQuotes |
      Print | Println | PropertyFile | Quarter | QueryAddColumn | QueryAddRow | QueryAppend | QueryClear |
      QueryColumnArray | QueryColumnCount | QueryColumnData | QueryColumnExists | QueryColumnList | QueryCurrentRow | QueryDeleteColumn | QueryDeleteRow |
      QueryEach | QueryEvery | QueryExecute | QueryFilter | QueryGetCell | QueryGetResult | QueryInsertAt | QueryKeyExists |
      QueryMap | QueryNew | QueryNone | QueryPrepend | QueryRecordCount | QueryReduce | QueryRegisterFunction | QueryReverse |
      QueryRowData | QueryRowSwap | QuerySetCell | QuerySetRow | QuerySlice | QuerySome | QuerySort | QueryStringToStruct |
      Rand | Randomize | RandRange | ReEscape | ReFind | ReFindNoCase | ReMatch | ReMatchNoCase |
      RemoveChars | RepeatString | Replace | ReplaceList | ReplaceListNoCase | ReplaceNoCase | ReReplace | ReReplaceNoCase |
      Reverse | Right | RJustify | Round | RTrim | RunAsync | RunThreadInContext | SchedulerGet |
      SchedulerGetAll | SchedulerList | SchedulerRestart | SchedulerShutdown | SchedulerStart | Second | SessionInvalidate | SessionRotate |
      SessionStartTime | SetEncoding | SetLocale | SetTimezone | Sgn | Sin | Sleep | Slugify |
      SnakeCase | SOAP | SpanExcluding | SpanIncluding | SQLPrettify | Sqr | StringBind | StringEach |
      StringEvery | StringFilter | StringLen | StringMap | StringReduce | StringReduceRight | StringSome | StringSort |
      StripCR | StructAppend | StructClear | StructCopy | StructCount | StructDelete | StructEach | StructEquals |
      StructEvery | StructFilter | StructFind | StructFindKey | StructFindValue | StructGet | StructGetMetadata | StructInsert |
      StructIsCaseSensitive | StructIsEmpty | StructIsOrdered | StructKeyArray | StructKeyExists | StructKeyList | StructKeyTranslate | StructMap |
      StructNew | StructNone | StructReduce | StructSome | StructSort | StructToQueryString | StructToSorted | StructUpdate |
      StructValueArray | SystemCacheClear | SystemExecute | SystemOutput | Tan | ThreadInterrupt | ThreadJoin | ThreadNew |
      ThreadTerminate | Throw | TimeFormat | TimeUnits | ToBase64 | ToBinary | ToModifiable | ToNumeric |
      ToScript | ToString | ToUnmodifiable | Trace | TransactionCommit | TransactionRollback | TransactionSetSavepoint | TranspileCollectionKeySwap |
      Trim | TrueFalseFormat | UCase | UCFirst | URLDecode | URLEncodedFormat | Val | Week |
      WeekOfYear | Wrap | WriteDump | WriteLog | WriteOutput | XMLChildPos | XMLElemNew | XMLFormat |
      XMLGetNodeType | XMLNew | XMLParse | XMLSearch | XMLTransform | XMLValidate | Year | YesNoFormat
    )

contexts:
  prototype:
    - include: comments
    - include: annotations

  else-pop:
    - match: (?=\S)
      pop: true

  else-pop-2:
    - match: (?=\S)
      pop: 2

  immediately-pop:
    - meta_include_prototype: false
    - match: ''
      pop: true

  immediately-pop-2:
    - meta_include_prototype: false
    - match: ''
      pop: 2

  main:
    - include: import-statement
    - include: statements

  statements:
    - match: (?=\S)
      push: statement

  statement:
    - match: \;
      scope: punctuation.terminator.statement.empty.boxlang
      pop: true
    - include: class-declaration
    - include: function-declaration
    - include: static-block
    - include: variable-declaration
    - include: conditional
    - include: block
    - include: label
    - include: flow-control
    - include: assert-statement
    - include: bx-component-statement
    - include: expression-statement

  comments:
    - match: /\*\*(?!/|\*)
      scope: punctuation.definition.comment.boxlang
      push:
        - meta_include_prototype: false
        - meta_scope: comment.block.documentation.boxlang
        - match: \*/
          scope: punctuation.definition.comment.boxlang
          pop: true
    - match: /\*
      scope: punctuation.definition.comment.boxlang
      push:
        - meta_include_prototype: false
        - meta_scope: comment.block.boxlang
        - match: \*/
          scope: punctuation.definition.comment.boxlang
          pop: true
    - match: //
      scope: punctuation.definition.comment.boxlang
      push:
        - meta_include_prototype: false
        - meta_scope: comment.block.documentation.boxlang
        - match: \n
          pop: true

  annotations:
    - match: '@'
      scope: punctuation.definition.decorator.boxlang keyword.operator.decorator.boxlang
      push:
        - annotation-body
        - annotation-name

  annotation-name:
    - match: '{{identifier}}'
      scope: entity.name.function.decorator.boxlang storage.type.annotation.boxlang
      pop: true
    - include: else-pop

  annotation-body:
    - match: \(
      scope: punctuation.section.parameters.begin.annotation.boxlang
      set:
        - meta_scope: meta.annotation.parameters.boxlang
        - match: \)
          scope: punctuation.section.parameters.end.annotation.boxlang
          pop: true
        - match: ','
          scope: punctuation.separator.annotation.boxlang
        - match: '(\w[\w\-]*)\s*(=)'
          captures:
            1: entity.other.attribute-name.annotation.boxlang
            2: punctuation.separator.key-value.annotation.boxlang
          push: expression-no-comma
        - include: expressions-no-comma
    - match: ''
      pop: true

  import-statement:
    - match: \b(import)\b
      scope: keyword.control.import.boxlang
      push:
        - meta_scope: meta.import.boxlang
        - match: (?=\n|;)
          pop: true
        - match: '\b(as)\b'
          scope: keyword.control.import.alias.boxlang
          push: import-alias
        - match: '\b(bx|java|whatever|coldfusion|cfml)(:)'
          captures:
            1: support.type.import.prefix.boxlang
            2: punctuation.separator.namespace.boxlang
          push:
            - import-class-name
            - import-path-segments
        - match: \*
          scope: constant.other.wildcard.import.boxlang
        - match: (?=\S)
          push:
            - import-class-name
            - import-path-segments
        - include: else-pop

  import-alias:
    - match: '([[:alpha:]][_$[:alnum:]]*)'
      scope: entity.name.class.import.alias.boxlang
      pop: true
    - include: else-pop

  import-path-segments:
    - match: '([_$[:alnum:]]+)\.'
      scope: meta.path.import.boxlang
    - include: else-pop

  import-class-name:
    - match: '([[:alpha:]][_$[:alnum:]]*)'
      scope: entity.name.class.import.boxlang
      pop: true
    - include: else-pop

  class-declaration:
    - match: \b(class)\b
      scope: keyword.declaration.class.boxlang storage.type.class.boxlang
      push:
        - meta_scope: meta.class.declaration.boxlang
        - match: \{
          scope: punctuation.section.block.begin.boxlang
          set: class-body
        - match: '(\w[\w\-]*)\s*(=)'
          captures:
            1: entity.other.attribute-name.class.boxlang
            2: punctuation.separator.key-value.class.boxlang
          push: expression-no-comma
        - match: \b(extends)\b
          scope: keyword.declaration.extends.boxlang
        - match: \b(implements)\b
          scope: keyword.declaration.implements.boxlang
        - match: '{{identifier}}'
          scope: entity.name.class.boxlang
        - match: '(\w[\w\-]*)'
          scope: entity.other.attribute-name.class.boxlang

  class-body:
    - meta_scope: meta.class.body.boxlang
    - match: \}
      scope: punctuation.section.block.end.boxlang
      pop: true
    - include: function-declaration
    - include: property-declaration
    - include: statements

  static-block:
    - match: \bstatic\b(?=\s*[\n\{])
      scope: keyword.control.static.boxlang
      push:
        - static-block-meta
        - block

  static-block-meta:
    - meta_include_prototype: false
    - meta_scope: meta.block.static.boxlang
    - include: immediately-pop

  block:
    - match: \{
      scope: punctuation.section.block.begin.boxlang
      set:
        - meta_scope: meta.block.boxlang
        - match: \}
          scope: punctuation.section.block.end.boxlang
          pop: true
        - include: statements

  variable-declaration:
    - match: \b(var)\b
      scope: keyword.declaration.var.boxlang storage.type.boxlang
      set:
        - expect-semicolon
        - variable-binding-list-top
        - variable-binding-top
    - include: static-declaration
    - include: final-declaration

  static-declaration:
    - match: \bstatic\b(?!\??\.)
      scope: storage.modifier.boxlang
      set:
        - match: (?=\bfinal\b(?!\??\.))
          set: final-declaration
        - match: '(?={{function_lookahead}}\b)'
          set: function-declaration
        - include: else-pop

  final-declaration:
    - match: \bfinal\b(?!\??\.)
      scope: storage.modifier.boxlang
      set:
        - match: (?=\bstatic\b(?!\??\.))
          set: static-declaration
        - match: '(?={{function_lookahead}}\b)'
          set: function-declaration
        - include: else-pop

  variable-binding-top:
    - match: (?={{binding_pattern_lookahead}})
      set:
        - initializer
        - variable-binding-pattern

  variable-binding-pattern:
    - include: variable-binding-name
    - include: variable-binding-array-destructuring
    - include: variable-binding-struct-destructuring
    - include: else-pop

  variable-binding-name:
    - match: (?={{non_reserved_identifier}}\b\[)
      pop: true
    - match: (?={{non_reserved_identifier}})
      set:
        - meta_scope: meta.binding.name.boxlang
        - match: '{{identifier}}'
          scope: variable.other.readwrite.boxlang
          pop: true

  variable-binding-array-destructuring:
    - match: '\['
      scope: punctuation.section.sequence.begin.boxlang
      set:
        - meta_scope: meta.binding.destructuring.sequence.boxlang
        - match: '\]'
          scope: punctuation.section.sequence.end.boxlang
          pop: true
        - include: variable-binding-list

  variable-binding-struct-destructuring:
    - match: '\{'
      scope: punctuation.section.mapping.begin.boxlang
      set:
        - meta_scope: meta.binding.destructuring.mapping.boxlang
        - match: '\}'
          scope: punctuation.section.mapping.end.boxlang
          pop: true
        - include: variable-binding-list

  variable-binding-list:
    - match: ','
      scope: punctuation.separator.comma.boxlang
      push: variable-binding-top
    - include: else-pop

  variable-binding-list-top:
    - match: ','
      scope: punctuation.separator.comma.boxlang
      push: variable-binding-top
    - include: else-pop

  initializer:
    - match: '='
      scope: keyword.operator.assignment.boxlang
      set: expression-no-comma
    - include: else-pop

  expect-semicolon:
    - match: \;
      scope: punctuation.terminator.statement.boxlang
      pop: true
    - include: else-pop

  label:
    - match: '({{identifier}})\s*(:)'
      captures:
        1: entity.name.label.boxlang
        2: punctuation.separator.boxlang

  flow-control:
    - match: \b(break|continue)\b
      scope: keyword.control.flow.boxlang
      set:
        - expect-semicolon
        - expect-label
    - match: \b(return)\b
      scope: keyword.control.flow.return.boxlang
      set: restricted-production
    - match: \b(throw|rethrow)\b
      scope: keyword.control.flow.throw.boxlang
      set: restricted-production
    - match: \b(abort)\b
      scope: keyword.control.flow.boxlang
      set: expect-semicolon

  assert-statement:
    - match: \b(assert)\b
      scope: keyword.control.assert.boxlang
      set:
        - expect-semicolon
        - assert-message-clause
        - expression-no-comma

  assert-message-clause:
    - match: ':'
      scope: punctuation.separator.key-value.boxlang
      set: expression-no-comma
    - include: else-pop

  expect-label:
    - meta_include_prototype: false
    - match: '(?={{nothing}}{{identifier}})'
      set:
        - match: '{{non_reserved_identifier}}'
          scope: variable.label.boxlang
          pop: true
        - match: '{{identifier}}'
          scope: invalid.illegal.identifier.boxlang variable.label.boxlang
          pop: true
        - include: else-pop
    - include: immediately-pop

  bx-component-statement:
    - match: \b(bx:)([[:alpha:]][[:alnum:]_]*)
      captures:
        1: support.function.boxlang keyword.control.boxlang
        2: entity.name.function.boxlang support.function.boxlang entity.name.tag.boxlang
      set:
        - bx-component-statement-meta
        - bx-component-statement-body
        - bx-component-statement-attributes

  bx-component-statement-meta:
    - meta_scope: meta.tag.boxlang meta.tag.script.bx.boxlang
    - include: immediately-pop

  bx-component-statement-attributes:
    - match: (?=\{)
      pop: true
    - match: (?=\;)
      pop: true
    - match: (\w[\w\-]*)\s*(=)\s*(\")
      captures:
        1: entity.other.attribute-name.boxlang
        2: punctuation.separator.key-value.boxlang
        3: punctuation.definition.string.begin.boxlang
      set:
        - meta_include_prototype: false
        - meta_scope: string.quoted.double.boxlang
        - match: \"
          scope: punctuation.definition.string.end.boxlang
          pop: true
        - match: '\\.'
          scope: constant.character.escape.boxlang
    - match: (\w[\w\-]*)\s*(=)\s*(')
      captures:
        1: entity.other.attribute-name.boxlang
        2: punctuation.separator.key-value.boxlang
        3: punctuation.definition.string.begin.boxlang
      set:
        - meta_include_prototype: false
        - meta_scope: string.quoted.single.boxlang
        - match: \'
          scope: punctuation.definition.string.end.boxlang
          pop: true
        - match: '\\.'
          scope: constant.character.escape.boxlang
    - match: (\w[\w\-]*)
      scope: entity.other.attribute-name.boxlang

  bx-component-statement-body:
    - match: \{
      scope: support.function.boxlang punctuation.definition.tag.begin.boxlang
      set:
        - meta_scope: meta.tag.boxlang meta.bx-tag.body.boxlang
        - match: \}
          scope: support.function.boxlang punctuation.definition.tag.end.boxlang
          pop: true
        - include: statements
    - match: \;
      scope: support.function.boxlang punctuation.definition.tag.end.boxlang
      pop: true
    - include: else-pop

  restricted-production:
    - meta_include_prototype: false
    - match: '{{line_ending_ahead}}'
      pop: true
    - match: ''
      set: expression-statement

  conditional:
    - match: \bswitch\b
      scope: keyword.control.conditional.switch.boxlang
      set:
        - switch-meta
        - switch-block
        - expect-parenthesized-expression
    - match: \bdo\b
      scope: keyword.control.loop.do-while.boxlang
      set:
        - do-while-meta
        - do-while-condition
        - statement
    - match: \bfor\b
      scope: keyword.control.loop.for.boxlang
      set:
        - for-meta
        - block-scope
        - for-condition
    - match: \bwhile\b
      scope: keyword.control.loop.while.boxlang
      set:
        - while-meta
        - block-scope
        - expect-parenthesized-expression
    - match: \bif\b
      scope: keyword.control.conditional.if.boxlang
      set:
        - conditional-meta
        - statement
        - expect-parenthesized-expression
    - match: \belse\s+if\b
      scope: keyword.control.conditional.elseif.boxlang
      set:
        - conditional-meta
        - statement
        - expect-parenthesized-expression
    - match: \belse\b
      scope: keyword.control.conditional.else.boxlang
      set:
        - conditional-meta
        - statement
    - match: \btry\b
      scope: keyword.control.exception.try.boxlang
      set:
        - try-meta
        - block-scope
    - match: \bfinally\b
      scope: keyword.control.exception.finally.boxlang
      set:
        - finally-meta
        - block-scope
    - match: \bcatch\b
      scope: keyword.control.exception.catch.boxlang
      set:
        - catch-meta
        - block-scope
        - catch-binding

  expect-parenthesized-expression:
    - include: parenthesized-expression
    - include: else-pop

  switch-meta:
    - meta_include_prototype: false
    - meta_scope: meta.switch.boxlang
    - include: immediately-pop

  do-while-meta:
    - meta_include_prototype: false
    - meta_scope: meta.do-while.boxlang
    - include: immediately-pop

  for-meta:
    - meta_include_prototype: false
    - meta_scope: meta.for.boxlang
    - include: immediately-pop

  while-meta:
    - meta_include_prototype: false
    - meta_scope: meta.while.boxlang
    - include: immediately-pop

  conditional-meta:
    - meta_include_prototype: false
    - meta_scope: meta.conditional.boxlang
    - include: immediately-pop

  try-meta:
    - meta_include_prototype: false
    - meta_scope: meta.try.boxlang
    - include: immediately-pop

  finally-meta:
    - meta_include_prototype: false
    - meta_scope: meta.finally.boxlang
    - include: immediately-pop

  catch-meta:
    - meta_include_prototype: false
    - meta_scope: meta.catch.boxlang
    - include: immediately-pop

  for-condition:
    - match: \(
      scope: punctuation.section.group.begin.boxlang
      branch_point: for-in
      branch:
        - for-in
        - for-oldstyle
      pop: true
    - include: else-pop

  for-condition-end:
    - meta_scope: meta.group.boxlang
    - match: \)
      scope: punctuation.section.group.end.boxlang
      pop: true
    - match: ;
      scope: invalid.illegal.unexpected-token.boxlang
    - include: expressions

  for-in:
    - meta_include_prototype: false
    - meta_scope: meta.group.boxlang
    - match: ''
      set:
        - for-condition-end
        - for-in-word
        - for-in-declaration

