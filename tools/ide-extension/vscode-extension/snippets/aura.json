{
  "// 函数": {
    "prefix": "fn",
    "body": [
      "fun ${1:name}(${2:params}): ${3:ReturnType} {",
      "    $0",
      "}"
    ],
    "description": "创建新函数"
  },
  "// 单表达式函数": {
    "prefix": "fn=",
    "body": [
      "fun ${1:name}(${2:params}): ${3:ReturnType} = ${4:expression}"
    ],
    "description": "创建单表达式函数"
  },
  "// 值类型（value class）": {
    "prefix": "vc",
    "body": [
      "value class ${1:Name}(",
      "    val ${2:field1}: ${3:Type1},",
      "    var ${4:field2}: ${5:Type2} = ${6:defaultValue}",
      ")"
    ],
    "description": "创建值类型（不可变，栈分配）"
  },
  "// 结构体（struct）": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name}(",
      "    val ${2:field1}: ${3:Type1},",
      "    var ${4:field2}: ${5:Type2} = ${6:defaultValue}",
      ")"
    ],
    "description": "创建结构体"
  },
  "// 枚举": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "    ${2:VALUE1},",
      "    ${3:VALUE2},",
      "    ${4:CUSTOM}(val ${5:name}: ${6:Type})",
      "}"
    ],
    "description": "创建枚举"
  },
  "// 类": {
    "prefix": "class",
    "body": [
      "class ${1:Name} : ${2:Superclass} {",
      "    override fun ${3:method}(${4:params}): ${5:ReturnType} {",
      "        $0",
      "    }",
      "}"
    ],
    "description": "创建类（继承）"
  },
  "// 密封类": {
    "prefix": "sealed",
    "body": [
      "sealed class ${1:Name} {",
      "    fun ${2:method}(): ${3:ReturnType} = ${4:default}",
      "}"
    ],
    "description": "创建密封类"
  },
  "// 接口": {
    "prefix": "interface",
    "body": [
      "interface ${1:Name} {",
      "    fun ${2:method}(${3:params}): ${4:ReturnType}",
      "}"
    ],
    "description": "创建接口"
  },
  "// Actor": {
    "prefix": "actor",
    "body": [
      "actor ${1:Name} {",
      "    private var ${2:state}: ${3:Type} = ${4:default}",
      "",
      "    fun start() {",
      "        $0",
      "    }",
      "}"
    ],
    "description": "创建 Actor（并发实体）"
  },
  "// 单例对象": {
    "prefix": "obj",
    "body": [
      "object ${1:Name} {",
      "    fun ${2:method}(${3:params}): ${4:ReturnType} {",
      "        $0",
      "    }",
      "}"
    ],
    "description": "创建单例对象"
  },
  "// 类型别名": {
    "prefix": "ta",
    "body": [
      "typealias ${1:Name} = ${2:Type}"
    ],
    "description": "创建类型别名"
  },
  "// 泛型函数": {
    "prefix": "gen",
    "body": [
      "fun <${1:T}> ${2:name}(${3:arg}: ${1:T}): ${1:T} {",
      "    return ${3:arg}",
      "}"
    ],
    "description": "创建泛型函数"
  },
  "// 协程函数": {
    "prefix": "suspend",
    "body": [
      "suspend fun ${1:name}(${2:params}): ${3:ReturnType} {",
      "    $0",
      "}"
    ],
    "description": "创建协程函数"
  },
  "// async 块": {
    "prefix": "async",
    "body": [
      "async {",
      "    $0",
      "}"
    ],
    "description": "async 异步块"
  },
  "// defer 延迟块": {
    "prefix": "defer",
    "body": [
      "defer {",
      "    $0",
      "}"
    ],
    "description": "defer 延迟执行块"
  },
  "// select 多路复用": {
    "prefix": "select",
    "body": [
      "select {",
      "    case ${1:channel} -> {",
      "        $0",
      "    }",
      "    case else -> {",
      "        ${2:fallback}",
      "    }",
      "}"
    ],
    "description": "select 多路复用"
  },
  "// if-else": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "    $0",
      "} else {",
      "    ${2:else}",
      "}"
    ],
    "description": "if-else 语句"
  },
  "// when": {
    "prefix": "when",
    "body": [
      "when (${1:value}) {",
      "    ${2:case1} -> $0",
      "    else -> ${3:else}",
      "}"
    ],
    "description": "when 表达式"
  },
  "// when 无 subject": {
    "prefix": "when2",
    "body": [
      "when {",
      "    ${1:condition1} -> $0",
      "    else -> ${2:else}",
      "}"
    ],
    "description": "when 无 subject 表达式"
  },
  "// for 循环": {
    "prefix": "for",
    "body": [
      "for (${1:item} in ${2:iterator}) {",
      "    $0",
      "}"
    ],
    "description": "for 循环"
  },
  "// while 循环": {
    "prefix": "while",
    "body": [
      "while (${1:condition}) {",
      "    $0",
      "}"
    ],
    "description": "while 循环"
  },
  "// do-while 循环": {
    "prefix": "dowhile",
    "body": [
      "do {",
      "    $0",
      "} while (${1:condition})"
    ],
    "description": "do-while 循环"
  },
  "// try-catch": {
    "prefix": "try",
    "body": [
      "try {",
      "    $0",
      "} catch (e: ${1:Exception}) {",
      "    ${2:handle}",
      "}"
    ],
    "description": "try-catch 异常处理"
  },
  "// try-catch-finally": {
    "prefix": "tryf",
    "body": [
      "try {",
      "    $0",
      "} catch (e: ${1:Exception}) {",
      "    ${2:handle}",
      "} finally {",
      "    ${3:cleanup}",
      "}"
    ],
    "description": "try-catch-finally 异常处理"
  },
  "// FFI 声明（C ABI）": {
    "prefix": "ffi",
    "body": [
      "extern \"c\" \"${1:library}\" {",
      "    fun ${2:functionName}(${3:params}): ${4:ReturnType}",
      "}"
    ],
    "description": "FFI 外部函数声明（C ABI）"
  },
  "// FFI 声明（行内）": {
    "prefix": "ffiinline",
    "body": [
      "extern \"c\" fun ${1:functionName}(${2:params}): ${3:ReturnType}"
    ],
    "description": "FFI 行内外部函数声明"
  },
  "// FFI AOT 接口（extern object）": {
    "prefix": "ffiaot",
    "body": [
      "extern object ${1:Utils} {",
      "    default fun loadLibrary(): String = \"${2:library}\"",
      "    @aot fun ${3:add}(a: Int, b: Int): Int",
      "    @aot fun ${4:multiply}(a: Int, b: Int): Int",
      "}"
    ],
    "description": "FFI AOT 接口声明"
  },
  "// native 注解": {
    "prefix": "native",
    "body": [
      "@native(${1:SYS_READ})",
      "fun ${2:name}(${3:params}): ${4:ReturnType}"
    ],
    "description": "native 注解（系统调用 / 内联汇编 / 编译器内置）"
  },
  "// @aot 注解": {
    "prefix": "aot",
    "body": [
      "@aot",
      "fun ${1:name}(${2:params}): ${3:ReturnType}"
    ],
    "description": "@aot 注解（AOT 编译函数）"
  },
  "// Lambda": {
    "prefix": "lambda",
    "body": [
      "val ${1:name} = (${2:params}) -> ${3:expression}"
    ],
    "description": "Lambda 表达式"
  },
  "// 方法引用": {
    "prefix": "mref",
    "body": [
      "val ${1:name} = ${2:obj}::${3:method}"
    ],
    "description": "方法引用"
  },
  "// 导入": {
    "prefix": "import",
    "body": [
      "import ${1:module} as ${2:alias}"
    ],
    "description": "导入模块"
  },
  "// 依赖声明": {
    "prefix": "dep",
    "body": [
      "// @depends ${1:package} >= ${2:version}"
    ],
    "description": "依赖声明注释"
  },
  "// main 函数": {
    "prefix": "main",
    "body": [
      "fun main() {",
      "    println(\"Hello, Aura!\")",
      "}"
    ],
    "description": "主函数入口"
  },
  "// main 返回 Int": {
    "prefix": "main2",
    "body": [
      "fun main(): Int {",
      "    return 0",
      "}"
    ],
    "description": "主函数入口（返回 Int）"
  },
  "// 文档注释（单行）": {
    "prefix": "///",
    "body": [
      "/// ${1:Description}",
      "$0"
    ],
    "description": "单行文档注释"
  },
  "// 文档注释（多行）": {
    "prefix": "/**",
    "body": [
      "/**",
      " * ${1:Description}",
      " * @param ${2:name} ${3:description}",
      " * @return ${4:returnDescription}",
      " */",
      "$0"
    ],
    "description": "多行文档注释"
  },
  "// 包声明": {
    "prefix": "package",
    "body": [
      "package ${1:com.example.module}"
    ],
    "description": "文件头包声明"
  }
}