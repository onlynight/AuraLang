{
  "name": "gitter-hat-language-support",
  "displayName": "HAT v3.0 Language Support (Gitter)",
  "description": "HAT (HIR-Advanced Text) SSA IR highlighting, snippets and theme colors for Gitter. Grammar assets are synced byte-for-byte from the upstream AuraLang VS Code extension (hat-vscode-extension).",
  "version": "3.0.3",
  "publisher": "aura-lang",
  "license": "Apache-2.0",
  "homepage": "https://github.com/onlynight/Gitter",
  "repository": {
    "type": "git",
    "url": "git@github.com:onlynight/Gitter.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "keywords": [
    "hat",
    "aura",
    "photon",
    "ir",
    "compiler",
    "novaos",
    "ssa",
    "gitter",
    "syntax highlighting"
  ],
  "activationEvents": [
    "onLanguage:hat"
  ],
  "contributes": {
    "languages": [
      {
        "id": "hat",
        "aliases": ["HAT", "hat"],
        "extensions": [".hat"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "hat",
        "scopeName": "source.hat",
        "path": "./syntaxes/hat.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "hat",
        "path": "./snippets/hat.json"
      }
    ],
    "themes": [
      {
        "label": "HAT Theme (Dark)",
        "uiTheme": "vs-dark",
        "path": "./colors/hat-colors.json"
      }
    ]
  },
  "scripts": {
    "sync-grammar": "node scripts/sync-grammar.mjs",
    "verify": "node scripts/verify.mjs",
    "package": "npm run verify && vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
