{
  "name": "gitter-aura-language",
  "displayName": "Aura Language (Gitter)",
  "description": "Aura language highlighting, snippets, theme colors and file icons for Gitter. Grammar assets are synced byte-for-byte from the upstream AuraLang VS Code extension (aura-vscode-extension) — this fork ships the static language contributions only, no LSP client.",
  "version": "0.3.0",
  "publisher": "aura-lang",
  "license": "Apache-2.0",
  "homepage": "https://github.com/onlynight/Gitter",
  "repository": {
    "type": "git",
    "url": "git@github.com:onlynight/Gitter.git"
  },
  "categories": [
    "Programming Languages",
    "Themes",
    "Formatters"
  ],
  "keywords": [
    "aura",
    "novaos",
    "kotlin",
    "scripting",
    "gitter",
    "syntax highlighting"
  ],
  "activationEvents": [
    "onLanguage:aura"
  ],
  "main": "./out/extension.js",
  "engines": {
    "vscode": "^1.80.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "aura",
        "aliases": [
          "Aura",
          "aura"
        ],
        "extensions": [
          ".aura"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./resources/aura-icon-light.png",
          "dark": "./resources/aura-icon-dark.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "aura",
        "scopeName": "source.aura",
        "path": "./syntaxes/aura.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "aura",
        "path": "./snippets/aura.json"
      }
    ],
    "configurationDefaults": {
      "[aura]": {
        "editor.tokenColorCustomizations": {
          "textMateRules": [
            {
              "scope": "support.function.std.aura",
              "settings": {
                "foreground": "#4EC9B0"
              }
            },
            {
              "scope": "entity.name.type.annotation.aura",
              "settings": {
                "foreground": "#BC83FF"
              }
            },
            {
              "scope": "storage.type.extern.aura",
              "settings": {
                "foreground": "#C586C0"
              }
            },
            {
              "scope": "storage.type.package.aura",
              "settings": {
                "foreground": "#569CD6"
              }
            },
            {
              "scope": "entity.name.type.enum.variant.aura",
              "settings": {
                "foreground": "#4FC1FF"
              }
            },
            {
              "scope": "variable.other.constant.aura",
              "settings": {
                "foreground": "#AAA0FA"
              }
            },
            {
              "scope": "variable.other.readwrite.aura, variable.other.object.aura, variable.field.aura, variable.other.property.aura",
              "settings": {
                "foreground": "#9CDCFE"
              }
            },
            {
              "scope": "variable.parameter.aura",
              "settings": {
                "foreground": "#CE9178"
              }
            },
            {
              "scope": "keyword.operator.elvis.aura, keyword.operator.null-assert.aura, keyword.operator.null-coalesce.aura",
              "settings": {
                "foreground": "#D7BA7D"
              }
            }
          ]
        }
      }
    }
  },
  "scripts": {
    "sync-grammar": "node scripts/sync-grammar.mjs",
    "verify": "node scripts/verify.mjs",
    "package": "npm run verify && vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
