internal value class String {
    companion object {
        const EMPTY: String = ""
        
        fun fromChars(chars: Array<Char>): String {
            var result: String = ""
            var i: Int = 0
            while (i < chars.size) {
                result = result + chars[i]
                i = i + 1
            }
            return result
        }
    }
    
    val length: Int
    
    fun toInt(): Int {
        return 42
    }
}
