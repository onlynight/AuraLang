// tests/hashmap_impl_test.aura
package test

import aura.lang.collection.HashMap
import aura.lang.collection.Map
import aura.lang.collection.ArrayList

// ─────────────────────────────────────────────────────────────────────────────
// HashMap<K, V> 实现自测：哈希分桶 + 链地址法 + 负载阈值扩容
//
// 覆盖：空表、put/get、覆盖写、getOrDefault、contains、remove、删除后重插、
// clear、toString、keys/values、null 值、扩容重建、墓碑压实、算术级数键
// （验证哈希混合）、Int/Boolean 键、Map 接口多态、HashMapUtils 工厂。
//
// 运行：aura run tests/hashmap_impl_test.aura
// ─────────────────────────────────────────────────────────────────────────────

/// 断言计数与汇总输出。
class Checker {
    private var passed: Int
    private var failed: Int

    constructor() {
        this.passed = 0
        this.failed = 0
    }

    fun check(name: String, cond: Boolean): Unit {
        if (cond) {
            this.passed = this.passed + 1
        } else {
            this.failed = this.failed + 1
            println("FAIL: " + name)
        }
    }

    fun summary(): Unit {
        println("passed=" + this.passed + " failed=" + this.failed)
        if (this.failed == 0) {
            println("ALL TESTS PASSED")
        } else {
            println("SOME TESTS FAILED")
        }
    }
}

// ── 1. 空表 ──

fun testEmpty(c: Checker): Unit {
    var m: HashMap<String, Int> = HashMap<String, Int>()
    c.check("empty.size", m.size == 0)
    c.check("empty.isEmpty", m.isEmpty())
    c.check("empty.getSize", m.getSize() == 0)
    c.check("empty.get", m.get("a") == null)
    c.check("empty.containsKey", m.containsKey("a") == false)
    c.check("empty.containsValue", m.containsValue(1) == false)
    c.check("empty.keys", m.keys().size == 0)
    c.check("empty.values", m.values().size == 0)
    c.check("empty.remove", m.remove("a") == null)
    c.check("empty.putMiss", m.getOrDefault("a", 7) == 7)
    c.check("empty.toString", m.toString() == "{}")
}

// ── 2. put / get ──

fun testPutGet(c: Checker): Unit {
    var m: HashMap<String, Int> = HashMap<String, Int>()
    var old: Int? = m.put("a", 1)
    c.check("put.missOldIsNull", old == null)
    c.check("put.size", m.size == 1)
    c.check("put.get", m.get("a") == 1)
    c.check("put.getMiss", m.get("b") == null)
    m.put("b", 2)
    m.put("c", 3)
    c.check("put.threeSize", m.size == 3)
    c.check("put.getb", m.get("b") == 2)
    c.check("put.getc", m.get("c") == 3)
}

// ── 3. 覆盖写：同键二次写入返回旧值，条目数不变 ──

fun testOverwrite(c: Checker): Unit {
    var m: HashMap<String, Int> = HashMap<String, Int>()
    m.put("k", 1)
    var old: Int? = m.put("k", 2)
    c.check("ow.oldValue", old == 1)
    c.check("ow.size", m.size == 1)
    c.check("ow.latest", m.get("k") == 2)
    var old2: Int? = m.put("k", 3)
    c.check("ow.thirdOld", old2 == 2)
    c.check("ow.thirdSize", m.size == 1)
    c.check("ow.thirdLatest", m.get("k") == 3)
    c.check("ow.singleKey", m.keys().size == 1)
    c.check("ow.singleValue", m.values().size == 1)
}

// ── 4. getOrDefault ──

fun testGetOrDefault(c: Checker): Unit {
    var m: HashMap<String, Int> = HashMap<String, Int>()
    m.put("a", 1)
    c.check("odo.hit", m.getOrDefault("a", 99) == 1)
    c.check("odo.miss", m.getOrDefault("zz", 99) == 99)
}

// ── 5. contains ──

fun testContains(c: Checker): Unit {
    var m: HashMap<String, String> = HashMap<String, String>()
    m.put("k1", "v1")
    m.put("k2", "v2")
    c.check("ct.containsKey1", m.containsKey("k1"))
    c.check("ct.containsKey2", m.containsKey("k2"))
    c.check("ct.notContains", m.containsKey("k3") == false)
    c.check("ct.containsValue1", m.containsValue("v1"))
    c.check("ct.containsValue2", m.containsValue("v2"))
    c.check("ct.notContainsValue", m.containsValue("v3") == false)
}

// ── 6. remove ──

fun testRemove(c: Checker): Unit {
    var m: HashMap<String, Int> = HashMap<String, Int>()
    m.put("a", 1)
    m.put("b", 2)
    m.put("c", 3)
    var removed: Int? = m.remove("b")
    c.check("rm.returnedValue", removed == 2)
    c.check("rm.size", m.size == 2)
    c.check("rm.getNull", m.get("b") == null)
    c.check("rm.notContains", m.containsKey("b") == false)
    c.check("rm.notContainsValue", m.containsValue(2) == false)
    c.check("rm.othersIntact", m.get("a") == 1 && m.get("c") == 3)
    c.check("rm.againNull", m.remove("b") == null)
    c.check("rm.missingNull", m.remove("zz") == null)
    c.check("rm.sizeStable", m.size == 2)
}

// ── 7. 删除后重插 ──

fun testRemoveThenPut(c: Checker): Unit {
    var m: HashMap<String, Int> = HashMap<String, Int>()
    m.put("x", 1)
    m.remove("x")
    var old: Int? = m.put("x", 10)
    c.check("rtp.sizeOne", m.size == 1)
    c.check("rtp.oldIsNull", old == null)
    c.check("rtp.newValue", m.get("x") == 10)
    c.check("rtp.containsKey", m.containsKey("x"))
    c.check("rtp.removable", m.remove("x") == 10)
    c.check("rtp.sizeZero", m.size == 0)
}

// ── 8. clear ──

fun testClear(c: Checker): Unit {
    var m: HashMap<String, Int> = HashMap<String, Int>()
    m.put("a", 1)
    m.put("b", 2)
    m.remove("a")
    m.clear()
    c.check("cl.size", m.size == 0)
    c.check("cl.isEmpty", m.isEmpty())
    c.check("cl.getNull", m.get("a") == null)
    c.check("cl.getNull2", m.get("b") == null)
    c.check("cl.keys", m.keys().size == 0)
    c.check("cl.values", m.values().size == 0)
    c.check("cl.toString", m.toString() == "{}")
    // 清空后仍可继续使用
    m.put("z", 9)
    c.check("cl.reuse", m.get("z") == 9)
    c.check("cl.reuseSize", m.size == 1)
}

// ── 9. toString ──

fun testToString(c: Checker): Unit {
    var m: HashMap<String, Int> = HashMap<String, Int>()
    m.put("a", 1)
    c.check("ts.single", m.toString() == "{a=1}")
    m.put("b", 2)
    var s: String = m.toString()
    c.check("ts.braceOpen", s.startsWith("{"))
    c.check("ts.braceClose", s.length > 0 && s.substring(s.length - 1, s.length) == "}")
    c.check("ts.hasA", s.indexOf("a=1") >= 0)
    c.check("ts.hasB", s.indexOf("b=2") >= 0)
    c.check("ts.hasComma", s.indexOf(", ") >= 0)
    // 删除后不再出现
    m.remove("a")
    var s2: String = m.toString()
    c.check("ts.afterRemoveNoA", s2.indexOf("a=1") < 0)
    c.check("ts.afterRemoveHasB", s2.indexOf("b=2") >= 0)
    m.remove("b")
    c.check("ts.emptyAgain", m.toString() == "{}")
}

// ── 10. keys / values 一一对应且无重复 ──

fun testKeysValues(c: Checker): Unit {
    var m: HashMap<String, Int> = HashMap<String, Int>()
    var i: Int = 0
    while (i < 10) {
        m.put("k" + i, i)
        i = i + 1
    }
    var ks: List<String> = m.keys()
    var vs: List<Int> = m.values()
    c.check("kv.size", ks.size == 10)
    c.check("kv.valuesSize", vs.size == 10)
    c.check("kv.mapSize", m.size == 10)
    // 键互不相同
    var dup: Boolean = false
    var a: Int = 0
    while (a < ks.size && dup == false) {
        var b: Int = a + 1
        while (b < ks.size && dup == false) {
            if (ks[a] == ks[b]) { dup = true }
            b = b + 1
        }
        a = a + 1
    }
    c.check("kv.noDuplicateKeys", dup == false)
    // 值互不相同（本用例值与下标一一对应）
    var vdup: Boolean = false
    a = 0
    while (a < vs.size && vdup == false) {
        // 注意：这里必须重新声明 `var b`。上一轮循环里的 `b` 声明在**块作用域内**，
        // 出块即失效；直接 `b = a + 1` 引用的是未定义名字，编译器会静默当 null
        //（`vs[null]` 取到 vs[0]）→ 误报「值重复」。
        var b: Int = a + 1
        while (b < vs.size && vdup == false) {
            if (vs[a] == vs[b]) { vdup = true }
            b = b + 1
        }
        a = a + 1
    }
    c.check("kv.noDuplicateValues", vdup == false)
}

// ── 11. null 值 ──

fun testNullValue(c: Checker): Unit {
    var m: HashMap<String, Int> = HashMap<String, Int>()
    m.put("a", 1)
    m.put("a", null)
    c.check("nv.containsKey", m.containsKey("a"))
    c.check("nv.getNull", m.get("a") == null)
    c.check("nv.size", m.size == 1)
    m.put("b", 2)
    c.check("nv.other", m.get("b") == 2)
    c.check("nv.removeNullVal", m.remove("a") == null)
    c.check("nv.sizeAfter", m.size == 1)
}

// ── 12. Int 键 ──

fun testIntKeys(c: Checker): Unit {
    var m: HashMap<Int, String> = HashMap<Int, String>()
    var i: Int = 0
    while (i < 30) {
        m.put(i, "v" + i)
        i = i + 1
    }
    c.check("ik.size", m.size == 30)
    var ok: Boolean = true
    i = 0
    while (i < 30) {
        if (m.get(i) != ("v" + i)) { ok = false }
        i = i + 1
    }
    c.check("ik.allValues", ok)
    c.check("ik.contains", m.containsKey(29))
    c.check("ik.missing", m.containsKey(30) == false)
    c.check("ik.remove", m.remove(15) == "v15")
    c.check("ik.sizeAfter", m.size == 29)
    c.check("ik.removed", m.get(15) == null)
    c.check("ik.neighbors", m.get(14) == "v14" && m.get(16) == "v16")
}

// ── 13. Boolean 键 ──

fun testBoolKeys(c: Checker): Unit {
    var m: HashMap<Boolean, String> = HashMap<Boolean, String>()
    m.put(true, "yes")
    m.put(false, "no")
    c.check("bk.size", m.size == 2)
    c.check("bk.true", m.get(true) == "yes")
    c.check("bk.false", m.get(false) == "no")
    m.put(true, "YES")
    c.check("bk.overwrite", m.size == 2)
    c.check("bk.overwriteVal", m.get(true) == "YES")
    c.check("bk.falseIntact", m.get(false) == "no")
}

// ── 14. 扩容重建：100 个 Int 键（16 → 32 → 64 → 128）──

fun testRehash(c: Checker): Unit {
    var m: HashMap<Int, Int> = HashMap<Int, Int>()
    var i: Int = 0
    while (i < 100) {
        m.put(i, i * 2)
        i = i + 1
    }
    c.check("rh.size", m.size == 100)
    var ok: Boolean = true
    i = 0
    while (i < 100) {
        if (m.get(i) != (i * 2)) { ok = false }
        i = i + 1
    }
    c.check("rh.allValues", ok)
    c.check("rh.keysCount", m.keys().size == 100)
    c.check("rh.valuesCount", m.values().size == 100)
    // 扩容后覆盖写仍然正确
    m.put(5, 999)
    c.check("rh.overwriteAfterRehash", m.size == 100)
    c.check("rh.overwriteAfterRehashVal", m.get(5) == 999)
    c.check("rh.othersAfterRehash", m.get(6) == 12 && m.get(99) == 198)
}

// ── 15. 删除 + 再插入：验证墓碑压实后链长有界 ──

fun testTombstoneCompaction(c: Checker): Unit {
    var m: HashMap<Int, Int> = HashMap<Int, Int>()
    var i: Int = 0
    while (i < 60) {
        m.put(i, i)
        i = i + 1
    }
    // 删除一半
    i = 0
    while (i < 60) {
        if (i % 2 == 0) { m.remove(i) }
        i = i + 1
    }
    c.check("tc.sizeAfterRemove", m.size == 30)
    var ok: Boolean = true
    i = 0
    while (i < 60) {
        if (i % 2 == 1) {
            if (m.get(i) != i) { ok = false }
        } else {
            if (m.containsKey(i)) { ok = false }
        }
        i = i + 1
    }
    c.check("tc.evenGoneOddKept", ok)
    c.check("tc.keysCount", m.keys().size == 30)
    // 再插入 100 个新键，触发多次扩容压实
    i = 1000
    while (i < 1100) {
        m.put(i, i)
        i = i + 1
    }
    c.check("tc.sizeAfterRefill", m.size == 130)
    ok = true
    i = 1000
    while (i < 1100) {
        if (m.get(i) != i) { ok = false }
        i = i + 1
    }
    c.check("tc.refillValues", ok)
    ok = true
    i = 1
    while (i < 60) {
        if (i % 2 == 1) {
            if (m.get(i) != i) { ok = false }
        }
        i = i + 2
    }
    c.check("tc.oldValuesSurviveRehash", ok)
}

// ── 16. 算术级数键：验证哈希混合（1, 17, 33, ... 步长 16）──

fun testArithmeticProgressionKeys(c: Checker): Unit {
    var m: HashMap<Int, Int> = HashMap<Int, Int>()
    var i: Int = 0
    while (i < 40) {
        m.put(1 + i * 16, i)
        i = i + 1
    }
    c.check("ap.size", m.size == 40)
    var ok: Boolean = true
    i = 0
    while (i < 40) {
        if (m.get(1 + i * 16) != i) { ok = false }
        i = i + 1
    }
    c.check("ap.allValues", ok)
    c.check("ap.remove", m.remove(1 + 20 * 16) == 20)
    c.check("ap.sizeAfter", m.size == 39)
    // 步长 1 的稠密键
    var n: HashMap<Int, Int> = HashMap<Int, Int>()
    i = 0
    while (i < 64) {
        n.put(i, i)
        i = i + 1
    }
    ok = true
    i = 0
    while (i < 64) {
        if (n.get(i) != i) { ok = false }
        i = i + 1
    }
    c.check("ap.denseKeys", n.size == 64 && ok)
}

// ── 17. 大量不同字符串键 ──

fun testManyStringKeys(c: Checker): Unit {
    var m: HashMap<String, Int> = HashMap<String, Int>()
    var i: Int = 0
    var ok: Boolean = true
    while (i < 200) {
        var k: String = "key-" + i + "-suffix"
        m.put(k, i)
        i = i + 1
    }
    c.check("sk.size", m.size == 200)
    i = 0
    while (i < 200) {
        if (m.get("key-" + i + "-suffix") != i) { ok = false }
        i = i + 1
    }
    c.check("sk.allValues", ok)
    c.check("sk.containsValue", m.containsValue(199))
    c.check("sk.notContainsValue", m.containsValue(200) == false)
    c.check("sk.keysCount", m.keys().size == 200)
    // 删除后再取
    m.remove("key-0-suffix")
    c.check("sk.afterRemove", m.size == 199 && m.get("key-0-suffix") == null)
    c.check("sk.afterRemoveNeighbor", m.get("key-1-suffix") == 1)
}

// ── 18. Map 接口多态 ──

fun testPolymorphicMap(c: Checker): Unit {
    // 以接口类型持有实现，验证 : Map<K, V> 继承生效
    var m: Map<String, Int> = HashMap<String, Int>()
    c.check("pm.isEmpty", m.isEmpty())
    c.check("pm.getSize", m.getSize() == 0)
    m.put("a", 1)
    m.put("b", 2)
    c.check("pm.getSize2", m.getSize() == 2)
    c.check("pm.get", m.get("a") == 1)
    c.check("pm.getMiss", m.get("zz") == null)
    c.check("pm.getOrDefault", m.getOrDefault("zz", 5) == 5)
    c.check("pm.containsKey", m.containsKey("b"))
    c.check("pm.notContains", m.containsKey("zz") == false)
    c.check("pm.containsValue", m.containsValue(2))
    c.check("pm.remove", m.remove("a") == 1)
    c.check("pm.sizeAfter", m.getSize() == 1)
    c.check("pm.keys", m.keys().size == 1)
    c.check("pm.values", m.values().size == 1)
    c.check("pm.notEmpty", m.isEmpty() == false)
    m.clear()
    c.check("pm.cleared", m.getSize() == 0 && m.isEmpty())
    c.check("pm.toString", m.toString() == "{}")
}

// ── 19. 接口类型的混合调用（Map 变量 + HashMap 方法）──

fun testMixedInterfaceCalls(c: Checker): Unit {
    var m: HashMap<String, Int> = HashMap<String, Int>()
    m.put("a", 1)
    var viaInterface: Map<String, Int> = m
    c.check("mi.sameInstance", viaInterface.get("a") == 1)
    m.put("a", 2)
    c.check("mi.reflected", viaInterface.get("a") == 2)
    c.check("mi.sizeMatch", m.size == viaInterface.getSize())
}

// ── 20. HashMapUtils 工厂 ──

fun testHashMapUtils(c: Checker): Unit {
    var e: HashMap<String, Int> = HashMapUtils.emptyMap<String, Int>()
    c.check("hu.emptySize", e.size == 0)
    c.check("hu.emptyIsEmpty", e.isEmpty())

    var mu: HashMap<String, Int> = HashMapUtils.mutableMapOf<String, Int>("a", 1, "b", 2)
    c.check("hu.mutableSize", mu.size == 2)
    c.check("hu.mutableA", mu.get("a") == 1)
    c.check("hu.mutableB", mu.get("b") == 2)
    mu.put("c", 3)
    c.check("hu.mutablePut", mu.size == 3 && mu.get("c") == 3)

    var mo: HashMap<String, Int> = HashMapUtils.mapOf<String, Int>("x", 10, "y", 20)
    c.check("hu.mapSize", mo.size == 2)
    c.check("hu.mapX", mo.get("x") == 10)
    c.check("hu.mapY", mo.get("y") == 20)

    // 单对
    var one: HashMap<String, Int> = HashMapUtils.mapOf<String, Int>("only", 1)
    c.check("hu.single", one.size == 1 && one.get("only") == 1)

    // 空工厂调用
    var none: HashMap<String, Int> = HashMapUtils.mapOf<String, Int>()
    c.check("hu.noArgs", none.size == 0)

    // Int 键
    var ik: HashMap<Int, String> = HashMapUtils.mapOf<Int, String>(1, "one", 2, "two")
    c.check("hu.intKeys", ik.size == 2 && ik.get(2) == "two")
}

// ── 21. 键冲突但值不同（同哈希不同键）──

fun testCollidingKeys(c: Checker): Unit {
    // toStr 规范形式不同的键，逐个写入后全部可区分
    var m: HashMap<String, Int> = HashMap<String, Int>()
    var pairs: List<String> = arrayListOf<String>()
    pairs.add("1")
    pairs.add("10")
    pairs.add("100")
    pairs.add("1000")
    pairs.add("a1")
    pairs.add("a10")
    pairs.add("ab")
    pairs.add("ba")
    pairs.add("abc")
    pairs.add("bca")
    var i: Int = 0
    while (i < pairs.size) {
        m.put(pairs[i], i)
        i = i + 1
    }
    c.check("ck.size", m.size == pairs.size)
    var ok: Boolean = true
    i = 0
    while (i < pairs.size) {
        if (m.get(pairs[i]) != i) { ok = false }
        i = i + 1
    }
    c.check("ck.distinct", ok)
    c.check("ck.containsAll", m.containsKey("abc") && m.containsKey("1"))
    c.check("ck.notContains", m.containsKey("10000") == false)
}

// ── 22. 大键空间下的删除密集场景 ──

fun testStressRemoveInsert(c: Checker): Unit {
    var m: HashMap<Int, Int> = HashMap<Int, Int>()
    var i: Int = 0
    while (i < 200) {
        m.put(i, i)
        i = i + 1
    }
    // 交替删除 / 重插
    i = 0
    while (i < 100) {
        m.remove(i)
        m.put(1000 + i, 1000 + i)
        i = i + 1
    }
    c.check("ss.size", m.size == 200)
    var ok: Boolean = true
    i = 100
    while (i < 200) {
        if (m.get(i) != i) { ok = false }
        i = i + 1
    }
    c.check("ss.tailKept", ok)
    i = 0
    while (i < 100) {
        if (m.containsKey(i)) { ok = false }
        i = i + 1
    }
    c.check("ss.headRemoved", ok)
    ok = true
    i = 0
    while (i < 100) {
        if (m.get(1000 + i) != (1000 + i)) { ok = false }
        i = i + 1
    }
    c.check("ss.refillKept", ok)
    c.check("ss.keysCount", m.keys().size == 200)
}

// ── main ──

fun main(): Unit {
    var c: Checker = Checker()
    println("T01"); testEmpty(c)
    println("T02"); testPutGet(c)
    println("T03"); testOverwrite(c)
    println("T04"); testGetOrDefault(c)
    println("T05"); testContains(c)
    println("T06"); testRemove(c)
    println("T07"); testRemoveThenPut(c)
    println("T08"); testClear(c)
    println("T09"); testToString(c)
    println("T10"); testKeysValues(c)
    println("T11"); testNullValue(c)
    println("T12"); testIntKeys(c)
    println("T13"); testBoolKeys(c)
    println("T14"); testRehash(c)
    println("T15"); testTombstoneCompaction(c)
    println("T16"); testArithmeticProgressionKeys(c)
    println("T17"); testManyStringKeys(c)
    println("T18"); testPolymorphicMap(c)
    println("T19"); testMixedInterfaceCalls(c)
    println("T20"); testHashMapUtils(c)
    println("T21"); testCollidingKeys(c)
    println("T22"); testStressRemoveInsert(c)
    println("TEND"); c.summary()
}
