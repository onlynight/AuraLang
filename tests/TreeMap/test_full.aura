package test

import aura.lang.collection.TreeMap

fun main(): Int {
    var m = TreeMap<Int, Int>()
    m.put(1, 10)
    m.put(2, 20)
    m.put(3, 30)
    
    assert(m.getSize() == 3, "TreeMap size should be 3")
    assert(m.get(1) == 10, "TreeMap get(1) should be 10")
    assert(m.get(2) == 20, "TreeMap get(2) should be 20")
    assert(m.get(3) == 30, "TreeMap get(3) should be 30")
    assert(m.get(4) == null, "TreeMap get(4) should be null")
    
    // Test containsKey
    assert(m.containsKey(1) == true, "TreeMap should contain key 1")
    assert(m.containsKey(4) == false, "TreeMap should not contain key 4")
    
    // Test overwrite
    m.put(1, 100)
    assert(m.getSize() == 3, "TreeMap size should still be 3 after overwrite")
    assert(m.get(1) == 100, "TreeMap get(1) after overwrite should be 100")
    
    // Test remove
    m.removeItem(2)
    assert(m.getSize() == 2, "TreeMap size after remove should be 2")
    assert(m.get(2) == null, "TreeMap get(2) after remove should be null")
    
    // Test clear
    m.clear()
    assert(m.isEmpty() == true, "TreeMap should be empty after clear")
    
    println("TreeMap tests passed")
    return 0
}
