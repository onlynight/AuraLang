    println("=== Phase 2 Sema/HIR Tests ===")
    println()

    val f1 = testTypeFromName()
    val f2 = testTypeQueries()
    val f3 = testTypeAssignability()
    val f4 = testFuncTypes()
    val f5 = testSymbolTableScopes()
    val f6 = testSymbolTableInsertFind()
    val f7 = testSymbolTableScopeChain()
    val f8 = testSymbolTableGlobalIndex()
    val f9 = testTypeInfo()
    val f10 = testTypeCheckerBasic()
    val f11 = testTypeCheckerMismatch()
    val f12 = testHirLiterals()
    val f13 = testHirIdentifiers()
    val f14 = testHirBinary()
    val f15 = testHirCall()
    val f16 = testHirBlockStmts()
    val f17 = testHirFunctionDecl()
    val f18 = testHirDump()
    val f19 = testHirMember()
    val f20 = testHirUnary()

    val totalFailures: Int = f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8 + f9 + f10 + f11 + f12 + f13 + f14 + f15 + f16 + f17 + f18 + f19 + f20

    println()
    println("=== Summary ===")
    println("Total failures: " + toStr(totalFailures))

    if (totalFailures == 0) {
        println("RESULT: PASS")
    } else {
        println("RESULT: FAIL (" + toStr(totalFailures) + ")")
    }
}
