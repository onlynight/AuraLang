// aura:///tests/hat_verification_tests.aura
// HAT v2.0 验证测试 — 双路径一致性 + 性能基准
//
// 运行: aura run tests/hat_verification_tests.aura

import aura.lang.String
import "../aura/compiler/aura/lang/compiler/test/TestRunner.aura"
import "../aura/compiler/aura/lang/compiler/mir/SsaMir.aura"
import "../aura/compiler/aura/lang/compiler/hir/hat/HatParser.aura"
import "../aura/compiler/aura/lang/compiler/hir/hat/HatSerializer.aura"

fun main() {
    println("=== HAT v2.0 Verification Tests ===")
    println()

    val t = TestRunner()

    // ── 测试 1: 双路径一致性 (HAT ↔ PHIR) ──
    t.begin("HatVerification.dualPathConsistency")

    // 同一个源码的 HAT 表示
    val hatText: String =
        "; module main target x86_64\n" +
        "; schema=HAT/2.0\n" +
        "\n" +
        "@fn main() -> Unit\n" +
        "  bb entry:\n" +
        "    @t0 = @const_str \"Hello, World!\" : String\n" +
        "    @ret () : Unit\n"

    val ssa: MirSsaProgram = HatParserUtils.parseHat(hatText)
    t.assertEq(ssa.functionCount, 1, "HAT has 1 function")
    t.assertTrue(ssa.valueCount >= 2, "HAT has values")

    // ── 测试 2: SSA 属性验证 ──
    t.begin("HatVerification.ssaProperties")

    val loopHat: String =
        "; module main target x86_64\n" +
        "; schema=HAT/2.0\n" +
        "\n" +
        "@fn sum_to(@n: Int) -> Int\n" +
        "  bb entry:\n" +
        "    @sum = @i32_const 0 : Int\n" +
        "    @i@0 = @i32_const 1 : Int\n" +
        "    @br @check\n" +
        "\n" +
        "  bb check:\n" +
        "    @sum@1 = @phi(@sum, @sum@2) : Int\n" +
        "    @i@1 = @phi(@i@0, @i@2) : Int\n" +
        "    @t0 = @icmp @i32_sle(@i@1, @n) : Bool\n" +
        "    @br_if @t0 => @body, @exit\n" +
        "\n" +
        "  bb body:\n" +
        "    @sum@2 = @add(@sum@1, @i@1) : Int\n" +
        "    @t1 = @i32_const 1 : Int\n" +
        "    @i@2 = @add(@i@1, @t1) : Int\n" +
        "    @br @check\n" +
        "\n" +
        "  bb exit:\n" +
        "    @ret @sum@1 : Int\n"

    val loopSsa: MirSsaProgram = HatParserUtils.parseHat(loopHat)
    t.assertEq(loopSsa.functionCount, 1, "loop has 1 function")
    t.assertEq(loopSsa.blockCount, 4, "loop has 4 blocks (entry, check, body, exit)")

    // ── 测试 3: 性能基准 ──
    t.begin("HatVerification.performance")

    // 生成测试文件
    var testHat: String = "; module perf target x86_64\n; schema=HAT/2.0\n\n"

    // 生成 100 个简单函数
    var fnCount: Int = 100
    var fi: Int = 0
    while (fi < fnCount) {
        testHat = testHat + "@fn fn" + toStr(fi) + "() -> Unit\n"
        testHat = testHat + "  bb entry:\n"
        testHat = testHat + "    @ret () : Unit\n"
        testHat = testHat + "\n"
        fi = fi + 1
    }

    // 解析测试
    val parsed: MirSsaProgram = HatParserUtils.parseHat(testHat)
    t.assertEq(parsed.functionCount, fnCount, "parsed " + toStr(fnCount) + " functions")

    // 序列化测试
    val serialized: String = HatSerializerUtils.serializeHat(parsed, "perf")
    t.assertTrue(serialized.length > 0, "serialized output is not empty")

    // ── 测试 4: 格式规范验证 ──
    t.begin("HatVerification.formatSpec")

    val specHat: String =
        "; module main target x86_64\n" +
        "; schema=HAT/2.0\n" +
        "\n" +
        "@extern printf(@fmt: String) -> Unit\n" +
        "\n" +
        "@fn main() -> Unit\n" +
        "  bb entry:\n" +
        "    @t0 = @const_str \"Hello\" : String\n" +
        "    @t1 = @call @printf(@t0) : Unit\n" +
        "    @ret () : Unit\n"

    val specResult: MirSsaProgram = HatParserUtils.parseHat(specHat)
    t.assertEq(specResult.functionCount, 1, "spec has 1 function")
    t.assertTrue(specResult.valueCount >= 3, "spec has values (const, call, ret)")

    // ── 测试 5: 类型系统验证 ──
    t.begin("HatVerification.typeSystem")

    val typeHat: String =
        "; module main target x86_64\n" +
        "; schema=HAT/2.0\n" +
        "\n" +
        "@fn types() -> Unit\n" +
        "  bb entry:\n" +
        "    @i = @i32_const 42 : Int\n" +
        "    @f = @f64_const 3.14 : Float\n" +
        "    @b = @bool_const true : Bool\n" +
        "    @s = @const_str \"hello\" : String\n" +
        "    @u = @null : Unit\n" +
        "    @ret () : Unit\n"

    val typeResult: MirSsaProgram = HatParserUtils.parseHat(typeHat)
    t.assertEq(typeResult.functionCount, 1, "types test has 1 function")
    t.assertTrue(typeResult.valueCount >= 5, "types test has 5+ values")

    // ── 报告结果 ──
    val failures = t.report()
    println()
    if (failures == 0) {
        println("RESULT: PASS — All HAT verification tests passed")
    } else {
        println("RESULT: FAIL (" + toStr(failures) + " failures)")
    }
}
