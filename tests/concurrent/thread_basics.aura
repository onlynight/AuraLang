// ════════════════════════════════════════════════════════════
// 线程基础测试 — Thread spawn / join / sleep / id / parallelism
// ════════════════════════════════════════════════════════════
// 验证底层床架线程重构后，多线程调度、阻塞等待、休眠、
// 线程标识符与并行度查询均工作正常。
//
// 验证命令：
//   aura build tests/concurrent/thread_basics.aura --aot \
//     --output build/aot-bin/concurrent/thread_basics.exe
//   build/aot-bin/concurrent/thread_basics.exe
//   # 期望输出 "concurrent.thread_basics ok"，退出码 0

import aura.lang.concurrent.*

// ── 线程函数（Thread.spawn 的 trampoline 入口）──────────

fun worker(n: Int): Int {
    return n * 2
}

fun add(a: Int): Int {
    return a + 100
}

fun sleepAndReturn(n: Int): Int {
    Thread.sleep(50)
    return n + 1
}

fun threadIdCapture(): Int {
    val tid = Thread.id()
    return tid
}

// ════════════════════════════════════════════════════════════
// 主函数
// ════════════════════════════════════════════════════════════

fun main(): Int {
    var passed = 0
    var total = 0

    // ── 1. 基本 spawn + join ──────────────────────────────
    total = total + 1
    println("--- 测试 1: 基本 spawn + join ---")
    do {
        val t = Thread.spawn(worker, 42)
        val r = Thread.join(t)
        if (r == 84) {
            println("  worker(42) = 84 ✓")
        } else {
            println("  FAIL: worker(42) = " + r.toString())
            return 1
        }
        passed = passed + 1
    } while (false)

    // ── 2. 多线程并发 ──────────────────────────────────────
    total = total + 1
    println("--- 测试 2: 多线程并发 ---")
    do {
        val t1 = Thread.spawn(worker, 10)
        val t2 = Thread.spawn(worker, 20)
        val t3 = Thread.spawn(worker, 30)
        val r1 = Thread.join(t1)
        val r2 = Thread.join(t2)
        val r3 = Thread.join(t3)
        val sum = r1 + r2 + r3
        if (sum == 120) {
            println("  worker(10)+worker(20)+worker(30) = " + sum.toString())
        } else {
            println("  FAIL: sum = " + sum.toString())
            return 1
        }
        passed = passed + 1
    } while (false)

    // ── 3. 线程内休眠 ──────────────────────────────────────
    total = total + 1
    println("--- 测试 3: 线程内休眠 ---")
    do {
        val t = Thread.spawn(sleepAndReturn, 99)
        val r = Thread.join(t)
        if (r == 100) {
            println("  sleepAndReturn(99) = 100 ✓")
        } else {
            println("  FAIL: r = " + r.toString())
            return 1
        }
        passed = passed + 1
    } while (false)

    // ── 4. 线程 ID ─────────────────────────────────────────
    total = total + 1
    println("--- 测试 4: 线程 ID ---")
    do {
        val mainId = Thread.id()
        if (mainId != -1) {
            println("  主线程 ID = " + mainId.toString())
        } else {
            println("  FAIL: mainId = -1")
            return 1
        }
        val t = Thread.spawn(threadIdCapture)
        val threadId = Thread.join(t)
        if (threadId != -1 && threadId != mainId) {
            println("  工作线程 ID = " + threadId.toString())
        } else {
            println("  FAIL: threadId = " + threadId.toString())
            return 1
        }
        passed = passed + 1
    } while (false)

    // ── 5. 并行度查询 ──────────────────────────────────────
    total = total + 1
    println("--- 测试 5: 并行度查询 ---")
    do {
        val par = Thread.parallelism()
        val cores = Thread.availableCores()
        if (par > 0 && cores > 0) {
            println("  parallelism=" + par.toString() + ", availableCores=" + cores.toString())
        } else {
            println("  FAIL: parallelism=" + par.toString())
            return 1
        }
        passed = passed + 1
    } while (false)

    // ── 6. Thread.sleep 不阻塞其他线程 ──────────────────────
    total = total + 1
    println("--- 测试 6: sleep 不阻塞其他线程 ---")
    do {
        val t1 = Thread.spawn(sleepAndReturn, 1)
        val t2 = Thread.spawn(worker, 2)
        val r1 = Thread.join(t1)
        val r2 = Thread.join(t2)
        if (r1 == 2 && r2 == 4) {
            println("  独立线程: r1=2, r2=4 ✓")
        } else {
            println("  FAIL: r1=" + r1.toString() + " r2=" + r2.toString())
            return 1
        }
        passed = passed + 1
    } while (false)

    // ── 7. 大量线程压力 ────────────────────────────────────
    total = total + 1
    println("--- 测试 7: 大量线程压力 ---")
    do {
        var spawned = 0
        for (i in 0..19) {
            val t = Thread.spawn(add, i)
            spawned = spawned + t
        }
        if (spawned > 0) {
            println("  创建了 20 个线程，总计 ID=" + spawned.toString())
        } else {
            println("  FAIL: spawned = 0")
            return 1
        }
        passed = passed + 1
    } while (false)

    // ── 总结 ────────────────────────────────────────────────
    println("")
    println("===================================================")
    println("  thread_basics: " + passed.toString() + "/" + total.toString() + " passed")
    if (passed == total) {
        println("concurrent.thread_basics ok")
        return 0
    } else {
        println("concurrent.thread_basics FAIL")
        return 1
    }
}
