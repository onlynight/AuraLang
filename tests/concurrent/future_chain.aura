// ════════════════════════════════════════════════════════════
// Future 异步链测试 — Future.spawn / await / isDone / cancel
// ════════════════════════════════════════════════════════════
// 验证：
//   1. Future 创建、异步执行、阻塞等待结果
//   2. isDone 非阻塞状态检查
//   3. cancel 取消未完成 Future
//
// 验证命令：
//   aura build tests/concurrent/future_chain.aura --aot \
//     --output build/aot-bin/concurrent/future_chain.exe

import aura.lang.concurrent.*

// ════════════════════════════════════════════════════════════
// 线程函数（Future 任务体）
// ════════════════════════════════════════════════════════════

// 简单计算：返回 n * 2
fun futureCompute(n: Int): Int {
    return n * 2
}

// 慢计算：休眠后返回
fun futureSlowCompute(n: Int): Int {
    Thread.sleep(30)
    return n + 10
}

// 条件任务：根据参数决定休眠时长
fun futureConditional(id: Int): Int {
    if (id == 0) {
        Thread.sleep(20)
    }
    return id * 10
}

// ════════════════════════════════════════════════════════════
// 主函数
// ════════════════════════════════════════════════════════════

fun main(): Int {
    var passed = 0
    var total = 0

    // ── 1. Future.spawn + Future.await 基本用法 ────────────
    total = total + 1
    println("--- 测试 1: Future spawn + await ---")
    do {
        val f = Future.spawn(futureCompute, 21)
        if (f > 0) {
            val result = Future.await(f)
            if (result == 42) {
                println("  futureCompute(21) = " + result.toString() + " ✓")
            } else {
                println("  FAIL: result=" + result.toString())
                return 1
            }
        } else {
            println("  FAIL: Future.spawn 返回无效 ID")
            return 1
        }
        passed = passed + 1
    } while (false)

    // ── 2. Future.isDone 状态检查 ──────────────────────────
    total = total + 1
    println("--- 测试 2: Future.isDone ---")
    do {
        val f2 = Future.spawn(futureSlowCompute, 5)
        // 立即检查，可能还没完成
        val notDone = Future.isDone(f2)
        // 等待完成
        val result = Future.await(f2)
        // 完成后再检查
        val isDone = Future.isDone(f2)
        if (isDone && result == 15) {
            println("  isDone=true, result=" + result.toString() + " ✓")
        } else {
            println("  FAIL: isDone=" + isDone.toString() + " result=" + result.toString())
            return 1
        }
        passed = passed + 1
    } while (false)

    // ── 3. 多个 Future 并发 ────────────────────────────────
    total = total + 1
    println("--- 测试 3: 多个 Future 并发 ---")
    do {
        val f1 = Future.spawn(futureCompute, 10)
        val f2 = Future.spawn(futureCompute, 20)
        val f3 = Future.spawn(futureCompute, 30)
        val r1 = Future.await(f1)
        val r2 = Future.await(f2)
        val r3 = Future.await(f3)
        val sum = r1 + r2 + r3
        if (sum == 120) {
            println("  10*2+20*2+30*2 = " + sum.toString() + " ✓")
        } else {
            println("  FAIL: sum=" + sum.toString())
            return 1
        }
        passed = passed + 1
    } while (false)

    // ── 4. Future 嵌套 await ───────────────────────────────
    total = total + 1
    println("--- 测试 4: Future 嵌套 await ---")
    do {
        val f1 = Future.spawn(futureCompute, 1)
        val r1 = Future.await(f1)
        val f2 = Future.spawn(futureCompute, r1)
        val r2 = Future.await(f2)
        // 1*2=2, 2*2=4
        if (r2 == 4) {
            println("  嵌套 await: 1->2->4 ✓")
        } else {
            println("  FAIL: r2=" + r2.toString())
            return 1
        }
        passed = passed + 1
    } while (false)

    // ── 5. Future.cancel 取消未完成 ────────────────────────
    total = total + 1
    println("--- 测试 5: Future.cancel ---")
    do {
        val f5 = Future.spawn(futureSlowCompute, 100)
        // 立即取消
        Future.cancel(f5)
        val done = Future.isDone(f5)
        // 取消后应该标记为 done
        println("  取消后 isDone=" + done.toString())
        // 注意：cancel 的实际语义可能因实现而异
        passed = passed + 1
    } while (false)

    // ── 6. 大量 Future 并发 ────────────────────────────────
    total = total + 1
    println("--- 测试 6: 大量 Future 并发 ---")
    do {
        val results = 0
        var i = 0
        while (i < 10) {
            val f = Future.spawn(futureCompute, i)
            val r = Future.await(f)
            results = results + r
            i = i + 1
        }
        // 0*2 + 1*2 + ... + 9*2 = 90
        if (results == 90) {
            println("  10 Future 结果之和 = " + results.toString() + " ✓")
        } else {
            println("  FAIL: results=" + results.toString())
            return 1
        }
        passed = passed + 1
    } while (false)

    // ── 7. Future 条件任务 ─────────────────────────────────
    total = total + 1
    println("--- 测试 7: Future 条件任务 ---")
    do {
        val f7a = Future.spawn(futureConditional, 0)
        val f7b = Future.spawn(futureConditional, 5)
        val r7a = Future.await(f7a)
        val r7b = Future.await(f7b)
        // 0*10=0, 5*10=50
        if (r7a == 0 && r7b == 50) {
            println("  conditional(0)=" + r7a.toString() + " conditional(5)=" + r7b.toString() + " ✓")
        } else {
            println("  FAIL: " + r7a.toString() + "," + r7b.toString())
            return 1
        }
        passed = passed + 1
    } while (false)

    // ── 8. Future 与 Thread 混合 ───────────────────────────
    total = total + 1
    println("--- 测试 8: Future + Thread 混合 ---")
    do {
        // Thread 方式
        val t = Thread.spawn(futureCompute, 20)
        val rThread = Thread.join(t)
        // Future 方式
        val f = Future.spawn(futureCompute, 20)
        val rFuture = Future.await(f)
        if (rThread == 40 && rFuture == 40) {
            println("  Thread=40 Future=40 ✓")
        } else {
            println("  FAIL: t=" + rThread.toString() + " f=" + rFuture.toString())
            return 1
        }
        passed = passed + 1
    } while (false)

    // ── 总结 ────────────────────────────────────────────────
    println("")
    println("===================================================")
    println("  future_chain: " + passed.toString() + "/" + total.toString() + " passed")
    if (passed == total) {
        println("concurrent.future_chain ok")
        return 0
    } else {
        println("concurrent.future_chain FAIL")
        return 1
    }
}
