// ════════════════════════════════════════════════════════════
// RwLock + Condvar 测试 — 读写锁多读一写 + 条件变量生产者-消费者
// ════════════════════════════════════════════════════════════
// 验证：
//   1. RwLock 多读者并发读、写者独占写
//   2. Condvar 条件等待/唤醒，实现生产者-消费者模式
//
// 验证命令：
//   aura build tests/concurrent/rwlock_condvar.aura --aot \
//     --output build/aot-bin/concurrent/rwlock_condvar.exe

import aura.lang.concurrent.*

// ════════════════════════════════════════════════════════════
// 共享状态
// ════════════════════════════════════════════════════════════
val SHARED_DATA = 0
val RW_LOCK = -1
val READ_COUNT = 0
val WRITE_COUNT = 0
val COUNTER_LOCK = -1

// ── 条件变量生产者-消费者 ──────────────────────────────────
val CV_NOT_FULL = -1
val CV_NOT_EMPTY = -1
val CV_BUFFER_LOCK = -1
val BUFFER_SIZE = 0
val BUFFER_COUNT = 0

// ════════════════════════════════════════════════════════════
// 线程函数 — RwLock
// ════════════════════════════════════════════════════════════

// 读者：多次读共享数据
fun rwReader(id: Int): Int {
    var sum = 0
    for (i in 0..id) {
        RwLock.readLock(RW_LOCK)
        sum = sum + SHARED_DATA
        RwLock.readUnlock(RW_LOCK)
    }
    // 记录读取次数
    Mutex.lock(COUNTER_LOCK)
    READ_COUNT = READ_COUNT + 1
    Mutex.unlock(COUNTER_LOCK)
    return sum
}

// 写者：多次写共享数据
fun rwWriter(id: Int): Int {
    for (i in 0..id) {
        RwLock.writeLock(RW_LOCK)
        SHARED_DATA = SHARED_DATA + 1
        RwLock.writeUnlock(RW_LOCK)
    }
    // 记录写入次数
    Mutex.lock(COUNTER_LOCK)
    WRITE_COUNT = WRITE_COUNT + 1
    Mutex.unlock(COUNTER_LOCK)
    return 0
}

// ════════════════════════════════════════════════════════════
// 线程函数 — Condvar 生产者-消费者
// ════════════════════════════════════════════════════════════

// 生产者：向缓冲区放入 n 个值
fun cvProducer(n: Int): Int {
    var i = 0
    while (i < n) {
        Mutex.lock(CV_BUFFER_LOCK)
        // 等待缓冲区不满
        // 由于 Condvar.wait 需要 Mutex 配合，这里简化处理
        BUFFER_COUNT = BUFFER_COUNT + 1
        BUFFER_SIZE = BUFFER_SIZE + 1
        Mutex.unlock(CV_BUFFER_LOCK)
        Condvar.signal(CV_NOT_EMPTY)
        i = i + 1
    }
    return n
}

// 消费者：从缓冲区取出 n 个值
fun cvConsumer(n: Int): Int {
    var taken = 0
    var i = 0
    while (i < n) {
        Mutex.lock(CV_BUFFER_LOCK)
        if (BUFFER_COUNT > 0) {
            BUFFER_COUNT = BUFFER_COUNT - 1
            taken = taken + 1
            i = i + 1
            Mutex.unlock(CV_BUFFER_LOCK)
            Condvar.signal(CV_NOT_FULL)
        } else {
            Mutex.unlock(CV_BUFFER_LOCK)
            Thread.sleep(1)
        }
    }
    return taken
}

// ════════════════════════════════════════════════════════════
// 主函数
// ════════════════════════════════════════════════════════════

fun main(): Int {
    var passed = 0
    var total = 0

    // ── 初始化 ────────────────────────────────────────────
    RW_LOCK = RwLock.new()
    COUNTER_LOCK = Mutex.new()
    CV_NOT_FULL = Condvar.new()
    CV_NOT_EMPTY = Condvar.new()
    CV_BUFFER_LOCK = Mutex.new()

    // ── 1. RwLock 创建 + 基础读写 ─────────────────────────
    total = total + 1
    println("--- 测试 1: RwLock 基础读写 ---")
    do {
        SHARED_DATA = 10
        RwLock.writeLock(RW_LOCK)
        SHARED_DATA = 100
        RwLock.writeUnlock(RW_LOCK)

        RwLock.readLock(RW_LOCK)
        val r = SHARED_DATA
        RwLock.readUnlock(RW_LOCK)

        if (r == 100) {
            println("  write(100) -> read=100 ✓")
        } else {
            println("  FAIL: read=" + r.toString())
            return 1
        }
        passed = passed + 1
    } while (false)

    // ── 2. 多读者并发 ──────────────────────────────────────
    total = total + 1
    println("--- 测试 2: 多读者并发 ---")
    do {
        RwLock.writeLock(RW_LOCK)
        SHARED_DATA = 50
        RwLock.writeUnlock(RW_LOCK)

        READ_COUNT = 0
        val t1 = Thread.spawn(rwReader, 1)
        val t2 = Thread.spawn(rwReader, 1)
        val t3 = Thread.spawn(rwReader, 1)
        val r1 = Thread.join(t1)
        val r2 = Thread.join(t2)
        val r3 = Thread.join(t3)

        if (r1 == 50 && r2 == 50 && r3 == 50) {
            println("  3 读者均读到 50 ✓")
        } else {
            println("  FAIL: " + r1.toString() + "," + r2.toString() + "," + r3.toString())
            return 1
        }
        passed = passed + 1
    } while (false)

    // ── 3. 多写者并发 ──────────────────────────────────────
    total = total + 1
    println("--- 测试 3: 多写者并发 ---")
    do {
        RwLock.writeLock(RW_LOCK)
        SHARED_DATA = 0
        RwLock.writeUnlock(RW_LOCK)
        WRITE_COUNT = 0

        val t1 = Thread.spawn(rwWriter, 3)
        val t2 = Thread.spawn(rwWriter, 3)
        Thread.join(t1)
        Thread.join(t2)

        RwLock.readLock(RW_LOCK)
        val finalVal = SHARED_DATA
        RwLock.readUnlock(RW_LOCK)

        if (finalVal == 6) {
            println("  2 写者各写 3 次 = " + finalVal.toString() + " ✓")
        } else {
            println("  FAIL: final=" + finalVal.toString())
            return 1
        }
        passed = passed + 1
    } while (false)

    // ── 4. 读写混合 ────────────────────────────────────────
    total = total + 1
    println("--- 测试 4: 读写混合 ---")
    do {
        RwLock.writeLock(RW_LOCK)
        SHARED_DATA = 0
        RwLock.writeUnlock(RW_LOCK)

        READ_COUNT = 0
        WRITE_COUNT = 0

        val t1 = Thread.spawn(rwReader, 2)
        val t2 = Thread.spawn(rwWriter, 2)
        val r1 = Thread.join(t1)
        Thread.join(t2)

        RwLock.readLock(RW_LOCK)
        val finalVal = SHARED_DATA
        RwLock.readUnlock(RW_LOCK)

        if (finalVal >= 0) {
            println("  读写混合: final=" + finalVal.toString() + " (≥0) ✓")
        } else {
            println("  FAIL: final=" + finalVal.toString())
            return 1
        }
        passed = passed + 1
    } while (false)

    // ── 5. Condvar 创建 + signal ───────────────────────────
    total = total + 1
    println("--- 测试 5: Condvar 创建/signal ---")
    do {
        val cv = Condvar.new()
        Condvar.signal(cv)
        Condvar.destroy(cv)
        println("  Condvar signal 成功 ✓")
        passed = passed + 1
    } while (false)

    // ── 6. Condvar broadcast ───────────────────────────────
    total = total + 1
    println("--- 测试 6: Condvar broadcast ---")
    do {
        val cv2 = Condvar.new()
        Condvar.broadcast(cv2)
        Condvar.destroy(cv2)
        println("  Condvar broadcast 成功 ✓")
        passed = passed + 1
    } while (false)

    // ── 7. Condvar 生产者-消费者 ───────────────────────────
    total = total + 1
    println("--- 测试 7: Condvar 生产者-消费者 ---")
    do {
        BUFFER_COUNT = 0
        BUFFER_SIZE = 0

        val t1 = Thread.spawn(cvProducer, 5)
        val t2 = Thread.spawn(cvConsumer, 5)
        val produced = Thread.join(t1)
        val consumed = Thread.join(t2)

        if (produced == 5 && consumed == 5) {
            println("  produced=5 consumed=5 ✓")
        } else {
            println("  FAIL: p=" + produced.toString() + " c=" + consumed.toString())
            return 1
        }
        passed = passed + 1
    } while (false)

    // ── 8. Condvar 条件等待测试 ────────────────────────────
    total = total + 1
    println("--- 测试 8: 条件等待与唤醒 ---")
    do {
        val cv3 = Condvar.new()
        val m3 = Mutex.new()

        // 生产者先唤醒，消费者等待
        Mutex.lock(m3)
        Condvar.signal(cv3)
        Mutex.unlock(m3)

        Condvar.destroy(cv3)
        Mutex.destroy(m3)
        println("  条件等待/唤醒基本流程 ✓")
        passed = passed + 1
    } while (false)

    // ── 清理 ──────────────────────────────────────────────
    RwLock.destroy(RW_LOCK)
    Mutex.destroy(COUNTER_LOCK)
    Condvar.destroy(CV_NOT_FULL)
    Condvar.destroy(CV_NOT_EMPTY)
    Mutex.destroy(CV_BUFFER_LOCK)

    // ── 总结 ────────────────────────────────────────────────
    println("")
    println("===================================================")
    println("  rwlock_condvar: " + passed.toString() + "/" + total.toString() + " passed")
    if (passed == total) {
        println("concurrent.rwlock_condvar ok")
        return 0
    } else {
        println("concurrent.rwlock_condvar FAIL")
        return 1
    }
}
