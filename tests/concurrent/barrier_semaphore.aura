// ════════════════════════════════════════════════════════════
// Barrier + Semaphore 测试 — 多线程屏障同步与信号量资源限制
// ════════════════════════════════════════════════════════════
// 验证：
//   1. Barrier 多线程同步点：所有线程到达后一起释放
//   2. Semaphore 资源计数限制：最多 N 个线程同时访问
//
// 验证命令：
//   aura build tests/concurrent/barrier_semaphore.aura --aot \
//     --output build/aot-bin/concurrent/barrier_semaphore.exe

import aura.lang.concurrent.*

// ════════════════════════════════════════════════════════════
// 共享状态
// ════════════════════════════════════════════════════════════
val BARRIER_COUNT = 0
val BARRIER_LOCK = -1
val SEM_COUNT = 0
val SEM_LOCK = -1

// ════════════════════════════════════════════════════════════
// 线程函数 — Barrier
// ════════════════════════════════════════════════════════════

// 屏障等待线程：等待所有线程到达同步点
fun barrierWaiter(bid: Int): Int {
    val result = Barrier.wait(bid)
    return result
}

// 多阶段屏障测试：等待第一轮，执行任务，等待第二轮
fun twoPhaseBarrier(bid: Int): Int {
    // 第一轮等待
    Barrier.wait(bid)
    // 执行任务（模拟工作）
    Thread.sleep(10)
    // 第二轮等待
    Barrier.wait(bid)
    return 0
}

// ════════════════════════════════════════════════════════════
// 线程函数 — Semaphore
// ════════════════════════════════════════════════════════════

// 信号量工作者：获取许可证，执行工作，释放许可证
fun semWorker(sid: Int): Int {
    Semaphore.acquire(sid)
    // 模拟工作
    Mutex.lock(SEM_LOCK)
    SEM_COUNT = SEM_COUNT + 1
    Mutex.unlock(SEM_LOCK)
    Thread.sleep(5)
    Semaphore.release(sid)
    return 0
}

// 信号量 tryAcquire 测试
fun semTryAcquireWorker(sid: Int): Int {
    val got = Semaphore.tryAcquire(sid)
    if (got) {
        Thread.sleep(5)
        Semaphore.release(sid)
    }
    return 0
}

// ════════════════════════════════════════════════════════════
// 主函数
// ════════════════════════════════════════════════════════════

fun main(): Int {
    var passed = 0
    var total = 0

    // ── 初始化 ────────────────────────────────────────────
    BARRIER_LOCK = Mutex.new()
    SEM_LOCK = Mutex.new()

    // ── 1. Barrier 创建 + 基础等待 ────────────────────────
    total = total + 1
    println("--- 测试 1: Barrier 基础等待 ---")
    do {
        val b = Barrier.new(3)
        val t1 = Thread.spawn(barrierWaiter, b)
        val t2 = Thread.spawn(barrierWaiter, b)
        val t3 = Thread.spawn(barrierWaiter, b)
        val r1 = Thread.join(t1)
        val r2 = Thread.join(t2)
        val r3 = Thread.join(t3)
        // Barrier.wait 返回到达的线程数
        if (r1 >= 0 && r2 >= 0 && r3 >= 0) {
            println("  3 线程屏障同步 ✓")
        } else {
            println("  FAIL: " + r1.toString() + "," + r2.toString() + "," + r3.toString())
            return 1
        }
        Barrier.destroy(b)
        passed = passed + 1
    } while (false)

    // ── 2. 两阶段屏障同步 ──────────────────────────────────
    total = total + 1
    println("--- 测试 2: 两阶段屏障 ---")
    do {
        val b2 = Barrier.new(3)
        val t1 = Thread.spawn(twoPhaseBarrier, b2)
        val t2 = Thread.spawn(twoPhaseBarrier, b2)
        val t3 = Thread.spawn(twoPhaseBarrier, b2)
        Thread.join(t1)
        Thread.join(t2)
        Thread.join(t3)
        println("  两阶段屏障同步完成 ✓")
        Barrier.destroy(b2)
        passed = passed + 1
    } while (false)

    // ── 3. 单线程屏障（自等待）─────────────────────────────
    total = total + 1
    println("--- 测试 3: 单线程屏障 ---")
    do {
        val b3 = Barrier.new(1)
        val r = Barrier.wait(b3)
        if (r >= 0) {
            println("  单线程屏障自等待 ✓")
        } else {
            println("  FAIL: r=" + r.toString())
            return 1
        }
        Barrier.destroy(b3)
        passed = passed + 1
    } while (false)

    // ── 4. 大量线程屏障 ────────────────────────────────────
    total = total + 1
    println("--- 测试 4: 大量线程屏障 ---")
    do {
        val b4 = Barrier.new(5)
        val t1 = Thread.spawn(barrierWaiter, b4)
        val t2 = Thread.spawn(barrierWaiter, b4)
        val t3 = Thread.spawn(barrierWaiter, b4)
        val t4 = Thread.spawn(barrierWaiter, b4)
        val t5 = Thread.spawn(barrierWaiter, b4)
        Thread.join(t1)
        Thread.join(t2)
        Thread.join(t3)
        Thread.join(t4)
        Thread.join(t5)
        println("  5 线程屏障同步完成 ✓")
        Barrier.destroy(b4)
        passed = passed + 1
    } while (false)

    // ── 5. Semaphore 创建 + acquire/release ───────────────
    total = total + 1
    println("--- 测试 5: Semaphore 基础 acquire/release ---")
    do {
        val s = Semaphore.new(3)
        val cnt = Semaphore.count(s)
        if (cnt == 3) {
            println("  初始 permits=3 ✓")
        } else {
            println("  FAIL: count=" + cnt.toString())
            return 1
        }
        Semaphore.acquire(s)
        val after1 = Semaphore.count(s)
        if (after1 == 2) {
            println("  acquire 后 permits=" + after1.toString() + " ✓")
        } else {
            println("  FAIL: after1=" + after1.toString())
            return 1
        }
        Semaphore.release(s)
        val after2 = Semaphore.count(s)
        if (after2 == 3) {
            println("  release 后 permits=" + after2.toString() + " ✓")
        } else {
            println("  FAIL: after2=" + after2.toString())
            return 1
        }
        Semaphore.destroy(s)
        passed = passed + 1
    } while (false)

    // ── 6. Semaphore 阻塞测试 ──────────────────────────────
    total = total + 1
    println("--- 测试 6: Semaphore 阻塞等待 ---")
    do {
        val s6 = Semaphore.new(1)
        // 获取唯一许可证
        Semaphore.acquire(s6)
        // 启动两个线程竞争许可证
        SEM_COUNT = 0
        val t1 = Thread.spawn(semWorker, s6)
        val t2 = Thread.spawn(semWorker, s6)
        val t3 = Thread.spawn(semWorker, s6)
        Thread.join(t1)
        Thread.join(t2)
        Thread.join(t3)
        Semaphore.release(s6)
        Mutex.lock(SEM_LOCK)
        val totalWork = SEM_COUNT
        Mutex.unlock(SEM_LOCK)
        if (totalWork == 3) {
            println("  3 线程依次获取许可证，总计 " + totalWork.toString() + " ✓")
        } else {
            println("  FAIL: work=" + totalWork.toString())
            return 1
        }
        Semaphore.destroy(s6)
        passed = passed + 1
    } while (false)

    // ── 7. Semaphore tryAcquire ───────────────────────────
    total = total + 1
    println("--- 测试 7: Semaphore tryAcquire ---")
    do {
        val s7 = Semaphore.new(1)
        // 先获取唯一许可证
        Semaphore.acquire(s7)
        // 尝试获取（应该失败，因为许可证已被占用）
        val got = Semaphore.tryAcquire(s7)
        if (!got) {
            println("  tryAcquire 失败（许可证已被占用）✓")
        } else {
            println("  FAIL: tryAcquire 不应该成功")
            return 1
        }
        Semaphore.release(s7)
        Semaphore.destroy(s7)
        passed = passed + 1
    } while (false)

    // ── 8. Semaphore 高并发限制 ────────────────────────────
    total = total + 1
    println("--- 测试 8: Semaphore 高并发限制 ---")
    do {
        val s8 = Semaphore.new(2)
        SEM_COUNT = 0
        val t1 = Thread.spawn(semWorker, s8)
        val t2 = Thread.spawn(semWorker, s8)
        val t3 = Thread.spawn(semWorker, s8)
        val t4 = Thread.spawn(semWorker, s8)
        val t5 = Thread.spawn(semWorker, s8)
        Thread.join(t1)
        Thread.join(t2)
        Thread.join(t3)
        Thread.join(t4)
        Thread.join(t5)
        Mutex.lock(SEM_LOCK)
        val totalWork = SEM_COUNT
        Mutex.unlock(SEM_LOCK)
        if (totalWork == 5) {
            println("  5 线程通过 Semaphore(2) 完成 " + totalWork.toString() + " 次工作 ✓")
        } else {
            println("  FAIL: work=" + totalWork.toString())
            return 1
        }
        Semaphore.destroy(s8)
        passed = passed + 1
    } while (false)

    // ── 清理 ──────────────────────────────────────────────
    Mutex.destroy(BARRIER_LOCK)
    Mutex.destroy(SEM_LOCK)

    // ── 总结 ────────────────────────────────────────────────
    println("")
    println("===================================================")
    println("  barrier_semaphore: " + passed.toString() + "/" + total.toString() + " passed")
    if (passed == total) {
        println("concurrent.barrier_semaphore ok")
        return 0
    } else {
        println("concurrent.barrier_semaphore FAIL")
        return 1
    }
}
