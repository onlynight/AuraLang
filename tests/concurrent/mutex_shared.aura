// ════════════════════════════════════════════════════════════
// Mutex 共享数据测试 — 线程间传递复杂数据（Mutex 保护共享状态）
// ════════════════════════════════════════════════════════════
// 使用 Mutex 保护共享全局变量，实现线程间传递复杂数据：
//   - 共享计数器（Int）
//   - 共享生产者-消费者缓冲区
//   - 共享任务队列
//
// 验证命令：
//   aura build tests/concurrent/mutex_shared.aura --aot \
//     --output build/aot-bin/concurrent/mutex_shared.exe
//   build/aot-bin/concurrent/mutex_shared.exe

import aura.lang.concurrent.*

// ════════════════════════════════════════════════════════════
// 全局共享状态（由 Mutex 保护）
// ════════════════════════════════════════════════════════════
// 注意：AOT 下全局变量为 Int 值，Mutex 句柄为 Int
// 共享数据结构通过全局 Int 变量 + Mutex 句柄实现

// ── 共享计数器 ─────────────────────────────────────────────
val SHARED_COUNT = -1
val SHARED_COUNT_LOCK = -1

// ── 共享任务队列（模拟简单队列）───────────────────────────
// 队列头索引、队列尾索引、队列容量、队列有效数
val QUEUE_HEAD = -1
val QUEUE_TAIL = -1
val QUEUE_CAPACITY = 10
val QUEUE_SIZE = 0
val QUEUE_LOCK = -1

// 队列存储（单线程 AOT 下用连续全局变量模拟数组）
val QUEUE_0 = 0
val QUEUE_1 = 0
val QUEUE_2 = 0
val QUEUE_3 = 0
val QUEUE_4 = 0
val QUEUE_5 = 0
val QUEUE_6 = 0
val QUEUE_7 = 0
val QUEUE_8 = 0
val QUEUE_9 = 0

// ── 共享计数器（用于验证）──────────────────────────────────
val TOTAL_PRODUCED = 0
val TOTAL_CONSUMED = 0
val VERIFY_LOCK = -1

// ════════════════════════════════════════════════════════════
// 线程函数
// ════════════════════════════════════════════════════════════

// ── 1. 共享计数器递增（Mutex 保护）────────────────────────
fun lockedIncrement(id: Int): Int {
    Mutex.lock(SHARED_COUNT_LOCK)
    // 模拟：读取 -> 修改 -> 写回（在 Mutex 保护下）
    // 由于 AOT 全局变量限制，这里用 Atomic 做实际计数，Mutex 做保护标记
    // 简化：每次调用加 1
    val newVal = SHARED_COUNT + 1
    SHARED_COUNT = newVal
    Mutex.unlock(SHARED_COUNT_LOCK)
    return newVal
}

// ── 2. 生产者线程 ──────────────────────────────────────────
// 向队列写入 id 个任务
fun producer(id: Int): Int {
    val totalProduced = 0
    for (i in 0..id) {
        Mutex.lock(QUEUE_LOCK)
        // 写入队列（环形缓冲区）
        val idx = QUEUE_TAIL
        // 设置队列槽位（通过 idx 间接寻址）
        // 简化：直接用 QUEUE_SIZE 作为写入位置
        if (QUEUE_SIZE < 10) {
            QUEUE_SIZE = QUEUE_SIZE + 1
            // 写入值（通过 QUEUE_SIZE 定位）
            QUEUE_TAIL = (idx + 1) % QUEUE_CAPACITY
        }
        Mutex.unlock(QUEUE_LOCK)
        totalProduced = totalProduced + 1
    }
    // 记录生产总数
    Mutex.lock(VERIFY_LOCK)
    TOTAL_PRODUCED = TOTAL_PRODUCED + totalProduced
    Mutex.unlock(VERIFY_LOCK)
    return totalProduced
}

// ── 3. 消费者线程 ──────────────────────────────────────────
// 从队列读取 count 个任务
fun consumer(count: Int): Int {
    val totalConsumed = 0
    var i = 0
    while (i < count) {
        Mutex.lock(QUEUE_LOCK)
        if (QUEUE_SIZE > 0) {
            QUEUE_SIZE = QUEUE_SIZE - 1
            totalConsumed = totalConsumed + 1
            i = i + 1
        }
        Mutex.unlock(QUEUE_LOCK)
        Thread.sleep(1)
    }
    // 记录消费总数
    Mutex.lock(VERIFY_LOCK)
    TOTAL_CONSUMED = TOTAL_CONSUMED + totalConsumed
    Mutex.unlock(VERIFY_LOCK)
    return totalConsumed
}

// ── 4. 复杂数据传递：结构体字段交换 ──────────────────────
// 使用多个全局变量模拟结构体字段，通过 Mutex 保护读写
// val STRUCT_X = 0
// val STRUCT_Y = 0
// val STRUCT_LOCK = -1

// 初始化：主线程设置结构体初始值
fun initStruct(x: Int, y: Int): Int {
    Mutex.lock(STRUCT_LOCK)
    STRUCT_X = x
    STRUCT_Y = y
    Mutex.unlock(STRUCT_LOCK)
    return 0
}

// 线程函数：交换 X 和 Y
fun swapStructFields(): Int {
    Mutex.lock(STRUCT_LOCK)
    val tmp = STRUCT_X
    STRUCT_X = STRUCT_Y
    STRUCT_Y = tmp
    Mutex.unlock(STRUCT_LOCK)
    return 0
}

// 线程函数：对结构体执行复杂计算
fun transformStruct(factor: Int): Int {
    Mutex.lock(STRUCT_LOCK)
    STRUCT_X = STRUCT_X * factor
    STRUCT_Y = STRUCT_Y + factor
    Mutex.unlock(STRUCT_LOCK)
    return 0
}

// ── 5. 嵌套锁测试 ─────────────────────────────────────────
val LOCK_A = -1
val LOCK_B = -1
val NESTED_COUNT = 0
val NESTED_LOCK = -1

fun nestedLockWorker(id: Int): Int {
    Mutex.lock(LOCK_A)
    Mutex.lock(LOCK_B)
    Mutex.lock(NESTED_LOCK)
    NESTED_COUNT = NESTED_COUNT + 1
    Mutex.unlock(NESTED_LOCK)
    Mutex.unlock(LOCK_B)
    Mutex.unlock(LOCK_A)
    return 0
}

// ════════════════════════════════════════════════════════════
// 主函数
// ════════════════════════════════════════════════════════════

fun main(): Int {
    var passed = 0
    var total = 0

    // ── 初始化共享资源 ────────────────────────────────────
    SHARED_COUNT_LOCK = Mutex.new()
    QUEUE_LOCK = Mutex.new()
    VERIFY_LOCK = Mutex.new()
    STRUCT_LOCK = Mutex.new()
    LOCK_A = Mutex.new()
    LOCK_B = Mutex.new()
    NESTED_LOCK = Mutex.new()

    // ── 1. Mutex 创建 + lock/unlock ───────────────────────
    total = total + 1
    println("--- 测试 1: lock / unlock 基础 ---")
    do {
        val m = Mutex.new()
        Mutex.lock(m)
        Mutex.unlock(m)
        Mutex.destroy(m)
        println("  lock/unlock 成功 ✓")
        passed = passed + 1
    } while (false)

    // ── 2. tryLock 测试 ──────────────────────────────────
    total = total + 1
    println("--- 测试 2: tryLock ---")
    do {
        val m2 = Mutex.new()
        val got1 = Mutex.tryLock(m2)
        if (got1) {
            println("  首次 tryLock 成功 ✓")
            Mutex.unlock(m2)
        } else {
            println("  FAIL: 首次 tryLock 失败")
            return 1
        }
        Mutex.destroy(m2)
        passed = passed + 1
    } while (false)

    // ── 3. 多线程 Mutex 保护递增 ──────────────────────────
    total = total + 1
    println("--- 测试 3: Mutex 保护并发递增 ---")
    do {
        SHARED_COUNT = 0
        val t1 = Thread.spawn(lockedIncrement, 1)
        val t2 = Thread.spawn(lockedIncrement, 1)
        val t3 = Thread.spawn(lockedIncrement, 1)
        val t4 = Thread.spawn(lockedIncrement, 1)
        Thread.join(t1)
        Thread.join(t2)
        Thread.join(t3)
        Thread.join(t4)
        Mutex.lock(SHARED_COUNT_LOCK)
        val finalCount = SHARED_COUNT
        Mutex.unlock(SHARED_COUNT_LOCK)
        if (finalCount == 4) {
            println("  4 线程并发递增 = " + finalCount.toString() + " ✓")
        } else {
            println("  FAIL: count=" + finalCount.toString())
            return 1
        }
        passed = passed + 1
    } while (false)

    // ── 4. 生产者-消费者模式 ──────────────────────────────
    total = total + 1
    println("--- 测试 4: 生产者-消费者 ---")
    do {
        QUEUE_SIZE = 0
        QUEUE_HEAD = 0
        QUEUE_TAIL = 0
        TOTAL_PRODUCED = 0
        TOTAL_CONSUMED = 0
        val tp = Thread.spawn(producer, 5)
        Thread.sleep(50)
        val tc = Thread.spawn(consumer, 5)
        val pResult = Thread.join(tp)
        val cResult = Thread.join(tc)
        Mutex.lock(VERIFY_LOCK)
        val produced = TOTAL_PRODUCED
        val consumed = TOTAL_CONSUMED
        Mutex.unlock(VERIFY_LOCK)
        if (produced == 5 && consumed == 5) {
            println("  produced=" + produced.toString() + " consumed=" + consumed.toString() + " ✓")
        } else {
            println("  FAIL: produced=" + produced.toString() + " consumed=" + consumed.toString())
            return 1
        }
        passed = passed + 1
    } while (false)

    // ── 5. 复杂数据结构交换（模拟结构体）─────────────────
    total = total + 1
    println("--- 测试 5: 结构体字段交换 ---")
    do {
        STRUCT_X = 10
        STRUCT_Y = 20
        initStruct(10, 20)
        val t = Thread.spawn(swapStructFields)
        Thread.join(t)
        Mutex.lock(STRUCT_LOCK)
        val sx = STRUCT_X
        val sy = STRUCT_Y
        Mutex.unlock(STRUCT_LOCK)
        if (sx == 20 && sy == 10) {
            println("  swap(10,20) -> (" + sx.toString() + "," + sy.toString() + ") ✓")
        } else {
            println("  FAIL: (" + sx.toString() + "," + sy.toString() + ")")
            return 1
        }
        passed = passed + 1
    } while (false)

    // ── 6. 结构体变换（多线程）────────────────────────────
    total = total + 1
    println("--- 测试 6: 结构体多线程变换 ---")
    do {
        STRUCT_X = 5
        STRUCT_Y = 10
        initStruct(5, 10)
        val t1 = Thread.spawn(transformStruct, 2)
        val t2 = Thread.spawn(transformStruct, 3)
        Thread.join(t1)
        Thread.join(t2)
        Mutex.lock(STRUCT_LOCK)
        val sx = STRUCT_X
        val sy = STRUCT_Y
        Mutex.unlock(STRUCT_LOCK)
        // 5*2*3=30, 10+2+3=15
        if (sx == 30 && sy == 15) {
            println("  (5,10) → (30,15) ✓")
        } else {
            println("  FAIL: (" + sx.toString() + "," + sy.toString() + ")")
            return 1
        }
        passed = passed + 1
    } while (false)

    // ── 7. 嵌套锁测试 ─────────────────────────────────────
    total = total + 1
    println("--- 测试 7: 嵌套锁 ---")
    do {
        NESTED_COUNT = 0
        val t1 = Thread.spawn(nestedLockWorker, 1)
        val t2 = Thread.spawn(nestedLockWorker, 1)
        val t3 = Thread.spawn(nestedLockWorker, 1)
        Thread.join(t1)
        Thread.join(t2)
        Thread.join(t3)
        Mutex.lock(NESTED_LOCK)
        val nc = NESTED_COUNT
        Mutex.unlock(NESTED_LOCK)
        if (nc == 3) {
            println("  3 线程嵌套锁 = " + nc.toString() + " ✓")
        } else {
            println("  FAIL: count=" + nc.toString())
            return 1
        }
        passed = passed + 1
    } while (false)

    // ── 清理 ──────────────────────────────────────────────
    Mutex.destroy(SHARED_COUNT_LOCK)
    Mutex.destroy(QUEUE_LOCK)
    Mutex.destroy(VERIFY_LOCK)
    Mutex.destroy(STRUCT_LOCK)
    Mutex.destroy(LOCK_A)
    Mutex.destroy(LOCK_B)
    Mutex.destroy(NESTED_LOCK)

    // ── 总结 ────────────────────────────────────────────────
    println("")
    println("===================================================")
    println("  mutex_shared: " + passed.toString() + "/" + total.toString() + " passed")
    if (passed == total) {
        println("concurrent.mutex_shared ok")
        return 0
    } else {
        println("concurrent.mutex_shared FAIL")
        return 1
    }
}
