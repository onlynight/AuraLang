// ════════════════════════════════════════════════════════════
// 原子操作测试 — Atomic counter / add / sub / cas / load / store
// ════════════════════════════════════════════════════════════
// 多线程并发递增、递减、CAS 比较交换等原子操作，验证无锁
// 并发正确性。
//
// 验证命令：
//   aura build tests/concurrent/atomic_ops.aura --aot \
//     --output build/aot-bin/concurrent/atomic_ops.exe
//   build/aot-bin/concurrent/atomic_ops.exe

import aura.lang.concurrent.*

// ── 全局 Atomic 计数器（线程间共享）──────────────────────
// 注意：AOT 下全局变量按 Int 值存储，Atomic 句柄为 Int 类型
val GLOBAL_COUNTER_ID = -1

// ── 线程函数 ──────────────────────────────────────────────

// 原子递增：每次 add +1
fun atomicIncrementer(id: Int): Int {
    val result = Atomic.add(id, 1)
    return result
}

// 原子递减：每次 sub -1
fun atomicDecrementer(id: Int): Int {
    val result = Atomic.sub(id, 1)
    return result
}

// 原子 store 写入固定值
fun atomicWriter(id: Int): Int {
    Atomic.store(id, 42)
    return 0
}

// CAS 操作：尝试从 0 变为 1
fun atomicCas(id: Int): Int {
    val success = Atomic.cas(id, 0, 1)
    if (success) {
        return 1
    }
    return 0
}

// 多线程并发递增（压力测试）
fun multiIncrementer(id: Int): Int {
    var i = 0
    while (i < 100) {
        Atomic.add(id, 1)
        i = i + 1
    }
    return 0
}

// ════════════════════════════════════════════════════════════
// 主函数
// ════════════════════════════════════════════════════════════

fun main(): Int {
    var passed = 0
    var total = 0

    // ── 1. Atomic 创建 + store/load ───────────────────────
    total = total + 1
    println("--- 测试 1: store / load ---")
    do {
        val a1 = Atomic.new(0)
        Atomic.store(a1, 42)
        val v = Atomic.load(a1)
        if (v == 42) {
            println("  store(42) -> load=42 ✓")
        } else {
            println("  FAIL: load=" + v.toString())
            return 1
        }
        Atomic.destroy(a1)
        passed = passed + 1
    } while (false)

    // ── 2. Atomic add / sub ────────────────────────────────
    total = total + 1
    println("--- 测试 2: add / sub ---")
    do {
        val a2 = Atomic.new(10)
        val r1 = Atomic.add(a2, 5)
        val r2 = Atomic.sub(a2, 3)
        val v = Atomic.load(a2)
        if (r1 == 15 && r2 == 12 && v == 12) {
            println("  10+5=" + r1.toString() + " -3=" + r2.toString() + " ✓")
        } else {
            println("  FAIL: r1=" + r1.toString() + " r2=" + r2.toString())
            return 1
        }
        Atomic.destroy(a2)
        passed = passed + 1
    } while (false)

    // ── 3. 多线程并发递增 ──────────────────────────────────
    total = total + 1
    println("--- 测试 3: 多线程并发递增 ---")
    do {
        val cnt = Atomic.new(0)
        val t1 = Thread.spawn(multiIncrementer, cnt)
        val t2 = Thread.spawn(multiIncrementer, cnt)
        val t3 = Thread.spawn(multiIncrementer, cnt)
        Thread.join(t1)
        Thread.join(t2)
        Thread.join(t3)
        val final = Atomic.load(cnt)
        if (final == 300) {
            println("  3×100 = " + final.toString() + " ✓")
        } else {
            println("  FAIL: final=" + final.toString())
            return 1
        }
        Atomic.destroy(cnt)
        passed = passed + 1
    } while (false)

    // ── 4. CAS 成功 ────────────────────────────────────────
    total = total + 1
    println("--- 测试 4: CAS 成功 ---")
    do {
        val a4 = Atomic.new(0)
        val ok = Atomic.cas(a4, 0, 1)
        val v = Atomic.load(a4)
        if (ok && v == 1) {
            println("  cas(0->1) 成功 ✓")
        } else {
            println("  FAIL: ok=" + ok.toString() + " v=" + v.toString())
            return 1
        }
        Atomic.destroy(a4)
        passed = passed + 1
    } while (false)

    // ── 5. CAS 失败（期望值不匹配）─────────────────────────
    total = total + 1
    println("--- 测试 5: CAS 失败 ---")
    do {
        val a5 = Atomic.new(0)
        val ok = Atomic.cas(a5, 999, 1)
        val v = Atomic.load(a5)
        if (!ok && v == 0) {
            println("  cas(999->1) 失败 ✓ (值未变)")
        } else {
            println("  FAIL: ok=" + ok.toString() + " v=" + v.toString())
            return 1
        }
        Atomic.destroy(a5)
        passed = passed + 1
    } while (false)

    // ── 6. 多线程 CAS 竞争 ─────────────────────────────────
    total = total + 1
    println("--- 测试 6: 多线程 CAS 竞争 ---")
    do {
        val a6 = Atomic.new(0)
        val t1 = Thread.spawn(atomicCas, a6)
        val t2 = Thread.spawn(atomicCas, a6)
        val t3 = Thread.spawn(atomicCas, a6)
        val t4 = Thread.spawn(atomicCas, a6)
        val r1 = Thread.join(t1)
        val r2 = Thread.join(t2)
        val r3 = Thread.join(t3)
        val r4 = Thread.join(t4)
        val winners = r1 + r2 + r3 + r4
        val v = Atomic.load(a6)
        if (winners == 1 && v == 1) {
            println("  4 线程竞争，仅 1 个成功 ✓")
        } else {
            println("  FAIL: winners=" + winners.toString() + " v=" + v.toString())
            return 1
        }
        Atomic.destroy(a6)
        passed = passed + 1
    } while (false)

    // ── 7. Atomic add 返回值正确性 ─────────────────────────
    total = total + 1
    println("--- 测试 7: add 返回值 ---")
    do {
        val a7 = Atomic.new(100)
        val v1 = Atomic.add(a7, 1)
        val v2 = Atomic.add(a7, 1)
        val v3 = Atomic.add(a7, 1)
        if (v1 == 101 && v2 == 102 && v3 == 103) {
            println("  100->101->102->103 ✓")
        } else {
            println("  FAIL: " + v1.toString() + "," + v2.toString() + "," + v3.toString())
            return 1
        }
        Atomic.destroy(a7)
        passed = passed + 1
    } while (false)

    // ── 总结 ────────────────────────────────────────────────
    println("")
    println("===================================================")
    println("  atomic_ops: " + passed.toString() + "/" + total.toString() + " passed")
    if (passed == total) {
        println("concurrent.atomic_ops ok")
        return 0
    } else {
        println("concurrent.atomic_ops FAIL")
        return 1
    }
}
