package test

import aura.lang.collection.LinkedHashMap

fun main(): Int {
    // Test basic put
    var m = LinkedHashMap<Int, String>()
    m.put(3, "three")
    m.put(1, "one")
    m.put(2, "two")
    
    assert(m.getSize() == 3, "size should be 3")
    assert(m.get(1) == "one", "get(1) should be one")
    assert(m.get(2) == "two", "get(2) should be two")
    assert(m.get(3) == "three", "get(3) should be three")
    
    // Test insertion order
    assert(m.firstKey() == 3, "firstKey should be 3")
    assert(m.lastKey() == 2, "lastKey should be 2")
    assert(m.keyAt(0) == 3, "keyAt(0) should be 3")
    assert(m.keyAt(1) == 1, "keyAt(1) should be 1")
    assert(m.keyAt(2) == 2, "keyAt(2) should be 2")
    assert(m.valueAt(0) == "three", "valueAt(0) should be three")
    assert(m.valueAt(1) == "one", "valueAt(1) should be one")
    assert(m.valueAt(2) == "two", "valueAt(2) should be two")
    
    // Test overwrite preserves order
    m.put(3, "three_updated")
    assert(m.getSize() == 3, "size should still be 3 after overwrite")
    assert(m.get(3) == "three_updated", "get(3) after overwrite should be three_updated")
    assert(m.firstKey() == 3, "firstKey should still be 3 after overwrite")
    assert(m.valueAt(0) == "three_updated", "valueAt(0) after overwrite should be three_updated")
    
    // Test remove preserves order
    m.removeItem(1)
    assert(m.getSize() == 2, "size after remove should be 2")
    assert(m.get(1) == null, "get(1) after remove should be null")
    assert(m.firstKey() == 3, "firstKey after remove should be 3")
    assert(m.lastKey() == 2, "lastKey after remove should be 2")
    assert(m.keyAt(0) == 3, "keyAt(0) after remove should be 3")
    assert(m.keyAt(1) == 2, "keyAt(1) after remove should be 2")
    
    // Test clear
    m.clear()
    assert(m.isEmpty() == true, "should be empty after clear")
    assert(m.getSize() == 0, "size after clear should be 0")
    
    // Test keys() and values() return ordered lists
    m.put(10, "A")
    m.put(20, "B")
    m.put(30, "C")
    var ks = m.keys()
    var vs = m.values()
    assert(ks.count() == 3, "keys count should be 3")
    assert(vs.count() == 3, "values count should be 3")
    
    println("LinkedHashMap order tests passed")
    return 0
}
