fun main() {
    val src = "fun main(): Int {\n    return 2 + 3 * 4\n}\n"
    println("src.len=" + toStr(src.length()))
    val lx0 = Lexer(src)
    lx0.scanAll()
    println("lexer.tokens=" + toStr(lx0.tokenCount()) + " lexer.n=" + toStr(lx0.n))
    val p = Parser(src)
    p.parseProgram()
    println("ast.count=" + toStr(p.ast.count))
    val hl = HirLowerer()
    hl.lower(p.ast)
    println("hir.count=" + toStr(hl.hir.count))
    val ml = MirLowerer()
    ml.lower(hl.hir)
    println("mir.count=" + toStr(ml.mir.count))
    val cg = Codegen()
    val bc = cg.emit(ml.mir)
    println("bc=" + toStr(bc.length))
    val vm = VmRunner()
    vm.loadBytecode(bc, cg.constPoolStr(), cg.funcTableStr())
    val out = vm.run()
    println("out=[" + toStr(out) + "]")
}
