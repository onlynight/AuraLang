import aura.lang.std.String
import aura.lang.native.Runtime
import aura.lang.native.file.FileOps
import aura.lang.native.process.ProcessOps
import aura.lang.native.time.Clock
import aura.lang.native.random.XorShift
import aura.lang.native.random.Random
import aura.lang.native.math.MathCore
import aura.lang.native.boxed.PlanA

// ─────────────────────────────────────────────────────────────
// 测试 1：文件 I/O
// ─────────────────────────────────────────────────────────────

fun testFileOpenClose(): Boolean {
    // 测试打开和关闭文件（只检查返回值）
    // 注意：实际测试需要文件系统支持
    return true  // 占位
}

// ─────────────────────────────────────────────────────────────
// 测试 2：进程管理
// ─────────────────────────────────────────────────────────────

fun testProcessExit(): Boolean {
    // 测试进程退出函数（不实际调用 exit）
    return true  // 占位
}

// ─────────────────────────────────────────────────────────────
// 测试 3：时间/时钟
// ─────────────────────────────────────────────────────────────

fun testClockNow(): Boolean {
    val t: Clock.Time = Clock.now()
    // 检查时间结构是否有效
    return t.sec >= 0
}

fun testClockTimeMs(): Boolean {
    val ms: Long = Clock.timeMs()
    // 检查返回值是否有效
    return ms >= 0
}

// ─────────────────────────────────────────────────────────────
// 测试 4：随机数
// ─────────────────────────────────────────────────────────────

fun testXorShiftBasic(): Boolean {
    val rng: XorShift = XorShift(12345)
    val n1: Long = rng.next()
    val n2: Long = rng.next()
    // 检查是否生成不同的随机数
    return n1 != n2
}

fun testXorShiftRange(): Boolean {
    val rng: XorShift = XorShift(12345)
    // 生成 0-9 的随机数
    for (i: Int in 0..100) {
        val n: Long = rng.nextRange(10)
        if (n < 0 || n >= 10) {
            return false
        }
    }
    return true
}

fun testGlobalRandom(): Boolean {
    val n1: Long = Random.next()
    val n2: Long = Random.next()
    return n1 != n2
}

// ─────────────────────────────────────────────────────────────
// 测试 5：数学库
// ─────────────────────────────────────────────────────────────

fun testMathAbs(): Boolean {
    return MathCore.abs(-5) == 5 && MathCore.abs(5) == 5
}

fun testMathMaxMin(): Boolean {
    return MathCore.max(10, 20) == 20 && MathCore.min(10, 20) == 10
}

fun testMathSqrt(): Boolean {
    val r1: Double = MathCore.sqrt(4.0)
    val r2: Double = MathCore.sqrt(16.0)
    val r3: Double = MathCore.sqrt(0.0)
    return r1 == 2.0 && r2 == 4.0 && r3 == 0.0
}

fun testMathIsqrt(): Boolean {
    return MathCore.isqrt(16) == 4 && MathCore.isqrt(25) == 5
}

fun testMathSinCos(): Boolean {
    // 检查 sin(0) = 0, cos(0) = 1
    val s: Double = MathCore.sin(0.0)
    val c: Double = MathCore.cos(0.0)
    return s == 0.0 && c == 1.0
}

fun testMathPow(): Boolean {
    val r: Double = MathCore.pow(2.0, 3.0)
    return r == 8.0
}

fun testMathExp(): Boolean {
    // 检查 exp(0) = 1
    val r: Double = MathCore.exp(0.0)
    return r == 1.0
}

// ─────────────────────────────────────────────────────────────
// 测试 6：Plan A 装箱
// ─────────────────────────────────────────────────────────────

fun testBoxSmallInt(): Boolean {
    // 测试小整数装箱/拆箱
    val boxed: Long = PlanA.boxInt(42)
    val unboxed: Long = PlanA.unboxInt(boxed)
    return unboxed == 42
}

fun testBoxNegativeInt(): Boolean {
    val boxed: Long = PlanA.boxInt(-5)
    val unboxed: Long = PlanA.unboxInt(boxed)
    return unboxed == -5
}

fun testBoxBool(): Boolean {
    val boxed1: Long = PlanA.boxBool(true)
    val boxed2: Long = PlanA.boxBool(false)
    val unboxed1: Boolean = PlanA.unboxBool(boxed1)
    val unboxed2: Boolean = PlanA.unboxBool(boxed2)
    return unboxed1 == true && unboxed2 == false
}

fun testIsObjectPtr(): Boolean {
    // 对象指针应该有标记位
    val objPtr: Long = 0x400000000000
    val tagged: Long = PlanA.addPtrTag(objPtr)
    return PlanA.isObjectPtr(tagged) == true
}

