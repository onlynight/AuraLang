// Test ArrayList with explicit size tracking
package test

import aura.lang.collection.ArrayList

class SimpleList {
    private var data: List<Int>
    private var _size: Int
    
    constructor() {
        data = arrayListOf<Int>()
        _size = 0
    }
    
    fun add(item: Int): Unit {
        data.add(item)
        _size = _size + 1
    }
    
    fun getSize(): Int {
        return _size
    }
    
    fun test(): Unit {
        add(1)
        add(2)
        add(3)
        println("size=" + _size)
        println("data.size=" + data.size)
        println("data[0]=" + data[0])
    }
}

fun main(): Int {
    var l = SimpleList()
    l.test()
    return 0
}
