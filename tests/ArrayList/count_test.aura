// Simple test for ArrayList count
package test

import aura.lang.collection.ArrayList

fun main(): Int {
    var l = ArrayList<Int>()
    l.add(1)
    l.add(2)
    l.add(3)
    println("size=" + l.size)
    println("count=" + l.count())
    println("isEmpty=" + l.isEmpty())
    println("getAt(0)=" + l.getAt(0))
    println("first=" + l.first())
    println("last=" + l.last())
    return 0
}
