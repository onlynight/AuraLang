// Test ArrayList addItem method
package test

import aura.lang.collection.ArrayList

fun main(): Int {
    var l = ArrayList<Int>()
    l.addItem(1)
    l.addItem(2)
    l.addItem(3)
    println("size=" + l.size)
    println("l[0]=" + l[0])
    println("l.getAt(0)=" + l.getAt(0))
    println("first=" + l.first())
    println("last=" + l.last())
    println("contains(2)=" + l.contains(2))
    println("indexOf(2)=" + l.indexOf(2))
    println("toString=" + l.toString())
    return 0
}
