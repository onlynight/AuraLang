package test

import aura.lang.collection.ArrayList

fun main(): Int {
    // Test ArrayList add
    var l = ArrayList<Int>()
    l.add(1)
    l.add(2)
    l.add(3)
    
    assert(l.count() == 3, "ArrayList count should be 3")
    assert(l.getAt(0) == 1, "ArrayList getAt(0) should be 1")
    assert(l.getAt(1) == 2, "ArrayList getAt(1) should be 2")
    assert(l.getAt(2) == 3, "ArrayList getAt(2) should be 3")
    assert(l.first() == 1, "ArrayList first should be 1")
    assert(l.last() == 3, "ArrayList last should be 3")
    assert(l.isEmpty() == false, "ArrayList should not be empty")
    
    // Test ArrayList insert
    l.insert(1, 100)
    assert(l.count() == 4, "ArrayList count after insert should be 4")
    assert(l.getAt(1) == 100, "ArrayList getAt(1) after insert should be 100")
    
    // Test ArrayList remove
    l.removeAt(1)
    assert(l.count() == 3, "ArrayList count after remove should be 3")
    assert(l.getAt(1) == 2, "ArrayList getAt(1) after remove should be 2")
    
    // Test ArrayList clear
    l.clear()
    assert(l.isEmpty() == true, "ArrayList should be empty after clear")
    
    println("ArrayList tests passed")
    return 0
}
