// Test if addItem is called
package test

import aura.lang.collection.ArrayList

fun main(): Int {
    println("creating ArrayList...")
    var l = ArrayList<Int>()
    println("created, size=" + l.size)
    println("calling addItem...")
    l.addItem(1)
    println("after addItem, size=" + l.size)
    l.addItem(2)
    println("after 2nd addItem, size=" + l.size)
    l.addItem(3)
    println("after 3rd addItem, size=" + l.size)
    println("l[0]=" + l[0])
    return 0
}
