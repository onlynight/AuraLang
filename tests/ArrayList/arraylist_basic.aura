// tests/ArrayList/arraylist_basic.aura
// ArrayList<T> 基础功能测试
package test

import aura.lang.collection.ArrayList

class Checker {
    private var passed: Int
    private var failed: Int

    constructor() {
        this.passed = 0
        this.failed = 0
    }

    fun check(name: String, cond: Boolean): Unit {
        if (cond) {
            this.passed = this.passed + 1
        } else {
            this.failed = this.failed + 1
            println("FAIL: " + name)
        }
    }

    fun summary(): Unit {
        println("passed=" + this.passed + " failed=" + this.failed)
        if (this.failed == 0) {
            println("ALL TESTS PASSED")
        } else {
            println("SOME TESTS FAILED")
        }
    }
}

fun main(): Int {
    var c = Checker()

    // 空列表
    var l = ArrayList<Int>()
    c.check("empty.size", l.size == 0)
    c.check("empty.isEmpty", l.isEmpty())
    c.check("empty.count", l.count() == 0)
    c.check("empty.getSize", l.getSize() == 0)
    c.check("empty.contains", l.contains(1) == false)
    c.check("empty.indexOf", l.indexOf(1) == -1)
    c.check("empty.lastIndexOf", l.lastIndexOf(1) == -1)
    c.check("empty.toString", l.toString() == "[]")

    // add
    l.add(1)
    l.add(2)
    l.add(3)
    c.check("add.size", l.size == 3)
    c.check("add.get0", l.get(0) == 1)
    c.check("add.get1", l.get(1) == 2)
    c.check("add.get2", l.get(2) == 3)
    c.check("add.contains", l.contains(2) == true)
    c.check("add.indexOf", l.indexOf(2) == 1)
    c.check("add.lastIndexOf", l.lastIndexOf(2) == 1)

    // first/last
    c.check("first", l.first() == 1)
    c.check("last", l.last() == 3)

    // set
    l.set(1, 99)
    c.check("set.get1", l.get(1) == 99)

    // remove
    var removed = l.remove(1)
    c.check("remove.ret", removed == 99)
    c.check("remove.size", l.size == 2)
    c.check("remove.get0", l.get(0) == 1)
    c.check("remove.get1", l.get(1) == 3)

    // clear
    l.clear()
    c.check("clear.size", l.size == 0)
    c.check("clear.isEmpty", l.isEmpty())

    // distinct
    var d = ArrayList<Int>()
    d.add(1)
    d.add(2)
    d.add(1)
    d.add(3)
    d.add(2)
    var distinct = d.distinct()
    c.check("distinct.size", distinct.size == 3)

    // take/skip
    var e = ArrayList<Int>()
    e.add(1)
    e.add(2)
    e.add(3)
    var t = e.take(2)
    c.check("take.size", t.size == 2)
    c.check("take.get0", t.get(0) == 1)
    c.check("take.get1", t.get(1) == 2)
    var s = e.skip(1)
    c.check("skip.size", s.size == 2)
    c.check("skip.get0", s.get(0) == 2)
    c.check("skip.get1", s.get(1) == 3)

    // sum/min/max
    c.check("sum", e.sum() == 6)
    c.check("min", e.min() == 1)
    c.check("max", e.max() == 3)

    // toString
    var ts = ArrayList<String>()
    ts.add("a")
    ts.add("b")
    ts.add("c")
    c.check("toString", ts.toString() == "[a, b, c]")

    // getAt
    c.check("getAt", e.getAt(1) == 2)

    c.summary()
    return c.failed
}
