// Test ArrayList contains
package test

import aura.lang.collection.ArrayList

fun main(): Int {
    var l = ArrayList<Int>()
    l.add(1)
    l.add(2)
    l.add(3)
    println("contains(2)=" + l.contains(2))
    println("contains(4)=" + l.contains(4))
    println("indexOf(2)=" + l.indexOf(2))
    println("indexOf(4)=" + l.indexOf(4))
    println("toString=" + l.toString())
    return 0
}
