// ═══════════════════════════════════════════════════════════════════════════
// Phase 4: Control Flow — 控制流测试
// ═══════════════════════════════════════════════════════════════════════════
// 覆盖：if-else 表达式 / when（字面量、in range、is、else）/
//       for / while / do-while / break / continue / 嵌套循环
//
// 验证：
//   aura check examples/language-test/04-control-flow.aura    # 语法/语义
//   aura run   examples/language-test/04-control-flow.aura    # VM 执行
//   aura run   examples/language-test/04-control-flow.aura --jit  # JIT
//   aura build examples/language-test/04-control-flow.aura --aot --output target/test/04-control-flow  # AOT
// ═══════════════════════════════════════════════════════════════════════════

fun main() {
    println("=== Phase 4: Control Flow ===")

    // ── §4.1 if-else 表达式 ──────────────────────────────────────────────
    println("\n--- §4.1 if-else as expression ---")

    val x: Int = 5
    val y = if (x > 0) 1 else 0
    println("  x>0 ? 1 : 0 = " + y.toString())

    val z = if (x > 10) "big" else if (x > 0) "positive" else "non-positive"
    println("  nested if: " + z)

    val w = if (false) "unreachable" else "reached"
    println("  const false: " + w)

    // ── §4.2 if-else 语句 ────────────────────────────────────────────────
    println("\n--- §4.2 if-else as statement ---")

    if (x > 0) {
        println("  x is positive")
    } else {
        println("  x is not positive")
    }

    if (x > 100) {
        println("  x > 100")
    } else if (x > 10) {
        println("  10 < x <= 100")
    } else {
        println("  x <= 10")
    }

    // ── §4.3 when 字面量匹配 ──────────────────────────────────────────────
    println("\n--- §4.3 when with literals ---")

    val day = 3
    val dayName = when (day) {
        1 -> "Monday"
        2 -> "Tuesday"
        3 -> "Wednesday"
        4 -> "Thursday"
        5 -> "Friday"
        6 -> "Saturday"
        7 -> "Sunday"
        else -> "Invalid"
    }
    println("  day " + day.toString() + ": " + dayName)

    val grade = 85
    val letter = when (grade) {
        100 -> "A+"
        90 -> "A"
        80 -> "B"
        else -> "F"
    }
    println("  grade " + grade.toString() + ": " + letter)

    // ── §4.4 when 无主体（条件表达式） ────────────────────────────────────
    println("\n--- §4.4 when without subject (conditions) ---")

    val score = 75
    val result = when {
        score >= 90 -> "Excellent"
        score >= 70 -> "Good"
        score >= 50 -> "Pass"
        else -> "Fail"
    }
    println("  score " + score.toString() + ": " + result)

    // ── §4.5 when with `in range` ────────────────────────────────────────
    println("\n--- §4.5 when in range ---")

    val temperature = 35
    val weather = when (temperature) {
        in 0..15 -> "Cold"
        in 16..25 -> "Cool"
        in 26..35 -> "Warm"
        in 36..50 -> "Hot"
        else -> "Extreme"
    }
    println("  temp " + temperature.toString() + ": " + weather)

    val exclusive = when (temperature) {
        in 0..<16 -> "Cold"
        in 16..<26 -> "Cool"
        in 26..<36 -> "Warm"
        else -> "Hot"
    }
    println("  temp " + temperature.toString() + " (excl): " + exclusive)

    // ── §4.6 when with `is` 类型检查 ──────────────────────────────────────
    println("\n--- §4.6 when with is (type check) ---")

    val val1: Any = "hello"
    val val2: Any = 42
    val val3: Any = true
    val val4: Any = 3.14

    val type1 = when (val1) {
        is String -> "String"
        is Int -> "Int"
        is Double -> "Double"
        else -> "Unknown"
    }
    println("  val1 (\"hello\"): " + type1)

    val type2 = when (val2) {
        is String -> "String"
        is Int -> "Int"
        is Double -> "Double"
        else -> "Unknown"
    }
    println("  val2 (42): " + type2)

    val type3 = when (val3) {
        is String -> "String"
        is Int -> "Int"
        is Boolean -> "Boolean"
        else -> "Unknown"
    }
    println("  val3 (true): " + type3)

    val type4 = when (val4) {
        is String -> "String"
        is Int -> "Int"
        is Double -> "Double"
        else -> "Unknown"
    }
    println("  val4 (3.14): " + type4)

    // ── §4.7 for 循环（含范围） ──────────────────────────────────────────
    println("\n--- §4.7 for loops ---")

    var sum1: Int = 0
    for (a in 1..5) {
        sum1 = sum1 + a
    }
    println("  sum 1..5 (inclusive) = " + sum1.toString())

    var sum2: Int = 0
    for (b in 1..<5) {
        sum2 = sum2 + b
    }
    println("  sum 1..<5 (exclusive) = " + sum2.toString())

    // 倒序范围
    var reverseSum: Int = 0
    for (c in 5..1) {
        reverseSum = reverseSum + c
    }
    println("  sum 5..1 (reverse) = " + reverseSum.toString())

    // ── §4.8 while 循环 ───────────────────────────────────────────────────
    println("\n--- §4.8 while loops ---")

    var i: Int = 0
    var fib: Int = 0
    var fib2: Int = 1
    while (i < 5) {
        println("  fib(" + i.toString() + ") = " + fib.toString())
        val temp = fib
        fib = fib + fib2
        fib2 = temp
        i = i + 1
    }

    // ── §4.9 do-while 循环 ──────────────────────────────────────────────
    println("\n--- §4.9 do-while loops ---")

    var attempt: Int = 0
    do {
        attempt = attempt + 1
        println("  attempt " + attempt.toString())
    } while (attempt < 3)

    // do-while 至少执行一次
    var once: Int = 0
    do {
        once = once + 1
    } while (false)
    println("  do-while(false) executed " + once.toString() + " time(s)")

    // ── §4.10 break 和 continue ───────────────────────────────────────────
    println("\n--- §4.10 break and continue ---")

    // break
    var breakSum: Int = 0
    for (d in 1..10) {
        if (d == 6) {
            break
        }
        breakSum = breakSum + d
    }
    println("  break at 6, sum = " + breakSum.toString())

    // continue
    var oddSum: Int = 0
    for (e in 1..10) {
        if (e % 2 == 0) {
            continue
        }
        oddSum = oddSum + e
    }
    println("  odd sum 1..10 = " + oddSum.toString())

    // break + continue 组合
    var complex: Int = 0
    for (f in 1..20) {
        if (f == 10) {
            break
        }
        if (f % 2 == 0) {
            continue
        }
        complex = complex + f
    }
    println("  break@10 + continue@even, sum = " + complex.toString())

    // ── §4.11 嵌套循环 ────────────────────────────────────────────────────
    println("\n--- §4.11 nested loops ---")

    // 乘法表
    for (g in 1..3) {
        for (h in 1..3) {
            println("  " + g.toString() + " x " + h.toString() + " = " + (g * h).toString())
        }
    }

    // 查找因子对
    val target = 6
    for (a in 1..target) {
        for (b in a..target) {
            if (a * b == target) {
                println("  " + a.toString() + " x " + b.toString() + " = " + target.toString())
            }
        }
    }

    // 嵌套 break
    var found: Boolean = false
    for (k in 1..10) {
        for (l in 1..10) {
            if (k * l == 23) {
                found = true
                break
            }
        }
        if (found) {
            break
        }
    }
    println("  found 23 as product of small numbers: " + found.toString())

    // ── §4.12 循环中的 return（通过顶层函数） ──────────────────────────────
    println("\n--- §4.12 return in loop ---")

    val firstEven = findFirstEven(3)
    println("  first even starting from 3 = " + firstEven.toString())

    val noEven = findFirstEven(100)
    println("  first even starting from 100 = " + noEven.toString())

    // ── §4.13 死循环 + break ─────────────────────────────────────────────
    println("\n--- §4.13 infinite loop with break ---")

    var counter: Int = 0
    while (true) {
        counter = counter + 1
        if (counter == 7) {
            break
        }
    }
    println("  counter = " + counter.toString())

    // do-while(true) + break
    var dc: Int = 0
    do {
        dc = dc + 1
        if (dc == 4) {
            break
        }
    } while (true)
    println("  do-while(true) counter = " + dc.toString())

    println("\n=== Phase 4 Complete ===")
}

// 辅助函数：从 start 开始找第一个偶数（用于测试循环中的 return）
fun findFirstEven(start: Int): Int {
    var n: Int = start
    while (n <= 100) {
        if (n % 2 == 0) {
            return n
        }
        n = n + 1
    }
    return -1
}
