import aura.lang.std.Math

fun main() {
    // ── §9.1 Pointer 基础操作 ──
    val p1: Pointer<Int> = intToPtr(42)
    val v1: Int = ptrToInt(p1)
    println("§9.1 ptrToInt(intToPtr(42))=" + v1.toString())

    val p2: Pointer<Int> = null
    val isNull: Boolean = ptrIsNull(p2)
    println("§9.1 ptrIsNull(null)=" + isNull.toString())

    val p3: Pointer<Int> = intToPtr(100)
    val isNull3: Boolean = ptrIsNull(p3)
    println("§9.1 ptrIsNull(intToPtr(100))=" + isNull3.toString())

    // ── §9.2 CString 转换 ──
    val s1: CString = "Hello FFI"
    val s2: CString = ""
    println("§9.2 CString created (non-empty): " + s1.toString())
    println("§9.2 CString created (empty): " + s2.toString())

    // ── §9.3 MakeCallback 基础 ──
    // 注意：makeCallback 需要函数引用，不是 lambda
    // val cb: Any = makeCallback( { x -> x } )
