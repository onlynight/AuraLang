// 异常类层次结构测试
// 验证 Throwable / Exception / RuntimeException 层次结构
// 使用 throw Exception("msg") 语法（非 throw "msg"）

fun testBasicException(): Unit {
    // 测试 throw Exception("msg") + catch (e: String)
    try {
        throw Exception("basic test exception")
    } catch (e: String) {
        println("Caught Exception: " + e)
    }
}

fun testRuntimeException(): Unit {
    // 测试 throw RuntimeException("msg") + catch (e: String)
    try {
        throw RuntimeException("runtime test")
    } catch (e: String) {
        println("Caught RuntimeException: " + e)
    }
}

fun testIndexOfOutOfBoundsException(): Unit {
    // 测试 throw IndexOutOfBoundsException("msg") + catch (e: String)
    try {
        throw IndexOutOfBoundsException("index: 5, size: 3")
    } catch (e: String) {
        println("Caught IndexOutOfBoundsException: " + e)
    }
}

fun testFinally(): Unit {
    // 测试 finally 块执行
    var flag: Boolean = false
    try {
        flag = true
        throw Exception("finally test")
    } catch (e: String) {
        println("Caught: " + e)
    } finally {
        println("Finally executed")
    }
}

fun testNested(): Unit {
    // 测试嵌套 try/catch
    try {
        println("Outer try")
        try {
            println("Inner try")
            throw RuntimeException("inner exception")
        } catch (e: String) {
            println("Inner catch: " + e)
        }
        println("After inner")
    } catch (e: String) {
        println("Outer catch: " + e)
    }
}

fun testThrowInFunction(): Unit {
    // 测试在函数中抛出异常
    try {
        throw IllegalStateException("called from test function")
    } catch (e: String) {
        println("Caught from function: " + e)
    }
}

fun testMultipleThrows(): Unit {
    // 测试多次抛出
    try {
        throw ArithmeticException("division by zero")
    } catch (e: String) {
        println("Caught 1: " + e)
    }
    try {
        throw IllegalStateException("bad state")
    } catch (e: String) {
        println("Caught 2: " + e)
    }
}

fun main(): Int {
    println("═══ 异常类层次结构测试 ═══")
    println("")
    
    println("§1 Basic Exception:")
    testBasicException()
    
    println("")
    println("§2 RuntimeException:")
    testRuntimeException()
    
    println("")
    println("§3 IndexOutOfBoundsException:")
    testIndexOfOutOfBoundsException()
    
    println("")
    println("§4 Finally:")
    testFinally()
    
    println("")
    println("§5 Nested try/catch:")
    testNested()
    
    println("")
    println("§6 Throw in function:")
    testThrowInFunction()
    
    println("")
    println("§7 Multiple throws:")
    testMultipleThrows()
    
    println("")
    println("═══ 全部测试完成 ✓ ═══")
    return 0
}
