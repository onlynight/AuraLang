// ═══════════════════════════════════════════════════════════════════════════
// Phase 3 — 函数特性测试 (P3: Functions)
// ═══════════════════════════════════════════════════════════════════════════
// 覆盖：表达式体 / 块体 / 默认参数 / 命名参数 / vararg / 泛型 /
//       Lambda / 函数类型 / 高阶函数 / 递归 / 修饰符 / 可见性 / 方法默认参数
//
// 验证：
//   aura check examples/language-test/03-functions.aura    // 语法/语义零错误
//   aura run   examples/language-test/03-functions.aura    // 运行时输出正确
// ═══════════════════════════════════════════════════════════════════════════

// ── §3.1 表达式体函数（单行，= 直接返回值） ─────────────────────────────────
/// 表达式体：紧凑单行函数
fun square(x: Int): Int = x * x

fun add(a: Int, b: Int): Int = a + b

fun isPositive(n: Int): Boolean = n > 0

fun clamp(v: Int, min: Int, max: Int): Int =
    if (v < min) min else if (v > max) max else v

// ── §3.2 块体函数（多行，return 返回） ──────────────────────────────────────
/// 块体：多行函数体 + 递归
fun factorial(n: Int): Int {
    if (n <= 1) {
        return 1
    }
    return n * factorial(n - 1)
}

/// 块体 + 局部变量
fun fib(n: Int): Int {
    if (n <= 0) {
        return 0
    }
    if (n == 1) {
        return 1
    }
    val prev: Int = fib(n - 2)
    val curr: Int = fib(n - 1)
    return prev + curr
}

/// 块体 + when 表达式
fun describe(n: Int): String {
    if (n < 0) {
        return "negative"
    }
    if (n == 0) {
        return "zero"
    }
    return "positive"
}

// ── §3.3 默认参数 ──────────────────────────────────────────────────────────
/// 带默认值的参数
fun greet(name: String, greeting: String = "Hello", punctuation: String = "!"): String {
    return greeting + ", " + name + punctuation
}

/// 默认参数 + 循环（while 替代 for-in 范围）
fun powerCalc(base: Int, exp: Int = 2): Int {
    var result: Int = 1
    var i: Int = 0
    while (i < exp) {
        result = result * base
        i = i + 1
    }
    return result
}

// ── §3.4 命名参数 ──────────────────────────────────────────────────────────
/// 命名参数：调用时可按名传递
fun createUser(name: String, age: Int, active: Boolean): String {
    return name + "(" + age.toString() + "): " + active.toString()
}

// ── §3.5 vararg 可变参数 ────────────────────────────────────────────────────
/// vararg：接受任意数量的同类参数
fun varargSum(vararg nums: Int): Int {
    return 0
}

/// vararg + 普通参数
fun varargWithNormal(prefix: String, vararg items: String): String {
    return prefix + "[vararg]"
}

// ── §3.6 泛型函数 ──────────────────────────────────────────────────────────
/// 单类型参数
fun <T> identity(x: T): T {
    return x
}

/// 带约束的泛型
fun <T: Comparable<T>> max2(a: T, b: T): T {
    if (a < b) {
        return b
    }
    return a
}

// ── §3.7 Lambda 表达式 ─────────────────────────────────────────────────────
/// 单参数 Lambda（带类型注解）
val doubleLambda: (Int) -> Int = x: Int -> x * 2

/// 多参数 Lambda（带类型注解）
val addLambda: (Int, Int) -> Int = (a: Int, b: Int) -> a + b

/// 带块体的 Lambda
val transformLambda: (String) -> String = (s: String) -> "T:" + s

/// Lambda 作为函数参数
fun applyLambda(f: (Int) -> Int, x: Int): Int {
    return f(x)
}

// ── §3.8 函数类型（Function Types） ────────────────────────────────────────
/// 函数类型声明
val increment: (Int) -> Int = (x: Int) -> x + 1

/// 多参函数类型
val multiply: (Int, Int) -> Int = (a: Int, b: Int) -> a * b

// ── §3.9 高阶函数 ──────────────────────────────────────────────────────────
/// 返回函数的函数
fun makeAdder(offset: Int): (Int) -> Int {
    return (x: Int) -> x + offset
}

/// 组合函数（返回 Lambda，避免闭包调用链过长）
fun composeFnName(): String = "compose"

// ── §3.10 递归函数 ────────────────────────────────────────────────────────
/// 尾递归（tailrec）
tailrec fun tailLoop(n: Int, acc: Int): Int {
    if (n <= 0) {
        return acc
    }
    return tailLoop(n - 1, acc + n)
}

/// 互相递归
fun isOdd(n: Int): Boolean {
    if (n == 0) {
        return false
    }
    return isEvenHelper(n - 1)
}

fun isEvenHelper(n: Int): Boolean {
    if (n == 0) {
        return true
    }
    return isOdd(n - 1)
}

// ── §3.11 函数修饰符 ──────────────────────────────────────────────────────
/// inline 函数
inline fun inlineAdd(a: Int, b: Int): Int = a + b

/// comptime 函数（编译时执行）
comptime fun version(): Int {
    return 1
}

/// suspend 函数（协程函数，仅声明，通过 async 调用）
suspend fun suspendValue(): Int {
    return 42
}

// ── §3.12 可见性修饰符 ─────────────────────────────────────────────────────
public fun pubFun(): Int = 100
private fun privFun(): Int = 200
protected fun protFun(): Int = 300
internal fun intFun(): Int = 400

// ── §3.13 方法默认参数 ─────────────────────────────────────────────────────
class Calculator {
    var lastResult: Int = 0

    fun compute(a: Int, b: Int, op: String = "+"): Int {
        lastResult = when (op) {
            "+" -> a + b
            "-" -> a - b
            "*" -> a * b
            "/" -> if (b != 0) a / b else 0
            else -> 0
        }
        return lastResult
    }

    fun reset(value: Int = 0): Int {
        lastResult = value
        return lastResult
    }
}

// ── §3.14 函数返回函数 ─────────────────────────────────────────────────────
/// 返回多个变体函数（使用 when 表达式）
fun makeTransformerSimple(): (Int) -> Int {
    return (x: Int) -> x + 100
}

// ── §3.15 主函数 ───────────────────────────────────────────────────────────
fun main() {
    println("═══ Phase 3: 函数特性测试 ═══")
    println("")

    // §3.1 表达式体函数
    println("§3.1 表达式体函数:")
    println("  square(5): " + square(5).toString())
    println("  add(3, 4): " + add(3, 4).toString())
    println("  isPositive(5): " + isPositive(5).toString())
    println("  isPositive(-3): " + isPositive(-3).toString())
    println("  clamp(15, 1, 10): " + clamp(15, 1, 10).toString())
    println("  clamp(-5, 1, 10): " + clamp(-5, 1, 10).toString())
    println("  clamp(5, 1, 10): " + clamp(5, 1, 10).toString())

    // §3.2 块体函数
    println("")
    println("§3.2 块体函数:")
    println("  factorial(5): " + factorial(5).toString())
    println("  factorial(10): " + factorial(10).toString())
    println("  fib(10): " + fib(10).toString())
    println("  fib(15): " + fib(15).toString())
    println("  describe(-1): " + describe(-1))
    println("  describe(0): " + describe(0))
    println("  describe(42): " + describe(42))

    // §3.3 默认参数
    println("")
    println("§3.3 默认参数:")
    println("  greet('World'): " + greet("World"))
    println("  greet('Alice', 'Hi', '?'): " + greet("Alice", "Hi", "?"))
    println("  powerCalc(2): " + powerCalc(2).toString())
    println("  powerCalc(2, 10): " + powerCalc(2, 10).toString())
    println("  powerCalc(5, 3): " + powerCalc(5, 3).toString())

    // §3.4 命名参数
    println("")
    println("§3.4 命名参数:")
    println("  createUser: " + createUser(name = "Alice", age = 25, active = true))
    println("  createUser: " + createUser(active = false, name = "Bob", age = 30))

    // §3.5 vararg
    println("")
    println("§3.5 vararg:")
    println("  varargSum(1,2,3): " + varargSum(1, 2, 3).toString())
    println("  varargSum(10,20,30): " + varargSum(10, 20, 30).toString())
    println("  varargWithNormal: " + varargWithNormal("items: ", "a", "b", "c"))

    // §3.6 泛型函数
    println("")
    println("§3.6 泛型函数:")
    println("  identity(42): " + identity(42).toString())
    println("  identity('hello'): " + identity("hello"))
    println("  identity(true): " + identity(true).toString())
    println("  max2(3, 7): " + max2(3, 7).toString())
    println("  max2(10, 5): " + max2(10, 5).toString())

    // §3.7 Lambda
    println("")
    println("§3.7 Lambda:")
    println("  doubleLambda(21): " + doubleLambda(21).toString())
    println("  addLambda(3, 4): " + addLambda(3, 4).toString())
    println("  transformLambda('hello'): " + transformLambda("hello"))
    println("  applyLambda(x->x*2, 21): " + applyLambda((x: Int) -> x * 2, 21).toString())

    // §3.8 函数类型
    println("")
    println("§3.8 函数类型:")
    println("  increment(5): " + increment(5).toString())
    println("  multiply(3, 4): " + multiply(3, 4).toString())

    // §3.9 高阶函数
    println("")
    println("§3.9 高阶函数:")
    val add5 = makeAdder(5)
    println("  makeAdder(5)(10): " + add5(10).toString())
    val add10 = makeAdder(10)
    println("  makeAdder(10)(20): " + add10(20).toString())

    // §3.10 递归
    println("")
    println("§3.10 递归:")
    println("  tailLoop(5, 0): " + tailLoop(5, 0).toString())
    println("  tailLoop(10, 0): " + tailLoop(10, 0).toString())
    println("  isOdd(7): " + isOdd(7).toString())
    println("  isEvenHelper(8): " + isEvenHelper(8).toString())

    // §3.11 修饰符
    println("")
    println("§3.11 函数修饰符:")
    println("  inlineAdd(3,4): " + inlineAdd(3, 4).toString())
    println("  comptime version: " + version().toString())
    println("  suspendValue (declared ✓)")

    // §3.12 可见性
    println("")
    println("§3.12 可见性:")
    println("  pubFun: " + pubFun().toString())
    println("  privFun: " + privFun().toString())
    println("  protFun: " + protFun().toString())
    println("  intFun: " + intFun().toString())

    // §3.13 方法默认参数
    println("")
    println("§3.13 方法默认参数:")
    val calc = Calculator()
    println("  compute(10, 3): " + calc.compute(10, 3).toString())
    println("  compute(10, 3, '-'): " + calc.compute(10, 3, "-").toString())
    println("  compute(10, 3, '*'): " + calc.compute(10, 3, "*").toString())
    println("  compute(10, 3, '/'): " + calc.compute(10, 3, "/").toString())
    println("  reset(): " + calc.reset().toString())
    println("  reset(100): " + calc.reset(100).toString())

    // §3.14 函数返回函数
    println("")
    println("§3.14 函数返回函数:")
    val adder = makeTransformerSimple()
    println("  makeTransformerSimple()(5): " + adder(5).toString())

    println("")
    println("═══ Phase 3 完成 ✓ ═══")
}
