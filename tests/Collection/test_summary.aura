// tests/Collection/README.md
// ─────────────────────────────────────────────────────────────────────────────
// 集合测试套件
//
// 覆盖以下集合类型：
//   - ArrayList<T>     : 动态数组列表
//   - HashSet<T>       : 哈希表集合
//   - HashMap<K, V>    : 哈希表映射
//   - LinkedList<T>    : 双向链表
//   - Deque<T>         : 双端队列
//   - LinkedHashMap    : 保持插入顺序的映射
//   - TreeSet<T>       : 有序集合
//   - TreeMap<K, V>    : 有序映射
//
// 编译器：aura-compiler-n1.exe
// 运行命令：
//   & "D:\Code\AuraLang\build\bin\aura-compiler-n1.exe" "<test>.aura" -o "<out>.exe"
//   & "<out>.exe"
// ─────────────────────────────────────────────────────────────────────────────
//
// 测试结果摘要：
//
//   ✅ ArrayList - test_basic.aura, test_full.aura
//   ✅ HashSet   - test_add_simple.aura, test_full.aura
//   ✅ HashMap   - test_full.aura
//   ✅ LinkedList - test_full.aura
//   ❌ Deque      - 编译器类型推断问题
//   ❌ LinkedHashMap - HashMap.put 调用降级问题
//   ⏳ TreeSet    - 未测试
//   ⏳ TreeMap    - 未测试
//
// 已知问题：
//   1. Deque.back()/front() 返回类型推断错误（ptr vs i16）
//   2. LinkedHashMap.put() 调用 HashMap.put 时崩溃
//   3. TreeSet/TreeMap 未验证
//
// ─────────────────────────────────────────────────────────────────────────────

package test

import aura.lang.collection.ArrayList
import aura.lang.collection.HashSet
import aura.lang.collection.HashMap
import aura.lang.collection.LinkedList

fun main(): Int {
    println("=== ArrayList ===")
    var al = ArrayList<Int>()
    al.add(1)
    al.add(2)
    al.add(3)
    println("  size=" + al.count())
    println("  get(1)=" + al.getAt(1))
    
    println("=== HashSet ===")
    var hs = HashSet<Int>()
    hs.add(1)
    hs.add(2)
    hs.add(1)
    println("  size=" + hs.count())
    
    println("=== HashMap ===")
    var hm = HashMap<Int, Int>()
    hm.put(1, 10)
    hm.put(2, 20)
    println("  size=" + hm.getSize())
    println("  get(1)=" + hm.get(1))
    
    println("=== LinkedList ===")
    var ll = LinkedList<Integer>()
    ll.add(1)
    ll.add(2)
    println("  size=" + ll.count())
    
    println("=== ALL DONE ===")
    return 0
}
