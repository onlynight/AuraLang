package test

import aura.lang.collection.ArrayList
import aura.lang.collection.HashSet
import aura.lang.collection.HashMap
import aura.lang.collection.LinkedList
import aura.lang.collection.Deque
import aura.lang.collection.LinkedHashMap
import aura.lang.collection.TreeSet
import aura.lang.collection.TreeMap

fun main(): Int {
    // Test ArrayList
    var al = ArrayList<Int>()
    al.add(1)
    al.add(2)
    println("ArrayList size=" + al.count())
    
    // Test HashSet
    var hs = HashSet<Int>()
    hs.add(1)
    hs.add(2)
    hs.add(1)
    println("HashSet size=" + hs.count())
    
    // Test HashMap
    var hm = HashMap<Int, Int>()
    hm.put(1, 10)
    hm.put(2, 20)
    println("HashMap size=" + hm.getSize())
    
    // Test LinkedList
    var ll = LinkedList<Int>()
    ll.add(1)
    ll.add(2)
    println("LinkedList size=" + ll.count())
    
    // Test Deque
    var dq = Deque<Int>()
    dq.pushBack(1)
    dq.pushBack(2)
    println("Deque size=" + dq.count())
    
    // Test LinkedHashMap
    var lhm = LinkedHashMap<Int, Int>()
    lhm.put(1, 10)
    lhm.put(2, 20)
    println("LinkedHashMap size=" + lhm.getSize())
    
    // Test TreeSet
    var ts = TreeSet<Int>()
    ts.add(3)
    ts.add(1)
    ts.add(2)
    println("TreeSet size=" + ts.count())
    
    // Test TreeMap
    var tm = TreeMap<Int, Int>()
    tm.put(1, 10)
    tm.put(2, 20)
    println("TreeMap size=" + tm.getSize())
    
    println("ALL DONE")
    return 0
}
