// Math-only test - no println to avoid String.toFloat bug
import aura.lang.std.Math

fun main() {
    val x: Float = Math.sin(0.0f)
    val y: Float = Math.cos(0.0f)
    val z: Float = Math.sqrt(4.0f)
    val w: Float = Math.pow(2.0f, 3.0f)
    val a: Int = Math.abs(-5)
    
    // Exit code 0 if all values are computed correctly
    if (x == 0.0f && y == 1.0f && z == 2.0f && w == 8.0f && a == 5) {
        return 0
    }
    return 1
}