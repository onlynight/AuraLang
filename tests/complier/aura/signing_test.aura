// ═════════════════════════════════════════════════════════════
// Signing 测试用例 — 纯 Aura 化迁移
//
// 验证内容：
//   1. HMAC-SHA256 签名
//   2. 签名验证
//   3. 签名文件生成
//   4. 密钥配置
//
// 运行：aura run tests/complier/aura/signing_test.aura
//   全通过时最后输出 "RESULT: PASS"
// ═════════════════════════════════════════════════════════════

import "../../../aura/compiler/aura/lang/compiler/test/TestRunner.aura"
import "../../../aura/compiler/aura/lang/compiler/signing/Signing.aura"

fun main() {
    println("════════ Signing 测试用例 ════════")
    println("")

    var totalFailures: Int = 0

    // ── 套件 1：HMAC-SHA256 基本功能 ─────────────────────────
    val t1 = TestRunner()
    t1.begin("Signing/HmacSha256")

    val key = Encoding.hexDecode("deadbeefdeadbeefdeadbeefdeadbeef")
    val data = "hello world"

    val sig = hmacSha256(key, data)
    t1.assertTrue(sig.length > 0, "signature not empty")
    t1.assertEq(sig.length, 64, "signature hex length is 64")

    // 空数据
    val sigEmpty = hmacSha256(key, "")
    t1.assertEq(sigEmpty.length, 64, "empty data signature length")

    // 空密钥
    val sigEmptyKey = hmacSha256("", data)
    t1.assertEq(sigEmptyKey.length, 64, "empty key signature length")

    totalFailures = totalFailures + t1.report()

    // ── 套件 2：签名确定性 ───────────────────────────────────
    val t2 = TestRunner()
    t2.begin("Signing/Deterministic")

    val key2 = Encoding.hexDecode("aabbccdd")
    val sig1 = hmacSha256(key2, "test data")
    val sig2 = hmacSha256(key2, "test data")
    t2.assertEq(sig1, sig2, "same key and data produce same signature")

    // 不同数据
    val sig3 = hmacSha256(key2, "other data")
    t2.assertNotEq(sig1, sig3, "different data produces different signature")

    // 不同密钥
    val key3 = Encoding.hexDecode("deadbeef")
    val sig4 = hmacSha256(key3, "test data")
    t2.assertNotEq(sig1, sig4, "different key produces different signature")

    totalFailures = totalFailures + t2.report()

    // ── 套件 3：KeyConfig ────────────────────────────────────
    val t3 = TestRunner()
    t3.begin("Signing/KeyConfig")

    val config = KeyConfig()
    t3.assertEq(config.signer, "unknown", "default signer")

    config.hmacKey = "deadbeefdeadbeefdeadbeefdeadbeef"
    config.signer = "test-signer"
    t3.assertEq(config.hmacKey, "deadbeefdeadbeefdeadbeefdeadbeef", "key set")
    t3.assertEq(config.signer, "test-signer", "signer set")

    totalFailures = totalFailures + t3.report()

    // ── 套件 4：Signer ───────────────────────────────────────
    val t4 = TestRunner()
    t4.begin("Signing/Signer")

    val config2 = KeyConfig()
    config2.hmacKey = "deadbeefdeadbeefdeadbeefdeadbeef"
    config2.signer = "test"
    config2.timestamp = 1234567890

    val signer = Signer(config2)
    val signature = signer.sign("hello")
    t4.assertTrue(signature.length > 0, "signer produces signature")
    t4.assertEq(signature.length, 64, "signer signature hex length")

    // 签名文件
    val checksumContent = "abc123  META-INF/aura.toml\n"
    val sigFile = signer.generateSignatureFile(checksumContent)
    t4.assertTrue(sigFile.contains("test"), "sig file contains signer")
    t4.assertTrue(sigFile.contains("1234567890"), "sig file contains timestamp")

    totalFailures = totalFailures + t4.report()

    // ── 套件 5：Verifier ─────────────────────────────────────
    val t5 = TestRunner()
    t5.begin("Signing/Verifier")

    val config3 = KeyConfig()
    config3.hmacKey = "aabbccdd"
    config3.signer = "test"

    val verifier = Verifier(config3)

    // 正确签名
    val correctSig = hmacSha256(Encoding.hexDecode("aabbccdd"), "data")
    t5.assertTrue(verifier.verify("data", correctSig), "correct signature verifies")

    // 错误密钥
    val verifier2 = Verifier(config3)
    t5.assertFalse(verifier2.verify("data", hmacSha256(Encoding.hexDecode("wrongkey"), "data")), "wrong key fails")

    // 错误数据
    t5.assertFalse(verifier.verify("other", correctSig), "wrong data fails")

    totalFailures = totalFailures + t5.report()

    // ── 套件 6：常量 ─────────────────────────────────────────
    val t6 = TestRunner()
    t6.begin("Signing/Constants")

    t6.assertEq(SIGNATURE_PATH, "META-INF/signature.sig", "signature path")
    t6.assertEq(CHECKSUM_PATH, "META-INF/checksum.sha256", "checksum path")

    totalFailures = totalFailures + t6.report()

    // ── 汇总 ─────────────────────────────────────────────────
    println("")
    println("════════ 测试汇总 ════════")
    println("总失败数: " + toStr(totalFailures) + " (期望 0)")
    println("")

    if (totalFailures == 0) {
        println("RESULT: PASS")
    } else {
        println("RESULT: FAIL")
    }
}
