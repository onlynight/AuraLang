// ═════════════════════════════════════════════════════════════
// SourceMap 测试用例 — 纯 Aura 化迁移
//
// 验证内容：
//   1. SourceFile 行索引与字节偏移映射
//   2. 多文件管理
//   3. Span 位置映射
//   4. 诊断代码片段渲染（^ / ~ 标记）
//
// 运行：aura run tests/complier/aura/sourcemap_test.aura
//   全通过时最后输出 "RESULT: PASS"
// ═════════════════════════════════════════════════════════════

import "../../../aura/compiler/aura/lang/compiler/test/TestRunner.aura"
import "../../../aura/compiler/aura/lang/compiler/sourcemap/SourceMap.aura"
import "../../../aura/compiler/aura/lang/compiler/lexer/Span.aura"

fun main() {
    println("════════ SourceMap 测试用例 ════════")
    println("")

    var totalFailures: Int = 0

    // ── 套件 1：SourceFile 基本功能 ──────────────────────────
    val t1 = TestRunner()
    t1.begin("SourceMap/SourceFile")

    // 行计数
    val sf1 = SourceFile(1, "test.aura", "val x = 1\nval y = 2\n")
    t1.assertEq(sf1.lineCount(), 3, "line count with trailing newline")

    val sf2 = SourceFile(2, "test.aura", "val x = 1")
    t1.assertEq(sf2.lineCount(), 1, "single line without newline")

    val sf3 = SourceFile(3, "test.aura", "")
    t1.assertEq(sf3.lineCount(), 1, "empty source")

    val sf4 = SourceFile(4, "test.aura", "val x = 1\n")
    t1.assertEq(sf4.lineCount(), 2, "trailing newline")

    // 行文本
    val sf5 = SourceFile(5, "test.aura", "val x = 1\nval y = \"hi\"\n")
    t1.assertEq(sf5.lineText(1), "val x = 1", "line 1 text")
    t1.assertEq(sf5.lineText(2), "val y = \"hi\"", "line 2 text")

    // 行起始偏移
    val sf6 = SourceFile(6, "test.aura", "val x = 1\nval y = 2")
    t1.assertEq(sf6.lineStart(1), 0, "line 1 start offset")
    t1.assertEq(sf6.lineStart(2), 10, "line 2 start offset")

    // 位置映射
    val sf7 = SourceFile(7, "test.aura", "val x = 1\nval y = 2")
    val loc1 = sf7.location(0)
    t1.assertEq(loc1.first, 1, "offset 0 line")
    t1.assertEq(loc1.second, 1, "offset 0 col")

    val loc2 = sf7.location(4)
    t1.assertEq(loc2.first, 1, "offset 4 line")
    t1.assertEq(loc2.second, 5, "offset 4 col")

    val loc3 = sf7.location(10)
    t1.assertEq(loc3.first, 2, "offset 10 line")
    t1.assertEq(loc3.second, 1, "offset 10 col")

    totalFailures = totalFailures + t1.report()

    // ── 套件 2：SourceMap 多文件管理 ─────────────────────────
    val t2 = TestRunner()
    t2.begin("SourceMap/MultiFile")

    val sm = SourceMap()
    val id1 = sm.addFile("main.aura", "val x = 1")
    val id2 = sm.addFile("util.aura", "fun add(a: Int, b: Int): Int { return a + b }")

    t2.assertEq(sm.fileCount(), 2, "file count")
    t2.assertEq(sm.file(id1).name, "main.aura", "file 1 name")
    t2.assertEq(sm.file(id2).name, "util.aura", "file 2 name")
    t2.assertEq(sm.source(id1), "val x = 1", "source text")

    // 位置映射
    val loc = sm.location(id2, 4)
    t2.assertEq(loc.first, 1, "location line")
    t2.assertEq(loc.second, 5, "location col")

    totalFailures = totalFailures + t2.report()

    // ── 套件 3：Span 位置映射 ────────────────────────────────
    val t3 = TestRunner()
    t3.begin("SourceMap/SpanLocation")

    val sm2 = SourceMap()
    val id = sm2.addFile("main.aura", "val x = 1\nval y = 2")
    val span = spanSingle(4, 1, 5)
    val spanLoc = sm2.spanLocation(id, span)
    t3.assertEq(spanLoc.first.first, 1, "span start line")
    t3.assertEq(spanLoc.first.second, 5, "span start col")
    t3.assertEq(spanLoc.second.first, 1, "span end line")
    t3.assertEq(spanLoc.second.second, 6, "span end col")

    totalFailures = totalFailures + t3.report()

    // ── 套件 4：诊断代码片段 ─────────────────────────────────
    val t4 = TestRunner()
    t4.begin("SourceMap/Snippet")

    val sm3 = SourceMap()
    val id3 = sm3.addFile("main.aura", "val x = 1\nval y = 2\n")
    val span2 = spanSingle(4, 1, 5)
    val snippet = sm3.snippet(id3, span2)
    t4.assertTrue(snippet.contains("val x = 1"), "snippet contains source line")
    t4.assertTrue(snippet.contains("^"), "snippet contains caret marker")
    t4.assertTrue(snippet.contains("1 |"), "snippet contains line number")

    // 多行片段
    val sm4 = SourceMap()
    val id4 = sm4.addFile("main.aura", "fun f() {\n    return 1\n}\n")
    val span3 = Span(0, 22, 1, 1, 3, 2)
    val snippet2 = sm4.snippet(id4, span3)
    t4.assertTrue(snippet2.contains("fun f() {"), "multiline snippet start")
    t4.assertTrue(snippet2.contains("~"), "multiline snippet has tilde markers")

    totalFailures = totalFailures + t4.report()

    // ── 汇总 ─────────────────────────────────────────────────
    println("")
    println("════════ 测试汇总 ════════")
    println("总失败数: " + toStr(totalFailures) + " (期望 0)")
    println("")

    if (totalFailures == 0) {
        println("RESULT: PASS")
    } else {
        println("RESULT: FAIL")
    }
}
