// ═════════════════════════════════════════════════════════════
// Signature (.sig) 测试用例 — 纯 Aura 化迁移
//
// 验证内容：
//   1. TypeSig 各种类型表示
//   2. FuncSig / TypeDefSig / FieldSig / ConstSig 序列化
//   3. ModuleSig 完整序列化/反序列化
//   4. .sig 文件读写
//
// 运行：aura run tests/complier/aura/signature_test.aura
//   全通过时最后输出 "RESULT: PASS"
// ═════════════════════════════════════════════════════════════

import "../../../aura/compiler/aura/lang/compiler/test/TestRunner.aura"
import "../../../aura/compiler/aura/lang/compiler/signature/Signature.aura"

fun main() {
    println("════════ Signature 测试用例 ════════")
    println("")

    var totalFailures: Int = 0

    // ── 套件 1：TypeSig 基本类型 ──────────────────────────────
    val t1 = TestRunner()
    t1.begin("Signature/TypeSig-Basic")

    val intType = TypeSig()
    intType.initInt()
    t1.assertEq(intType.toStr(), "int", "int type string")

    val floatType = TypeSig()
    floatType.initFloat()
    t1.assertEq(floatType.toStr(), "float", "float type string")

    val boolType = TypeSig()
    boolType.initBool()
    t1.assertEq(boolType.toStr(), "bool", "bool type string")

    val strType = TypeSig()
    strType.initStr()
    t1.assertEq(strType.toStr(), "str", "str type string")

    val nullType = TypeSig()
    nullType.initNull()
    t1.assertEq(nullType.toStr(), "null", "null type string")

    totalFailures = totalFailures + t1.report()

    // ── 套件 2：TypeSig 复合类型 ──────────────────────────────
    val t2 = TestRunner()
    t2.begin("Signature/TypeSig-Complex")

    // Ref type
    val refTarget = TypeSig()
    refTarget.initInt()
    val refType = TypeSig()
    refType.initRef(refTarget)
    t2.assertEq(refType.toStr(), "&int", "ref type string")

    // Tuple type
    val tupleParams: List<TypeSig> = []
    val tInt = TypeSig()
    tInt.initInt()
    val tStr = TypeSig()
    tStr.initStr()
    tupleParams.add(tInt)
    tupleParams.add(tStr)
    val tupleType = TypeSig()
    tupleType.initTuple(tupleParams)
    t2.assertEq(tupleType.toStr(), "(int, str)", "tuple type string")

    // Func type
    val funcParams: List<TypeSig> = []
    val fInt = TypeSig()
    fInt.initInt()
    val fStr = TypeSig()
    fStr.initStr()
    funcParams.add(fInt)
    funcParams.add(fStr)
    val fReturn = TypeSig()
    fReturn.initBool()
    val funcType = TypeSig()
    funcType.initFunc(funcParams, fReturn)
    t2.assertEq(funcType.toStr(), "(int, str) -> bool", "func type string")

    // Generic type
    val genParams: List<TypeSig> = []
    val gInt = TypeSig()
    gInt.initInt()
    genParams.add(gInt)
    val genType = TypeSig()
    genType.initGeneric("List", genParams)
    t2.assertEq(genType.toStr(), "List<int>", "generic type string")

    // User type
    val userType = TypeSig()
    userType.initUserType("Point", [])
    t2.assertEq(userType.toStr(), "Point", "user type string")

    // Nested types
    val nestedTarget = TypeSig()
    nestedTarget.initStr()
    val nestedRef = TypeSig()
    nestedRef.initRef(nestedTarget)
    t2.assertEq(nestedRef.toStr(), "&str", "nested ref type")

    totalFailures = totalFailures + t2.report()

    // ── 套件 3：TypeSig 序列化/反序列化 ──────────────────────
    val t3 = TestRunner()
    t3.begin("Signature/TypeSig-Serialization")

    val original = TypeSig()
    original.initFunc([], TypeSig.int())

    val json = original.toJson()
    val restored = TypeSig.fromJson(json)
    t3.assertEq(restored.kind, original.kind, "type kind preserved")

    totalFailures = totalFailures + t3.report()

    // ── 套件 4：ModuleSig 查找 ────────────────────────────────
    val t4 = TestRunner()
    t4.begin("Signature/ModuleSig-Lookup")

    val sig = ModuleSig("test", "1.0.0", "abcdef1234567890")
    t4.assertEq(sig.moduleName, "test", "module name")
    t4.assertEq(sig.moduleVersion, "1.0.0", "module version")

    // 添加函数
    val func = FuncSig()
    func.name = "add"
    func.isPublic = true
    val p1 = TypeSig()
    p1.initInt()
    val p2 = TypeSig()
    p2.initInt()
    func.params.add(p1)
    func.params.add(p2)
    val ret = TypeSig()
    ret.initInt()
    func.returnType = ret
    sig.functions.add(func)

    // 查找函数
    val found = sig.findFunction("add")
    t4.assertNotNull(found, "find function")
    t4.assertEq(found.name, "add", "found function name")
    t4.assertNull(sig.findFunction("nonexistent"), "find nonexistent function")

    totalFailures = totalFailures + t4.report()

    // ── 套件 5：ModuleSig 完整序列化 ─────────────────────────
    val t5 = TestRunner()
    t5.begin("Signature/ModuleSig-Serialization")

    val sig2 = ModuleSig("math", "2.0.0", "1234567890abcdef")
    val func2 = FuncSig()
    func2.name = "add"
    func2.isPublic = true
    val pInt1 = TypeSig()
    pInt1.initInt()
    val pInt2 = TypeSig()
    pInt2.initInt()
    func2.params.add(pInt1)
    func2.params.add(pInt2)
    val rInt = TypeSig()
    rInt.initInt()
    func2.returnType = rInt
    sig2.functions.add(func2)

    val json = sig2.toJson()
    val restored = ModuleSig.fromJson(json)
    t5.assertEq(restored.moduleName, "math", "restored module name")
    t5.assertEq(restored.moduleVersion, "2.0.0", "restored module version")
    t5.assertEq(restored.functions.length, 1, "restored function count")
    t5.assertEq(restored.functions[0].name, "add", "restored function name")

    totalFailures = totalFailures + t5.report()

    // ── 套件 6：sigToBytes / sigFromBytes 往返 ────────────────
    val t6 = TestRunner()
    t6.begin("Signature/SigBytes-Roundtrip")

    val sig3 = ModuleSig("roundtrip", "1.0.0", "fedcba0987654321")
    val f = FuncSig()
    f.name = "test"
    f.isPublic = true
    val rT = TypeSig()
    rT.initNull()
    f.returnType = rT
    sig3.functions.add(f)

    val bytes = sigToBytes(sig3)
    t6.assertTrue(bytes.length > 10, "bytes length > 10")
    t6.assertEq(bytes.substring(0, 4), "ASIG", "magic number")

    val restored = sigFromBytes(bytes)
    t6.assertNotNull(restored, "restored not null")
    t6.assertEq(restored.moduleName, "roundtrip", "restored name")
    t6.assertEq(restored.moduleVersion, "1.0.0", "restored version")

    totalFailures = totalFailures + t6.report()

    // ── 汇总 ─────────────────────────────────────────────────
    println("")
    println("════════ 测试汇总 ════════")
    println("总失败数: " + toStr(totalFailures) + " (期望 0)")
    println("")

    if (totalFailures == 0) {
        println("RESULT: PASS")
    } else {
        println("RESULT: FAIL")
    }
}
