// ═════════════════════════════════════════════════════════════
// Package Management 测试用例 — 纯 Aura 化迁移
//
// 验证内容：
//   1. 语义化版本解析与比较
//   2. 版本约束匹配
//   3. @depends 依赖解析
//   4. 清单文件 TOML 解析
//   5. 锁定文件解析
//
// 运行：aura run tests/complier/aura/package_test.aura
//   全通过时最后输出 "RESULT: PASS"
// ═════════════════════════════════════════════════════════════

import "../../../aura/compiler/aura/lang/compiler/test/TestRunner.aura"
import "../../../aura/compiler/aura/lang/compiler/package/Package.aura"

fun main() {
    println("════════ Package Management 测试用例 ════════")
    println("")

    var totalFailures: Int = 0

    // ── 套件 1：版本解析 ─────────────────────────────────────
    val t1 = TestRunner()
    t1.begin("Package/VersionParse")

    val v1 = Version.parse("1.2.3")
    t1.assertEq(v1.major, 1, "major version")
    t1.assertEq(v1.minor, 2, "minor version")
    t1.assertEq(v1.patch, 3, "patch version")

    val v2 = Version.parse("1.2")
    t1.assertEq(v2.major, 1, "two-part major")
    t1.assertEq(v2.minor, 2, "two-part minor")
    t1.assertEq(v2.patch, 0, "two-part patch defaults to 0")

    t1.assertNull(Version.parse("invalid"), "invalid version")
    t1.assertNull(Version.parse("1"), "single-part version")
    t1.assertNull(Version.parse(""), "empty version")

    // 带预发布版本
    val v3 = Version.parse("1.2.3-rc.1")
    t1.assertEq(v3.prerelease.length, 2, "prerelease length")
    t1.assertEq(v3.prerelease[0], "rc", "prerelease id 0")
    t1.assertEq(v3.prerelease[1], "1", "prerelease id 1")

    totalFailures = totalFailures + t1.report()

    // ── 套件 2：版本字符串转换 ──────────────────────────────
    val t2 = TestRunner()
    t2.begin("Package/VersionToString")

    val v4 = Version.parse("1.2.3")
    t2.assertEq(v4.toStr(), "1.2.3", "version to string")

    val v5 = Version.parse("1.0.0-alpha.1")
    t2.assertEq(v5.toStr(), "1.0.0-alpha.1", "version with prerelease")

    totalFailures = totalFailures + t2.report()

    // ── 套件 3：版本比较 ────────────────────────────────────
    val t3 = TestRunner()
    t3.begin("Package/VersionCompare")

    val va = Version.parse("1.0.0")
    val vb = Version.parse("1.1.0")
    val vc = Version.parse("2.0.0")

    t3.assertTrue(va.compareTo(vb) < 0, "1.0.0 < 1.1.0")
    t3.assertTrue(vb.compareTo(vc) < 0, "1.1.0 < 2.0.0")
    t3.assertEq(va.compareTo(va), 0, "equal versions")

    // 预发布版本排序
    val vStable = Version.parse("1.0.0")
    val vRc = Version.parse("1.0.0-rc.1")
    t3.assertTrue(vRc.compareTo(vStable) < 0, "prerelease < stable")

    totalFailures = totalFailures + t3.report()

    // ── 套件 4：版本约束 ────────────────────────────────────
    val t4 = TestRunner()
    t4.begin("Package/VersionConstraint")

    // Exact match
    val c1 = VersionConstraint.parse("== 1.2.3")
    t4.assertTrue(Version.parse("1.2.3").matchesConstraint(c1), "exact match")
    t4.assertFalse(Version.parse("1.2.4").matchesConstraint(c1), "exact no match")

    // Greater or equal
    val c2 = VersionConstraint.parse(">= 1.0.0")
    t4.assertTrue(Version.parse("1.0.0").matchesConstraint(c2), "gte equal")
    t4.assertTrue(Version.parse("1.1.0").matchesConstraint(c2), "gte greater")
    t4.assertFalse(Version.parse("0.9.0").matchesConstraint(c2), "gte less")

    // Greater than
    val c3 = VersionConstraint.parse("> 1.0.0")
    t4.assertTrue(Version.parse("1.0.1").matchesConstraint(c3), "gt greater")
    t4.assertFalse(Version.parse("1.0.0").matchesConstraint(c3), "gt equal")

    // Less than
    val c4 = VersionConstraint.parse("< 2.0.0")
    t4.assertTrue(Version.parse("1.9.0").matchesConstraint(c4), "lt less")
    t4.assertFalse(Version.parse("2.0.0").matchesConstraint(c4), "lt equal")

    // Tilde
    val c5 = VersionConstraint.parse("~> 1.0.0")
    t4.assertTrue(Version.parse("1.0.0").matchesConstraint(c5), "tilde base")
    t4.assertTrue(Version.parse("1.5.0").matchesConstraint(c5), "tilde same major")
    t4.assertFalse(Version.parse("2.0.0").matchesConstraint(c5), "tilde different major")

    // Compatible
    val c6 = VersionConstraint.parse("^1.0.0")
    t4.assertTrue(Version.parse("1.0.0").matchesConstraint(c6), "compatible base")
    t4.assertTrue(Version.parse("1.5.0").matchesConstraint(c6), "compatible same major")
    t4.assertFalse(Version.parse("2.0.0").matchesConstraint(c6), "compatible different major")

    // Any
    val c7 = VersionConstraint.parse("*")
    t4.assertTrue(Version.parse("99.99.99").matchesConstraint(c7), "any match")

    totalFailures = totalFailures + t4.report()

    // ── 套件 5：约束字符串转换 ──────────────────────────────
    val t5 = TestRunner()
    t5.begin("Package/ConstraintToString")

    val c8 = VersionConstraint.parse("== 2.1.0")
    t5.assertEq(c8.toStr(), "== 2.1.0", "exact to string")

    val c9 = VersionConstraint.parse(">= 1.0.0")
    t5.assertEq(c9.toStr(), ">= 1.0.0", "gte to string")

    val c10 = VersionConstraint.parse("> 1.0.0")
    t5.assertEq(c10.toStr(), "> 1.0.0", "gt to string")

    val c11 = VersionConstraint.parse("< 1.0.0")
    t5.assertEq(c11.toStr(), "< 1.0.0", "lt to string")

    val c12 = VersionConstraint.parse("~> 3.0.0")
    t5.assertEq(c12.toStr(), "~> 3.0.0", "tilde to string")

    val c13 = VersionConstraint.parse("^4.5.0")
    t5.assertEq(c13.toStr(), "^4.5.0", "compatible to string")

    val c14 = VersionConstraint.parse("*")
    t5.assertEq(c14.toStr(), "*", "any to string")

    totalFailures = totalFailures + t5.report()

    // ── 套件 6：@depends 解析 ───────────────────────────────
    val t6 = TestRunner()
    t6.begin("Package/DependsParse")

    val source1 = "// @depends aura-json >= 1.0\n// @depends aura-http == 2.1\nimport json"
    val deps1 = parseDepends(source1)
    t6.assertEq(deps1.length, 2, "two dependencies parsed")
    t6.assertEq(deps1[0].name, "aura-json", "first dep name")
    t6.assertEq(deps1[1].name, "aura-http", "second dep name")

    // 带来源的依赖
    val source2 = "// @depends aura-http from git@github.com:user/http.git"
    val deps2 = parseDepends(source2)
    t6.assertEq(deps2.length, 1, "one dependency parsed")
    t6.assertEq(deps2[0].source, "git@github.com:user/http.git", "source URL")

    // 混合内容
    val source3 = "fun main() {\n    // @depends aura-math ~> 2.0\n    println(1)\n}\n// @depends aura-string >= 1.0"
    val deps3 = parseDepends(source3)
    t6.assertEq(deps3.length, 2, "two deps in mixed source")

    // 无版本约束
    val source4 = "// @depends aura-json"
    val deps4 = parseDepends(source4)
    t6.assertEq(deps4.length, 1, "dep without version")

    totalFailures = totalFailures + t6.report()

    // ── 套件 7：清单文件解析 ────────────────────────────────
    val t7 = TestRunner()
    t7.begin("Package/Manifest")

    val toml1 = "name = \"test-pkg\"\nversion = \"0.1.0\"\nentry = \"main.aura\"\nlibrary = false\nkind = \"bytecode\"\n"
    val manifest1 = PackageManifest.fromToml(toml1)
    t7.assertEq(manifest1.name, "test-pkg", "manifest name")
    t7.assertEq(manifest1.version, "0.1.0", "manifest version")
    t7.assertEq(manifest1.entry, "main.aura", "manifest entry")
    t7.assertFalse(manifest1.library, "manifest library")
    t7.assertEq(manifest1.kind, "bytecode", "manifest kind")

    // 库判断
    val manifest2 = PackageManifest.fromToml("name = \"lib\"\nlibrary = true\n")
    t7.assertTrue(manifest2.isLibrary(), "library is library")

    val manifest3 = PackageManifest.fromToml("name = \"app\"\nentry = \"\"\n")
    t7.assertTrue(manifest3.isLibrary(), "empty entry is library")

    totalFailures = totalFailures + t7.report()

    // ── 套件 8：清单 TOML 序列化 ────────────────────────────
    val t8 = TestRunner()
    t8.begin("Package/ManifestSerialize")

    val manifest4 = PackageManifest()
    manifest4.name = "my-package"
    manifest4.version = "1.0.0"
    manifest4.description = "A test package"
    manifest4.entry = "main.aura"
    manifest4.library = false
    manifest4.kind = "hybrid"

    val tomlOut = manifest4.toToml()
    t8.assertTrue(tomlOut.contains("my-package"), "toml contains name")
    t8.assertTrue(tomlOut.contains("1.0.0"), "toml contains version")
    t8.assertTrue(tomlOut.contains("hybrid"), "toml contains kind")

    totalFailures = totalFailures + t8.report()

    // ── 套件 9：锁定文件 ────────────────────────────────────
    val t9 = TestRunner()
    t9.begin("Package/LockFile")

    val lockToml = "version = 1\n\n[[dependencies]]\nname = \"aura-json\"\nversion = \"1.0.0\"\nsource = \"https://github.com/aura/json\"\n\n[[dependencies]]\nname = \"aura-string\"\nversion = \"2.1.0\"\nsource = \"https://github.com/aura/string\"\n"
    val lockFile = LockFile.fromToml(lockToml)
    t9.assertEq(lockFile.version, 1, "lock file version")
    t9.assertEq(lockFile.dependencies.length, 2, "two lock entries")
    t9.assertEq(lockFile.dependencies[0].name, "aura-json", "first lock name")
    t9.assertEq(lockFile.dependencies[1].name, "aura-string", "second lock name")

    // 查找
    val found = lockFile.find("aura-json")
    t9.assertNotNull(found, "find lock entry")
    t9.assertEq(found.name, "aura-json", "found lock entry name")
    t9.assertNull(lockFile.find("nonexistent"), "find nonexistent")

    totalFailures = totalFailures + t9.report()

    // ── 汇总 ─────────────────────────────────────────────────
    println("")
    println("════════ 测试汇总 ════════")
    println("总失败数: " + toStr(totalFailures) + " (期望 0)")
    println("")

    if (totalFailures == 0) {
        println("RESULT: PASS")
    } else {
        println("RESULT: FAIL")
    }
}
