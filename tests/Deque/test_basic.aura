package test

import aura.lang.collection.Deque

fun main(): Int {
    var d = Deque<Int>()
    d.pushBack(1)
    d.pushBack(2)
    d.pushFront(0)
    println("size=" + d.count())
    println("front=" + d.front())
    println("back=" + d.back())
    d.popFront()
    println("after popFront size=" + d.count())
    return 0
}
