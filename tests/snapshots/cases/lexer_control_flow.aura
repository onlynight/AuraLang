// snapshot case: control-flow tokens (if / else / while / for / when)
fun classify(n: Int): String {
    if (n < 0) {
        return "negative"
    } else if (n == 0) {
        return "zero"
    } else {
        return "positive"
    }
}

fun sumTo(n: Int): Int {
    var s = 0
    var i = 1
    while (i <= n) {
        s += i
        i += 1
    }
    for (j in 0..3) {
        s = s + j
    }
    return s
}

fun dayName(day: Int): String {
    return when (day) {
        1 -> "Mon"
        2 -> "Tue"
        else -> "Other"
    }
}
