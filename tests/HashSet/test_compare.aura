package test

import aura.lang.collection.ArrayList
import aura.lang.collection.HashSet

fun main(): Int {
    // Test ArrayList directly
    var l = ArrayList<Int>()
    l.add(1)
    l.add(2)
    l.add(3)
    println("ArrayList size=" + l.count())
    
    // Test HashSet
    var s = HashSet<Int>()
    println("Before HashSet add")
    s.add(1)
    println("After HashSet add")
    println("HashSet size=" + s.count())
    return 0
}
