// Test splitPipe on actual symbol entries
package aura.lang.compiler.backend.photon
import aura.lang.std.String

fun main() {
    val entry1: String = "main|0|1|0x0001|0x01"
    val entry2: String = "@str.0|0|2|0x0001|0x02"
    
    println("Entry 1: " + entry1)
    println("Entry 1 fields:")
    var fields1: List<String> = splitPipe(entry1)
    var i: Int = 0
    while (i < fields1.size) {
        println("  Field $i: '" + fields1[i] + "' (length=" + fields1[i].length + ")")
        i = i + 1
    }
    
    println("Entry 2: " + entry2)
    println("Entry 2 fields:")
    var fields2: List<String> = splitPipe(entry2)
    i = 0
    while (i < fields2.size) {
        println("  Field $i: '" + fields2[i] + "' (length=" + fields2[i].length + ")")
        i = i + 1
    }
    
    // Test padSectionName with the actual fields
    println("padSectionName(fields1[0], 8): " + padSectionName(fields1[0], 8))
    println("padSectionName(fields2[0], 8): " + padSectionName(fields2[0], 8))
}

fun splitPipe(text: String): List<String> {
    val result: List<String> = arrayListOf<String>()
    if (text == "") {
        return result
    }
    var start: Int = 0
    var i: Int = 0
    var len: Int = text.length
    while (i < len) {
        if (text.substring(i, i + 1).charCodeAt(0) == 124) {  // '|'
            result.add(text.substring(start, i))
            start = i + 1
        }
        i = i + 1
    }
    if (start < len) {
        result.add(text.substring(start, len))
    }
    return result
}

fun padSectionName(name: String, len: Int): String {
    var out: String = ""
    var i: Int = 0
    while (i < name.length && i < len) {
        val c: Int = name.substring(i, i + 1).charCodeAt(0)
        out = out + hexDigit(c / 16) + hexDigit(c % 16)
        i = i + 1
    }
    while (out.length < len * 2) {
        out = out + "00"
    }
    return out
}

fun hexDigit(d: Int): String {
    if (d == 0) return "0"
    if (d == 1) return "1"
    if (d == 2) return "2"
    if (d == 3) return "3"
    if (d == 4) return "4"
    if (d == 5) return "5"
    if (d == 6) return "6"
    if (d == 7) return "7"
    if (d == 8) return "8"
    if (d == 9) return "9"
    if (d == 10) return "a"
    if (d == 11) return "b"
    if (d == 12) return "c"
    if (d == 13) return "d"
    if (d == 14) return "e"
    return "f"
}
