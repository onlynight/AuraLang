package aura.lang.compiler.photon
// Debug: test select() within the photon package

import aura.lang.std.String
import "../../../aura/photon/aura/lang/compiler/photon/Lir.aura"
import "../../../aura/photon/aura/lang/compiler/photon/MachineDag.aura"
import "../../../aura/photon/aura/lang/compiler/photon/InstructionSelection.aura"

fun main() {
    println("═══Debug Select ═══")

    // Test 1: empty program
    println("[1] empty program")
    val lir = LirUtils.emptyProgram()
    println("  program created, functionCount=" + lir.functionCount)

    // Test 2: selector creation
    println("[2] selector creation")
    val sel = InstructionSelectorUtils.emptySelector()
    println("  selector created")

    // Test 3: call select
    println("[3] call select")
    val dag = sel.select(lir)
    println("  nodes=" + dag.nodeCount + " instrs=" + dag.instrCount)
    println("  PASS")
}
