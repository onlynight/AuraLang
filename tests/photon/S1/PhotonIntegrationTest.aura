// aura:///aura/lang/compiler/backend/BackendIntegrationTest.aura
package aura.lang.compiler.backend.photon
// ─────────────────────────────────────────────────────────────
// 新后端集成测试 — 验证 helloworld 通过完整管线
//
// 测试内容：
//   1. X86Encoder: 指令编码验证
//   2. BackendPipeline: 完整管线执行
//   3. 机器码字节验证
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String
import "../../../aura/compiler/aura/lang/compiler/backend/photon/x86_64/X86Encoder.aura"
import "../../../aura/compiler/aura/lang/compiler/backend/photon/PhotonPipeline.aura"

/// 测试入口。
fun main() {
    println("╔══════════════════════════════════════════════════╗")
    println("║   新编译后端集成测试 — Phase A-E 全流程验证      ║")
    println("╚══════════════════════════════════════════════════╝")
    println("")

    var failures: Int = 0
    var tests: Int = 0

    // ── 测试 1: X86Encoder 基础编码 ──
    tests = tests + 1
    println("[Test 1] X86Encoder: 基础指令编码")
    val encoder = X86EncoderUtils.emptyEncoder()
    encoder.emitPrologue(48)
    encoder.emitEpilogue()
    val proEpiHex = encoder.toHex()
    println("  Prologue+Epilogue: " + proEpiHex)
    if (proEpiHex != "") {
        println("  ✓ 编码成功 (" + encoder.byteCount() + " 字节)")
    } else {
        println("  ✗ 编码失败")
        failures = failures + 1
    }

    // ── 测试 2: X86Encoder MOV 指令 ──
    tests = tests + 1
    println("[Test 2] X86Encoder: MOV 指令编码")
    val enc2 = X86EncoderUtils.emptyEncoder()
    enc2.emitMovRR("rax", "rcx")
    enc2.emitMovRI("rdx", 42)
    val movHex = enc2.toHex()
    println("  MOV rax, rcx; MOV rdx, 42: " + movHex)
    if (movHex != "") {
        println("  ✓ MOV 编码成功 (" + enc2.byteCount() + " 字节)")
    } else {
        println("  ✗ MOV 编码失败")
        failures = failures + 1
    }

    // ── 测试 3: X86Encoder 算术指令 ──
    tests = tests + 1
    println("[Test 3] X86Encoder: 算术指令编码")
    val enc3 = X86EncoderUtils.emptyEncoder()
    enc3.emitAddRR("rax", "rcx")
    enc3.emitSubRR("rax", "rdx")
    enc3.emitCmpRI("rax", 0)
    val arithHex = enc3.toHex()
    println("  ADD/SUB/CMP: " + arithHex)
    if (arithHex != "") {
        println("  ✓ 算术编码成功 (" + enc3.byteCount() + " 字节)")
    } else {
        println("  ✗ 算术编码失败")
        failures = failures + 1
    }

    // ── 测试 4: X86Encoder 控制流指令 ──
    tests = tests + 1
    println("[Test 4] X86Encoder: 控制流指令编码")
    val enc4 = X86EncoderUtils.emptyEncoder()
    enc4.emitRet()
    enc4.emitNop()
    enc4.emitCallRel("println")
    val cfHex = enc4.toHex()
    val relocCount = enc4.getRelocations().size
    println("  RET/NOP/CALL: " + cfHex)
    println("  重定位项: " + relocCount)
    if (cfHex != "" && relocCount == 1) {
        println("  ✓ 控制流编码成功 (" + enc4.byteCount() + " 字节)")
    } else {
        println("  ✗ 控制流编码失败")
        failures = failures + 1
    }

    // ── 测试 5: X86Encoder SETcc 指令 ──
    tests = tests + 1
    println("[Test 5] X86Encoder: SETcc 条件设置编码")
    val enc5 = X86EncoderUtils.emptyEncoder()
    enc5.emitSetcc("al", "eq")
    enc5.emitSetcc("bl", "ne")
    enc5.emitSetcc("cl", "lt")
    val setHex = enc5.toHex()
    println("  SETcc: " + setHex)
    if (setHex != "") {
        println("  ✓ SETcc 编码成功 (" + enc5.byteCount() + " 字节)")
    } else {
        println("  ✗ SETcc 编码失败")
        failures = failures + 1
    }

    // ── 测试 6: PhotonPipeline 完整管线 ──
    tests = tests + 1
    println("[Test 6] BackendPipeline: 完整管线执行")
    val pipeline = PhotonPipelineUtils.emptyPipeline()
    val helloworld = "fun main() {\n    println(\"hello\")\n}\n"
    val result = pipeline.compile(helloworld, "build", "helloworld")
    if (result.success) {
        println("  ✓ 管线执行成功")
        println("    目标文件: " + result.objectFilePath)
        println("    可执行文件: " + result.executablePath)
        println("    机器码: " + result.machineCodeHex)
        println("    字节数: " + result.encodedByteCount)
        println("    重定位数: " + result.relocationCount)
        println("    函数数: " + result.functionCount)
    } else {
        println("  ✗ 管线执行失败: " + result.errorMessage)
        failures = failures + 1
    }

    // ── 测试 7: 完整 helloworld 机器码 ──
    tests = tests + 1
    println("[Test 7] 完整 helloworld 机器码验证")
    val hwEncoder = X86EncoderUtils.emptyEncoder()

    // main 函数
    hwEncoder.emitPrologue(48)
    // lea rcx, [rip + "hello"]
    hwEncoder.emitLeaRIP("rcx", "@str.0")
    // call println
    hwEncoder.emitCallRel("println")
    // xor eax, eax (return 0)
    hwEncoder.emitXorRR("eax", "eax")
    // epilogue
    hwEncoder.emitEpilogue()

    val hwHex = hwEncoder.toHex()
    val hwRelocs = hwEncoder.getRelocations()
    println("  机器码: " + hwHex)
    println("  重定位:")
    var i: Int = 0
    while (i < hwRelocs.size) {
        println("    [" + i + "] " + hwRelocs[i])
        i = i + 1
    }
    if (hwHex != "" && hwRelocs.size == 2) {
        println("  ✓ helloworld 机器码验证通过 (" + hwEncoder.byteCount() + " 字节)")
    } else {
        println("  ✗ helloworld 机器码验证失败")
        failures = failures + 1
    }

    // ── 汇总 ──
    println("")
    println("══════════════════════════════════════════════════")
    println("测试结果: " + (tests - failures) + "/" + tests + " 通过")
    if (failures == 0) {
        println("RESULT: PASS — 新编译后端集成测试全部通过")
    } else {
        println("RESULT: FAIL (" + failures + " 失败)")
    }
    println("══════════════════════════════════════════════════")
}
