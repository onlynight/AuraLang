// Debug: simulate buildCoffFile symbol table generation
package aura.lang.compiler.backend.photon
import aura.lang.std.String

fun main() {
    // Simulate the symbols string
    val symbols: String = "main|0|1|0x0001|0x01;;@str.0|0|2|0x0001|0x02"
    
    // Split by ;;
    var symParts: List<String> = splitDoubleSemi(symbols)
    println("symParts size: " + symParts.size)
    
    var j: Int = 0
    var buf: String = ""
    while (j < symParts.size) {
        if (symParts[j] != "") {
            val fields: List<String> = splitPipe(symParts[j])
            println("fields size: " + fields.size)
            println("fields[0]: '" + fields[0] + "'")
            
            if (fields.size >= 5) {
                val nameHex: String = padSectionName(fields[0], 8)
                println("padSectionName result: " + nameHex)
                buf = buf + nameHex
                
                val valueHex: String = writeIntLe(strToInt(fields[1]), 4)
                println("writeIntLe(0,4) result: " + valueHex)
                buf = buf + valueHex
                
                val sectionHex: String = writeIntLe(strToInt(fields[2]), 2)
                println("writeIntLe(1,2) result: " + sectionHex)
                buf = buf + sectionHex
                
                val typeHex: String = writeIntLe(hexToInt(fields[3]), 2)
                println("writeIntLe(hexToInt('0x0001'),2) result: " + typeHex)
                buf = buf + typeHex
                
                val storageHex: String = writeIntLe(hexToInt(fields[4]), 1)
                println("writeIntLe(hexToInt('0x01'),1) result: " + storageHex)
                buf = buf + storageHex
                
                buf = buf + writeIntLe(0, 1)
            }
        }
        j = j + 1
    }
    
    println("Final buf: " + buf)
}

fun splitDoubleSemi(text: String): List<String> {
    val result: List<String> = arrayListOf<String>()
    if (text == "") { return result }
    var start: Int = 0
    var i: Int = 0
    var len: Int = text.length
    while (i < len - 1) {
        if (text.substring(i, i + 2) == ";;") {
            result.add(text.substring(start, i))
            start = i + 2
        }
        i = i + 1
    }
    if (start < len) { result.add(text.substring(start, len)) }
    return result
}

fun splitPipe(text: String): List<String> {
    val result: List<String> = arrayListOf<String>()
    if (text == "") { return result }
    var start: Int = 0
    var i: Int = 0
    var len: Int = text.length
    while (i < len) {
        if (text.substring(i, i + 1).charCodeAt(0) == 124) {
            result.add(text.substring(start, i))
            start = i + 1
        }
        i = i + 1
    }
    if (start < len) { result.add(text.substring(start, len)) }
    return result
}

fun padSectionName(name: String, len: Int): String {
    var out: String = ""
    var i: Int = 0
    while (i < name.length && i < len) {
        val c: Int = name.substring(i, i + 1).charCodeAt(0)
        out = out + hexDigit(c / 16) + hexDigit(c % 16)
        i = i + 1
    }
    while (out.length < len * 2) { out = out + "00" }
    return out
}

fun writeIntLe(value: Int, bytes: Int): String {
    var out: String = ""
    var v: Int = value
    var i: Int = 0
    while (i < bytes) {
        out = out + hexDigit(v / 16 % 16) + hexDigit(v % 16)
        v = v / 256
        i = i + 1
    }
    return out
}

fun strToInt(text: String): Int {
    if (text == "") { return 0 }
    var total: Int = 0
    var neg: Boolean = false
    var i: Int = 0
    if (text.charCodeAt(0) == 45) { neg = true; i = 1 }
    while (i < text.length) {
        total = total * 10 + (text.substring(i, i + 1).charCodeAt(0) - 48)
        i = i + 1
    }
    if (neg) { return -total }
    return total
}

fun hexToInt(text: String): Int {
    if (text == "") { return 0 }
    var total: Int = 0
    var i: Int = 0
    while (i < text.length) {
        val c: Int = text.substring(i, i + 1).charCodeAt(0)
        var digit: Int = 0
        if (c >= 48 && c <= 57) { digit = c - 48 }
        else if (c >= 97 && c <= 102) { digit = c - 87 }
        else if (c >= 65 && c <= 70) { digit = c - 55 }
        total = total * 16 + digit
        i = i + 1
    }
    return total
}

fun hexDigit(d: Int): String {
    if (d == 0) return "0"
    if (d == 1) return "1"
    if (d == 2) return "2"
    if (d == 3) return "3"
    if (d == 4) return "4"
    if (d == 5) return "5"
    if (d == 6) return "6"
    if (d == 7) return "7"
    if (d == 8) return "8"
    if (d == 9) return "9"
    if (d == 10) return "a"
    if (d == 11) return "b"
    if (d == 12) return "c"
    if (d == 13) return "d"
    if (d == 14) return "e"
    return "f"
}
