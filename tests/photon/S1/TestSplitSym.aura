// Test splitPipe on symbol entries
package aura.lang.compiler.backend.photon
import aura.lang.std.String

fun main() {
    // Simulate the symbols string
    val symbols: String = "main|0|1|0x0001|0x01;;@str.0|0|2|0x0001|0x02"
    println("Symbols: " + symbols)
    
    // Split by ;;
    var start: Int = 0
    var i: Int = 0
    var len: Int = symbols.length
    println("\nSplitting by ;;")
    while (i < len - 1) {
        if (symbols.substring(i, i + 2) == ";;") {
            val entry: String = symbols.substring(start, i)
            println("Entry: " + entry)
            // Split entry by |
            var pStart: Int = 0
            var j: Int = 0
            var entryLen: Int = entry.length
            var fieldIdx: Int = 0
            while (j < entryLen) {
                if (entry.substring(j, j + 1).charCodeAt(0) == 124) {  // '|'
                    val field: String = entry.substring(pStart, j)
                    println("  Field $fieldIdx: " + field)
                    fieldIdx = fieldIdx + 1
                    pStart = j + 1
                }
                j = j + 1
            }
            if (pStart < entryLen) {
                val field: String = entry.substring(pStart, entryLen)
                println("  Field $fieldIdx: " + field)
                fieldIdx = fieldIdx + 1
            }
            start = i + 2
        }
        i = i + 1
    }
    if (start < len) {
        val entry: String = symbols.substring(start, len)
        println("Entry: " + entry)
        var pStart: Int = 0
        var j: Int = 0
        var entryLen: Int = entry.length
        var fieldIdx: Int = 0
        while (j < entryLen) {
            if (entry.substring(j, j + 1).charCodeAt(0) == 124) {  // '|'
                val field: String = entry.substring(pStart, j)
                println("  Field $fieldIdx: " + field)
                fieldIdx = fieldIdx + 1
                pStart = j + 1
            }
            j = j + 1
        }
        if (pStart < entryLen) {
            val field: String = entry.substring(pStart, entryLen)
            println("  Field $fieldIdx: " + field)
            fieldIdx = fieldIdx + 1
        }
    }
}
