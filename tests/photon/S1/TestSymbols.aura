// Test PhotonObjectWriter symbol generation
package aura.lang.compiler.backend.photon
import aura.lang.std.String
import "../../../aura/compiler/aura/lang/compiler/backend/photon/PhotonObjectWriter.aura"
import "../../../aura/compiler/aura/lang/compiler/backend/photon/x86_64/X86Encoder.aura"

fun main() {
    val writer = PhotonObjectWriter()
    
    // Test splitPipe
    val testStr: String = "main|0|1|0x0001|0x01|@str.0|0|2|0x0001|0x02"
    println("Test string: " + testStr)
    println("Length: " + testStr.length)
    
    // Call the private splitPipe via reflection... can't do that in Aura
    // Let's just test the COFF generation directly
    
    val encoder = X86Encoder()
    encoder.emitPrologue(48)
    encoder.emitLeaRIP("rcx", "@str.0")
    encoder.emitCallRel("println")
    encoder.emitXorRR("eax", "eax")
    encoder.emitEpilogue()
    
    val mcHex = encoder.toHex()
    val relocs = encoder.getRelocations()
    
    var relocHex: String = ""
    var i: Int = 0
    while (i < relocs.size) {
        if (relocHex != "") { relocHex = relocHex + "|" }
        relocHex = relocHex + relocs[i]
        i = i + 1
    }
    
    println("Machine code: " + mcHex)
    println("Relocs: " + relocHex)
    
    val coffHex = writer.emitFromMachineCode(mcHex, relocHex, "hello", "main")
    println("COFF hex length: " + coffHex.length)
    
    // Check NumberOfSymbols (bytes 12-15)
    val numSym = coffHex.substring(24, 28)
    println("NumberOfSymbols hex: " + numSym)
    
    // Check PointerToSymbolTable (bytes 8-11)
    val ptrSym = coffHex.substring(16, 24)
    println("PointerToSymbolTable hex: " + ptrSym)
}
