// Test strToInt and writeIntLe
package aura.lang.compiler.backend.photon
import aura.lang.std.String

fun main() {
    // Test strToInt
    println("strToInt('0'): " + strToInt("0"))
    println("strToInt('1'): " + strToInt("1"))
    println("strToInt('2'): " + strToInt("2"))
    println("strToInt('10'): " + strToInt("10"))
    
    // Test writeIntLe
    println("writeIntLe(0, 4): " + writeIntLe(0, 4))
    println("writeIntLe(1, 4): " + writeIntLe(1, 4))
    println("writeIntLe(1, 2): " + writeIntLe(1, 2))
    println("writeIntLe(0x0001, 2): " + writeIntLe(0x0001, 2))
    
    // Test hexToInt
    println("hexToInt('0x0001'): " + hexToInt("0x0001"))
    println("hexToInt('0x01'): " + hexToInt("0x01"))
    println("hexToInt('0x02'): " + hexToInt("0x02"))
    
    // Test padSectionName
    println("padSectionName('main', 8): " + padSectionName("main", 8))
    println("padSectionName('@str.0', 8): " + padSectionName("@str.0", 8))
}

fun strToInt(text: String): Int {
    if (text == "") { return 0 }
    var total: Int = 0
    var neg: Boolean = false
    var i: Int = 0
    if (text.charCodeAt(0) == 45) { neg = true; i = 1 }
    while (i < text.length) {
        total = total * 10 + (text.substring(i, i + 1).charCodeAt(0) - 48)
        i = i + 1
    }
    if (neg) { return -total }
    return total
}

fun hexToInt(text: String): Int {
    if (text == "") { return 0 }
    var total: Int = 0
    var i: Int = 0
    while (i < text.length) {
        val c: Int = text.substring(i, i + 1).charCodeAt(0)
        var digit: Int = 0
        if (c >= 48 && c <= 57) { digit = c - 48 }
        else if (c >= 97 && c <= 102) { digit = c - 87 }
        else if (c >= 65 && c <= 70) { digit = c - 55 }
        total = total * 16 + digit
        i = i + 1
    }
    return total
}

fun writeIntLe(value: Int, bytes: Int): String {
    var out: String = ""
    var v: Int = value
    var i: Int = 0
    while (i < bytes) {
        out = out + hexDigit(v / 16 % 16) + hexDigit(v % 16)
        v = v / 256
        i = i + 1
    }
    return out
}

fun hexDigit(d: Int): String {
    if (d == 0) return "0"
    if (d == 1) return "1"
    if (d == 2) return "2"
    if (d == 3) return "3"
    if (d == 4) return "4"
    if (d == 5) return "5"
    if (d == 6) return "6"
    if (d == 7) return "7"
    if (d == 8) return "8"
    if (d == 9) return "9"
    if (d == 10) return "a"
    if (d == 11) return "b"
    if (d == 12) return "c"
    if (d == 13) return "d"
    if (d == 14) return "e"
    return "f"
}

fun padSectionName(name: String, len: Int): String {
    var out: String = ""
    var i: Int = 0
    while (i < name.length && i < len) {
        val c: Int = name.substring(i, i + 1).charCodeAt(0)
        out = out + hexDigit(c / 16) + hexDigit(c % 16)
        i = i + 1
    }
    while (out.length < len * 2) {
        out = out + "00"
    }
    return out
}
