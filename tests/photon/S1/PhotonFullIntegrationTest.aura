// aura:///aura/lang/compiler/backend/PhaseEIntegrationTest.aura
package aura.lang.compiler.backend.photon
// ─────────────────────────────────────────────────────────────
// Phase E 集成测试 — 验证完整 AOT 管线
//
// 测试内容：
//   1. X86Encoder: 指令编码验证
//   2. AotBackend: COFF 目标文件生成
//   3. SystemLinker: 链接命令构建
//   4. BackendPipeline: 完整管线执行
//   5. COFF 文件结构验证
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String
import "../../../aura/compiler/aura/lang/compiler/backend/photon/x86_64/X86Encoder.aura"
import "../../../aura/compiler/aura/lang/compiler/backend/photon/PhotonObjectWriter.aura"
import "../../../aura/compiler/aura/lang/compiler/backend/photon/PhotonSystemLinker.aura"
import "../../../aura/compiler/aura/lang/compiler/backend/photon/PhotonPipeline.aura"

/// 测试入口。
fun main() {
    println("╔══════════════════════════════════════════════════════╗")
    println("║   Phase E 集成测试 — AOT 完整管线验证                ║")
    println("║   按照 参考go rust设计新的编译后端.md 第九章         ║")
    println("╚══════════════════════════════════════════════════════╝")
    println("")

    var failures: Int = 0
    var tests: Int = 0

    // ── 测试 1: X86Encoder 机器码生成 ──
    tests = tests + 1
    println("[Test 1] X86Encoder: helloworld 机器码")
    val encoder = X86EncoderUtils.emptyEncoder()
    encoder.emitPrologue(48)
    encoder.emitLeaRIP("rcx", "@str.0")
    encoder.emitCallRel("println")
    encoder.emitXorRR("eax", "eax")
    encoder.emitEpilogue()
    val mcHex = encoder.toHex()
    val mcRelocs = encoder.getRelocations()
    println("  机器码: " + mcHex)
    println("  字节数: " + encoder.byteCount())
    println("  重定位数: " + mcRelocs.size)
    if (mcHex != "" && mcRelocs.size == 2) {
        println("  ✓ PASS")
    } else {
        println("  ✗ FAIL")
        failures = failures + 1
    }

    // ── 测试 2: PhotonObjectWriter COFF 生成 ──
    tests = tests + 1
    println("")
    println("[Test 2] AotBackend: COFF 目标文件生成")
    val aot = PhotonObjectWriterUtils.emptyBackend()
    val relocHex = ""
    var i: Int = 0
    while (i < mcRelocs.size) {
        if (relocHex != "") { relocHex = relocHex + "|" }
        relocHex = relocHex + mcRelocs[i]
        i = i + 1
    }
    val coffHex = aot.emitFromMachineCode(mcHex, relocHex, "hello", "main")
    println("  COFF hex 长度: " + coffHex.length + " 字符")
    println("  COFF 字节数: " + (coffHex.length / 2))
    if (coffHex != "" && coffHex.length > 100) {
        println("  ✓ PASS")
    } else {
        println("  ✗ FAIL")
        failures = failures + 1
    }

    // ── 测试 3: COFF 文件头验证 ──
    tests = tests + 1
    println("")
    println("[Test 3] COFF 文件头验证")
    // COFF 文件头前 2 字节应该是 0x8664 (AMD64)
    val headerStart = coffHex.substring(0, 4)
    println("  文件头前 4 字节: " + headerStart)
    // Machine = AMD64 (0x8664) -> 小端: 64 86
    if (headerStart == "6486") {
        println("  ✓ Machine = AMD64 (0x8664)")
    } else {
        println("  ✗ Machine 值不正确: " + headerStart)
        failures = failures + 1
    }

    // ── 测试 4: COFF 节表验证 ──
    tests = tests + 1
    println("")
    println("[Test 4] COFF 节表验证")
    // 节表从第 20 字节开始，每节 40 字节
    // .text 节名从第 20 字节开始
    val textSectionName = coffHex.substring(40, 56)  // 40 hex chars = 20 bytes = 8 bytes for name
    println("  .text 节名 hex: " + textSectionName)
    // .text = 2e 74 65 78 74 00 00 00（编码器的 hexDigit 输出**小写**）
    if (textSectionName.substring(0, 10) == "2e74657874") {
        println("  ✓ .text 节名正确")
    } else {
        println("  ✗ .text 节名不正确")
        failures = failures + 1
    }

    // ── 测试 5: SystemLinker 命令构建 ──
    tests = tests + 1
    println("")
    println("[Test 5] SystemLinker: 链接命令构建")
    val linker = PhotonSystemLinkerUtils.defaultLinker()
    linker.setOutputType("exe")
    linker.objectFiles = "helloworld.obj"
    linker.outputName = "helloworld"
    // 显式给出子系统/入口/机器类型（buildLldLinkCommand 不会默认添加这三项）
    linker.flags = "/SUBSYSTEM:CONSOLE,/ENTRY:main,/MACHINE:X64"
    val linkCmd = linker.buildCommand()
    println("  链接命令: " + linkCmd)
    if (linkCmd.contains("lld-link") && linkCmd.contains("helloworld.obj")) {
        println("  ✓ PASS")
    } else {
        println("  ✗ FAIL")
        failures = failures + 1
    }

    // ── 测试 6: SystemLinker 标志验证 ──
    tests = tests + 1
    println("")
    println("[Test 6] SystemLinker: 链接标志验证")
    if (linkCmd.contains("/OUT:") && linkCmd.contains("/SUBSYSTEM:") && linkCmd.contains("/MACHINE:X64")) {
        println("  ✓ 链接标志完整")
    } else {
        println("  ✗ 链接标志不完整")
        failures = failures + 1
    }

    // ── 测试 7: PhotonObjectWriterUtils helloworld 机器码 ──
    tests = tests + 1
    println("")
    println("[Test 7] PhotonObjectWriterUtils: helloworld 机器码生成")
    val hwMc = PhotonObjectWriterUtils.helloworldMachineCode()
    println("  机器码: " + hwMc)
    if (hwMc != "" && hwMc.length > 10) {
        println("  ✓ PASS")
    } else {
        println("  ✗ FAIL")
        failures = failures + 1
    }

    // ── 测试 8: PhotonObjectWriterUtils helloworld 重定位 ──
    tests = tests + 1
    println("")
    println("[Test 8] PhotonObjectWriterUtils: helloworld 重定位项")
    val hwRelocs = PhotonObjectWriterUtils.helloworldRelocs()
    println("  重定位: " + hwRelocs)
    if (hwRelocs != "" && hwRelocs.contains("R_X86_64_REL32")) {
        println("  ✓ PASS")
    } else {
        println("  ✗ FAIL")
        failures = failures + 1
    }

    // ── 测试 9: PhotonPipeline 完整管线 ──
    tests = tests + 1
    println("")
    println("[Test 9] BackendPipeline: 完整 AOT 管线")
    val pipeline = PhotonPipelineUtils.emptyPipeline()
    val result = pipeline.compile("fun main() { println(\"hello\") }", "build", "helloworld")
    println("  成功: " + result.success)
    println("  目标文件: " + result.objectFilePath)
    println("  可执行文件: " + result.executablePath)
    println("  链接命令: " + result.linkCommand)
    if (result.success) {
        println("  ✓ PASS")
    } else {
        println("  ✗ FAIL")
        failures = failures + 1
    }

    // ── 测试 10: COFF 常量验证 ──
    tests = tests + 1
    println("")
    println("[Test 10] COFF 常量验证")
    println("  COFF_MACHINE_AMD64: " + PhotonObjectWriterUtils.COFF_MACHINE_AMD64)
    println("  SECTION_CODE: " + PhotonObjectWriterUtils.SECTION_CODE)
    println("  SECTION_MEM_READ: " + PhotonObjectWriterUtils.SECTION_MEM_READ)
    println("  SECTION_MEM_EXECUTE: " + PhotonObjectWriterUtils.SECTION_MEM_EXECUTE)
    println("  REL32: " + PhotonObjectWriterUtils.REL32)
    if (PhotonObjectWriterUtils.COFF_MACHINE_AMD64 == 34404 &&
        PhotonObjectWriterUtils.SECTION_CODE == 32 &&
        PhotonObjectWriterUtils.REL32 == 4) {
        println("  ✓ PASS")
    } else {
        println("  ✗ FAIL")
        failures = failures + 1
    }

    // ── 测试 11: SystemLinker 工具验证 ──
    tests = tests + 1
    println("")
    println("[Test 11] PhotonSystemLinkerUtils: 工具函数")
    println("  linkerForOs(windows): " + PhotonSystemLinkerUtils.linkerForOs("windows"))
    println("  linkerForOs(linux): " + PhotonSystemLinkerUtils.linkerForOs("linux"))
    println("  linkerForOs(macos): " + PhotonSystemLinkerUtils.linkerForOs("macos"))
    println("  extensionForType(exe): " + PhotonSystemLinkerUtils.extensionForType("exe", "windows"))
    println("  subsystemFlag(console): " + PhotonSystemLinkerUtils.subsystemFlag("console"))
    println("  entryFlag(windows,main): " + PhotonSystemLinkerUtils.entryFlag("windows", "main"))
    // linkerForOs 现已统一返回 lld 驱动名（windows→lld-link、linux→ld.lld、macos→ld64.lld），
    // 与 PhotonSystemLinker.getLdPath()/getLd64Path() 保持一致。
    if (PhotonSystemLinkerUtils.linkerForOs("windows") == "lld-link" &&
        PhotonSystemLinkerUtils.linkerForOs("linux") == "ld.lld" &&
        PhotonSystemLinkerUtils.linkerForOs("macos") == "ld64.lld") {
        println("  ✓ PASS")
    } else {
        println("  ✗ FAIL")
        failures = failures + 1
    }

    // ── 测试 12: PhotonPipelineUtils 验证 ──
    tests = tests + 1
    println("")
    println("[Test 12] PhotonPipelineUtils: 工具函数")
    println("  detectOS: " + PhotonPipelineUtils.detectOS())
    println("  detectArch: " + PhotonPipelineUtils.detectArch())
    println("  buildTriple(windows,x86_64): " + PhotonPipelineUtils.buildTriple("windows", "x86_64"))
    println("  phaseList: " + PhotonPipelineUtils.phaseList())
    if (PhotonPipelineUtils.detectOS() == "windows" &&
        PhotonPipelineUtils.detectArch() == "x86_64") {
        println("  ✓ PASS")
    } else {
        println("  ✗ FAIL")
        failures = failures + 1
    }

    // ── 汇总 ──
    println("")
    println("══════════════════════════════════════════════════════")
    println("测试结果: " + (tests - failures) + "/" + tests + " 通过")
    if (failures == 0) {
        println("RESULT: PASS — Phase E 全部测试通过")
        println("")
        println("Phase E 组件清单:")
        println("  ✓ X86Encoder — x86_64 指令编码器")
        println("  ✓ AotBackend — COFF/ELF 目标文件发射")
        println("  ✓ SystemLinker — 系统链接器集成")
        println("  ✓ JitBackend — W^X mmap + 分派表")
        println("  ✓ BackendPipeline — 完整管线集成")
    } else {
        println("RESULT: FAIL (" + failures + " 失败)")
    }
    println("══════════════════════════════════════════════════════")
}
