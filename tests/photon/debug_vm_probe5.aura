// 调试：复刻 LirUtils.splitArgs 的行为
object Splitter {
    fun splitArgs(text: String): List<String> {
        val out: List<String> = arrayListOf<String>()
        if (text == "") {
            return out
        }
        val len: Int = text.length
        var start: Int = 0
        var i: Int = 0
        while (i < len) {
            if (text.charAt(i).toString() == ",") {
                out.add(text.substring(start, i))
                start = i + 1
            }
            i = i + 1
        }
        out.add(text.substring(start, len))
        return out
    }
}

fun callSplitter(text: String): String {
    val parts: List<String> = Splitter.splitArgs(text)
    var out: String = "n=" + toStr(parts.size) + ";"
    var i: Int = 0
    while (i < parts.size) {
        out = out + "[" + parts.get(i) + "]"
        i = i + 1
    }
    return out
}

fun literalList(): String {
    val out: List<String> = arrayListOf<String>()
    out.add("alpha")
    out.add("beta")
    var s: String = "n=" + toStr(out.size) + ";"
    var i: Int = 0
    while (i < out.size) {
        s = s + "[" + out.get(i) + "]"
        i = i + 1
    }
    return s
}

fun substringList(): String {
    val out: List<String> = arrayListOf<String>()
    val src: String = "alpha,beta"
    out.add(src.substring(0, 5))
    out.add(src.substring(6, 10))
    var s: String = "n=" + toStr(out.size) + ";"
    var i: Int = 0
    while (i < out.size) {
        s = s + "[" + out.get(i) + "]"
        i = i + 1
    }
    return s
}

fun main() {
    println("splitter:     " + callSplitter("10,20,30"))
    println("literalList:  " + literalList())
    println("substringList:" + substringList())
}
