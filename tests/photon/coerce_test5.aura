// tests/photon/coerce_test5.aura
// 精确复现 SsaBuilder + MirSsaProgram 结构

class TypeReg {
    var count: Int = 0
    var data: List<String> = arrayListOf<String>()
    init() {
        this.count = 0
        this.data = arrayListOf<String>()
    }
}

class Func {
    var name: String = ""
    var blocks: String = ""
}

class Program {
    var types: TypeReg = TypeReg()
    var funcs: List<Func> = arrayListOf<Func>()
    var blockCount: Int = 0
    var currentFunc: Int = -1

    init() {
        this.types = TypeReg()
        this.funcs = arrayListOf<Func>()
        this.blockCount = 0
        this.currentFunc = -1
    }

    fun addFunc(name: String): Int {
        val f: Func = Func()
        f.name = name
        f.blocks = ""
        this.funcs.add(f)
        this.currentFunc = this.funcs.size - 1
        return this.currentFunc
    }

    fun funcOf(id: Int): Func {
        if (id < 0 || id >= this.funcs.size) {
            return Func()
        }
        return this.funcs[id]
    }

    fun addBlock(): Int {
        this.blockCount = this.blockCount + 1
        if (this.currentFunc >= 0) {
            val f: Func = this.funcOf(this.currentFunc)
            if (f.blocks == "") {
                f.blocks = toStr(this.blockCount)
            } else {
                f.blocks = f.blocks + "," + toStr(this.blockCount)
            }
        }
        return this.blockCount
    }
}

class Builder {
    var program: Program = Program()
    var types: TypeReg = TypeReg()
    var curFunc: Int = -1
    var curBlock: Int = 0
    var tmpCount: Int = 0
    var memHead: Int = -1
    var curParams: String = ""
    var varMap: String = ""

    init() {
        this.program = Program()
        this.types = this.program.types
        this.curFunc = -1
        this.curBlock = 0
        this.tmpCount = 0
        this.memHead = -1
        this.curParams = ""
        this.varMap = ""
    }

    fun buildFunc(name: String): Unit {
        this.curFunc = this.program.addFunc(name)
        this.program.addBlock()
        this.program.addBlock()
        this.program.addBlock()
    }
}

fun main() {
    val b: Builder = Builder()
    b.buildFunc("main")
    b.buildFunc("helper")
    b.buildFunc("util")
    
    var ok: Boolean = true
    var i: Int = 0
    while (i < 3) {
        val fi: Func = b.program.funcOf(i)
        println("func" + toStr(i) + ".name=" + fi.name + " blocks=" + fi.blocks)
        if (i == 0 && fi.blocks != "1,2,3") { ok = false; println("FAIL func0") }
        if (i == 1 && fi.blocks != "4,5,6") { ok = false; println("FAIL func1") }
        if (i == 2 && fi.blocks != "7,8,9") { ok = false; println("FAIL func2") }
        i = i + 1
    }
    
    if (ok) { println("ALL OK") } else { println("FAILED") }
}
