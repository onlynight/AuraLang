// tests/photon/P2/04_string_ops.aura
// Phase 2.4: 字符串操作测试
//
// 测试: 字符串拼接、长度、比较

import aura.lang.std.String

fun main() {
    var s1: String = "Hello"
    var s2: String = "World"
    var s3: String = s1 + " " + s2
    
    println("s3 = " + s3)
    println("len = " + toStr(s3.length()))
    
    if (s3 == "Hello World") {
        println("Match!")
    }
}