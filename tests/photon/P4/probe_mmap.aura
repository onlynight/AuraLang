// tests/photon/P4/probe_mmap.aura
// 诊断：Memory.mmap 是否可用
import aura.lang.std.String
import aura.lang.native.Memory

fun main() {
    val base: Long = Memory.mmap(0, 4096, 3, 34, -1, 0)
    println("mmap1: " + toStr(base))
    val base2: Long = Memory.mmap(0, 8192, 3, 34, -1, 0)
    println("mmap2: " + toStr(base2))
    Memory.munmap(base, 4096)
    println("munmap done")
}
