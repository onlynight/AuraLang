// tests/photon/P4/probe_mutex.aura
// 诊断：复现 07_mutex_ops 的挂起
import aura.lang.std.String
import aura.lang.concurrent.Mutex

fun main() {
    println("A")
    val lock_id: Long = Mutex()
    println("B lock_id=" + toStr(lock_id))
    println("Locked: " + toStr(Mutex.isLocked(lock_id)))
    println("C")
    Mutex.lock(lock_id)
    println("D locked=" + toStr(Mutex.isLocked(lock_id)))
    Mutex.unlock(lock_id)
    println("E unlocked=" + toStr(Mutex.isLocked(lock_id)))
}
