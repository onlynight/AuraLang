// tests/photon/P4/test_thread.aura
// Phase 4.6: Thread support test
//
// Test: Thread creation and mutex operations

import aura.lang.std.String
import aura.lang.concurrent.Thread
import aura.lang.concurrent.Mutex
import aura.lang.concurrent.Condvar

fun main() {
    // 测试 Mutex
    val lock_id: Long = Mutex()
    println("Mutex created, lock_id=" + toStr(lock_id))
    
    // 锁定
    Mutex.lock(lock_id)
    println("Locked: " + toStr(Mutex.isLocked(lock_id)))
    
    // 解锁
    Mutex.unlock(lock_id)
    println("Unlocked: " + toStr(!Mutex.isLocked(lock_id)))
    
    // 获取当前线程 ID
    val tid: Long = Thread.currentThreadId()
    println("Thread ID: " + toStr(tid))
    
    println("Thread test passed")
}