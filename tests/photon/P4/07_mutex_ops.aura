// tests/photon/P4/07_mutex_ops.aura
// Phase 4.7: Mutex 操作测试
//
// 测试: 互斥锁的锁定/解锁

import aura.lang.std.String
import aura.lang.concurrent.Mutex

fun main() {
    val lock_id: Long = Mutex()
    
    println("Locked: " + toStr(Mutex.isLocked(lock_id)))
    
    Mutex.lock(lock_id)
    println("After lock: " + toStr(Mutex.isLocked(lock_id)))
    
    Mutex.unlock(lock_id)
    println("After unlock: " + toStr(Mutex.isLocked(lock_id)))
}