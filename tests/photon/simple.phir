fun main() -> Int {
    return 42
}

fun Any.toString(self: Any) -> String {
    if self == null {
        return "null"
    }
    return toStr(self)
}

fun Any.equals(self: Any, other: Any) -> Boolean {
    if self == null {
        return other == null
    }
    if other == null {
        return false
    }
    return toStr(self) == toStr(other)
}

fun Any.hashCode(self: Any) -> Int {
    if self == null {
        return 0
    }
    val s: String = toStr(self)
    var hash: Int = 0
    var i: Int = 0
    while i < s.length {
        hash = hash * 31 + String.charCodeAt(s, i)
        i = i + 1
    }
    return hash
}

