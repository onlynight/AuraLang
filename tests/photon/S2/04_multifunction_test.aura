// tests/photon/S2/04_multifunction_test.aura
// ═════════════════════════════════════════════════════════════
// 多函数对象文件测试
// 运行：aura run tests/photon/S2/04_multifunction_test.aura
// ═════════════════════════════════════════════════════════════

import aura.lang.std.String
import "../../../aura/compiler/aura/lang/compiler/backend/photon/PhotonObjectWriter.aura"

fun main() {
    println("═══ 多函数对象文件测试 ═══")
    var pass = 0
    var total = 3

    // [1] 单函数（向后兼容）
    println("[1] 单函数")
    val b = PhotonObjectWriterUtils.emptyBackend()
    val mcHex = "554889e54881ec50000000"
    val out1 = b.emitFromMachineCode(mcHex, "", "", "main")
    if (out1 != "" && out1.length > 100) { pass = pass + 1; println("  COFF size=" + out1.length) }

    // [2] 双函数
    println("[2] 双函数")
    val out2 = b.emitFromMachineCode(mcHex, "", "", "main,helper")
    if (out2 != "" && out2.length > 100) { pass = pass + 1; println("  COFF size=" + out2.length) }

    // [3] 三函数
    println("[3] 三函数")
    val out3 = b.emitFromMachineCode(mcHex, "", "", "main,helper1,helper2")
    if (out3 != "" && out3.length > 100) { pass = pass + 1; println("  COFF size=" + out3.length) }

    println("")
    println("PASS: " + pass + "/" + total)
    if (pass == total) { println("ALL PASS") }
}
