// tests/photon/S2/06_liveness_test.aura
// ═════════════════════════════════════════════════════════════
// 寄存器分配存活分析测试
// 运行：aura run tests/photon/S2/06_liveness_test.aura
// ═════════════════════════════════════════════════════════════

import aura.lang.std.String
import "../../../aura/compiler/aura/lang/compiler/backend/photon/MachineDag.aura"
import "../../../aura/compiler/aura/lang/compiler/backend/photon/RegisterAllocator.aura"

fun main() {
    println("═══ 存活分析测试 ═══")
    var pass = 0
    var total = 3

    // [1] 空 DAG
    println("[1] 空 DAG")
    val d1 = MachineDagUtils.emptyDag()
    val alloc1 = RegisterAllocatorUtils.emptyAllocator()
    alloc1.allocate(d1)
    if (alloc1.getSpillSlots() == 0) { pass = pass + 1 }

    // [2] 带节点但无冲突
    println("[2] 带节点但无冲突")
    val d2 = MachineDagUtils.emptyDag()
    val n1 = d2.addNode("Value", "Const", 0, "", "", "", -1, "42")
    val n2 = d2.addNode("Value", "Add", 0, "", "", "", -1, "")
    d2.selectPattern(0, MachineDagUtils.toStr(n1), n1)
    d2.selectPattern(1, MachineDagUtils.toStr(n1) + "," + MachineDagUtils.toStr(n2), n2)
    val alloc2 = RegisterAllocatorUtils.emptyAllocator()
    alloc2.allocate(d2)
    // 检查节点是否分配了寄存器
    var i: Int = 0
    var allAssigned: Boolean = true
    while (i < d2.nodeCount) {
        val node = d2.nodeOf(i)
        if (node.kind == "Value" && node.reg == "") {
            allAssigned = false
        }
        i = i + 1
    }
    if (allAssigned) { pass = pass + 1; println("  all nodes assigned") }

    // [3] 多节点（测试寄存器复用）
    println("[3] 多节点（测试寄存器复用）")
    val d3 = MachineDagUtils.emptyDag()
    var j: Int = 0
    var lastNode: Int = 0
    while (j < 5) {
        lastNode = d3.addNode("Value", "Const", 0, "", "", "", -1, this.toStr(j))
        j = j + 1
    }
    val alloc3 = RegisterAllocatorUtils.emptyAllocator()
    alloc3.allocate(d3)
    // 检查是否所有节点都分配了寄存器
    var k: Int = 0
    var allAssigned3: Boolean = true
    while (k < d3.nodeCount) {
        val node = d3.nodeOf(k)
        if (node.kind == "Value" && node.reg == "") {
            allAssigned3 = false
        }
        k = k + 1
    }
    if (allAssigned3) { pass = pass + 1; println("  5 nodes all assigned") }

    println("")
    println("PASS: " + pass + "/" + total)
    if (pass == total) { println("ALL PASS") }
}

/// 整数转字符串。
fun toStr(n: Int): String {
    if (n == 0) { return "0" }
    var neg: Boolean = false
    if (n < 0) { neg = true; n = -n }
    var result: String = ""
    while (n > 0) {
        result = digitChar(n % 10) + result
        n = n / 10
    }
    if (neg) { result = "-" + result }
    return result
}

/// 将单个数字转为字符串。
fun digitChar(d: Int): String {
    if (d == 0) { return "0" }
    if (d == 1) { return "1" }
    if (d == 2) { return "2" }
    if (d == 3) { return "3" }
    if (d == 4) { return "4" }
    if (d == 5) { return "5" }
    if (d == 6) { return "6" }
    if (d == 7) { return "7" }
    if (d == 8) { return "8" }
    if (d == 9) { return "9" }
    return ""
}
