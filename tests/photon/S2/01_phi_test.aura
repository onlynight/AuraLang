// tests/photon/S2/01_phi_test.aura
// ═════════════════════════════════════════════════════════════
// Phi 节点处理测试
// 运行：aura run tests/photon/S2/01_phi_test.aura
// ═════════════════════════════════════════════════════════════

import aura.lang.std.String
import "../../../aura/compiler/aura/lang/compiler/backend/photon/Lir.aura"
import "../../../aura/compiler/aura/lang/compiler/backend/photon/MachineDag.aura"
import "../../../aura/compiler/aura/lang/compiler/backend/photon/InstructionSelection.aura"

fun main() {
    println("═══ Phi 节点测试 ═══")
    var pass = 0
    var total = 3

    // [1] 单块程序（无 Phi）
    println("[1] 单块程序（无 Phi）")
    val lir1 = LirUtils.emptyProgram()
    val t1 = lir1.types
    val i32 = t1.intType(32)
    val fid1 = lir1.addFunction("test", i32, i32, false)
    val func1 = lir1.functionOf(fid1)
    val bid1 = lir1.addBlock()
    func1.blocks = LirBlockUtils.succsAdd(func1.blocks, bid1)
    func1.entryBlock = bid1
    val v1 = lir1.addInstr(bid1, "Const", i32, "", "42")
    lir1.setTerminator(bid1, "Ret", i32, LirUtils.toStr(v1), "")
    val sel1 = InstructionSelectorUtils.emptySelector()
    val dagg1 = sel1.select(lir1)
    println("  nodes=" + dagg1.nodeCount + " instrs=" + dagg1.instrCount)
    if (dagg1.instrCount >= 1) { pass = pass + 1 }

    // [2] 带 Phi 的程序（简化：块2 有 Phi 节点）
    println("[2] 带 Phi 的程序")
    val lir2 = LirUtils.emptyProgram()
    val t2 = lir2.types
    val i32b = t2.intType(32)
    val fid2 = lir2.addFunction("test2", i32b, i32b, false)
    val func2 = lir2.functionOf(fid2)
    val bid2 = lir2.addBlock()
    func2.blocks = LirBlockUtils.succsAdd(func2.blocks, bid2)
    func2.entryBlock = bid2
    // 两个常量值
    val va = lir2.addInstr(bid2, "Const", i32b, "", "10")
    val vb = lir2.addInstr(bid2, "Const", i32b, "", "20")
    // Phi 节点（取第一个入边值）
    val vPhi = lir2.addPhi(bid2, i32b, LirUtils.toStr(va) + "," + LirUtils.toStr(vb), "")
    lir2.setTerminator(bid2, "Ret", i32b, LirUtils.toStr(vPhi), "")
    val sel2 = InstructionSelectorUtils.emptySelector()
    val dagg2 = sel2.select(lir2)
    println("  nodes=" + dagg2.nodeCount + " instrs=" + dagg2.instrCount)
    // 检查是否有 MOV 指令（Phi → MOV）
    var i: Int = 0
    var movCount: Int = 0
    while (i < dagg2.instrCount) {
        val instr = dagg2.instrOf(i)
        if (instr.template == "mov %dst, %src") {
            movCount = movCount + 1
        }
        i = i + 1
    }
    println("  MOV count=" + movCount)
    if (movCount >= 1) { pass = pass + 1 }

    // [3] 工具函数验证
    println("[3] 工具函数验证")
    if (InstructionSelectorUtils.isConstOp("Const") &&
        InstructionSelectorUtils.isConstOp("ConstImm")) { pass = pass + 1 }
    else { }

    println("")
    println("PASS: " + pass + "/" + total)
    if (pass == total) { println("ALL PASS") }
}
