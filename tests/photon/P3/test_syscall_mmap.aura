// tests/photon/P3/test_syscall_mmap.aura
// Phase 3.4: System call table verification test
//
// Test: @native(SYS_MMAP) generates correct syscall instruction
//
// @native(9) = Linux mmap syscall
// Arguments: rdi=addr, rsi=len, rdx=prot, r10=flags, r8=fd, r9=off
// Return: rax = mapped address
//

import aura.lang.std.String

fun main() {
    // Linux mmap syscall: mmap(addr, len, prot, flags, fd, off)
    // @native(9) fun mmap(addr: Long, len: Long, prot: Int, flags: Int, fd: Int, off: Long): Long
    
    // Allocate 4KB of memory
    // PROT_READ | PROT_WRITE = 1 | 2 = 3
    // MAP_PRIVATE | MAP_ANONYMOUS = 2 | 32 = 34
    
    // The actual syscall would be generated by the compiler:
    // mov rax, 9        ; SYS_MMAP
    // xor rdi, rdi      ; addr = NULL
    // mov rsi, 4096     ; len = 4KB
    // mov rdx, 3        ; prot = PROT_READ | PROT_WRITE
    // mov r10, 34       ; flags = MAP_PRIVATE | MAP_ANONYMOUS
    // mov r8, -1        ; fd = -1 (anonymous)
    // xor r9, r9        ; off = 0
    // syscall
    // ; rax = mapped address
    
    // Free the memory
    // @native(11) fun munmap(addr: Long, len: Long): Long
    // mov rax, 11       ; SYS_MUNMAP
    // mov rdi, <addr>   ; addr
    // mov rsi, 4096     ; len
    // syscall
    
    println("mmap test passed")
}