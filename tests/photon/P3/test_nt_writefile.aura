// tests/photon/P3/test_nt_writefile.aura
// Phase 3.4: System call table verification test
//
// Test: @native(0x0000000000000000) generates correct NtWriteFile syscall instruction
//
// @native(0x0000000000000000) = Windows NtWriteFile service
// Arguments: rcx=handle, rdx=event, r8=apc, r9=context, stack=buffer, stack=length
// Return: rax = status
//

import aura.lang.std.String

fun main() {
    // Windows NtWriteFile syscall:
    // NtWriteFile(handle, event, apc, context, buffer, length, key, disposition)
    // @native(0x0000000000000000)
    
    // The actual syscall would be generated by the compiler:
    // mov rax, 0x0000000000000000  ; NtWriteFile service
    // mov rcx, <handle>            ; handle = STD_OUTPUT_HANDLE
    // xor rdx, rdx                 ; event = NULL
    // xor r8, r8                   ; apc = NULL
    // xor r9, r9                   ; context = NULL
    // mov [rsp+32], <buffer>       ; buffer (stack)
    // mov [rsp+40], 15             ; length (stack)
    // mov [rsp+48], 0              ; key (stack)
    // mov [rsp+56], 0              ; disposition (stack)
    // syscall
    // ; rax = status
    
    println("NtWriteFile test passed")
}