// tests/photon/P1/03_arithmetic.aura
// Phase 1.3: 算术运算测试
//
// 测试: 基本算术运算符

import aura.lang.std.String

fun main() {
    var a: Int = 10
    var b: Int = 3
    
    println("a + b = " + toStr(a + b))
    println("a - b = " + toStr(a - b))
    println("a * b = " + toStr(a * b))
    println("a / b = " + toStr(a / b))
    println("a % b = " + toStr(a % b))
    
    var c: Int = 5
    c = c + 1
    println("c = " + toStr(c))
}