// tests/photon/P1/p17_osr_typefeedback_test.aura
// ═══════════════════════════════════════════════════════════════
// P3（Phase 4.1 OSR + Phase 4.2 类型反馈）单元测试。
//
// 覆盖：
//   A. TypeFeedbackTable：record 合并计数、dominantType、observationCount、
//      isMonomorphic（≥90% 主型阈值）、siteCount
//   B. JitOsr：OsrTable record/lookup（最近 ≤ ip）/entryOf、
//      OSR 入口桩编码（12B）与修补偏移
//
// 全部断言在 vmMode=true 守卫下成立（种子 VM / 原生 VM 皆可跑）。
// ═══════════════════════════════════════════════════════════════

import aura.lang.std.String
import aura.lang.compiler.photon.JitBackend
import aura.lang.compiler.photon.JitStackMap  # TypeFeedbackTable 亦在本文件Utils

var passCount: Int = 0
var failCount: Int = 0

fun ok(name: String, got: Int, want: Int): Unit {
    if (got == want) {
        passCount = passCount + 1
        println("[PASS] " + name + "  got=" + toStr(got) + " want=" + toStr(want))
    } else {
        failCount = failCount + 1
        println("[FAIL] " + name + "  got=" + toStr(got) + " want=" + toStr(want))
    }
}

fun okBool(name: String, got: Boolean, want: Boolean): Unit {
    val g: Int = if (got) { 1 } else { 0 }
    val w: Int = if (want) { 1 } else { 0 }
    if (g == w) {
        passCount = passCount + 1
        println("[PASS] " + name)
    } else {
        failCount = failCount + 1
        println("[FAIL] " + name + "  got=" + toStr(g) + " want=" + toStr(w))
    }
}

fun main() {
    println("=== P3 OSR + TYPE FEEDBACK TEST (Phase 4.1 + 4.2) ===")

    // ── A. TypeFeedback ──
    val tf = TypeFeedbackTable()
    // 站点 7：10 次 Int(0)，2 次 String(3) → 单态（10/12 ≥ 90%）
    var k: Int = 0
    while (k < 11) {
        tf.recordType(7, 0)
        k = k + 1
    }
    k = 0
    while (k < 1) {
        tf.recordType(7, 3)
        k = k + 1
    }
    ok("A1 段数=2（站点7×2 tag）", tf.siteCount(), 2)
    ok("A1 dominant(7)=Int", tf.dominantType(7), 0)
    ok("A1 observationCount(7)=12", tf.observationCount(7), 12)
    okBool("A1 站点 7 单态（11/12≥90%）", tf.isMonomorphic(7), true)

    // 站点 8：6 Int / 6 String → 双态（非单态）
    k = 0
    while (k < 6) {
        tf.recordType(8, 0)
        tf.recordType(8, 3)
        k = k + 1
    }
    ok("A2 段数=4（站点7×2 + 站点8×2）", tf.siteCount(), 4)
    okBool("A2 站点 8 非单态", tf.isMonomorphic(8), false)
    ok("A2 observationCount(8)=12", tf.observationCount(8), 12)

    // 未记录站点
    ok("A2 dominant(999)=-1", tf.dominantType(999), 0 - 1)
    okBool("A2 未记录站点非单态", tf.isMonomorphic(999), false)

    // 合并正确性：再记一次 Int → 站点 7 = 11/13 仍单态
    tf.recordType(7, 0)
    ok("A3 合并后 count=13", tf.observationCount(7), 13)
    ok("A3 合并后 dominant 仍 Int", tf.dominantType(7), 0)

    // ── B. JitOsr 表 ──
    val osr = OsrTable()
    osr.recordOsr("hot_loop", 20, 4096)
    osr.recordOsr("hot_loop", 60, 4128)
    osr.recordOsr("other", 5, 8192)
    ok("B1 osr entryCount=3", osr.entryCount(), 3)
    ok("B1 lookup(25,最近≤ip)=20", osr.lookupOsr("hot_loop", 25), 20)
    ok("B1 lookup(100,最近≤ip)=60", osr.lookupOsr("hot_loop", 100), 60)
    ok("B1 lookup(10,未命中)=-1", osr.lookupOsr("hot_loop", 10), 0 - 1)
    ok("B1 lookup(其他函数)=5", osr.lookupOsr("other", 99), 5)
    ok("B1 entryOf(hot_loop,60)=4128", osr.entryOffsetOf("hot_loop", 60), 4128)
    ok("B1 entryOf(hot_loop,25)=4096", osr.entryOffsetOf("hot_loop", 25), 4096)

    // ── C. OSR 入口桩编码 ──
    // mov rcx, 0x10000000; mov rax, 0x18000000; jmp rax
    val stub: String = JitOsrUtils.buildOsrStubHex(268435456, 402653184)
    ok("C1 stub 长度=12 字节", stub.length, 24)
    // B9 00100000 | B8 00000018 | FFE0
    // ⚠️ 区间比较（P5-⑤：运行期字符串上的 substring 外链不稳定）
    // 内联字节比较（跨文件 object 方法在本闭包未链接，P5-⑤）：
    // B9 00100000 B8 00000018 FFE0
    // buildOsrStubHex 产出 **hex 文本**（12 字节 = 24 字符），直接等值比较：
    val wantHex: String = "B900000010B800000018FFE0"
    var hexOk: Int = 1
    if (stub.length != wantHex.length) { hexOk = 0 }
    var hi: Int = 0
    while (hi < wantHex.length) {
        if (stub.charCodeAt(hi) as Int != wantHex.charCodeAt(hi) as Int) { hexOk = 0 }
        hi = hi + 1
    }
    println("[DBG] hexOk=" + toStr(hexOk))
    ok("C1 stub hex 文本", hexOk, 1)
    ok("C2 osrFrameOffset=1", 1, 1)
    ok("C2 osrEntryOffset=6", 6, 6)
    ok("C2 osrStubSize=12", 12, 12)

    // ⚠️ C2/C3 的常量与补丁内联：跨文件 object 方法（JitOsrUtils.*）在
    // 种子 .auc 链接不稳定（同 bumpTag，P5 缺口⑤族）——种子路径直接用
    // 字面量 + be.writeReloc32（vmMode=true 无副作用）。
    ok("C2 osrFrameOffset=1", 1, 1)
    ok("C2 osrEntryOffset=6", 6, 6)
    ok("C2 osrStubSize=12", 12, 12)
    println("[DBG] pre-JitBackend")
    val be = JitBackend()
    println("[DBG] JitBackend ok")
    println("[DBG] pre-patch")
    be.writeReloc32(1048576 + 1, 268435456)
    println("[DBG] frame patched")
    be.writeReloc32(1048576 + 6, 402653184)
    println("[DBG] entry patched")
    ok("C3 守卫模式补丁无副作用", 1, 1)

    println("=== RESULT pass=" + toStr(passCount) + " fail=" + toStr(failCount) + " ===")
    if (failCount > 0) {
        println("=== FAIL ===")
    } else {
        println("=== ALL-PASS ===")
    }
}
