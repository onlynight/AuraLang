// tests/HashMap/hashmap_hash_distribution.aura
// ─────────────────────────────────────────────────────────────────────────────
// HashMap<K, V> 哈希分布验证测试
//
// 覆盖：等差键（步长 1/2/16/1000）验证 hashKey 混合效果；
//       多种键类型（Int/String/Boolean）下的桶分布；
//       大量键的 containsValue 一致性；
//       keys() 与 values() 的一一对应关系。
//
// 运行：aura run tests/HashMap/hashmap_hash_distribution.aura
//   全通过时输出 "ALL TESTS PASSED"
// ─────────────────────────────────────────────────────────────────────────────

package test

import aura.lang.collection.HashMap
import aura.lang.collection.ArrayList

/// 断言计数与汇总输出。
class Checker {
    private var passed: Int
    private var failed: Int

    constructor() {
        this.passed = 0
        this.failed = 0
    }

    fun check(name: String, cond: Boolean): Unit {
        if (cond) {
            this.passed = this.passed + 1
        } else {
            this.failed = this.failed + 1
            println("FAIL: " + name)
        }
    }

    fun summary(): Unit {
        println("passed=" + this.passed + " failed=" + this.failed)
        if (this.failed == 0) {
            println("ALL TESTS PASSED")
        } else {
            println("SOME TESTS FAILED")
        }
    }
}

// ── 1. 步长 1 稠密键（验证 hashKey 打散连续哈希）──

fun testDenseKeys(c: Checker): Unit {
    var m: HashMap<Int, Int> = HashMap<Int, Int>()
    var n: Int = 200
    var i: Int = 0
    while (i < n) {
        m.put(i, i)
        i = i + 1
    }
    c.check("dk.size", m.size == n)
    var ok: Boolean = true
    i = 0
    while (i < n) {
        if (m.get(i) != i) { ok = false }
        i = i + 1
    }
    c.check("dk.allValues", ok)
    // 扩容后仍然正确
    i = 0
    while (i < n) {
        m.put(1000 + i, 1000 + i)
        i = i + 1
    }
    c.check("dk.sizeAfterExtend", m.size == 2 * n)
    ok = true
    i = 0
    while (i < n) {
        if (m.get(1000 + i) != (1000 + i)) { ok = false }
        i = i + 1
    }
    c.check("dk.extendedValues", ok)
}

// ── 2. 步长 2 键 ──

fun testStride2Keys(c: Checker): Unit {
    var m: HashMap<Int, Int> = HashMap<Int, Int>()
    var n: Int = 150
    var i: Int = 0
    while (i < n) {
        m.put(i * 2, i)
        i = i + 1
    }
    c.check("s2.size", m.size == n)
    var ok: Boolean = true
    i = 0
    while (i < n) {
        if (m.get(i * 2) != i) { ok = false }
        i = i + 1
    }
    c.check("s2.allValues", ok)
}

// ── 3. 步长 16 键（初始容量 = 16，验证 hashKey 混合防退化）──

fun testStride16Keys(c: Checker): Unit {
    var m: HashMap<Int, Int> = HashMap<Int, Int>()
    var n: Int = 80
    var i: Int = 0
    while (i < n) {
        m.put(1 + i * 16, i)
        i = i + 1
    }
    c.check("s16.size", m.size == n)
    var ok: Boolean = true
    i = 0
    while (i < n) {
        if (m.get(1 + i * 16) != i) { ok = false }
        i = i + 1
    }
    c.check("s16.allValues", ok)
}

// ── 4. 步长 1000 键（大跨距，验证扩容后重分桶）──

fun testStride1000Keys(c: Checker): Unit {
    var m: HashMap<Int, Int> = HashMap<Int, Int>()
    var n: Int = 50
    var i: Int = 0
    while (i < n) {
        m.put(i * 1000, i)
        i = i + 1
    }
    c.check("s1k.size", m.size == n)
    var ok: Boolean = true
    i = 0
    while (i < n) {
        if (m.get(i * 1000) != i) { ok = false }
        i = i + 1
    }
    c.check("s1k.allValues", ok)
}

// ── 5. 大量键的 containsValue 一致性 ──

fun testContainsValueLarge(c: Checker): Unit {
    var m: HashMap<Int, String> = HashMap<Int, String>()
    var n: Int = 500
    var i: Int = 0
    while (i < n) {
        m.put(i, "value-" + i)
        i = i + 1
    }
    c.check("cvl.size", m.size == n)
    // 存在的值
    var ok: Boolean = true
    i = 0
    while (i < 50) {
        if (m.containsValue("value-" + i) == false) { ok = false }
        i = i + 1
    }
    c.check("cvl.existsValues", ok)
    // 不存在的值（逐个检查）
    c.check("cvl.absent500", m.containsValue("value-500") == false)
    c.check("cvl.absent501", m.containsValue("value-501") == false)
    c.check("cvl.absent502", m.containsValue("value-502") == false)
    c.check("cvl.absent503", m.containsValue("value-503") == false)
    c.check("cvl.absent504", m.containsValue("value-504") == false)
    c.check("cvl.absent510", m.containsValue("value-510") == false)
    c.check("cvl.absent600", m.containsValue("value-600") == false)
    // 删除后 containsValue 不再返回 true
    m.remove(100)
    c.check("cvl.afterRemove", m.containsValue("value-100") == false)
    c.check("cvl.neighborsIntact", m.containsValue("value-99") && m.containsValue("value-101"))
}

// ── 6. keys() 与 values() 一一对应 ──

fun testKeysValuesCorrespondence(c: Checker): Unit {
    var m: HashMap<Int, String> = HashMap<Int, String>()
    var n: Int = 200
    var i: Int = 0
    while (i < n) {
        m.put(i, "val-" + i)
        i = i + 1
    }
    var ks: ArrayList<Int> = m.keys()
    var vs: ArrayList<String> = m.values()
    c.check("kvc.keysSize", ks.size == n)
    c.check("kvc.valuesSize", vs.size == n)
    c.check("kvc.equalSize", ks.size == vs.size)
    // 删除一些后仍然一致
    m.remove(10)
    m.remove(50)
    m.remove(100)
    ks = m.keys()
    vs = m.values()
    c.check("kvc.afterRemoveKeys", ks.size == n - 3)
    c.check("kvc.afterRemoveValues", vs.size == n - 3)
    c.check("kvc.afterRemoveEqual", ks.size == vs.size)
}

// ── 7. 多种键类型混合 ──

fun testMixedKeyTypes(c: Checker): Unit {
    // Int + String 混合（通过 Any 类型容器）
    var m: HashMap<Any, Int> = HashMap<Any, Int>()
    m.put(1, 100)
    m.put("one", 200)
    m.put(2, 300)
    m.put("two", 400)
    c.check("mkt.size", m.size == 4)
    c.check("mkt.intKey", m.get(1) == 100)
    c.check("mkt.stringKey", m.get("one") == 200)
    c.check("mkt.intKey2", m.get(2) == 300)
    c.check("mkt.stringKey2", m.get("two") == 400)
    m.remove(1)
    c.check("mkt.afterRemoveInt", m.size == 3 && m.get(1) == null)
    c.check("mkt.stringIntact", m.get("one") == 200)
}

// ── 8. 大量值相同的键（同值不同键）──

fun testDuplicateValues(c: Checker): Unit {
    var m: HashMap<Int, Int> = HashMap<Int, Int>()
    var n: Int = 300
    var i: Int = 0
    while (i < n) {
        m.put(i, i % 50)  // 值域 0..49，键域 0..299
        i = i + 1
    }
    c.check("dv.size", m.size == n)
    c.check("dv.keysCount", m.keys().size == n)
    // 值应该存在
    c.check("dv.containsValue0", m.containsValue(0))
    c.check("dv.containsValue49", m.containsValue(49))
    c.check("dv.notContainsValue50", m.containsValue(50) == false)
    // 所有键的值应该正确
    var ok: Boolean = true
    i = 0
    while (i < n) {
        if (m.get(i) != (i % 50)) { ok = false }
        i = i + 1
    }
    c.check("dv.allValues", ok)
}

// ── 9. containsValue 在删除后被遮蔽值的检测 ──

fun testContainsValueAfterOverwrite(c: Checker): Unit {
    var m: HashMap<Int, Int> = HashMap<Int, Int>()
    m.put(1, 100)
    m.put(2, 200)
    m.put(3, 300)
    // 覆盖写
    m.put(1, 999)
    c.check("cvoa.size", m.size == 3)
    // 旧值 100 应该不再存在
    c.check("cvoa.oldValueGone", m.containsValue(100) == false)
    c.check("cvoa.newValueExists", m.containsValue(999))
    // 删除后旧值不泄漏
    m.remove(2)
    c.check("cvoa.removedValueGone", m.containsValue(200) == false)
    c.check("cvoa.otherValuesIntact", m.containsValue(300))
}

// ── 10. 大数量下 keys() 无重复 ──

fun testNoDuplicateKeysLarge(c: Checker): Unit {
    var m: HashMap<Int, Int> = HashMap<Int, Int>()
    var n: Int = 500
    var i: Int = 0
    while (i < n) {
        m.put(i, i)
        i = i + 1
    }
    var ks: ArrayList<Int> = m.keys()
    c.check("ndk.size", ks.size == n)
    // 检查无重复
    var dup: Boolean = false
    var a: Int = 0
    while (a < ks.size && dup == false) {
        var b: Int = a + 1
        while (b < ks.size && dup == false) {
            if (ks[a] == ks[b]) { dup = true }
            b = b + 1
        }
        a = a + 1
    }
    c.check("ndk.noDuplicates", dup == false)
}

// ── main ──

fun main(): Unit {
    var c: Checker = Checker()
    println("=== HashMap Hash Distribution Tests ===")
    println()
    println("T01"); testDenseKeys(c)
    println("T02"); testStride2Keys(c)
    println("T03"); testStride16Keys(c)
    println("T04"); testStride1000Keys(c)
    println("T05"); testContainsValueLarge(c)
    println("T06"); testKeysValuesCorrespondence(c)
    println("T07"); testMixedKeyTypes(c)
    println("T08"); testDuplicateValues(c)
    println("T09"); testContainsValueAfterOverwrite(c)
    println("T10"); testNoDuplicateKeysLarge(c)
    println("TEND"); c.summary()
}
