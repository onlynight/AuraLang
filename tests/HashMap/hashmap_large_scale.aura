// tests/HashMap/hashmap_large_scale.aura
// ─────────────────────────────────────────────────────────────────────────────
// HashMap<K, V> 大数量规模测试
//
// 覆盖：1000 条、5000 条、10000 条插入后全量检索；
//       大批量删除与重插；密集删除后扩容压实；
//       键值一致性校验；keys/values 数量校验。
//
// 运行：aura run tests/HashMap/hashmap_large_scale.aura
//   全通过时输出 "ALL TESTS PASSED"
// ─────────────────────────────────────────────────────────────────────────────

package test

import aura.lang.collection.HashMap
import aura.lang.collection.ArrayList

/// 断言计数与汇总输出。
class Checker {
    private var passed: Int
    private var failed: Int

    constructor() {
        this.passed = 0
        this.failed = 0
    }

    fun check(name: String, cond: Boolean): Unit {
        if (cond) {
            this.passed = this.passed + 1
        } else {
            this.failed = this.failed + 1
            println("FAIL: " + name)
        }
    }

    fun summary(): Unit {
        println("passed=" + this.passed + " failed=" + this.failed)
        if (this.failed == 0) {
            println("ALL TESTS PASSED")
        } else {
            println("SOME TESTS FAILED")
        }
    }
}

// ── 1. 1000 条 Int 键插入 + 全量检索 ──

fun testInsert1000(c: Checker): Unit {
    var n: Int = 1000
    var m: HashMap<Int, Int> = HashMap<Int, Int>()
    var i: Int = 0
    while (i < n) {
        m.put(i, i * 2)
        i = i + 1
    }
    c.check("1000.size", m.size == n)
    c.check("1000.keysCount", m.keys().size == n)
    c.check("1000.valuesCount", m.values().size == n)
    var ok: Boolean = true
    i = 0
    while (i < n) {
        if (m.get(i) != (i * 2)) { ok = false }
        i = i + 1
    }
    c.check("1000.allValues", ok)
    // containsKey 全量
    ok = true
    i = 0
    while (i < n) {
        if (m.containsKey(i) == false) { ok = false }
        i = i + 1
    }
    c.check("1000.allContains", ok)
    c.check("1000.missing", m.containsKey(n) == false)
}

// ── 2. 5000 条 Int 键插入 + 删除一半 + 重插 ──

fun testInsert5000(c: Checker): Unit {
    var n: Int = 5000
    var m: HashMap<Int, Int> = HashMap<Int, Int>()
    var i: Int = 0
    while (i < n) {
        m.put(i, i)
        i = i + 1
    }
    c.check("5000.size", m.size == n)
    c.check("5000.keysCount", m.keys().size == n)
    // 删除偶数索引
    var removed: Int = 0
    i = 0
    while (i < n) {
        if (i % 2 == 0) {
            m.remove(i)
            removed = removed + 1
        }
        i = i + 1
    }
    c.check("5000.removedCount", removed == 2500)
    c.check("5000.sizeAfterRemove", m.size == 2500)
    c.check("5000.keysAfterRemove", m.keys().size == 2500)
    // 验证剩余键值
    var ok: Boolean = true
    i = 0
    while (i < n) {
        if (i % 2 == 1) {
            if (m.get(i) != i) { ok = false }
        } else {
            if (m.containsKey(i)) { ok = false }
        }
        i = i + 1
    }
    c.check("5000.evenGoneOddKept", ok)
    // 重插 5000 个新键
    i = 10000
    while (i < 15000) {
        m.put(i, i)
        i = i + 1
    }
    c.check("5000.sizeAfterRefill", m.size == 7500)
    c.check("5000.keysAfterRefill", m.keys().size == 7500)
    ok = true
    i = 10000
    while (i < 15000) {
        if (m.get(i) != i) { ok = false }
        i = i + 1
    }
    c.check("5000.refillValues", ok)
}

// ── 3. 10000 条 Int 键插入 + 全量检索 ──

fun testInsert10000(c: Checker): Unit {
    var n: Int = 10000
    var m: HashMap<Int, Int> = HashMap<Int, Int>()
    var i: Int = 0
    while (i < n) {
        m.put(i, i * 3 + 1)
        i = i + 1
    }
    c.check("10000.size", m.size == n)
    c.check("10000.keysCount", m.keys().size == n)
    var ok: Boolean = true
    i = 0
    while (i < n) {
        if (m.get(i) != (i * 3 + 1)) { ok = false }
        i = i + 1
    }
    c.check("10000.allValues", ok)
    // 随机删除 1000 个
    var removed: Int = 0
    i = 0
    while (i < 1000) {
        var key: Int = 9000 - i
        m.remove(key)
        removed = removed + 1
        i = i + 1
    }
    c.check("10000.removedCount", removed == 1000)
    c.check("10000.sizeAfterRemove", m.size == 9000)
    ok = true
    i = 0
    while (i < 9000) {
        if (i < 8001) {
            if (m.get(i) != (i * 3 + 1)) { ok = false }
        } else {
            if (m.containsKey(i)) { ok = false }
        }
        i = i + 1
    }
    c.check("10000.tailRemoved", ok)
}

// ── 4. 1000 条 String 键插入 + 全量检索 ──

fun testStringKeys1000(c: Checker): Unit {
    var n: Int = 1000
    var m: HashMap<String, Int> = HashMap<String, Int>()
    var i: Int = 0
    while (i < n) {
        m.put("key-" + i, i)
        i = i + 1
    }
    c.check("sk1000.size", m.size == n)
    c.check("sk1000.keysCount", m.keys().size == n)
    var ok: Boolean = true
    i = 0
    while (i < n) {
        if (m.get("key-" + i) != i) { ok = false }
        i = i + 1
    }
    c.check("sk1000.allValues", ok)
    c.check("sk1000.missing", m.get("key-" + n) == null)
    // 删除后再验证
    m.remove("key-500")
    c.check("sk1000.afterRemove", m.size == 999 && m.get("key-500") == null)
    c.check("sk1000.afterRemoveNeighbor", m.get("key-499") == 499 && m.get("key-501") == 501)
}

// ── 5. 大数量覆盖写：同键反复写入 ──

fun testMassiveOverwrite(c: Checker): Unit {
    var m: HashMap<Int, Int> = HashMap<Int, Int>()
    // 对 5 个键各写入 200 次
    var keyCount: Int = 5
    var opsPerKey: Int = 200
    var k: Int = 0
    while (k < keyCount) {
        var i: Int = 0
        while (i < opsPerKey) {
            m.put(k, k * 100 + i)
            i = i + 1
        }
        k = k + 1
    }
    c.check("ow5.size", m.size == keyCount)
    c.check("ow5.keysCount", m.keys().size == keyCount)
    // 最后一个写入的值应该生效
    var ok: Boolean = true
    k = 0
    while (k < keyCount) {
        if (m.get(k) != (k * 100 + opsPerKey - 1)) { ok = false }
        k = k + 1
    }
    c.check("ow5.lastValues", ok)
}

// ── 6. 大数量交替删除 / 重插 ──

fun testMassiveDeleteInsert(c: Checker): Unit {
    var m: HashMap<Int, Int> = HashMap<Int, Int>()
    var n: Int = 2000
    var i: Int = 0
    while (i < n) {
        m.put(i, i)
        i = i + 1
    }
    // 交替删除与重插 500 轮
    var rounds: Int = 500
    i = 0
    while (i < rounds) {
        var keyToRemove: Int = i * 4
        var keyToAdd: Int = 100000 + i
        if (m.containsKey(keyToRemove)) {
            m.remove(keyToRemove)
        }
        m.put(keyToAdd, keyToAdd)
        i = i + 1
    }
    // 剩余：未被删除的原始键 + 新增键
    var expectedSize: Int = n - rounds + rounds
    c.check("mdd.size", m.size == expectedSize)
    // 验证新增键全部存在
    var ok: Boolean = true
    i = 0
    while (i < rounds) {
        if (m.get(100000 + i) != (100000 + i)) { ok = false }
        i = i + 1
    }
    c.check("mdd.newKeys", ok)
}

// ── 7. 大批量 null 值 + 删除 ──

fun testLargeNullValues(c: Checker): Unit {
    var m: HashMap<Int, Int> = HashMap<Int, Int>()
    var n: Int = 500
    var i: Int = 0
    while (i < n) {
        if (i % 3 == 0) {
            m.put(i, null)
        } else {
            m.put(i, i)
        }
        i = i + 1
    }
    c.check("ln.size", m.size == n)
    c.check("ln.keysCount", m.keys().size == n)
    // null 值的键应该 exists 但 get 返回 null
    var ok: Boolean = true
    i = 0
    while (i < n) {
        if (i % 3 == 0) {
            if (m.containsKey(i) == false) { ok = false }
            if (m.get(i) != null) { ok = false }
        } else {
            if (m.get(i) != i) { ok = false }
        }
        i = i + 1
    }
    c.check("ln.nullValues", ok)
    // 删除 null 值的键
    var removedNull: Int = 0
    i = 0
    while (i < n) {
        if (i % 3 == 0) {
            m.remove(i)
            removedNull = removedNull + 1
        }
        i = i + 1
    }
    c.check("ln.removedNullCount", removedNull == 167)
    c.check("ln.sizeAfterRemove", m.size == 333)
    ok = true
    i = 0
    while (i < n) {
        if (i % 3 == 0) {
            if (m.containsKey(i)) { ok = false }
        }
        i = i + 1
    }
    c.check("ln.nullKeysGone", ok)
}

// ── main ──

fun main(): Unit {
    var c: Checker = Checker()
    println("=== HashMap Large Scale Tests ===")
    println()
    println("T01"); testInsert1000(c)
    println("T02"); testInsert5000(c)
    println("T03"); testInsert10000(c)
    println("T04"); testStringKeys1000(c)
    println("T05"); testMassiveOverwrite(c)
    println("T06"); testMassiveDeleteInsert(c)
    println("T07"); testLargeNullValues(c)
    println("TEND"); c.summary()
}
