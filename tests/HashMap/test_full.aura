package test

import aura.lang.collection.HashMap

fun main(): Int {
    // Test HashMap put
    var m = HashMap<Int, Int>()
    m.put(1, 10)
    m.put(2, 20)
    m.put(3, 30)
    
    assert(m.getSize() == 3, "HashMap size should be 3")
    assert(m.get(1) == 10, "HashMap get(1) should be 10")
    assert(m.get(2) == 20, "HashMap get(2) should be 20")
    assert(m.get(3) == 30, "HashMap get(3) should be 30")
    assert(m.get(4) == null, "HashMap get(4) should be null")
    
    // Test HashMap containsKey
    assert(m.containsKey(1) == true, "HashMap should contain key 1")
    assert(m.containsKey(4) == false, "HashMap should not contain key 4")
    
    // Test HashMap containsValue
    assert(m.containsValue(10) == true, "HashMap should contain value 10")
    assert(m.containsValue(40) == false, "HashMap should not contain value 40")
    
    // Test HashMap overwrite
    m.put(1, 100)
    assert(m.getSize() == 3, "HashMap size should still be 3 after overwrite")
    assert(m.get(1) == 100, "HashMap get(1) after overwrite should be 100")
    
    // Test HashMap remove
    m.remove(2)
    assert(m.getSize() == 2, "HashMap size after remove should be 2")
    assert(m.get(2) == null, "HashMap get(2) after remove should be null")
    
    // Test HashMap clear
    m.clear()
    assert(m.isEmpty() == true, "HashMap should be empty after clear")
    
    println("HashMap tests passed")
    return 0
}
