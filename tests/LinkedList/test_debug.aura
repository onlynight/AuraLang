package test

import aura.lang.collection.LinkedList
import aura.lang.collection.ListNode

fun main(): Int {
    var node = ListNode<Int>(42)
    println("node value=" + node.value)
    println("node next=" + node.next)
    println("node prev=" + node.prev)
    var l = LinkedList<Int>()
    println("before add size=" + l.count())
    l.add(1)
    println("after add size=" + l.count())
    println("head=" + l.head)
    return 0
}
