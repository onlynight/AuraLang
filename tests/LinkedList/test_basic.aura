package test

import aura.lang.collection.LinkedList

fun main(): Int {
    var l = LinkedList<Int>()
    l.add(1)
    l.add(2)
    l.add(3)
    println("size=" + l.count())
    println("first=" + l.first())
    println("last=" + l.last())
    l.prepend(0)
    println("after prepend first=" + l.first())
    l.removeLast()
    println("after removeLast last=" + l.last())
    return 0
}
