package test

import aura.lang.collection.LinkedList

fun main(): Int {
    var l = LinkedList<Integer>()
    println("before addBack size=" + l.count())
    l.addBack(1)
    println("after addBack(1) size=" + l.count())
    l.addBack(2)
    println("after addBack(2) size=" + l.count())
    l.addBack(3)
    println("after addBack(3) size=" + l.count())
    println("first=" + l.first())
    println("last=" + l.last())
    return 0
}
