package test

import aura.lang.collection.LinkedList

fun main(): Int {
    // Test LinkedList as local variable
    var local = LinkedList<Int>()
    local.addBack(1)
    local.addBack(2)
    local.addBack(3)
    println("local size=" + local.getSize())
    println("local first=" + local.first())
    
    // Test LinkedList as field
    var holder = Holder()
    holder.addLocal(1)
    holder.addLocal(2)
    holder.addLocal(3)
    println("field size=" + holder.getSize())
    println("field first=" + holder.first())
    
    return 0
}

class Holder {
    var data: LinkedList<Int>
    
    constructor() {
        data = LinkedList<Int>()
    }
    
    fun addLocal(item: Int): Unit {
        data.addBack(item)
    }
    
    fun getSize(): Int {
        return data.getSize()
    }
    
    fun first(): Int {
        return data.first()
    }
}
