package test

import aura.lang.collection.LinkedList

fun main(): Int {
    var local = LinkedList<Int>()
    local.addBack(1)
    local.addBack(2)
    local.addBack(3)
    var c: Int = local.count()
    println("local count=" + c)
    println("local first=" + local.first())
    println("local last=" + local.last())
    return 0
}
