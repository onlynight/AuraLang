package test

import aura.lang.collection.TreeSet

fun main(): Int {
    var s = TreeSet<Int>()
    s.add(3)
    s.add(1)
    s.add(2)
    s.add(3)
    
    assert(s.count() == 3, "TreeSet count should be 3")
    assert(s.contains(1) == true, "TreeSet should contain 1")
    assert(s.contains(2) == true, "TreeSet should contain 2")
    assert(s.contains(3) == true, "TreeSet should contain 3")
    assert(s.contains(4) == false, "TreeSet should not contain 4")
    
    s.removeItem(2)
    assert(s.count() == 2, "TreeSet count after removeItem should be 2")
    assert(s.contains(2) == false, "TreeSet should not contain 2 after removeItem")
    
    s.clear()
    assert(s.isEmpty() == true, "TreeSet should be empty after clear")
    
    println("TreeSet tests passed")
    return 0
}
