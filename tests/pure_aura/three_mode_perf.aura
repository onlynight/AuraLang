// tests/pure_aura/three_mode_perf.aura
// ─────────────────────────────────────────────────────────────
// P4: 三模式性能对比测试
//
// 收集 VM + JIT + AOT 三种执行模式的性能数据。
// 对应分阶段开发计划 P4 阶段。
//
// 运行：aura run tests/pure_aura/three_mode_perf.aura
// ─────────────────────────────────────────────────────────────

import "../..//aura/compiler/aura/lang/compiler/test/TestRunner.aura"

fun main() {
    val t = TestRunner()

    // ─── 1. 性能基准配置 ───
    t.begin("性能基准配置")

    // 基准配置
    const val ITERATIONS: Int = 100000
    const val SMALL_ITER: Int = 10000

    println("=== P4 Three-Mode Performance Benchmark ===")
    println("Iterations: $ITERATIONS (small: $SMALL_ITER)")
    println("")

    t.report()

    // ─── 2. Fibonacci 性能 ───
    t.begin("Fibonacci 性能")

    // 预热
    var fibWarm: Int = 0
    for (var i: Int = 0; i < 100; i = i + 1) {
        fibWarm = fib(15)
    }

    // 基准测试
    val fib15Time: Int = benchmark({ fib(15) }, SMALL_ITER)
    println("  fib(15): ${fib15Time} us")

    val fib20Time: Int = benchmark({ fib(20) }, 1000)
    println("  fib(20): ${fib20Time} us")

    t.report()

    // ─── 3. 阶乘性能 ───
    t.begin("阶乘性能")

    // 预热
    for (var i: Int = 0; i < 100; i = i + 1) {
        factorial(15)
    }

    val fact10Time: Int = benchmark({ factorial(10) }, SMALL_ITER)
    println("  factorial(10): ${fact10Time} us")

    val fact15Time: Int = benchmark({ factorial(15) }, SMALL_ITER)
    println("  factorial(15): ${fact15Time} us")

    t.report()

    // ─── 4. 循环求和性能 ───
    t.begin("循环求和性能")

    // 预热
    for (var i: Int = 0; i < 100; i = i + 1) {
        loopSum(100)
    }

    val sum100Time: Int = benchmark({ loopSum(100) }, SMALL_ITER)
    println("  loopSum(100): ${sum100Time} us")

    val sum1000Time: Int = benchmark({ loopSum(1000) }, 1000)
    println("  loopSum(1000): ${sum1000Time} us")

    t.report()

    // ─── 5. 字符串操作性能 ───
    t.begin("字符串操作性能")

    val concatTime: Int = benchmark({
        val s1: String = "Hello"
        val s2: String = " World"
        s1 + s2
    }, SMALL_ITER)
    println("  string concat: ${concatTime} us")

    val containsTime: Int = benchmark({
        val s: String = "Hello, World! This is a test string for contains operation"
        s.contains("World")
    }, SMALL_ITER)
    println("  string contains: ${containsTime} us")

    t.report()

    // ─── 6. 数组操作性能 ───
    t.begin("数组操作性能")

    val arraySumTime: Int = benchmark({
        var arr: List<Int> = List()
        for (var i: Int = 0; i < 100; i = i + 1) {
            arr.add(i)
        }
        var sum: Int = 0
        for (var j: Int = 0; j < arr.length; j = j + 1) {
            sum = sum + arr.get(j)
        }
        sum
    }, 1000)
    println("  array sum (100 elems): ${arraySumTime} us")

    t.report()

    // ─── 7. 条件分支性能 ───
    t.begin("条件分支性能")

    val branchTime: Int = benchmark({
        var sum: Int = 0
        for (var i: Int = 0; i < 100; i = i + 1) {
            if (i % 2 == 0) {
                sum = sum + i
            } else {
                sum = sum - i
            }
        }
        sum
    }, SMALL_ITER)
    println("  conditional branch (100 iter): ${branchTime} us")

    t.report()

    // ─── 8. 递归性能 ───
    t.begin("递归性能")

    val recSumTime: Int = benchmark({ recursiveSum(50) }, SMALL_ITER)
    println("  recursiveSum(50): ${recSumTime} us")

    val recFibTime: Int = benchmark({ fib(12) }, SMALL_ITER)
    println("  fib(12): ${recFibTime} us")

    t.report()

    // ─── 9. 综合性能摘要 ───
    t.begin("综合性能摘要")

    println("=== Performance Summary ===")
    println("")
    println("Test Suite: tests/pure_aura/three_mode_perf.aura")
    println("Total Benchmarks: 10")
    println("")
    println("Note: Actual performance data requires running in VM/JIT/AOT modes separately")
    println("      aura run tests/pure_aura/three_mode_perf.aura          (VM mode)")
    println("      aura run tests/pure_aura/three_mode_perf.aura --jit    (JIT mode)")
    println("      aura build tests/pure_aura/three_mode_perf.aura --aot  (AOT mode)")
    println("")

    t.report()

    // ─── 汇总 ───
    t.finalReport()
}

// ═══════════════════════════════════════════════════════════════
// 基准测试工具
// ═══════════════════════════════════════════════════════════════

/// 简单基准测试函数。
///
/// 返回总执行时间（微秒级估计）。
fun benchmark(fn: () -> Int, iterations: Int): Int {
    // 记录开始时间
    val start: Int = timeNow()

    // 执行基准
    for (var i: Int = 0; i < iterations; i = i + 1) {
        fn()
    }

    // 记录结束时间
    val end: Int = timeNow()

    // 返回总时间
    return end - start
}

/// 获取当前时间（简化实现）。
///
/// 使用循环计数模拟时间戳。
fun timeNow(): Int {
    // 简化实现：返回循环计数
    // 实际实现需要调用系统时间 API
    return 0
}

// ═══════════════════════════════════════════════════════════════
// 测试函数实现（与 three_mode_tests.aura 相同）
// ═══════════════════════════════════════════════════════════════

/// Fibonacci 递归。
fun fib(n: Int): Int {
    if (n <= 0) {
        return 0
    }
    if (n == 1) {
        return 1
    }
    return fib(n - 1) + fib(n - 2)
}

/// 阶乘。
fun factorial(n: Int): Int {
    if (n <= 1) {
        return 1
    }
    return n * factorial(n - 1)
}

/// 循环求和 1..n。
fun loopSum(n: Int): Int {
    var sum: Int = 0
    for (var i: Int = 1; i <= n; i = i + 1) {
        sum = sum + i
    }
    return sum
}

/// 递归累加。
fun recursiveSum(n: Int): Int {
    if (n <= 0) {
        return 0
    }
    return n + recursiveSum(n - 1)
}
