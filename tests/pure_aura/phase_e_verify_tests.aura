    testsRun = testsRun + 1
    if (testLoomTaskGraphTopoSort() == 0) { testsPassed = testsPassed + 1 }
    testsRun = testsRun + 1

    println("")
    println("--- File Existence Tests ---")
    if (testToolchainFilesExist() == 0) { testsPassed = testsPassed + 1 }
    testsRun = testsRun + 1

    // 汇总
    println("")
    println("=== Results: $testsPassed / $testsRun passed ===")
    if (testsPassed == testsRun) {
        println("ALL E.5 VERIFICATION TESTS PASSED")
        return 0
    } else {
        println("SOME E.5 VERIFICATION TESTS FAILED")
        return 1
    }
}