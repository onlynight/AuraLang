// ── E.5.21: LSP JSON-RPC 端到端验证 ──

fun testLspJsonRpc(): Int {
    println("[E.5.21] Testing LSP JSON-RPC...")

    // 测试 Content-Length 解析
    Assert.assert(parseContentLength("Content-Length: 100") == 100, "Should parse 100")
    Assert.assert(parseContentLength("Content-Length: 256") == 256, "Should parse 256")
    Assert.assert(parseContentLength("Invalid") == -1, "Should return -1 for invalid")

    // 测试 didOpen 处理
    val server = LspServer()
    val openParams = "{\"textDocument\": {\"uri\": \"file:///test.aura\", \"text\": \"fun main() {}\"}}"
    val result = server.handleDidOpen(openParams)
    Assert.assert(result == "null", "didOpen should return null")

    // 测试 didChange 处理
    val changeParams = "{\"textDocument\": {\"uri\": \"file:///test.aura\", \"text\": \"fun main() { return 0 }\"}}"
    val changeResult = server.handleDidChange(changeParams)
    Assert.assert(changeResult == "null", "didChange should return null")

    // 测试 didClose 处理
    val closeParams = "{\"textDocument\": {\"uri\": \"file:///test.aura\"}}"
    val closeResult = server.handleDidClose(closeParams)
    Assert.assert(closeResult == "null", "didClose should return null")

    return 0
}

// ── E.5.22: Debugger 断点生命周期验证 ──

fun testDebuggerLifecycle(): Int {
    println("[E.5.22] Testing Debugger lifecycle...")

    // 创建调试器
    val dbg = Debugger()
    Assert.assert(!dbg.initialized, "Should not be initialized")

    // 添加断点
    val bp = dbg.addBreakpoint("main.aura", 10)
    Assert.assert(bp.id == 1, "First breakpoint id should be 1")
    Assert.assert(bp.file == "main.aura", "File should be 'main.aura'")
    Assert.assert(bp.line == 10, "Line should be 10")

    // 验证断点列表
    Assert.assert(dbg.breakpoints.list().size == 1, "Should have 1 breakpoint")

    // 移除断点
    dbg.removeBreakpoint(1)
    Assert.assert(dbg.breakpoints.list().size == 0, "Should have 0 breakpoints after removal")

    // 添加多个断点
    dbg.addBreakpoint("main.aura", 10)
    dbg.addBreakpoint("main.aura", 20)
    dbg.addBreakpoint("other.aura", 5)
    Assert.assert(dbg.breakpoints.list().size == 3, "Should have 3 breakpoints")

    return 0
}

// ── E.5.23: Loom Manifest 解析验证 ──

fun testLoomManifestParsing(): Int {
    println("[E.5.23] Testing Loom Manifest parsing...")

    // 创建 manifest
    val m = Manifest("test-project", "aura.toml")
    m.version = "1.0.0"
    m.description = "A test project"
    m.addDependency("aura.core")
    m.addDevDependency("aura.test")
    m.addBuildTask("build")

    // 验证所有字段
    Assert.assert(m.name == "test-project", "Name should be 'test-project'")
    Assert.assert(m.version == "1.0.0", "Version should be '1.0.0'")
    Assert.assert(m.description == "A test project", "Description should be set")
    Assert.assert(m.dependencies.size == 1, "Should have 1 dependency")
    Assert.assert(m.devDependencies.size == 1, "Should have 1 dev dependency")
    Assert.assert(m.buildTasks.size == 1, "Should have 1 build task")

    return 0
}

// ── E.5.24: Loom TaskGraph 拓扑排序验证 ──

fun testLoomTaskGraphTopoSort(): Int {
    println("[E.5.24] Testing Loom TaskGraph topoSort...")

    val g = TaskGraph()
    g.addTask("check", "aura check")
    g.addTask("fmt", "aura fmt")
    g.addTask("build", "aura build")
    g.addTask("test", "aura test")
    g.addTask("doc", "aura doc")
    g.addTask("clean", "rm -rf build")

    g.addDependency("build", "check")
    g.addDependency("test", "build")
    g.addDependency("doc", "build")

    val result = g.topoSort()
    Assert.assert(result == 0, "Topo sort should succeed")
    Assert.assert(g.executionOrder.size == 6, "Should have 6 tasks")

    // 验证 check 在 build 之前
    var checkIdx = -1
    var buildIdx = -1
    var testIdx = -1
    var i = 0
    while (i < g.executionOrder.size) {
        if (g.executionOrder.get(i) == "check") { checkIdx = i }
        if (g.executionOrder.get(i) == "build") { buildIdx = i }
        if (g.executionOrder.get(i) == "test") { testIdx = i }
        i = i + 1
    }
    Assert.assert(checkIdx >= 0, "Check should be in order")
    Assert.assert(buildIdx >= 0, "Build should be in order")
    Assert.assert(testIdx >= 0, "Test should be in order")
    Assert.assert(checkIdx < buildIdx, "Check should come before Build")
    Assert.assert(buildIdx < testIdx, "Build should come before Test")

    return 0
}

// ── E.5.25: 工具链文件存在性验证 ──

fun testToolchainFilesExist(): Int {
    println("[E.5.25] Testing toolchain files exist...")

    // 验证所有工具链文件存在
    Assert.assert(testFileExists("aura/toolchain/aura/lang/cli/AuraCli.aura"),
                  "AuraCli.aura should exist")
    Assert.assert(testFileExists("aura/toolchain/aura/lang/lsp/AuraLsp.aura"),
                  "AuraLsp.aura should exist")
    Assert.assert(testFileExists("aura/toolchain/aura/lang/debugger/AuraDebugger.aura"),
                  "AuraDebugger.aura should exist")
    Assert.assert(testFileExists("aura/toolchain/aura/lang/loom/Loom.aura"),
                  "Loom.aura should exist")
    Assert.assert(testFileExists("scripts/verify-pure-aura.ps1"),
                  "verify-pure-aura.ps1 should exist")

    return 0
}

