// ── E.5.2: aura build 验证 ──

fun testBuildCommand(): Int {
    println("[E.5.2] Testing aura build...")

    // 验证 build 命令存在且可调用
    val args = Args()
    args.add("build")
    args.add("--output")
    args.add("/tmp/test_build.aura")

    // 验证 Args 解析正确
    Assert.assert(args.size == 3, "Build args should have 3 items")
    Assert.assert(args.hasFlag("--output"), "Should have --output flag")
    Assert.assert(args.getValue("--output") == "/tmp/test_build.aura", "Output should be correct")

    // 验证 build 命令处理（无源文件应返回错误）
    val emptyArgs = Args()
    val result = cmdBuild(emptyArgs)
    Assert.assert(result == 1, "cmdBuild with no args should return 1")

    return 0
}

