    testsRun = testsRun + 1

    println("")
    println("--- LSP Tests ---")
    if (testLspJsonRpc() == 0) { testsPassed = testsPassed + 1 }
    testsRun = testsRun + 1

    println("")
    println("--- Debugger Tests ---")
    if (testDebuggerLifecycle() == 0) { testsPassed = testsPassed + 1 }
    testsRun = testsRun + 1

    println("")
    println("--- Loom Tests ---")
    if (testLoomBuild() == 0) { testsPassed = testsPassed + 1 }
    testsRun = testsRun + 1
    if (testLoomTest() == 0) { testsPassed = testsPassed + 1 }
