// Phase E.3: AuraDebugger.aura 单元测试
//
// 验证断点管理、调试器状态机、REPL 命令等核心功能。

import aura.lang.std.String
import aura.lang.std.IO
import aura.lang.std.Collections
import aura.lang.std.Assert

// ── Breakpoint 测试 ──

fun testBreakpointConstruction(): Int {
    val bp = Breakpoint(1, "test.aura", 42, true)
    Assert.assert(bp.id == 1, "Breakpoint id should be 1")
    Assert.assert(bp.file == "test.aura", "File should be 'test.aura'")
    Assert.assert(bp.line == 42, "Line should be 42")
    Assert.assert(bp.enabled, "Should be enabled")
    return 0
}

fun testBreakpointToStr(): Int {
    val bp = Breakpoint(1, "test.aura", 42, true)
    val s = bp.toStr()
    Assert.assert(s.contains("1"), "String should contain id")
    Assert.assert(s.contains("test.aura"), "String should contain file")
    Assert.assert(s.contains("42"), "String should contain line")
    return 0
}

// ── BreakpointManager 测试 ──

fun testBreakpointManagerAdd(): Int {
    val mgr = BreakpointManager()
    val bp = mgr.add("main.aura", 10)
    Assert.assert(bp.id == 1, "First breakpoint id should be 1")
    Assert.assert(mgr.list().size == 1, "Should have 1 breakpoint")
    return 0
}

fun testBreakpointManagerAddMultiple(): Int {
    val mgr = BreakpointManager()
    mgr.add("main.aura", 10)
    mgr.add("main.aura", 20)
    mgr.add("other.aura", 5)
    Assert.assert(mgr.list().size == 3, "Should have 3 breakpoints")
    Assert.assert(mgr.list().get(2).id == 3, "Third breakpoint id should be 3")
    return 0
}

fun testBreakpointManagerRemove(): Int {
    val mgr = BreakpointManager()
    mgr.add("main.aura", 10)
    mgr.add("main.aura", 20)
    mgr.remove(1)
    Assert.assert(mgr.list().size == 1, "Should have 1 breakpoint after removal")
    Assert.assert(mgr.list().get(0).id == 2, "Remaining breakpoint should have id 2")
    return 0
}

fun testBreakpointManagerToggle(): Int {
    val mgr = BreakpointManager()
    mgr.add("main.aura", 10)
    Assert.assert(mgr.list().get(0).enabled, "Should be enabled initially")
    mgr.toggle(1)
    Assert.assert(!mgr.list().get(0).enabled, "Should be disabled after toggle")
    mgr.toggle(1)
    Assert.assert(mgr.list().get(0).enabled, "Should be enabled after second toggle")
    return 0
}

fun testBreakpointManagerPrintAll(): Int {
    val mgr = BreakpointManager()
    // printAll 应输出断点列表（不崩溃即可）
    mgr.printAll()
    return 0
}

// ── Debugger 状态机测试 ──

fun testDebuggerInit(): Int {
    val dbg = Debugger()
    Assert.assert(!dbg.initialized, "Should not be initialized initially")
    Assert.assert(!dbg.running, "Should not be running initially")
    return 0
}

// ── Watch 表达式测试 ──

fun testDebuggerWatch(): Int {
    val dbg = Debugger()
    dbg.watch("x + 1")
    Assert.assert(dbg.watchExprs.size == 1, "Should have 1 watch expression")
    dbg.watch("y * 2")
    Assert.assert(dbg.watchExprs.size == 2, "Should have 2 watch expressions")
    return 0
}

// ── 主测试函数 ──

fun main(): Int {
    println("=== Phase E.3: AuraDebugger Unit Tests ===")

    var testsRun: Int = 0
    var testsPassed: Int = 0

    println("Running Breakpoint tests...")
    if (testBreakpointConstruction() == 0) { testsPassed = testsPassed + 1 }
    testsRun = testsRun + 1
    if (testBreakpointToStr() == 0) { testsPassed = testsPassed + 1 }
    testsRun = testsRun + 1

    println("Running BreakpointManager tests...")
    if (testBreakpointManagerAdd() == 0) { testsPassed = testsPassed + 1 }
    testsRun = testsRun + 1
    if (testBreakpointManagerAddMultiple() == 0) { testsPassed = testsPassed + 1 }
    testsRun = testsRun + 1
    if (testBreakpointManagerRemove() == 0) { testsPassed = testsPassed + 1 }
    testsRun = testsRun + 1
    if (testBreakpointManagerToggle() == 0) { testsPassed = testsPassed + 1 }
    testsRun = testsRun + 1
    if (testBreakpointManagerPrintAll() == 0) { testsPassed = testsPassed + 1 }
    testsRun = testsRun + 1

    println("Running Debugger state tests...")
    if (testDebuggerInit() == 0) { testsPassed = testsPassed + 1 }
    testsRun = testsRun + 1
    if (testDebuggerWatch() == 0) { testsPassed = testsPassed + 1 }
    testsRun = testsRun + 1

    println("")
    println("=== Results: $testsPassed / $testsRun passed ===")
    if (testsPassed == testsRun) {
        println("ALL TESTS PASSED")
        return 0
    } else {
        println("SOME TESTS FAILED")
        return 1
    }
}