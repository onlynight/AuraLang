// ═════════════════════════════════════════════════════════════════
// Phase C.2 流程测试（Aura 侧）：FFI 声明 → HIR → LLVM IR
//
// 验证「Aura 编写的编译器」自身能否处理 `@native`（差距分析 C 阶段缺口）：
//   extern object { @native(SYS_WRITE) fun … }  → call @aura_syscall_dispatch(N, …)
//   extern object { native fun MemoryXxx … }    → aura_memory_* / inttoptr + load|store
//   extern object { @native(asm = "…") … }      → aura_cpu_* / LLVM inline asm
//   export fun …                                → define（外部可见符号）
//   @aot fun …                                  → declare（链接期解析）
//
// 运行：aura run tests/pure_aura/native_c2_emit_tests.aura
//   全通过时输出 "RESULT: PASS"
//
// 说明：本用例只做「HIR → LLVM IR 文本」断言，**不调用 llc/clang**，
//       因此无需安装 LLVM。端到端（IR → llc → clang → exe → 运行）见
//       tests/pure_aura/native_c2_aot_tests.aura。
// ═════════════════════════════════════════════════════════════════

import aura.lang.std.String

import "../../aura/compiler/aura/lang/compiler/test/TestRunner.aura"

import "../../aura/compiler/aura/lang/compiler/lexer/Span.aura"
import "../../aura/compiler/aura/lang/compiler/lexer/Token.aura"
import "../../aura/compiler/aura/lang/compiler/lexer/Lexer.aura"
import "../../aura/compiler/aura/lang/compiler/ast/Ast.aura"
import "../../aura/compiler/aura/lang/compiler/errors/CompileError.aura"
import "../../aura/compiler/aura/lang/compiler/parser/Parser.aura"

import "../../aura/compiler/aura/lang/compiler/hir/Hir.aura"
import "../../aura/compiler/aura/lang/compiler/hir/Desugar.aura"
import "../../aura/compiler/aura/lang/compiler/hir/Mono.aura"
import "../../aura/compiler/aura/lang/compiler/hir/Inline.aura"
import "../../aura/compiler/aura/lang/compiler/hir/Fold.aura"

import "../../aura/compiler/aura/lang/compiler/aot/TypeMapper.aura"
import "../../aura/compiler/aura/lang/compiler/aot/AotUtil.aura"
import "../../aura/compiler/aura/lang/compiler/aot/Runtime.aura"
import "../../aura/compiler/aura/lang/compiler/aot/StdSigs.aura"
import "../../aura/compiler/aura/lang/compiler/aot/Ffi.aura"
import "../../aura/compiler/aura/lang/compiler/aot/Target.aura"
import "../../aura/compiler/aura/lang/compiler/aot/Optimize.aura"
import "../../aura/compiler/aura/lang/compiler/aot/EmitBuffer.aura"
import "../../aura/compiler/aura/lang/compiler/aot/Emit.aura"

// ═════════════════════════════════════════════════════════════════
// 夹具
// ═════════════════════════════════════════════════════════════════

/// 源码 → HIR（Aura 侧 AOT 前半段）。
fun nc2SourceToHir(source: String): Hir {
    val p = Parser(source)
    p.parseProgram()
    val hl = HirLowerer()
    hl.lower(p.ast)
    return hl.hir
}

/// 源码 → LLVM IR 文本（Aura 侧发射器，不触碰外部工具链）。
fun nc2EmitIr(source: String): String {
    return emitLlvmIr(nc2SourceToHir(source), "nc2", "x86_64-pc-windows-msvc")
}

/// HIR 中是否降级出指定 kind 的节点。
fun nc2HirHasKind(hir: Hir, kind: String): Boolean {
    var i: Int = 0
    while (i < hir.count) {
        if (hir.kindOf(i) == kind) {
            return true
        }
        i = i + 1
    }
    return false
}

// ═════════════════════════════════════════════════════════════════
// 测试 1：@native(SYS_*) → aura_syscall_dispatch
// ═════════════════════════════════════════════════════════════════

fun nc2TestSyscall(): Int {
    val t = TestRunner()
    t.begin("c2.syscall")

    val src = "extern object Syscalls {\n" +
        "    @native(SYS_WRITE) fun write(fd: Int, buf: Long, count: Long): Long\n" +
        "    @native(SYS_MMAP)  fun mmap(addr: Long, len: Long, prot: Int, flags: Int, fd: Int, off: Long): Long\n" +
        "}\n" +
        "fun main(): Int {\n    return 0\n}\n"

    val hir: Hir = nc2SourceToHir(src)
    t.assertTrue(nc2HirHasKind(hir, "HirNativeFunction"), "HIR 降级出 HirNativeFunction")
    t.assertTrue(nc2HirHasKind(hir, "HirExternObject"), "HIR 降级出 HirExternObject")

    val ir: String = nc2EmitIr(src)
    // 声明：C 分发入口（runtimeDeclarations 注入）
    t.assertTrue(ir.contains("declare i64 @aura_syscall_dispatch("),
        "IR 声明 aura_syscall_dispatch")
    // 定义：syscall 参数统一 i64
    t.assertTrue(ir.contains("define i64 @write(i64 %arg.0, i64 %arg.1, i64 %arg.2)"),
        "syscall 包装器签名（参数统一 i64）")
    // 调用点：syscall 号 + 参数不足 6 个补 0（实参必须带 LLVM 类型）
    t.assertTrue(ir.contains("call i64 @aura_syscall_dispatch(i64 1, i64 %arg.0, i64 %arg.1, i64 %arg.2, i64 0, i64 0, i64 0)"),
        "SYS_WRITE(1) 分发调用")
    t.assertTrue(ir.contains("call i64 @aura_syscall_dispatch(i64 9, i64 %arg.0, i64 %arg.1, i64 %arg.2, i64 %arg.3, i64 %arg.4, i64 %arg.5)"),
        "SYS_MMAP(9) 分发调用")

    return t.report()
}

// ═════════════════════════════════════════════════════════════════
// 测试 2：native fun（内置）→ load/store 类型修正
// ═════════════════════════════════════════════════════════════════

fun nc2TestMemoryBuiltin(): Int {
    val t = TestRunner()
    t.begin("c2.memory")

    // 注意：函数名需含 "Memory"（与 Rust 侧 `emit_native_wrapper` 的
    // `func.name.contains("Memory")` 判定保持一致）。
    val src = "extern object Memory {\n" +
        "    native fun MemoryAlloc(n: Long): Long\n" +
        "    native fun MemoryFree(addr: Long): Void\n" +
        "    native fun MemoryRead(addr: Long): Byte\n" +
        "    native fun MemoryWrite(addr: Long, v: Byte): Void\n" +
        "}\n" +
        "fun main(): Int {\n" +
        "    val a: Long = MemoryAlloc(16)\n" +
        "    MemoryWrite(a, 7)\n" +
        "    val v: Byte = MemoryRead(a)\n" +
        "    MemoryFree(a)\n" +
        "    return 0\n" +
        "}\n"

    val ir: String = nc2EmitIr(src)
    t.assertTrue(ir.contains("call i64 @aura_memory_alloc(i64 %arg.0)"), "Memory.alloc → aura_memory_alloc")
    t.assertTrue(ir.contains("call void @aura_memory_free(i64 %arg.0)"), "Memory.free → aura_memory_free")
    // 读：地址 i64 → inttoptr → load i8（旧缺口：类型不匹配）
    t.assertTrue(ir.contains("inttoptr i64 %arg.0 to i8*"), "Memory.read 使用 inttoptr 转换地址")
    t.assertTrue(ir.contains("load i8, i8* %ptr.0"), "Memory.read 按 i8 载入")
    t.assertTrue(ir.contains("store i8 %arg.1, i8* %ptr.0"), "Memory.write 按 i8 存储")
    // 调用点返回类型按声明（Byte → i8），不能回退 i32
    t.assertTrue(ir.contains("define i8 @MemoryRead(i64 %arg.0)"), "MemoryRead 返回 i8")

    return t.report()
}

// ═════════════════════════════════════════════════════════════════
// 测试 3：@native(asm) → C 封装 / 通用内联汇编
// ═════════════════════════════════════════════════════════════════

fun nc2TestInlineAsm(): Int {
    val t = TestRunner()
    t.begin("c2.asm")

    val src = "extern object Cpu {\n" +
        "    @native(asm = \"rdtsc\")  fun rdtsc(): Long\n" +
        "    @native(asm = \"mfence\") fun memFence(): Void\n" +
        "    @native(asm = \"cpuid\")  fun cpuid(): Long\n" +
        "}\n" +
        "fun main(): Int {\n    return 0\n}\n"

    val ir: String = nc2EmitIr(src)
    // 已知指令走 C 封装（与 Rust 后端产物一致）
    t.assertTrue(ir.contains("call i64 @aura_cpu_rdtsc()"), "rdtsc → aura_cpu_rdtsc")
    t.assertTrue(ir.contains("call void @aura_cpu_mem_fence()"), "mfence → aura_cpu_mem_fence")
    // 通用指令走 LLVM inline asm（缺口 1 的泛化路径）
    t.assertTrue(ir.contains("asm sideeffect"), "通用 asm 使用 LLVM inline asm")
    t.assertTrue(ir.contains("cpuid"), "inline asm 保留 asm 代码串")
    // x86 目标按 Intel 语法解析（仓库自带 FFI 片段即 Intel 写法）
    t.assertTrue(ir.contains(".intel_syntax noprefix"), "x86 内联汇编按 Intel 语法")
    // LLVM asm-call 必须带参数表 `()`，输出约束与返回值个数一致
    t.assertTrue(ir.contains("\"=r\"()"), "asm-call 带空参数表与 =r 约束")

    return t.report()
}

// ═════════════════════════════════════════════════════════════════
// 测试 4：export / @aot
// ═════════════════════════════════════════════════════════════════

fun nc2TestExportAndAot(): Int {
    val t = TestRunner()
    t.begin("c2.export")

    val src = "export fun auraAdd(a: Long, b: Long): Long {\n" +
        "    return a + b\n" +
        "}\n" +
        "extern object AuraLib {\n" +
        "    @aot fun auraLibHelper(x: Long): Long\n" +
        "}\n" +
        "fun main(): Int {\n    return 0\n}\n"

    val hir: Hir = nc2SourceToHir(src)
    t.assertTrue(nc2HirHasKind(hir, "HirAotDecl"), "HIR 降级出 HirAotDecl")

    val ir: String = nc2EmitIr(src)
    // export → 普通 define（符号默认外部可见，可被 C 侧解析）
    t.assertTrue(ir.contains("define i64 @auraAdd(i64 %arg.a, i64 %arg.b)"),
        "export fun 发射为 define")
    // @aot → 外部 declare
    t.assertTrue(ir.contains("declare i64 @auraLibHelper(i64)"), "@aot fun 发射为 declare")

    return t.report()
}

// ═════════════════════════════════════════════════════════════════
// 入口
// ═════════════════════════════════════════════════════════════════

fun main(): Int {
    println("=== Phase C.2 (Aura 侧) FFI 发射测试 ===")

    var failures: Int = 0
    failures = failures + nc2TestSyscall()
    failures = failures + nc2TestMemoryBuiltin()
    failures = failures + nc2TestInlineAsm()
    failures = failures + nc2TestExportAndAot()

    println("")
    if (failures == 0) {
        println("RESULT: PASS")
    } else {
        println("RESULT: FAIL (" + toStr(failures) + " failed)")
    }
    return failures
}
