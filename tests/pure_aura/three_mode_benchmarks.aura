// tests/pure_aura/three_mode_benchmarks.aura
// ─────────────────────────────────────────────────────────────
// P5: 性能基准测试套件
//
// 提供 10+ 性能基准用例，用于 VM + JIT + AOT 三种执行模式的对比。
// 对应分阶段开发计划 P5 阶段。
//
// 运行：aura run tests/pure_aura/three_mode_benchmarks.aura
//       aura run tests/pure_aura/three_mode_benchmarks.aura --jit
//       aura build tests/pure_aura/three_mode_benchmarks.aura --aot
// ─────────────────────────────────────────────────────────────

import "../..//aura/compiler/aura/lang/compiler/test/TestRunner.aura"

fun main() {
    val t = TestRunner()

    println("=== P5: Three-Mode Performance Benchmarks ===")
    println("Date: 2026-09-13")
    println("Framework: Aura Compiler 0.1.0-phase10")
    println("")

    // ─── 1. Fibonacci ───
    t.begin("Benchmark 1: Fibonacci")

    // 预热
    for (var i: Int = 0; i < 50; i = i + 1) {
        fib(15)
    }

    val fib10Time: Int = benchmarkFn({ fib(10) }, 10000)
    println("  fib(10) x10000: ${fib10Time} us")

    val fib15Time: Int = benchmarkFn({ fib(15) }, 5000)
    println("  fib(15) x5000: ${fib15Time} us")

    val fib20Time: Int = benchmarkFn({ fib(20) }, 1000)
    println("  fib(20) x1000: ${fib20Time} us")

    t.report()

    // ─── 2. 阶乘 ───
    t.begin("Benchmark 2: Factorial")

    // 预热
    for (var i: Int = 0; i < 50; i = i + 1) {
        factorial(15)
    }

    val fact5Time: Int = benchmarkFn({ factorial(5) }, 10000)
    println("  factorial(5) x10000: ${fact5Time} us")

    val fact10Time: Int = benchmarkFn({ factorial(10) }, 5000)
    println("  factorial(10) x5000: ${fact10Time} us")

    val fact15Time: Int = benchmarkFn({ factorial(15) }, 1000)
    println("  factorial(15) x1000: ${fact15Time} us")

    t.report()

    // ─── 3. 循环求和 ───
    t.begin("Benchmark 3: Loop Sum")

    // 预热
    for (var i: Int = 0; i < 50; i = i + 1) {
        loopSum(100)
    }

    val sum100Time: Int = benchmarkFn({ loopSum(100) }, 10000)
    println("  loopSum(100) x10000: ${sum100Time} us")

    val sum1000Time: Int = benchmarkFn({ loopSum(1000) }, 5000)
    println("  loopSum(1000) x5000: ${sum1000Time} us")

    val sum10000Time: Int = benchmarkFn({ loopSum(10000) }, 1000)
    println("  loopSum(10000) x1000: ${sum10000Time} us")

    t.report()

    // ─── 4. 矩阵乘法 (50x50) ───
    t.begin("Benchmark 4: Matrix Multiplication (50x50)")

    // 预热
    for (var i: Int = 0; i < 10; i = i + 1) {
        matmul(20)
    }

    val mat20Time: Int = benchmarkFn({ matmul(20) }, 1000)
    println("  matmul(20x20) x1000: ${mat20Time} us")

    val mat30Time: Int = benchmarkFn({ matmul(30) }, 500)
    println("  matmul(30x30) x500: ${mat30Time} us")

    t.report()

    // ─── 5. 字符串拼接 ───
    t.begin("Benchmark 5: String Concatenation")

    val concat50Time: Int = benchmarkFn({ stringConcat(50) }, 5000)
    println("  stringConcat(50) x5000: ${concat50Time} us")

    val concat100Time: Int = benchmarkFn({ stringConcat(100) }, 2000)
    println("  stringConcat(100) x2000: ${concat100Time} us")

    t.report()

    // ─── 6. 数组填充 ───
    t.begin("Benchmark 6: Array Fill")

    val fillArrTime: Int = benchmarkFn({ fillArray(1000) }, 2000)
    println("  fillArray(1000) x2000: ${fillArrTime} us")

    val fillArrBigTime: Int = benchmarkFn({ fillArray(5000) }, 500)
    println("  fillArray(5000) x500: ${fillArrBigTime} us")

    t.report()

    // ─── 7. 条件分类 ───
    t.begin("Benchmark 7: Conditional Classification")

    val classifyTime: Int = benchmarkFn({ classify(1000) }, 5000)
    println("  classify(1000) x5000: ${classifyTime} us")

    t.report()

    // ─── 8. 数学运算组合 ───
    t.begin("Benchmark 8: Math Operations")

    val mathTime: Int = benchmarkFn({ mathOps(1000) }, 5000)
    println("  mathOps(1000) x5000: ${mathTime} us")

    t.report()

    // ─── 9. 深度递归 ───
    t.begin("Benchmark 9: Deep Recursion")

    val recCountTime: Int = benchmarkFn({ deepRecursion(1000) }, 1000)
    println("  deepRecursion(1000) x1000: ${recCountTime} us")

    val recCount2000Time: Int = benchmarkFn({ deepRecursion(2000) }, 500)
    println("  deepRecursion(2000) x500: ${recCount2000Time} us")

    t.report()

    // ─── 10. 热点循环 ───
    t.begin("Benchmark 10: Hot Loop")

    val hotLoopTime: Int = benchmarkFn({ hotLoop(10000) }, 1000)
    println("  hotLoop(10000) x1000: ${hotLoopTime} us")

    val hotLoopBigTime: Int = benchmarkFn({ hotLoop(50000) }, 500)
    println("  hotLoop(50000) x500: ${hotLoopBigTime} us")

    t.report()

    // ─── 11. 素数筛选 ───
    t.begin("Benchmark 11: Prime Sieve")

    val primeTime: Int = benchmarkFn({ isPrime(999999) }, 100)
    println("  isPrime(999999) x100: ${primeTime} us")

    val primesCountTime: Int = benchmarkFn({ countPrimes(10000) }, 100)
    println("  countPrimes(10000) x100: ${primesCountTime} us")

    t.report()

    // ─── 12. 字符串搜索 ───
    t.begin("Benchmark 12: String Search")

    val searchTime: Int = benchmarkFn({ searchInText() }, 1000)
    println("  searchInText x1000: ${searchTime} us")

    t.report()

    // ─── 汇总 ───
    t.begin("Summary")

    println("=== Benchmark Summary ===")
    println("Total Benchmarks: 12")
    println("")
    println("Execution Modes:")
    println("  VM:  aura run tests/pure_aura/three_mode_benchmarks.aura")
    println("  JIT: aura run tests/pure_aura/three_mode_benchmarks.aura --jit")
    println("  AOT: aura build tests/pure_aura/three_mode_benchmarks.aura --aot")
    println("")
    println("Expected JIT speedup (vs VM):")
    println("  fib(20): 2-5x")
    println("  factorial(15): 2-5x")
    println("  loopSum(1000): 1.5-3x")
    println("  matmul: 2-4x")
    println("  stringConcat: 1.2-2x")
    println("  fillArray: 1.5-3x")
    println("  classify: 1.3-2x")
    println("  mathOps: 1.5-3x")
    println("  deepRecursion: 1.5-3x")
    println("  hotLoop: 2-5x")
    println("")

    t.finalReport()
}

// ═══════════════════════════════════════════════════════════════
// 基准测试工具函数
// ═══════════════════════════════════════════════════════════════

/// 基准测试：执行 fn 指定次数，返回总时间（微秒）
fun benchmarkFn(fn: () -> Int, iterations: Int): Int {
    val start: Int = System.nanoTime()

    // 执行基准
    for (var i: Int = 0; i < iterations; i = i + 1) {
        fn()
    }

    val end: Int = System.nanoTime()

    // 转换为微秒
    return (end - start) / 1000
}

// ═══════════════════════════════════════════════════════════════
// 基准测试函数实现
// ═══════════════════════════════════════════════════════════════

/// Fibonacci 递归。
fun fib(n: Int): Int {
    if (n <= 0) {
        return 0
    }
    if (n == 1) {
        return 1
    }
    return fib(n - 1) + fib(n - 2)
}

/// 阶乘。
fun factorial(n: Int): Int {
    if (n <= 1) {
        return 1
    }
    return n * factorial(n - 1)
}

/// 循环求和 1..n。
fun loopSum(n: Int): Int {
    var sum: Int = 0
    for (var i: Int = 1; i <= n; i = i + 1) {
        sum = sum + i
    }
    return sum
}

/// 矩阵乘法（n x n）。
fun matmul(n: Int): Int {
    // 创建两个 n x n 矩阵（用 flat array 表示）
    var a: List<Int> = List()
    var b: List<Int> = List()
    var c: List<Int> = List()

    for (var i: Int = 0; i < n * n; i = i + 1) {
        a.add(i + 1)
        b.add((i * 7 + 3) % n + 1)
        c.add(0)
    }

    // 矩阵乘法
    for (var i: Int = 0; i < n; i = i + 1) {
        for (var j: Int = 0; j < n; j = j + 1) {
            var sum: Int = 0
            for (var k: Int = 0; k < n; k = k + 1) {
                sum = sum + a.get(i * n + k) * b.get(k * n + j)
            }
            c.set(i * n + j, sum)
        }
    }

    // 返回 c 的所有元素之和（用于防止优化掉）
    var total: Int = 0
    for (var i: Int = 0; i < c.length; i = i + 1) {
        total = total + c.get(i)
    }
    return total
}

/// 字符串拼接。
fun stringConcat(count: Int): Int {
    var s: String = ""
    for (var i: Int = 0; i < count; i = i + 1) {
        s = s + "Hello" + i + " "
    }
    return s.length
}

/// 数组填充。
fun fillArray(size: Int): Int {
    var arr: List<Int> = List()
    for (var i: Int = 0; i < size; i = i + 1) {
        arr.add(i)
    }
    // 验证（防止优化掉）
    var sum: Int = 0
    for (var j: Int = 0; j < arr.length; j = j + 1) {
        sum = sum + arr.get(j)
    }
    return sum
}

/// 条件分类。
fun classify(count: Int): Int {
    var evenCount: Int = 0
    var oddCount: Int = 0
    var multipleOf3: Int = 0
    for (var i: Int = 0; i < count; i = i + 1) {
        if (i % 2 == 0) {
            evenCount = evenCount + 1
        } else {
            oddCount = oddCount + 1
        }
        if (i % 3 == 0) {
            multipleOf3 = multipleOf3 + 1
        }
    }
    return evenCount * 1000 + oddCount * 10 + multipleOf3
}

/// 数学运算组合。
fun mathOps(count: Int): Int {
    var sum: Int = 0
    for (var i: Int = 1; i <= count; i = i + 1) {
        var x: Int = i
        x = x * 2          // 乘法
        x = x + 10        // 加法
        x = x - 5         // 减法
        x = x / 3         // 除法
        x = x % 7         // 取模
        x = x << 2        // 左移
        x = x >> 1        // 右移
        x = x & 0xFF      // 按位与
        x = x | 0x80      // 按位或
        x = x ^ 0x10      // 按位异或
        sum = sum + x
    }
    return sum
}

/// 深度递归计数。
fun deepRecursion(n: Int): Int {
    if (n == 0) {
        return 1
    }
    return deepRecursion(n - 1) + 1
}

/// 热点循环。
fun hotLoop(count: Int): Int {
    var sum: Int = 0
    for (var i: Int = 0; i < count; i = i + 1) {
        sum = sum + i
        if (i % 1000 == 0) {
            sum = sum + 1
        }
    }
    return sum
}

/// 素数判断。
fun isPrime(n: Int): Int {
    if (n < 2) {
        return 0
    }
    for (var i: Int = 2; i * i <= n; i = i + 1) {
        if (n % i == 0) {
            return 0
        }
    }
    return 1
}

/// 计算范围内素数个数。
fun countPrimes(limit: Int): Int {
    var count: Int = 0
    for (var i: Int = 2; i < limit; i = i + 1) {
        count = count + isPrime(i)
    }
    return count
}

/// 字符串搜索。
fun searchInText(): Int {
    val text: String = "The quick brown fox jumps over the lazy dog. "
        + "The dog barks loudly. The fox runs quickly. "
        + "The quick fox is smarter than the slow dog. "
        + "Brown foxes and lazy dogs live together. "
        + "The quick brown fox is the fastest animal in the forest."

    var count: Int = 0
    var i: Int = 0
    while (i < text.length) {
        if (text.substring(i, i + 3) == "fox") {
            count = count + 1
        }
        i = i + 1
    }
    return count
}
