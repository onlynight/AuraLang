// Phase 3 verification: extern "C" { } syntax compiles and links

extern "C" {
    fun strlen(s: Pointer<Byte>): Int
    fun memcpy(dst: Pointer<Byte>, src: Pointer<Byte>, n: Int): Pointer<Byte>
    fun printf(format: Pointer<Byte>): Int
    fun atoi(s: Pointer<Byte>): Int
    fun atof(s: Pointer<Byte>): Double
}

fun main(): Int {
    val msg: String = "hello"
    val len: Int = strlen(msg)
    if (len != 5) {
        return 1
    }
    return 0
}
