// Phase 0 verification: @native(N) generates inline syscall IR
//
// This test verifies:
// 1. @native(39) (SYS_GETPID) generates inline syscall, not @aura_syscall_dispatch
// 2. The generated LLVM IR contains "syscall" instruction
// 3. The generated LLVM IR does NOT contain "@aura_syscall_dispatch"
//
// Run: aura build tests/pure_aura/test_syscall_ir.aura --llvm-home "D:\DevTools\LLVM\clang+llvm-23.1.0-x86_64-pc-windows-msvc"

extern object TestSys {
    @native(39) fun getPid(): Int
    @native(1) fun write(fd: Int, buf: Long, count: Long): Long
}

fun main(): Int {
    // Test: getpid syscall (SYS_GETPID = 39)
    // Expected IR: movq $39, %rax; syscall
    val pid: Int = TestSys.getPid()
    return 0
}
