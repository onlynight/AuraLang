// ═════════════════════════════════════════════════════════════════
// Phase C.2 测试：@native(asm) 内联汇编泛化发射
//
// 对应改造方案 C.2「Rust @native 发射器三缺口」之缺口 1。
// 验证点：
//   - @native(asm="rdtsc")  → 已知指令走 C 封装（aura_cpu_rdtsc）
//   - @native(asm="mfence") → 已知指令走 C 封装（aura_cpu_mem_fence）
//   - @native(asm="cpuid")  → 通用内联汇编走 LLVM inline asm
//
// 运行：cargo test -p compiler --test native_c2_tests -- --nocapture
//       或独立验证：
//         aura build tests/pure_aura/native_c2_asm.aura --aot -o /tmp/asm_test
//         /tmp/asm_test
// ═════════════════════════════════════════════════════════════════

// ── 已知指令：走 C 封装路径 ──
@native(asm = "rdtsc")
fun rdtsc(): Long { }

@native(asm = "mfence")
fun memFence(): Void { }

// ── 通用内联汇编：走 LLVM inline asm 路径 ──
@native(asm = "cpuid")
fun cpuid(): Long { }

// ── 带参数的内联汇编 ──
@native(asm = "mov eax, 42")
fun movEax(): Long { }

fun main(): Int {
    // 测试 1: rdtsc 返回非负值
    val t1: Long = rdtsc()
    println("rdtsc1=" + toStr(t1))
    val t2: Long = rdtsc()
    println("rdtsc2=" + toStr(t2))
    if (t2 >= t1) {
        println("rdtsc_monotonic=yes")
    } else {
        println("rdtsc_monotonic=no")
    }

    // 测试 2: memFence 不崩溃
    memFence()
    println("fence=ok")

    // 测试 3: cpuid 返回非负值
    val cpu: Long = cpuid()
    println("cpuid=" + toStr(cpu))

    // 测试 4: movEax 返回非负值
    val eax: Long = movEax()
    println("movEax=" + toStr(eax))

    println("RESULT: PASS")
    return 0
}
