// ═════════════════════════════════════════════════════════════════
// C 风格 for 循环 · AOT 流程测试（端到端：源码 → HIR → IR → llc → clang → exe → 运行）
//
// 覆盖 `for (init; cond; incr) body` 的降级正确性：
//   * 步进是**赋值**（`i = i + 1` / `i += 1`）——必须回写循环变量
//   * 循环体多语句 / 嵌套 C 风格 for
//
// 历史背景（本用例锁定的缺陷）：
//   Rust 侧 `desugar_cfor` 把步进包成 `HirStmt::Expr(desugar_expr(inc))`，
//   而 `desugar_expr(Expr::Assign)` **只求值不回写** → 循环变量永不变 →
//   编译产物死循环（CPU 0%、内存不增长，进程卡死）。
//
// 运行：aura run tests/pure_aura/cfor_aot_tests.aura
//   需要本机 LLVM（见 Aot.aura::llvmHomeDefault）。
// ═════════════════════════════════════════════════════════════════

import aura.lang.std.String

import "../../aura/compiler/aura/lang/compiler/test/TestRunner.aura"

import "../../aura/compiler/aura/lang/compiler/lexer/Span.aura"
import "../../aura/compiler/aura/lang/compiler/lexer/Token.aura"
import "../../aura/compiler/aura/lang/compiler/lexer/Lexer.aura"
import "../../aura/compiler/aura/lang/compiler/ast/Ast.aura"
import "../../aura/compiler/aura/lang/compiler/errors/CompileError.aura"
import "../../aura/compiler/aura/lang/compiler/parser/Parser.aura"

import "../../aura/compiler/aura/lang/compiler/hir/Hir.aura"
import "../../aura/compiler/aura/lang/compiler/hir/Desugar.aura"
import "../../aura/compiler/aura/lang/compiler/hir/Mono.aura"
import "../../aura/compiler/aura/lang/compiler/hir/Inline.aura"
import "../../aura/compiler/aura/lang/compiler/hir/Fold.aura"

import "../../aura/compiler/aura/lang/compiler/aot/TypeMapper.aura"
import "../../aura/compiler/aura/lang/compiler/aot/AotUtil.aura"
import "../../aura/compiler/aura/lang/compiler/aot/Runtime.aura"
import "../../aura/compiler/aura/lang/compiler/aot/StdSigs.aura"
import "../../aura/compiler/aura/lang/compiler/aot/Ffi.aura"
import "../../aura/compiler/aura/lang/compiler/aot/Target.aura"
import "../../aura/compiler/aura/lang/compiler/aot/Optimize.aura"
import "../../aura/compiler/aura/lang/compiler/aot/EmitBuffer.aura"
import "../../aura/compiler/aura/lang/compiler/aot/Emit.aura"
import "../../aura/compiler/aura/lang/compiler/aot/Linker.aura"
import "../../aura/compiler/aura/lang/compiler/aot/CBackend.aura"
import "../../aura/compiler/aura/lang/compiler/aot/Dwarf.aura"
import "../../aura/compiler/aura/lang/compiler/aot/Aot.aura"

/// 源码 → HIR（Aura 侧 AOT 前半段）。
fun cfaSourceToHir(source: String): Hir {
    val p = Parser(source)
    p.parseProgram()
    val hl = HirLowerer()
    hl.lower(p.ast)
    return hl.hir
}

/// 源码 → 原生 exe 并运行，返回退出码（编译失败返回 -999）。
fun cfaBuildRun(name: String, source: String): Int {
    val r: AotExeResult = aotBuildExeFromHir(cfaSourceToHir(source), name,
        "build/pure_aura", llvmHomeDefault())
    if (!r.ok) {
        println("  [build failed] " + name + " llc=" + toStr(r.llcExit)
            + " clang=" + toStr(r.clangExit))
        if (r.irError != "") {
            println("  IR error: " + r.irError)
        }
        return -999
    }
    return runBuiltExe(r.exePath)
}

// ═════════════════════════════════════════════════════════════════
// 用例：C 风格 for 的步进回写 / 嵌套 / 多语句
// ═════════════════════════════════════════════════════════════════

fun testCFor(): Int {
    val t = TestRunner()
    t.begin("cfor")

    // 1) 基本：`i = i + 1` 步进必须回写（否则死循环）
    val basic = "fun main(): Int {\n" +
        "    var s: Int = 0\n" +
        "    for (var i: Int = 0; i < 5; i = i + 1) { s = s + i }\n" +
        "    return s - 10\n" +
        "}\n"
    t.assertEq(cfaBuildRun("cfa_basic", basic), 0, "C-for writes back increment (sum 0..4)")

    // 2) 复合赋值步进 `i += 1` + 体内复合赋值
    val compound = "fun main(): Int {\n" +
        "    var s: Int = 0\n" +
        "    for (var i: Int = 0; i < 4; i += 1) { s += 2 }\n" +
        "    return s - 8\n" +
        "}\n"
    t.assertEq(cfaBuildRun("cfa_compound", compound), 0, "compound-assign increment")

    // 3) 嵌套 C 风格 for
    val nested = "fun main(): Int {\n" +
        "    var s: Int = 0\n" +
        "    for (var i: Int = 0; i < 3; i = i + 1) {\n" +
        "        for (var j: Int = 0; j < 2; j = j + 1) { s = s + 1 }\n" +
        "    }\n" +
        "    return s - 6\n" +
        "}\n"
    t.assertEq(cfaBuildRun("cfa_nested", nested), 0, "nested C-for")

    // 4) 循环体多语句（`;` 分隔，与循环外变量协同）
    val multi = "fun main(): Int {\n" +
        "    var s: Int = 0\n" +
        "    var t: Int = 0\n" +
        "    for (var i: Int = 0; i < 4; i = i + 1) { s = s + i; t = t + 1 }\n" +
        "    return (s - 6) + (t - 4)\n" +
        "}\n"
    t.assertEq(cfaBuildRun("cfa_multi", multi), 0, "multi-statement body")

    return t.report()
}

fun main() {
    var failures: Int = 0
    failures = failures + testCFor()

    println("")
    println("=== Summary ===")
    println("Total failures: " + toStr(failures))
    if (failures == 0) {
        println("RESULT: PASS")
    } else {
        println("RESULT: FAIL")
    }
}
