// ═════════════════════════════════════════════════════════════════
// Phase C.2 测试：@native Memory builtin load/store 类型修正
//
// 对应改造方案 C.2「Rust @native 发射器三缺口」之缺口 2。
// 验证点：
//   - Memory.alloc(n)   → call i64 @aura_memory_alloc(i64)
//   - Memory.free(addr) → call void @aura_memory_free(i64)
//   - Memory.read(addr) → inttoptr + load i8, i8* %ptr
//   - Memory.write(addr, v) → inttoptr + store i8 %v, i8* %ptr
//
// 运行：cargo test -p compiler --test native_c2_tests -- --nocapture
//       或独立验证：
//         aura build tests/pure_aura/native_c2_memory.aura --aot -o /tmp/mem_test
//         /tmp/mem_test
// ═════════════════════════════════════════════════════════════════

// 函数名包含 "Memory" 以匹配内置分派逻辑
@native fun MemoryAlloc(n: Long): Long { }
@native fun MemoryFree(addr: Long): Void { }
@native fun MemoryRead(addr: Long): Byte { }
@native fun MemoryWrite(addr: Long, value: Byte): Void { }

fun main(): Int {
    // 测试 1: alloc 返回非零地址（Linux）或非负值（Windows）
    val addr: Long = MemoryAlloc(64)
    println("alloc=" + toStr(addr))

    // 测试 2: write 不崩溃
    MemoryWrite(addr, 42)
    println("write=ok")

    // 测试 3: read 返回值
    val v: Byte = MemoryRead(addr)
    println("read=" + toStr(v))

    // 测试 4: free 不崩溃
    MemoryFree(addr)
    println("free=ok")

    // 测试 5: 多字节读写
    val addr2: Long = MemoryAlloc(16)
    println("alloc2=" + toStr(addr2))
    MemoryWrite(addr2, 100)
    MemoryWrite(addr2 + 1, 200)
    val v2: Byte = MemoryRead(addr2)
    val v3: Byte = MemoryRead(addr2 + 1)
    println("read2=" + toStr(v2) + "," + toStr(v3))
    MemoryFree(addr2)
    println("free2=ok")

    println("RESULT: PASS")
    return 0
}
