// tests/pure_aura/jit_p2_ffi_tests.aura
// ─────────────────────────────────────────────────────────────
// P2: JIT FFI 边界端到端测试
//
// 验证 jit_ffi.rs 的三个 FFI 函数（compile/load/call）
// 以及 VmJitBridge.aura 的 VM 集成。
//
// 运行：aura run tests/pure_aura/jit_p2_ffi_tests.aura
// ─────────────────────────────────────────────────────────────

import "../..//aura/compiler/aura/lang/compiler/test/TestRunner.aura"
import "../..//aura/compiler/aura/lang/compiler/vm/VmJitBridge.aura"

// ── FFI 声明 ─────────────────────────────────────────────────

@native fun jit_compile(clif_text: String): String

@native fun jit_load(blob_b64: String): String

@native fun jit_call(entry_token: String, args: String, out_slot: Int): String

fun main() {
    val t = TestRunner()

    // ─── 1. FFI 边界基本功能 ───
    t.begin("JIT FFI 边界基本功能")

    // 1.1 jit_compile 返回空串（非 JIT 特性时）
    //     当 --features jit 未启用时，jit_compile 返回空串
    val compile_result: String = jit_compile(";; empty")
    // 注意：在测试环境中，JIT 特性可能未启用
    // 所以这里只验证函数可调用，不验证具体返回值
    t.assertTrue(compile_result == "" || compile_result.length > 0, 
                 "jit_compile callable (returns empty or blob)")

    // 1.2 jit_load 返回空串（无效输入）
    val load_result: String = jit_load("")
    t.assertEq(load_result, "", "jit_load empty input returns empty")

    // 1.3 jit_load 返回空串（无效 base64）
    val load_result2: String = jit_load("invalid_base64!!!")
    t.assertEq(load_result2, "", "jit_load invalid base64 returns empty")

    // 1.4 jit_call 返回空串（无效 entry_token）
    val call_result: String = jit_call("invalid_token", "", 0)
    t.assertEq(call_result, "", "jit_call invalid token returns empty")

    t.report()

    // ─── 2. VmJitBridge 状态管理 ───
    t.begin("VmJitBridge 状态管理")

    val bridge = VmJitBridge()

    // 2.1 初始状态
    t.assertEq(bridge.compileCount, 0, "initial compileCount = 0")
    t.assertEq(bridge.nativeCallCount, 0, "initial nativeCallCount = 0")
    t.assertEq(bridge.deoptCount, 0, "initial deoptCount = 0")
    t.assertEq(bridge.fallbackCount, 0, "initial fallbackCount = 0")

    // 2.2 注册函数
    bridge.registerFunction(1, "test_code_1", "params_1")
    bridge.registerFunction(2, "test_code_2", "params_2")

    // 2.3 调用计数
    t.assertEq(bridge.incrementCallCount(1), 1, "call count 1")
    t.assertEq(bridge.incrementCallCount(1), 2, "call count 2")
    t.assertEq(bridge.incrementCallCount(2), 1, "call count 2 (func 2)")

    // 2.4 热点检测（默认阈值 10000）
    t.assertFalse(bridge.shouldCompile(1), "not hot at count 2")
    
    // 模拟达到阈值
    var i: Int = 0
    while (i < 10000) {
        bridge.incrementCallCount(1)
        i = i + 1
    }
    t.assertTrue(bridge.shouldCompile(1), "hot at count 10001")

    t.report()

    // ─── 3. 派发决策 ───
    t.begin("派发决策")

    val bridge2 = VmJitBridge()
    bridge2.registerFunction(1, "test_code", "params")

    // 3.1 未达阈值 → defer
    val decision1: String = checkCall(bridge2, 1, "0|42")
    t.assertEq(decision1, "defer", "not hot → defer")

    // 3.2 模拟已跳过 → skip
    bridge2.state.skip(2, "test skip")
    val decision2: String = checkCall(bridge2, 2, "0|42")
    t.assertEq(decision2, "skip", "skipped → skip")

    // 3.3 模拟已编译 → native
    bridge2.state.insert(3)
    val decision3: String = checkCall(bridge2, 3, "0|42")
    t.assertEq(decision3, "native", "compiled → native")

    t.report()

    // ─── 4. VM 调用钩子 ───
    t.begin("VM 调用钩子")

    val bridge3 = VmJitBridge()
    bridge3.registerFunction(1, "test_code", "params")

    // 4.1 未达阈值 → defer
    val hook_result1: String = vmCallHook(bridge3, 1, "0|42")
    t.assertEq(hook_result1, "defer", "vmCallHook not hot → defer")

    // 4.2 已跳过 → skip
    bridge3.state.skip(2, "test skip")
    val hook_result2: String = vmCallHook(bridge3, 2, "0|42")
    t.assertEq(hook_result2, "skip", "vmCallHook skipped → skip")

    t.report()

    // ─── 5. JIT 统计 ───
    t.begin("JIT 统计")

    val bridge4 = VmJitBridge()
    bridge4.registerFunction(1, "test_code", "params")

    // 5.1 初始统计
    val stats1: String = jitStats(bridge4)
    t.assertTrue(stats1.contains("compiled: 0"), "stats shows 0 compiled")

    // 5.2 模拟编译
    bridge4.compileCount = 5
    bridge4.nativeCallCount = 100
    bridge4.deoptCount = 2
    bridge4.fallbackCount = 3

    val stats2: String = jitStats(bridge4)
    t.assertTrue(stats2.contains("compiled: 5"), "stats shows 5 compiled")
    t.assertTrue(stats2.contains("native_calls: 100"), "stats shows 100 native_calls")
    t.assertTrue(stats2.contains("deopt: 2"), "stats shows 2 deopt")
    t.assertTrue(stats2.contains("fallback: 3"), "stats shows 3 fallback")

    // 5.3 重置统计
    resetStats(bridge4)
    t.assertEq(bridge4.compileCount, 0, "reset compileCount = 0")
    t.assertEq(bridge4.nativeCallCount, 0, "reset nativeCallCount = 0")

    t.report()

    // ─── 汇总 ───
    t.finalReport()
}
