// Phase E.1: AuraCli.aura 单元测试
//
// 验证 Args 类、命令分派、标志解析等核心功能。
// 运行：aura run tests/pure_aura/phase_e_cli_tests.aura

import aura.lang.std.String
import aura.lang.std.IO
import aura.lang.std.Collections
import aura.lang.std.Assert
import aura.lang.std.Test

// ── Args 类测试 ──

// 测试 Args 基本操作
fun testArgsBasic(): Int {
    val args = Args()
    args.add("build")
    args.add("--output")
    args.add("out.exe")

    Assert.assert(args.size() == 3, "Args size should be 3")
    Assert.assert(args.get(0) == "build", "First arg should be 'build'")
    Assert.assert(args.get(1) == "--output", "Second arg should be '--output'")
    Assert.assert(args.get(2) == "out.exe", "Third arg should be 'out.exe'")
    return 0
}

// 测试 hasFlag
fun testArgsHasFlag(): Int {
    val args = Args()
    args.add("build")
    args.add("--aot")
    args.add("--output")
    args.add("out.exe")

    Assert.assert(args.hasFlag("--aot"), "Should have --aot flag")
    Assert.assert(args.hasFlag("--output"), "Should have --output flag")
    Assert.assert(!args.hasFlag("--lib"), "Should not have --lib flag")
    return 0
}

// 测试 getValue
fun testArgsGetValue(): Int {
    val args = Args()
    args.add("build")
    args.add("--output")
    args.add("out.exe")

    Assert.assert(args.getValue("--output") == "out.exe", "getValue should return 'out.exe'")
    Assert.assert(args.getValue("--nonexistent") == "", "getValue should return '' for missing flag")
    return 0
}

// 测试 isEmpty
fun testArgsIsEmpty(): Int {
    val empty = Args()
    Assert.assert(empty.isEmpty(), "Empty Args should be empty")

    val nonEmpty = Args()
    nonEmpty.add("test")
    Assert.assert(!nonEmpty.isEmpty(), "Non-empty Args should not be empty")
    return 0
}

// ── 命令分派测试 ──

// 测试 printUsage 输出
fun testPrintUsage(): Int {
    // printUsage 应输出帮助信息
    printUsage()
    return 0
}

// 测试子命令参数构建
fun testSubArgsConstruction(): Int {
    // 模拟 main 中的子命令参数构建逻辑
    val args = Args()
    args.add("build")
    args.add("--output")
    args.add("out.exe")

    val subArgs = Args()
    var i: Int = 1
    while (i < args.size) {
        subArgs.add(args.get(i))
        i = i + 1
    }

    Assert.assert(subArgs.size == 2, "SubArgs should have 2 items")
    Assert.assert(subArgs.get(0) == "--output", "First sub-arg should be '--output'")
    Assert.assert(subArgs.get(1) == "out.exe", "Second sub-arg should be 'out.exe'")
    return 0
}

// ── 命令处理函数测试 ──

// 测试 cmdBuild 错误处理（无参数）
fun testCmdBuildNoArgs(): Int {
    val args = Args()
    val result = cmdBuild(args)
    Assert.assert(result == 1, "cmdBuild with no args should return 1")
    return 0
}

// 测试 cmdRun 错误处理（无参数）
fun testCmdRunNoArgs(): Int {
