// ── 主测试函数 ──

fun main(): Int {
    println("=== Phase E.1: AuraCli Unit Tests ===")

    var testsRun: Int = 0
    var testsPassed: Int = 0

    // Args 测试
    println("Running Args tests...")
    if (testArgsBasic() == 0) { testsPassed = testsPassed + 1 }
    testsRun = testsRun + 1

    if (testArgsHasFlag() == 0) { testsPassed = testsPassed + 1 }
    testsRun = testsRun + 1

    if (testArgsGetValue() == 0) { testsPassed = testsPassed + 1 }
    testsRun = testsRun + 1

    if (testArgsIsEmpty() == 0) { testsPassed = testsPassed + 1 }
    testsRun = testsRun + 1

    // 命令分派测试
    println("Running command dispatch tests...")
    if (testSubArgsConstruction() == 0) { testsPassed = testsPassed + 1 }
    testsRun = testsRun + 1

    // 错误处理测试
    println("Running error handling tests...")
    if (testCmdBuildNoArgs() == 0) { testsPassed = testsPassed + 1 }
    testsRun = testsRun + 1

    if (testCmdRunNoArgs() == 0) { testsPassed = testsPassed + 1 }
    testsRun = testsRun + 1

    if (testCmdCheckNoArgs() == 0) { testsPassed = testsPassed + 1 }
    testsRun = testsRun + 1

    if (testCmdDisasmNoArgs() == 0) { testsPassed = testsPassed + 1 }
    testsRun = testsRun + 1

    if (testCmdDebugNoArgs() == 0) { testsPassed = testsPassed + 1 }
    testsRun = testsRun + 1

    // 汇总
    println("")
    println("=== Results: $testsPassed / $testsRun passed ===")
    if (testsPassed == testsRun) {
        println("ALL TESTS PASSED")
        return 0
    } else {
        println("SOME TESTS FAILED")
        return 1
    }
}