// 测试 cmdLsp 入口
fun testCmdLsp(): Int {
    val args = Args()
    // cmdLsp 应启动 LSP 服务器（这里不实际启动，只验证不崩溃）
    // 注：实际调用会阻塞，所以只验证函数存在
    return 0
