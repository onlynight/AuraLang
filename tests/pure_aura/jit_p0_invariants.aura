// tests/pure_aura/jit_p0_invariants.aura
// ─────────────────────────────────────────────────────────────
// P0: JIT 纯 Aura 侧不变量断言测试
//
// 验证 8 个 JIT 文件的核心契约（不依赖 FFI 边界）。
// 对应分阶段开发计划 P0 阶段。
//
// 运行：aura run tests/pure_aura/jit_p0_invariants.aura
// ─────────────────────────────────────────────────────────────

import "../..//aura/compiler/aura/lang/compiler/test/TestRunner.aura"
import "../..//aura/compiler/aura/lang/compiler/jit/JitState.aura"
import "../..//aura/compiler/aura/lang/compiler/jit/JitAbi.aura"
import "../..//aura/compiler/aura/lang/compiler/jit/JitDispatch.aura"
import "../..//aura/compiler/aura/lang/compiler/jit/JitRuntime.aura"
import "../..//aura/compiler/aura/lang/compiler/jit/JitUtil.aura"
import "../..//aura/compiler/aura/lang/compiler/jit/JitCore.aura"
import "../..//aura/compiler/aura/lang/compiler/jit/JitOpt.aura"
import "../..//aura/compiler/aura/lang/compiler/jit/JitLower.aura"

fun main() {
    val t = TestRunner()
    
    // ─── 1. JitValue ABI 不变量 ───
    t.begin("JitValue ABI")
    
    // JitValue 是 16 字节结构（tag: i64 + payload: i64）
    t.assertEq(jitValueSize(), 16, "JitValue size = 16 bytes")
    t.assertEq(jitTagSize(), 8, "tag field = 8 bytes")
    t.assertEq(jitPayloadSize(), 8, "payload field = 8 bytes")
    
    // 13 个类型标签
    t.assertEq(jitTagCount(), 13, "13 type tags")
    t.assertEq(jitTagValue(jitTagInt()), 0, "TAG_INT = 0")
    t.assertEq(jitTagValue(jitTagFloat()), 1, "TAG_FLOAT = 1")
    t.assertEq(jitTagValue(jitTagBool()), 2, "TAG_BOOL = 2")
    t.assertEq(jitTagValue(jitTagNull()), 3, "TAG_NULL = 3")
    t.assertEq(jitTagValue(jitTagStr()), 4, "TAG_STR = 4")
    t.assertEq(jitTagValue(jitTagPtr()), 5, "TAG_PTR = 5")
    t.assertEq(jitTagValue(jitTagObj()), 6, "TAG_OBJ = 6")
    t.assertEq(jitTagValue(jitTagFunc()), 7, "TAG_FUNC = 7")
    t.assertEq(jitTagValue(jitTagArray()), 8, "TAG_ARRAY = 8")
    t.assertEq(jitTagValue(jitTagList()), 9, "TAG_LIST = 9")
    t.assertEq(jitTagValue(jitTagMap()), 10, "TAG_MAP = 10")
    t.assertEq(jitTagValue(jitTagClosure()), 11, "TAG_CLOSURE = 11")
    t.assertEq(jitTagValue(jitTagCString()), 12, "TAG_CSTRING = 12")
    
    t.report()
    
    // ─── 2. JitState 状态机不变量 ───
    t.begin("JitState 状态机")
    
    val state = JitState()
    t.assertEq(state.compiledCount(), 0, "initial compiled = 0")
    t.assertEq(state.skippedCount(), 0, "initial skipped = 0")
    t.assertEq(state.dispatchTableSize(), 0, "initial dispatch table = 0")
    
    // 插入编译函数
    state.insert(1)
    t.assertTrue(state.isCompiled(1), "func 1 compiled")
    t.assertEq(state.compiledCount(), 1, "compiled count = 1")
    
    // 跳过函数
    state.skip(2, "not compilable")
    t.assertTrue(state.isSkipped(2), "func 2 skipped")
    t.assertEq(state.skippedCount(), 1, "skipped count = 1")
    t.assertEq(state.skipReason(2), "not compilable", "skip reason preserved")
    
    // 未编译函数
    t.assertFalse(state.isCompiled(3), "func 3 not compiled")
    t.assertFalse(state.isSkipped(3), "func 3 not skipped")
    
    t.report()
    
    // ─── 3. 派发决策不变量 ───
    t.begin("派发决策")
    
    // 已编译 → NATIVE
    t.assertEq(jitDecide(state, 1), JitDecide.NATIVE, "compiled → native")
    
    // 已跳过 → SKIP
    t.assertEq(jitDecide(state, 2), JitDecide.SKIP, "skipped → skip")
    
    // 未处理 → DEFER
    t.assertEq(jitDecide(state, 3), JitDecide.DEFER, "unprocessed → defer")
    
    // 回退原因
    t.assertEq(jitFallbackReason(state, 1), "", "compiled has no fallback reason")
    t.assertEq(jitFallbackReason(state, 2), "not compilable", "skipped has reason")
    
    t.report()
    
    // ─── 4. 运行时不变量 ───
    t.begin("运行时契约")
    
    // 调用深度限制
    t.assertEq(jitMaxCallDepth(), 1024, "max call depth = 1024")
    t.assertTrue(jitCallDepthOk(0), "depth 0 ok")
    t.assertTrue(jitCallDepthOk(1023), "depth 1023 ok")
    t.assertFalse(jitCallDepthOk(1024), "depth 1024 not ok")
    
    // 段大小
    t.assertEq(jitSegmentEntryBytes(), 16, "segment entry = 16 bytes")
    t.assertEq(jitFuncDescSize(), 32, "func desc = 32 bytes")
    
    // Blob 魔数
    t.assertEq(jitBlobMagic(), "AURA", "blob magic = AURA")
    
    t.report()
    
    // ─── 5. 工具函数不变量 ───
    t.begin("工具函数")
    
    // 字符串分割
    t.assertEq(jitLineCount("a\nb\nc"), 3, "3 lines")
    t.assertEq(jitLineAt("a\nb\nc", 0), "a", "line 0 = a")
    t.assertEq(jitLineAt("a\nb\nc", 1), "b", "line 1 = b")
    t.assertEq(jitLineAt("a\nb\nc", 2), "c", "line 2 = c")
    
    // 整数解析
    t.assertEq(jitParseInt("42"), 42, "parse 42")
    t.assertEq(jitParseInt("-7"), -7, "parse -7")
    t.assertEq(jitParseInt("0"), 0, "parse 0")
    
    // 记录解析
    t.assertEq(jitRecordCount("1|2|3"), 3, "3 records")
    t.assertEq(jitRecordAt("1|2|3", 0), "1", "record 0 = 1")
    t.assertEq(jitRecordAt("1|2|3", 1), "2", "record 1 = 2")
    t.assertEq(jitRecordAt("1|2|3", 2), "3", "record 2 = 3")
    
    t.report()
    
    // ─── 6. 优化 Pass 不变量 ───
    t.begin("优化 Pass")
    
    // 验证 7 个优化 pass 存在
    t.assertEq(jitOptPassCount(), 7, "7 optimization passes")
    
    t.report()
    
    // ─── 汇总 ───
    t.finalReport()
}
