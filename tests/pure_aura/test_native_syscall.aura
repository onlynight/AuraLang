// Test: Phase 0 - @native(N) generates inline syscall IR, not C dispatch
// This test verifies:
// 1. @native(0) (SYS_READ) generates inline syscall, not @aura_syscall_dispatch
// 2. @native(1) (SYS_WRITE) generates inline syscall
// 3. No C FFI declarations for syscall dispatch in the generated IR
//
// Build & test:
//   aura build --aot test_native_syscall.aura --output test_native_syscall.exe
//   test_native_syscall.exe

import aura.lang.native.arch.x86_64_linux.Syscalls
import aura.lang.native.Memory

fun main(): Int {
    // Test 1: getpid syscall (SYS_GETPID = 39)
    // This should generate: movq $39, %rax; syscall
    val pid: Int = Syscalls.getpid()
    
    // Verify the result via write to stderr
    val msg: Long = Memory.alloc(64)
    // Simple test: just return 0 if no crash
    Memory.free(msg)
    
    // Test 2: exit_group syscall (SYS_EXIT_GROUP = 231)
    // @native(231) fun exitGroup(code: Int)
    
    return 0
}
