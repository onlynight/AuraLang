// aura:///aura/lang/compiler/backend/JitBackend.aura
package aura.lang.compiler.photon
// ─────────────────────────────────────────────────────────────
// JIT 后端 — W^X mmap + 分派表 — Phase E (任务 E.3)
//
// 对应后端 JIT 编译阶段。在运行时将机器码写入可执行内存，
// 通过分派表管理函数入口点。
//
// ── W^X 内存安全 ──
//
// 写时不可执行（Write eXecute / W^X）：
//   - 内存区域在同一时刻只能为可读可写（写入时）或可执行（执行时）
//   - 写入代码后必须调用 mprotect/VirtualProtect 切换为可执行
//   - 防止缓冲区溢出导致的任意代码执行
//
// ── 系统调用 ──
//
//   Windows:
//     VirtualAlloc(size, MEM_COMMIT, PAGE_READWRITE)   — 分配 RW 内存
//     VirtualProtect(base, size, PAGE_EXECUTE_READ)    — 切换为可执行
//     VirtualFree(base, size, MEM_RELEASE)             — 释放
//
//   Unix (Linux/macOS):
//     mmap(NULL, size, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0) — 分配 RW
//     mprotect(base, size, PROT_READ|PROT_EXEC)       — 切换为可执行
//     munmap(base, size)                               — 释放
//
// ── 分派表布局 ──
//
//   dispatchTable[0] = functionA entry point address
//   dispatchTable[1] = functionB entry point address
//   ...
//   dispatchTable[n-1] = lastFunction entry point address
//
//   分派存根（Dispatch Stub）：
//     jmp [dispatchTable + slot * 8]    — 间接跳转
//
// ── JIT 代码布局 ──
//
//   codeBase        — 可执行内存基址
//   codeSize        — 代码区域大小
//   textStart       — .text 节起始地址
//   textEnd         — .text 节结束地址
//   dataStart       — .data 节起始地址
//   dataEnd         — .data 节结束地址
//   entryPoint      — 入口点地址
//   dispatchTable   — 分派表基址
//   functionCount   — JIT 编译函数数量
//
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String
import aura.lang.std.Builtin
import aura.lang.native.Memory
import aura.lang.native.JitExec
import aura.lang.compiler.hir.Hir
import aura.lang.compiler.photon.PhotonPipeline
import aura.lang.compiler.photon.JitRelocation
import aura.lang.compiler.photon.JitRelocBatch

// ─────────────────────────────────────────────────────────────
// JitBackend — JIT 后端：W^X 内存 + 分派表
// ─────────────────────────────────────────────────────────────

/// JIT 后端：管理可执行内存分配、机器码写入、分派表构建。
class JitBackend {

    const val PROT_READ: Int = 1
    const val PROT_WRITE: Int = 2
    const val PROT_EXEC: Int = 4

    /// 可执行内存基址（VirtualAlloc/mmap 返回值；多函数共享同一块）。
    var codeBase: Int = 0

    /// 可执行内存区域大小（字节）。
    var codeSize: Int = 0

    /// 已使用的代码字节数（多函数顺序追加时使用）。
    var usedSize: Int = 0

    /// 已发射（编码 + 写入）的函数数量。
    private var funcCount: Int = 0

    /// 最近一次注册的函数名（供 `lookupFunction` / `deoptimize` 按名定位）。
    ///
    /// 说明：VM 运行时的字符串 stdlib（`split` / `substring` / `indexOf` /
    /// `charAt` 等）不可用，无法维护「名字 → 槽位」的通用映射；这里记录最近
    /// 一次注册的名字，覆盖 JIT 的常见单函数场景。原生运行时可在此基础上扩展
    /// 为完整映射。
    private var lastFuncName: String = ""

    /// 最近一次注册的分派条目值。
    private var dispatchEntryValue: Int = 0

    /// 最近一次注册的分派槽位。
    private var lastDispatchSlot: Int = -1

    /// 槽位 0 的分派条目值。
    private var firstDispatchEntry: Int = 0

    /// 已分配的分派槽位数量。
    private var dispatchCount: Int = 0

    /// 总分配字节数（累计）。
    var allocatedSize: Int = 0

    /// 系统页粒度（通常 4096 字节）。
    var pageGranularity: Int = 4096

    /// VM 模式标志：为 true 时跳过所有 Memory 外部调用（模拟分配）。
    ///
    /// 默认 **true** —— `Memory` 是 `extern interface`，只在 AOT / 自举（原生）
    /// 运行时才会被降低为真实调用；种子 VM 的字节码后端无法解析
    /// （`未解析的函数调用 'Memory.alloc'`），运行时会以
    /// `call to undefined function #65535` 崩溃。
    ///
    /// 因此默认走「VM 安全」路径：地址与写入均为模拟。
    /// 在 AOT / 自举（原生）运行时调用 [`enableNativeExec`] 关闭模拟，
    /// 才会真实分配 W^X 内存并写入机器码。
    var vmMode: Boolean = true

    /// 是否运行在原生（AOT / 自举）运行时。
    var nativeRuntime: Boolean = false

    /// 最近一次 [`emitFunctionRelocated`] 的重定位应用结果（P1-2 诊断用）。
    private var lastRelocResult: RelocApplyResult = RelocApplyResult()

    /// 最近一次发射中跳过的重定位条目数（未知符号 / 偏移越界 / 数据段未分配）。
    private var lastRelocSkipped: Int = 0

    /// 数据段基址（Phase 2.1）：字符串常量 / 字面量所在的可读内存。
    ///
    /// 0 = 未分配（`DATA_REF` 重定位被跳过）；非 0 时 `applyRelocations`
    /// 与 `applyBatch` 会把 `R_X86_64_DATA` 回填为 `dataBase + offset`。
    var dataBase: Int = 0

    /// 数据段大小（字节）。
    var dataSize: Int = 0

    /// 已写入的数据字节数。
    var dataUsed: Int = 0

    /// 最近一次 [`compileBatch`] 的批量回填结果（Phase 1.4 诊断用）。
    private var lastBatchResult: BatchRelocResult = BatchRelocResult()

    /// 最近一次 [`compileBatch`] 的调用存根区首字节地址（0 = 无存根）。
    private var lastStubBase: Int = 0

    /// vmMode 下用于模拟分配的假地址计数器（`0x100000` = 1048576）。
    ///
    /// **必须写十进制**：发射器把 `var` 字段初始值按原文写进 LLVM IR，
    /// 而 `i32 0x100000` 会被 LLVM 当作十六进制浮点字面量而报
    /// `floating point constant invalid for type`。
    var simNextAddr: Int = 1048576

    init() {
        this.codeBase = 0
        this.codeSize = 0
        this.usedSize = 0
        this.funcCount = 0
        this.lastFuncName = ""
        this.dispatchEntryValue = 0
        this.lastDispatchSlot = -1
        this.firstDispatchEntry = 0
        this.dispatchCount = 0
        this.allocatedSize = 0
        this.pageGranularity = 4096
        this.vmMode = true
        this.nativeRuntime = false
        this.simNextAddr = 1048576
        this.lastRelocResult = RelocApplyResult()
        this.lastRelocSkipped = 0
        this.dataBase = 0
        this.dataSize = 0
        this.dataUsed = 0
        this.lastBatchResult = BatchRelocResult()
        this.lastStubBase = 0
        // ⚠️ 2026-10-08 P1-3：曾试过在这里读 `AURA_JIT` 环境变量做「同一份
        // .auc 两种跑法」的参数化——已撤。原因：.auc 字节码侧的 `Env.get`
        // 走的是 stdlib 的 Env **单例对象**（含 `all: HashMap` 字段），而
        // Aura 版 VmRunner 尚未实现 Rust VM 的
        // `create_singletons` + `run_singleton_initializers`（见
        // seed/compiler/src/vm/mod.rs:1265）——单例字段恒 Null，
        // HashMap 内部对 0 指针解引用 ⇒ 原生 VM 下直接段错误。模式切换
        // 因此只保留显式 `enableNativeExec()` 通道（原生验证程序专用）；
        // 字节码侧参数化等单例初始化补齐后再接（P5 候选）。
    }

    /// 启用原生执行：关闭 VM 模拟，真实分配 W^X 内存并写入机器码。
    ///
    /// **仅可在 AOT / 自举（原生）运行时调用**；种子 VM 下调用会在首次
    /// 触碰 `Memory` 时崩溃。
    fun enableNativeExec(): Unit {
        this.vmMode = false
        this.nativeRuntime = true
    }

    /// 当前是否处于 VM 模拟模式。
    fun isVmMode(): Boolean {
        return this.vmMode
    }

    // ── 真实执行 ──

    /// 调用 `entry` 处已发射的机器码，返回结果（`rax`）。
    ///
    /// 通过 [`JitExec.callI64`]（AOT 发射器降级为 `inttoptr` + 间接 `call`）
    /// 把控制权交给 JIT 代码。**仅原生模式可用**：
    ///
    ///   * `vmMode == true`（种子 VM / 默认）→ 直接返回 0，绝不触碰 `JitExec`；
    ///   * `vmMode == false`（AOT / 自举，已 `enableNativeExec()`）→ 真实调用。
    ///
    /// 目标函数按平台 C ABI（Windows x64：`arg0` → `rcx`，返回值 `rax`）。
    fun executeNative(entry: Int, arg0: Int): Int {
        if (this.vmMode || entry == 0) {
            return 0
        }
        // ⚠️ 2026-10-08 P1-3：曾实测双参 extern 调用到达桩时 (rcx,rdx) 与
        // 源序不符（发射器/前端实参排序缺陷，P5 追踪）。桩
        // `JitExec_callI64` 因此做成**参数序自识别**：entry 必然落在
        // allocRW 的 JIT 区间 [0x08000000, 0x20000000)，arg0 为任意小整数，
        // 桩按区间判定后装载，源序无需（也不能）在此补偿。
        val r: Long = JitExec.callI64(entry as Long, arg0 as Long)
        return r as Int
    }

    /// 调用无参 JIT 函数，返回结果（`rax`）。语义同 [`executeNative`]。
    fun executeNative0(entry: Int): Int {
        if (this.vmMode || entry == 0) {
            return 0
        }
        // 反序补偿说明同 executeNative（单参调用无此问题，保持源序）。
        val r: Long = JitExec.call0(entry as Long)
        return r as Int
    }

    // ── 内存管理 ──

    /// 分配 W^X 可执行内存。
    ///
    /// VM 模式：模拟分配（`simNextAddr` 计数器），绝不触碰 Memory/JitExec。
    /// 原生模式：走单参原语 `JitExec.allocRW`——独立 mmap 区（低地址提示
    /// 重试 + Int32 可容校验内联在运行时桩），与堆物理隔离（2026-10-08
    /// P1-3 根治：旧 `Memory.alloc` 的堆地址 >Int32 会被截断成垃圾，且
    /// mprotect 整页粒度会波及同页堆对象）。
    fun allocateExecMemory(size: Int): Int {
        // 对齐到页粒度
        val alignedSize: Int = this.alignToPage(size)

        // VM 模式：模拟分配，不实际调用 Memory（仅用于 VM 测试）
        if (this.vmMode) {
            val base: Int = this.simNextAddr
            this.simNextAddr = this.simNextAddr + alignedSize
            this.allocatedSize = this.allocatedSize + alignedSize
            return base
        }

        println("[ST2] before allocRW size=" + toStr(alignedSize))
        val baseL: Long = JitExec.allocRW(alignedSize as Long)
        val base: Int = baseL as Int
        if (base == 0) {
            return 0
        }

        this.allocatedSize = this.allocatedSize + alignedSize
        return base
    }

    /// 释放可执行内存。
    ///
    /// 原生模式：mmap 区归还内核（NtFreeVirtualMemory / Memory_munmap）。
    /// 旧实现 `Memory.free` 是 bump 分配器的 no-op——对 mmap 区等于泄漏。
    fun freeExecMemory(base: Int, size: Int): Unit {
        if (base == 0) {
            return
        }
        if (!this.vmMode) {
            Memory.munmap(base as Long, size as Long)
        }
        this.allocatedSize = this.allocatedSize - size
    }

    /// mmap 风格 prot 位（PROT_*）→ Win32 PAGE_* 常量。
    ///
    /// ⚠️ 两套常量数值不同（mmap: R=1 W=2 X=4；Win32: NOACCESS=1
    /// READONLY=2 READWRITE=4 EXECUTE=0x10 EXECUTE_READ=0x20…），
    /// 必须翻译后才能传给 runtime 的 `Memory_mprotect`（VirtualProtect）。
    private fun protToWin32(prot: Int): Int {
        if (prot == (this.PROT_READ + this.PROT_EXEC)) { return 32 }        // PAGE_EXECUTE_READ
        if (prot == (this.PROT_READ + this.PROT_WRITE + this.PROT_EXEC)) { return 64 } // PAGE_EXECUTE_READWRITE
        if (prot == (this.PROT_READ + this.PROT_WRITE)) { return 4 }        // PAGE_READWRITE
        if (prot == this.PROT_READ) { return 2 }                            // PAGE_READONLY
        if (prot == this.PROT_EXEC) { return 16 }                           // PAGE_EXECUTE
        return 4
    }

    /// 将内存标记为可执行（只读+执行）。
    ///
    /// Windows: VirtualProtect(base, size, PAGE_EXECUTE_READ)
    /// Unix:    mprotect(base, size, PROT_READ|PROT_EXEC)
    ///
    /// ⚠️ 2026-10-08 P1-3：runtime 的 `Memory_mprotect` 旧为恒 0 空桩——
    /// 本调用曾长期静默无效，JIT 代码从未真正获得执行权限。现已是
    /// VirtualProtect 真实现；本处负责 prot 位翻译。
    fun setExecutable(base: Int, size: Int): Unit {
        if (this.vmMode) {
            return
        }
        val pok: Int = JitExec.protect(base as Long, size as Long,
                this.protToWin32(this.PROT_READ + this.PROT_EXEC))
                + " prot=" + toStr(this.protToWin32(this.PROT_READ + this.PROT_EXEC))
                + " -> " + toStr(pok))
    }

    /// 将内存标记为可写（读+写，不可执行）。
    ///
    /// Windows: VirtualProtect(base, size, PAGE_READWRITE)
    /// Unix:    mprotect(base, size, PROT_READ|PROT_WRITE)
    fun setWritable(base: Int, size: Int): Unit {
        if (this.vmMode) {
            return
        }
        JitExec.protect(base as Long, size as Long,
                this.protToWin32(this.PROT_READ + this.PROT_WRITE))
    }

    /// 将机器码写入可执行内存。
    ///
    /// 将 hex 编码的字节流写入指定偏移处。
    /// 调用前内存必须为可写状态，调用后可切换为可执行。
    fun writeCode(base: Int, offset: Int, bytes: String): Unit {
        if (base == 0 || bytes == "") {
            return
        }
        // VM 模式：跳过实际写入（仅用于 VM 测试）
        if (this.vmMode) {
            return
        }
        // 将 hex 字符串转换为字节数组并写入内存
        //
        // ⚠ 用 `bytes.charCodeAt(i) as Int` 而不是索引访问 `bytes[i]`：
        // 裸字符索引在 Photon 原生闭包下返回 Any（非 Char），传入
        // `hexToNibble(text: String)` 时 `c.charCodeAt(0)` 解析到 Any 的
        // 默认分支而恒返回 0 ⇒ 所有机器码字节被写成 00。实测 P1-3 原生
        // 验证：`emitFunction` 写出的整段代码全为 00 字节，`executeNative`
        // 返回 0 而非期望值（2026-10-08 探针，详见 p13 阶段报告 §八）。
        // 同一模式下必须 `as Int` 再与数字比较（见 HatGetPatchUtils 注释）。
        val hexLen: Int = bytes.length
        var i: Int = 0
        while (i < hexLen) {
            // 逐字节写入。⚠️ hex 解析必须走 `charCodeAt(idx)`
            // （`hexToNibbleAt`）——`substring(idx, idx+1)` 是 3 参方法
            // 调用，Photon 原生路径接收者错位（stub 收到 str=0 即崩，
            // 实测 P1-3 三次构建稳定复现；14/14 自检全绿形态即本循环）。
            val hi: Int = JitBackendUtils.hexToNibbleAt(bytes, i)
            i = i + 1
            if (i < hexLen) {
                val lo: Int = JitBackendUtils.hexToNibbleAt(bytes, i)
                Memory.write((base + offset + (i - 1) / 2) as Long, ((hi << 4) | lo) as Byte)
            }
            i = i + 1
        }
    }

    /// 写入 32 位重定位值（小端）。
    ///
    /// P1-2 新增：`JitRelocation` 回填 `RIP32`/`PCREL32` 位移用。
    /// `addr` 是**占位符首字节**的绝对地址（`codeBase + offset`）。
    /// VM 模式下跳过实际写入（与 [`writeCode`] 一致）。
    fun writeReloc32(addr: Int, value: Int): Unit {
        if (addr == 0 || this.vmMode) {
            return
        }
        Memory.write32(addr as Long, value)
    }

    /// 写入 64 位重定位值（绝对地址）。
    ///
    /// P1-2 新增：`JitRelocation` 回填 `R_X86_64_64` / 数据段引用用。
    fun writeReloc64(addr: Int, value: Long): Unit {
        if (addr == 0 || this.vmMode) {
            return
        }
        Memory.write64(addr as Long, value)
    }

    // ── 分派表管理 ──

    /// 在分派表中分配一个新槽位，返回槽位索引。
    fun allocateDispatchSlot(): Int {
        val slot: Int = this.dispatchCount
        this.dispatchCount = slot + 1
        return slot
    }

    /// 设置分派表条目。
    fun setDispatchEntry(slot: Int, entry: Int): Unit {
        if (slot == 0) {
            this.firstDispatchEntry = entry
        }
        if (slot >= this.lastDispatchSlot) {
            this.lastDispatchSlot = slot
            this.dispatchEntryValue = entry
        }
        if (this.dispatchCount <= slot) {
            this.dispatchCount = slot + 1
        }
    }

    /// 获取分派表条目（0 表示空槽 / 未分配）。
    fun getDispatchEntry(slot: Int): Int {
        if (slot == this.lastDispatchSlot) {
            return this.dispatchEntryValue
        }
        if (slot == 0) {
            return this.firstDispatchEntry
        }
        return 0
    }

    // ── 存根构建 ──

    /// 构建分派存根（Dispatch Stub）。
    ///
    /// 分派存根用于间接跳转到分派表中的函数入口点。
    ///
    /// x86_64 机器码：
    ///   mov rax, [dispatchTable + slot * 8]   — 48 8B 05 xx xx xx xx (modRM+disp32)
    ///   jmp rax                                — FF E0
    ///
    /// 返回 hex 编码的机器码。
    fun buildDispatchStub(slot: Int): String {
        var out: String = ""
        // mov rax, [rip + offset]  — 间接通过 RIP 寻址
        // 实际编码需要链接器修正重定位
        // 简化：使用 RIP 相对寻址的占位符
        // 0x48 0x8B 0x05 0x00 0x00 0x00 0x00  — mov rax, [rip+0]
        out = out + "48" + "8B" + "05" + "00" + "00" + "00" + "00"
        // jmp rax — FF E0
        out = out + "FF" + "E0"
        return out
    }

    /// 构建去优化蹦床（Deoptimization Trampoline）。
    ///
    /// 去优化蹦床用于从 JIT 编译代码跳回 VM 解释器。
    /// 它保存 JIT 帧状态，恢复 VM 帧上下文，然后跳转回解释器入口。
    ///
    /// 参数：
    ///   targetFrame — VM 帧地址（Int）
    ///
    /// 返回 hex 编码的机器码。
    fun buildDeoptTrampoline(targetFrame: Int): String {
        var out: String = ""
        // 保存寄存器到栈
        // push rbp — 55
        out = out + "55"
        // push rbx — 53
        out = out + "53"
        // mov rbp, rsp — 48 89 E5
        out = out + "48" + "89" + "E5"
        // sub rsp, 32 (shadow space) — 48 83 EC 20
        out = out + "48" + "83" + "EC" + "20"
        // lea rax, [rip + trampoline_target] — 48 8D 05 xx xx xx xx
        // 指向去优化处理函数（VM 解释器入口）
        out = out + "48" + "8D" + "05"
        // 位移占位符（链接时修正）
        out = out + "00" + "00" + "00" + "00"
        // mov [rbp - 8], rax — 48 89 45 F8
        out = out + "48" + "89" + "45" + "F8"
        // 恢复 VM 帧指针
        // lea rdi, [rip + vm_frame] — 48 8D 3D xx xx xx xx
        out = out + "48" + "8D" + "3D"
        out = out + "00" + "00" + "00" + "00"
        // 调用 VM 解释器入口
        // call rax — FF D0
        out = out + "FF" + "D0"
        return out
    }

    /// 构建调用存根（Call Stub）。
    ///
    /// 调用存根用于从 JIT 代码调用另一个已编译函数。
    ///
    /// x86_64 机器码：
    ///   jmp targetAddr                    — E9 xx xx xx xx (jmp rel32)
    ///   或
    ///   mov rax, targetAddr               — 48 B8 xx xx xx xx xx xx xx xx
    ///   jmp rax                           — FF E0
    ///
    /// 返回 hex 编码的机器码。
    fun buildCallStub(targetAddr: Int): String {
        var out: String = ""
        // mov rax, imm64 — 48 B8 [8 bytes of targetAddr]
        out = out + "48" + "B8"
        out = out + this.intToHexLe(targetAddr, 8)
        // jmp rax — FF E0
        out = out + "FF" + "E0"
        return out
    }

    /// 构建返回存根（Return Stub）。
    ///
    /// 返回存根用于函数返回时清理栈帧。
    ///
    /// x86_64 机器码：
    ///   mov rsp, rbp — 48 89 EC
    ///   pop rbp      — 5D
    ///   ret          — C3
    fun buildReturnStub(): String {
        var out: String = ""
        // mov rsp, rbp — 48 89 EC
        out = out + "48" + "89" + "EC"
        // pop rbp — 5D
        out = out + "5D"
        // ret — C3
        out = out + "C3"
        return out
    }

    // ── 函数发射 ──

    /// 将函数机器码写入可执行内存，返回入口点地址。
    ///
    /// 多个函数**共享同一块**可执行内存（见设计 10.3.2）：首次调用时按页
    /// 粒度分配一块内存，后续调用在 `usedSize` 处按 16 字节对齐顺序追加，
    /// 因此入口地址是 `codeBase + offset` 而非基址。
    ///
    /// VM 模式下地址为模拟值、写入被跳过；原生模式下真实 W^X 写入。
    fun emitFunction(funcName: String, machineCode: String): Int {
        return this.emitFunctionRelocated(funcName, machineCode, "", "", 0)
    }

    /// 带重定位修正的函数发射（P1-2）。
    ///
    /// 与 [`emitFunction`] 的唯一区别是多三步：
    ///   1. 分配后先**保持 RW** 写入机器码（不再立刻切 RX）；
    ///   2. 调用 [`JitRelocationUtils.applyRelocations`] 回填占位符；
    ///   3. 全部回填完成后再 `setExecutable` 切 RX（真正的 W^X）。
    ///
    /// 参数：
    ///   `machineCode`    裸机器码 hex（含 `00 00 00 00` 占位符）；
    ///   `relocRecords`   `offset|symbol|type` 条目、`;` 分隔（可为空）；
    ///   `funcNameOffsets` `funcName|offset` 条目、`;` 分隔（可为空）；
    ///   `dataBase`       数据段基址（0 = 未分配，`DATA_REF` 重定位被跳过）。
    ///
    /// 返回入口地址 `base + offset`；失败（空码 / 分配失败 / 越界）返回 0。
    fun emitFunctionRelocated(funcName: String, machineCode: String,
                              relocRecords: String, funcNameOffsets: String,
                              dataBase: Int): Int {
        if (machineCode == "") {
            return 0
        }

        val codeBytes: Int = machineCode.length / 2

        // 首次调用：分配一块共享可执行内存。
        var base: Int = this.codeBase
        if (base == 0) {
            val reserve: Int = this.alignToPage(codeBytes + 64) // 64 字节余量
            base = this.allocateExecMemory(reserve)
            if (base == 0) {
                return 0
            }
            this.codeBase = base
            this.codeSize = reserve
            this.usedSize = 0
        } else if (this.usedSize + codeBytes + 16 > this.codeSize) {
            // 需要更大的内存；VM 模式直接扩容（模拟），原生模式无法就地扩容，
            // 本次发射失败（调用方可先分配足够大的空间）。
            if (!this.vmMode) {
                return 0
            }
            this.codeSize = this.alignToPage(this.usedSize + codeBytes + 64)
        }

        val offset: Int = this.usedSize
        val entry: Int = base + offset

        // 写入机器码（VM 模式下 writeCode 内部跳过）。
        println("[ST2] before writeCode base=" + toStr(base))
        this.writeCode(base, offset, machineCode)
        println("[ST2] after writeCode")

        // P1-2：回填重定位。
        //
        // 关键约定：`relocRecords` 与 `funcNameOffsets` 的 offset 都是
        // **段内**字节偏移（`X86Emitter` 单次 `emitFunction` 调用的模块内偏移）。
        // `applyRelocations` 收到的 `codeBase` 因此是本段起点 `base + offset`，
        // 而**不是**共享内存基址——否则同一块内存里发射第二个函数时，
        // 第一段的偏移语义与第二段错位（`base+off` 与 `base+offset+off`）。
        // `funcNameOffsets` 的符号也按段内偏移解析，无需叠加。
        if (relocRecords != "") {
            val relocs: List<Relocation> = JitRelocationUtils.parseRelocs(relocRecords)
            val res: RelocApplyResult = JitRelocationUtils.applyRelocations(
                    this, base + offset, codeBytes, relocs, funcNameOffsets, dataBase)
            this.lastRelocResult = res
            this.lastRelocSkipped = res.skipped
        }

        // 切换为可执行权限（VM 模式下 setExecutable 内部跳过）。
        println("[ST2] before setExecutable")
        this.setExecutable(base, this.codeSize)
        println("[ST2] after setExecutable")

        // 16 字节对齐追加。
        this.usedSize = offset + codeBytes
        val rem: Int = this.mod16(codeBytes)
        if (rem != 0) {
            this.usedSize = this.usedSize + (16 - rem)
        }

        this.funcCount = this.funcCount + 1
        this.lastFuncName = funcName
        return entry
    }

    // ── 数据段（Phase 2.1）──

    /// 分配数据段（可读可写内存，不设为可执行）。
    ///
    /// 与 [`allocateExecMemory`] 的区别：数据段**不切换为 RX**，因此可以
    /// 在装载期持续写入（字符串常量、`@data.N` 字面量、后续的热补丁等）。
    /// 返回段基址；0 表示失败。重复调用（已有数据段）返回既有基址，
    /// 不重复分配——单个后端实例只有一个数据段。
    ///
    /// 关键：数据段**不**推进 `usedSize`，因此不会被后续
    /// [`compileBatch`] / [`emitFunctionRelocated`] 的扩容检查误判为
    /// 「代码区已满」——它占据的模拟地址空间是独立的。
    ///
    /// VM 模式下地址为模拟值（推进 `simNextAddr`），不触碰 `Memory`。
    fun allocateDataMemory(size: Int): Int {
        if (this.dataBase != 0) {
            return this.dataBase
        }
        val aligned: Int = this.alignToPage(size + 64)
        val base: Int = this.allocateExecMemory(aligned)
        if (base == 0) {
            return 0
        }
        // 数据段保持 RW：不切 RX，便于持续写入。
        this.setWritable(base, aligned)
        this.dataBase = base
        this.dataSize = aligned
        this.dataUsed = 0
        return base
    }

    /// 写入数据段内容（hex 字节串），返回写入结束处的段内偏移。
    ///
    /// `dataBase == 0`（未分配）时静默返回 0——调用方应先
    /// [`allocateDataMemory`]。VM 模式下跳过实际写入（与 `writeCode` 一致）。
    fun writeDataSection(data: String): Int {
        if (this.dataBase == 0 || data == "") {
            return 0
        }
        this.writeCode(this.dataBase, this.dataUsed, data)
        this.dataUsed = this.dataUsed + (data.length / 2)
        return this.dataUsed
    }

    /// 当前数据段基址（0 = 未分配）。
    fun getDataBase(): Int {
        return this.dataBase
    }

    /// 当前数据段已用字节数。
    fun getDataUsed(): Int {
        return this.dataUsed
    }

    /// 释放数据段。
    fun freeDataMemory(): Unit {
        if (this.dataBase != 0) {
            this.freeExecMemory(this.dataBase, this.dataSize)
        }
        this.dataBase = 0
        this.dataSize = 0
        this.dataUsed = 0
    }

    // ── 批量编译装载（Phase 1.4：多函数编译时链接）──

    /// 批量编译并装载多个函数到**同一块**可执行内存（Phase 1.4）。
    ///
    /// 与 `emitFunctionRelocated` 的关键区别：
    ///
    ///   * 段**连续追加**在同一段代码区，段间 `call rel32` 位移永不越界
    ///     （`emitFunctionRelocated` 的每段独立分配在跨越 2GB 时会失效）；
    ///   * 重定位**跨段统一解析**——`double` 的符号表条目可以被后面
    ///     任何一段引用，不再局限于「本段自己的 `funcNameOffsets`」；
    ///   * 外部符号（`exit` / `println` / `@str.N`）走**调用存根兜底**：
    ///     call 的 rel32 被替换为「跳到本块内的调用存根」，存根体
    ///     `mov rax, imm64; jmp rax` 的 imm64 留给调用方事后用
    ///     [`patchCallStubTarget`] 回填。目标为 0 的存根**不写**，
    ///     语义与 P1-2「不写错值」一致。
    ///
    /// 参数：
    ///   `sources`      每个元素的机器码 hex（可含 `00 00 00 00` 占位符）；
    ///   `relocs`       与 `sources` 对应的重定位记录串（`;` 分隔）；
    ///   `funcOffsets`  符号名 → **模块内**偏移表（`;` 分隔 `name|offset`）；
    ///   `names`        函数名（顺序与 `sources` 一致，用于存根诊断）；
    ///   `stubCount`    预留的调用存根个数（外部符号上限）。
    ///
    /// 返回入口列表（与 `names` 等长，`names[i]` 的绝对入口地址；
    /// 失败项为 0）。存根区首字节地址见 [`lastBatchStubBase`]。
    fun compileBatch(sources: List<String>, relocs: List<String>,
                     funcOffsets: String, names: List<String>,
                     stubCount: Int): List<Int> {
        val out: List<Int> = arrayListOf<Int>()
        if (sources.size == 0) {
            return out
        }

        // 1. 计算连续布局：每段代码 + 对齐 + 存根区。
        val sizes: List<Int> = arrayListOf<Int>()
        var i: Int = 0
        while (i < sources.size) {
            sizes.add(sources[i].length / 2)
            i = i + 1
        }
        val segOffs: List<Int> = JitRelocBatchUtils.segmentOffsets(sizes)
        val codeUsed: Int = JitRelocBatchUtils.layoutSizes(names, sizes, 0)
        val totalNeed: Int = codeUsed + stubCount * CallStub.SIZE + 64

        // 2. 首次批量装载才分配整块；已存在时检查容量。
        var base: Int = this.codeBase
        if (base == 0) {
            base = this.allocateExecMemory(this.alignToPage(totalNeed))
            if (base == 0) {
                var k: Int = 0
                while (k < names.size) {
                    out.add(0)
                    k = k + 1
                }
                return out
            }
            this.codeBase = base
            this.codeSize = this.alignToPage(totalNeed)
            this.usedSize = 0
        } else if (this.usedSize + totalNeed > this.codeSize) {
            // 原生模式无法就地扩容；VM 模式模拟扩容。
            if (!this.vmMode) {
                var k: Int = 0
                while (k < names.size) {
                    out.add(0)
                    k = k + 1
                }
                return out
            }
            this.codeSize = this.alignToPage(this.usedSize + totalNeed)
        }

        // 存根区紧跟代码区（同一块内存内，段间位移永不越界）。
        val stubBase: Int = base + codeUsed
        this.lastStubBase = stubBase

        // 3. 写机器码到各段，并构造段描述符。
        //
        // 记录表里的 offset 是**编码器视角的模块内偏移**（`compileEncodeOnly`
        // 整批编译时 `enc.byteCount()` 从 0 累计）。本方法把多段写进同一块
        // 连续内存，各段的实际基址取决于前面所有段的对齐后尺寸——因此需要
        // 把记录 offset 平移为段内偏移（`off - firstModuleOff`）。
        //
        // 单段编译时 `firstModuleOff == 0`，语义与 `emitFunctionRelocated`
        // 完全一致（那里的 `codeBase` 就是段基址）。
        val firstModuleOff: Int = JitRelocBatchUtils.lookupOffset(funcOffsets, names[0])
        val segments: List<RelocSegment> = arrayListOf<RelocSegment>()
        i = 0
        while (i < sources.size) {
            val src: String = sources[i]
            val segOff: Int = segOffs[i]
            this.writeCode(base, segOff, src)
            val seg: RelocSegment = RelocSegment()
            seg.name = names[i]
            seg.offset = segOff
            seg.size = sizes[i]
            if (i < relocs.size) {
                val parsed: List<Relocation> = JitRelocationUtils.parseRelocs(relocs[i])
                var pi: Int = 0
                while (pi < parsed.size) {
                    val r: Relocation = parsed[pi]
                    r.offset = r.offset - firstModuleOff
                    pi = pi + 1
                }
                seg.relocs = parsed
            }
            segments.add(seg)
            out.add(base + segOff)
            i = i + 1
        }

        // 4. 批量回填（段间 + 外部符号存根兜底）。
        val res: BatchRelocResult = JitRelocBatchUtils.applyBatch(
                this, base, segments, funcOffsets, this.dataBase, stubBase, stubCount)
        this.lastBatchResult = res

        // 5. 整块切 RX（真正的 W^X；VM 模式下 setExecutable 为空操作）。
        this.setExecutable(base, this.codeSize)
        this.usedSize = codeUsed + stubCount * CallStub.SIZE
        this.funcCount = this.funcCount + sources.size
        this.lastFuncName = names[sources.size - 1]
        return out
    }

    /// 批量回填的调用存根区首字节地址（0 = 无存根 / 未编译）。
    fun lastBatchStubBase(): Int {
        return this.lastStubBase
    }

    /// 回填第 `index` 个调用存根的目标地址（见 `compileBatch` 说明）。
    ///
    /// 返回 false 表示未写入（index 越界 / 目标为 0 / 无存根区）。
    fun patchCallStubTarget(index: Int, target: Long): Boolean {
        if (this.lastStubBase == 0) {
            return false
        }
        return JitRelocBatchUtils.patchCallStubTarget(this, this.lastStubBase, index, target)
    }

    /// 最近一次 [`compileBatch`] 的批量回填统计。
    fun lastBatchResult(): BatchRelocResult {
        return this.lastBatchResult
    }

    /// 使用 Photon 管线把 HIR 编译为机器码（hex），供 JIT 侧直接消费。
    ///
    /// 这是 JIT 路径与 Photon 机器码后端的最小接缝：
    /// 调用方拿到 `machineCodeHex` 后可交给 `emitFunction` 写入可执行内存，
    /// 或直接参与派发/回退决策。
    ///
    /// 注意：使用 `compileEncodeOnly` 而非 `compileHir`，
    /// 因为 JIT 不需要 COFF 目标文件组装和链接。
    fun compileMachineCode(hir: Hir, outDir: String, moduleName: String): String {
        return this.compileMachineCodeResult(hir, outDir, moduleName).machineCodeHex
    }

    /// [`compileMachineCode`] 的完整结果版（P1-2）。
    ///
    /// 返回 `BackendResult`，除 `machineCodeHex` 外还带
    /// `relocRecords` / `funcNameOffsets` / `funcOffsets` / `stringConsts`
    /// / `relocationCount`——JIT 装载必需的重定位信息。
    fun compileMachineCodeResult(hir: Hir, outDir: String, moduleName: String): BackendResult {
        val pipeline = PhotonPipeline()
        return pipeline.compileEncodeOnly(hir, outDir, moduleName)
    }

    /// 最近一次 [`emitFunctionRelocated`] 的重定位应用统计。
    fun lastRelocResult(): RelocApplyResult {
        return this.lastRelocResult
    }

    /// 最近一次发射中跳过的重定位数（未知符号 / 越界 / 数据段未分配）。
    fun lastRelocSkippedCount(): Int {
        return this.lastRelocSkipped
    }

    /// 将函数注册到分派表，返回槽位索引。
    ///
    /// 记录函数名，使 [`lookupFunction`] / [`deoptimize`] 可按名定位最近注册的
    /// 函数（VM 运行时无法维护通用名字映射，见 `lastFuncName` 说明）。
    fun registerFunction(funcName: String, entryPoint: Int): Int {
        val slot: Int = this.allocateDispatchSlot()
        this.setDispatchEntry(slot, entryPoint)
        this.lastFuncName = funcName
        return slot
    }

    /// 查找函数的入口点地址（按函数名）。
    ///
    /// VM 运行时字符串 stdlib 不可用，无法维护「名字 → 槽位」通用映射；
    /// 这里按最近一次注册的函数名匹配（覆盖单函数 JIT 场景）。
    /// 未找到返回 0（调用方应回退解释器）。
    fun lookupFunction(funcName: String): Int {
        if (funcName == this.lastFuncName) {
            if (this.lastDispatchSlot >= 0) {
                return this.getDispatchEntry(this.lastDispatchSlot)
            }
        }
        return 0
    }

    /// 已发射函数数量。
    fun functionCount(): Int {
        return this.funcCount
    }

    /// 已分配的（非空）分派槽位数量。
    fun slotCount(): Int {
        return this.dispatchCount
    }

    /// 去优化函数：将函数从 JIT 编译代码回退到 VM 解释执行。
    ///
    /// 流程：
    ///   1. 按函数名定位分派槽位（最近注册者）
    ///   2. 将分派表条目置零（禁用入口点）
    ///   3. VM 回退解释执行
    fun deoptimize(functionName: String): Unit {
        // 1. 最近注册者 → 其槽位
        if (functionName == this.lastFuncName && this.lastDispatchSlot >= 0) {
            this.setDispatchEntry(this.lastDispatchSlot, 0)
            return
        }
        // 2. 兜底：名字未知时禁用第一个非空槽位（兼容旧调用）。
        var i: Int = 0
        while (i < this.dispatchCount) {
            val entry: Int = this.getDispatchEntry(i)
            if (entry != 0) {
                this.setDispatchEntry(i, 0)
                return
            }
            i = i + 1
        }
    }

    // ── 布局查询 ──

    /// 返回 JIT 代码布局信息字符串。
    ///
    /// 格式：
    ///   base=<hex> size=<hex> used=<hex> textStart=<hex> textEnd=<hex>
    ///   dataStart=<hex> dataEnd=<hex> entryPoint=<hex>
    ///   dispatchTable=<hex> functionCount=<int> mode=<vm|native>
    fun getJitCodeLayout(): String {
        var mode: String = "native"
        if (this.vmMode) {
            mode = "vm"
        }
        var out: String = ""
        out = out + "base=" + this.intToHex(this.codeBase) + " "
        out = out + "size=" + this.intToHex(this.codeSize) + " "
        out = out + "used=" + this.intToHex(this.usedSize) + " "
        out = out + "textStart=" + this.intToHex(this.codeBase) + " "
        out = out + "textEnd=" + this.intToHex(this.codeBase + this.usedSize) + " "
        out = out + "dataStart=" + this.intToHex(this.dataBase) + " "
        out = out + "dataEnd=" + this.intToHex(this.dataBase + this.dataUsed) + " "
        out = out + "entryPoint=" + this.intToHex(this.codeBase) + " "
        out = out + "dispatchTable=00000000 "
        out = out + "functionCount=" + this.intToStr(this.funcCount) + " "
        out = out + "mode=" + mode
        if (this.lastRelocResult.total > 0) {
            out = out + " " + JitRelocationUtils.formatApplyResult(this.lastRelocResult)
        }
        if (this.lastBatchResult.total > 0) {
            out = out + " " + JitRelocBatchUtils.formatBatchResult(this.lastBatchResult)
        }
        return out
    }

    // ── 内部辅助 ──

    /// 对 16 取模（非负）。
    fun mod16(n: Int): Int {
        if (n <= 0) {
            return 0
        }
        return n - (n / 16) * 16
    }

    /// 将值对齐到页粒度（向上取整）。
    fun alignToPage(value: Int): Int {
        if (value <= 0) {
            return this.pageGranularity
        }
        val remainder: Int = value % this.pageGranularity
        if (remainder == 0) {
            return value
        }
        return value + (this.pageGranularity - remainder)
    }

    /// 将整数编码为 16 位 hex 字符串。
    fun intToHex(value: Int): String {
        var out: String = ""
        var remaining: Int = value
        while (remaining > 0) {
            val nibble: Int = remaining & 0x0F
            out = this.hexChar(nibble) + out
            remaining = remaining >> 4
        }
        if (out == "") {
            return "00000000"
        }
        // 填充到 8 个字符
        var i: Int = 0
        while (i < 8 - out.length) {
            out = "0" + out
            i = i + 1
        }
        return out
    }

    /// 将整数编码为小端 hex 字符串。
    fun intToHexLe(value: Int, byteCount: Int): String {
        var out: String = ""
        var remaining: Int = value
        var i: Int = 0
        while (i < byteCount) {
            val byte: Int = remaining & 0xFF
            out = out + this.byteToHex(byte)
            remaining = remaining >> 8
            i = i + 1
        }
        return out
    }

    /// 将单个字节编码为 2 字符 hex 字符串。
    fun byteToHex(byte: Int): String {
        val hi: Int = (byte >> 4) & 0x0F
        val lo: Int = byte & 0x0F
        return this.hexChar(hi) + this.hexChar(lo)
    }

    /// 将 0-15 的数值转换为 hex 字符。
    fun hexChar(n: Int): String {
        if (n == 0) { return "0" }
        if (n == 1) { return "1" }
        if (n == 2) { return "2" }
        if (n == 3) { return "3" }
        if (n == 4) { return "4" }
        if (n == 5) { return "5" }
        if (n == 6) { return "6" }
        if (n == 7) { return "7" }
        if (n == 8) { return "8" }
        if (n == 9) { return "9" }
        if (n == 10) { return "A" }
        if (n == 11) { return "B" }
        if (n == 12) { return "C" }
        if (n == 13) { return "D" }
        if (n == 14) { return "E" }
        return "F"
    }

    /// 将整数转为十进制字符串。
    fun intToStr(n: Int): String {
        if (n == 0) {
            return "0"
        }
        var neg: Boolean = false
        if (n < 0) {
            neg = true
            n = -n
        }
        var result: String = ""
        while (n > 0) {
            result = this.hexChar(n % 10) + result
            n = n / 10
        }
        if (neg) {
            result = "-" + result
        }
        return result
    }
}

// ─────────────────────────────────────────────────────────────
// JitBackendUtils — 顶层辅助函数
// ─────────────────────────────────────────────────────────────

object JitBackendUtils {

    /// 默认页粒度（字节）。
    fun defaultPageGranularity(): Int {
        return 4096
    }

    /// 最小可执行内存分配大小（字节）。
    fun minCodeAllocation(): Int {
        return 65536 // 64 KB
    }

    /// 默认 JIT 后端配置（VM 安全：模拟分配，不触碰 Memory）。
    fun defaultJitBackend(): JitBackend {
        return JitBackend()
    }

    /// 原生 JIT 后端配置（关闭 VM 模拟，真实 W^X 分配）。
    ///
    /// **仅可在 AOT / 自举（原生）运行时使用**；种子 VM 下会因
    /// `Memory` 不可解析而崩溃，请改用 [`defaultJitBackend`]。
    fun nativeJitBackend(): JitBackend {
        val b: JitBackend = JitBackend()
        b.enableNativeExec()
        return b
    }

    /// 判断当前运行环境是否具备原生内存能力（`Memory` extern）。
    ///
    /// 纯 Aura 无法在运行期可靠探测（探测本身就会触发不可解析调用），
    /// 因此由入口显式传入：默认返回 false（VM 安全）。
    fun nativeRuntimeAvailable(): Boolean {
        return false
    }

    // ── 整数解析 ──

    /// 简单整数解析（不使用 charCodeAt）。
    fun parseSimpleInt(text: String): Int {
        var result: Int = 0
        var neg: Boolean = false
        var i: Int = 0
        val len = text.length
        // 检查负号
        if (i < len && text.substring(i, i + 1) == "-") {
            neg = true
            i = i + 1
        }
        // 解析数字
        while (i < len) {
            val ch = text.substring(i, i + 1)
            if (ch == "0") { result = result * 10 }
            else if (ch == "1") { result = result * 10 + 1 }
            else if (ch == "2") { result = result * 10 + 2 }
            else if (ch == "3") { result = result * 10 + 3 }
            else if (ch == "4") { result = result * 10 + 4 }
            else if (ch == "5") { result = result * 10 + 5 }
            else if (ch == "6") { result = result * 10 + 6 }
            else if (ch == "7") { result = result * 10 + 7 }
            else if (ch == "8") { result = result * 10 + 8 }
            else if (ch == "9") { result = result * 10 + 9 }
            i = i + 1
        }
        if (neg) { result = -result }
        return result
    }

    /// x86_64 分派存根大小（字节）。
    fun dispatchStubSize(): Int {
        return 9 // mov rax,[rip+0] (7) + jmp rax (2)
    }

    /// x86_64 调用存根大小（字节）。
    fun callStubSize(): Int {
        return 11 // mov rax,imm64 (10) + jmp rax (2) = 12? no, 48 B8 + 8 bytes + FF E0 = 11
    }

    /// x86_64 返回存根大小（字节）。
    fun returnStubSize(): Int {
        return 5 // mov rsp,rbp (3) + pop rbp (1) + ret (1)
    }

    /// x86_64 去优化蹦床大小（字节）。
    fun deoptTrampolineSize(): Int {
        return 48
    }

    /// 将 hex 字符转换为 0-15 的数值。
    /// 十六进制字符（按索引取）→ 0..15。
    ///
    /// ⚠️ 2026-10-08 P1-3：刻意走 `charCodeAt(idx)` 而不是
    /// `substring(idx, idx+1)` + `hexToNibble`——Photon 原生路径上
    /// **3 参方法调用 `String.substring` 的接收者没有正确落到 rcx**
    /// （stub 收到 str=0 → 解引用即崩；实测 P1-3 自检 writeCode 首字符
    /// 即崩，charCodeAt 形态正常）。顺带消除每字符一次的堆分配。
    fun hexToNibbleAt(s: String, idx: Int): Int {
        val code: Int = s.charCodeAt(idx) as Int
        if (code >= 48 && code <= 57) { // '0' - '9'
            return code - 48
        }
        if (code >= 65 && code <= 70) { // 'A' - 'F'
            return code - 55
        }
        if (code >= 97 && code <= 102) { // 'a' - 'f'
            return code - 87
        }
        return 0
    }

    fun hexToNibble(c: String): Int {
        val code: Int = c.charCodeAt(0)
        if (code >= 48 && code <= 57) { // '0' - '9'
            return code - 48
        }
        if (code >= 65 && code <= 70) { // 'A' - 'F'
            return code - 55
        }
        if (code >= 97 && code <= 102) { // 'a' - 'f'
            return code - 87
        }
        return 0
    }

    /// 统计 hex 字符串中的字节数。
    fun hexByteCount(hex: String): Int {
        return hex.length / 2
    }

    /// 判断地址是否为页对齐的。
    fun isPageAligned(addr: Int): Boolean {
        return addr % 4096 == 0
    }

    /// 获取地址所在页的基址。
    fun pageBase(addr: Int): Int {
        return addr - (addr % 4096)
    }

    /// 计算覆盖指定地址和大小所需的页数。
    fun pageCount(addr: Int, size: Int): Int {
        if (size <= 0) {
            return 0
        }
        val startPage: Int = pageBase(addr)
        val endAddr: Int = addr + size - 1
        val endPage: Int = pageBase(endAddr)
        return (endPage - startPage) / 4096 + 1
    }

    /// 将大小对齐到页粒度。
    fun alignToPage(value: Int): Int {
        if (value <= 0) {
            return 4096
        }
        val remainder: Int = value % 4096
        if (remainder == 0) {
            return value
        }
        return value + (4096 - remainder)
    }

    /// 将值转为 Int（十六进制字符串）。
    fun hexToInt(text: String): Int {
        if (text == "") {
            return 0
        }
        val len: Int = text.length
        var total: Int = 0
        var i: Int = 0
        while (i < len) {
            total = total * 16 + hexToNibble(text.substring(i, i + 1))
            i = i + 1
        }
        return total
    }

    /// 将 Int 转为 hex 字符串。
    fun intToHexStr(n: Int): String {
        if (n == 0) {
            return "0"
        }
        var result: String = ""
        while (n > 0) {
            val nibble: Int = n & 0x0F
            if (nibble < 10) {
                result = JitBackendUtils.intToStr(nibble) + result
            } else {
                result = JitBackendUtils.hexCharStr(nibble) + result
            }
            n = n >> 4
        }
        return result
    }

    /// 将 0-15 转为 hex 字符字符串。
    fun hexCharStr(n: Int): String {
        if (n == 10) { return "A" }
        if (n == 11) { return "B" }
        if (n == 12) { return "C" }
        if (n == 13) { return "D" }
        if (n == 14) { return "E" }
        return "F"
    }

    /// 将整数转为十进制字符串。
    fun intToStr(n: Int): String {
        if (n == 0) {
            return "0"
        }
        var result: String = ""
        while (n > 0) {
            result = (n % 10).toString() + result
            n = n / 10
        }
        return result
    }

    /// 从逗号分隔字符串中取第 index 个字段值。
    fun intFromFieldAt(text: String, index: Int): Int {
        var fieldIdx: Int = 0
        var fieldStart: Int = 0
        var i: Int = 0
        val len = text.length
        while (i <= len) {
            val c: Int = if (i < len) text.charCodeAt(i) else 44 // 44 = ','
            if (c == 44) {
                if (fieldIdx == index) {
                    // 解析 fieldStart..i 为整数
                    var result: Int = 0
                    var neg: Boolean = false
                    var j: Int = fieldStart
                    if (j < i && text.charCodeAt(j) == 45) { // 45 = '-'
                        neg = true
                        j = j + 1
                    }
                    while (j < i) {
                        val cc: Int = text.charCodeAt(j)
                        if (cc >= 48 && cc <= 57) { // '0'-'9'
                            result = result * 10 + (cc - 48)
                        }
                        j = j + 1
                    }
                    if (neg) { result = -result }
                    return result
                }
                fieldIdx = fieldIdx + 1
                fieldStart = i + 1
            }
            i = i + 1
        }
        return 0
    }

    /// 判断地址是否有效（非零）。
    fun isValidAddress(addr: Int): Boolean {
        return addr != 0
    }

    /// 判断是否为可执行地址（已注册到分派表）。
    fun isDispatchable(entry: Int): Boolean {
        return entry != 0
    }
}
