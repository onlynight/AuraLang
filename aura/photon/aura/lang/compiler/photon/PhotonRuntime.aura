        writer.appendFunction(encCC.toHex(), "OptimizationLevel", PhotonObjectWriterUtils.joinRelocRecords(encCC.getRelocations()))
        encCC = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitClassConstructor(encCC, 128)
        writer.appendFunction(encCC.toHex(), "CEmitter", PhotonObjectWriterUtils.joinRelocRecords(encCC.getRelocations()))
        encCC = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitClassConstructor(encCC, 128)
        writer.appendFunction(encCC.toHex(), "LlvmEmitter", PhotonObjectWriterUtils.joinRelocRecords(encCC.getRelocations()))
        encCC = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitClassConstructor(encCC, 256)
        writer.appendFunction(encCC.toHex(), "PhotonPipeline", PhotonObjectWriterUtils.joinRelocRecords(encCC.getRelocations()))
        encCC = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitClassConstructor(encCC, 256)
        writer.appendFunction(encCC.toHex(), "PhotonObjectWriter", PhotonObjectWriterUtils.joinRelocRecords(encCC.getRelocations()))
        encCC = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitClassConstructor(encCC, 128)
        writer.appendFunction(encCC.toHex(), "PhotonSystemLinker", PhotonObjectWriterUtils.joinRelocRecords(encCC.getRelocations()))
        encCC = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitClassConstructor(encCC, 64)
        writer.appendFunction(encCC.toHex(), "PhotonLldConfig", PhotonObjectWriterUtils.joinRelocRecords(encCC.getRelocations()))
        encCC = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitClassConstructor(encCC, 256)
        writer.appendFunction(encCC.toHex(), "AotCodeGenerator", PhotonObjectWriterUtils.joinRelocRecords(encCC.getRelocations()))
        encCC = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitClassConstructor(encCC, 64)
        writer.appendFunction(encCC.toHex(), "AotExeResult", PhotonObjectWriterUtils.joinRelocRecords(encCC.getRelocations()))
        encCC = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitClassConstructor(encCC, 64)
        writer.appendFunction(encCC.toHex(), "AotLinkResult", PhotonObjectWriterUtils.joinRelocRecords(encCC.getRelocations()))
        encCC = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitClassConstructor(encCC, 256)
        writer.appendFunction(encCC.toHex(), "AotModuleLinker", PhotonObjectWriterUtils.joinRelocRecords(encCC.getRelocations()))
        encCC = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitClassConstructor(encCC, 64)
        writer.appendFunction(encCC.toHex(), "AotOptions", PhotonObjectWriterUtils.joinRelocRecords(encCC.getRelocations()))
        encCC = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitClassConstructor(encCC, 64)
        writer.appendFunction(encCC.toHex(), "AotResult", PhotonObjectWriterUtils.joinRelocRecords(encCC.getRelocations()))
        encCC = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitClassConstructor(encCC, 64)
        writer.appendFunction(encCC.toHex(), "BackendResult", PhotonObjectWriterUtils.joinRelocRecords(encCC.getRelocations()))
        encCC = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitClassConstructor(encCC, 128)
        writer.appendFunction(encCC.toHex(), "JitBackend", PhotonObjectWriterUtils.joinRelocRecords(encCC.getRelocations()))
        encCC = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitClassConstructor(encCC, 256)
        writer.appendFunction(encCC.toHex(), "JitCoreCompiler", PhotonObjectWriterUtils.joinRelocRecords(encCC.getRelocations()))
        encCC = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitClassConstructor(encCC, 256)
        writer.appendFunction(encCC.toHex(), "JitCoreVm", PhotonObjectWriterUtils.joinRelocRecords(encCC.getRelocations()))
        encCC = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitClassConstructor(encCC, 64)
        writer.appendFunction(encCC.toHex(), "JitLinkResult", PhotonObjectWriterUtils.joinRelocRecords(encCC.getRelocations()))
        val encOpen = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitOpen(encOpen)
        writer.appendFunction(encOpen.toHex(), "io_open", PhotonObjectWriterUtils.joinRelocRecords(encOpen.getRelocations()))
        val encClose = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitClose(encClose)
        writer.appendFunction(encClose.toHex(), "io_close", PhotonObjectWriterUtils.joinRelocRecords(encClose.getRelocations()))
        val encRead = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitRead(encRead)
        writer.appendFunction(encRead.toHex(), "io_read", PhotonObjectWriterUtils.joinRelocRecords(encRead.getRelocations()))
        val encWrite = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitWrite(encWrite)
        writer.appendFunction(encWrite.toHex(), "io_write", PhotonObjectWriterUtils.joinRelocRecords(encWrite.getRelocations()))
        val encAcc = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitAccess(encAcc)
        writer.appendFunction(encAcc.toHex(), "io_access", PhotonObjectWriterUtils.joinRelocRecords(encAcc.getRelocations()))
        val encEG = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitExitGroup(encEG)
        writer.appendFunction(encEG.toHex(), "exitGroup", PhotonObjectWriterUtils.joinRelocRecords(encEG.getRelocations()))
        // Memory 内置函数
        val encMw = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitMemoryWrite(encMw)
        writer.appendFunction(encMw.toHex(), "Memory_write", PhotonObjectWriterUtils.joinRelocRecords(encMw.getRelocations()))
        val encMr = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitMemoryRead(encMr)
        writer.appendFunction(encMr.toHex(), "Memory_read", PhotonObjectWriterUtils.joinRelocRecords(encMr.getRelocations()))
        val encMw16 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitMemoryWrite16(encMw16)
        writer.appendFunction(encMw16.toHex(), "Memory_write16", PhotonObjectWriterUtils.joinRelocRecords(encMw16.getRelocations()))
        val encMr16 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitMemoryRead16(encMr16)
        writer.appendFunction(encMr16.toHex(), "Memory_read16", PhotonObjectWriterUtils.joinRelocRecords(encMr16.getRelocations()))
        val encMw32 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitMemoryWrite32(encMw32)
        writer.appendFunction(encMw32.toHex(), "Memory_write32", PhotonObjectWriterUtils.joinRelocRecords(encMw32.getRelocations()))
        val encMr32 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitMemoryRead32(encMr32)
        writer.appendFunction(encMr32.toHex(), "Memory_read32", PhotonObjectWriterUtils.joinRelocRecords(encMr32.getRelocations()))
        val encMw64 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitMemoryWrite64(encMw64)
        writer.appendFunction(encMw64.toHex(), "Memory_write64", PhotonObjectWriterUtils.joinRelocRecords(encMw64.getRelocations()))
        val encMr64 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitMemoryRead64(encMr64)
        writer.appendFunction(encMr64.toHex(), "Memory_read64", PhotonObjectWriterUtils.joinRelocRecords(encMr64.getRelocations()))
        val encMa = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitMemoryAlloc(encMa)
        writer.appendFunction(encMa.toHex(), "Memory_alloc", PhotonObjectWriterUtils.joinRelocRecords(encMa.getRelocations()))
        val encMf = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitMemoryFree(encMf)
        val encMaa = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitMemoryAtomicAdd(encMaa)
        writer.appendFunction(encMaa.toHex(), "Memory_atomicAdd", PhotonObjectWriterUtils.joinRelocRecords(encMaa.getRelocations()))
        val encMinc = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitMemoryArcIncrement(encMinc)
        writer.appendFunction(encMinc.toHex(), "Memory_arcIncrement", PhotonObjectWriterUtils.joinRelocRecords(encMinc.getRelocations()))
        val encMdec = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitMemoryArcDecrement(encMdec)
        writer.appendFunction(encMdec.toHex(), "Memory_arcDecrement", PhotonObjectWriterUtils.joinRelocRecords(encMdec.getRelocations()))
        val encMmap = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitMemoryMmap(encMmap)
        writer.appendFunction(encMmap.toHex(), "Memory_mmap", PhotonObjectWriterUtils.joinRelocRecords(encMmap.getRelocations()))
        val encMunmap = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitMemoryMunmap(encMunmap)
        writer.appendFunction(encMunmap.toHex(), "Memory_munmap", PhotonObjectWriterUtils.joinRelocRecords(encMunmap.getRelocations()))
        writer.appendFunction(encMf.toHex(), "Memory_free", PhotonObjectWriterUtils.joinRelocRecords(encMf.getRelocations()))
        // CLI 参数函数
        val encArgCount = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitCliArgCount(encArgCount)
        writer.appendFunction(encArgCount.toHex(), "cliArgCount", PhotonObjectWriterUtils.joinRelocRecords(encArgCount.getRelocations()))
        val encArg = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitCliArg(encArg)
        writer.appendFunction(encArg.toHex(), "cliArg", PhotonObjectWriterUtils.joinRelocRecords(encArg.getRelocations()))
        for (symName in listOf("fork", "execve", "wait4")) {
            val encS = X86EncoderUtils.emptyEncoder()
            PhotonRuntime.emitStubMinus1(encS)
            writer.appendFunction(encS.toHex(), symName, PhotonObjectWriterUtils.joinRelocRecords(encS.getRelocations()))
        }
        val encThrow = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitThrow(encThrow)
        writer.appendFunction(encThrow.toHex(), "__throw", PhotonObjectWriterUtils.joinRelocRecords(encThrow.getRelocations()))
        // P0-2：heapArena 耗尽处理器（明确报错 + exit(70)，替代静默 NULL/段错误）
        val encHoom = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitHeapOom(encHoom)
        writer.appendFunction(encHoom.toHex(), "__heap_oom", PhotonObjectWriterUtils.joinRelocRecords(encHoom.getRelocations()))
        // P0-2b：堆基址/容量变量化后的初始化与扩容采纳函数
        val encHinit = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitHeapInit(encHinit)
        writer.appendFunction(encHinit.toHex(), "Heap_init", PhotonObjectWriterUtils.joinRelocRecords(encHinit.getRelocations()))
        // P0-2b：Heap_init 扩容路径专用 mmap（正确 0x18 槽位，见 emitHeapMmap）
        val encHmmap = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitHeapMmap(encHmmap)
        writer.appendFunction(encHmmap.toHex(), "Heap_mmap", PhotonObjectWriterUtils.joinRelocRecords(encHmmap.getRelocations()))
        val encAl = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitArrayListOf(encAl)
        writer.appendFunction(encAl.toHex(), "arrayListOf", PhotonObjectWriterUtils.joinRelocRecords(encAl.getRelocations()))
        val encCii = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitCollectionIndexOf(encCii)
        val encCc = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitCollectionContains(encCc)
        val encCmk = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitCollectionMapContainsKey(encCmk)
        val encCga = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitCollectionsGetAt(encCga)
        // 真正的 `Env.get`（见 `emitEnvGet`）：自举产物的 CLI 参数通道
        val encEg = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitEnvGetWin32(encEg)
        writer.appendFunction(encEg.toHex(), "env_get", PhotonObjectWriterUtils.joinRelocRecords(encEg.getRelocations()))
        // 2026-10-02 自举链接修复：`String.fromCharCode` 与 Process.argv 桩
        //（argCount/args 走 CLI 的 Env 回退通道，见 `emitProcArgCountStub` 说明）
        val encFcc = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitFromCharCode(encFcc)
        writer.appendFunction(encFcc.toHex(), "String_fromCharCode", PhotonObjectWriterUtils.joinRelocRecords(encFcc.getRelocations()))
        val encPa0 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitProcArgCountStub(encPa0)
        writer.appendFunction(encPa0.toHex(), "ProcessOps_aura_process_argCount", PhotonObjectWriterUtils.joinRelocRecords(encPa0.getRelocations()))
        val encPa1 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitProcArgsStub(encPa1)
        writer.appendFunction(encPa1.toHex(), "ProcessOps_aura_process_args", PhotonObjectWriterUtils.joinRelocRecords(encPa1.getRelocations()))
        val encSs = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitStringSubstring(encSs)
        writer.appendFunction(encSs.toHex(), "String_substring", PhotonObjectWriterUtils.joinRelocRecords(encSs.getRelocations()))
        // 2026-10-08 P1-3：`String_startsWith/charAt/trim/substringAfter/
        // substringBefore/split` 不再从 runtime emit。前端闭包通过
        // `import aura.lang.std.String` 从 stdlib 拿到这些方法的真实定义，
        // 同时 emit 会造成 `duplicate symbol`（实测 P1-3 首次链接）。
        // emit* 函数体保留供精简宿主使用。
        // 2026-10-08 P1-3：编译器前端闭包里的裸整数工具（SsaBuilder.synthesizeCtors
        // 的 min / analyzePhiPreds 的 or 等）；缺一条即 `undefined symbol`。
        val encMi = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitMin(encMi)
        writer.appendFunction(encMi.toHex(), "min", PhotonObjectWriterUtils.joinRelocRecords(encMi.getRelocations()))
        val encMa = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitMax(encMa)
        writer.appendFunction(encMa.toHex(), "max", PhotonObjectWriterUtils.joinRelocRecords(encMa.getRelocations()))
        val encOr = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitOr(encOr)
        writer.appendFunction(encOr.toHex(), "or", PhotonObjectWriterUtils.joinRelocRecords(encOr.getRelocations()))
        val encAn = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitAnd(encAn)
        writer.appendFunction(encAn.toHex(), "and", PhotonObjectWriterUtils.joinRelocRecords(encAn.getRelocations()))
        // 2026-10-08 P1-3：`JitExec.callI64/call0`——Photon HAT 后端把 extern
        // interface 当普通函数符号发射；AOT 侧由 Rust 编译器直接 inttoptr
        // 落地，但 Photon 需要 runtime 桩提供同样的间接 call 语义。
        val encJrx = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitJitExecAllocRWX(encJrx)
        writer.appendFunction(encJrx.toHex(), "JitExec_allocRWX", PhotonObjectWriterUtils.joinRelocRecords(encJrx.getRelocations()))
        val encJc1 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitJitExecCallI64(encJc1)
        writer.appendFunction(encJc1.toHex(), "JitExec_callI64", PhotonObjectWriterUtils.joinRelocRecords(encJc1.getRelocations()))
        val encJc0 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitJitExecCall0(encJc0)
        writer.appendFunction(encJc0.toHex(), "JitExec_call0", PhotonObjectWriterUtils.joinRelocRecords(encJc0.getRelocations()))
        val encJa = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitJitExecAllocRW(encJa)
        writer.appendFunction(encJa.toHex(), "JitExec_allocRW", PhotonObjectWriterUtils.joinRelocRecords(encJa.getRelocations()))
        val encJp2 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitJitExecProtect(encJp2)
        writer.appendFunction(encJp2.toHex(), "JitExec_protect", PhotonObjectWriterUtils.joinRelocRecords(encJp2.getRelocations()))
        // 单例槽读写（见 `emitObjSlotGet` / `emitObjSlotSet`）：早前会话的
        // `synthesizeSingletonGetter` 只发调用点，实现必须由 runtime 提供。
        val encOsg = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitObjSlotGet(encOsg)
        writer.appendFunction(encOsg.toHex(), "__obj_slot_get", PhotonObjectWriterUtils.joinRelocRecords(encOsg.getRelocations()))
        val encOss = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitObjSlotSet(encOss)
        writer.appendFunction(encOss.toHex(), "__obj_slot_set", PhotonObjectWriterUtils.joinRelocRecords(encOss.getRelocations()))
        // Memory.copy / Memory.mprotect（见 `emitMemoryCopy` / `emitMemoryMprotect`）
        val encMcp = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitMemoryCopy(encMcp)
        writer.appendFunction(encMcp.toHex(), "Memory_copy", PhotonObjectWriterUtils.joinRelocRecords(encMcp.getRelocations()))
        val encMpr = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitMemoryMprotect(encMpr)
        writer.appendFunction(encMpr.toHex(), "Memory_mprotect", PhotonObjectWriterUtils.joinRelocRecords(encMpr.getRelocations()))
        // POSIX 进程原语桩（见 `emitProcessOpsUnsupported`）
        val encPoe = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitProcessOpsUnsupported(encPoe)
        writer.appendFunction(encPoe.toHex(), "ProcessOps_execve", PhotonObjectWriterUtils.joinRelocRecords(encPoe.getRelocations()))
        val encPof = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitProcessOpsUnsupported(encPof)
        writer.appendFunction(encPof.toHex(), "ProcessOps_fork", PhotonObjectWriterUtils.joinRelocRecords(encPof.getRelocations()))
        val encPow = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitProcessOpsUnsupported(encPow)
        writer.appendFunction(encPow.toHex(), "ProcessOps_wait4", PhotonObjectWriterUtils.joinRelocRecords(encPow.getRelocations()))
        val encCcnt = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitCollectionCount(encCcnt)
        val encCclr = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitCollectionClear(encCclr)
        val encChp = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitCollectionHashMapPut(encChp)
        writer.appendFunction(encChp.toHex(), "Collections_hashMapPut", PhotonObjectWriterUtils.joinRelocRecords(encChp.getRelocations()))
        val encCla = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitCollectionListAppend(encCla)
        val encTr = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitTransform(encTr)
        writer.appendFunction(encTr.toHex(), "transform", PhotonObjectWriterUtils.joinRelocRecords(encTr.getRelocations()))
        val encFc = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitFromCharCode(encFc)
        writer.appendFunction(encFc.toHex(), "fromCharCode", PhotonObjectWriterUtils.joinRelocRecords(encFc.getRelocations()))
        val encRcs = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitReadCStr(encRcs)
        writer.appendFunction(encRcs.toHex(), "ReadCStr", PhotonObjectWriterUtils.joinRelocRecords(encRcs.getRelocations()))
        val encMem = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitAuraMemUsedMb(encMem)
        writer.appendFunction(encMem.toHex(), "aura_mem_used_mb", PhotonObjectWriterUtils.joinRelocRecords(encMem.getRelocations()))
        val encHb = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitAuraHeapBump(encHb)
        writer.appendFunction(encHb.toHex(), "aura_heapbump", PhotonObjectWriterUtils.joinRelocRecords(encHb.getRelocations()))
        // .data: toStrBuffer(32) + heapArena(1048576) + heapBump(8) + objBump(8)
        writer.dataSection = ""
        writer.dataSymbolName = "toStrBuffer:32,oomMsg:24,heapMbName:24,heapArenaBase:8,heapCap:8,heapBump:8,objBump:8,envBuffer:4096,objSlots:4096,vehFlag:8,crashBuf:4096,allocRing:512,allocRingIdx:8,strRing:4096,strRingIdx:8,tStrRing:512,tStrRingIdx:8,canaryCount:8,canaryBuf:32"
        // runtime 对象自带**一个空串常量** `@str.0`。
        //
        // ⚠️ 必须显式给：`Collections.getAt`（`Env.get` 的落点，见 `emitCollectionsGetAt`）
        // 里有一条 `lea rax, @str.0`。runtime 对象的 `stringConsts` 原本为空 ⇒
        // 符号表里没有 `@str.0` ⇒ `composeRelocations` 查不到符号名就把该重定位
        // **静默丢弃**（实测 runtime 侧 `dropped=1 sym=[@str.0]`）⇒ 指令位移保持
        // 占位值 0 ⇒ 该「空串」指针实际指向**紧随其后的代码字节** ⇒ 自举
        // `Main.exe` 在 `main` 的 `cliArgCount()` → `Env.get` 里对它做
        // `strlen`/`charCodeAt` 越界 ⇒ `0xC0000005`（`BOOT-1` 之后立刻崩）。
        //
        // 常量池编码是「`<十进制长度>|<载荷>` 首尾相接」，空载荷即 `0|`。
        writer.stringConsts = "0|"
        writer.bssSymbolName = "heapArena:67108864"  // [MEM-FIX] 静态堆 → .bss（文件零字节,加载器零填充）
        writer.buildSymbols(writer.functions, writer.stringConsts)
        writer.emit()
        return writer.writeObjectHexFile(path)
    }

    /// 生成用户代码目标文件并落盘为 hex 文本（同上，重新序列化落盘）
    fun writeMainObjectHexFile(text: String, path: String): Boolean {
        val enc = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitPrintMain(enc, text)
        val writer = PhotonObjectWriter()
        writer.emitFromMachineCode(
            enc.toHex(),
            PhotonObjectWriterUtils.joinRelocRecords(enc.getRelocations()),
            text,
            "main"
        )
        return writer.writeObjectHexFile(path)
    }
}

// ─────────────────────────────────────────────────────────────
// PhotonRuntimeUtils 顶层辅助函数（S1.6// ─────────────────────────────────────────────────────────────

object PhotonRuntimeUtils {

    /// 生成 runtime 目标文件并落盘为 hex 文本（供 compileHir 链接使用）
    fun writeRuntimeObjectHexFile(path: String): Boolean {
        val writer = PhotonObjectWriter()

        val enc1 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitPrintln(enc1)
        writer.appendFunction(enc1.toHex(), "println", PhotonObjectWriterUtils.joinRelocRecords(enc1.getRelocations()))

        val enc2 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitPrint(enc2)
        writer.appendFunction(enc2.toHex(), "print", PhotonObjectWriterUtils.joinRelocRecords(enc2.getRelocations()))

        val enc3 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitPuts(enc3)
        writer.appendFunction(enc3.toHex(), "puts", PhotonObjectWriterUtils.joinRelocRecords(enc3.getRelocations()))

        val enc4 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitToStr(enc4)
        writer.appendFunction(enc4.toHex(), "toStr", PhotonObjectWriterUtils.joinRelocRecords(enc4.getRelocations()))

        val enc4b = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitStrcat(enc4b)
        writer.appendFunction(enc4b.toHex(), "strcat", PhotonObjectWriterUtils.joinRelocRecords(enc4b.getRelocations()))

        val enc5 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitToInt(enc5)
        writer.appendFunction(enc5.toHex(), "toInt", PhotonObjectWriterUtils.joinRelocRecords(enc5.getRelocations()))

        val enc6 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitToFloat(enc6)
        writer.appendFunction(enc6.toHex(), "toFloat", PhotonObjectWriterUtils.joinRelocRecords(enc6.getRelocations()))

        val enc7 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitToString(enc7)
        writer.appendFunction(enc7.toHex(), "toString", PhotonObjectWriterUtils.joinRelocRecords(enc7.getRelocations()))
        val enc7b = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitBoolToStr(enc7b)
        writer.appendFunction(enc7b.toHex(), "boolToStr", PhotonObjectWriterUtils.joinRelocRecords(enc7b.getRelocations()))

        val enc7c = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitCharToStr(enc7c)
        writer.appendFunction(enc7c.toHex(), "charToStr", PhotonObjectWriterUtils.joinRelocRecords(enc7c.getRelocations()))

        val enc7d = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitAuraIsOfType(enc7d)
        writer.appendFunction(enc7d.toHex(), "aura_isOfType", PhotonObjectWriterUtils.joinRelocRecords(enc7d.getRelocations()))

        val enc7e = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitPtrToInt(enc7e)
