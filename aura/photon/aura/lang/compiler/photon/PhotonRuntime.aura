// aura:///aura/lang/compiler/photon/PhotonRuntime.aura
package aura.lang.compiler.photon
// ─────────────────────────────────────────────────────────────
// Photon 最runtime（Phase E3//
// 提供 `println(ptr)` —目前唯一用真实机器码实现的运行时函数// 作为「Aura 用户代码 调用 runtime 直连 kernel32」这条链路的验证载体//
// 之所以现在能实现：编码器已支*函数内局部标签与跳转**
// （见 X86Encoder.emitLabel / emitJmpLabel / emitJccLabel），
// 因而可以写出扫NUL strlen 循环//
// ── 调用约定（Windows x64）──
//
//   println(rcx = char*)   无返回//
// ── 栈帧布局（sub rsp, 0x50）──
//
//   [rsp, rsp+0x20)   影子空间（shadow space）—被调函数可任意改写，禁止放局部变量！
//   [rbp-0x30]        5 个参数的入栈槽（= rsp+0x20，调用时须为 NULL//   [rbp-0x28]        hStdOut
//   [rbp-0x20]        入参指针
//   [rbp-0x18]        字符串长度（strlen 结果//   [rbp-0x10]        栈上构造的换行符（0x0D 0x0A//
// ⚠️ 踩坑记录：最初用 `sub rsp,0x30` 并把 hStdOut/ptr/len 放在
// [rbp-0x18]/[rbp-0x20]/[rbp-0x28]，结果这些槽位正好落在被调函数的
// **影子空间**—WriteFile 溢出 rcx/rdx/r8/r9 时把它们全写// （[rbp-0x28]←rdx、[rbp-0x20]←r8、[rbp-0x18]←r9），
// 表现为「第一WriteFile 正常、第二次静默失败」// 结论：局部变量必须放[rsp+0x20, rbp) 区间，即影子空间**之上**//
// 对齐：`push rbp` rbp 0 (mod 16)，`sub rsp,0x50`0 16 的倍数// rsp 0 (mod 16)，满call 前的 16 字节对齐要求// ─────────────────────────────────────────────────────────────

import aura.lang.std.String

import aura.lang.compiler.photon.x86_64.X86Encoder
import aura.lang.compiler.photon.PhotonObjectWriter
import aura.lang.compiler.photon.SyscallEmitter

object PhotonRuntime {

    /// 帧大小：0xB8 = 184 字节
    ///
    /// 布局（rsp = rbp - 0xB8）：
    ///   [rbp-0xB8, rbp-0x98)  影子空间 shadow space2 字节）—syscall 前必须为
    ///   [rbp-0x98, rbp-0x90)  8 字节对齐填充（rsp+0x20，不可用
    ///   [rbp-0x90, rbp-0x58)  NtWriteFile 栈参数（arg5..arg10
    ///     -0x90 = IoStatusBlock ptr    rsp+0x28
    ///     -0x88 = Buffer               rsp+0x30
    ///     -0x80 = Length               rsp+0x38
    ///     -0x78 = ByteOffset           rsp+0x40
    ///     -0x70 = Key                  rsp+0x48
    ///     -0x68 = EaLength             rsp+0x50
    ///   [rbp-0x58, rbp)       局部变量（必须落在 rsp+0x60 之上，避开参数与影子空间）
    ///     -0x58 = IoStatusBlock 存储6 字节
    ///     -0x40 = 入参指针
    ///     -0x38 = strlen 结果
    ///     -0x30 = hStdOutput
    ///     -0x28 = 换行符缓冲区 字节
    ///
    /// 对齐推导：函数入rsp 8 (mod 16)；`push rbp` rsp 0
    /// `mov rbp, rsp` rbp 0；`sub rsp, 0xB8`84 % 16 == 8）后
    /// rsp 8 (mod 16) —正是 Windows x64 ABI syscall 的要求
    ///
    /// ⚠️ 历史踩坑（两连错）：
    ///   1. 早先 arg5 放在 rsp+0x20，落*影子空间**内，NtWriteFile 读到 IoStatusBlock=0
    ///   2. 改为 rsp+0x40 仍然错——x64 ABI arg5 起于 **rsp+0x28**（影子空间之8 字节），
    ///      不是 rsp+0x20 也不rsp+0x40。权威参照：mcountryman/min-sized-rust-windows
    ///      `mainCRTStartup` 裸汇编注释表 `arg5 IoStatusBlock @ rsp+0x28`，该程序可运行
    val FRAME_SIZE: Int = 0xB8

    /// NtWriteFile 栈参数偏移（相对 rbp）
    ///
    /// 推导：rsp = rbp - 0xB8，故 rsp+0x28 = rbp - 0x90，依+8 排列
    /// ⚠️ arg5 起于 rsp+0x28（影子空间之8 字节），不是 rsp+0x20 也不rsp+0x40
    val OFF_ARG5: Int = -0x90   // rsp+0x28 = IoStatusBlock ptr
    val OFF_ARG6: Int = -0x88   // rsp+0x30 = Buffer
    val OFF_ARG7: Int = -0x80   // rsp+0x38 = Length
    val OFF_ARG8: Int = -0x78   // rsp+0x40 = ByteOffset
    val OFF_ARG9: Int = -0x70   // rsp+0x48 = Key
    val OFF_ARG10: Int = -0x68  // rsp+0x50 = EaLength

    /// IoStatusBlock 存储区起始（16 字节，位rsp+0x60 之上，不与参数重叠）
    val OFF_IOBLOCK: Int = -0x58

    /// 入参指针保存槽
    val OFF_INPUT_PTR: Int = -0x40

    /// 字符串长度保存槽
    val OFF_LEN: Int = -0x38

    /// hStdOutput 保存槽
    val OFF_HSTDOUT: Int = -0x30

    /// 换行符缓冲区 字节x0D 0x0A）
    val OFF_NEWLINE: Int = -0x28

    /// STANDARD_PROCESS_INFORMATION 缓冲区（24 字节：hStdInput, hStdOutput, hStdError）
    ///
    /// 位于 [rbp-0x20, rbp-0x00)，不与参数（arg5..arg10）和局部变量冲突
    val OFF_INFOBUF: Int = -0x20

    // ── println 实现 ──

    /// 编码 `println(rcx = char*)`
    ///
    /// ```asm
    /// println:
    ///   push rbp; mov rbp, rsp; sub rsp, 0x50
    ///   mov  [rbp-0x20], rcx          ; 保存入参指针
    ///   mov  rdx, rcx                 ; rdx 作为扫描指针
    /// pl_strlen_loop:
    ///   cmp  byte [rdx], 0
    ///   je   pl_strlen_done
    ///   inc  rdx
    ///   jmp  pl_strlen_loop
    /// pl_strlen_done:
    ///   sub  rdx, rcx                 ; rdx = 长度
    ///   mov  [rbp-0x18], rdx
    ///   mov  ecx, -11                 ; STD_OUTPUT_HANDLE
    ///   call [rip+__imp_GetStdHandle]
    ///   mov  [rbp-0x28], rax          ; hStdOut
    ///   ; WriteFile(hStdOut, ptr, len, NULL, NULL)
    ///   mov  rcx, [rbp-0x28]
    ///   mov  rdx, [rbp-0x20]
    ///   mov  r8,  [rbp-0x18]
    ///   xor  r9, r9
    ///   mov  [rbp-0x30], r9
    ///   call [rip+__imp_WriteFile]
    ///   ; 追加换行：WriteFile(hStdOut, "\r\n", 2, NULL, NULL)
    ///   mov  byte [rbp-0x10], 0x0D
    ///   mov  byte [rbp-0x0F], 0x0A
    ///   mov  rcx, [rbp-0x28]
    ///   lea  rdx, [rbp-0x10]
    ///   mov  r8d, 2
    ///   xor  r9, r9
    ///   mov  [rbp-0x30], r9
    ///   call [rip+__imp_WriteFile]
    ///   leave; ret
    /// ```
    // ── 栈帧 canary 报告器（2026-10-06，P0-2 系统性定位首次越界写）──
    //
    // `canary_report(rcx=kind, rdx=funcIdx, r8=value)`：由 X86Emitter 在每个
    // 客户函数的 prologue/epilogue 插桩后调用，**无条件调用、由本函数判定是否
    // 违例**（客户端不分支，避免在 epilogue 处编码跳转链）。
    //
    // kind：
    //   1 = 帧哨兵（value = 实际读到的槽值；违例 ⇔ value != 0x5C5C5C5C）
    //   2 = 返回地址（value = [rbp+8]；违例 ⇔ 不在镜像 .text 内）
    //   3 = 保存寄存器异或差（value = shadow ⊕ reg；违例 ⇔ value != 0）
    //
    // 记录：32 字节 = magic("CAN1")|kind|funcIdx|value，WriteFile 直落 stdout，
    // 与 VEH 的 crashBuf 记录同风格（od 解析）。累计 24 条后静默（防刷屏）。
    // 仅碰易失寄存器（rax rcx rdx r8-r11）+ 栈参数槽，prologue/epilogue 标准。
    fun emitCanaryReport(enc: X86Encoder): Unit {
        enc.emitPrologue(0x50)
        // canaryCount++（单线程，无原子性要求）
        enc.emitMovRIP("rax", "canaryCount")
        enc.emitAddRI("rax", 1)
        enc.emitStoreRIP("canaryCount", "rax")
        enc.emitCmpRI("rax", 24)
        enc.emitJccLabel("a", "cr_done")   // 报满 24 条后静默
        // 按 kind 分派
        enc.emitCmpRI("rcx", 1)
        enc.emitJccLabel("eq", "cr_k1")
        enc.emitCmpRI("rcx", 2)
        enc.emitJccLabel("eq", "cr_k2")
        enc.emitCmpRI("rcx", 3)
        enc.emitJccLabel("eq", "cr_k3")
        enc.emitJmpLabel("cr_done")
        // kind1：帧哨兵。哨兵常量取 0x5C5C5C5C（正数 ⇒ C7 imm32 符号扩展后
        // 与零扩展值一致，两端无需 movabs）。
        enc.emitLabel("cr_k1")
        enc.emitMovRI("r9", 1550766684)
        enc.emitCmpRR("r8", "r9")
        enc.emitJccLabel("eq", "cr_done")
        enc.emitJmpLabel("cr_write")
        // kind2：返回地址必须落在镜像 .text。no-ASLR 基址固定 0x140000000，
        // 范围 [0x140001000, 0x140080000) ⇔ 高32位==1 且 低32位 ∈
        // [0x40001000, 0x40080000)。⚠️ 低 32 位比较前必须**清零高位**
        //（shl+shr 成对）：64 位全值与 imm32 比较时高 dword 恒 ≥ 1，
        // 上下界双双失真（实测设计稿踩坑，2026-10-06）。
        enc.emitLabel("cr_k2")
        enc.emitMovRR("r9", "r8")
        enc.emitShrRI("r9", 32)
        enc.emitCmpRI("r9", 1)
        enc.emitJccLabel("ne", "cr_write")
        enc.emitMovRR("r9", "r8")
        enc.emitShlRI("r9", 32)
        enc.emitShrRI("r9", 32)
        enc.emitCmpRI("r9", 0x40001000)
        enc.emitJccLabel("b", "cr_write")
        enc.emitCmpRI("r9", 0x40080000)
        enc.emitJccLabel("ae", "cr_write")
        enc.emitJmpLabel("cr_done")
        // kind3：异或差非 0 即违例
        enc.emitLabel("cr_k3")
        enc.emitCmpRI("r8", 0)
        enc.emitJccLabel("eq", "cr_done")
        // 落记录（32 字节：magic|kind|funcIdx|value）。⚠️ 入参 a 在 rdx，
        // 先挪 r11 再复用 rdx 装缓冲区地址。
        enc.emitLabel("cr_write")
        enc.emitMovRR("r11", "rdx")
        enc.emitLeaRIP("rdx", "canaryBuf")
        enc.emitMovRI32("r10d", 0x43414E31)   // "CAN1"
        enc.emitStoreMemDisp32("rdx", 0, "r10")
        enc.emitStoreMemDisp32("rdx", 8, "rcx")    // kind
        enc.emitStoreMemDisp32("rdx", 16, "r11")   // funcIdx
        enc.emitStoreMemDisp32("rdx", 24, "r8")    // value
        // WriteFile(hStdout, canaryBuf, 32, crashBuf+56, NULL)
        enc.emitMovRI("ecx", -11)
        enc.emitCallImport("GetStdHandle")
        enc.emitMovRR("rcx", "rax")
        enc.emitLeaRIP("rdx", "canaryBuf")
        enc.emitMovRI32("r8d", 32)
        enc.emitLeaRIP("r9", "crashBuf")
        enc.emitAddRI("r9", 56)                    // written 计数槽
        enc.emitXorRR("r10", "r10")
        enc.emitStoreMemDisp32("rsp", 32, "r10")   // 第 5 参 = NULL
        enc.emitCallImport("WriteFile")
        enc.emitLabel("cr_done")
        enc.emitEpilogue()
    }

    // ── else-if 链修复后暴露的内建/原生桩（2026-10-06，P0-2）──
    //
    // lowerBranch 的 If 用例修复让先前被静默丢弃的分支活了，其中一批裸名
    // 调用（编译器内建 / std 原生）第一次真正到达链接期。此处补最小实现：
    //
    //  * `typeof(v)`：Plan A 值模型折叠 —— null→"Null"、奇数（装箱 Int，
    //    `(v<<1)|1`）→"Int"、否则→"String"。真实类型标签需要运行时元数据，
    //    装载链路径只依赖 isString（下游自带奇偶守卫，见 VmOps.isString）。
    //  * `__is_tagged_int(v)`：`v & 1`（Plan A 装箱整数判定，见 VmOps.isTaggedInt）。
    //  * `Clock_clockGettime` / `ThreadOps_create`：返回 -1（不支持）——
    //    clockNowMs 对 rc!=0 已有 0 值回退；threadSpawn 不在装载链路径。
    //  * `IO_readFile` / `IO_writeFile`：读返回空串常量（@str.0）、写返回 0
    //    —— 装载链不触达；真实文件 I/O 走 io_* 原生（后续任务）。
    //
    // 前四个是叶子函数：不碰栈、无 prologue（ret 前无需 leave）。
    fun emitTypeOfPlanA(enc: X86Encoder): Unit {
        enc.emitCmpRI("rcx", 0)
        enc.emitJccLabel("ne", "to_notnull")
        enc.emitLeaRIP("rax", "@str.1")   // "Null"
        enc.emitRet()
        enc.emitLabel("to_notnull")
        enc.emitMovRR("rax", "rcx")
        enc.emitAndRI("rax", 1)
        enc.emitCmpRI("rax", 1)
        enc.emitJccLabel("ne", "to_string")
        enc.emitLeaRIP("rax", "@str.2")   // "Int"
        enc.emitRet()
        enc.emitLabel("to_string")
        enc.emitLeaRIP("rax", "@str.3")   // "String"
        enc.emitRet()
    }

    fun emitIsTaggedInt(enc: X86Encoder): Unit {
        enc.emitMovRR("rax", "rcx")
        enc.emitAndRI("rax", 1)
        enc.emitRet()
    }

    fun emitClockGettimeStub(enc: X86Encoder): Unit {
        enc.emitMovRI("rax", -1)
        enc.emitRet()
    }

    fun emitThreadCreateStub(enc: X86Encoder): Unit {
        enc.emitMovRI("rax", -1)
        enc.emitRet()
    }

    /// ThreadOps 家族其余桩：join → -1、sleepMs → 0、currentId → 1、cores → 1。
    fun emitThreadOpsStubs(enc: X86Encoder): Unit {
        // 统一入口不现实（各符号独立导出），此处仅 join 一个形态；
        // 其余三个见 buildRuntimeObject 的追加（同形叶函数）。
        enc.emitMovRI("rax", -1)
        enc.emitRet()
    }

    fun emitIOReadFileStub(enc: X86Encoder): Unit {
        enc.emitLeaRIP("rax", "@str.0")   // 空串
        enc.emitRet()
    }

    fun emitIOWriteFileStub(enc: X86Encoder): Unit {
        enc.emitXorRR("eax", "eax")
        enc.emitRet()
    }

    /// VEH 显式安装：`veh_install()` —— 供 Aura wrapper 首行裸名调用
    ///（裸名经 resolveMethodSymbol 原样保留 → 链接到本符号）。
    fun emitVehInstall(enc: X86Encoder): Unit {
        enc.emitPrologue(0x40)
        enc.emitMovRI("ecx", 1)
        enc.emitLeaRIP("rdx", "aura_veh_handler")
        enc.emitCallImport("AddVectoredExceptionHandler")
        // 诊断：注册成功（rax 非 0）时向 stderr 写 VEHI 标记（5 字节）。
        // ⚠️ handle 暂存必须用**负**偏移（0x28 是正偏移 ⇒ 落到调用方帧区，
        // 覆盖 main 的局部变量——VEHI 后 [M2]→[M3] 段的 wandering 崩溃即
        // 由它引起，2026-10-06）。prologue 已 sub 0x40，-0x30 在本帧内。
        enc.emitStackStore(-0x30, "rax")
        enc.emitCmpRI("rax", 0)
        enc.emitJccLabel("eq", "vi_none")
        enc.emitMovRI("ecx", -11)
        enc.emitCallImport("GetStdHandle")
        enc.emitMovRR("rcx", "rax")                  // handle
        enc.emitLeaRIP("rdx", "crashBuf")            // buf（crashBuf 尾部）
        enc.emitMovRI32("r10d", 0x49484556)          // "VEHI"
        enc.emitStoreMemDisp32("rdx", 0, "r10")
        enc.emitMovRI32("r10d", 10)                  // LF
        enc.emitStoreMemDisp32("rdx", 4, "r10")
        enc.emitMovRI32("r8d", 5)                    // len
        enc.emitMovRR("r9", "rdx")
        enc.emitAddRI("r9", 48)                      // &written（crashBuf+48）
        enc.emitXorRR("r10", "r10")
        enc.emitStoreMemDisp32("rsp", 32, "r10")     // 第 5 参 = NULL
        enc.emitCallImport("WriteFile")
        enc.emitLabel("vi_none")
        enc.emitEpilogue()
    }

    /// VEH 回调：`aura_veh_handler(ExceptionInfo*)`。
    ///
    /// 只处理 0xC0000005：把 RIP（Context+0xF8）与异常访问地址
    /// （Record+0x18）作为 2×u64 原始记录写 crashBuf，经 WriteFile 落
    /// stderr，返回 0（CONTINUE_SEARCH，进程照常终止）。只碰易失寄存器；
    /// 栈布局：sub 0x50 = [rsp+0x20] WriteFile 第 5 参、[rsp+0x28] handle、
    /// [rsp+0x30] Record、[rsp+0x38] Context。
    fun emitVehHandler(enc: X86Encoder): Unit {
        // ⚠️ 入口 rsp%16=8（call 推了返回地址）：sub 0x58（%16=8）后 rsp%16=0，
        // 内部 GetStdHandle/WriteFile 调用才满足 16 字节对齐（sub 0x50 时
        // 不对齐 ⇒ SSE 指令崩溃 ⇒ handler 静默失效，2026-10-06）。
        enc.emitAddRI("rsp", -88)
        enc.emitMovMemDisp32("r10", "rcx", 0)        // r10 = ExceptionRecord
        enc.emitStoreMemDisp32("rsp", 48, "r10")
        enc.emitMovMemDisp32("r11", "rcx", 8)        // r11 = Context
        enc.emitStoreMemDisp32("rsp", 56, "r11")
        enc.emitMovMemDisp32("eax", "r10", 0)        // eax = ExceptionCode
        // 诊断（临时）：不过滤异常码，验证 handler 可达性
        // enc.emitCmpRI("eax", -1073741819)            // 0xC0000005
        // enc.emitJccLabel("ne", "avh_done")
        enc.emitMovRI("ecx", -11)                    // STD_OUTPUT_HANDLE
        enc.emitCallImport("GetStdHandle")
        enc.emitStoreMemDisp32("rsp", 40, "rax")     // handle
        enc.emitMovMemDisp32("r10", "rsp", 48)       // Record
        enc.emitMovMemDisp32("r11", "rsp", 56)       // Context
        enc.emitMovMemDisp32("rcx", "r11", 248)      // Context.Rip (+0xF8)
        enc.emitLeaRIP("rdx", "crashBuf")
        enc.emitStoreMemDisp32("rdx", 0, "rcx")
        enc.emitMovMemDisp32("rcx", "r10", 24)       // ExceptionInformation[1]
        enc.emitStoreMemDisp32("rdx", 8, "rcx")
        // 完整现场（2026-10-06）：ctx.rcx / ctx.rdx / ctx.rsp / [Rsp] / [Rsp+8]
        // CONTEXT 偏移：Rcx=0x80 Rdx=0x88 Rsp=0x98 Rip=0xF8。r11=Context、
        // r10=Record、rdx=crashBuf 均在本段起点有效，r8 作暂存。
        enc.emitMovMemDisp32("r8", "r11", 128)       // r8 = ctx.Rcx
        enc.emitStoreMemDisp32("rdx", 16, "r8")
        enc.emitMovMemDisp32("r8", "r11", 136)       // r8 = ctx.Rdx
        enc.emitStoreMemDisp32("rdx", 24, "r8")
        enc.emitMovMemDisp32("r11", "r11", 152)      // r11 = ctx.Rsp
        enc.emitStoreMemDisp32("rdx", 32, "r11")
        enc.emitMovMemDisp32("rcx", "r11", 0)        // [Rsp]   = 返回地址
        enc.emitStoreMemDisp32("rdx", 40, "rcx")
        enc.emitMovMemDisp32("rcx", "r11", 8)        // [Rsp+8]
        enc.emitStoreMemDisp32("rdx", 48, "rcx")
        enc.emitMovMemDisp32("rcx", "rsp", 40)       // handle
        enc.emitMovRI32("r8d", 56)
        enc.emitMovRR("r9", "rdx")
        enc.emitAddRI("r9", 56)                      // scratch（crashBuf+56）
        enc.emitXorRR("r10", "r10")
        enc.emitStoreMemDisp32("rsp", 32, "r10")     // lpOverlapped = 0
        enc.emitCallImport("WriteFile")
        enc.emitLabel("avh_done")
        enc.emitXorRR("eax", "eax")                  // CONTINUE_SEARCH
        enc.emitAddRI("rsp", 88)
        enc.emitRet()
    }

    fun emitPrintln(enc: X86Encoder): Unit {
        enc.emitPrologue(PhotonRuntime.FRAME_SIZE)

        // 保存入参指针
        enc.emitStackStore(PhotonRuntime.OFF_INPUT_PTR, "rcx")

        // strlen：扫描到 NUL
        enc.emitMovRR("rdx", "rcx")
        enc.emitXorRR("rax", "rax")
        enc.emitLabel("pl_strlen_loop")
        enc.emitCmpByteMemImm8("rdx", 0)
        enc.emitJccLabel("eq", "pl_strlen_done")
        enc.emitIncRR("rdx")
        enc.emitIncRR("rax")
        enc.emitJmpLabel("pl_strlen_loop")
        enc.emitLabel("pl_strlen_done")
        enc.emitStackStore(PhotonRuntime.OFF_LEN, "rax")

        // 获取 hStdOutput：PEB 走链（Windows 11 x64 正确偏移）
        //
        //   rax = gs:[0x60]          ; PEB（Windows x64 TEB PEB 指针的固定偏移）
        //   rax = [rax + 0x20]       ; PEB.ProcessParameters（RTL_USER_PROCESS_PARAMETERS*
        //   rax = [rax + 0x28]       ; RTL_USER_PROCESS_PARAMETERS.hStdOutput
        //
        // 偏移依据：Windows 10/11 x64 PEB.ProcessParameters 位于 +0x20
        // PROCESS_PARAMETERS.hOutput 位于 +0x28
        enc.emitMovGSSeg64("rax", 0x60)
              // rax = PEB
        enc.emitMovMemDisp8("rax", "rax", 0x20)
      // rax = ProcessParameters (PEB+0x20)
        enc.emitMovMemDisp8("rax", "rax", 0x28)
      // rax = hStdOutput (ProcessParameters+0x28)
        enc.emitStackStore(PhotonRuntime.OFF_HSTDOUT, "rax")

        // ── 第一NtWriteFile：写入字符串 ──
        //
        // 栈参数（x64 ABI：arg5 起于 rsp+0x20）：
        //   [rbp-0x98] = IoStatusBlock ptr   (rsp+0x20)
        //   [rbp-0x90] = Buffer              (rsp+0x28)
        //   [rbp-0x88] = Length              (rsp+0x30)
        //   [rbp-0x80] = ByteOffset = 0      (rsp+0x38)
        //   [rbp-0x78] = Key = 0             (rsp+0x40)
        //   [rbp-0x70] = EaBuffer = 0        (rsp+0x48)
        enc.emitLeaStack("rax", PhotonRuntime.OFF_IOBLOCK)
        enc.emitStackStore(PhotonRuntime.OFF_ARG5, "rax")
        enc.emitStackLoad("rax", PhotonRuntime.OFF_INPUT_PTR)
        enc.emitStackStore(PhotonRuntime.OFF_ARG6, "rax")
        enc.emitStackLoad("rax", PhotonRuntime.OFF_LEN)
        enc.emitStackStore(PhotonRuntime.OFF_ARG7, "rax")
        enc.emitXorRR("rax", "rax")
        enc.emitStackStore(PhotonRuntime.OFF_ARG8, "rax")
        enc.emitStackStore(PhotonRuntime.OFF_ARG9, "rax")
        // EaLength 必须显式清零：NtWriteFile 的第 10 个参数，若栈上残留非 0
        // 值，内核会尝试从 EaBuffer 复制扩展属性并导致访问违规
        enc.emitStackStore(PhotonRuntime.OFF_ARG10, "rax")

        // 寄存器设+ syscall
        // ⚠️ Windows x64 syscall *1 个参数必须放r10**
        // `syscall` 指令会把返回地址写进 rcx，因此内核从 r10 读取 arg1
        // （ntdll stub 正是 `mov r10, rcx` 后再 `syscall`）
        enc.emitStackLoad("r10", PhotonRuntime.OFF_HSTDOUT)
        enc.emitXorRR("rdx", "rdx")
        enc.emitXorRR("r8", "r8")
        enc.emitXorRR("r9", "r9")
        SyscallEmitter.emitSyscall(enc, 0x08)  // NtWriteFile（本ntdll 实测 0x08
        // ── 第二NtWriteFile：写CRLF ──
        enc.emitStoreByteMemImm8(PhotonRuntime.OFF_NEWLINE, 0x0D)
        enc.emitStoreByteMemImm8(PhotonRuntime.OFF_NEWLINE + 1, 0x0A)

        enc.emitLeaStack("rax", PhotonRuntime.OFF_IOBLOCK)
        enc.emitStackStore(PhotonRuntime.OFF_ARG5, "rax")
        enc.emitLeaStack("rax", PhotonRuntime.OFF_NEWLINE)
        enc.emitStackStore(PhotonRuntime.OFF_ARG6, "rax")
        enc.emitMovRI32("rax", 2)
        enc.emitStackStore(PhotonRuntime.OFF_ARG7, "rax")
        enc.emitXorRR("rax", "rax")
        enc.emitStackStore(PhotonRuntime.OFF_ARG8, "rax")
        enc.emitStackStore(PhotonRuntime.OFF_ARG9, "rax")
        // EaLength 必须显式清零：NtWriteFile 的第 10 个参数，若栈上残留非 0
        // 值，内核会尝试从 EaBuffer 复制扩展属性并导致访问违规
        enc.emitStackStore(PhotonRuntime.OFF_ARG10, "rax")

        // ⚠️ Windows x64 syscall *1 个参数必须放r10**
        // `syscall` 指令会把返回地址写进 rcx，因此内核从 r10 读取 arg1
        // （ntdll stub 正是 `mov r10, rcx` 后再 `syscall`）
        enc.emitStackLoad("r10", PhotonRuntime.OFF_HSTDOUT)
        enc.emitXorRR("rdx", "rdx")
        enc.emitXorRR("r8", "r8")
        enc.emitXorRR("r9", "r9")
        SyscallEmitter.emitSyscall(enc, 0x08)  // NtWriteFile（本ntdll 实测 0x08
        enc.emitEpilogue()
    }

    // ── 用户代码：main ──

    /// 编码 `main`：调runtime `println` 打印文本，返0
    ///
    /// ```asm
    /// main:
    ///   push rbp; mov rbp, rsp; sub rsp, 0x30
    ///   lea  rcx, [rip + @str.0]
    ///   call println                  ; 跨对象：runtime.obj 提供
    ///   xor  eax, eax
    ///   leave; ret
    /// ```
    fun emitPrintMain(enc: X86Encoder, text: String): Unit {
        enc.emitPrologue(0x30)
        enc.emitLeaRIP("rcx", "@str.0")
        enc.emitCallRel("println")
        enc.emitXorRR("eax", "eax")
        enc.emitMovRR("rcx", "eax")  // exit code = 0
        enc.emitCallRel("exit")
      // 显式终止进程（无 CRT）
        enc.emitEpilogue()
           // 不可达，仅保持函数完整性
    }

    // ── 字符串操──

    /// 编码 `strlen(rcx = char*) rax = Int`
    ///
    /// ```asm
    /// strlen:
    ///   push rbp; mov rbp, rsp
    ///   mov  rdx, rcx
    ///   xor  rax, rax
    /// loop:
    ///   cmp  byte [rdx], 0
    ///   je   done
    ///   inc  rdx
    ///   inc  rax
    ///   jmp  loop
    /// done:
    ///   leave; ret
    /// ```
    fun emitStrlen(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitMovRR("rdx", "rcx")
        enc.emitXorRR("rax", "rax")
        enc.emitLabel("strlen_loop")
        enc.emitCmpByteMemImm8("rdx", 0)
        enc.emitJccLabel("eq", "strlen_done")
        enc.emitIncRR("rdx")
        enc.emitIncRR("rax")
        enc.emitJmpLabel("strlen_loop")
        enc.emitLabel("strlen_done")
        enc.emitEpilogue()
    }

    /// 编码 `charCodeAt(rcx = char*, rdx = index) rax = Int`
    ///
    /// ```asm
    /// charCodeAt:
    ///   push rbp; mov rbp, rsp
    ///   movzx eax, byte ptr [rcx+rdx]
    ///   leave; ret
    /// ```
    fun emitCharCodeAt(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitMovzxRegMemIndexed("eax", "rcx", "rdx")
        enc.emitEpilogue()
    }

    /// 编码 `String_fromCharCode(rcx = code) rax = char*`（2026-10-02 自举链接修复）
    ///
    /// 从 `heapArena` bump 出 8 字节，写入 `code & 0xFF` 一个字节 + 3 个隐式 NUL
    ///（32 位 store 的高 3 字节恰为 0），返回 NUL 结尾的 1 字节字符串。
    /// 与 `charCodeAt` 的 1 字节字符模型一致（>255 的码点按低字节截断）。
    ///
    /// ```asm
    /// String_fromCharCode:
    ///   push rbp; mov rbp, rsp
    ///   mov  rax, [rel heapBump]
    ///   lea  rdx, [rel heapArena]
    ///   add  rax, rdx              ; rax = ptr
    ///   mov  r9, rax
    ///   add  rax, 8
    ///   sub  rax, rdx              ; rax = base + 8
    ///   cmp  rax, 16000000
    ///   jg   fcc_ovf               ; 溢出：保持 bump 不动，返回 ptr（内容为旧值）
    ///   mov  [rel heapBump], rax
    /// fcc_ovf:
    ///   movzx eax, cl
    ///   mov  [r9], eax             ; dword 写入：byte + 3×NUL
    ///   mov  rax, r9
    ///   leave; ret
    /// ```
    fun emitFromCharCode(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitMovRIP("rax", "heapBump")
        enc.emitLeaRIP("rdx", "heapArena")
        enc.emitAddRR("rax", "rdx")     // rax = ptr = heapArena + base
        enc.emitMovRR("r9", "rax")      // r9 = ptr（保存）
        enc.emitAddRI("rax", 8)
        enc.emitSubRR("rax", "rdx")     // rax = base + 8（新 bump 偏移）
        enc.emitCmpRI("rax", 33546336)
        enc.emitJccLabel("g", "fcc_ovf")
        enc.emitStoreRIP("heapBump", "rax")
        enc.emitLabel("fcc_ovf")
        enc.emitMovzxRegReg8("eax", "ecx")
        enc.emitStoreMemDisp32("r9", 0, "rax")   // dword 写入：byte + 3×NUL
        enc.emitMovRR("rax", "r9")
        enc.emitEpilogue()
    }

    /// 编码 `String_substring(rcx = str, rdx = start, r8 = len) rax = char*`
    /// （2026-10-02：薄 VM 宿主链接修复 —— VmOps.vmSubstr / methodNameOf 的
    /// `s.substring(a, len)` 调用点需要它。语义与 VM `String.substring` 一致：
    /// 越界钳位，返回 NUL 结尾副本。heapArena bump 分配（与 strcat 同堆）。
    ///
    /// ```asm
    /// String_substring:
    ///   push rbp; mov rbp, rsp
    ///   ; 钳位 start
    ///   test rdx, rdx
    ///   jg   ss_start_ok
    ///   xor  rdx, rdx
    /// ss_start_ok:
    ///   ; len 钳位到 [0, strlen(str)-start]（保守：先按 len 存，副本以 NUL 结尾）
    ///   cmp  r8, 0
    ///   jg   ss_len_ok
    ///   xor  r8, r8
    /// ss_len_ok:
    ///   ; 分配 len+1
    ///   mov  rax, [rel heapBump]
    ///   lea  r9, [rel heapArena]
    ///   add  rax, r9               ; rax = ptr
    ///   mov  r10, rax
    ///   add  rax, r8
    ///   inc  rax
    ///   sub  rax, r9               ; newBase = base + len + 1
    ///   cmp  rax, 16000000
    ///   jg   ss_ovf
    ///   mov  [rel heapBump], rax
    ///   jmp  ss_copy
    /// ss_ovf:                      ; 溢出：返回空串指针（堆首字节恒 0? 保守置 0）
    ///   mov  r10, r9
    ///   mov  byte [r10], 0
    ///   mov  rax, r10
    ///   leave; ret
    /// ss_copy:
    ///   ; r10 = 副本指针；逐字节从 str+start 拷 len 字节（遇 NUL 提前停，补 0）
    ///   xor  r11, r11
    /// ss_copy_loop:
    ///   cmp  r11, r8
    ///   jge ss_copy_done
    ///   movzx eax, byte [rcx + r11]
    ///   test al, al
    ///   jz   ss_copy_zpad
    ///   mov  [r10 + r11], al
    ///   inc  r11
    ///   jmp  ss_copy_loop
    /// ss_copy_zpad:                ; 源串提前 NUL：剩余补 0
    ///   mov  byte [r10 + r11], 0
    ///   inc  r11
    /// ss_zpad_loop:
    ///   cmp  r11, r8
    ///   jge  ss_copy_done
    ///   mov  byte [r10 + r11], 0
    ///   inc  r11
    ///   jmp  ss_zpad_loop
    /// ss_copy_done:
    ///   mov  byte [r10 + r8], 0     ; 尾 NUL
    ///   mov  rax, r10
    ///   leave; ret
    /// ```
    fun emitStringSubstring(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        // start 钳位非负
        enc.emitTestRR("rdx", "rdx")
        enc.emitJccLabel("g", "ss_start_ok")
        enc.emitXorRR("rdx", "rdx")
        enc.emitLabel("ss_start_ok")
        // len 钳位非负
        enc.emitTestRR("r8", "r8")
        enc.emitJccLabel("g", "ss_len_ok")
        enc.emitXorRR("r8", "r8")
        enc.emitLabel("ss_len_ok")
        // bump 分配 len+1
        enc.emitMovRIP("rax", "heapBump")
        enc.emitLeaRIP("r9", "heapArena")
        enc.emitAddRR("rax", "r9")          // rax = ptr
        enc.emitMovRR("r10", "rax")         // r10 = ptr
        enc.emitAddRR("rax", "r8")
        enc.emitIncRR("rax")
        enc.emitSubRR("rax", "r9")          // rax = base + len + 1
        enc.emitCmpRI("rax", 33546336)
        enc.emitJccLabel("g", "ss_ovf")
        enc.emitStoreRIP("heapBump", "rax")
        // 逐字节拷贝（源遇 NUL 提前停，剩余补 0）
        enc.emitXorRR("r11", "r11")
        enc.emitLabel("ss_copy_loop")
        enc.emitCmpRR("r11", "r8")
        enc.emitJccLabel("ge", "ss_copy_done")
        enc.emitMovzxRegMemIndexed("eax", "rcx", "r11")
        enc.emitTestRR("rax", "rax")
        enc.emitJccLabel("z", "ss_zpad")
        enc.emitStoreIndexed8("r10", "r11", 0, "rax")
        enc.emitIncRR("r11")
        enc.emitJmpLabel("ss_copy_loop")
        enc.emitLabel("ss_zpad")
        enc.emitStoreIndexed8("r10", "r11", 0, "rax")  // 写 0（rax 此刻为 0）
        enc.emitIncRR("r11")
        enc.emitJmpLabel("ss_zpad")
        enc.emitLabel("ss_copy_done")
        // 尾 NUL：[r10 + len] = 0（eax 已为 0？保守再清）
        enc.emitXorRR("eax", "eax")
        enc.emitStoreIndexed8("r10", "r8", 0, "rax")
        enc.emitMovRR("rax", "r10")
        enc.emitEpilogue()
    }

    /// 编码 `ProcessOps_aura_process_argCount() rax = 0`（2026-10-02 自举链接修复）
    ///
    /// **有意的桩**：返回 0，使自举编译器 CLI 的 `cliArgCount()` 走既有的
    /// **环境变量回退通道**（`AURA_ARGV_COUNT` / `AURA_ARG_N`，与冻结种子
    /// 场景同一机制，scripts/bootstrap-*.ps1 已注入）。原生 argv（命令行解析）
    /// 待后续轮次用 `GetCommandLineA` 实现。
    fun emitProcArgCountStub(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitXorRR("rax", "rax")
        enc.emitEpilogue()
    }

    /// 编码 `ProcessOps_aura_process_args() rax = char*`（空串；同上，配套桩）
    fun emitProcArgsStub(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitMovRIP("rax", "heapBump")
        enc.emitLeaRIP("rdx", "heapArena")
        enc.emitAddRR("rax", "rdx")
        enc.emitMovRR("r9", "rax")
        enc.emitAddRI("rax", 8)
        enc.emitSubRR("rax", "rdx")
        enc.emitCmpRI("rax", 33546336)
        enc.emitJccLabel("g", "pargs_ovf")
        enc.emitStoreRIP("heapBump", "rax")
        enc.emitLabel("pargs_ovf")
        enc.emitXorRR("eax", "eax")
        enc.emitStoreMemDisp32("r9", 0, "rax")
        enc.emitMovRR("rax", "r9")
        enc.emitEpilogue()
    }

    /// 编码 `strcmp(rcx = char*, rdx = char*) rax = Int`
    ///
    /// ```asm
    /// strcmp:
    ///   push rbp; mov rbp, rsp
    ///   xor  r8, r8
    /// loop:
    ///   cmp  byte [rcx+r8], byte [rdx+r8]
    ///   jne  done
    ///   test byte [rcx+r8], byte [rcx+r8]
    ///   jz   done
    ///   inc  r8
    ///   jmp  loop
    /// done:
    ///   mov  rax, r8
    ///   leave; ret
    /// ```
    fun emitStrcmp(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitXorRR("r8", "r8")
        enc.emitLabel("strcmp_loop")
        enc.emitCmpMemMem("rcx", "r8", "rdx", "r8")
        enc.emitJccLabel("ne", "strcmp_done")
        // 同 `emitStreq`：不能用 `test mem, 0`（恒 ZF=1），改为 zero-extend + test reg。
        enc.emitMovzxRegReg8("rax", "rax")
        enc.emitTestRR("rax", "rax")
        enc.emitJccLabel("z", "strcmp_done")
        enc.emitIncRR("r8")
        enc.emitJmpLabel("strcmp_loop")
        enc.emitLabel("strcmp_done")
        enc.emitMovRR("rax", "r8")
        enc.emitEpilogue()
    }

    // ── 字符串相等比──

    /// 编码 `streq(rcx = char*, rdx = char*) rax = 1/0`（内容相等）
    ///
    /// 为什么不`strcmp`：`emitStrcmp` 返回的是「首个不同字节的下标
    ///（相等时返回长度），无法用于判等。`streq` 返回严格0/1
    ///
    /// ```asm
    /// streq:
    ///   push rbp; mov rbp, rsp
    ///   xor  r8, r8
    /// loop:
    ///   mov  al, [rcx+r8]
    ///   cmp  al, [rdx+r8]
    ///   jne  not_equal
    ///   test al, al
    ///   jz   equal
    ///   inc  r8
    ///   jmp  loop
    /// equal:
    ///   mov  eax, 1
    ///   leave; ret
    /// not_equal:
    ///   xor  eax, eax
    ///   leave; ret
    /// ```
    fun emitStreq(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        // ⚠️ null 安全前置（2026-10-03，fs 探针）：`if (s == null)` 类判空
        // 在 HIR/ISA 某层会被改写成与空串的内容比较，且未初始化 String 的
        // null 值会作为实参到达这里 —— 对地址 0 做字节比较必崩。
        // 语义：null == null → 1；null == x（x 非 null）→ 0。
        enc.emitTestRR("rcx", "rcx")
        enc.emitJccLabel("ne", "streq_a_ok")
        enc.emitTestRR("rdx", "rdx")
        enc.emitJccLabel("ne", "streq_not_equal")   // a=null, b≠null → 0
        enc.emitMovRI32("eax", 1)                    // 双 null → 1
        enc.emitEpilogue()
        enc.emitLabel("streq_a_ok")
        enc.emitTestRR("rdx", "rdx")
        enc.emitJccLabel("ne", "streq_prep")         // 双非 null → 准备比较
        enc.emitXorRR("eax", "eax")                  // a≠null, b=null → 0
        enc.emitEpilogue()
        // ⚠️ 索引清零必须在进入 streq_loop **之前**：上面的条件跳转若直接
        // 跳进 loop，r8 会残留调用方垃圾（实测残留 rcx 指针 ⇒ [rcx+r8]
        // 越界读 ⇒ 0xC0000005，2026-10-03 fs 探针）。
        enc.emitLabel("streq_prep")
        enc.emitXorRR("r8", "r8")
        enc.emitLabel("streq_loop")
        enc.emitCmpMemMem("rcx", "r8", "rdx", "r8")
        enc.emitJccLabel("ne", "streq_not_equal")
        // ⚠️ 这里**不能**用 `test byte [rcx+r8], 0` —— `test x, 0` 恒有 ZF=1
        //（`x & 0 == 0`），于是「字符串结束」判定永远成立、循环只比第一个字节。
        // 正确做法：把刚取到的 a 字节零扩展进 rax 再 `test rax, rax`
        //（`emitCmpMemMem` 的第一步就是 `mov al, [rcx+r8]`，故 al 即该字节；
        //  movzx 会把高 32 位清零，使 `test rax, rax` 有意义）。
        enc.emitMovzxRegReg8("rax", "rax")
        enc.emitTestRR("rax", "rax")
        enc.emitJccLabel("z", "streq_equal")
        enc.emitIncRR("r8")
        enc.emitJmpLabel("streq_loop")
        enc.emitLabel("streq_equal")
        enc.emitMovRI32("eax", 1)
        enc.emitEpilogue()
        enc.emitLabel("streq_not_equal")
        enc.emitXorRR("eax", "eax")
        enc.emitEpilogue()
    }

    // ── 异常处理支持 ──

    /// 编码 `throwException(rcx = Exception*) -> never returns`
    /// 简化实现：直接终止程序（NtTerminateProcess syscall）
    /// 完整实现需要异常表遍历
    fun emitThrowException(enc: X86Encoder): Unit {
        enc.emitPrologue(0x20)
        // NtTerminateProcess(0, 1)
        enc.emitXorRR("r10", "r10")  // processHandle = 0 (当前进程), arg1 必须在 r10
        enc.emitMovRI32("rdx", 1)
    // exitStatus = 1 (异常)
        SyscallEmitter.emitSyscall(enc, 0x2C)  // NtTerminateProcess (实测 0x2C)
        enc.emitEpilogue()  // 不可达，仅为函数完整
    }

    // ── exit 实现 ──

    /// 编码 `exit(rcx = Int) never returns`
    ///
    /// 使用 NtTerminateProcess syscall 终止进程
    ///
    /// ```asm
    /// exit:
    ///   push rbp; mov rbp, rsp; sub rsp, 0x20
    ///   mov  [rbp-0x10], rcx       ; 保存退出码
    ///   xor  rcx, rcx              ; processHandle = 0
    ///   mov  rdx, [rbp-0x10]       ; exitStatus
    ///   mov  eax, 0x30             ; NtTerminateProcess
    ///   syscall
    ///   ret                        ; 不可
    /// ```
    fun emitExit(enc: X86Encoder): Unit {
        enc.emitPrologue(0x20)
        // 保存退出码（rcx 将被覆盖processHandle
        enc.emitStackStore(-0x10, "rcx")
        // NtTerminateProcess(NtCurrentProcess(), exitStatus)
        //
        // ⚠️ 当前进程*伪句柄是 -1xFFFFFFFFFFFFFFFF*，不0
        // `NtTerminateProcess(0, ` 会以 STATUS_INVALID_HANDLE 直接返回
        // 进程不会终止 —`call exit` 于是返回，执行流继续落到 main 之后
        // `int3` 填充字节上，进程0x80000003（STATUS_BREAKPOINT）结
        //（实01/02 退出码恒为 -21474836453 还额外打印出一行垃圾）
        // arg1 r10（Win64 syscall 约定）
        enc.emitMovRI("r10", -1)
        enc.emitStackLoad("rdx", -0x10)  // exitStatus
        SyscallEmitter.emitSyscall(enc, 0x2C)  // NtTerminateProcess (实测 0x2C)
        enc.emitEpilogue()  // 不可达，仅为函数完整
    }

    // ── toStr 实现 ──

    /// 编码 `toStr(rcx = Int) rax = char*`
    ///
    /// 使用 .data 段的静态缓冲区2 字节）存储转换结果
    /// 算法：处0、处理负数、除 10 取余、逆序写入
    fun emitToStr(enc: X86Encoder): Unit {
        enc.emitPrologue(0x40)

        // Windows x64 ABI：rbx / rsi 是非易失寄存器，必须保存 + 恢复
        // 旧实现直接用它们当「缓冲区基址 / 写指针」却不保—调用方的
        // 跨调用活值（例如字符串常量的地址）会被这个函数悄悄改掉
        enc.emitStackStore(-0x30, "rbx")
        enc.emitStackStore(-0x38, "rsi")

        // 加载缓冲区地址
        enc.emitLeaRIP("rbx", "toStrBuffer")

        // 保存输入
        enc.emitStackStore(-0x20, "rcx")

        // 处理负数
        enc.emitStackLoad("rax", -0x20)
        enc.emitCmpRI("rax", 0)
        enc.emitJccLabel("ge", "tos_nonneg")

        // 负数：设置标志，取反
        // ⚠️ 标志必须放 **rdx**：旧实现 `emitMovRI32("eax", 1)` 先把 1 写进
        // rax——恰好覆盖了 886 行刚载入的输入值——随后 `sub rdx, rax` 算出的是
        // `-1` 而非 `-input` ⇒ 绝对值恒为 0xFFFF…FF ⇒ 无符号除 10 打出
        // `-18446744073709551615`（实测 P222/P223 全部负数探针）。
        enc.emitMovRI32("rdx", 1)
        enc.emitStackStore(-0x28, "rdx")  // 负号标志
        enc.emitXorRR("rdx", "rdx")
        enc.emitSubRR("rdx", "rax")  // rdx = -rax（rax 仍是输入值）
        enc.emitMovRR("rax", "rdx")
        enc.emitStackStore(-0x20, "rax")  // 保存绝对
        enc.emitJmpLabel("tos_start")

        enc.emitLabel("tos_nonneg")
        enc.emitMovRI32("eax", 0)
        enc.emitStackStore(-0x28, "rax")  // 无负号标
        enc.emitLabel("tos_start")
        // 初始化写指针：指向缓冲区末尾1
        enc.emitMovRR("rsi", "rbx")
        enc.emitAddRI("rsi", 31)  // rsi = &buffer[31]
        enc.emitXorRR("rax", "rax")  // rax = 0
        enc.emitMovByteMemReg("rsi", "rax")  // [rsi] = 0（NUL 终止符）

        // 加载绝对
        enc.emitStackLoad("rax", -0x20)

        // ── 特例：值为 0 ──
        // 循环是「先判零再写字符」，0 会直接跳tos_done 且写指针仍停
        // 缓冲区末尾的 NUL 返回空串。实`toStr(0)` 打印空行
        enc.emitCmpRI("rax", 0)
        enc.emitJccLabel("ne", "tos_loop")
        enc.emitSubRI("rsi", 1)
        enc.emitMovRI32("eax", '0')
        enc.emitMovByteMemReg("rsi", "rax")
        enc.emitJmpLabel("tos_return")

        // 循环：除10，存余数
        enc.emitLabel("tos_loop")
        enc.emitCmpRI("rax", 0)
        enc.emitJccLabel("eq", "tos_done")

        // rax = rax / 10
        enc.emitMovRI32("r10", 10)
        enc.emitXorRR("rdx", "rdx")
        enc.emitIdiv("r10")  // rax =  rdx = 余数

        // 递减写指针并存储数字字符
        enc.emitSubRI("rsi", 1)
        enc.emitAddRI("rdx", '0')  // rdx = 余数 + '0'
        enc.emitMovByteMemReg("rsi", "rdx")  // [rsi] = 数字字符

        enc.emitJmpLabel("tos_loop")

        enc.emitLabel("tos_done")
        // 如果是负数，添加 '-' 前缀
        enc.emitStackLoad("rax", -0x28)
        enc.emitCmpRI("rax", 0)
        enc.emitJccLabel("eq", "tos_return")

        enc.emitSubRI("rsi", 1)
        enc.emitMovRI32("eax", '-')  // rax = '-'
        enc.emitMovByteMemReg("rsi", "rax")  // [rsi] = '-'

        enc.emitLabel("tos_return")
        enc.emitMovRR("rax", "rsi")  // 返回字符串指
        // 恢复非易失寄存器（rax 已持有返回值，不受影响
        enc.emitStackLoad("rsi", -0x38)
        enc.emitStackLoad("rbx", -0x30)
        enc.emitEpilogue()
    }

    // ── strcat 实现 ──

    /// 编码 `strcat(rcx = s1, rdx = s2) rax = 拼接结果`
    ///
    /// 结果.data 段的**bump 分配 arena** 里切一块新内存（每次调用返
    /// 不同地址），因此拼接结果*不可*—后续拼接不会覆写它
    ///
    /// ```asm
    ///   len1 = strlen(s1); len2 = strlen(s2)
    ///   need = len1 + len2 + 1
    ///   base = [strcatBump]; new = base + need
    ///   if (new > ARENA_LIMIT) { base = 0; new = need }   ; 回绕，避免越
    ///   [strcatBump] = new
    ///   dst = strcatArena + base
    ///   dst[0..len1) = s1; dst[len1..len1+len2] = s2; 末尾 NUL
    ///   rax = dst
    /// ```
    ///
    /// ⚠️ 旧实现返*同一*静态缓冲区：链式拼接时源与目标别名
    ///（`"B: " + s3` s3 就是该缓冲区），边读边写导致源永NUL 写越界；
    /// 即使不崩溃，`s3` 也会被下一次拼接覆—实测
    /// `P2/04_string_ops` `s3.length()` 得到 16 而不11，判等随之失败
    fun emitStrcat(enc: X86Encoder): Unit {
        // 0x120 = 288 字节：保存寄存器 + s1/s2/len1/len2/newBump
        // 16 字节对齐x120 % 16 == 0）
        enc.emitPrologue(0x120)

        // 保存 callee-saved r12 / rbx / rsi / rdi（Win64 非易失寄存器
        enc.emitStackStore(-0x88, "r12")
        enc.emitStackStore(-0x98, "rbx")
        enc.emitStackStore(-0xA8, "rsi")
        enc.emitStackStore(-0xB0, "rdi")

        // 保存两个字符串指
        enc.emitStackStore(-0x90, "rcx")  // s1
        enc.emitStackStore(-0xC0, "rdx")  // s2

        // ⚠️ P227 NULL 安全（防御性）：phi 简化缺陷会把未初始化的 String 局部
        // 传成 NULL（实测 decodeNumeric 的 a1 合并路径）——把 NULL 当空串处理，
        // 把崩溃变成可观测的错误串，供上层探针定位 phi 缺陷。
        enc.emitStackLoad("rax", -0x90)
        enc.emitCmpRI("rax", 0)
        enc.emitJccLabel("ne", "strcat_s1_ok")
        enc.emitLeaRIP("rax", "@str.0")
        enc.emitStackStore(-0x90, "rax")
        enc.emitLabel("strcat_s1_ok")
        enc.emitStackLoad("rax", -0xC0)
        enc.emitCmpRI("rax", 0)
        enc.emitJccLabel("ne", "strcat_s2_ok")
        enc.emitLeaRIP("rax", "@str.0")
        enc.emitStackStore(-0xC0, "rax")
        enc.emitLabel("strcat_s2_ok")

        // 计算 s1 长度
        enc.emitStackLoad("rax", -0x90)   // rax = s1
        enc.emitXorRR("rdx", "rdx")
        // rdx = 0 (用于检NUL)
        enc.emitLabel("strcat_len1_loop")
        enc.emitCmpByteMemImm8("rax", 0)
        enc.emitJccLabel("eq", "strcat_len1_done")
        enc.emitIncRR("rax")
        enc.emitIncRR("rdx")
        enc.emitJmpLabel("strcat_len1_loop")
        enc.emitLabel("strcat_len1_done")
        enc.emitStackStore(-0xA0, "rdx")  // len1 = rdx

        // 计算 s2 长度
        enc.emitStackLoad("rax", -0xC0)   // rax = s2
        enc.emitXorRR("rdx", "rdx")
        // rdx = 0
        enc.emitLabel("strcat_len2_loop")
        enc.emitCmpByteMemImm8("rax", 0)
        enc.emitJccLabel("eq", "strcat_len2_done")
        enc.emitIncRR("rax")
        enc.emitIncRR("rdx")
        enc.emitJmpLabel("strcat_len2_loop")
        enc.emitLabel("strcat_len2_done")
        enc.emitStackStore(-0xB8, "rdx")  // len2 = rdx（供复制阶段定长使用
        // ── 分配阶段：从 bump arena 切一**内存当目──
        //
        // need = len1 + len2 + 1（含结尾 NUL
        enc.emitMovRR("rcx", "rdx")
          // rcx = len2
        enc.emitStackLoad("rax", -0xA0)
      // len1
        enc.emitAddRR("rcx", "rax")
        enc.emitIncRR("rcx")
                 // rcx = need

        // base = [heapBump]；new = base + need；越界则回绕0 重新开
        enc.emitMovRIP("rax", "heapBump")
    // rax = base
        enc.emitMovRR("rbx", "rax")
        enc.emitAddRR("rbx", "rcx")
          // rbx = new
        enc.emitCmpRI("rbx", 33546336)
        enc.emitJccLabel("le", "strcat_alloc_ok")
        enc.emitXorRR("rax", "rax")
          // base = 0
        enc.emitMovRR("rbx", "rcx")
          // new = need
        enc.emitLabel("strcat_alloc_ok")
        enc.emitStoreRIP("heapBump", "rbx")

        // dst = heapArena + base
        enc.emitLeaRIP("r12", "heapArena")
        enc.emitAddRR("r12", "rax")

        // s1 dst（计= len1 + 1，含 NUL
        enc.emitStackLoad("rsi", -0x90)
        enc.emitMovRR("rdi", "r12")
        enc.emitStackLoad("rcx", -0xA0)   // len1
        enc.emitIncRR("rcx")
        enc.emitLabel("strcat_c1_loop")
        enc.emitCmpRI("rcx", 0)
        enc.emitJccLabel("eq", "strcat_c1_done")
        enc.emitMovzxRegMemByte("rax", "rsi")
        enc.emitMovByteMemReg("rdi", "rax")
        enc.emitIncRR("rsi")
        enc.emitIncRR("rdi")
        enc.emitSubRI("rcx", 1)
        enc.emitJmpLabel("strcat_c1_loop")
        enc.emitLabel("strcat_c1_done")

        // 目标指针回到 dst + len1（覆盖上一步写下的 NUL
        enc.emitMovRR("rdi", "r12")
        enc.emitStackLoad("rcx", -0xA0)   // len1
        enc.emitAddRR("rdi", "rcx")

        // s2 dst + len1（计= len2 + 1，含 NUL
        enc.emitStackLoad("rsi", -0xC0)
        enc.emitStackLoad("rcx", -0xB8)   // len2
        enc.emitIncRR("rcx")
        enc.emitLabel("strcat_c2_loop")
        enc.emitCmpRI("rcx", 0)
        enc.emitJccLabel("eq", "strcat_done")
        enc.emitMovzxRegMemByte("rax", "rsi")
        enc.emitMovByteMemReg("rdi", "rax")
        enc.emitIncRR("rsi")
        enc.emitIncRR("rdi")
        enc.emitSubRI("rcx", 1)
        enc.emitJmpLabel("strcat_c2_loop")

        enc.emitLabel("strcat_done")
        enc.emitMovRR("rax", "r12")  // 返回新分配的字符串指
        // 恢复 callee-saved r12 / rbx / rsi / rdi（rax 已持有返回值）
        enc.emitStackLoad("rdi", -0xB0)
        enc.emitStackLoad("rsi", -0xA8)
        enc.emitStackLoad("rbx", -0x98)
        enc.emitStackLoad("r12", -0x88)
        enc.emitEpilogue()
    }

    // ── 堆列表实现（数组/列表字面+ 索引读写）──
    //
    // 内存布局 字节槽）
    //
    //   [0]      count（元素个数，64 位）
    //   [8]      元素 0
    //   [16]     元素 1
    //          元素 i 位于 [8 + i*8]
    //
    // 对象`heapArena` bump 游标分配（与 `strcat` 共用同一个堆）
    // 元素统一64 位槽存放 —Photon 目前只有 Int/Bool/Float/String 指针
    // 这几种标量，都在 8 字节以内（字符串存的是指针）
    //
    // 为什么在 Photon 侧用 runtime 函数而不Load/Gep：那条路径当前是空的
    //（`Lowering.lowerLoad/lowerStore` `addValueWithChain`，值不登记
    // `LirBlock.instrs`，DAG 里根本没有加存储指令）
    /// 编码 `__list_alloc(rcx = count) rax = list`
    fun emitListAlloc(enc: X86Encoder): Unit {
        // 内联布局 [count@0][elems@8...]+8KB slack（回退到 p199b 已验证形态）。
        // core 布局统一尝试（§10.22-10.25）因深层槽别名暂缓。
        enc.emitPrologue(0x20)
        enc.emitMovRR("r8", "rcx")
        enc.emitShlRI("rcx", 3)
        enc.emitAddRI("rcx", 8)
        enc.emitAddRI("rcx", 8192)
        enc.emitMovRIP("rax", "heapBump")
        enc.emitMovRR("rdx", "rax")
        enc.emitAddRR("rdx", "rcx")
        enc.emitCmpRI("rdx", 33546336)
        enc.emitJccLabel("le", "list_alloc_ok")
        enc.emitXorRR("rax", "rax")
        enc.emitMovRR("rdx", "rcx")
        enc.emitLabel("list_alloc_ok")
        enc.emitStoreRIP("heapBump", "rdx")
        enc.emitLeaRIP("r9", "heapArena")
        enc.emitAddRR("rax", "r9")
        enc.emitStoreMemDisp32("rax", 0, "r8")
        enc.emitEpilogue()
    }


    /// 编码 `__list_setat(rcx = list, rdx = idx, r8 = val) rax = list`
    /// 添加 null 检查防止崩溃
    fun emitListSetAt(enc: X86Encoder): Unit {
        enc.emitCmpRI("rcx", 0)
        enc.emitJccLabel("eq", "list_set_null")
        enc.emitStoreIndexed8("rcx", "rdx", 8, "r8")
        enc.emitMovRR("rax", "rcx")
        enc.emitRet()
        enc.emitLabel("list_set_null")
        enc.emitMovRI("eax", 0)
        enc.emitRet()
    }

    /// 编码 `__list_get(rcx = list, rdx = idx) rax = value`
    /// 添加 null 检查防止崩溃（对象模型未完全实现时 list 可能null）
    fun emitListGet(enc: X86Encoder): Unit {
        enc.emitCmpRI("rcx", 0)
        enc.emitJccLabel("eq", "list_get_null")
        enc.emitLoadIndexed8("rax", "rcx", "rdx", 8)
        enc.emitRet()
        enc.emitLabel("list_get_null")
        enc.emitMovRI("eax", 0)
        enc.emitRet()
    }

    /// 编码 `__field_get(rcx = obj, rdx = fieldIndex) rax = value`
    ///
    /// 对象布局（与 `emitClassConstructorWithVtable` 一致）：
    ///   [0x00] vtable 指针  [0x08] 对象大小  [0x10 + i*8] 字段 i
    /// 传「字段序号」而不是字节偏移：编码器的 `emitLoadIndexed8` 固定 SIB
    /// scale=8，序号直接可用。obj 为 0 时返回 0（对象模型完成前的兜底）。
    fun emitFieldGet(enc: X86Encoder): Unit {
        enc.emitCmpRI("rcx", 0)
        enc.emitJccLabel("eq", "field_get_null")
        enc.emitLoadIndexed8("rax", "rcx", "rdx", 16)
        enc.emitRet()
        enc.emitLabel("field_get_null")
        enc.emitMovRI("eax", 0)
        enc.emitRet()
    }

    /// 编码 `__field_set(rcx = obj, rdx = fieldIndex, r8 = value) rax = obj`
    fun emitFieldSet(enc: X86Encoder): Unit {
        enc.emitCmpRI("rcx", 0)
        enc.emitJccLabel("eq", "field_set_null")
        enc.emitStoreIndexed8("rcx", "rdx", 16, "r8")
        enc.emitMovRR("rax", "rcx")
        enc.emitRet()
        enc.emitLabel("field_set_null")
        enc.emitMovRI("eax", 0)
        enc.emitRet()
    }

    /// 编码 stub 函数：`mov eax, 0; ret`
    ///
    /// 用于自举编译阶段链接器未定义符号的占位实现——编译器引用
    /// 尚未runtime 中实现的 stdlib / POSIX / 类构造器符号。stub 返回 0
    /// 保证链接器不undefined symbol；运行时不会调用到这些符
    /// （Step 3 目标是「可链接」，不是「可运行」）
    fun emitStub(enc: X86Encoder): Unit {
        enc.emitMovRI("eax", 0)
        enc.emitRet()
    }

    // ── Step 4: 对象分配+ 类构造器 ──

    /// 编码 `emitObjectAlloc(size: i64) rax = obj*`
    ///
    /// `.data` 段的 `objBump` 游标分配 size 字节B 对齐），
    /// 零初始化后返回对象指针。与 `strcat`/`__list_alloc` 共用 `heapArena`
    /// 但使用独立的 bump 游标 `objBump`
    ///
    /// ```asm
    /// emitObjectAlloc:
    ///   push rbp; mov rbp, rsp; sub rsp, 0x50
    ///   mov  [rbp-0x30], r12    ; 保存 callee-saved
    ///   mov  [rbp-0x38], rsi
    ///   mov  [rbp-0x10], rcx    ; size
    ///   mov  r12, [rip+objBump] ; 当前偏移
    ///   add  rdx, r12           ; new = old + size
    ///   cmp  rdx, 16000000
    ///   jle  alloc_ok
    ///   xor  r12, r12           ; 回绕：base = 0
    ///   mov  rdx, [rbp-0x10]    ; new = size
    /// alloc_ok:
    ///   mov  [rip+objBump], rdx ; 更新游标
    ///   lea  rsi, [rip+heapArena]
    ///   add  rsi, r12           ; rsi = 实际地址
    ///   mov  [rbp-0x20], rsi    ; 保存返回地址
    ///   mov  [rbp-0x28], rsi    ; 初始化写指针
    ///   mov  rcx, [rbp-0x10]    ; rcx = size / 8
    ///   shr  rcx, 3
    ///   xor  rdx, rdx           ; rdx = 0
    /// zero_loop:
    ///   cmp  rcx, 0
    ///   je   zero_done
    ///   mov  rsi, [rbp-0x28]
    ///   mov  [rsi], rdx         ; 8 字节
    ///   add  rsi, 8
    ///   mov  [rbp-0x28], rsi
    ///   sub  rcx, 1
    ///   jmp  zero_loop
    /// zero_done:
    ///   mov  rax, [rbp-0x20]    ; 返回原始地址
    ///   ; 恢复 callee-saved + leave; ret
    /// ```
    fun emitObjectAlloc(enc: X86Encoder): Unit {
        enc.emitPrologue(0x50)

        // 保存 callee-saved
        enc.emitStackStore(-0x30, "r12")
        enc.emitStackStore(-0x38, "rsi")

        // 保存 size
        enc.emitStackStore(-0x10, "rcx")

        // ⚠️ 统一 bump 游标（2026-10-03）：旧实现用**独立的 objBump** 切
        // heapArena，而 strcat/__list_alloc 等字符串侧用 heapBump —— 两个
        // 互不知晓的游标在**同一块 arena** 上各自从 0 递增 ⇒ 交叉使用必然
        // 相互覆盖（实测 R12 探针：dump 的 strcat 结果覆盖 stringToBuffer
        // 的缓冲区 ⇒ 第二次构造的内容全错；也是 §7.5「路径缓冲区首字节
        // 为 0 / 内容被后续分配覆盖」、§7.3「崩点随构建漂移」随机损坏
        // 家族的根因）。改用与字符串侧**同一个** heapBump 游标 + 8 字节
        // 对齐（对象槽位按 8 对齐，与字段读取的偏移假设一致）。
        // r12 = [heapBump]
        enc.emitMovRIP("r12", "heapBump")

        // 8 字节对齐：new = (r12 + 7) & ~7（先对齐再叠加 size）
        enc.emitAddRI("r12", 7)
        enc.emitAndRI("r12", -8)

        // new = r12 + size
        enc.emitStackLoad("rdx", -0x10)
        enc.emitAddRR("rdx", "r12")

        // 边界检
        enc.emitCmpRI("rdx", 33546336)
        enc.emitJccLabel("le", "oa_alloc_ok")

        // 回绕
        enc.emitXorRR("r12", "r12")
        enc.emitStackLoad("rdx", -0x10)

        enc.emitLabel("oa_alloc_ok")

        // 更新 heapBump
        enc.emitStoreRIP("heapBump", "rdx")

        // 计算实际地址：heapArena + offset
        enc.emitLeaRIP("rsi", "heapArena")
        enc.emitAddRR("rsi", "r12")

        // 保存返回地址（不被修改）
        enc.emitStackStore(-0x20, "rsi")
        // 初始化写指针（将在循环中递增
        enc.emitStackStore(-0x28, "rsi")

        // 零初始化：每次写 8 字节
        enc.emitStackLoad("rcx", -0x10)
        enc.emitShrRI("rcx", 3)
        enc.emitXorRR("rdx", "rdx")  // rdx = 0

        enc.emitLabel("oa_zero_loop")
        enc.emitCmpRI("rcx", 0)
        enc.emitJccLabel("eq", "oa_zero_done")

        enc.emitStackLoad("rsi", -0x28)
        enc.emitStoreMemDisp32("rsi", 0, "rdx")
        enc.emitAddRI("rsi", 8)
        enc.emitStackStore(-0x28, "rsi")

        enc.emitSubRI("rcx", 1)
        enc.emitJmpLabel("oa_zero_loop")

        enc.emitLabel("oa_zero_done")

        // 返回原始地址
        enc.emitStackLoad("rax", -0x20)

        // 恢复 callee-saved
        enc.emitStackLoad("rsi", -0x38)
        enc.emitStackLoad("r12", -0x30)

        enc.emitEpilogue()
    }

    /// 生成类构造器代码：分配对设置 vtable pointer (offset 0) + object size (offset 8) 返回指针
    ///
    /// 对象内存布局
    ///   [0x00] vtable pointer (8B)  初始化为 0（无虚方法）
    ///   [0x08] object size   (8B)  记录分配大小
    ///   [0x10] field 0       (8B)  emitObjectAlloc 零初始化
    ///   [0x18] field 1       (8B)  emitObjectAlloc 零初始化
    ///   ...
    ///
    /// 栈帧布局（sub rsp, 0x30 = 48B）：
    ///   [rbp-0x30, rbp-0x10)  影子空间 shadow space2B，调emitObjectAlloc 前必须为空）
    ///   [rbp-0x08]            size 保存槽（避开影子空间
    ///
    fun emitClassConstructorWithVtable(enc: X86Encoder, size: Int, name: String): Unit {
        enc.emitPrologue(0x30)  // push rbp; mov rbp, rsp; sub rsp, 0x30

        // 保存 size 到栈上（call 后 rcx 会被 runtime_emitObjectAlloc 覆盖）
        enc.emitMovRI("rcx", size)
        enc.emitStackStore(-0x8, "rcx")  // [rbp-0x8] = size

        // 重新加载 size 到 rcx（runtime_emitObjectAlloc 的参数）
        enc.emitStackLoad("rcx", -0x8)
        enc.emitCallRel("runtime_emitObjectAlloc")

        // rax = 对象指针
        // 设置 vtable pointer = 0（offset 0，当前无虚方法）
        enc.emitXorRR("rdx", "rdx")
        enc.emitStoreMemDisp32("rax", 0, "rdx")

        // 设置 object size = size（offset 8）
        enc.emitStackLoad("rcx", -0x8)
        enc.emitStoreMemDisp32("rax", 8, "rcx")

        // 返回对象指针（rax 已持有）
        enc.emitEpilogue()  // leave; ret
    }

    /// 兼容入口：不指定 vtable 名称
    fun emitClassConstructor(enc: X86Encoder, size: Int): Unit {
        emitClassConstructorWithVtable(enc, size, "")
    }

    // ── Step 4: POSIX 函数实现 ──

    /// 编码 `open(rcx=path, rdx=flags) rax = handle or -1`
    /// 使用 NtCreateFile syscall（服务号 0x05），ASCII→UTF-16 转换
    fun emitOpen(enc: X86Encoder): Unit {
        // ⚠️ 2026-10-03 换道：旧 NtCreateFile 直编版（UNICODE 转换 + 11 参
        // 栈布局）实测 fd 恒 -1。改走 kernel32 `CreateFileA` 导入（与
        // GetFileSize/GetEnvironmentVariableA 同一已验证机制）：
        //   io_open(rcx=path, rdx=flags) rax = handle | -1
        // flags==0 → GENERIC_READ + OPEN_EXISTING；否则 GENERIC_WRITE +
        // CREATE_ALWAYS（覆盖 File.writeText 的 1|0x40|0x200 组合）。
        enc.emitPrologue(0x40)
        // rdx = flags 判读后即写 DesiredAccess（先存 flags 到栈，防被覆盖）
        enc.emitStackStore(-0x8, "rdx")
        enc.emitCmpRI("rdx", 0)
        enc.emitJccLabel("ne", "open_write")
        enc.emitMovRI("edx", -1073741824)              // GENERIC_READ (0x80000000)
        enc.emitJmpLabel("open_acc_done")
        enc.emitLabel("open_write")
        enc.emitMovRI("edx", 1073741824)               // GENERIC_WRITE (0x40000000)
        enc.emitLabel("open_acc_done")
        enc.emitXorRR("r8", "r8")                      // share = 0
        enc.emitXorRR("r9", "r9")                      // security = 0
        // 第 5 参 CreateDisposition：flags==0（读）→ OPEN_EXISTING；
        // 否则（写，O_CREAT|O_TRUNC）→ CREATE_ALWAYS —— .hat 首写必需
        //（旧值恒 3 ⇒ 写新文件必失败，实测 "Failed to read .hat file"）。
        // ⚠️ 栈参定位（P232 勘误）：emitPrologue(0x40) **含 push rbp** ⇒
        // rbp = 入口rsp−8，rsp = rbp−0x40 ⇒ arg5/6/7 = [rsp+0x20/28/30] =
        // **rbp−0x20/−0x18/−0x10**（原始写法正确）。曾误按 rbp−0x48 改成
        // −0x28/−0x20/−0x18 ⇒ disposition 落到 arg5 读到 0x80 ⇒ CreateFileA
        // 报 ERROR 87（INVALID_PARAMETER），已回滚。
        enc.emitStackLoad("rax", -0x8)                 // flags
        enc.emitCmpRI("rax", 0)
        enc.emitMovRI32("eax", 3)                      // OPEN_EXISTING
        enc.emitJccLabel("eq", "open_disp")
        enc.emitMovRI32("eax", 2)                      // CREATE_ALWAYS
        enc.emitLabel("open_disp")
        enc.emitStackStore(-0x20, "rax")               // arg5 @ [rsp+0x20]
        enc.emitMovRI32("eax", 128)                    // 第 6 参：FILE_ATTRIBUTE_NORMAL
        enc.emitStackStore(-0x18, "rax")               // arg6 @ [rsp+0x28]
        enc.emitXorRR("eax", "eax")                    // 第 7 参：hTemplate = 0
        enc.emitStackStore(-0x10, "rax")               // arg7 @ [rsp+0x30]
        enc.emitCallImport("CreateFileA")
        // 失败（INVALID_HANDLE_VALUE = -1）→ 返回 GetLastError 码（诊断期，
        // 2026-10-03：fd 恒 -1 需要真实失败原因；修通后改回 -1）
        enc.emitCmpRI("rax", -1)
        enc.emitJccLabel("ne", "open_ok")
        enc.emitCallImport("GetLastError")
        enc.emitLabel("open_ok")
        enc.emitEpilogue()
    }

    /// 编码 `close(rcx=fd) rax = 0`。kernel32 `CloseHandle`（2026-10-03 换道）
    fun emitClose(enc: X86Encoder): Unit {
        enc.emitPrologue(0x20)
        enc.emitCallImport("CloseHandle")
        enc.emitXorRR("eax", "eax")                    // 恒返回 0（尽力而为）
        enc.emitEpilogue()
    }

    /// 编码 `read(rcx=fd, rdx=buf, r8=count) rax = bytes or -1`。
    /// kernel32 `ReadFile`（2026-10-03 换道；handle 即 io_open 的返回值）。
    fun emitRead(enc: X86Encoder): Unit {
        enc.emitPrologue(0x40)
        enc.emitLeaStack("r9", -0x8)                   // lpNumberOfBytesRead
        enc.emitXorRR("eax", "eax")
        enc.emitStoreMemDisp32("r9", 0, "rax")
        enc.emitXorRR("eax", "eax")                    // lpOverlapped = 0
        enc.emitStackStore(-0x20, "rax")               // arg5 @ [rsp+0x20] = rbp−0x20
        enc.emitCallImport("ReadFile")
        enc.emitCmpRI("eax", 0)
        enc.emitJccLabel("eq", "read_fail")
        // 实际读到的字节数在 [rbp-0x8]（lpNumberOfBytesRead）。
        // ⚠️ 旧实现返回 r9 —— ReadFile 调用后 r9 已被冲，恒返回垃圾/0：
        // File.readText 的 `read <= 0` 守卫因此把**成功读取**当失败，
        // 永远返回空串（§8.5 已知遗留，2026-10-03 修复）。当时的
        // 「改 StackLoad ⇒ 驱动启动无限递归」是驱动自身值模型缺陷
        // （本轮已定位为 bump 游标重叠/RA 区间断裂家族），与本函数无关。
        enc.emitStackLoad("rax", -0x8)
        enc.emitJmpLabel("read_done")
        enc.emitLabel("read_fail")
        enc.emitMovRI("eax", -1)
        enc.emitLabel("read_done")
        enc.emitEpilogue()
    }

    /// 编码 `write(rcx=fd, rdx=buf, r8=count) rax = bytes or -1`。NtWriteFilex08）
    fun emitWrite(enc: X86Encoder): Unit {
        enc.emitPrologue(0x60)
        enc.emitStackStore(-0x20, "rbx")
        enc.emitStackStore(-0x28, "rsi")
        enc.emitStackStore(-0x10, "rcx")
        enc.emitStackStore(-0x18, "rdx")
        enc.emitStackStore(-0x30, "r8")
        enc.emitLeaStack("rbx", -0x50)
        enc.emitXorRR("rax", "rax")
        enc.emitStoreMemDisp32("rbx", 0, "rax")
        enc.emitStoreMemDisp32("rbx", 8, "rax")
        enc.emitXorRR("rax", "rax")
        enc.emitStackStore(-0x38, "rax")
        enc.emitStackStore(-0x50, "rax")
        enc.emitStackStore(-0x58, "rax")
        enc.emitStackStore(-0x50, "rax")
        enc.emitStackStore(-0x58, "rax")
        enc.emitStackLoad("rcx", -0x10)
        enc.emitStackLoad("rdx", -0x18)
        enc.emitStackLoad("r8", -0x30)
        enc.emitLeaStack("r9", -0x50)
        SyscallEmitter.emitWindowsSyscall(enc, 0x08, "rcx", "rdx", "r8", "r9")
        enc.emitCmpRI("eax", 0)
        enc.emitJccLabel("ne", "write_fail")
        enc.emitStackLoad("rax", -0x48)
        enc.emitJmpLabel("write_done")
        enc.emitLabel("write_fail")
        enc.emitMovRI("eax", -1)
        enc.emitLabel("write_done")
        enc.emitStackLoad("rsi", -0x28)
        enc.emitStackLoad("rbx", -0x20)
        enc.emitEpilogue()
    }

    /// 编码 `access(rcx=path, rdx=mode) rax = 0`。stub 返回 0（存在）
    fun emitAccess(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitMovRI("eax", 0)
        enc.emitEpilogue()
    }

    /// 编码 `FileOps_lseek(fd, offset, whence) rax = size|0`（2026-10-03，fs 探针）
    ///
    /// 语义只需覆盖 `File.readText` 的装载模式：
    ///   * `whence==2`（SEEK_END）→ 返回文件大小（kernel32 `GetFileSize`）；
    ///   * `whence==0`（SEEK_SET）→ 返回 0——**不移动 OS 位置**：装载流是
    ///     open → lseek(END) 取大小 → lseek(SET,0) 复位 → read，open 后
    ///     位置本就在 0，前两步之间无读取，NtReadFile(NULL offset) 自然从 0 读。
    ///   * 其它（SEEK_CUR 等）→ -1（未实现，调用方按失败处理）。
    /// 失败（句柄无效）返回 -1：调用方 `size <= 0` 分支安全收敛。
    fun emitFileOpsLseek(enc: X86Encoder): Unit {
        enc.emitPrologue(0x20)
        enc.emitCmpRI("r8", 2)
        enc.emitJccLabel("eq", "lsk_end")
        enc.emitCmpRI("r8", 0)
        enc.emitJccLabel("eq", "lsk_set")
        enc.emitMovRI("rax", -1)        // 其它 whence：未实现（64 位 -1）
        enc.emitEpilogue()
        enc.emitLabel("lsk_set")
        enc.emitXorRR("rax", "rax")     // SEEK_SET：位置已在 0，返回 0
        enc.emitEpilogue()
        enc.emitLabel("lsk_end")
        enc.emitXorRR("rdx", "rdx")     // lpFileSizeHigh = NULL
        enc.emitCallImport("GetFileSize")
        // ⚠️ 必须 32 位比较（emitCmpEaxImm32）：Win64 只写 eax、rax 高位零
        // 扩展，`cmp rax, -1` 撞不上 64 位 -1 ⇒ INVALID 哨兵失效 ⇒
        // 返回 +4294967295 骗过 `size <= 0` 守卫 ⇒ malloc(4G) 段错误
        //（实测 fs 探针 readText，2026-10-03；§8.4 只修了 mov 侧）。
        enc.emitCmpEaxImm32(-1)         // INVALID_FILE_SIZE → -1
        enc.emitJccLabel("ne", "lsk_ok")
        // P232 诊断：INVALID 时返回 -(GetLastError)-1000，guest 端打印
        // 即可读出 Win32 错误码（定位句柄无效的原因后移除）。
        enc.emitCallImport("GetLastError")
        enc.emitAddRI("rax", 1000)
        enc.emitMovRI("rdx", -1)
        enc.emitSubRR("rax", "rdx")
        enc.emitEpilogue()
        enc.emitMovRI("rax", -1)        // 必须 64 位：eax 只写低 32 位，
        enc.emitEpilogue()              // 高位残留 ⇒ size 变 4294967295 ⇒
                                        // 调用方 malloc(4G) 段错误（fs 探针）
        enc.emitLabel("lsk_ok")
        enc.emitEpilogue()
    }

    /// 编码 `exitGroup(rcx=code)`。NtTerminateProcessx2C）
    fun emitExitGroup(enc: X86Encoder): Unit {
        enc.emitPrologue(0x20)
        enc.emitStackStore(-0x10, "rcx")
        enc.emitMovRI("r10", -1)
        enc.emitStackLoad("rdx", -0x10)
        SyscallEmitter.emitSyscall(enc, 0x2C)
        enc.emitEpilogue()
    }

    /// stub: fork/execve/wait4 返回 -1
    fun emitStubMinus1(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitMovRI("eax", -1)
        enc.emitEpilogue()
    }

    // ── P4：线程支持（`extern interface ThreadOps` 的运行库实现）──
    //
    // Photon 运行库目前是**单线程**的：`Mutex` / `Condvar` 由 Aura 侧基于
    // `Memory.atomicAdd`（`lock xaddq`，真原子）实现，没有线程注册表与调度器。
    // 这里提供 `ThreadOps` 的 5 个符号，保证「引用即已定义」（旧实现完全缺失，
    // P4/test_thread 在链接期 `undefined symbol: ThreadOps_currentId`）：
    //   * `currentId` → 主线程 id = 1（与 VM 参考实现输出一致）
    //   * `cores`     → 1
    //   * `create` / `join` → 0（未创建线程）
    //   * `sleepMs`   → 即时返回
    // 语义上限写在此处：真正的线程创建需要 OS 线程 + Aura 函数回调桥，属后续工作。

    fun emitThreadOpsCurrentId(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitMovRI("eax", 1)
        enc.emitEpilogue()
    }

    fun emitThreadOpsCores(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitMovRI("eax", 1)
        enc.emitEpilogue()
    }

    // ── Cpu（extern interface @native(asm=…)）原语 ─────────────────────
    // ABI（2026-10-03 定版）：Hir.aura lowerCall 对大写 Ident 接收者保留
    // HirVar(name)，buildCall 的 skipFirst 识别单例/extern 后**丢弃接收者**
    // ⇒ extern interface 成员调用点 = 普通函数形状，rcx=首实参。
    //   Cpu_rdtsc() / Cpu_memFence()   无参
    //   Cpu_cpuid(level)               rcx=level
    //   Cpu_atomicAdd(a, d)            rcx=addr, rdx=delta

    /// 编码 `Cpu_rdtsc() rax = 64 位时间戳`：rdtsc → edx:eax → rax 组合
    fun emitCpuRdtsc(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.writeByte(0x0F); enc.writeByte(0x31)      // rdtsc
        enc.emitShlRI("rdx", 32)                       // rdx <<= 32
        enc.emitOrRR("rax", "rdx")                     // rax |= rdx
        enc.emitEpilogue()
    }

    /// 编码 `Cpu_memFence()`：mfence 全序栅栏
    fun emitCpuMemFence(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.writeByte(0x0F); enc.writeByte(0xAE); enc.writeByte(0xF0)  // mfence
        enc.emitEpilogue()
    }

    /// 编码 `Cpu_cpuid(level) rax = 叶信息`：CPUID 零扩展 rax 高 32 位
    fun emitCpuCpuid(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.writeByte(0x89); enc.writeByte(0xC8)      // mov eax, ecx（level）
        enc.writeByte(0x0F); enc.writeByte(0xA2)      // cpuid
        enc.emitEpilogue()
    }

    /// 编码 `Cpu_atomicAdd(addr, delta) rax = 旧值`：lock xadd qword [rcx], rdx
    fun emitCpuAtomicAdd(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.writeByte(0xF0); enc.writeByte(0x48); enc.writeByte(0x0F)
        enc.writeByte(0xC1); enc.writeByte(0x11)      // lock xadd [rcx], rdx（ModRM 11 = reg rdx / rm rcx）
        enc.writeByte(0x48); enc.writeByte(0x89); enc.writeByte(0xD0)  // mov rax, rdx
        enc.emitEpilogue()
    }

    fun emitStubZero(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitMovRI("eax", 0)
        enc.emitEpilogue()
    }

    fun emitStubVoid(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitEpilogue()
    }

    /// stub: Collections.getAt 返回**静态空串**（`@str.0`）。
    ///
    /// `Env.get` 被映射到 `Collections.getAt`，但 runtime 没有真正的键值存储。
    ///
    /// ⚠️ 旧实现 `mov rax, rdx`（「返回第二个参数」）在**单实参**调用点上取的是
    /// **未定义的 `rdx`**。`Env.get("AURA_ARGV_COUNT")` 恰好就是单参调用：
    /// 它返回一个垃圾指针，紧接着 `cliEnvArgCount()` 做 `s.length` / `charCodeAt`
    /// ⇒ 对垃圾指针越界读 ⇒ **自举 `Main.exe` 零参数也直接崩**
    ///（`0xC0000005`，且零输出 —— 因为 `main` 第一条语句就是
    /// `cliArgCount()` → `cliEnvArgCount()` → `Env.get`）。
    ///
    /// 返回 `@str.0` 保证「查不到 = 空串」且指针永远有效（与同文件的
    /// `emitCliArg` 用同一个静态空串串常量）。
    ///
    /// 真正的环境变量读取需要访问 PEB
    ///（`gs:[0x60]` → ProcessParameters(+0x20) → Environment(+0x80)，NUL 分隔、
    /// 双 NUL 结尾），而编码器目前**没有段前缀（0x65）支持** —— 属后续工作项。
    /// 因此 `AURA_ARGV_COUNT` / `AURA_ARG_*` 这条 CLI 通道在自举产物里暂时不生效。
    fun emitCollectionsGetAt(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitLeaRIP("rax", "@str.0")
        enc.emitEpilogue()
    }

    /// 编码 `env_get(rcx=name) rax = char*` — **真正的**环境变量读取（PEB 实现）。
    ///
    /// ⚠️ **不能用 `GetEnvironmentVariableA`**：本运行时是「零 DLL 导入、全走
    /// syscall（`Nt*`）」的自研实现（见 `PhotonPipeline` 的 `useDefaultLibs = false`
    /// 注释），而链接命令不带任何导入库（`LIB` 环境变量也常为空）⇒ 引入导入就是
    /// `lld-link: error: undefined symbol: __declspec(dllimport) GetEnvironmentVariableA`
    ///（实测：驱动内部链接因此失败）。
    ///
    /// PEB 链（Windows 10/11 x64 固定偏移，与 `emitPrintln` 取 hStdOutput 同源）：
    ///     rax = gs:[0x60]        ; TEB.Peb
    ///     rax = [rax + 0x20]     ; PEB.ProcessParameters（RTL_USER_PROCESS_PARAMETERS*）
    ///     rax = [rax + 0x80]     ; ProcessParameters.Environment（**UTF-16** 块）
    /// 块内每条为 `NAME=VALUE\0`（UTF-16），整块以**空条目**（双 NUL）结尾。
    ///
    /// 环境变量名恒为 ASCII，所以：
    ///   * 「条目/值的低字节是否为 0」可当作 NUL 判据（低字节在前）；
    ///   * 比较用 `name[i]`（ANSI）对 `entry[2i]` 的**低字节**；
    ///   * 命中后把值的低字节逐字符拷进 `envBuffer`，得到 ANSI 串返回。
    ///
    /// 查不到时返回静态空串 `@str.0`（**绝不**返回 `rdx`：`Env.get(name)` 存在
    /// 单实参调用点，那时 `rdx` 是未定义值 —— 旧 `Collections.getAt` 的
    /// `mov rax, rdx` 正是因此返回垃圾指针而崩）。代码库里
    /// `Env.get(name, default)` 的 default 一律是 `""`，语义等价。
    /// 编码 `env_get(rcx=name) rax = char*` —— **Win32 `GetEnvironmentVariableA` 版**。
    ///
    /// 为什么不用下面的 PEB 版（`emitEnvGetPeb`）：那条路要**逐字节扫描** UTF-16
    /// 环境块，依赖 `emitMovzxRegMemByte`。实测该编码原语在当前编码器上产出的
    /// 字节流是错的 —— `build\envprobe\aura_runtime.obj` 的 `env_get` 里出现
    ///     `movzbq 0x4d(%r10), %r10` / `movzbl 0x4d(%rbx), %ecx`
    /// （`0x4d` 是本该在指令**最前**的 REX 前缀，却被当成位移 ✗）⇒ 扫描必然失败
    /// ⇒ 恒返回空 `envBuffer` ⇒ 自举 `Main.exe` 的 `cliEnvArgCount()` 得 0。
    ///
    /// 本版只用「置参数 + `call qword ptr [rip+__imp_...]`」：运行库本就以同一机制
    /// 导入 kernel32（`__imp_GetStdHandle` / `__imp_WriteFile`），链接器从
    /// `kernel32.lib` 解析，无需任何导入表代码；且它直接给 **ANSI**，省掉 UTF-16 转换。
    ///
    /// ⚠️ 查不到时返回**静态空串** `@str.0`，绝不返回未定义值：`Env.get(name)`
    /// 存在**单实参**调用点，那时 rdx 是脏值；代码库里 `Env.get(name, default)` 的
    /// default 一律是 `""`，故「缺失 = 空串」语义等价。
    fun emitEnvGetWin32(enc: X86Encoder): Unit {
        // 帧 0x40：为被调者留 32 字节 shadow space，且 call 处 rsp 16 字节对齐。
        enc.emitPrologue(0x40)
        enc.emitLeaRIP("rdx", "envBuffer")
        enc.emitMovRI("r8", 4096)
        enc.emitCallImport("GetEnvironmentVariableA")
        enc.emitTestRR("rax", "rax")
        enc.emitJccLabel("eq", "egw_missing")
        enc.emitLeaRIP("rax", "envBuffer")
        enc.emitEpilogue()
        enc.emitLabel("egw_missing")
        enc.emitLeaRIP("rax", "@str.0")
        enc.emitEpilogue()
    }

    /// PEB 链版 `env_get`（保留备用；当前**未被注册**，见 `emitEnvGetWin32` 的说明）。
    fun emitEnvGetPeb(enc: X86Encoder): Unit {
        // 帧 0x40：不调用外部函数，仅留出常规空间并保持 16 字节对齐。
        enc.emitPrologue(0x40)
        // ⚠️ 只用**易失**寄存器（rcx/rdx/r8-r11），**不用 rdi/rsi**：
        // 生成代码的函数入口会 `push rdi/rsi`，说明分配器会把活值放在这两个
        // 寄存器上；运行库若拿它们当临时变量，就会破坏调用方的活值。
        // 实测症状正是「小探针不崩、自举 `Main.exe` 在 `BOOT-1` 后直接
        // `0xC0000005`」——大函数 `main` 在 rdi/rsi 上有跨调用活值。
        //   rcx = name（入参，保持不动）   r10 = 名字扫描指针
        //   r11 = 环境块条目指针           r8/r9 = 临时      rdx = 拷贝写指针
        enc.emitMovGSSeg64("rax", 0x60)                 // rax = PEB
        enc.emitMovMemDisp8("rax", "rax", 0x20)         // rax = ProcessParameters
        enc.emitMovMemDisp32("rax", "rax", 0x80)        // rax = Environment（UTF-16）
        // 防御：指针必须像用户态地址（> 0x10000）。这里用**寄存器**比较 ——
        // 实测 `cmp reg, 65536` 这类大立即数比较在本编码器上不可信
        //（诊断版正是因此没拦住，直接 `0xC0000005`）。
        enc.emitMovRI("r8", 65536)
        enc.emitCmpRR("rax", "r8")
        enc.emitJccLabel("lt", "eg_missing")
        enc.emitMovRR("r11", "rax")
        enc.emitLabel("eg_entry")
        // 空条目（低字节 0）＝ 整块结束
        enc.emitCmpByteMemImm8("r11", 0)
        enc.emitJccLabel("eq", "eg_missing")
        enc.emitMovRR("r10", "rcx")
        enc.emitLabel("eg_cmp")
        enc.emitMovzxRegMemByte("r9", "r10")            // r9 = name[i]
        enc.emitMovzxRegMemByte("r8", "r11")            // r8 = entry 低字节
        enc.emitTestRR("r9", "r9")
        enc.emitJccLabel("eq", "eg_nameend")           // 名字比完 → 看条目侧是否为 '='
        enc.emitCmpRR("r9", "r8")
        enc.emitJccLabel("ne", "eg_next")
        enc.emitIncRR("r10")
        enc.emitAddRI("r11", 2)
        enc.emitJmpLabel("eg_cmp")
        enc.emitLabel("eg_nameend")
        // ⚠️ 这里**必须**先比完名字再看 '='。旧逻辑在循环里直接判
        // `entry == '='` 就进「命中」分支 —— 而 Windows 环境块常以
        // `=C:=C:\...` 这类**以 '=' 开头**的条目打头，于是第一条就被误判为命中，
        // 返回 `C:=C:\...`（或后续行为不可预期）。
        enc.emitCmpRI("r8", 61)                        // '='
        enc.emitJccLabel("eq", "eg_found")
        enc.emitJmpLabel("eg_next")
        enc.emitLabel("eg_next")
        // 跳过本条目剩余部分，直到其 UTF-16 NUL，再越过它
        enc.emitLabel("eg_next_scan")
        enc.emitCmpByteMemImm8("r11", 0)
        enc.emitJccLabel("eq", "eg_next_done")
        enc.emitAddRI("r11", 2)
        enc.emitJmpLabel("eg_next_scan")
        enc.emitLabel("eg_next_done")
        enc.emitAddRI("r11", 2)
        enc.emitJmpLabel("eg_entry")
        enc.emitLabel("eg_found")
        enc.emitAddRI("r11", 2)                        // 越过 '='
        enc.emitLeaRIP("rdx", "envBuffer")
        enc.emitLabel("eg_copy")
        enc.emitCmpByteMemImm8("r11", 0)
        enc.emitJccLabel("eq", "eg_copy_done")
        enc.emitMovzxRegMemByte("r8", "r11")
        enc.emitMovByteMemReg("rdx", "r8")
        enc.emitIncRR("rdx")
        enc.emitAddRI("r11", 2)
        enc.emitJmpLabel("eg_copy")
        enc.emitLabel("eg_copy_done")
        enc.emitMovRI("r8", 0)
        enc.emitMovByteMemReg("rdx", "r8")             // NUL 结尾
        enc.emitLeaRIP("rax", "envBuffer")
        enc.emitEpilogue()
        enc.emitLabel("eg_missing")
        enc.emitLeaRIP("rax", "@str.0")
        enc.emitEpilogue()
    }

    /// 编码 `ProcessOps_execve` / `ProcessOps_fork` / `ProcessOps_wait4` —— 统一返回 -1。
    ///
    /// POSIX 进程原语在 Windows 光子路径上**不适用**：本运行时是「零 DLL 导入、
    /// 全走 syscall（`Nt*`）」的自研实现，既没有 CRT 也没有 `CreateProcess`
    /// 可用；而这些符号由 stdlib 的 `ProcessOps` 声明、被 `ProcessNative` 等引用，
    /// 不提供就是 `lld-link: error: undefined symbol: ProcessOps_execve`（实测自举）。
    /// 自举 `Main.aura` 的 Windows 路径不会真正走到它们，桩实现（-1 = 失败/未支持）
    /// 语义足够且安全。
    ///
    /// 用 `xor` + `sub` 而不是 `mov rax, -1`：后者依赖立即数编码的符号扩展，
    /// 这里用两条最简指令，行为确定。
    fun emitProcessOpsUnsupported(enc: X86Encoder): Unit {
        enc.emitXorRR("rax", "rax")
        enc.emitSubRI("rax", 1)
        enc.emitRet()
    }

    /// 编码 `Memory_copy(rcx=dst, rdx=src, r8=count)` — 逐字节拷贝。
    ///
    /// 用 `emitLoadIndexed8` / `emitStoreIndexed8` 手写循环（编码器没有 `rep movsb`）：
    /// 这两个原语是**零分配内联访存**，且索引寄存器成对出现，正好适配。
    /// 自举 `Main.aura` 里 `Memory.copy` 属 stdlib 的常用操作，缺它就是
    /// `lld-link: error: undefined symbol: Memory_copy`。
    fun emitMemoryCopy(enc: X86Encoder): Unit {
        // ⚠️ P247 终审修复：n 是**字节数**（memcpy 语义），循环必须按
        // **QWORD 次数 = ceil(n/8)** 迭代。旧实现拿字节数当 QWORD 次数
        // ⇒ **8 倍过量复制**——每次 listAppend grow / 任何 Memory.copy
        // 都把 dst 之后 7n 字节的相邻堆块刷成源数据（实测 numArgsFlat
        // items 被grow 的旧元素成批覆盖、§10.47 渐进覆写模式的真身）。
        enc.emitPrologue(0)
        // P248 归因实验结论：还原旧行为后解码仍 n=8 ⇒ Memory_copy 修复无罪，
        // 解码回归为**布局依赖的同一底层缺陷**（探针/extern interface 加入
        // 即改变表现位置）。恢复 ceil(n/8) 正确语义。
        enc.emitMovRR("r10", "r8")             // r10 = qword 次数 = ceil(n/8)
        enc.emitAddRI("r10", 7)
        enc.emitShrRI("r10", 3)
        enc.emitXorRR("rax", "rax")            // rax = 下标
        enc.emitLabel("mc_loop")
        enc.emitCmpRR("rax", "r10")
        enc.emitJccLabel("ge", "mc_done")      // rax >= 次数 → 结束
        enc.emitLoadIndexed8("r9", "rdx", "rax", 0)
        enc.emitStoreIndexed8("rcx", "rax", 0, "r9")
        enc.emitIncRR("rax")
        enc.emitJmpLabel("mc_loop")
        enc.emitLabel("mc_done")
        enc.emitEpilogue()
    }

    /// 编码 `Memory_mprotect(addr, len, prot)` — Windows 光子路径不做页保护变更，
    /// 恒返回 0（= 成功）。裸映射场景下调它只是「尽力而为」的保护设置，
    /// 没有它会是 `undefined symbol: Memory_mprotect`。
    fun emitMemoryMprotect(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitMovRI("eax", 0)
        enc.emitEpilogue()
    }

    /// **临时诊断**：把「PEB → ProcessParameters → +disp 处」的头 32 字节
    ///（低字节）当字符串返回，用于确认环境块偏移是否正确。
    /// 定好偏移后应删除本函数，并把 `env_get` 指回 `emitEnvGet`。
    fun emitEnvGetDebugDump(enc: X86Encoder, disp: Int): Unit {
        enc.emitPrologue(0x40)
        enc.emitMovGSSeg64("rax", 0x60)              // PEB
        enc.emitMovMemDisp8("rax", "rax", 0x20)      // ProcessParameters
        enc.emitMovMemDisp32("rax", "rax", disp)     // 目标字段
        enc.emitMovRR("rsi", "rax")
        enc.emitLeaRIP("r11", "envBuffer")
        enc.emitMovRI("r9", 0)                       // 计数
        enc.emitLabel("dbg_copy")
        enc.emitCmpRI("r9", 32)
        enc.emitJccLabel("ge", "dbg_done")
        enc.emitMovzxRegMemByte("r8", "rsi")
        enc.emitMovByteMemReg("r11", "r8")
        enc.emitIncRR("r11")
        enc.emitIncRR("rsi")
        enc.emitIncRR("r9")
        enc.emitJmpLabel("dbg_copy")
        enc.emitLabel("dbg_done")
        enc.emitMovRI("r8", 0)
        enc.emitMovByteMemReg("r11", "r8")
        enc.emitLeaRIP("rax", "envBuffer")
        enc.emitEpilogue()
    }

    /// 对 `[ProcessParameters + disp]` 打一个标记字符：
    ///   * 若该字段像**用户态指针**（`> 0x10000`，可排除句柄/长度值）**且**解引用后
    ///     首字节是可打印 ASCII（0x20..0x7E），记**大写**字母（第 `idx` 个）；
    ///   * 否则记小写字母。
    ///
    /// 为什么这样判定：环境块内容形如 `NAME=VALUE\0`（UTF-16，低字节在前），
    /// 其首字节必然是 `=`(0x3D) 或字母 ⇒ 可打印 ✓；而句柄（如 `0xC`）或长度值
    /// 不会通过 `> 0x10000` 这一关，从而**避免解引用非指针字段导致的访问违例**。
    private fun emitFieldPrintableFlag(enc: X86Encoder, disp: Int, idx: Int): Unit {
        val id: String = toStr(idx)
        enc.emitMovGSSeg64("rax", 0x60)
        enc.emitMovMemDisp8("rax", "rax", 0x20)          // rax = ProcessParameters
        enc.emitMovMemDisp32("r10", "rax", disp)         // r10 = 字段值
        enc.emitCmpRI("r10", 65536)
        enc.emitJccLabel("lt", "egf_low_" + id)
        enc.emitMovzxRegMemByte("r9", "r10")             // r9 = *字段（首字节）
        enc.emitCmpRI("r9", 32)
        enc.emitJccLabel("lt", "egf_no_" + id)
        enc.emitCmpRI("r9", 127)
        enc.emitJccLabel("ge", "egf_no_" + id)
        enc.emitMovRI("r8", 65 + idx)                    // 大写 = 命中
        enc.emitJmpLabel("egf_st_" + id)
        enc.emitLabel("egf_no_" + id)
        enc.emitMovRI("r8", 97 + idx)
        enc.emitJmpLabel("egf_st_" + id)
        enc.emitLabel("egf_low_" + id)
        enc.emitMovRI("r8", 97 + idx)
        enc.emitLabel("egf_st_" + id)
        enc.emitMovByteMemReg("r11", "r8")
        enc.emitIncRR("r11")
    }

    /// **临时诊断**：返回 6 个标记字符，逐个对应候选偏移处的「可打印指针」判定。
    ///   0 → `0x68`（`ImagePathName.Buffer`，**对照点**，必然大写 `A`）
    ///   1 → `0x80`  2 → `0x88`  3 → `0x90`  4 → `0xA0`  5 → `0xB0`
    /// `Environment` 的实际偏移 = 输出里第 1 个**大写**字母对应的那个（除对照点）。
    /// 定好偏移后删除本函数，并把 `env_get` 指回 `emitEnvGet`。
    fun emitEnvOffsetProbe(enc: X86Encoder): Unit {
        enc.emitPrologue(0x40)
        enc.emitLeaRIP("r11", "envBuffer")
        this.emitFieldPrintableFlag(enc, 0x68, 0)
        this.emitFieldPrintableFlag(enc, 0x80, 1)
        this.emitFieldPrintableFlag(enc, 0x88, 2)
        this.emitFieldPrintableFlag(enc, 0x90, 3)
        this.emitFieldPrintableFlag(enc, 0xA0, 4)
        this.emitFieldPrintableFlag(enc, 0xB0, 5)
        enc.emitMovRI("r8", 0)
        enc.emitMovByteMemReg("r11", "r8")
        enc.emitLeaRIP("rax", "envBuffer")
        enc.emitEpilogue()
    }

    /// **临时诊断（安全版）**：返回 2 字符。
    ///   [0]：`Y` = `[ProcessParameters+0x80]` 通过 `> 0x10000`（像用户态指针）；
    ///        `N` = 未通过。
    ///   [1]：通过时解引用取首字节 —— `P` 可打印（环境条目应为 `=`/字母）、
    ///        `X` 不可打印；未通过时为 `-`。
    ///
    /// 一次运行即可区分「偏移不对」与「扫描逻辑不对」，且**不会**解引用小整数
    ///（上一版多偏移探针就是因为在无检查的情况下解引用而崩溃）。
    fun emitEnvDiag2(enc: X86Encoder): Unit {
        enc.emitPrologue(0x40)
        enc.emitLeaRIP("r11", "envBuffer")
        enc.emitMovGSSeg64("rax", 0x60)
        enc.emitMovMemDisp8("rax", "rax", 0x20)
        enc.emitMovMemDisp32("r10", "rax", 0x80)
        enc.emitCmpRI("r10", 65536)
        enc.emitJccLabel("lt", "eg2_noptr")
        enc.emitMovRI("r8", 89)                        // 'Y'
        enc.emitMovByteMemReg("r11", "r8")
        enc.emitIncRR("r11")
        enc.emitMovzxRegMemByte("r9", "r10")
        enc.emitCmpRI("r9", 32)
        enc.emitJccLabel("lt", "eg2_np")
        enc.emitCmpRI("r9", 127)
        enc.emitJccLabel("ge", "eg2_np")
        enc.emitMovRI("r8", 80)                        // 'P'
        enc.emitJmpLabel("eg2_w")
        enc.emitLabel("eg2_np")
        enc.emitMovRI("r8", 88)                        // 'X'
        enc.emitJmpLabel("eg2_w")
        enc.emitLabel("eg2_noptr")
        enc.emitMovRI("r8", 78)                        // 'N'
        enc.emitMovByteMemReg("r11", "r8")
        enc.emitIncRR("r11")
        enc.emitMovRI("r8", 45)                        // '-'
        enc.emitJmpLabel("eg2_done")
        enc.emitLabel("eg2_w")
        enc.emitMovByteMemReg("r11", "r8")
        enc.emitIncRR("r11")
        enc.emitLabel("eg2_done")
        enc.emitMovRI("r8", 0)
        enc.emitMovByteMemReg("r11", "r8")
        enc.emitLeaRIP("rax", "envBuffer")
        enc.emitEpilogue()
    }

    /// 编码 `__obj_slot_get(rcx=slot) rax = objSlots[slot]`（0 = 尚未分配）。
    ///
    /// `SsaBuilder.synthesizeSingletonGetter` 生成的 `<Name>_getInstance()` 会先
    /// 调它判空（空则 `Memory_alloc` 并逐字段写默认值），再把缓存指针写回。
    /// 这两个符号**必须由 runtime 提供**：生成器只发调用点，用户侧没有定义 ⇒
    /// 缺了就是 `lld-link: error: undefined symbol: __obj_slot_get`
    ///（实测自举 `Main.exe` 链接失败，引用点 `Allocator_getInstance`）。
    fun emitObjSlotGet(enc: X86Encoder): Unit {
        // rcx = slot；eax = 0 是合法值（未分配），调用者据此分配
        enc.emitPrologue(0)
        enc.emitLeaRIP("rax", "objSlots")
        enc.emitShlRI("rcx", 3)                    // slot * 8（每槽一个指针）
        enc.emitAddRR("rax", "rcx")
        enc.emitMovMemDisp32("rax", "rax", 0)      // rax = [objSlots + slot*8]
        enc.emitEpilogue()
    }

    /// 编码 `__obj_slot_set(rcx=slot, rdx=obj)` — 缓存单例实例指针。
    fun emitObjSlotSet(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitLeaRIP("rax", "objSlots")
        enc.emitShlRI("rcx", 3)
        enc.emitAddRR("rax", "rcx")
        enc.emitStoreMemDisp32("rax", 0, "rdx")    // [objSlots + slot*8] = rdx
        enc.emitEpilogue()
    }

    /// 编码 `cliArgCount() rax = Int` — 返回命令行参数个数（当前固定 0）
    ///
    /// 无 CRT 环境下 OS 直接调用 entry point（无 argc/argv 参数），
    /// 因此暂返回 0。后续可改为从 PEB/TEB 读取命令行并解析。
    fun emitCliArgCount(enc: X86Encoder): Unit {
        enc.emitMovRI("eax", 0)
        enc.emitRet()
    }

    /// 编码 `cliArg(index: Int) rax = char*` — 返回指定索引的参数（当前返回空串）
    ///
    /// 无 CRT 环境下无法解析命令行，返回指向静态空串的指针。
    fun emitCliArg(enc: X86Encoder): Unit {
        enc.emitLeaRIP("rax", "@str.0")
        enc.emitRet()
    }

    // ── Step 4: Memory 内置函数实现 ──
    //
    // `Memory.write/read/alloc/free` Aura 源码中是 `extern interface Memory`
    // 的无 @native 注解方法（编译器内置）。Rust AOT 后端将它们内联为 store/load
    // 指令，但 Photon 后端不做内联 —如果调用被映射到 `write`（FileOps.write
     // 运行时函数），`Memory.write(addr, val)` 会被当成文件 I/O 写：fd=addr（无效）
    // buf=val（小整数），count=未定NtWriteFile 失败返回 0 -1，导
    // `writeObjectFile()` `while (written < want)` 无限循环挂起
    //
    // 修复：提供独立的 `Memory_write` / `Memory_read` / `Memory_alloc` / `Memory_free`
    // 符号，并`mapStdlibFuncName` 中按首参类型区分（Long Memory，Int FileOps）
    /// 编码 `Memory_write(rcx=addr, rdx=val) 无返回值`：将 val 写入 addr 指向的字节
    fun emitMemoryWrite(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        // rcx = addr, rdx = val
        // store byte [rcx], dl
        enc.emitMovByteMemReg("rcx", "rdx")
        enc.emitEpilogue()
    }

    /// 编码 `Memory_read(rcx=addr) rax = byte`：读addr 指向的字节
    fun emitMemoryRead(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        // rcx = addr
        // movzx eax, byte ptr [rcx]
        enc.emitMovzxRegMemByte("eax", "rcx")
        enc.emitEpilogue()
    }

    /// 编码 `Memory_write16(rcx=addr, rdx=val) 无返回值`：写16 位值
    fun emitMemoryWrite16(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitStoreMemDisp32("rcx", 0, "rdx")
        enc.emitEpilogue()
    }

    /// 编码 `Memory_read16(rcx=addr) rax = i16`：读16 位值
    fun emitMemoryRead16(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.writeByte(0x48); enc.writeByte(0x8B); enc.writeByte(0x01)  // MOV rax, [rcx]
        // 简化：直接加载 64 位（高位由调用者处理）
        enc.emitEpilogue()
    }

    /// 编码 `Memory_write32(rcx=addr, rdx=val) 无返回值`：写32 位值
    fun emitMemoryWrite32(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitStoreMemDisp32("rcx", 0, "rdx")
        enc.emitEpilogue()
    }

    /// 编码 `Memory_read32(rcx=addr) rax = i32`：读32 位值
    fun emitMemoryRead32(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.writeByte(0x48); enc.writeByte(0x8B); enc.writeByte(0x01)  // MOV rax, [rcx]
        enc.emitEpilogue()
    }

    /// 编码 `Memory_write64(rcx=addr, rdx=val) 无返回值`：写64 位值
    fun emitMemoryWrite64(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitStoreMemDisp32("rcx", 0, "rdx")
        enc.emitEpilogue()
    }

    /// 编码 `Memory_read64(rcx=addr) rax = i64`：读64 位值
    fun emitMemoryRead64(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.writeByte(0x48); enc.writeByte(0x8B); enc.writeByte(0x01)  // MOV rax, [rcx]
        enc.emitEpilogue()
    }

    /// 编码 `Memory_alloc(rcx=n) rax = ptr`：调runtime_emitObjectAlloc 分配内存
    fun emitMemoryAlloc(enc: X86Encoder): Unit {
        // ⚠️ VEH 懒安装已摘除（2026-10-06）：Memory_alloc 是全程序最热的
        // 路径，install 序列（含 AddVectoredExceptionHandler 调用）对本轮的
        // 探针矩阵造成全面崩坏（首次 alloc 即段错误）。aura_veh_handler 与
        // 数据符号保留在 runtime 内；下轮以「wrapper main 显式调用安装函数」
        // 的形式启用（一次性、零热路径开销）。
        enc.emitPrologue(0)
        enc.emitCallRel("runtime_emitObjectAlloc")
        enc.emitEpilogue()
    }

    /// 编码 `Memory_free(rcx=addr)`：bump 分配器无需释放（no-op）
    fun emitMemoryFree(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitEpilogue()
    }

    /// 编码 `Memory_atomicAdd(rcx=addr, rdx=delta) rax=old[rcx]`。
    /// `lock xaddq [rcx], rdx`：返回旧值，`[rcx] <- [rcx]+delta`。
    fun emitMemoryAtomicAdd(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        // Memory_atomicAdd(rcx=addr, rdx=delta) rax=old[rcx]
        // lock xaddq [rcx], r8: returns old value in r8, [rcx] <- [rcx]+r8
        enc.emitMovRR("r8", "rdx")  // r8 = delta
        enc.writeByte(0xF0)  // LOCK
        enc.writeByte(0x4C)  // REX.WR (W=1, R=1 for r8 in reg field, B=0 for rcx)
        enc.writeByte(0x0F)  // XADD r/m64, r64
        enc.writeByte(0xC1)
        enc.writeByte(0x01)  // ModRM: mod=00, reg=000(r8 w/ REX.R), r/m=001(rcx)
        enc.emitMovRR("rax", "r8")  // rax = old value
        enc.emitEpilogue()
    }

    /// 编码 `Memory_arcIncrement(rcx=addr) rax=new[rcx]`。
    fun emitMemoryArcIncrement(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        // 检查地址是否有效（>= 0x10000）
        enc.emitCmpRI("rcx", 0x10000)
        enc.emitJccLabel("b", "arc_inc_invalid")  // below
        enc.writeByte(0xF0)  // LOCK
        enc.writeByte(0x48)  // REX.W (64-bit)
        enc.writeByte(0xFF)  // INC r/m64
        enc.writeByte(0x01)  // ModRM: [rcx]
        enc.writeByte(0x48); enc.writeByte(0x8B); enc.writeByte(0x01)  // MOV rax, [rcx]
        enc.emitEpilogue()
        enc.emitLabel("arc_inc_invalid")
        enc.emitXorRR("rax", "rax")  // rax = 0
        enc.emitEpilogue()
    }

    /// 编码 `Memory_arcDecrement(rcx=addr) rax=new[rcx]`。
    fun emitMemoryArcDecrement(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        // 检查地址是否有效（>= 0x10000）
        enc.emitCmpRI("rcx", 0x10000)
        enc.emitJccLabel("b", "arc_dec_invalid")  // below
        enc.writeByte(0xF0)  // LOCK
        enc.writeByte(0x48)  // REX.W (64-bit)
        enc.writeByte(0xFF)  // DEC r/m64
        enc.writeByte(0x09)  // ModRM: [rcx]
        enc.writeByte(0x48); enc.writeByte(0x8B); enc.writeByte(0x01)  // MOV rax, [rcx]
        enc.emitEpilogue()
        enc.emitLabel("arc_dec_invalid")
        enc.emitXorRR("rax", "rax")  // rax = 0
        enc.emitEpilogue()
    }

    /// 编码 `Memory_mmap(rcx=addr, rdx=length, r8=prot, r9=flags, [sp]=fd, [sp]=offset) rax=ptr`。
    /// Windows: NtAllocateVirtualMemory (0x18)。
    fun emitMemoryMmap(enc: X86Encoder): Unit {
        enc.emitPrologue(0x90)
        enc.emitStackStore(-0x70, "rbx")
        enc.emitStackStore(-0x78, "rsi")
        enc.emitStackStore(-0x80, "r12")
        // baseAddr=[rbp-0x30] regionSize=[rbp-0x38]
        enc.emitStackStore(-0x30, "rcx")  // base=addr
        enc.emitStackStore(-0x38, "rdx")  // size=length
        enc.emitMovRI("rcx", -1)
        enc.emitLeaStack("rdx", -0x30)
        enc.emitXorRR("r8", "r8")
        enc.emitLeaStack("r9", -0x38)
        enc.emitMovRR("r10", "rcx")
        // ⚠️ Nt* syscall 的**第 5/6 个参数在栈上**，位置是 `[rsp+0x28]` / `[rsp+0x30]`
        //（Win64 前 4 个实参占 `[rsp+0x00..0x20]` 的影子空间，第 5 个从 +0x28 开始）。
        // 本函数 `emitPrologue(0x90)` ⇒ `rsp = rbp-0x90` ⇒ 正确槽位是
        // **`rbp-0x68`（AllocationType）与 `rbp-0x60`（Protect）**。
        // 旧实现写在 `-0x58`/`-0x50`（= `rsp+0x38/0x40`，偏了 0x10）⇒ 内核读到的是
        // 残留栈数据 ⇒ `STATUS_INVALID_PARAMETER` ⇒ 直接走 `mm_fail` 返回 **0**
        //（实测 `probe_mmap` 的 `mmap1: 0`：`ArenaAllocator.init` 又把 0 当成成功，
        //  于是「mmap 堆」形同虚设、`alloc` 恒返回 0 —— P4 第 1 项的真根因）。
        enc.emitMovRI32("eax", 0x3000)
        enc.emitStackStore(-0x68, "rax")
        enc.emitMovRI32("eax", 4)
        enc.emitStackStore(-0x60, "rax")
        SyscallEmitter.emitSyscall(enc, 0x18)
        enc.emitTestRR("rax", "rax")
        enc.emitJccLabel("ne", "mm_fail")
        enc.emitStackLoad("rax", -0x30)
        enc.emitJmpLabel("mm_done")
        enc.emitLabel("mm_fail")
        enc.emitXorRR("rax", "rax")
        enc.emitLabel("mm_done")
        enc.emitStackLoad("r12", -0x80)
        enc.emitStackLoad("rsi", -0x78)
        enc.emitStackLoad("rbx", -0x70)
        enc.emitEpilogue()
    }

    /// 编码 `Memory_munmap(rcx=addr, rdx=length) rax=status`。
    /// Windows: NtFreeVirtualMemory (0x45)。
    fun emitMemoryMunmap(enc: X86Encoder): Unit {
        enc.emitPrologue(0x50)
        enc.emitStackStore(-0x28, "rdx")  // save length
        enc.emitStackStore(-0x10, "rbx")  // save rbx
        enc.emitStackStore(-0x18, "r12")  // save r12
        enc.emitMovRI("rcx", -1)          // NtCurrentProcess
        enc.emitLeaStack("r9", -0x28)      // &regionSize
        enc.emitStackLoad("r12", -0x28)    // length
        enc.emitStoreMemDisp32("r9", 0, "r12")
        enc.emitMovRI32("eax", 0x8000)    // MEM_RELEASE
        enc.emitStackStore(-0x18, "rax")  // [rbp-0x18] = [rsp+0x40]
        SyscallEmitter.emitSyscall(enc, 0x45)  // NtFreeVirtualMemory
        enc.emitStackLoad("r12", -0x18)
        enc.emitStackLoad("rbx", -0x10)
        enc.emitEpilogue()
    }

    // ── Step 4: Stdlib 函数实现 ──

    /// 编码 `__throw(rcx=msg)` 打印错误exit(1)
    fun emitThrow(enc: X86Encoder): Unit {
        enc.emitPrologue(0x20)
        enc.emitStackStore(-0x10, "rcx")
        enc.emitCallRel("println")
        enc.emitMovRI32("ecx", 1)
        enc.emitCallRel("exit")
        enc.emitEpilogue()
    }

    /// 编码 `arrayListOf()` 调用 __list_alloc(0)
    fun emitArrayListOf(enc: X86Encoder): Unit {
        // arrayListOf() → __list_alloc(0) → cap=0+4+1024=1028, count=0
        // core 布局 [count@0][cap@8][itemsPtr@0x10]
        enc.emitPrologue(0)
        enc.emitXorRR("rcx", "rcx")
        enc.emitCallRel("__list_alloc")
        enc.emitEpilogue()
    }

    /// 编码 `Collections.indexOf(rcx=list, rdx=elem) rax = index or -1`
    /// list layout: [count:8][e0:8][e1:8]...
    fun emitCollectionIndexOf(enc: X86Encoder): Unit {
        enc.emitPrologue(0x40)
        enc.emitStackStore(-0x10, "rcx")  // list
        enc.emitStackStore(-0x18, "rdx")  // elem
        enc.emitStackStore(-0x20, "rbx")
        enc.emitStackStore(-0x28, "rsi")
        enc.emitStackStore(-0x30, "rdi")
        // ⚠️ Null check: if list (rcx) is null, return -1 to prevent crash
        enc.emitTestRR("rcx", "rcx")
        enc.emitJccLabel("z", "cii_notfound")
        // rdi = 当前索引 (0)
        enc.emitXorRR("rdi", "rdi")
        enc.emitLabel("cii_loop")
        // rax = list pointer
        enc.emitStackLoad("rax", -0x10)
        // r8 = count = [list + 0]
        enc.emitLoadIndexed8("r8", "rax", "rsp", 0)
        // cmp rdi, r8 if rdi >= count, not found
        enc.emitCmpRR("rdi", "r8")
        enc.emitJccLabel("ae", "cii_notfound")
        // rcx = [list + 8 + rdi*8] = element at index rdi
        // r9 = rdi * 8
        enc.emitMovRR("r9", "rdi")
        enc.emitShlRI("r9", 3)
        // rax = list + 8 + r9
        enc.emitAddRI("rax", 8)
        enc.emitAddRR("rax", "r9")
        // rcx = [rax] = element
        enc.emitLoadIndexed8("rcx", "rax", "rsp", 0)
        enc.emitStackLoad("rdx", -0x18)   // rdx = target elem
        enc.emitCmpRR("rcx", "rdx")
        enc.emitJccLabel("eq", "cii_found")
        enc.emitIncRR("rdi")
        enc.emitJmpLabel("cii_loop")
        enc.emitLabel("cii_found")
        enc.emitMovRR("rax", "rdi")  // return index
        enc.emitStackLoad("rsi", -0x28)
        enc.emitStackLoad("rbx", -0x20)
        enc.emitEpilogue()
        enc.emitLabel("cii_notfound")
        enc.emitMovRI("eax", -1)  // return -1
        enc.emitStackLoad("rsi", -0x28)
        enc.emitStackLoad("rbx", -0x20)
        enc.emitEpilogue()
    }

    /// 编码 `Collections.contains(rcx=list, rdx=elem) rax = 1 or 0`
    fun emitCollectionContains(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        // ⚠️ 内部调用名必须是**下划线形态**（runtime 导出名 2026-10-06 统一
        // 下划线）：旧写法 `Collections.indexOf` 是点号 ⇒ runtime obj 自引用
        // 未定义符号（实测 P223 链接期）。
        enc.emitCallRel("Collections_indexOf")
        enc.emitCmpRI("rax", -1)
        enc.emitJccLabel("ne", "cc_found")
        enc.emitMovRI("eax", 0)
        enc.emitEpilogue()
        enc.emitLabel("cc_found")
        enc.emitMovRI("eax", 1)
        enc.emitEpilogue()
    }

    /// 编码 `Collections.count(rcx = list) rax = 元素个数`
    ///
    /// list layout: [count:8][e0:8][e1:8]...（见 `emitCollectionIndexOf`）。
    /// 前端把 `count()` / `getSize()` / `size` 三种写法都映射到这里
    ///（见 `Hir.aura` 的集合成员映射表）。
    fun emitCollectionCount(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        // ⚠️ Null check: if list (rcx) is null, return 0 to prevent crash
        enc.emitTestRR("rcx", "rcx")
        enc.emitJccLabel("z", "@count_null")
        // rax = [rcx + 0] = count。index 传 `"rsp"` 即 x86 的「无索引」
        //（index 字段 = 100b），等价于 `mov rax, [rcx]`。
        enc.writeByte(0x48); enc.writeByte(0x8B); enc.writeByte(0x01)  // MOV rax, [rcx]
        enc.emitEpilogue()
        // Null label: return 0
        enc.emitLabel("@count_null")
        enc.emitXorRR("rax", "rax")
        enc.emitEpilogue()
    }

    /// 编码 `Collections.clear(rcx = list)`：count 置 0。
    ///
    /// ⚠️ 旧实现函数体随「列表 native 重写」被误删，但 `Collections.clear`
    /// 的 4 处注册点仍在 ⇒ seed AOT 链接期 `undefined symbol`，整个
    /// photon 驱动无法重建（P223 首次暴露）。补回：core 布局
    /// [count@0][cap@8][itemsPtr@0x10] 下 clear 即 `[rcx] = 0`（容量与
    /// items 块保留，后续 append 原地复用）；返回列表句柄（与
    /// listAppend 的 `rax = list` 约定一致）。
    fun emitCollectionClear(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitTestRR("rcx", "rcx")
        enc.emitJccLabel("z", "@clr_null")
        enc.emitXorRR("rax", "rax")
        enc.writeByte(0x48); enc.writeByte(0x89); enc.writeByte(0x01)  // MOV [rcx], rax → count = 0
        enc.emitMovRR("rax", "rcx")
        enc.emitEpilogue()
        enc.emitLabel("@clr_null")
        enc.emitXorRR("rax", "rax")
        enc.emitEpilogue()
    }

    /// 编码 `Collections.listAppend(rcx = list, rdx = value) rax = list`
    ///
    /// 在列表末尾追加元素：读 count → 写入 [count*8+8] → count+1。
    /// list layout: [count:8][e0:8][e1:8]...（与 `__list_alloc` 一致）。
    ///
    /// ⚠️ **关键修复**：此前 `add` 被映射到 `ArrayList_add`（类方法），
    /// 而类方法期望 `this` 是 `ArrayList` 对象（32 字节：vtable+size+data+_size），
    /// 实际传入的是 `arrayListOf()` 创建的**裸列表句柄**（24+ 字节：count+elements）。
    /// 布局不匹配导致读取野值、`realloc` 段错误（0xC0000005）。
    /// 现在 `add` 映射到此函数，直接操作裸句柄布局，语义正确。
    fun emitCollectionListAppend(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitTestRR("rcx", "rcx")
        enc.emitJccLabel("z", "@listAppend_null")
        enc.writeByte(0x48); enc.writeByte(0x8B); enc.writeByte(0x01)  // MOV rax, [rcx]
        enc.emitMovRR("r8", "rax")
        enc.emitShlRI("r8", 3)
        // r9 = rcx + 8 + r8（⚠️ r9 必须先 mov rcx 再加——旧实现 r9 未初始化）
        enc.emitMovRR("r9", "rcx")
        enc.emitAddRI("r9", 8)
        enc.emitAddRR("r9", "r8")
        // [r9] = rdx（⚠️ REX.B 0x49）
        enc.writeByte(0x49); enc.writeByte(0x89); enc.writeByte(0x11)
        enc.emitIncRR("rax")
        enc.writeByte(0x48); enc.writeByte(0x89); enc.writeByte(0x01)
        enc.emitMovRR("rax", "rcx")
        enc.emitEpilogue()
        enc.emitLabel("@listAppend_null")
        enc.emitXorRR("rax", "rax")
        enc.emitEpilogue()
    }


    /// 编码 `Collections.hashMapPut(rcx = map, rdx = key, r8 = value) rax = value`
    ///
    /// ⚠️ **stub**：与同文件的 `Collections.mapContainsKey`（恒返回 0）、
    /// `Collections.getAt`（恒返回键名）同级 —— Photon runtime 目前**没有**真正的
    /// hash map 存储，Map 语义尚不成立。这里只保证链接成功且不破坏 Win64 调用
    /// 约定（把 value 原样回传），把「Map 无实际存储」这一已知缺口显式留在代码
    /// 注释里，而不是让它以「缺失符号」的形式在链接期暴露。
    fun emitCollectionHashMapPut(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitMovRR("rax", "r8")
        enc.emitEpilogue()
    }

    /// 编码 `Collections.remove(rcx=list, rdx=index) rax = removed elem`
    /// list layout: [count:8][e0:8][e1:8]...
    fun emitCollectionRemove(enc: X86Encoder): Unit {
        enc.emitPrologue(0x40)
        enc.emitStackStore(-0x10, "rcx")  // list
        enc.emitStackStore(-0x18, "rdx")  // index
        enc.emitStackStore(-0x20, "rbx")
        enc.emitStackStore(-0x28, "rsi")
        enc.emitStackStore(-0x30, "rdi")
        // rax = list pointer
        enc.emitStackLoad("rax", -0x10)
        // rdi = count = [list + 0]
        enc.emitLoadIndexed8("rdi", "rax", "rsp", 0)
        // rsi = index
        enc.emitStackLoad("rsi", -0x18)
        // r8 = element to remove = [list + 8 + rsi*8]
        enc.emitMovRR("r9", "rsi")
        enc.emitShlRI("r9", 3)
        enc.emitAddRI("rax", 8)
        enc.emitAddRR("rax", "r9")
        enc.emitLoadIndexed8("r8", "rax", "rsp", 0)
        // r8 = removed element (保存返回
        enc.emitMovRR("rbx", "r8")
        // 移动元素：从 index+1 count-1
        // rsi = index + 1 (source)
        enc.emitIncRR("rsi")
        enc.emitLabel("cr_loop")
        // rdi = count - 1
        enc.emitDecRR("rdi")
        // cmp rsi, rdi if rsi > rdi, done
        enc.emitCmpRR("rsi", "rdi")
        enc.emitJccLabel("ja", "cr_done")
        // rax = list + 8 + rsi*8 (source)
        enc.emitStackLoad("rax", -0x10)
        enc.emitMovRR("r9", "rsi")
        enc.emitShlRI("r9", 3)
        enc.emitAddRI("rax", 8)
        enc.emitAddRR("rax", "r9")
        // rcx = [rax] = source element
        enc.emitLoadIndexed8("rcx", "rax", "rsp", 0)
        // rax = list + 8 + (rsi-1)*8 (dest)
        enc.emitStackLoad("rax", -0x10)
        enc.emitDecRR("rsi")  // rsi = dest index
        enc.emitMovRR("r9", "rsi")
        enc.emitShlRI("r9", 3)
        enc.emitAddRI("rax", 8)
        enc.emitAddRR("rax", "r9")
        // [rax] = rcx (copy element)
        enc.emitStoreIndexed8("rax", "rsp", 0, "rcx")
        enc.emitIncRR("rsi")  // rsi = source index
        enc.emitJmpLabel("cr_loop")
        // 更新 count
        enc.emitLabel("cr_done")
        enc.emitStackLoad("rax", -0x10)
        enc.emitDecRR("rdi")  // rdi = count - 1
        enc.emitStoreIndexed8("rax", "rsp", 0, "rdi")
        // 返回被移除的元素
        enc.emitMovRR("rax", "rbx")
        enc.emitStackLoad("rsi", -0x28)
        enc.emitStackLoad("rbx", -0x20)
        enc.emitEpilogue()
    }

    /// stub: Collections.mapContainsKey 返回 0
    fun emitCollectionMapContainsKey(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitMovRI("eax", 0)
        enc.emitEpilogue()
    }

    /// stub: transform 返回入参
    fun emitTransform(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitMovRR("rax", "rcx")
        enc.emitEpilogue()
    }

    /// stub: ReadCStr 返回 0
    fun emitReadCStr(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitMovRI("eax", 0)
        enc.emitEpilogue()
    }

    /// 编码 `aura_mem_used_mb() rax = MB`。返heapBump / 1024 / 1024
    fun emitAuraMemUsedMb(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitMovRIP("rax", "heapBump")
        enc.emitMovRI32("rdx", 0)
        enc.emitMovRI32("rcx", 1048576)  // 1024*1024
        enc.emitIdiv("rcx")
        enc.emitEpilogue()
    }

    /// 编码 `aura_heapbump() rax = heapBump 裸值`（P239 诊断：解码期分配器
    /// 状态追踪——bump 应单调递增，骤降/归零即写手）。
    fun emitAuraHeapBump(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitMovRIP("rax", "heapBump")
        enc.emitEpilogue()
    }

    // ── print 实现（无换行）──

    /// 编码 `print(rcx = char*)`
    ///
    /// println 相同，但不添加换行符
    fun emitPrint(enc: X86Encoder): Unit {
        enc.emitPrologue(PhotonRuntime.FRAME_SIZE)

        // 保存入参指针
        enc.emitStackStore(PhotonRuntime.OFF_INPUT_PTR, "rcx")

        // strlen：扫描到 NUL
        enc.emitMovRR("rdx", "rcx")
        enc.emitXorRR("rax", "rax")
        enc.emitLabel("pr_strlen_loop")
        enc.emitCmpByteMemImm8("rdx", 0)
        enc.emitJccLabel("eq", "pr_strlen_done")
        enc.emitIncRR("rdx")
        enc.emitIncRR("rax")
        enc.emitJmpLabel("pr_strlen_loop")
        enc.emitLabel("pr_strlen_done")
        enc.emitStackStore(PhotonRuntime.OFF_LEN, "rax")

        // 获取 hStdOutput：PEB 走链（推导见 emitPrintln 中的注释
        enc.emitMovGSSeg64("rax", 0x60)
              // rax = PEB
        enc.emitMovMemDisp8("rax", "rax", 0x20)
      // rax = ProcessParameters (PEB+0x20)
        enc.emitMovMemDisp8("rax", "rax", 0x28)
      // rax = hStdOutput (ProcessParameters+0x28)
        enc.emitStackStore(PhotonRuntime.OFF_HSTDOUT, "rax")

        // NtWriteFile：写入字符串（无换行
        enc.emitLeaStack("rax", PhotonRuntime.OFF_IOBLOCK)
        enc.emitStackStore(PhotonRuntime.OFF_ARG5, "rax")
        enc.emitStackLoad("rax", PhotonRuntime.OFF_INPUT_PTR)
        enc.emitStackStore(PhotonRuntime.OFF_ARG6, "rax")
        enc.emitStackLoad("rax", PhotonRuntime.OFF_LEN)
        enc.emitStackStore(PhotonRuntime.OFF_ARG7, "rax")
        enc.emitXorRR("rax", "rax")
        enc.emitStackStore(PhotonRuntime.OFF_ARG8, "rax")
        enc.emitStackStore(PhotonRuntime.OFF_ARG9, "rax")
        // EaLength 必须显式清零：NtWriteFile 的第 10 个参数，若栈上残留非 0
        // 值，内核会尝试从 EaBuffer 复制扩展属性并导致访问违规
        enc.emitStackStore(PhotonRuntime.OFF_ARG10, "rax")

        // ⚠️ Windows x64 syscall *1 个参数必须放r10**
        // `syscall` 指令会把返回地址写进 rcx，因此内核从 r10 读取 arg1
        // （ntdll stub 正是 `mov r10, rcx` 后再 `syscall`）
        enc.emitStackLoad("r10", PhotonRuntime.OFF_HSTDOUT)
        enc.emitXorRR("rdx", "rdx")
        enc.emitXorRR("r8", "r8")
        enc.emitXorRR("r9", "r9")
        SyscallEmitter.emitSyscall(enc, 0x08)  // NtWriteFile（本ntdll 实测 0x08
        enc.emitEpilogue()
    }

    // ── puts 实现（带换行）──

    /// 编码 `puts(rcx = char*)`
    ///
    /// println 相同：写入字符串并添加换行符
    fun emitPuts(enc: X86Encoder): Unit {
        PhotonRuntime.emitPrintln(enc)
    }

    // ── toInt 实现 ──

    /// 编码 `toInt(rcx = char*) rax = Int`
    ///
    /// 解析前导的十进制 ASCII 数字（支持负号），忽略尾部非数字字符
    fun emitToInt(enc: X86Encoder): Unit {
        enc.emitPrologue(0x40)

        // 检查前导负
        enc.emitMovzxRegMemByte("rax", "rcx")
        enc.emitCmpRI("rax", '-')
        enc.emitJccLabel("eq", "int_neg")

        // 正数：无负号标志
        enc.emitMovRI32("eax", 0)
        enc.emitStackStore(-0x18, "rax")  // 保存标志
        enc.emitJmpLabel("int_parse")

        enc.emitLabel("int_neg")
        enc.emitMovRI32("eax", 1)
        enc.emitStackStore(-0x18, "rax")  // 保存负号标志
        enc.emitAddRI("rcx", 1)  // 跳过 '-'

        enc.emitLabel("int_parse")
        enc.emitXorRR("rdx", "rdx")  // 结果 = 0

        // 解析数字循环
        enc.emitLabel("int_loop")
        enc.emitMovzxRegMemByte("rax", "rcx")
        enc.emitCmpRI("rax", 0)
        enc.emitJccLabel("eq", "int_done")

        // 检查是否为数字
        enc.emitCmpRI("rax", '0')
        enc.emitJccLabel("b", "int_done")  // 小于 '0'
        enc.emitCmpRI("rax", '9')
        enc.emitJccLabel("a", "int_done")  // 大于 '9'

        // result = result * 10 + (digit - '0')
        enc.emitImulRI("rdx", 10)
        enc.emitSubRI("rax", '0')
        enc.emitAddRR("rdx", "rax")

        enc.emitIncRR("rcx")
        enc.emitJmpLabel("int_loop")

        enc.emitLabel("int_done")
        // 如果是负数，取反结果
        enc.emitStackLoad("rax", -0x18)  // 加载标志
        enc.emitCmpRI("rax", 0)
        enc.emitJccLabel("eq", "int_return")

        enc.emitXorRR("rax", "rax")
        enc.emitSubRR("rax", "rdx")  // rax = 0 - rdx = -rdx
        enc.emitMovRR("rdx", "rax")

        enc.emitLabel("int_return")
        enc.emitMovRR("rax", "rdx")
        enc.emitEpilogue()
    }

    // ── toFloat 实现 ──

    /// 编码 `toFloat(rcx = char*) rax = float`
    ///
    /// 简化的字符串到浮点转换：解析整数部分，忽略小数部分
    /// 使用 toInt 解析字符串，然后转换float32
    /// 
    /// 注意：当前实现为简化版本（返回整数部分float32 表示），
    /// 完整实现需FPU 指令支持
    fun emitToFloat(enc: X86Encoder): Unit {
        enc.emitPrologue(0x50)

        // 保存非易失寄存器 rbx（下面用 rbx 做位长计数）
        enc.emitStackStore(-0x40, "rbx")

        // 调用 toInt 解析整数部分
        enc.emitCallRel("toInt")

        // 保存结果
        enc.emitStackStore(-0x20, "rax")

        // 检查是否为
        enc.emitStackLoad("rax", -0x20)
        enc.emitCmpRI("rax", 0)
        enc.emitJccLabel("eq", "tf_zero")

        // 处理符号
        enc.emitCmpRI("rax", 0)
        enc.emitJccLabel("ge", "tf_nonneg")

        // 负数：设置符号位，取
        enc.emitMovRI32("ecx", 0x80000000)  // 符号
        enc.emitXorRR("rdx", "rdx")
        enc.emitSubRR("rdx", "rax")  // rdx = -rax
        enc.emitMovRR("rax", "rdx")
        enc.emitJmpLabel("tf_abs_done")

        enc.emitLabel("tf_nonneg")
        enc.emitXorRR("ecx", "ecx")  // 无符号位

        enc.emitLabel("tf_abs_done")
        // rax = 绝对 ecx = 符号(0x80000000 0)

        // 保存绝对
        enc.emitStackStore(-0x28, "rax")

        // 计算位数（通过右移计数
        enc.emitStackLoad("rbx", -0x28)
        enc.emitXorRR("eax", "eax")  // eax = 位数计数

        enc.emitLabel("tf_count")
        enc.emitCmpRI("rbx", 0)
        enc.emitJccLabel("eq", "tf_count_done")
        enc.emitShrRI("rbx", 1)
        enc.emitIncRR("eax")
        enc.emitJmpLabel("tf_count")

        enc.emitLabel("tf_count_done")
        // eax = 位数, rbx = 0

        // 指数 = (位数 - 1) + 127
        enc.emitSubRI("eax", 1)
        enc.emitAddRI("eax", 127)
        // eax = 指数（偏置后
        // 左移指数到正确位
        enc.emitShlRI("eax", 23)
        // eax = 指数部分

        // 构造尾数：原值去掉最高位，左移填23
         enc.emitStackLoad("rbx", -0x28)
        // rbx = 原绝对
        // 计算 mask = (1 << (bit_length - 1)) - 1
        // 但位数已经被覆盖了，需要从 rbx 重新计算位数
        // 简化：直接使用原值作为尾数（截断23 位）
        enc.emitAndRR("rbx", "rbx")  // rbx = rbx & 0x7FFFFF (截断23 
        // 实际上需要不同的方法...

        // 简化实现：返回 0.0
        // 完整实现需要更复杂的位操作来规范化尾数

        enc.emitXorRR("eax", "eax")  // 返回 0.0
        enc.emitStackLoad("rbx", -0x40)  // 恢复非易失寄存器
        enc.emitEpilogue()
    }

    // ── toString 实现 ──

    /// 编码 `toString(rcx = Any) rax = char*`
    ///
    /// 将参数视char* 并原样返回（恒等函数）
    fun emitToString(enc: X86Encoder): Unit {
        // 隔离测试：回退到恒等桩（原实现）——确认 toString 转发 toStr
        // 是否是 fn0 解码崩的唯一原因
        enc.emitPrologue(0)
        enc.emitMovRR("rax", "rcx")
        enc.emitEpilogue()
    }

    // ── ARC 支持 ──

    /// 编码 `retain(rcx = obj*) obj*`：增加引用计数
    ///
    /// 简化实现：直接返回对象（无实际引用计数）
    /// 完整实现需要对象头中的引用计数字段
    fun emitRetain(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitMovRR("rax", "rcx")
        enc.emitEpilogue()
    }

    /// 编码 `release(rcx = obj*) Unit`：减少引用计数
    ///
    /// 简化实现：无操作（无实际引用计数）
    /// 完整实现需要对象头中的引用计数字段
    fun emitRelease(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitEpilogue()
    }

    // ── 目标文件产出 ──

    /// 所有运行时函数名列表（逗号分隔）
    /// runtime 发射器构建号：**任何 emitXxx 变更都必须手动递增**——
    /// Pipeline 以 `RUNTIME_SYMBOLS + BUILD_ID` 作为 aura_runtime.obj 的缓存
    /// 键，否则发射器改动会被陈旧缓存吞掉（实测 VEH 崩溃转储加进发射器后
    /// 产物一直是 06:32 的旧 obj，2026-10-06）。
    val BUILD_ID: String = "p223-listcore-neg"
    val RUNTIME_SYMBOLS: String = "println,print,puts,toStr,strcat,toInt,toFloat,toString,strlen,charCodeAt,exit,Memory_write,Memory_read,Memory_write16,Memory_read16,Memory_write32,Memory_read32,Memory_write64,Memory_read64,Memory_alloc,Memory_free,Memory_atomicAdd,Memory_mmap,Memory_munmap,Memory_arcIncrement,Memory_arcDecrement,io_open,io_close,io_read,io_write,io_access,Collections.hashMapPut,env_get,Env_get,__obj_slot_get,__obj_slot_set,Memory_copy,Memory_mprotect,ProcessOps_execve,ProcessOps_fork,ProcessOps_wait4,String_fromCharCode,String_substring,ProcessOps_aura_process_argCount,ProcessOps_aura_process_args,Cpu_rdtsc,Cpu_memFence,Cpu_cpuid,Cpu_atomicAdd,FileOps_lseek,veh_install,canary_report,aura_typeof,aura_is_tagged_int,Clock_clockGettime,ThreadOps_create,IO_readFile,IO_writeFile,ThreadOps_join,ThreadOps_sleepMs,ThreadOps_currentId,ThreadOps_cores"

    /// 将所有运行时函数编码到目标文件中，返COFF hex
    fun buildRuntimeObject(): String {
        val writer = PhotonObjectWriter()
        // 按顺序编码每个函数，appendFunction 追加
        val enc1 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitPrintln(enc1)
        writer.appendFunction(
            enc1.toHex(),
            "println",
            PhotonObjectWriterUtils.joinRelocRecords(enc1.getRelocations())
        )

        val enc2 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitPrint(enc2)
        writer.appendFunction(
            enc2.toHex(),
            "print",
            PhotonObjectWriterUtils.joinRelocRecords(enc2.getRelocations())
        )

        // VEH 崩溃转储回调（2026-10-06，见 emitVehHandler 说明）
        val encVeh = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitVehHandler(encVeh)
        writer.appendFunction(
            encVeh.toHex(),
            "aura_veh_handler",
            PhotonObjectWriterUtils.joinRelocRecords(encVeh.getRelocations())
        )

        // VEH 显式安装入口（供 Aura wrapper 调用，见 emitVehInstall）
        val encVehI = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitVehInstall(encVehI)
        writer.appendFunction(
            encVehI.toHex(),
            "veh_install",
            PhotonObjectWriterUtils.joinRelocRecords(encVehI.getRelocations())
        )

        // 栈帧 canary 报告器（见 emitCanaryReport；X86Emitter 每函数插桩调用）
        val encCan = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitCanaryReport(encCan)
        writer.appendFunction(
            encCan.toHex(),
            "canary_report",
            PhotonObjectWriterUtils.joinRelocRecords(encCan.getRelocations())
        )

        // else-if 修复暴露的内建/原生桩（见各 emit* 说明，2026-10-06）
        val encTo = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitTypeOfPlanA(encTo)
        writer.appendFunction(
            encTo.toHex(),
            "aura_typeof",
            PhotonObjectWriterUtils.joinRelocRecords(encTo.getRelocations())
        )
        val encIti = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitIsTaggedInt(encIti)
        writer.appendFunction(
            encIti.toHex(),
            "aura_is_tagged_int",
            PhotonObjectWriterUtils.joinRelocRecords(encIti.getRelocations())
        )
        val encCgt = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitClockGettimeStub(encCgt)
        writer.appendFunction(
            encCgt.toHex(),
            "Clock_clockGettime",
            PhotonObjectWriterUtils.joinRelocRecords(encCgt.getRelocations())
        )
        val encTcr = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitThreadCreateStub(encTcr)
        writer.appendFunction(
            encTcr.toHex(),
            "ThreadOps_create",
            PhotonObjectWriterUtils.joinRelocRecords(encTcr.getRelocations())
        )
        val encIrf = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitIOReadFileStub(encIrf)
        writer.appendFunction(
            encIrf.toHex(),
            "IO_readFile",
            PhotonObjectWriterUtils.joinRelocRecords(encIrf.getRelocations())
        )
        val encIwf = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitIOWriteFileStub(encIwf)
        writer.appendFunction(
            encIwf.toHex(),
            "IO_writeFile",
            PhotonObjectWriterUtils.joinRelocRecords(encIwf.getRelocations())
        )
        // ThreadOps 家族（全部叶桩，2026-10-06）
        val encTj = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitThreadOpsStubs(encTj)
        writer.appendFunction(
            encTj.toHex(),
            "ThreadOps_join",
            PhotonObjectWriterUtils.joinRelocRecords(encTj.getRelocations())
        )
        val encTs = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitIOWriteFileStub(encTs)   // 同形：xor eax; ret → 0
        writer.appendFunction(
            encTs.toHex(),
            "ThreadOps_sleepMs",
            PhotonObjectWriterUtils.joinRelocRecords(encTs.getRelocations())
        )
        val encTid = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitThreadOpsStubs(encTid)   // -1；currentId 语义上应为正，装载链不触达
        writer.appendFunction(
            encTid.toHex(),
            "ThreadOps_currentId",
            PhotonObjectWriterUtils.joinRelocRecords(encTid.getRelocations())
        )
        val encTcp = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitThreadOpsStubs(encTcp)
        writer.appendFunction(
            encTcp.toHex(),
            "ThreadOps_cores",
            PhotonObjectWriterUtils.joinRelocRecords(encTcp.getRelocations())
        )

        val enc3 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitPuts(enc3)
        writer.appendFunction(
            enc3.toHex(),
            "puts",
            PhotonObjectWriterUtils.joinRelocRecords(enc3.getRelocations())
        )

        val enc4 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitToStr(enc4)
        writer.appendFunction(
            enc4.toHex(),
            "toStr",
            PhotonObjectWriterUtils.joinRelocRecords(enc4.getRelocations())
        )

        val enc4b = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitStrcat(enc4b)
        writer.appendFunction(
            enc4b.toHex(),
            "strcat",
            PhotonObjectWriterUtils.joinRelocRecords(enc4b.getRelocations())
        )

        val enc5 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitToInt(enc5)
        writer.appendFunction(
            enc5.toHex(),
            "toInt",
            PhotonObjectWriterUtils.joinRelocRecords(enc5.getRelocations())
        )

        val enc6 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitToFloat(enc6)
        writer.appendFunction(
            enc6.toHex(),
            "toFloat",
            PhotonObjectWriterUtils.joinRelocRecords(enc6.getRelocations())
        )

        val enc7 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitToString(enc7)
        writer.appendFunction(
            enc7.toHex(),
            "toString",
            PhotonObjectWriterUtils.joinRelocRecords(enc7.getRelocations())
        )

        val enc8 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitStrlen(enc8)
        writer.appendFunction(
            enc8.toHex(),
            "strlen",
            PhotonObjectWriterUtils.joinRelocRecords(enc8.getRelocations())
        )

        val enc8b = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitCharCodeAt(enc8b)
        writer.appendFunction(
            enc8b.toHex(),
            "charCodeAt",
            PhotonObjectWriterUtils.joinRelocRecords(enc8b.getRelocations())
        )

        val enc9 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitExit(enc9)
        writer.appendFunction(
            enc9.toHex(),
            "exit",
            PhotonObjectWriterUtils.joinRelocRecords(enc9.getRelocations())
        )

        val enc10 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitStreq(enc10)
        writer.appendFunction(
            enc10.toHex(),
            "streq",
            PhotonObjectWriterUtils.joinRelocRecords(enc10.getRelocations())
        )

        val enc11 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitListAlloc(enc11)
        writer.appendFunction(
            enc11.toHex(),
            "__list_alloc",
            PhotonObjectWriterUtils.joinRelocRecords(enc11.getRelocations())
        )

        val enc12 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitListSetAt(enc12)
        writer.appendFunction(
            enc12.toHex(),
            "__list_setat",
            PhotonObjectWriterUtils.joinRelocRecords(enc12.getRelocations())
        )

        val enc13 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitListGet(enc13)
        writer.appendFunction(
            enc13.toHex(),
            "__list_get",
            PhotonObjectWriterUtils.joinRelocRecords(enc13.getRelocations())
        )

        // 对象字段读写（Photon 对象模型 A-1）：字段访问走 runtime 调用，
        // 与列表访问同一策略（Load/Store 路径当前不可用，见 emitFieldGet 说明）。
        val encFg = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitFieldGet(encFg)
        writer.appendFunction(encFg.toHex(), "__field_get", PhotonObjectWriterUtils.joinRelocRecords(encFg.getRelocations()))
        val encFs = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitFieldSet(encFs)
        writer.appendFunction(encFs.toHex(), "__field_set", PhotonObjectWriterUtils.joinRelocRecords(encFs.getRelocations()))

        // ── Step 4: 对象分配+ 类构造器 ──
        val encOA = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitObjectAlloc(encOA)
        writer.appendFunction(encOA.toHex(), "runtime_emitObjectAlloc", PhotonObjectWriterUtils.joinRelocRecords(encOA.getRelocations()))

        // 类构造器：直接硬编码（避VM arrayListOf+add bug substring 类型问题
        var encCC = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitClassConstructor(encCC, 32)
        writer.appendFunction(encCC.toHex(), "ArenaAllocator", PhotonObjectWriterUtils.joinRelocRecords(encCC.getRelocations()))
        encCC = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitClassConstructor(encCC, 128)
        writer.appendFunction(encCC.toHex(), "AucModule", PhotonObjectWriterUtils.joinRelocRecords(encCC.getRelocations()))
        encCC = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitClassConstructor(encCC, 128)
        writer.appendFunction(encCC.toHex(), "AucReader", PhotonObjectWriterUtils.joinRelocRecords(encCC.getRelocations()))
        encCC = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitClassConstructor(encCC, 16)
        writer.appendFunction(encCC.toHex(), "CString", PhotonObjectWriterUtils.joinRelocRecords(encCC.getRelocations()))
        encCC = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitClassConstructor(encCC, 64)
        writer.appendFunction(encCC.toHex(), "HashMap", PhotonObjectWriterUtils.joinRelocRecords(encCC.getRelocations()))
        encCC = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitClassConstructor(encCC, 256)
        writer.appendFunction(encCC.toHex(), "Hir", PhotonObjectWriterUtils.joinRelocRecords(encCC.getRelocations()))
        encCC = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitClassConstructor(encCC, 128)
