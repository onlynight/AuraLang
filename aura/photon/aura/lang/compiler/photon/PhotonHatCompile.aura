// aura:///aura/lang/compiler/photon/PhotonHatCompile.aura
// HAT v2.0 独立编译链路驱动 — 源码 → HIR → SSA MIR → .hat → LIR → DAG → X86 → COFF → Link
//
// HAT 文本由 Aura 侧前端
// （`AotModuleLinker`：源码 + 递归 import → 合并 HIR）经 `SsaBuilder` +
// `HatSerializer` 直接产出，随后再由 `PhotonPipeline.compileHat` 从 `.hat`
// 文本重新解析进入后端 —— 即「HAT IR 是这条链路的真正中间表示」。
//
// ⚠️ 运行前提：**原生运行时**（自举产物 / AOT）。在冻结种子 VM 下实测不可用 ——
//   `AotModuleLinker` / `HirLowerer` 依赖「把同一个 Hir arena 交给另一个对象填写」，
//   而种子 VM 下跨对象的对象字段绑定/方法返回对象会失真：
//     · link() 后 `linker.hir.count = 4`（只含入口文件，std 模块未合并）
//     · `linker.seen` 只有 1 个模块（22 条 std 路径全部未 load）
//     · `linker.link(p)` 的**返回值**字段全为 null（`ret.count` → null）
//   因此本文件是「HAT 独立链路」的驱动骨架，等原生驱动可用后再启用。
//
// 用法:
//   aura run aura/photon/aura/lang/compiler/photon/PhotonHatCompile.aura
//
// 环境变量:
//   AURA_HAT_AURA    入口 .aura 源码路径（含递归 import）  [必填]
//   AURA_HAT_SRC     输出/输入的 .hat 路径                [默认 <out>/program.hat]
//   AURA_HAT_OUT     输出目录                            [默认 build/hat_test]
//   AURA_HAT_MODULE  模块名                              [默认 program]
//   AURA_HAT_SKIP_FRONT  跳过前端，复用已有 .hat         [默认 关]
//
//   调试开关（默认全关，stdout 只保留下面的 ===...=== 协议标记）：
//   AURA_PHOTON_VERBOSE=1   前端 + 后端的阶段进度/心跳
//   AURA_PHOTON_TRACE=1     上者 + 节点级崩溃诊断
//   AURA_HAT_TRACE=1        HAT 解析器心跳（长任务区分「慢」与「卡死」）
//   AURA_PHOTON_DEBUG_HIR=1 SSA / LIR / DAG 全量转储
//   AURA_PHOTON_STOP=A|B|C|D  阶段短路（性能二分）
//   AURA_PHOTON_TIME=1       逐阶段耗时（`[time] link= ssa= hatSerialize=
//                            compileHat= total=`，供耗时归因用）
//
// 输出标记（供构建脚本解析）:
//   ===COFF-MAIN===<hex>
//   ===COFF-RUNTIME===<hex>
//   ===LINK===<link command>
//   ===RESULT===success|fail
//   ===ERR===<message>
import aura.lang.std.String
import aura.lang.std.fs.FileUtils
import aura.lang.native.time.Clock


// ── 自举前端（源码 → HIR）的模块闭包 ──
//
// ⚠️ 必须把前端模块**全部列出**：Aura 编译器各模块间存在「隐式同编译单元」约定
// （例如 `Parser.aura` 只用 `import aura.lang.std.String`，却直接使用
// `CompileErrors` / `Ast` / `Lexer`）。AOT 路径按**入口文件的 import 闭包**内联，
// 未列出的模块不会参与编译，其类定义缺失 → `call void @CompileErrors()`
// （llc: `use of undefined value '@CompileErrors'`）。`Main.aura` 正是靠这一串
// import 才自举成功的，这里与之保持一致。
import aura.lang.compiler.lexer.Span
import aura.lang.compiler.lexer.Token
import aura.lang.compiler.lexer.Lexer
import aura.lang.compiler.ast.Ast
import aura.lang.compiler.errors.CompileError
import aura.lang.compiler.parser.Parser
import aura.lang.compiler.hir.Hir
import aura.lang.compiler.hir.hat.HatSerializer
import aura.lang.compiler.mir.SsaMir
import aura.lang.compiler.mir.SsaBuilder
import aura.lang.compiler.aot.AotUtil
import aura.lang.compiler.aot.Emit
import aura.lang.compiler.aot.ModuleLink
import "PhotonPipeline.aura"
import "PhotonRuntime.aura"

/// 单调纳秒时钟（`clock_gettime(CLOCK_REALTIME)`，Windows 上走
/// `GetSystemTimeAsFileTime`）。`Time.getNow()` 返回 Float 且从未调用
/// `ClockImpl.init()`，差值恒为 0 —— 这里直接用 `ClockImpl.timeNs()`
/// （Long 差值精确），供 AURA_PHOTON_TIME=1 的逐阶段计时用。
/// 每次调用前 `init()`：`tsBuf` 未初始化时 `now()` 会静默返回 0。
fun tNs(): Long {
    ClockImpl.init()
    return ClockImpl.timeNs()
}

fun secOf(deltaNs: Long): String {
    val sec: Long = deltaNs / 1000000000
    val ms: Long = (deltaNs % 1000000000) / 1000000
    val mss: String = toStr(ms)
    val pad: String = if (mss.length == 1) { "00" } else if (mss.length == 2) { "0" } else { "" }
    return toStr(sec) + "." + pad + mss
}

// ── 输入通道：固定路径约定 ──
//
// ⚠ 为什么不用环境变量/运行期配置文件：宿主二进制的 import 闭包含
// photon 管线时，主流程里调用 `Env.get` 或 `FileUtils.exists/readText`
// 之后进入 link() 会稳定段错误（最小复现见
// docs/photon/photon-bootstrap-link-benchmark.md §2026-10-03；三者
// 单独与 photon 闭包组合均安全，组合即崩——宿主侧 AOT 值模型残留缺陷）。
// 与 `build/vm/current.auc` 通道同一先例：调用方脚本把入口源码**拷贝**
// 到固定路径 `build/hat-vmhost/current.aura`，驱动从这里读取；
// 产物固定为 `build/hat-vmhost/current.{hat,obj}`。

fun main(): Int {
    // 输入通道：固定路径约定（调用方脚本把入口源码拷贝到
    // build/hat-vmhost/current.aura，产物固定 current.{hat,obj}）。
    // ⚠ 宿主主流程刻意**只使用已验证安全**的设施：FileUtils.mkdirP /
    // writeText / link 内部的源码读取（均有 photon 闭包共存的实测）。
    // Env.get / FileUtils.exists+readText / Process.* 在 photon 闭包下
    // 会令后续 link() 段错误（2026-10-03 探针矩阵，见 docs/photon/）。
    val srcPath = "build/hat-vmhost/current.aura"
    val outDir = "build/hat-vmhost"
    val moduleName = "current"
    val hatPath = "build/hat-vmhost/current.hat"

    FileUtils.mkdirP(outDir)

    // ── 前端：源码（含递归 import）→ 合并 HIR → SSA → HAT 文本 ──
    val tAll0: Long = tNs()
    val tLink0: Long = tNs()
    val linker = AotModuleLinker()
    val hir: Hir = linker.link(srcPath)
    if (linker.missing != "") {
        println("[hat-front] missing imports: " + linker.missing)
    }

    val tSsa0: Long = tNs()
    val ssa: MirSsaProgram = SsaBuilderUtils.build(hir)

    val tHat0: Long = tNs()
    val hatText: String = HatSerializerUtils.serializeHat(ssa, moduleName)
    FileUtils.writeText(hatPath, hatText)

    // ── HAT 文本 → SSA MIR → LIR → DAG → RegAlloc → X86 → COFF ──
    val tBack0: Long = tNs()
    val pipeline = PhotonPipelineUtils.emptyPipeline()
    pipeline.outDir = outDir
    pipeline.moduleName = moduleName
    val result = pipeline.compileHat(hatPath)

    // 输出 COFF hex（主对象 / runtime 对象）与链接信息
    println("===COFF-MAIN===")
    println(result.coffHex)
    val rtHex: String = PhotonRuntime.buildRuntimeObject()
    println("===COFF-RUNTIME===")
    println(rtHex)
    println("===LINK===")
    println(result.linkCommand)

    var resultTag: String = "fail"
    if (result.success) { resultTag = "success" }
    println("===RESULT===" + resultTag)
    if (!result.success) {
        println("===ERR===" + result.errorMessage)
        return 1
    }
    return 0
}
