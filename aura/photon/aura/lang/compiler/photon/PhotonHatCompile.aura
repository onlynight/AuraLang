// aura:///aura/lang/compiler/photon/PhotonHatCompile.aura
// HAT v2.0 独立编译链路驱动 — 源码 → HIR → SSA MIR → .hat → LIR → DAG → X86 → COFF → Link
//
// HAT 文本由 Aura 侧前端
// （`AotModuleLinker`：源码 + 递归 import → 合并 HIR）经 `SsaBuilder` +
// `HatSerializer` 直接产出，随后再由 `PhotonPipeline.compileHat` 从 `.hat`
// 文本重新解析进入后端 —— 即「HAT IR 是这条链路的真正中间表示」。
//
// ⚠️ 运行前提：**原生运行时**（自举产物 / AOT）。在冻结种子 VM 下实测不可用 ——
//   `AotModuleLinker` / `HirLowerer` 依赖「把同一个 Hir arena 交给另一个对象填写」，
//   而种子 VM 下跨对象的对象字段绑定/方法返回对象会失真：
//     · link() 后 `linker.hir.count = 4`（只含入口文件，std 模块未合并）
//     · `linker.seen` 只有 1 个模块（22 条 std 路径全部未 load）
//     · `linker.link(p)` 的**返回值**字段全为 null（`ret.count` → null）
//   因此本文件是「HAT 独立链路」的驱动骨架，等原生驱动可用后再启用。
//
// 用法:
//   aura run aura/photon/aura/lang/compiler/photon/PhotonHatCompile.aura
//
// 环境变量:
//   AURA_HAT_AURA    入口 .aura 源码路径（含递归 import）  [必填]
//   AURA_HAT_SRC     输出/输入的 .hat 路径                [默认 <out>/program.hat]
//   AURA_HAT_OUT     输出目录                            [默认 build/hat_test]
//   AURA_HAT_MODULE  模块名                              [默认 program]
//   AURA_HAT_SKIP_FRONT  跳过前端，复用已有 .hat         [默认 关]
//
//   调试开关（默认全关，stdout 只保留下面的 ===...=== 协议标记）：
//   AURA_PHOTON_VERBOSE=1   前端 + 后端的阶段进度/心跳
//   AURA_PHOTON_TRACE=1     上者 + 节点级崩溃诊断
//   AURA_HAT_TRACE=1        HAT 解析器心跳（长任务区分「慢」与「卡死」）
//   AURA_PHOTON_DEBUG_HIR=1 SSA / LIR / DAG 全量转储
//   AURA_PHOTON_STOP=A|B|C|D  阶段短路（性能二分）
//   AURA_PHOTON_TIME=1       逐阶段耗时（`[time] link= ssa= hatSerialize=
//                            compileHat= total=`，供耗时归因用）
//
// 输出标记（供构建脚本解析）:
//   ===COFF-MAIN===<hex>
//   ===COFF-RUNTIME===<hex>
//   ===LINK===<link command>
//   ===RESULT===success|fail
//   ===ERR===<message>
import aura.lang.std.String
import aura.lang.std.fs.FileUtils
import aura.lang.std.string.StringBuilder
import aura.lang.std.Env
import aura.lang.native.time.Clock


// ── 自举前端（源码 → HIR）的模块闭包 ──
//
// ⚠️ 必须把前端模块**全部列出**：Aura 编译器各模块间存在「隐式同编译单元」约定
// （例如 `Parser.aura` 只用 `import aura.lang.std.String`，却直接使用
// `CompileErrors` / `Ast` / `Lexer`）。AOT 路径按**入口文件的 import 闭包**内联，
// 未列出的模块不会参与编译，其类定义缺失 → `call void @CompileErrors()`
// （llc: `use of undefined value '@CompileErrors'`）。`Main.aura` 正是靠这一串
// import 才自举成功的，这里与之保持一致。
import aura.lang.compiler.lexer.Span
import aura.lang.compiler.lexer.Token
import aura.lang.compiler.lexer.Lexer
import aura.lang.compiler.ast.Ast
import aura.lang.compiler.errors.CompileError
import aura.lang.compiler.parser.Parser
import aura.lang.compiler.hir.Hir
import aura.lang.compiler.hir.hat.HatSerializer
import aura.lang.compiler.mir.SsaMir
import aura.lang.compiler.mir.SsaBuilder
import aura.lang.compiler.aot.AotUtil
import aura.lang.compiler.aot.Emit
import aura.lang.compiler.aot.ModuleLink
import "PhotonPipeline.aura"
import "PhotonRuntime.aura"

/// 单调纳秒时钟（`clock_gettime(CLOCK_REALTIME)`，Windows 上走
/// `GetSystemTimeAsFileTime`）。`Time.getNow()` 返回 Float 且从未调用
/// `ClockImpl.init()`，差值恒为 0 —— 这里直接用 `ClockImpl.timeNs()`
/// （Long 差值精确），供 AURA_PHOTON_TIME=1 的逐阶段计时用。
/// 每次调用前 `init()`：`tsBuf` 未初始化时 `now()` 会静默返回 0。
fun tNs(): Long {
    ClockImpl.init()
    return ClockImpl.timeNs()
}

fun secOf(deltaNs: Long): String {
    val sec: Long = deltaNs / 1000000000
    val ms: Long = (deltaNs % 1000000000) / 1000000
    val mss: String = toStr(ms)
    val pad: String = if (mss.length == 1) { "00" } else if (mss.length == 2) { "0" } else { "" }
    return toStr(sec) + "." + pad + mss
}

/// 读环境变量，为空时回退 `default`。
///
/// 只用 `Env.get` + `length == 0` 判定，不触碰 `FileUtils`（源码读取仍由
/// `linker.link()` 内部完成）——见上方「输入通道」注释的共存性说明。
fun readPathEnv(name: String, default: String): String {
    val v: String = Env.get(name, "")
    if (v.length == 0) {
        return default
    }
    return v
}

// ── 输入通道：环境变量优先，固定路径兜底 ──
//
// ⚠ 历史：2026-10-03 探针矩阵曾观察到「`Env.get` / `FileUtils.exists+readText`
// 之后进入 `link()` 会稳定段错误」（最小复现见
// docs/photon/photon-bootstrap-link-benchmark.md），因此旧实现完全忽略
// `AURA_HAT_AURA`，走固定路径 `build/hat-vmhost/current.aura`。
//
// 但该注释只覆盖了「读文件类调用」，并未覆盖 `Env.get` 本身——本文件
// `AURA_HAT_SKIP_FRONT` 分支一直依赖 `Env.get`，且
// `scripts/photon/photon-hat-native-suite.ps1` 一直在用它驱动，实测共存安全。
// 2026-10-08 因此补上 `AURA_HAT_AURA/_OUT/_MODULE/_SRC` 的读取：
// `readPathEnv` 只用 `Env.get` + 字符串判空，不触碰 `FileUtils.readText`
// （源码读取仍由 `linker.link()` 内部完成），风险面与原注释所述的最小复现
// 不同。读不到时一律回退默认路径，行为不劣于旧实现。

    fun fnvFile(path: String): String {
        val text: String = FileUtils.readText(path)
        var h: Int = 0x811c9dc5
        var i: Int = 0
        while (i < text.length) {
            h = h * 0x01000193
            h = h ^ text.charCodeAt(i)
            i = i + 1
        }
        var out: String = ""
        var v: Int = h
        var k: Int = 0
        while (k < 8) {
            val d: Int = v & 15
            val ch: Int = if (d < 10) { 48 + d } else { 87 + d }
            out = out + String.fromCharCode(ch)
            v = v >> 4
            k = k + 1
        }
        return out
    }

    fun joinSb(pieces: List<String>): String {
        val sb: StringBuilder = StringBuilder()
        var i: Int = 0
        while (i < pieces.size) {
            sb.append(pieces[i])
            i = i + 1
        }
        return sb.build()
    }

fun main(): Int {
    // 输入通道：**优先读环境变量**（AURA_HAT_AURA / _OUT / _MODULE / _SRC），
    // 未设置时回退到固定路径约定（build/hat-vmhost/current.{aura,hat}）。
    //
    // ⚠ 历史背景与回退原因：宿主主流程早期刻意**只使用已验证安全**的设施
    // （FileUtils.mkdirP / writeText / link 内部的源码读取），因为 2026-10-03
    // 探针矩阵实测 `Env.get` 与 `link()` 共存会段错误。后来实测证明
    // `Env.get("AURA_HAT_SKIP_FRONT")` 与 `link()` 在同一 main 内共存是
    // **安全**的（`AURA_HAT_SKIP_FRONT` 分支就依赖它，且 native 套件
    // photon-hat-native-suite.ps1 一直在用它驱动），因此按文件头文档承诺
    // 补上其余三个变量的读取。读不到时一律回退默认值，不会比旧行为更差。
    //
    // ⚠ 2026-10-08 修复：旧实现完全忽略 `AURA_HAT_AURA`，导致脚本传入的
    // 入口源文件被静默丢弃——驱动恒编译固定的 `current.aura`（一个 VM
    // 自举宿主，运行时读 `build/vm/current.auc` 并打印 `fib(28)` 探针），
    // 表现为「换任何入口源文件，输出都逐字节相同」。这是 P1-3「原生运行时
    // 验证」被误判为「自举链阻塞」的真根因。
    val srcPath = readPathEnv("AURA_HAT_AURA", "build/hat-vmhost/current.aura")
    val outDir = readPathEnv("AURA_HAT_OUT", "build/hat-vmhost")
    val moduleName = readPathEnv("AURA_HAT_MODULE", "current")
    val hatPath = readPathEnv("AURA_HAT_SRC", outDir + "/current.hat")

    FileUtils.mkdirP(outDir)
    // ── [MEM-FIX] 产物缓存（2026-10-10）──────────────────────────────
    // 编译的固定大头 = 前端对整个闭包源码（~45K 行）的词法/解析/SSA 字符串
    // 风暴（阶段归因：concat 1917 万次 / 7.7GB，见 09 报告 §A·补充五）。
    // 闭包+入口源全部未变时，直接回放缓存 COFF（前端+后端全跳过，
    // 编译内存 ~0）。任何源新增/修改/删除（内容哈希校验）→ 回退全量构建。
    // AURA_BUILD_CACHE=0 关闭；AURA_HAT_SKIP_FRONT=1 时不参与缓存。
    val cacheMain: String = outDir + "/" + moduleName + ".cache-main.hex"
    val cacheRt: String = outDir + "/" + moduleName + ".cache-rt.hex"
    val cacheManifest: String = outDir + "/" + moduleName + ".cache-manifest.txt"
    val cacheOn: Boolean = Env.get("AURA_BUILD_CACHE", "1") == "1"

    // ── AURA_HAT_SKIP_FRONT=1：跳过前端，直接复用现成 .hat ──
    //（文档承诺过此开关但一直没实现；「bash 侧补桩 .hat + SKIP_FRONT 重编」
    // 两段式工作流必需它，2026-10-06。跳过段不调 link()，Env.get 安全。）
    val skipFront: Boolean = Env.get("AURA_HAT_SKIP_FRONT", "") == "1"
    // 命中判定:清单存在 → 每个列出的源文件哈希一致 → 缓存 hex 文件存在
    if (cacheOn && !skipFront) {
        val mf: String = FileUtils.readText(cacheManifest)
        if (mf != "") {
        val mlines: List<String> = mf.split("\n")
            var ok: Boolean = mlines[0] == "v1"
            var mainHexPath: String = ""
            var rtHexPath: String = ""
            var linkCmdCached: String = ""
            var fi: Int = 1
            while (fi < mlines.size && ok) {
                val line: String = mlines[fi]
                if (line.startsWith("M ")) {
                    mainHexPath = line.substring(2, line.length)
                    ok = FileUtils.exists(mainHexPath)
                } else if (line.startsWith("R ")) {
                    rtHexPath = line.substring(2, line.length)
                    ok = FileUtils.exists(rtHexPath)
                } else if (line.startsWith("L ")) {
                    linkCmdCached = line.substring(2, line.length)
                } else if (line.startsWith("F ")) {
                    val sp1: Int = line.indexOf(" ", 2)
                    val wantHash: String = line.substring(2, sp1)
                    val path: String = line.substring(sp1 + 1, line.length)
                    if (!FileUtils.exists(path) || fnvFile(path) != wantHash) { ok = false }
                }
                fi = fi + 1
            }
            if (ok && mainHexPath != "" && rtHexPath != "") {
                val mainHex: String = FileUtils.readText(mainHexPath)
                val rtHex: String = FileUtils.readText(rtHexPath)
                if (mainHex != "" && rtHex != "") {
                    println("===COFF-MAIN===")
                    print(mainHex)
                    println("")
                    println("===COFF-RUNTIME===")
                    print(rtHex)
                    println("")
                    println("===LINK===" + linkCmdCached)
                    println("===RESULT===success")
                    return 0
                }
            }
        }
    }
    var seenList: String = ""   // link 实际读取的源文件清单（缓存清单用）
    if (!skipFront) {
        // ── 前端：源码（含递归 import）→ 合并 HIR → SSA → HAT 文本 ──
        val tAll0: Long = tNs()
        val tLink0: Long = tNs()
        val linker = AotModuleLinker()
        val hir: Hir = linker.link(srcPath)
        seenList = linker.seen
        if (linker.missing != "") {
            println("[hat-front] missing imports: " + linker.missing)
        }

        val tSsa0: Long = tNs()
        val ssa: MirSsaProgram = SsaBuilderUtils.build(hir)

        val tHat0: Long = tNs()
        val hatText: String = HatSerializerUtils.serializeHat(ssa, moduleName)
        // ── 溶解对象 getter 桩补写（2026-10-06）──
        //
        // 前端对部分 `object X`（实测 MirUtils，aura/lang/compiler/mir/Mir.aura）
        // 采用「方法限定名 + 体提升」的降级形态：方法以 `X_m` 顶层函数进入 HIR、
        // 方法体被注入 `X_getInstance()` 调用，但对象声明节点不进 HIR ⇒
        // SsaBuilder 的单例登记（buildClassIndex 只认四类声明节点）捕不到 X ⇒
        // getter 未合成 ⇒ 链接期 `undefined symbol: X_getInstance`。
        // 前端根因（Hir.aura 为何溶解、为何四类扫描看不到）留待下轮；此处按
        // 「.hat 文本后处理」兜底：引用了 `@call @X_getInstance(` 却没有
        // `@fn X_getInstance` 定义 ⇒ 追加一个 Memory_alloc 桩 getter
        //（每次调用分配 64 字节零块；被溶解对象当前都是无字段纯静态单例，
        // 实例值实际不被使用，泄漏可忽略）。
        val hatFixed: String = HatGetPatchUtils.patchMissingGetters(hatText)
        FileUtils.writeText(hatPath, hatFixed)
    }

    // ── HAT 文本 → SSA MIR → LIR → DAG → RegAlloc → X86 → COFF ──
    val tBack0: Long = tNs()
    val pipeline = PhotonPipelineUtils.emptyPipeline()
    pipeline.outDir = outDir
    pipeline.moduleName = moduleName
    // [MEM-FIX] 直连判定：getter 桩补写**无改动**（hatFixed == hatText）⇒
    // SSA 与落盘文本语义等价 ⇒ compileSsaDirect 跳过「落盘+重解析」
    // （HatParser 4700 万次 substring/dup + SSA2 双份驻留，2026-10-09）。
    // 补丁触发时自动回退旧路径（补丁只存在于文本层面，必须走重解析）。
    // AURA_COMPILE_ROUNDTRIP=1 强制旧路径（对照/调试）。
    // ⚠️ 默认关闭：实测直连与回环产物存在语义差异（sum .text 0xac8 起
    // 编码不同——回环序列化会把部分调用结果物化进文本，直连保留调用），
    // 等价性工作完成前不可默认启用。
    val directCompile: Boolean = (hatFixed == hatText)
            && Env.get("AURA_COMPILE_DIRECT", "") == "1"
    val result: BackendResult
    if (directCompile) {
        result = pipeline.compileSsaDirect(ssa)
    } else {
        FileUtils.writeText(hatPath, hatFixed)
        result = pipeline.compileHat(hatPath)
    }

    // 输出 COFF hex（主对象 / runtime 对象）与链接信息
    // ⚠️ 分片输出（2026-10-09 内存回合）：result.coffPieces /
    // buildRuntimeObjectPieces 不做单串归并（134M 字符级 = 内容 ×
    // log₂(片段数) 的成对中间层，无 GC 全驻留 ~1.3-2 GB）。协议要求
    // hex 是 marker 后的**单行**——用无换行 print 逐片拼接，行尾 println("")。
    println("===COFF-MAIN===")
    // ⚠️ 分片逐片 print（无换行）——绝不可先拼回单串：134M 字符级
    // O(N²) 拼接 = 数十 GB 驻留（2026-10-09 BISECT-A 残留实测 20GB+）。
    val coffPieces: List<String> = result.coffPieces
    var cp: Int = 0
    while (cp < coffPieces.size) {
        print(coffPieces[cp])
        cp = cp + 1
    }
    println("")
    val rtPieces: List<String> = PhotonRuntime.buildRuntimeObjectPieces()
    println("===COFF-RUNTIME===")
    var rp: Int = 0
    while (rp < rtPieces.size) {
        print(rtPieces[rp])
        rp = rp + 1
    }
    println("")
    println("===LINK===")
    println(result.linkCommand)

    var resultTag: String = "fail"
    if (result.success) { resultTag = "success" }
    println("===RESULT===" + resultTag)
    // [MEM-FIX] 构建成功 → 写产物缓存清单（源文件清单+内容哈希+缓存 hex 路径）。
    // 下次构建源全部未变 → 直接回放缓存（前端+后端全跳过）。
    if (resultTag == "success" && cacheOn && seenList != "") {
        val mf: String = "v1\nM " + cacheMain + "\nR " + cacheRt + "\nL " + result.linkCommand + "\n"
        var fi: Int = 0
        var mf2: String = mf
        while (fi < seenList.length) {
            var nl: Int = -1
            var sc: Int = fi
            while (sc < seenList.length) {
                if (seenList.charCodeAt(sc) == 10) { nl = sc; break }
                sc = sc + 1
            }
            if (nl < 0) { break }
            val path: String = seenList.substring(fi, nl)
            if (path != "" && FileUtils.exists(path)) {
                mf2 = mf2 + "F " + fnvFile(path) + " " + path + "\n"
            }
            fi = nl + 1
        }
        FileUtils.writeText(cacheManifest, mf2)
        FileUtils.writeText(cacheMain, joinSb(coffPieces))
        FileUtils.writeText(cacheRt, joinSb(rtPieces))
    }
    if (!result.success) {
        println("===ERR===" + result.errorMessage)
        return 1
    }
    return 0
}

// ─────────────────────────────────────────────────────────────
// HatGetPatchUtils — 溶解对象 getter 的 .hat 文本桩补写
// （背景与动机见 main 内「getter 桩补写」注释，2026-10-06）
// ─────────────────────────────────────────────────────────────
object HatGetPatchUtils {

    /// 扫描 .hat 文本：引用了 `@call @X_getInstance(` 却没有 `@fn X_getInstance`
    /// 定义 ⇒ 为每个缺失的 X 追加一个 Memory_alloc 桩 getter。
    fun patchMissingGetters(hat: String): String {
        // 1) 收集被调的 X（去重 CSV；禁 ArrayList.add——红线①）。
        var calledCsv: String = ""
        var i: Int = 0
        val n: Int = hat.length
        // 诊断探针（按需打开）：println("[getPatch0] len=" + toStr(n))
        while (i + 7 <= n) {
            // 手工匹配 "@call @"（7 字符）：禁带 from 的 indexOf（红线②）。
            // ⚠️ charCodeAt 必须 `as Int` 再比较（裸比较在 seed AOT 下恒假，
            // 实测 P136 桩补写静默不触发，2026-10-06）。
            if ((hat.charCodeAt(i) as Int) == 64 && (hat.charCodeAt(i + 1) as Int) == 99 &&
                (hat.charCodeAt(i + 2) as Int) == 97 && (hat.charCodeAt(i + 3) as Int) == 108 &&
                (hat.charCodeAt(i + 4) as Int) == 108 && (hat.charCodeAt(i + 5) as Int) == 32 &&
                (hat.charCodeAt(i + 6) as Int) == 64) {
                // 提取名字到 '('
                var j: Int = i + 7
                var name: String = ""
                while (j < n) {
                    val c: Int = hat.charCodeAt(j) as Int
                    if (c == 40) { break }
                    if (c == 10 || c == 32) { name = ""; break }
                    name = name + hat.substring(j, j + 1)
                    j = j + 1
                }
                // 精确后缀 `_getInstance`（12 字符）
                if (name.length > 12) {
                    val cut: Int = name.length - 12
                    if (name.substring(cut, name.length) == "_getInstance") {
                        val x: String = name.substring(0, cut)
                        if (x != "" && calledCsv.indexOf("\n" + x + "\n") < 0) {
                            // 有定义则跳过（`@fn X_getInstance(` 全文检索）
                            val defNeedle: String = "@fn " + x + "_getInstance("
                            if (hat.indexOf(defNeedle) < 0) {
                                println("[getPatch] " + x)
                                calledCsv = calledCsv + "\n" + x + "\n"
                            }
                        }
                    }
                }
                i = j
            }
            i = i + 1
        }
        if (calledCsv == "") {
            return hat
        }
        // 2) 逐个追加桩 getter（每次调用分配 64 字节零块）。
        var out: String = hat
        var p: Int = 0
        while (p < calledCsv.length) {
            var e: Int = p
            while (e < calledCsv.length) {
                if ((calledCsv.charCodeAt(e) as Int) == 10) { break }
                e = e + 1
            }
            if (e > p) {
                val x: String = calledCsv.substring(p, e)
                out = out + "\n@fn " + x + "_getInstance() -> Long" +
                      "\n  bb entry:" +
                      "\n    @s0 = @i32_const 64 : Int" +
                      "\n    @s1 = @call @Memory_alloc(@s0) : Long" +
                      "\n    @ret @s1 : Long\n"
            }
            if (e >= calledCsv.length) { break }
            p = e + 1
        }
        return out
    }
}
