// aura:///aura/lang/compiler/photon/InstructionSelection.aura
package aura.lang.compiler.photon
// ─────────────────────────────────────────────────────────────
// DAG Tiling 指令选择器 — Phase C (任务 C.2) / S1.2 / S1.3
//
// 将 LIR（Lir.aura）通过 DAG Tiling 选择为 MachineDag（MachineDag.aura）
// 中的机器指令序列。
//
// S1 修复要点：
//   - selectFunction 通过 LirProgram.blockOf(id) 取回真实块（不再 new LirBlock()）
//   - selectValue 按 LirValue.op 分派真实指令（不再只产出 "Value"/"Unknown"）
//   - LIR value id → DAG node id 映射记入 nodeMap
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String
import aura.lang.std.Env
import aura.lang.std.fs.FileUtils
import aura.lang.compiler.photon.Lir
import aura.lang.compiler.photon.MachineDag
// `emitConst` 需要按类型 id 判断字符串常量（this.types.isString）：
// 缺这个 import 时 `this.types` 成员无法解析 → 接收者退化为 `<error>`
// → 与 TypeUtils/ValueCheck 等的同名 `isString` 冲突 → 裸名调用未解析。
import aura.lang.compiler.mir.TypeRegistry

/// DAG Tiling 指令选择器。
class InstructionSelector {

    /// 输出的机器级 DAG。
    var dag: MachineDag = MachineDag()

    /// 当前正在处理的函数名。
    var funcName: String = ""

    /// 模式数据库（逗号分隔的模式 ID 列表，用于调试/配置）。
    var patterns: String = ""

    /// 已选择的指令数量计数器。
    var selectedCount: Int = 0

    /// LIR → DAG 节点 ID 映射（**按 LIR 值 ID 直接下标**，O(1)）。
    ///
    /// ⚠️ 旧实现是扁平字符串 `"lirId|dagId\n…"`，`lookupNode` 全表扫描
    ///（含逐行 `substring` + `charAt` 比较 + `startsWith`）：编译真实工程时
    /// 该表条目数与**整个模块的值数**同阶（数万条），每次查询 O(N) 且分配
    /// ⇒ 整条 Phase C 退化为 O(N²) 并持续吃内存。键就是整数 ID，直接下标即可。
    private var nodeMapIds: List<Int> = arrayListOf<Int>()

    /// 当前内存链头节点 ID（-1 表示无内存依赖）。
    private var curChain: Int = -1

    /// 临时值计数器（用于生成虚拟节点名）。
    private var tmpCount: Int = 0

    /// LIR 程序引用（用于 selectValue 时查询真实 LirValue）。
    private var lir: LirProgram = null

    /// 标签计数器（用于控制流块的本地标签）。
    private var labelCount: Int = 0

    /// 块 ID → 标签名 映射（**按块 ID 直接下标**，O(1)）。
    private var labelNames: List<String> = arrayListOf<String>()

    /// 字符串常量计数器（用于生成 @str.N 符号）。
    private var strConstCount: Int = 0

    /// 字符串常量列表（逗号分隔的字符串内容）。
    var stringConstants: String = ""

    /// Photon runtime（`aura_runtime.obj`）已导出的符号名表。
    ///
    /// **必须与 `PhotonRuntime.RUNTIME_SYMBOLS` 逐字一致**（见 `isRuntimeSymbol`
    /// 的说明）：漏一项就会在链接期报 `duplicate symbol`。
    /// 成员方法按本表的 `.` 拼写书写，比较时由 `dotToUnderscore` 归一化，
    /// 因此 `Collections.getAt` 与 `Collections_getAt` 都能命中。
    ///
    /// ⚠️ 2026-10-06：list 家族 7 项（count/listAppend/getAt/indexOf/contains/
    /// listRemove/mapContainsKey）**移出**本名单 —— guest 的 core
    /// `Collections.aura` 已带同名真实现（core 布局），runtime 侧对应物要么是
    /// 桩（getAt 恒返回空串 —— `Env.get` 历史落点），要么布局分叉。保留名单
    /// 会把 guest 真实现抑制掉（`!isRuntimeSymbol` 跳过发射），实测
    /// `tl.get(0)` 返回空串。仅保留 guest 没有的 clear/hashMapPut。
    private var runtimeSymbolNames: String = "println,print,puts,toStr,strcat,toInt,toFloat,toString,strlen,streq,charCodeAt,exit,Memory_write,Memory_read,Memory_write16,Memory_read16,Memory_write32,Memory_read32,Memory_write64,Memory_read64,Memory_alloc,Memory_free,Memory_atomicAdd,Memory_mmap,Memory_munmap,Memory_arcIncrement,Memory_arcDecrement,RegionEnter,RegionReset,io_open,io_close,io_read,io_write,io_access,Collections.clear,Collections.hashMapPut,env_get,Env_get,__obj_slot_get,__obj_slot_set,Memory_copy,Memory_mprotect,ProcessOps_execve,ProcessOps_fork,ProcessOps_wait4,String_fromCharCode,String_substring,ProcessOps_aura_process_argCount,ProcessOps_aura_process_args,aura_heapbump,Heap_init,Heap_mmap,boolToStr,charToStr,aura_isOfType,refToStr,String_contains,String_toUpperCase,Path_join,Path_basename,Env_has,FileUtils_writeText,FileUtils_readText,FileUtils_exists"

    /// `computeReachable` 的列表形式结果（供 `select()` 免分配查表）。
    private var reachableNames: List<String> = arrayListOf<String>()

    /// P40x：与 lirFuncNames 平行的返回类型表（emitToStrConvNode 判被调
    /// 是否返回 String 用；下标一一对应）。
    private var lirFuncRetTys: List<Int> = arrayListOf<Int>()

    // P40x-d：concat 转换开关读一次缓存（-1 未读）。热点路径 Env.get =
    // 驱动段错误，开关必须缓存。
    private var concatConvCache: Int = -1

    /// LIR 全部定义函数名（select() 入口建一次，供 `resolveCalleeSymbol` 查表）。
    private var lirFuncNames: List<String> = arrayListOf<String>()

    /// 被调名解析缓存（名字 → 解析结果；解析结果等于名字时也缓存，查表免重扫）。
    private var calleeCacheNames: List<String> = arrayListOf<String>()
    private var calleeCacheTargets: List<String> = arrayListOf<String>()

    /// 强制纳入可达集合的符号清单（定义名）。
    ///
    /// ⚠️ 存在的理由：自举前端对**顶层工具函数 / 同名方法**常发**裸名**
    ///（`mirNoKids`、`add`、`keys`），定义却带命名空间前缀
    ///（`MirUtils_mirNoKids`、`Ast_add` / `Hir_add` / `Mir_add`、`EnvOps_keys`…）。
    /// 按名字走图的 `computeReachable` 识别不出这条边 ⇒ 定义不进可达集合
    /// ⇒ `select()` 不选它 ⇒ 链接期 `undefined symbol`。
    /// 只改调用点映射（`mapStdlibFuncName`）**不够**：定义依然没被发射。
    ///
    /// 曾尝试「对所有被调名做 `_<name>` 后缀匹配」的**通用**回退，结论是**不可取**：
    /// 常见裸名（`add` / `get` / `set` / `toString`）各能匹配到几十个定义，
    /// 可达集合迅速膨胀到近乎整个模块；同时那是 O(N²) 的字符串累加。
    /// 实测自举：43s → **394s**、内存 **破 10 GB**（被人工终止）。
    /// 因此改为这份**显式小清单**：有界、确定、成本可忽略。
    ///
    /// ⚠️ 清单本身也要**克制**：这里每加一个名字，都会连带拉进它的**传递闭包**
    ///（它们调用的函数、再下一层……）。实测把 `Ast_add`/`Hir_add`/`Mir_add`/
    /// `ArrayList_add`/`HashMap_keys`/`EnvOps_keys` 一起加进来后，自举耗时
    /// 43s → **265s**、`Main.obj` 1.11MB → 1.73MB —— 收益为零（`add`/`keys`
    /// 的调用点仍未被映射，仍是未定义），代价却是 6 倍编译时间。
    /// 只保留**确实解决未定义**的叶子小函数。
    ///
    /// ⚠️ 2026-09-29 瘦身：移除了 `ArrayList_add,HashMap_keys,Ast_add,Hir_add,Mir_add`
    /// 这 5 项——本注释第 96–99 行已明确证明它们"收益为零（`add`/`keys` 的调用点
    /// 仍未被映射，仍是未定义）"，却各拉进自己的传递闭包，代价是 6 倍编译时间
    /// （自举 43s → 265s）。移除后若出现新的 `undefined symbol`，按"哪一项回来
    /// 就带来哪批未定义"逐个补回，**不要一次加回全部**（调用点映射本来就没修好）。
    // 2026-10-06 追加：core 包列表实现（aura.lang.collection.Collections）——
    // HAT 调用名为点形式（@Collections.getAt），定义名为下划线
    //（@fn Collections_getAt），computeReachable 的映射入队对
    // listAppend（无限定映射规则）不生效 ⇒ 定义被剪 → undefined symbol。
    // 显式强制纳入（有界清单机制的本职用途）。
    private var forceReachable: String = "MirUtils_mirNoKids,MirUtils_mirKidsAdd,Linearizer_mirNoKids,Linearizer_mirKidsAdd,FileUtils_mkdir,Collections_listAppend,Collections_getAt,Collections_count,Collections_listSet,Collections_listPop,Collections_emptyList,Collections_newList,Collections_push,Collections_contains,Collections_indexOf,Collections_mapContainsKey,Collections_listRemove,Collections_range"

    /// Phase C 定位探针（见 `selProbe` 的说明）。
    private var probePath: String = ""
    private var probeBuf: String = ""
    private var probeStep: Int = 0

    /// 字符串常量分块表（`select()` 结束时归并成 `stringConstants`）。
    ///
    /// ⚠ 旧实现是 `stringConstants = stringConstants + "," + lit`，而它**跨函数**
    /// 累积（`select()` 期间一共只有一份表）：自举 `Main.aura` 选中 1200+ 个函数后
    /// 常量条目上万，逐条整段拷贝 ⇒ O(条目数²)，实测在 Phase C 吃掉 20 GB
    /// （`AURA_MEM_LIMIT_MB=20480` 仍被打爆）。改为分块追加 + 末尾两两归并。
    private var stringConstChunks: List<String> = arrayListOf<String>()

    /// 追加一条字符串常量（O(1)，不做拷贝）。
    private fun stringConstAdd(lit: String): Unit {
        this.stringConstChunks.add(lit)
    }

    /// 把分块列表两两归并成整串（O(总长 · log 块数)）。
    private fun joinChunks(items: List<String>): String {

        var cur: List<String> = items
        while (cur.size > 1) {
            val next: List<String> = arrayListOf<String>()
            var i: Int = 0
            while (i < cur.size) {
                if (i + 1 < cur.size) {
                    next.add(cur[i] + "," + cur[i + 1])
                } else {
                    next.add(cur[i])
                }
                i = i + 2
            }
            cur = next
        }
        if (cur.size == 0) {
            return ""
        }
        return cur[0]
    }

    /// 常量池的**可逆编码**：每条 `<十进制长度>|<载荷>`，首尾直接相接（无需分隔符）。
    ///
    /// ⚠️ 旧编码是「用 `,` 连接 + 靠引号平衡判断哪些逗号是分隔符」。只要某条载荷里
    /// 出现**未转义且数量为奇数**的 `"`，引号状态机就会翻转，其后所有逗号都不再当
    /// 分隔符 —— 整段尾部坍缩成**一条**。自举 `Main.aura` 实测：
    ///     `strConstCount=8669` / `chunks=8669`（发射端自洽）
    ///     写入端 `splitCommaQuoted` 只解析出 **5762** 条
    /// ⇒ `@str.5762` 之后的常量**缺符号** ⇒ 引用它们的 5454 条重定位在
    /// `composeRelocations` 被静默丢弃 ⇒ 那些 `lea`/`call` 位移保持占位值 0
    /// ⇒ 指针指向代码字节 ⇒ `strlen` 越界 ⇒ `0xC0000005`。
    ///（`main` 是最后发射的函数，其常量编号必然落在丢失区间 ⇒ 崩在第一条语句。）
    ///
    /// 长度前缀与内容完全无关，与 `PhotonObjectWriter.parseConstPool` 严格互逆。
    private fun joinConstPool(items: List<String>): String {
        if (items.size == 0) {
            return ""
        }
        val parts: List<String> = arrayListOf<String>()
        var i: Int = 0
        while (i < items.size) {
            parts.add(MachineDagUtils.toStr(items[i].length) + "|" + items[i])
            i = i + 1
        }
        // 两两归并（纯拼接、无分隔符）避免 O(n²)
        var cur: List<String> = parts
        while (cur.size > 1) {
            val next: List<String> = arrayListOf<String>()
            var k: Int = 0
            while (k < cur.size) {
                if (k + 1 < cur.size) {
                    next.add(cur[k] + cur[k + 1])
                } else {
                    next.add(cur[k])
                }
                k = k + 2
            }
            cur = next
        }
        return cur[0]
    }

    /// 当前函数已处理的参数计数（用于确定 ABI 寄存器 rcx/rdx/r8/r9）。
    private var paramIndex: Int = 0

    /// Const 节点的寄存器轮转计数器（避免所有 Const 都默认到 rax 导致 clobber）。
    private var constRegCounter: Int = 0

    /// Const 节点轮转寄存器列表。
    ///
    /// **只用 Windows x64 的非易失（callee-saved）寄存器**：rbx / rsi / rdi /
    /// r12-r15。常量的值经常要跨越调用存活（例如 `println("x = " + toStr(x))`
    /// 里的字符串地址），放进易失寄存器（rax/rcx/rdx/r8-r11）会被被调函数
    /// 无条件覆写 —— 实测常量被换成 `toStr` 的返回值，输出变成 `42` 而不是
    /// `x = 42`。配合「函数入口保存/出口恢复」这套约定才成立。
    private var constRegs: List<String> = listOf("rbx", "rsi", "rdi", "r12", "r13", "r14", "r15")

    /// PHI 前驱信息（保留供调试打印；正式数据在下面两张表里）。
    private var phiPreds: String = ""

    /// PHI-MOV 表：**按边块 ID − `phiMovBase` 下标**的**扁平**记录表。
    ///
    /// ⚠ 旧实现把全部 PHI-MOV 累计进一个 `phiPreds` 大串：
    ///   * 生产端 `phiPreds = phiPreds + …` 每条边一次整段拷贝 ⇒ O(边数²)；
    ///   * 消费端 `emitPhiMovsForBlock` 对**每个块**都 `split` 整串 ⇒ O(块数 × 边数)。
    /// 自举 `Main.aura` 的 `emitCall`（547 块）实测 phiPreds 涨到 16 万字符以上
    /// 并在 Phase C 吃满 12 GB 内存闸门。按下标存即两侧都 O(1)/O(本块边数)。
    ///
    /// ⚠️ 2026-10-02：不再用 `List<List<String>>`——嵌套列表的**内层临时对象**
    /// 在 AOT 重负载下实测损坏（slot.size 读回指针值、随后段错误；单层
    /// List + 算术下标读写经 `build/lstest*.aura` 全套探针验证可靠）。
    /// 布局：`phiMovFlat[(blk-base)*CAP + k]` 为第 k 条记录
    /// `"<phiVid>,<incomingVid>"`，`phiMovCnt[blk-base]` 为该槽记录数。
    private var phiMovFlat: List<String> = arrayListOf<String>()

    /// 每槽 PHI-MOV 记录数（与 `phiMovFlat` 同槽位下标）。
    private var phiMovCnt: List<Int> = arrayListOf<Int>()

    /// 每槽记录容量上限（超出者丢弃；PHI 前驱数超过 32 的块在实际代码里未出现）。
    private var phiMovCap: Int = 32

    /// 临时诊断（2026-10-05）：PHI-MOV 发射计数。AURA_PHI_DIAG=1 时输出。
    private var phiDiagOn: Boolean = false
    private var phiDiagEmitted: Int = 0
    private var phiDiagMissing: Int = 0

    /// P386 诊断：vmSubstr 调用实参追踪（前 40 个）。AURA_PHI_DIAG=1 时输出。
    private var diagCallArgCnt: Int = 0

    /// P387 诊断：Add 类型判定追踪（前 60 个）。AURA_PHI_DIAG=1 时输出。
    private var diagAddCnt: Int = 0

    /// P390 诊断：emitCall escape 过滤计数（独立）。
    private var diagCeCnt: Int = 0

    /// P390 诊断：GetField 分派计数（独立）。
    private var diagGfCnt: Int = 0

    /// 每块的传递前驱闭包（位集，wordsPer * slots 个 Int；见 pass1.5）。
    private var predClosure: List<Int> = arrayListOf<Int>()
    private var predClosureWords: Int = 0
    /// P382：支配集（dom[b] 位集）与基址——def ∈ dom[pred] ⇔ def 支配 pred。
    private var domSet: List<Int> = arrayListOf<Int>()
    private var domWords: Int = 0
    private var domBase: Int = 0

    /// Phi 入口边配对（phiLirId -> entryIncomingLirId），供 RA 后 home 合并。
    private var phiEntryMapIds: List<Int> = arrayListOf<Int>()
    private var phiEntryMapHomes: List<Int> = arrayListOf<Int>()
    private var phiEntryMapCnt: Int = 0

    /// P372：Phi 入边值认领表（槽合并核心）。emitPhi 为每个非 Const/Phi
    /// 入边值登记 `vid → phi 的 DAG 节点`；pass3 定义侧 registerNode 时
    /// 查表，把定义节点的栈槽**别名到 phi 节点的栈槽**——定义写与 phi 读
    /// 落同一槽，phi MOV 退化为自拷贝，边匹配/前驱标签错误不再可能
    /// 影响正确性（§10.89 总根的治本修复）。
    private var phiClaimFrom: List<Int> = arrayListOf<Int>()
    private var phiClaimNode: List<Int> = arrayListOf<Int>()
    /// 定义节点 → phi 节点的槽别名（registerNode 时记录，发射器消费）。
    private var slotAliasFrom: List<Int> = arrayListOf<Int>()
    private var slotAliasTo: List<Int> = arrayListOf<Int>()

    /// 查询 vid 被哪个 phi 认领（返回 phi 的 DAG 节点 id；−1 = 无）。
    private fun phiClaimTarget(vid: Int): Int {
        var i: Int = this.phiClaimFrom.size - 1
        while (i >= 0) {
            if (this.phiClaimFrom[i] == vid) { return this.phiClaimNode[i] }
            i = i - 1
        }
        return -1
    }

    /// 槽别名链解析（dagNode → … → phi 节点；无别名原样返回）。
    fun slotAliasResolve(nodeId: Int): Int {
        var n: Int = nodeId
        var guard: Int = 0
        while (guard < 64) {
            var found: Int = -1
            var i: Int = this.slotAliasFrom.size - 1
            while (i >= 0) {
                if (this.slotAliasFrom[i] == n) { found = this.slotAliasTo[i]; break }
                i = i - 1
            }
            if (found < 0) { break }
            n = found
            guard = guard + 1
        }
        return n
    }

    /// 槽别名表（Phase C 结束后定型，发射器经管线消费）。
    fun getSlotAliasFrom(): List<Int> { return this.slotAliasFrom }
    fun getSlotAliasTo(): List<Int> { return this.slotAliasTo }

    /// 判定「fromBlock 是 toBlock 的传递前驱」（含直接前驱）。
    private fun isTransitivePred(fromBlock: Int, toBlock: Int): Boolean {
        if (this.predClosureWords <= 0) { return false }
        if (fromBlock < this.phiMovBase) { return false }
        if (toBlock < this.phiMovBase) { return false }
        val ti: Int = toBlock - this.phiMovBase
        val fi: Int = fromBlock - this.phiMovBase
        if (ti >= this.predClosure.size / this.predClosureWords) { return false }
        if (fi >= this.predClosure.size / this.predClosureWords) { return false }
        val w: Int = fi / 32
        if (w >= this.predClosureWords) { return false }
        val bit: Int = 1 << (fi % 32)
        val rowBase: Int = ti * this.predClosureWords
        if (rowBase + w >= this.predClosure.size) { return false }
        return (this.predClosure[rowBase + w] and bit) != 0
    }

    /// P382：def ∈ dom[pred] ⇔ def 支配 pred（每条到 pred 的路径都经过
    /// def ⇒ 入边值在该边必然存活）。支配集在 analyzePhiPreds 内计算。
    private fun isDominating(defBlock: Int, ofBlock: Int): Boolean {
        if (this.domWords <= 0) { return false }
        if (defBlock < this.domBase) { return false }
        if (ofBlock < this.domBase) { return false }
        val oi: Int = ofBlock - this.domBase
        val di: Int = defBlock - this.domBase
        if (oi >= this.domSet.size / this.domWords) { return false }
        if (di >= this.domSet.size / this.domWords) { return false }
        val w: Int = di / 32
        if (w >= this.domWords) { return false }
        val bit: Int = 1 << (di % 32)
        val rowBase: Int = oi * this.domWords
        if (rowBase + w >= this.domSet.size) { return false }
        return (this.domSet[rowBase + w] and bit) != 0
    }

    /// 全函数 PHI-MOV 记录总数（探针/诊断用）。
    private var phiMovTotal: Int = 0

    /// PHI-MOV 表的下标基准（函数内最小块 ID）。
    private var phiMovBase: Int = 0

    /// 缓存的 trace 开关（入口处读一次 `Env.get`，避免 `selectBlock` 每块都读 environ）。
    private var traceOn: Boolean = false

    /// 类型注册表（MIR/LIR 的类型 id → 类型名）。
    ///
    /// `emitConst` 需要它把 `LirValue.type` 判定为「字符串 / 数值」。
    /// 由 `select()` 从 `LirProgram.types` 绑定（见 Lowering 的 `dst.types`），
    /// 保证与产出这些类型 id 的是**同一个**注册表。
    var types: TypeRegistry = TypeRegistry()

    init() {
        this.dag = MachineDag()
        this.traceOn = false
        this.funcName = ""
        this.patterns = ""
        this.selectedCount = 0
        this.nodeMapIds = arrayListOf<Int>()
        this.curChain = -1
        this.tmpCount = 0
        this.lir = null
        this.labelCount = 0
        this.labelNames = arrayListOf<String>()
        this.strConstCount = 0
        this.stringConstants = ""
        this.stringConstChunks = arrayListOf<String>()
        this.types = TypeRegistry()
        this.paramIndex = 0
        this.constRegCounter = 0
        this.constRegs = listOf("rbx", "rsi", "rdi", "r12", "r13", "r14", "r15")
        this.phiPreds = ""
    }

    // ── 主入口 ──

    /// 将 LIR 程序转换为 MachineDag（主入口）。
    fun select(src: LirProgram): MachineDag {
        this.dag = MachineDag()
        this.traceOn = this.traceFlag()
        this.phiDiagOn = Env.get("AURA_PHI_DIAG", "") == "1"
        this.phiDiagEmitted = 0
        this.phiDiagMissing = 0
        this.dag.setTraceOn(this.traceOn)
        this.nodeMapIds = arrayListOf<Int>()
        this.curChain = -1
        this.tmpCount = 0
        this.selectedCount = 0
        this.funcName = ""
        this.labelCount = 0
        this.labelNames = arrayListOf<String>()
        this.strConstCount = 0
        this.stringConstants = ""
        this.stringConstChunks = arrayListOf<String>()
        this.paramIndex = 0
        this.constRegCounter = 0
        this.lir = src
        this.phiPreds = ""
        // 绑定 LIR 的类型注册表：`emitConst` 用它判定字符串常量。
        this.types = src.types

        // 只选择**从入口 `main` 可达**的函数。
        //
        // 否则会把 `Any.toString` / `Any.equals` / `Any.hashCode` 这些**未被使用**
        // 的方法一并编进 .text —— 它们内部会调用 runtime 未提供的符号
        // （实测 `lld-link: undefined symbol: toStr` / 以及前端误把
        //  某些源码行误当成调用而生成的垃圾符号名）。结果是：连
        // `println("Hello, World!")` 这种只用到 `println` 的程序都**链不出来**。
        //
        // 找不到入口（脚本型模块等情况）时退回「全选」，避免行为回退。
        this.probePath = this.readProbePath()
        this.probeBuf = ""
        this.probeStep = 0
        this.selProbe("select start fn=" + MachineDagUtils.toStr(src.functionCount) +
                " probe=" + this.probePath)
        // LIR 定义函数名索引（`resolveCalleeSymbol` 的查表底座）。
        this.lirFuncNames = arrayListOf<String>()
        // P40x：并行返回类型表（与 lirFuncNames 下标一一对应）
        this.lirFuncRetTys = arrayListOf<Int>()
        this.calleeCacheNames = arrayListOf<String>()
        this.calleeCacheTargets = arrayListOf<String>()
        var nfi: Int = 0
        while (nfi < src.functionCount) {
            this.lirFuncNames.add(src.functionOf(nfi).name)
            this.lirFuncRetTys.add(src.functionOf(nfi).returnType)
            nfi = nfi + 1
        }
        val reachable: String = this.computeReachable(src, "main")
        this.selProbe("reachable done n=" + MachineDagUtils.toStr(this.reachableNames.size) +
                " strLen=" + MachineDagUtils.toStr(reachable.length))
        val hasEntry: Boolean = this.nameInList(reachable, "main")

        // 已选函数名（去重表）。
        //
        // ⚠ Aura 自举前端的函数命名空间是**扁平的裸名**（`HirLowerer.lowerCall`
        // 对 `X.m()` 只取成员名，见 `SsaBuilder.buildAllFunctions` 的说明），
        // 于是不同模块/类里同名的函数（实测自举 `Main.aura`：`run` ×4、
        // `println` ×2、`strlen` ×2、`isValid` ×2 …）会被**各自**编进 .text。
        // 同名符号在 COFF 符号表里重复 → 链接期 `duplicate symbol`。
        // 这里按名字去重（先到先得，与 `computeReachable` 的「名字即身份」一致）。
        val selected: List<String> = arrayListOf<String>()
        // 每函数一条进度心跳：自举 `Main.aura` 要选 ~2000 个函数，没有它无法
        // 区分「慢」与「卡死」。默认关闭（stdout 只留 `===...===` 协议标记）。
        // 任一开关为 `1` 即开启：AURA_PHOTON_VERBOSE / AURA_PHOTON_TRACE；
        // AURA_HAT_TRACE 为历史别名，继续有效。
        var fi: Int = 0
        while (fi < src.functionCount) {
            val func: LirFunction = src.functionOf(fi)
            if ((!hasEntry || this.listContains(this.reachableNames, func.name))
                && !this.isRuntimeSymbol(func.name)
                && !this.listContains(selected, func.name)) {
                selected.add(func.name)
                if (this.traceOn) {
                    // 打印在**进入**函数之前：崩溃时最后一行就是出事的函数名。
                    println("[isel] fi=" + MachineDagUtils.toStr(fi) + "/" +
                            MachineDagUtils.toStr(src.functionCount) +
                            " nodes=" + MachineDagUtils.toStr(this.dag.nodeCount) +
                            " instrs=" + MachineDagUtils.toStr(this.dag.instrCount) +
                            " fn=" + func.name)
                }
                // 探针同样打在**进入函数之前**：C 侧链超限时 `exit(71)`，
                // 最后一行就是出事的函数（`selProbe` 是立即落盘的）。
                this.selProbe("fn enter fi=" + MachineDagUtils.toStr(fi) + "/" +
                        MachineDagUtils.toStr(src.functionCount) +
                        " sel=" + MachineDagUtils.toStr(selected.size) +
                        " nodes=" + MachineDagUtils.toStr(this.dag.nodeCount) +
                        " instrs=" + MachineDagUtils.toStr(this.dag.instrCount) +
                        " fn=" + func.name)
                this.selectFunction(func, src)
            }
            fi = fi + 1
        }

        // Phase C: 寻址模式融合 — Load/Store 对消除
        this.selProbe("before fuse instrs=" + MachineDagUtils.toStr(this.dag.instrCount) +
                " nodes=" + MachineDagUtils.toStr(this.dag.nodeCount))
        this.fuseLoadStorePairs()
        this.selProbe("after fuse instrs=" + MachineDagUtils.toStr(this.dag.instrCount) +
                " nodes=" + MachineDagUtils.toStr(this.dag.nodeCount) +
                " strChunks=" + MachineDagUtils.toStr(this.stringConstChunks.size))

        // 字符串常量表在**全部函数选完之后**一次性归并（见 `stringConstChunks`）。
        this.stringConstants = this.joinConstPool(this.stringConstChunks)
        // 定性探针：`@str.N` 的下标空间（`strConstCount`）与常量表条目数必须相等。
        // 若 count > chunks，则存在「递增了下标但没登记常量」的路径 —— 那些
        // `@str.N` 会缺符号，引用它的重定位在 `composeRelocations` 被静默丢弃。
        println("STRCONST count=" + MachineDagUtils.toStr(this.strConstCount) +
                " chunks=" + MachineDagUtils.toStr(this.stringConstChunks.size) +
                " joinedLen=" + MachineDagUtils.toStr(this.stringConstants.length))
        this.selProbe("after joinChunks strConsts=" +
                MachineDagUtils.toStr(this.stringConstants.length))

        if (this.phiDiagOn && (this.phiDiagEmitted > 0 || this.phiDiagMissing > 0)) {
            println("[phi-diag] fn=" + this.funcName + " emitted=" + toStr(this.phiDiagEmitted)
                    + " missing=" + toStr(this.phiDiagMissing))
        }
        return this.dag
    }

    // ── 可达性分析（死函数消除）──

    /// 从入口函数出发，按 LIR 的 `Call` 指令收集可达函数名（逗号分隔）。
    ///
    /// 见 `select()` 里的说明：不可达函数会被编进 .text 并引入 runtime 未提供的
    /// 外部符号（`toStr` 等），让链接直接失败。
    ///
    /// 入口队列除 `entry` 外还会并入 `forceReachable` 的显式清单（见其说明）。
    /// 最后一个实参是否为内存链 token（`MemToken`）。见 `mapStdlibFuncName`
    /// 中集合版 `add` 的判据说明。
    private fun lastArgIsMemToken(args: List<Int>): Boolean {
        if (args.size < 1) {
            return false
        }
        val li: Int = args[args.size - 1]
        if (li < 0) {
            return false
        }
        return this.lir.valueOf(li).op == "MemToken"
    }

    private fun computeReachable(src: LirProgram, entry: String): String {
        // 注：这里曾放过「按 `_<callee>` 后缀匹配定义名」的通用回退 + 记忆化缓存，
        // 因可达集合爆炸（近乎全模块）与 O(N²) 缓存拼接而回退 —— 见 `forceReachable`。

        // 为什么用**列表队列 + 列表去重**，而不是「逗号串 + `splitArgs` 出队」：
        // 旧实现把待处理队列存成一个字符串，每展开一次就 `splitArgs` 出队、再
        // 把该函数**所有调用点**的被调名（含大量重复）`pending = pending + "," + …`
        // 追加回去。自举 `Main.aura` 的调用点多达十几万，队列串被反复整段拷贝 ⇒
        // O(边数 × 队列长度) 的分配，实测在 Phase C 前就吃满 12 GB 内存闸门
        // （`guard` 只限制「名字」数，限制不了这类重复追加）。
        //
        // 同时旧实现的 `guard < 128` 会**提前截断**遍历：`readBytecode` /
        // `countTextLines` 等确有定义的函数进不了 `out`，`select()` 不选它们，
        // 链接期报一堆 `undefined symbol`。新实现靠「每个名字只展开一次」自然收敛。
        val outList: List<String> = arrayListOf<String>()
        val queue: List<String> = arrayListOf<String>()
        queue.add(entry)
        var head: Int = 0

        // 强制纳入清单（见 `forceReachable` 的说明）：有界、确定、成本可忽略。
        val forced: List<String> = LirUtils.splitArgs(this.forceReachable)
        var fq: Int = 0
        while (fq < forced.size) {
            if (forced[fq] != "" && !this.listContains(queue, forced[fq])) {
                queue.add(forced[fq])
            }
            fq = fq + 1
        }

        while (head < queue.size) {
            val cur: String = queue[head]
            head = head + 1
            if (cur == "" || this.listContains(outList, cur)) {
                continue
            }
            outList.add(cur)

            // 扫描 `cur` 的基本块，收集其 Call 的被调函数名（同名函数只取第一个，
            // 与 `select()` 的「同名去重」保持同一身份口径）。
            var fi: Int = 0
            while (fi < src.functionCount) {
                val f: LirFunction = src.functionOf(fi)
                if (f.name == cur) {
                    // Lir P2.2 起 `blocks`/`instrs` 是类型化 List[Int>] —— 旧的
                    // `splitArgs(List)` 依赖宿主的隐式 List→String 转换，VM 下
                    // 侥幸可用，AOT 下退化为空串 ⇒ 可达集合坍缩成 {main}，
                    // 全部函数体零发射（主 COFF 只剩桩）。
                    // 下标表达式先取出到 Int 局部（同 `analyzePhiPreds` 的规约）。
                    var bi: Int = 0
                    while (bi < f.blocks.size) {
                        val blkId: Int = f.blocks[bi]
                        val b: LirBlock = src.blockOf(blkId)
                        var ii: Int = 0
                        while (ii < b.instrs.size) {
                            val vid: Int = b.instrs[ii]
                            val v: LirValue = src.valueOf(vid)
                            if (v.op == "Call" && v.aux != "") {
                                if (!this.listContains(outList, v.aux)) {
                                    queue.add(v.aux)
                                }
                                // 2026-10-02 修复：**可达性与发射用同一个名字映射**。
                                // emitCall 会把被调名经 mapStdlibFuncName 做接收者类型
                                // 分派（裸名 `keys`→`HashMap_keys`、`textOf`→`Ast_textOf`、
                                // `getSize`→`ArrayList_getSize`……），而此处此前只收集
                                // **映射前**的裸名 —— 裸名没有同名定义，于是被调函数的
                                // **定义**被死代码消除剪掉，`select()` 不编码，链接期报
                                // `undefined symbol`（自举 Main.aura 实测 20 个，全部此类）。
                                // 这里把映射后的名字也入队（无定义时自然收敛，无害）。
                                val rTy: String = this.callReceiverTypeName(v.args)
                                val mapped: String = this.mapStdlibFuncName(
                                    v.aux, rTy, v.args.size, this.lastArgIsMemToken(v.args))
                                if (mapped != "" && mapped != v.aux
                                    && !this.listContains(outList, mapped)) {
                                    queue.add(mapped)
                                }
                            }
                            ii = ii + 1
                        }
                        bi = bi + 1
                    }
                    // 同名函数只展开第一个（名字即身份），避免重复展开
                    break
                }
                fi = fi + 1
            }
        }

        // 出口仍返回逗号串（`nameInList` 语义），同时留下列表供 `select()` 免分配查表
        this.reachableNames = outList
        var out: String = ""
        var i: Int = 0
        while (i < outList.size) {
            if (out == "") { out = outList[i] } else { out = out + "," + outList[i] }
            i = i + 1
        }
        return out
    }

    /// 列表内是否包含指定名字（无分配的线性扫描）。
    private fun listContains(list: List<String>, name: String): Boolean {
        var i: Int = 0
        while (i < list.size) {
            if (list[i] == name) { return true }
            i = i + 1
        }
        return false
    }

    /// `s` 是否以后缀 `suffix` 结尾（charCodeAt 逐字节；AOT 下 `charCodeAt`
    /// 是无边界检查的内联访存，循环条件必须在结构上保证下标合法）。
    private fun endsWithStr(s: String, suffix: String): Boolean {
        val slen: Int = s.length
        val tlen: Int = suffix.length
        if (slen < tlen) { return false }
        var i: Int = 0
        while (i < tlen) {
            if (s.charCodeAt(slen - tlen + i) != suffix.charCodeAt(i)) { return false }
            i = i + 1
        }
        return true
    }

    /// 被调名兜底解析（2026-10-02，链接失败修复的第二半）。
    ///
    /// `mapStdlibFuncName` 覆盖不了所有调用点：自举前端对成员方法**大量发裸名**
    ///（实测 `@call @build(...)` / `@call @getSize(...)` / `@call @tokenCount(...)`），
    /// 接收者类型缺位时映射表无从分派 → 引用裸名 → 链接期 `undefined symbol`。
    ///
    /// 规则（有界、可预测）：
    ///   1. 名字是 runtime 符号或 LIR 已有同名定义 → 原样返回；
    ///   2. 否则找 **`_<name>` 后缀唯一命中**的 LIR 定义（`<Class>_name` 命名约定）
    ///      → 重写到该定义；
    ///   3. 多个命中时若 `recvTy_name` 恰在命中列表 → 按接收者类型定；
    ///      仍歧义 → 原样保留（链接期可见，不猜）。
    ///
    /// 与 `computeReachable` 的映射入队配套：这里改写的每个名字，可达集合里
    /// 都已有同名定义（映射入队 + 本解析同用 `lirFuncNames` 查表），定义必被编码。
    private fun resolveCalleeSymbol(name: String, recvTy: String): String {
        var ci: Int = 0
        while (ci < this.calleeCacheNames.size) {
            if (this.calleeCacheNames[ci] == name) {
                return this.calleeCacheTargets[ci]
            }
            ci = ci + 1
        }
        var target: String = name
        if (!this.listContains(this.lirFuncNames, name) && !this.isRuntimeSymbol(name)) {
            val cands: List<String> = arrayListOf<String>()
            val suffix: String = "_" + name
            var i: Int = 0
            while (i < this.lirFuncNames.size) {
                val n: String = this.lirFuncNames[i]
                if (this.endsWithStr(n, suffix)) {
                    cands.add(n)
                }
                i = i + 1
            }
            if (cands.size > 0) {
                var csv: String = ""
                var ci2: Int = 0
                while (ci2 < cands.size) {
                    if (ci2 > 0) { csv = csv + "," }
                    csv = csv + cands[ci2]
                    ci2 = ci2 + 1
                }
                println("[resolve] " + name + " -> cands(" + toStr(cands.size) + ")=[" + csv + "] recvTy=[" + recvTy + "]")
            }
            if (cands.size == 1) {
                target = cands[0]
            } else if (cands.size > 1 && recvTy != "") {
                val pref: String = recvTy + "_" + name
                if (this.listContains(cands, pref)) {
                    target = pref
                }
            }
        }
        this.calleeCacheNames.add(name)
        // ⚠️ 返回前把点号归一为下划线：runtime obj 的导出名自 2026-10-06 起
        // 统一为下划线形态（`Collections_count` 而非 `Collections.count`，
        // 与 ISel 映射表、"定义名为下划线"约定一致）。旧实现把命中
        // runtime 名单的名字**原样保留**——名单里是点号 ⇒ guest obj 引用
        // 点号符号 ⇒ 链接期 `undefined symbol: Collections.hashMapPut`
        //（实测 P223：hashMapPut/mapContainsKey/indexOf 三处）。
        target = this.dotToUnderscore(target)
        this.calleeCacheTargets.add(target)
        return target
    }

    /// 进度/心跳开关：任一为 `1` 即开启。默认关闭（stdout 只留 `===...===`
    /// 协议标记，构建脚本逐行解析）。
    ///   `AURA_PHOTON_VERBOSE=1`   阶段进度/心跳
    ///   `AURA_PHOTON_TRACE=1`     上者 + 节点级崩溃诊断
    ///   `AURA_HAT_TRACE=1`        历史别名（HAT 解析器心跳），继续有效
    private fun traceFlag(): Boolean {
        return Env.get("AURA_PHOTON_VERBOSE", "") == "1"
                || Env.get("AURA_PHOTON_TRACE", "") == "1"
                || Env.get("AURA_HAT_TRACE", "") == "1"
    }

    /// 读取一次探针输出路径（`Env.get` 不能进循环，见 `PhotonPipeline.verboseOn`
    /// 的说明），只返回一次；空串表示关闭。
    private fun readProbePath(): String {
        if (Env.get("AURA_SEL_PROBE", Env.get("AURA_MEM_STATS", "")) != "1") {
            return ""
        }
        val p: String = Env.get("AURA_SEL_PROBE_PATH", "")
        if (p != "") { return p }
        val dir: String = Env.get("AURA_HAT_OUT", "")
        if (dir == "") { return "" }
        return dir + "/isel_probe.log"
    }

    /// Phase C **定位探针**：把当前上下文立即落盘（用于锁定内存失控点）。
    ///
    /// ⚠️ 为什么与 `PhotonPipeline.traceMark` 不同：后者把消息 append 进
    /// `traceBuf` 再**整文件重写**，成本 O(行数²)；Phase C 是每函数/每块打点，
    /// 累积式落盘本身就会成为持续分配源（正是我们要抓的病）。这里改成
    /// **有界截断**——只保留尾部 2.5KB，每次重写一个 ≤3KB 的小文件，
    /// 内存与时间都有界，同时保留最近一段历史。
    ///
    /// 与 C 运行库的拼接链探测（`AURA_CHAIN_TRIP_KB`）配合使用：链长超限时
    /// C 侧写报告并 `exit(71)`，因此本文件的**最后几行就是出事的精确上下文**
    /// （哪个函数、哪一遍、处理到第几个块 / 多少指令）。
    ///
    ///   `AURA_SEL_PROBE=1`      开启
    ///   `AURA_MEM_STATS=1`      亦开启（诊断模式连带打开，便于一次跑齐两份证据）
    ///   `AURA_SEL_PROBE_PATH`   输出文件（默认 `<AURA_HAT_OUT>/isel_probe.log`）
    private fun selProbe(msg: String): Unit {
        if (this.probePath == "") { return }
        this.probeStep = this.probeStep + 1
        this.probeBuf = this.probeBuf + "[s" + this.probeStep + "] " + msg + "\n"
        if (this.probeBuf.length > 3000) {
            this.probeBuf = this.probeBuf.substring(this.probeBuf.length - 2500)
        }
        FileUtils.writeText(this.probePath, this.probeBuf)
    }

    /// 名字是否由 Photon runtime 目标文件（`aura_runtime.obj`）提供。
    ///
    /// ⚠ 这些符号**不能**再被用户目标文件定义：链接期会 `duplicate symbol`
    ///（实测自举 `Main.aura` 的 `strlen`：用户源码里的 `strlen` 与 runtime 的
    /// `strlen` 同名，`lld-link: error: duplicate symbol: strlen`）。
    /// 与 `PhotonRuntime.RUNTIME_SYMBOLS` 必须保持同步；调用点已由
    /// `mapStdlibFuncName` 映射到这些名字，因此跳过定义不会产生 undefined symbol。
    private fun isRuntimeSymbol(name: String): Boolean {
        if (name == "") { return false }
        // P40x-b：ptr 反射三臂不并入 runtimeSymbolNames 长字面量——实测追加
        // 3 名（总长 ~730）后驱动启动即段错误（长字符串字面量发射阈值，
        // P40x-d 入档），改为内联判定。
        if (name == "ptrToInt" || name == "intToPtr" || name == "ptrIsNull") {
            return true
        }
        if (name == "IO_fileExists" || name == "Box" || name == "take"
                || name == "newChannel" || name == "channelSend" || name == "channelRecv") {
            return true
        }
        if (name == "toStrN") {
            return true
        }
        if (name == "toStrN") {
            return true
        }
        // ⚠️ 名单**必须与 `PhotonRuntime.RUNTIME_SYMBOLS` 逐字一致**。
        // 旧实现只列了 println/toStr/strlen 这一小撮，而标准库里
        // `Memory.aura` / `Collections` 的方法体同样会被编译进用户目标文件
        //（自举 `Main.aura` 实测）：
        //     lld-link: error: duplicate symbol: Memory_write
        //     >>> defined at Main.obj / aura_runtime.obj
        // 即这份名单一旦漏项，就是「链接期重复符号」，与调用点映射无关。
        //
        // 成员方法有两种拼写形态（`Collections.getAt` / `Collections_getAt`），
        // 这里把 `.` 统一成 `_` 后比较，两边都命中。
        val n: String = this.dotToUnderscore(name)
        val parts: List<String> = LirUtils.splitArgs(this.runtimeSymbolNames)
        var i: Int = 0
        while (i < parts.size) {
            if (this.dotToUnderscore(parts[i]) == n) {
                return true
            }
            i = i + 1
        }
        return false
    }

    /// 把 `.` 统一为 `_`（成员方法的两种拼写形态归一）。
    private fun dotToUnderscore(s: String): String {
        var out: String = ""
        var i: Int = 0
        val len: Int = s.length
        while (i < len) {
            if ((s.charCodeAt(i) as Int) == 46) {
                out = out + "_"
            } else {
                out = out + s.substring(i, i + 1)
            }
            i = i + 1
        }
        return out
    }

    /// 把科学计数法文本（形如 `1.5e10` / `1.2E-3`）展开为十进制文本
    /// （VM 参考：`15000000000.0` / `0.0012`）。
    ///
    /// 纯字符串算法：把 mantissa 视为整数分数，按指数位置重新摆放小数点。
    /// `expIdx` 是 e/E 在原串中的下标；mantissa 在 `[0, expIdx)`，
    /// 指数（含 +/-）在 `(expIdx, end)`。
    private fun sciNotationToDecimal(s: String, expIdx: Int): String {
        var mantText: String = s.substring(0, expIdx)
        val expText: String = s.substring(expIdx + 1)
        // 解析 mantissa 的符号
        var mantNeg: Boolean = false
        var mStart: Int = 0
        if (mantText.length > 0) {
            val mc0: Int = mantText.charCodeAt(0)
            if (mc0 == 45) { mantNeg = true; mStart = 1 }
            else if (mc0 == 43) { mStart = 1 }
        }
        // 收集 mantissa 的纯数字字符序列与小数点位置
        var digits: String = ""
        var dotAt: Int = -1  // 小数点在 digits 中的下标（若 mantissa 带小数点）
        var di: Int = mStart
        var digitsStart: Int = mStart
        while (di < mantText.length) {
            val c: Int = mantText.charCodeAt(di)
            if (c == 46) {
                // 记录小数点：位于「下一个数字字符」在 digits 中的位置
                dotAt = digits.length
                di = di + 1
            } else if (c >= 48 && c <= 57) {
                digits = digits + mantText.substring(di, di + 1)
                di = di + 1
            } else {
                di = di + 1
            }
        }
        if (digits.length == 0) { return "0.0" }
        // 解析指数
        var expNeg: Boolean = false
        var eStart: Int = 0
        if (expText.length > 0) {
            val ec0: Int = expText.charCodeAt(0)
            if (ec0 == 45) { expNeg = true; eStart = 1 }
            else if (ec0 == 43) { eStart = 1 }
        }
        var exp: Int = 0
        var ei: Int = eStart
        while (ei < expText.length) {
            val c: Int = expText.charCodeAt(ei)
            if (c >= 48 && c <= 57) { exp = exp * 10 + (c - 48) }
            ei = ei + 1
        }
        if (expNeg) { exp = -exp }
        // 有效小数点位置：在 digits 中的索引
        // 无小数点时视为 digits 末尾（如 "15" × 10^0 = 15.）
        var dotPos: Int
        if (dotAt >= 0) { dotPos = dotAt } else { dotPos = digits.length }
        // 新的小数点位置 = 原位置 + 指数
        var newDotPos: Int = dotPos + exp
        // 前导 / 后随补零
        var result: String = ""
        if (newDotPos < 0) {
            // 如 0.0012e0 展开：整数部分为 0，小数部分前补 |newDotPos| 个 0
            result = "0."
            var k: Int = 0
            while (k < -newDotPos) { result = result + "0"; k = k + 1 }
            result = result + digits
        } else if (newDotPos >= digits.length) {
            // 如 1.5e10 = 15000000000
            result = digits
            var k: Int = 0
            while (k < newDotPos - digits.length) { result = result + "0"; k = k + 1 }
        } else {
            result = digits.substring(0, newDotPos) + "." + digits.substring(newDotPos)
        }
        if (mantNeg) { result = "-" + result }
        // VM 参考：整数值浮点以 ".0" 结尾（3.14 → "3.14"、15000000000 → "15000000000.0"）
        if (result.indexOf(".") < 0) { result = result + ".0" }
        return result
    }

    /// 逗号分隔名表中是否包含指定名字。
    private fun nameInList(list: String, name: String): Boolean {
        val parts: List<String> = LirUtils.splitArgs(list)
        var i: Int = 0
        while (i < parts.size) {
            if (parts[i] == name) { return true }
            i = i + 1
        }
        return false
    }

    // ── 函数级选择 ──

    /// 选择单个函数的指令（S1.2 修复：通过 LirProgram 获取真实块）。
    fun selectFunction(func: LirFunction, src: LirProgram): Unit {
        this.funcName = func.name
        this.labelCount = 0
        this.labelNames = arrayListOf<String>()
        this.paramIndex = 0
        this.constRegCounter = 0
        this.phiPreds = ""

        // P390：**per-function vid 状态全量重置**——LIR 各函数的 ValueID 都从
        // 各自 0 起编号，而 nodeMapIds / phiClaimFrom / phiEntryMap* 按 vid
        // 索引且此前只在模块级 select() 重置 ⇒ 函数间 vid 撞号即互相串节点：
        // 实测 escapeConstValue 的 `Call __field_get(args=[getInstance, idx])`
        // 的 arg0 解析到 **Vm_loadArgsFlat 的 Mov 节点**（vid 撞号），其栈槽
        // 在本函数帧内从未写入 → field_get 内联读到栈残留 0xd0 当对象指针 →
        // `mov rax,[0xd0+堆指针*8+0x10]` 非规范地址 → #GP（崩点随布局漂移、
        // 探针「承重」的物理机制：残留值随布局变化）。2026-10-07。
        this.nodeMapIds = arrayListOf<Int>()
        this.phiClaimFrom = arrayListOf<Int>()
        this.phiClaimNode = arrayListOf<Int>()
        this.phiEntryMapIds = arrayListOf<Int>()
        this.phiEntryMapHomes = arrayListOf<Int>()
        this.phiEntryMapCnt = 0

        // 记录函数起始指令数（多函数发射时用于标记指令边界）。
        val startInstr: Int = this.dag.instrCount

        val blockCount: Int = func.blocks.size
        val traceFn: Boolean = this.traceOn && blockCount > 200
        if (traceFn) {
            println("[isel-fn] " + func.name + " blocks=" + MachineDagUtils.toStr(blockCount))
        }

        // 第一遍：分析 PHI 前驱信息（用于 PHI 消除）。
        this.selProbe("fn pass1 enter fn=" + func.name +
                " blocks=" + MachineDagUtils.toStr(blockCount))
        this.analyzePhiPreds(func, src)
        this.selProbe("fn pass1 done fn=" + func.name +
                " phiSlots=" + MachineDagUtils.toStr(this.phiMovTotal) +
                " instrs=" + MachineDagUtils.toStr(this.dag.instrCount))
        if (traceFn) {
            println("[isel-fn] " + func.name + " afterPhiPreds phiSlots=" +
                    MachineDagUtils.toStr(this.phiMovTotal) +
                    " instrs=" + MachineDagUtils.toStr(this.dag.instrCount))
        }

        // 第二遍：处理所有 Phi 节点（注册到 nodeMap，供前驱块 MOV 使用）。
        this.selProbe("fn pass2 enter fn=" + func.name)
        var bi2: Int = 0
        while (bi2 < blockCount) {
            val blockId2: Int = func.blocks[bi2]
            if (blockId2 >= 0) {
                val block2: LirBlock = src.blockOf(blockId2)
                this.selectBlockPhis(block2, src)
            }
            if (traceFn && bi2 % 100 == 0) {
                println("[isel-fn] " + func.name + " pass2 bi=" + MachineDagUtils.toStr(bi2) +
                        " instrs=" + MachineDagUtils.toStr(this.dag.instrCount))
            }
            if (bi2 % 200 == 0) {
                this.selProbe("fn pass2 bi=" + MachineDagUtils.toStr(bi2) + "/" +
                        MachineDagUtils.toStr(blockCount) +
                        " fn=" + func.name +
                        " instrs=" + MachineDagUtils.toStr(this.dag.instrCount))
            }
            bi2 = bi2 + 1
        }
        this.selProbe("fn pass2 done fn=" + func.name +
                " instrs=" + MachineDagUtils.toStr(this.dag.instrCount))

        // 第三遍：处理所有基本块（含 PHI MOVs 在终结指令之前）。
        this.selProbe("fn pass3 enter fn=" + func.name)
        var bi: Int = 0
        while (bi < blockCount) {
            val blockId: Int = func.blocks[bi]
            if (blockId >= 0) {
                val block: LirBlock = src.blockOf(blockId)
                this.selectBlock(block, src)
            }
            if (traceFn && bi % 10 == 0) {
                println("[isel-fn] " + func.name + " pass3 bi=" + MachineDagUtils.toStr(bi) +
                        " nodes=" + MachineDagUtils.toStr(this.dag.nodeCount) +
                        " instrs=" + MachineDagUtils.toStr(this.dag.instrCount))
            }
            if (bi % 200 == 0) {
                this.selProbe("fn pass3 bi=" + MachineDagUtils.toStr(bi) + "/" +
                        MachineDagUtils.toStr(blockCount) +
                        " fn=" + func.name +
                        " nodes=" + MachineDagUtils.toStr(this.dag.nodeCount) +
                        " instrs=" + MachineDagUtils.toStr(this.dag.instrCount))
            }
            bi = bi + 1
        }
        this.selProbe("fn pass3 done fn=" + func.name +
                " nodes=" + MachineDagUtils.toStr(this.dag.nodeCount) +
                " instrs=" + MachineDagUtils.toStr(this.dag.instrCount))

        // 为所有新指令打上 funcName 标记（多函数发射用）。
        var ii: Int = startInstr
        while (ii < this.dag.instrCount) {
            val instr: DagInstruction = this.dag.instrOf(ii)
            instr.funcName = this.funcName
            ii = ii + 1
        }
        this.selProbe("fn tail done fn=" + func.name +
                " instrs=" + MachineDagUtils.toStr(this.dag.instrCount))
    }

    // ── PHI 前驱分析（用于 PHI 消除）──

    /// 分析所有 PHI 节点的**前驱边块**，记录到 phiPreds。
    /// 格式：predBlockId|phiVid|incomingVid\n...
    ///
    /// ⚠️ 前驱块必须由**控制流**决定，不能取「入边值的定义块」：
    /// PHI 的 MOV 要发在「从该前驱跳到 PHI 所在块」的边上。入边值常常在
    /// 更早的块里定义（循环里尤其明显），旧实现用入边值的定义块当边块，
    /// 于是把 MOV 发到了错误的块。实测 P2/02_fibonacci：
    /// `prev = curr` 的入边值是**条件块的** curr Phi（定义块 = 条件块），
    /// MOV 因此被放到条件块开头 —— 每次迭代进入条件块时先执行 `prev = curr`，
    /// 循环体里的 `next = prev + curr` 变成 `2 * curr`，`curr` 逐次翻倍，
    /// fib_iterative(10) 输出 512（应为 55）。
    private fun analyzePhiPreds(func: LirFunction, src: LirProgram): Unit {
        this.phiPreds = ""
        val blockCount: Int = func.blocks.size
        val traceBig: Boolean = this.traceFlag() && blockCount > 200

        // ① 建立「块 → 后继块」并反转为「块 → 前驱块列表」。
        //
        // ⚠ 旧实现把「块 → 前驱」存成 `"blockId|p1,p2,\n"` 的**扁平串**，每追加
        // 一条边都调 `appendPred`：`splitFlat` 拆整表 + 逐行重拼 + 拷回 ——
        // 单次 O(块数²)，而它被每条边调用一次 ⇒ O(块数³) 并伴随同量级 `split`
        // 分配。自举 `Main.aura` 的 `emitCall`（单函数 14007 行 .hat，约 1500 块）
        // 直接吃满 12 GB 内存闸门。这里改为**按块 ID 下标的前驱槽表**：
        // 一条边一次 O(1) 追加（每个槽的前驱数很小），总代价 O(边数)。
        //
        // 块 ID 在同一函数内连续（HAT 解析器预登记 / SsaBuilder 建块均按序分配，
        // Lowering 保持同号），因此用 `[最小 ID, 最大 ID]` 作下标区间。
        var base: Int = -1
        var top: Int = -1
        var bi: Int = 0
        while (bi < blockCount) {
            val b: Int = func.blocks[bi]
            if (b >= 0) {
                if (base < 0 || b < base) { base = b }
                if (b > top) { top = b }
            }
            bi = bi + 1
        }
        if (base < 0) {
            return
        }
        // ⚠️ 2026-10-02：改用**扁平 CSR**（计数 → 前缀偏移 → 填充），不再用
        // `List<List<Int>>`——嵌套列表的内层临时对象在 AOT 重负载下实测损坏
        // （slot.size 读回指针值、随后段错误；单层 List + 算术下标读写经
        // `build/lstest*.aura` 全套探针验证可靠）。两侧仍均摊 O(1)/O(边数)。
        val slots: Int = top - base + 1
        val predCnt: List<Int> = arrayListOf<Int>()
        val predOff: List<Int> = arrayListOf<Int>()
        val predFlat: List<Int> = arrayListOf<Int>()
        this.slotInit(predCnt, slots)
        this.slotInit(predOff, slots + 1)
        // PHI-MOV 表：扁平布局（见字段说明）。
        this.phiMovBase = base
        this.phiMovTotal = 0
        this.phiEntryMapIds = arrayListOf<Int>()
        this.phiEntryMapHomes = arrayListOf<Int>()
        this.phiEntryMapCnt = 0
        var emInit: Int = 0
        while (emInit < 512) {
            this.phiEntryMapIds.add(-1)
            this.phiEntryMapHomes.add(-1)
            emInit = emInit + 1
        }
        this.phiMovFlat = arrayListOf<String>()
        this.phiMovCnt = arrayListOf<Int>()
        this.slotInit(this.phiMovCnt, slots)
        var slotIdx: Int = 0
        while (slotIdx < slots) {
            var mv: Int = 0
            while (mv < this.phiMovCap) {
                this.phiMovFlat.add("")
                mv = mv + 1
            }
            slotIdx = slotIdx + 1
        }

        // 过 ①a：统计每个后继槽的入边数。
        bi = 0
        while (bi < blockCount) {
            val bid: Int = func.blocks[bi]
            if (bid >= 0) {
                val succs: List<Int> = this.succBlocksOf(src.blockOf(bid), src)
                var si: Int = 0
                while (si < succs.size) {
                    val s: Int = succs[si]
                    if (s >= base && s <= top) {
                        val slot: Int = s - base
                        predCnt[slot] = predCnt[slot] + 1
                    }
                    si = si + 1
                }
            }
            bi = bi + 1
        }

        // 过 ①b：前缀和 → predOff；predFlat 按总边数定容。
        var acc: Int = 0
        slotIdx = 0
        while (slotIdx < slots) {
            predOff[slotIdx] = acc
            acc = acc + predCnt[slotIdx]
            slotIdx = slotIdx + 1
        }
        predOff[slots] = acc
        slotIdx = 0
        while (slotIdx < acc) {
            predFlat.add(0)
            slotIdx = slotIdx + 1
        }
        // 填充指针 = predOff 的工作副本。
        val fill: List<Int> = arrayListOf<Int>()
        slotIdx = 0
        while (slotIdx <= slots) {
            fill.add(predOff[slotIdx])
            slotIdx = slotIdx + 1
        }

        // 过 ①c：按填充指针写入前驱。
        bi = 0
        while (bi < blockCount) {
            val bid: Int = func.blocks[bi]
            if (bid >= 0) {
                val succs: List<Int> = this.succBlocksOf(src.blockOf(bid), src)
                var si: Int = 0
                while (si < succs.size) {
                    val s: Int = succs[si]
                    if (s >= base && s <= top) {
                        val slot2: Int = s - base
                        val pos: Int = fill[slot2]
                        predFlat[pos] = bid
                        fill[slot2] = pos + 1
                    }
                    si = si + 1
                }
            }
            bi = bi + 1
        }
        // ── pass1.5：计算每个块的**传递前驱闭包**（位集，按 slots/64 字打包）。
        //
        // ⚠️ 2026-10-05：phi 入边值的定义块往往是目标的**间接**前驱
        //（如 if/循环汇流：值定义于 bb2597，phi 在 bb2601，中间隔
        // bb2599/bb2600 两个纯跳转块）。pass② 的「定义块 == 直接前驱」
        // 精确匹配因此永远失配 ⇒ 全部落 (b) 兜底乱配 ⇒ 入口 MOV 装错值
        //（实测 runner 读循环 buf=0/count=0 ⇒ ReadFile 读 0 字节）。
        // 闭包 = 反复沿直接前驱边扩张到不动点（迭代法，位集用 Int 数组，
        // 每 32 块一个 Int）。
        val wordsPer: Int = (slots + 31) / 32
        if (wordsPer > 0) {
            var closeArr: List<Int> = arrayListOf<Int>()
            var wInit: Int = 0
            var totalWords: Int = wordsPer * slots
            while (wInit < totalWords) {
                closeArr.add(0)
                wInit = wInit + 1
            }
            // 初始化：直接前驱边
            var bi1: Int = 0
            while (bi1 < blockCount) {
                val b1: Int = func.blocks[bi1]
                if (b1 >= base && b1 <= top) {
                    val sLo: Int = predOff[b1 - base]
                    val sHi: Int = predOff[b1 - base + 1]
                    var si1: Int = sLo
                    while (si1 < sHi) {
                        val p1: Int = predFlat[si1]
                        if (p1 >= base && p1 <= top) {
                            val slotP: Int = p1 - base
                            closeArr[b1 * wordsPer + slotP / 32] =
                                closeArr[b1 * wordsPer + slotP / 32] or (1 << (slotP % 32))
                        }
                        si1 = si1 + 1
                    }
                }
                bi1 = bi1 + 1
            }
            // 不动点迭代：pred 的闭包并入 succ 的闭包（沿直接前驱边反向传播）
            var changed: Boolean = true
            var rounds: Int = 0
            while (changed && rounds < 64) {
                changed = false
                rounds = rounds + 1
                var bi2: Int = 0
                while (bi2 < blockCount) {
                    val b2: Int = func.blocks[bi2]
                    if (b2 >= base && b2 <= top) {
                        val sLo2: Int = predOff[b2 - base]
                        val sHi2: Int = predOff[b2 - base + 1]
                        var si2: Int = sLo2
                        while (si2 < sHi2) {
                            val p2: Int = predFlat[si2]
                            if (p2 >= base && p2 <= top) {
                                // close[b2] |= close[p2]
                                var w: Int = 0
                                while (w < wordsPer) {
                                    val oldW: Int = closeArr[b2 * wordsPer + w]
                                    val newW: Int = oldW or closeArr[p2 * wordsPer + w]
                                    if (newW != oldW) {
                                        closeArr[b2 * wordsPer + w] = newW
                                        changed = true
                                    }
                                    w = w + 1
                                }
                            }
                            si2 = si2 + 1
                        }
                    }
                    bi2 = bi2 + 1
                }
            }
            this.predClosure = closeArr
            this.predClosureWords = wordsPer
        } else {
            this.predClosure = arrayListOf<Int>()
            this.predClosureWords = 0
        }
        // P382：支配集（与 predClosure 同构位集，**交集**语义）。
        // dom[b] = {b} ∪ ⋂_{p ∈ 直接前驱} dom[p]；def ∈ dom[pred] ⇔ def
        // 支配 pred ⇒ 入边值在该边必然存活，PHI-MOV 才健全。
        // （旧 (a2) 用可达闭包：def 可达 pred 只说明**存在**路径经过 def，
        // 其他路径上值未定义 ⇒ MOV 写陈旧值 = 逐调用点值腐坏的机制之一。）
        if (wordsPer > 0 && blockCount > 0) {
            var dArr: List<Int> = arrayListOf<Int>()
            var dInit: Int = 0
            val dTotal: Int = wordsPer * slots
            while (dInit < dTotal) {
                dArr.add(-1)
                dInit = dInit + 1
            }
            // 入口 = 首块：dom = {自身}
            val entryB: Int = func.blocks[0]
            if (entryB >= base && entryB <= top) {
                val slotE: Int = entryB - base
                dArr[entryB * wordsPer + slotE / 32] =
                    dArr[entryB * wordsPer + slotE / 32] or (1 << (slotE % 32))
            }
            // 不动点：对非入口块，dom[b] = {b} ∪ ⋂ dom[直接前驱]
            var dChanged: Boolean = true
            var dRounds: Int = 0
            while (dChanged && dRounds < 64) {
                dChanged = false
                dRounds = dRounds + 1
                var bi4: Int = 0
                while (bi4 < blockCount) {
                    val b4: Int = func.blocks[bi4]
                    if (b4 >= base && b4 <= top && b4 != entryB) {
                        val sLo4: Int = predOff[b4 - base]
                        val sHi4: Int = predOff[b4 - base + 1]
                        if (sHi4 > sLo4) {
                            // dAcc = ⋂ dom[直接前驱]（首前驱起全 1 初值）
                            // ⚠️ 本函数上方已有 `var acc: Int`（predOff 计数）——
                            // 同函数同名异型会触发 seed 裸名/槽复用家族缺陷，故用 dAcc。
                            var dAcc: List<Int> = arrayListOf<Int>()
                            var wA: Int = 0
                            while (wA < wordsPer) { dAcc.add(-1); wA = wA + 1 }
                            var si4: Int = sLo4
                            var pCount: Int = 0
                            while (si4 < sHi4) {
                                val p4: Int = predFlat[si4]
                                if (p4 >= base && p4 <= top) {
                                    var w4: Int = 0
                                    while (w4 < wordsPer) {
                                        dAcc[w4] = dAcc[w4] and dArr[p4 * wordsPer + w4]
                                        w4 = w4 + 1
                                    }
                                    pCount = pCount + 1
                                }
                                si4 = si4 + 1
                            }
                            if (pCount > 0) {
                                var w5: Int = 0
                                var dBl: Boolean = false
                                while (w5 < wordsPer) {
                                    val newW: Int = dAcc[w5] or (1 << ((b4 - base) % 32))
                                    if (dArr[b4 * wordsPer + w5] != newW) {
                                        dArr[b4 * wordsPer + w5] = newW
                                        dBl = true
                                    }
                                    w5 = w5 + 1
                                }
                                if (dBl) { dChanged = true }
                            }
                        }
                    }
                    bi4 = bi4 + 1
                }
            }
            this.domSet = dArr
            this.domWords = wordsPer
            this.domBase = base
        } else {
            this.domSet = arrayListOf<Int>()
            this.domWords = 0
            this.domBase = 0
        }
        if (traceBig) {
            println("[isel-phi] " + func.name + " pass1 done base=" + LirUtils.toStr(base) +
                    " top=" + LirUtils.toStr(top))
        }
        this.selProbe("phi pass1 done fn=" + func.name +
                " base=" + LirUtils.toStr(base) + " top=" + LirUtils.toStr(top) +
                " edges=" + MachineDagUtils.toStr(acc))

        // ② 为每个 PHI 的每条入边确定「边块」：先按定义块精确匹配，
        //    未能匹配的入边值按顺序分配给剩余前驱。
        bi = 0
        while (bi < blockCount) {
            val blockId: Int = func.blocks[bi]
            if (traceBig && bi % 25 == 0) {
                println("[isel-phi] " + func.name + " pass2 bi=" + LirUtils.toStr(bi) +
                        " phiSlots=" + LirUtils.toStr(this.phiMovTotal))
            }
            if (bi % 250 == 0) {
                this.selProbe("phi pass2 bi=" + MachineDagUtils.toStr(bi) + "/" +
                        MachineDagUtils.toStr(blockCount) + " fn=" + func.name)
            }
            if (blockId >= 0) {
                val block: LirBlock = src.blockOf(blockId)
                // 该块的前驱区间 [pLo, pHi)（CSR）。
                var pLo: Int = 0
                var pHi: Int = 0
                if (blockId >= base && blockId <= top) {
                    pLo = predOff[blockId - base]
                    pHi = predOff[blockId - base + 1]
                }
                val phiParts: List<Int> = block.phis
                var pi: Int = 0
                while (pi < phiParts.size) {
                    val phiVid: Int = phiParts[pi]
                    if (phiVid >= 0) {
                        val phiVal: LirValue = src.valueOf(phiVid)
                        val incoming: List<Int> = phiVal.args
                        // 「已使用的入边值」标记表：按下标标记（O(1) 判定）。
                        //
                        // ⚠️ 旧实现用 `usedIdx = usedIdx + toStr(pick) + ","` 这个
                        // `s = s + x` 累加器，并靠 `flatContains(usedIdx, …)` 查表，
                        // 而 `flatContains` 每次都要 `usedIdx.split(",")` **整段
                        // 重新分配一个 List + 全部子串**。它在
                        // 「块 × PHI × 前驱 × 入边」四层循环的最内层被调用，
                        // 自举 `Main.aura` 的循环函数里 PHI 的入边可达上百条，
                        // 于是这一步单独就产生千万次小串分配（Phase C 的
                        // `<=64B` 桶 1190 万次 / 119MB 主要来源）。改成标记表后
                        // 两侧都是 O(1) 且零分配。
                        // ⚠️ 两段式匹配（2026-10-04）：先对**所有**前驱做
                        // 「定义块精确匹配」(a)，全部完成后才对未命中的前驱做
                        // 「首个未使用」兜底 (b)。旧实现单遍逐前驱贪心：兜底会
                        // 把**后面前驱的精确匹配入边提前抢走**——当 PHI 入边的
                        // 记录顺序与前驱顺序不一致时（SSA 构建序 ≠ 前驱序，常态），
                        // 两个前驱双双错配 ⇒ 循环携带变量（cap/ok 等）初值 MOV
                        // 落到错误入口（实测 VM runner readFileToBuffer 的 cap：
                        // 65536 分到回边 ⇒ cap=0 ⇒ ReadFile(count=0) 无限循环；
                        // probe_obj3 的 ok 标志 COPY-BAD，2026-10-04）。
                        // ⚠️ `used[ai]` 必须先取出到 Int 局部再比较（rust AOT 下
                        // 下标表达式直写比较被判假，见旧注释）。
                        val incomingN: Int = incoming.size
                        val predN: Int = pHi - pLo
                        val used: List<Int> = arrayListOf<Int>()
                        val pickOfPred: List<Int> = arrayListOf<Int>()
                        var u0: Int = 0
                        while (u0 < incomingN) {
                            used.add(0)
                            u0 = u0 + 1
                        }
                        var r0: Int = 0
                        while (r0 < predN) {
                            pickOfPred.add(-1)
                            r0 = r0 + 1
                        }
                        // (a0) ⚠️ P228 精确配边：Lowering 把 MIR 的 `pred:vid`
                        // 入边旁路记入 `lir.phiPredMap`（`phiVid|p1:vid1,...`）。
                        // 有旁路记录的入边**按前驱块精确命中**——取代下方
                        // 定义块/传递闭包/尾兜底启发式链（该链在多分支汇合时
                        // 错配：实测 decodeNumeric 的 name/a0/a1 串值互相串块，
                        // 迭代 1 的 name 泄漏进迭代 2 → strcat(乱码)）。
                        // ⚠️ P229 重新启用：P228 的垃圾入边根因是 lowerFunction
                        // 178 行 Phi 拦截点漏剥（非本段缺陷）——剥对已补，见
                        // Lowering.aura。pmAdd 值恢复纯净后本段生效。
                        var predMapIdx: Int = this.phiPredFind(src, phiVid)
                        if (predMapIdx >= 0 && incomingN == predN) {
                            val pairs: List<String> = this.phiPredPairs(predMapIdx)
                            var ai9: Int = 0
                            while (ai9 < pairs.size && ai9 < incomingN) {
                                val seg: String = pairs[ai9]
                                var colon2: Int = -1
                                var qi9: Int = 0
                                while (qi9 < seg.length) {
                                    if ((seg.charCodeAt(qi9) as Int) == 58) {
                                        colon2 = qi9
                                        qi9 = seg.length
                                    }
                                    qi9 = qi9 + 1
                                }
                                if (colon2 > 0) {
                                    val predP: Int = LirUtils.strToInt(seg.substring(0, colon2))
                                    val vidP: Int = LirUtils.strToInt(seg.substring(colon2 + 1, seg.length))
                                    if (predP >= 0) {
                                        var rk9: Int = 0
                                        while (rk9 < predN) {
                                            if (predFlat[pLo + rk9] == predP) {
                                                if (pickOfPred[rk9] < 0) {
                                                    pickOfPred[rk9] = ai9
                                                    used[ai9] = 1
                                                }
                                                rk9 = predN
                                            }
                                            rk9 = rk9 + 1
                                        }
                                    }
                                }
                                ai9 = ai9 + 1
                            }
                        }
                        // (a1) 严格匹配：入边值**定义块 == 前驱块本身**。
                        // 必须先于 (a2) 对**所有**前驱整体跑一遍：传递闭包经
                        // 循环回边会把循环内**所有**块连成一家（closure(218)
                        // ⊇ {211,212,213,217,…}），若直接按闭包匹配，continue
                        // 前驱会按 args 顺序抢走 before(入口值)（实测
                        // probe_cont_min：218 ← before ⇒ i/total 恒 0）。
                        // continue Mov（def=continue 块）与 bodyEnd（def=latch）
                        // 在严格层必然命中，轮不到闭包层。
                        var ri: Int = 0
                        while (ri < predN) {
                            val predB: Int = predFlat[pLo + ri]
                            var ai: Int = 0
                            while (ai < incomingN) {
                                val usedAi: Int = used[ai]
                                if (usedAi == 0) {
                                    val iv: Int = incoming[ai]
                                    if (iv >= 0 && src.valueOf(iv).block == predB) {
                                        pickOfPred[ri] = ai
                                        used[ai] = 1
                                        // 记录 (phi → 入口边值) 配对（首个命中的边）
                                        var seen: Boolean = false
                                        var si3: Int = 0
                                        while (si3 < this.phiEntryMapCnt) {
                                            if (this.phiEntryMapIds[si3] == phiVid) {
                                                seen = true
                                            }
                                            si3 = si3 + 1
                                        }
                                        if (seen == false && this.phiEntryMapIds.size > this.phiEntryMapCnt) {
                                            this.phiEntryMapIds[this.phiEntryMapCnt] = phiVid
                                            this.phiEntryMapHomes[this.phiEntryMapCnt] = iv
                                            this.phiEntryMapCnt = this.phiEntryMapCnt + 1
                                        }
                                        break
                                    }
                                }
                                ai = ai + 1
                            }
                            ri = ri + 1
                        }
                        // (a2) 传递闭包匹配：仍未命中的前驱，入边值定义块 ∈
                        // 其传递前驱闭包（if/汇流块分隔的间接定义者）。
                        var ri2: Int = 0
                        while (ri2 < predN) {
                            if (pickOfPred[ri2] < 0) {
                                val predB2: Int = predFlat[pLo + ri2]
                                var ai2: Int = 0
                                while (ai2 < incomingN) {
                                    val usedAi2: Int = used[ai2]
                                    if (usedAi2 == 0) {
                                        val iv2: Int = incoming[ai2]
                                    if (iv2 >= 0 && this.isDominating(
                                            src.valueOf(iv2).block, predB2)) {
                                            pickOfPred[ri2] = ai2
                                            used[ai2] = 1
                                            var seen2: Boolean = false
                                            var si4: Int = 0
                                            while (si4 < this.phiEntryMapCnt) {
                                                if (this.phiEntryMapIds[si4] == phiVid) {
                                                    seen2 = true
                                                }
                                                si4 = si4 + 1
                                            }
                                            if (seen2 == false && this.phiEntryMapIds.size > this.phiEntryMapCnt) {
                                                this.phiEntryMapIds[this.phiEntryMapCnt] = phiVid
                                                this.phiEntryMapHomes[this.phiEntryMapCnt] = iv2
                                                this.phiEntryMapCnt = this.phiEntryMapCnt + 1
                                            }
                                            break
                                        }
                                    }
                                    ai2 = ai2 + 1
                                }
                            }
                            ri2 = ri2 + 1
                        }
                        // (b) P330：**删除强制兜底**。旧实现把「剩余入边值」从尾部
                        // 强行配给未匹配前驱——当 phi 入参数 ≠ 实际前驱数（SSA
                        // 构建期的 continue 边丢失/陈旧 latch 标签，常态）时，
                        // 这会把**不相干路径的陈旧值**写进 phi 家槽：实测
                        // decodeNumeric 循环 phi 17 入参 vs 18 实际前驱，(b) 把
                        // 孤儿 latch 值配给 op==0 臂 → 每轮 count/offset 被
                        // 重置（decoded 恒 1/2，flat 塌缩）。
                        // 正确语义：未匹配前驱 = 该路径**未赋值**该循环变量 ⇒
                        // phi 取上一轮值 = 家槽现内容 ⇒ **不发 MOV** 即正确。
                        var rj: Int = 0
                        while (rj < predN) {
                            if (pickOfPred[rj] < 0) {
                                if (this.phiDiagOn && this.phiDiagMissing < 40) {
                                    this.phiDiagMissing = this.phiDiagMissing + 1
                                    println("[phi-nomov] fn=" + this.funcName
                                            + " pred=" + MachineDagUtils.toStr(predFlat[pLo + rj])
                                            + " phi=" + MachineDagUtils.toStr(phiVid))
                                }
                            }
                            rj = rj + 1
                        }
                        // 登记 PHI-MOV
                        var rk: Int = 0
                        while (rk < predN) {
                            val pk: Int = pickOfPred[rk]
                            if (pk >= 0) {
                                val predB2: Int = predFlat[pLo + rk]
                                val pickVid: Int = incoming[pk]
                                this.phiMovAdd(predB2, phiVid, pickVid)
                            }
                            rk = rk + 1
                        }
                    }
                    pi = pi + 1
                }
            }
            bi = bi + 1
        }
    }

    /// 在 `lir.phiPredMap` 中找 phi 的旁路记录下标（记录序），无则 -1。
    /// 逐字符扫描（禁带 from 的 indexOf，红线②）。
    private fun phiPredFind(src: LirProgram, phiVid: Int): Int {
        if (this.lir == null) { return -1 }
        val map: String = this.lir.phiPredMap
        if (map == "") { return -1 }
        val want: String = LirUtils.toStr(phiVid)
        var pos: Int = 0
        var segStart: Int = 0
        val len: Int = map.length
        while (pos <= len) {
            if (pos == len || (map.charCodeAt(pos) as Int) == 59) {
                if (pos > segStart) {
                    val rec: String = map.substring(segStart, pos)
                    // rec = "phiVid|p1:vid1,..."
                    var bar: Int = -1
                    var qi: Int = 0
                    while (qi < rec.length) {
                        if ((rec.charCodeAt(qi) as Int) == 124) {
                            bar = qi
                            qi = rec.length
                        }
                        qi = qi + 1
                    }
                    if (bar > 0 && rec.substring(0, bar) == want) {
                        return segStart
                    }
                }
                segStart = pos + 1
            }
            pos = pos + 1
        }
        return -1
    }

    /// 取 `phiPredFind` 命中记录的 `p:vid` 对列表。
    private fun phiPredPairs(recStart: Int): List<String> {
        val map: String = this.lir.phiPredMap
        var bar: Int = -1
        var qi: Int = recStart
        val len: Int = map.length
        while (qi < len) {
            if ((map.charCodeAt(qi) as Int) == 124) {
                bar = qi
                qi = len
            }
            qi = qi + 1
        }
        var endPos: Int = len
        var ej: Int = bar + 1
        while (ej < len) {
            if ((map.charCodeAt(ej) as Int) == 59) {
                endPos = ej
                ej = len
            }
            ej = ej + 1
        }
        val body: String = map.substring(bar + 1, endPos)
        val out: List<String> = arrayListOf<String>()
        var pos: Int = 0
        var start: Int = 0
        while (pos <= body.length) {
            if (pos == body.length || (body.charCodeAt(pos) as Int) == 44) {
                if (pos > start) {
                    out.add(body.substring(start, pos))
                }
                start = pos + 1
            }
            pos = pos + 1
        }
        return out
    }

    /// 取块的终结指令对应的后继块列表。
    private fun succBlocksOf(block: LirBlock, src: LirProgram): List<Int> {
        if (block.term < 0) { return emptyList() }
        val v: LirValue = src.valueOf(block.term)
        if (v.op == "Br" || v.op == "Switch") {
            return v.args
        }
        if (v.op == "CondBr") {
            // CondBr args = [cond, thenBlock, elseBlock?] —— 跳过 cond。
            if (v.args.size >= 3) {
                val thenId: Int = v.args[1]
                val elseId: Int = v.args[2]
                val two: List<Int> = arrayListOf<Int>()
                two.add(thenId)
                two.add(elseId)
                return two
            }
            if (v.args.size >= 2) {
                val thenId2: Int = v.args[1]
                val one: List<Int> = arrayListOf<Int>()
                one.add(thenId2)
                return one
            }
        }
        return emptyList()
    }

    /// RA 之后的 phi-home 合并（2026-10-05）：
    /// phi 节点被 RA 分到独立 home（寄存器/槽），但其 MOV 只在**前驱块末尾**
    /// 发射——入口边 MOV 在循环头前执行 ✓；问题在于【其它路径读取 phi 时
    /// 读到 phi 自己的 home（未写入）】。合并方案：把 phi 节点的 home 改写为
    /// 「入口边 incoming 节点」的 home —— 两者共享寄存器/槽后，MOV 仍维护
    /// 值的正确流动，而其它读取也命中同一 home。
    /// 由 Pipeline 在 allocate(dag) 之后调用。
    fun mergePhiHomesAfterRA(): Unit {
        var i: Int = 0
        while (i < this.phiEntryMapCnt) {
            val phiLir: Int = this.phiEntryMapIds[i]
            val incLir: Int = this.phiEntryMapHomes[i]
            if (phiLir >= 0 && incLir >= 0) {
                val phiDag: Int = this.lookupNode(phiLir)
                val incDag: Int = this.lookupNode(incLir)
                if (phiDag >= 0 && incDag >= 0) {
                    val phiNode: DagNode = this.dag.nodeOf(phiDag)
                    val incNode: DagNode = this.dag.nodeOf(incDag)
                    // ⚠️ 只合并「真实存储 home」的入边：**Const 入边必须跳过**。
                    // 大常量（如 65536）经 emitConst 物化成「mov-abs 进寄存器」
                    // 节点、带 reg；把 phi 的 home 改写到该寄存器 = 把循环携带
                    // 变量钉在**易失寄存器**上 —— 入口 MOV 写的是 phi 原有
                    // home，读取却走寄存器 ⇒ 任何 call 后读到残渣（实测 VM
                    // runner 读循环 cap=65536 初值变 0：FileOps.read 的
                    // count=cap-total=0，2026-10-06）。小常量（0-3）作为内联
                    // 立即数无 reg，本就不触发合并——所以探针矩阵全绿。
                    if (incNode.reg != "" && incNode.kind != "Const") {
                        phiNode.reg = incNode.reg
                    }
                }
            }
            i = i + 1
        }
    }

    /// 扁平逗号串是否包含指定 token。
    private fun flatContains(flat: String, token: String): Boolean {
        if (flat == "") { return false }
        val parts: List<String> = flat.split(",")
        var i: Int = 0
        while (i < parts.size) {
            if (parts[i] == token) { return true }
            i = i + 1
        }
        return false
    }

    // ── 块级选择 ──

    /// 选择单个基本块的指令。
    fun selectBlock(block: LirBlock, src: LirProgram): Unit {
        // 为该块创建本地标签。
        //
        // ⚠️ 标签名必须由**全局唯一的块 ID** 决定，不能用 `labelCount` 计数器：
        // 生成终结指令（如 CondBr/Br）时，目标块尚未 `selectBlock`，于是
        // `lookupLabel` 只能走 fallback（`"bb"+blockId`）。若 `selectBlock`
        // 用计数器命名，前向跳转的标签名（bb<id>）与真正发射的标签名
        // （bb<count>）就会不一致 → `labelOffset` 返回 -1 → `resolveLabels`
        // 提前返回 false → **所有**跳转保持 disp=0（两分支都执行）。
        // 用块 ID 命名同时消除了跨函数重名（每个函数的计数器都从 0 开始）。
        val label: String = "bb" + MachineDagUtils.toStr(block.id)
        this.registerLabel(block.id, label)
        this.labelCount = this.labelCount + 1

        // **发射块标签指令**（template="label"）。
        this.dag.addInstr("label", label, -1, 0, "", "", "")

        // 处理普通指令。
        var ii: Int = 0
        while (ii < block.instrs.size) {
            val vid: Int = block.instrs[ii]
            if (vid >= 0) {
                this.selectValue(vid, block.id, src)
            }
            ii = ii + 1
        }

        // PHI 消除：在本块末尾（终结指令之前）发射前驱 MOV。
        // 对于以本块为前驱的每个 PHI 节点，插入 MOV phi_node, incoming_node。
        this.emitPhiMovsForBlock(block.id)

        // 处理终结指令。
        if (this.traceOn) {
            println("    [IS] selectBlock term=" + toStr(block.term) + " instrs=" + block.instrs)
        }
        if (block.term >= 0) {
            this.selectValue(block.term, block.id, src)
        }
    }

    /// 第二遍处理：仅处理块中的 Phi 节点。
    fun selectBlockPhis(block: LirBlock, src: LirProgram): Unit {
        var pi: Int = 0
        while (pi < block.phis.size) {
            val vid: Int = block.phis[pi]
            if (vid >= 0) {
                this.selectValue(vid, block.id, src)
            }
            pi = pi + 1
        }
    }

    /// 用 `.add` 把 Int 列表填 n 个 0（扁平表的初始化原语）。
    private fun slotInit(list: List<Int>, n: Int): Unit {
        var i: Int = 0
        while (i < n) {
            list.add(0)
            i = i + 1
        }
    }

    /// 登记一条 PHI-MOV（边块 `blockId` 末尾：`phiVid <- incomingVid`）。
    /// O(1) 写入扁平表槽位（旧写法整段字符串拷贝，单块多 PHI 时 O(n²)）。
    private fun phiMovAdd(blockId: Int, phiVid: Int, incomingVid: Int): Unit {
        val idx: Int = blockId - this.phiMovBase
        if (idx < 0 || idx >= this.phiMovCnt.size) { return }
        val cnt: Int = this.phiMovCnt[idx]
        // ⚠️ 2026-10-04：超容（≥32 条 PHI-MOV）旧实现**静默丢弃** ⇒ 该块的
        // 循环携带变量（cap/ok 等）初值 MOV 丢失 ⇒ 读到 0/垃圾（实测 VM
        // runner 的 readFileToBuffer：cap=65536 丢失 → ReadFile(count=0)
        // 无限循环；probe_obj3 的 ok 标志同理）。改为：超容时**翻倍扩容**
        // 重建扁平表（保留全部已有记录）。
        if (cnt >= this.phiMovCap) {
            val newCap: Int = this.phiMovCap * 2
            val newFlat: List<String> = arrayListOf<String>()
            var bi2: Int = 0
            while (bi2 < this.phiMovCnt.size) {
                var k2: Int = 0
                while (k2 < this.phiMovCap) {
                    newFlat.add(this.phiMovFlat[bi2 * this.phiMovCap + k2])
                    k2 = k2 + 1
                }
                var pad: Int = this.phiMovCap
                while (pad < newCap) {
                    newFlat.add("")
                    pad = pad + 1
                }
                bi2 = bi2 + 1
            }
            this.phiMovFlat = newFlat
            this.phiMovCap = newCap
        }
        this.phiMovFlat[idx * this.phiMovCap + cnt] =
            MachineDagUtils.toStr(phiVid) + "," + MachineDagUtils.toStr(incomingVid)
        this.phiMovCnt[idx] = cnt + 1
        this.phiMovTotal = this.phiMovTotal + 1
    }

    /// 为指定块发射 PHI 前驱 MOV 指令。
    /// 在块末尾（终结指令之前）插入 MOV phi_node, incoming_node。
    private fun emitPhiMovsForBlock(blockId: Int): Unit {
        val idx: Int = blockId - this.phiMovBase
        if (idx < 0 || idx >= this.phiMovCnt.size) { return }
        val cnt: Int = this.phiMovCnt[idx]
        if (cnt == 0) { return }
        var i: Int = 0
        while (i < cnt) {
            val rec: String = this.phiMovFlat[idx * this.phiMovCap + i]
            if (rec != "") {
                val parts: List<String> = this.splitFlat(rec, ",")
                if (parts.size >= 2) {
                    val phiVid: Int = LirUtils.strToInt(parts[0])
                    val incomingVid: Int = LirUtils.strToInt(parts[1])
                    var phiNode: Int = this.lookupNode(phiVid)
                    var incomingNode: Int = this.lookupNode(incomingVid)
                    // ⚠️ 2026-10-05：节点未注册（-1）时旧实现**静默跳过**该 MOV
                    // ⇒ 循环携带变量的入口值丢失（实测 runner 读循环 cap=0/
                    // buf=0：`cap = 65536` 的入口 MOV 整条蒸发，[FR] buf=0
                    // count=0 ⇒ ReadFile 读 0 字节 ⇒ cannot read file）。
                    // 修复：缺失的 phi/incoming **就地发射**（selectValue 幂等，
                    // 注册后不会重复发射）——MOV 到达顺序不再依赖第二遍。
                    if (phiNode < 0) {
                        phiNode = this.selectValue(phiVid, blockId, this.lir)
                    }
                    if (incomingNode < 0) {
                        incomingNode = this.selectValue(incomingVid, blockId, this.lir)
                    }
                    if (this.phiDiagOn) {
                        if (phiNode < 0 || incomingNode < 0) {
                            this.phiDiagMissing = this.phiDiagMissing + 1
                        } else {
                            this.phiDiagEmitted = this.phiDiagEmitted + 1
                        }
                    }
                    if (phiNode >= 0 && incomingNode >= 0) {
                        // MOV phi_node, incoming_node（pattern 7）。
                        //
                        // ⚠️ pattern 7 的约定是 `nodes[0] = src`、`output = dst`
                        //（见 emitArith / emitMovRR）。旧实现把 phiNode 放在
                        // nodes[0] 且 output 也是 phiNode → 编出 `mov phi, phi`
                        // 自拷贝（反汇编里的 `movq %rax, %rax`），循环变量永远
                        // 不更新 → 死循环/崩溃。
                        this.dag.selectPattern(7, MachineDagUtils.toStr(incomingNode), phiNode)
                    }
                }
            }
            i = i + 1
        }
    }

    /// 按分隔符拆分字符串（避免 VM arrayListOf+add bug）。
    private fun splitFlat(text: String, sep: String): List<String> {
        if (text == "") { return emptyList() }
        return text.split(sep)
    }

    /// 整数转字符串。
    private fun intToStr(n: Int): String {
        return MachineDagUtils.toStr(n)
    }

    // ── 值级选择（核心 S1.3 修复）──

    /// 选择单个 LIR 值的指令（S1.3 修复：按 op 分派）。
    fun selectInstr(val: LirValue): Int {
        if (this.lir == null) { return -1 }
        return this.selectValue(val.id, val.block, this.lir)
    }

    /// 选择指定 ID 的 LIR 值（通过 LirProgram 查询真实 LirValue）。
    private fun selectValue(vid: Int, blockId: Int, src: LirProgram): Int {
        // 先查映射：如果已经处理过，直接返回。
        val mapped: Int = this.lookupNode(vid)
        if (mapped >= 0) {
            return mapped
        }

        // 从 LIR 程序获取真实值节点。
        val val: LirValue = src.valueOf(vid)
        val op: String = val.op

        // ── Memory chain 传递 ──
        // 如果 LIR 值有 chain ID，更新 curChain 以强制内存操作顺序。
        if (val.chain >= 0) {
            this.curChain = val.chain
        }

        // ── MemToken（内存依赖链令牌，不发射任何指令）──
        if (op == "MemToken" || val.aux == "entry_mem" || val.aux == "mem_after_store") {
            val memNodeId: Int = this.dag.addNode("Value", "MemToken", val.type,
                                                  "", "", "", this.curChain, "")
            this.registerNode(vid, memNodeId)
            return memNodeId
        }

        // ── 常量 ──
        if (op == "Const" || op == "ConstImm") {
            return this.emitConst(val, vid)
        }

        // ── 参数（从 Windows x64 ABI 寄存器加载）──
        if (op == "Param") {
            return this.emitParam(val, vid)
        }

        // ── Phi 节点（S1 简化：取第一个入边值）──
        if (op == "Phi") {
            return this.emitPhi(val, vid)
        }

        // ── 整数算术运算 ──
        if (op == "Add" || op == "Sub" || op == "Mul"
            || op == "SDiv" || op == "SRem"
            || op == "And" || op == "Or" || op == "Xor"
            || op == "Shl" || op == "Shr") {
            return this.emitArith(val, vid)
        }

        // ── 浮点运算 ──
        if (op == "AddF" || op == "SubF" || op == "MulF" || op == "DivF") {
            return this.emitArith(val, vid)
        }

        // ── 内存操作 ──
        if (op == "Load" || op == "LoadPtr") {
            return this.emitLoad(val, vid)
        }
        if (op == "Store" || op == "StorePtr") {
            return this.emitStore(val, vid)
        }

        // ── 地址计算 ──
        if (op == "Gep" || op == "AddImm" || op == "SubImm"
            || op == "AddReg" || op == "SubReg") {
            return this.emitAddrMode(val, vid)
        }

        // ── 数据移动 ──
        if (op == "Mov" || op == "Mov64") {
            return this.emitMovValue(val, vid)
        }

        // ── 逻辑非：!x ≡ (x == 0) ──
        //
        // ⚠️ 旧实现 Not 不在**任何**分派里：节点照常登记 home（CondBr/后续
        // 读取都按 home 取），但没有任何指令写它 ⇒ 读到的是未初始化槽。
        // 实测（2026-10-06，反汇编实证）：runner 装载 .auc 的
        // `!reader.readFromFile(path)` —— call 后返回值存 -0x50(%rbp)，
        // 紧随其后的分支却 `cmpq $0x0, -0x58(%rbp)` 读**另一个槽**的残渣
        // ⇒ 恒走 error 分支，.auc 装载通道整个被它封死。
        // 修复：cmp src, 0 + sete（ZeroFlag = (x==0)），与 emitCmpSetcc
        // Case-1 的「streq 结果与 0 比较」同一发射形态。
        if (op == "Not") {
            val notSrc: Int = this.resolveNode(val.args[0])
            this.dag.selectPattern(20, MachineDagUtils.toStr(notSrc) + ",0", -1)
            val notNode: Int = this.dag.addNode("Value", "ICmpEq", val.type,
                                                "", "", "", this.curChain, "ICmpEq")
            this.registerNode(vid, notNode)
            val notSetcc: Int = this.dag.selectPattern(40,
                              MachineDagUtils.toStr(notNode), notNode)
            val notInstr: DagInstruction = this.dag.instrOf(notSetcc)
            notInstr.cond = "e"
            return notNode
        }

        // ── 一元负号：Neg x ≡ 0 - x ──
        //
        // ⚠️ 旧实现 Neg 不在**任何**分派里：落到默认 Value 节点且 **args 整体
        // 丢弃** ⇒ 没有任何指令写 home ⇒ 读者拿到未初始化槽的残渣。
        // 实测（2026-10-06，P222 值模型探针）：`toStr(-1)` 打印 `1`、
        // `return -v`（v=7）原样返回 `7` —— 字面量与变量上的负号全部静默
        // 丢失，VM 解释器所有 `return -1` 错误哨兵变正，错误检查整体失效。
        //
        // ⚠️ 实现必须用 **xor dst,dst + sub dst,src**，不能「mov dst, 0常量节点
        // + sub」：DAG 内现造的 Const 节点没有自己的物化指令（emitConst 的常量
        // 才有 pattern-6 `mov reg, imm` 跟随），RA 会把它涂进一个**内容为残渣的
        // 寄存器**（实测反汇编 `negProbe`：`mov %rsi,%rdi; sub %rbx,%rdi` ——
        // rsi 是 caller 残留）。
        if (op == "Neg" && val.args.size >= 1) {
            val negSrc: Int = this.resolveNode(val.args[0])
            val negRes: Int = this.dag.addNode("Reg", "Sub", val.type,
                                               "", "", "", this.curChain, "")
            this.registerNode(vid, negRes)
            // xor dst, dst —— 硬件清零（pattern 13），不依赖常量物化
            this.dag.selectPattern(13, MachineDagUtils.toStr(negRes) + "," +
                                   MachineDagUtils.toStr(negRes), negRes)
            // sub dst, src —— dst = 0 - src
            this.dag.selectPattern(3, MachineDagUtils.toStr(negRes) + "," +
                                   MachineDagUtils.toStr(negSrc), negRes)
            return negRes
        }

        // ── 比较运算 → CMP + SETcc ──
        //
        // ⚠️ SsaBuilder.mapBinaryOp 产出的是 **ICmp\* 系列**（`ICmpEq` /
        // `ICmpNe` / `ICmpSlt` / `ICmpSgt` / `ICmpSle` / `ICmpSge`）。旧实现只认
        // `SEq`/`Slt` 这类短名 → 比较值退化成「无指令的 Value 节点」，
        // `if x > 3` 的 `cmp` 拿不到结果（实测两个分支都执行）。
        if (op == "ICmpEq" || op == "ICmpNe"
            || op == "ICmpSlt" || op == "ICmpSgt" || op == "ICmpSle" || op == "ICmpSge"
            || op == "ICmpUlt" || op == "ICmpUgt" || op == "ICmpUle" || op == "ICmpUge"
            || op == "SEq" || op == "SNe" || op == "Slt" || op == "Sgt"
            || op == "Sle" || op == "Sge"
            || op == "Ult" || op == "Ugt" || op == "Ule" || op == "Uge"
            || op == "OEq" || op == "ONe" || op == "Olt" || op == "Ogt"
            || op == "Ole" || op == "Oge"
            || op == "UEq" || op == "UNe" || op == "ULE" || op == "UGE") {
            return this.emitCmpSetcc(val, vid)
        }

        // ── 栈操作 ──
        if (op == "AllocStack" || op == "FrameAddr") {
            return this.emitStackOp(val, vid)
        }

        // ── 终结指令 ──
        if (op == "Call") {
            return this.emitCall(val, vid)
        }
        if (op == "Ret") {
            return this.emitRetValue(val, vid)
        }
        if (op == "Br") {
            return this.emitBr(val, vid)
        }
        if (op == "CondBr") {
            return this.emitCondBr(val, vid)
        }
        if (op == "Switch") {
            return this.emitBr(val, vid)
        }

        // ── 类型转换（S1 简化：忽略转换）──
        if (op == "Cast" || op == "Trunc" || op == "SExt" || op == "ZExt"
            || op == "FPExt" || op == "FPT") {
            return this.emitMovValue(val, vid)
        }

        // ── GetField：字段读取 ──
        //
        // ⚠️ 旧实现落到最下面的「默认 Value 节点」，**args 被整体丢弃**：
        // 基址操作数不进 DAG ⇒ ① 发射阶段无源可读（读残留寄存器 = 垃圾）；
        // ② 基址的活跃区间终止于其定义点 ⇒ RA 把它的寄存器分配给后续值
        // ⇒ 跨调用存活的对象句柄被静默覆写（实测 R12 探针：`a.pathBuf`
        // 读出 0，且实例 a 的寄存器被第二次构造复写。2026-10-03）。
        // 字段索引在 .hat 序列化中随 aux 丢失（HatSerializer 的 @field 不带
        // 名字），这里按 index 0 降级为 `__field_get(obj, 0)` —— 语义近似
        // （单字段对象恒正确）且保住区间/干扰的完整性；正式路径是前端
        // emitFieldGet 的 `Call __field_get(obj, idx)`（带真索引）。
        if (op == "GetField") {
            // P390 诊断：GetField 分派的 args 形态（独立计数，前 40）。
            if (this.phiDiagOn && this.diagGfCnt < 40) {
                this.diagGfCnt = this.diagGfCnt + 1
                println("[GF] fn=[" + this.funcName + "] n=" + MachineDagUtils.toStr(val.args.size)
                        + " aux=[" + val.aux + "] baseOp=" + (if (val.args.size > 0) { this.lir.valueOf(val.args[0]).op } else { "-" })
                        + " baseAux=[" + (if (val.args.size > 0) { this.lir.valueOf(val.args[0]).aux } else { "-" }) + "]")
            }
            var baseNode: Int = -1
            var baseTy: Int = 0
            if (val.args.size > 0) {
                baseNode = this.resolveNode(val.args[0])
                baseTy = this.lir.valueOf(val.args[0]).type
            }
            val zeroNode: Int = this.dag.addNode("Const", "ConstImm", baseTy,
                                                 "", "", "", this.curChain, "0")
            var fldArgs: String = ""
            if (baseNode >= 0) {
                fldArgs = MachineDagUtils.toStr(baseNode)
            }
            // P390 诊断：合成现场值。
            if (this.phiDiagOn && this.diagGfCnt < 40) {
                println("[GF2] baseNode=" + MachineDagUtils.toStr(baseNode)
                        + " fldArgs=[" + fldArgs + "]")
            }
            fldArgs = fldArgs + "," + MachineDagUtils.toStr(zeroNode)
            val gfNode: Int = this.dag.addNode("Value", "Call", val.type,
                                               fldArgs, "", "", this.curChain, "__field_get")
            this.registerNode(vid, gfNode)
            this.dag.selectPattern(50, MachineDagUtils.toStr(gfNode), -1)
            return gfNode
        }

        // ── 默认：创建一个 Value 节点 ──
        val nodeId: Int = this.dag.addNode("Value", op, val.type,
                                           "", "", "", this.curChain, val.aux)
        this.registerNode(vid, nodeId)
        return nodeId
    }

    // ── 发射：常量 ──

    /// 发射常量指令。
    ///
    /// ⚠️ 常量节点（kind="Const"）交给**寄存器分配器**着色（`reg=""`）。
    /// 旧实现用「轮转寄存器」把每个常量钉死在 rbx/rsi/rdi/r12-r15 上，且分配器
    /// Step 0 会预登记这些固定寄存器为「已占用」：函数内只要有 ≥7 个常量，
    /// 整个非易失寄存器池在**第 0 个节点被着色前**就已被占满 —— 于是任何跨越
    /// 循环/调用的值（Phi、跨 call 的循环变量）都拿不到颜色，`regOfNode` 回退
    /// 到 `rax`，而 rax 会被 `call` 的返回值覆写。实测 04_control_flow 的
    /// while 循环变量 Phi 因此被 `println` 的返回值覆盖，`i` 永远是 1 → 死循环。
    private fun emitConst(val: LirValue, vid: Int): Int {
        val constVal0: String = val.aux
        val typeId: Int = val.type

        // 字符串常量：分配 @str.N 符号，创建 LEA 指令加载地址。
        // ⚠️ 2026-10-06 P227：空串**必须**走本分支。旧实现（2026-10-03）刻意
        // 只按 isString 判定、把空串留在数值路径（strToInt("")=0 ⇒ 物化为
        // NULL），streq 另打 null 兜底——但任何其他空串用法全是雷：实测
        // decodeNumeric 的 `var a1: String = ""` 初始化物化为 NULL ⇒
        // `a0 + "," + a1` → strcat(s1, NULL) → strlen(0) 必崩（minimal.auc
        // 第 2 条指令即触发）。物化为真实 @str.N（内容 1 字节 NUL）。
        if (this.types.isString(typeId) || constVal0 == "") {
            val strName: String = "@str." + this.strConstCount
            this.strConstCount = this.strConstCount + 1
            // ⚠️ String 类型的 null 常量必须物化为**空串**——aux 原样入池会
            // 把字面文本 "null" 当字符串内容（实测 readMagic 的 result 初值
            // （源码 ""，自举前端降级成 null 常量）拼接出 "nullAURA" 魔数，
            // 2026-10-06）。
            var strLit: String = constVal0
            if (strLit == "null") { strLit = "" }
            this.stringConstAdd(strLit)

            // Const 节点（aux = @str.N 符号名），寄存器由分配器决定。
            val nodeId: Int = this.dag.addNode("Const", val.op, val.type,
                                               "", "", "", this.curChain, strName)
            this.registerNode(vid, nodeId)

            // 创建 LEA 指令加载字符串地址（pattern 63: "lea %dst, @sym"）。
            val nodes: String = MachineDagUtils.toStr(nodeId)
            this.dag.selectPattern(63, nodes, nodeId)
            return nodeId
        }

        // ── P40x-k：Float/Double 常量物化为**其文本的 .rdata 串** ──
        //
        // 浮点值在语言测试里几乎只被打印（01-lexer §1.4、toString_implicit）；
        // 数值路径的十进制跳字符解析会把 aux "3.14" 折叠成 314，打印时该值
        // 被当串指针 → strlen(314) 段错误（实测）。物化为 "3.14" 串后：
        // 打印路径全通；浮点算术退化为指针运算（diff 不崩，待 Float 定标专项）。
        var fTyName: String = this.types.nameOf(typeId)
        if (fTyName == "Float" || fTyName == "Double"
                || endsWithStr(fTyName, "|Float") || endsWithStr(fTyName, "|Double")) {
            var fLit: String = constVal0
            if (fLit == "null") { fLit = "0.0" }
            // 去掉类型后缀（3.14f / 3.14d）与下划线。
            // ⚠️ 尾部字母剥除必须**只剥 f/F/d/D**（类型标记），且仅在**最后一个字母
            //    之前没有 e/E 且其后是指数部分**时执行——否则 `1.5e10` 会被误剥成
            //    `1.5e1`、`1.2E-3` 被剥成 `1.2E-`（P40x-k 回归，实测 01-lexer §1.4）。
            var cleaned: String = ""
            var ci: Int = 0
            while (ci < fLit.length) {
                val ch: Int = fLit.charCodeAt(ci)
                if (ch != 95) { cleaned = cleaned + fLit.substring(ci, ci + 1) }
                ci = ci + 1
            }
            var cut: Int = cleaned.length
            // 定位最后一个 e/E 位置（若有）——作为后缀剥除的边界
            var expIdx: Int = -1
            var ei: Int = 0
            while (ei < cleaned.length) {
                val c: Int = cleaned.charCodeAt(ei)
                if (c == 101 || c == 69) {
                    // 前一字符必须是数字/小数点（避免匹配非数值 e，如标识符）
                    val prevOk: Boolean = ei > 0
                    val nextOk: Boolean = ei + 1 < cleaned.length
                    if (prevOk && nextOk) {
                        val pc: Int = cleaned.charCodeAt(ei - 1)
                        val nc: Int = cleaned.charCodeAt(ei + 1)
                        val pNum: Boolean = (pc >= 48 && pc <= 57) || pc == 46
                        val nSym: Boolean = (nc >= 48 && nc <= 57) || nc == 45 || nc == 43
                        if (pNum && nSym) { expIdx = ei }
                    }
                }
                ei = ei + 1
            }
            // 后缀剥除的搜索起点：如果有 e/E 指数，只能在指数部分之后剥
            var suffixStart: Int = if (expIdx >= 0) expIdx + 1 else 0
            var j: Int = cleaned.length - 1
            while (j >= suffixStart) {
                val c: Int = cleaned.charCodeAt(j)
                // 只剥 f/F/d/D（类型标记），不动其他字母
                if (c == 102 || c == 70 || c == 100 || c == 68) {
                    j = j - 1
                } else { break }
            }
            cut = j + 1
            if (cut < 1) { cut = 1 }
            fLit = cleaned.substring(0, cut)
            // R64a：科学计数法 → 等价十进制文本。
            // aux 里 `1.5e10` 直接物化为串 → toString 路径读指针，打印出原文本；
            // VM 参考把 1.5e10 打成 15000000000.0、1.2E-3 打成 0.0012。
            // 编译期做 mantissa × 10^exp 的十进制字符串展开。
            if (expIdx >= 0) {
                fLit = this.sciNotationToDecimal(cleaned, expIdx)
            }
            this.stringConstAdd(fLit)

            val fNodeName: String = "@str." + toStr(this.strConstCount)
            this.strConstCount = this.strConstCount + 1
            val fNodeId: Int = this.dag.addNode("Const", val.op, val.type,
                                                "", "", "", this.curChain, fNodeName)
            this.registerNode(vid, fNodeId)
            val fNodes: String = MachineDagUtils.toStr(fNodeId)
            this.dag.selectPattern(63, fNodes, fNodeId)
            return fNodeId
        }

        // 数值常量：**保留符号**（旧实现把 '-' 剥掉后仅用 `isNeg` 标记却从不使用，
        // 负数常量被实体化成正数）。
        // null 常量（SsaBuilder zeroValueOf / 字面量 null 的 aux="null"，经
        // HatParser 修复后 .hat 往返保留）按 0 物化——与修复前「aux 被序列化
        // 丢成空串→strToInt=0」的机器码一致，只是不再丢信息（ISA Case-2 的
        // nullish 判定依赖 aux=="null"，见 emitStreqSetcc 上方说明）。
        var constVal: String = constVal0
        if (constVal == "null") {
            constVal = "0"
        }
        val nodeId: Int = this.dag.addNode("Const", val.op, val.type,
                                           "", "", "", this.curChain, constVal)
        this.registerNode(vid, nodeId)

        // 创建 MOV 立即数指令（pattern 6: "mov %dst, @imm"）。
        val nodes: String = MachineDagUtils.toStr(nodeId)
        this.dag.selectPattern(6, nodes, nodeId)
        return nodeId
    }

    // ── 发射：Phi ──

    /// 把操作数 ValueID 列表逗号连接成串（`DagNode.args` 是 String 槽）。
    ///
    /// ⚠️ Lir P2.2 起 `LirValue.args` 是 `List[Int>]`；不能把 List 直接传给
    /// String 形参（`addNode` 的 args 槽 / `String` 局部）—— 那条隐式转换
    /// 只在种子 VM 下碰巧成立，AOT 下退化为空串（本文件 2026-10-02 修复的
    /// 「全函数零发射」回归的根源）。凡是把 args 存进 DAG 节点的地方，
    /// 一律先过本函数。
    private fun argsJoin(list: List<Int>): String {
        var out: String = ""
        var i: Int = 0
        while (i < list.size) {
            if (i == 0) {
                out = MachineDagUtils.toStr(list[i])
            } else {
                out = out + "," + MachineDagUtils.toStr(list[i])
            }
            i = i + 1
        }
        return out
    }

    /// 发射 Phi 节点（正确语义：将入边值 MOV 到 Phi 目标寄存器）。
    ///
    /// Phi 节点的正确翻译：
    ///   - 为 Phi 节点分配一个目标寄存器
    ///   - MOV 指令由 emitPhiMovsForBlock 在前驱块末尾发射（PHI 消除）
    ///
    /// 注意：完整的 Phi 消除需要控制流分析（将 Phi 值分配到前驱块）。
    /// 本实现通过 analyzePhiPreds 在前驱块末尾插入 MOV phi_node, incoming_node，
    /// emitPhi 仅注册节点，不发射 MOV。
    private fun emitPhi(val: LirValue, vid: Int): Int {
        val nodeId: Int = this.dag.addNode("Value", "Phi", val.type,
                                            "", "", "", this.curChain, this.argsJoin(val.args))
        this.registerNode(vid, nodeId)
        // P372：入边值认领（槽合并核心）——非 Const/Phi 入边的**定义槽**
        // 别名到本 phi 的槽：定义写与 phi 读落同一槽，phi MOV 退化为自拷贝，
        // 边匹配/前驱标签错误不再可能影响正确性。Const 入边排除（每次使用
        // 重物化，槽合并无意义且会吞掉入口初始化）；Phi 入边排除（嵌套
        // phi 保持既有 MOV 机制）。
        var ai: Int = 0
        while (ai < val.args.size) {
            val iv: Int = val.args[ai]
            if (iv >= 0) {
                val op0: String = this.lir.valueOf(iv).op
                if (op0 != "Const" && op0 != "Phi") {
                    this.phiClaimFrom.add(iv)
                    this.phiClaimNode.add(nodeId)
                }
            }
            ai = ai + 1
        }
        // MOV 由 emitPhiMovsForBlock 在前驱块末尾发射，此处不发射。
        return nodeId
    }

    // ── 发射：算术运算 ──

    /// 发射算术运算指令（Add/Sub/Mul 等）。
    private fun emitArith(val: LirValue, vid: Int): Int {
        if (val.args.size < 2) {
            val nodeId: Int = this.dag.addNode("Value", val.op, val.type,
                                               "", "", "", this.curChain, "")
            this.registerNode(vid, nodeId)
            return nodeId
        }

        val lhs: Int = val.args[0]
        val rhs: Int = val.args[1]

        val lhsNode: Int = this.resolveNode(lhs)
        val rhsNode: Int = this.resolveNode(rhs)

        // ── 字符串拼接：String + String → 调用 runtime strcat ──
        //
        // ⚠️ 类型判定必须**兜底看操作数**：循环携带 String 变量的 phi 可能
        // 被定型成 Int（SsaBuilder.buildWhile 旧实现硬编码 phi 类型 0）、
        // 自举前端的 concat 节点类型可能是 Basic——只看 Add 本身类型会把
        // 字符串 concat 编成**整数指针加法**（实测 readMagic 的
        // `result = result + fromCharCode(c)`：循环退出后读到 0x200 垃圾、
        // strlen(0x200) 段错误，2026-10-06）。
        // ⚠️⚠️ P293 反向缺陷（同一分派的另一面）：操作数兜底会把**整数加**
        // 误判成 strcat——一端类型被污染成 String（跨块类型丢失，§10.75）
        // 时，`count + 1` 的 Int 常量 1 救不了它 → strcat → "111"…
        // （实测 decodeNumeric 的 count+1 → strcat → 解码截断）。修复：
        // **任一操作数为整数 Const ⇒ 强制整数加**（Aura 源码拼接一律先
        // toStr，`str + Int常量` 形态不存在于自举代码）。
        var addIsStr: Boolean = this.types.isString(val.type)
        if (this.phiDiagOn && this.diagAddCnt < 6000 && val.op == "Add") {
            this.diagAddCnt = this.diagAddCnt + 1
            val dv0: LirValue = this.lir.valueOf(val.args[0])
            val dv1: LirValue = this.lir.valueOf(val.args[1])
            println("[ADDSEL] fn=" + this.funcName + " ty=" + MachineDagUtils.toStr(val.type)
                    + "=[" + this.types.typeNameOf(val.type) + "]"
                    + " lhs=" + MachineDagUtils.toStr(dv0.type) + "=[" + this.types.typeNameOf(dv0.type) + "]"
                    + " rhs=" + MachineDagUtils.toStr(dv1.type) + "=[" + this.types.typeNameOf(dv1.type) + "]"
                    + " isStr=" + MachineDagUtils.toStr(if (addIsStr) 1 else 0))
        }
        if (!addIsStr && this.lir != null && val.args.size >= 2) {
            val lhsV: LirValue = this.lir.valueOf(lhs)
            val rhsV: LirValue = this.lir.valueOf(rhs)
            val lhsStr: Boolean = this.types.isString(lhsV.type)
            val rhsStr: Boolean = this.types.isString(rhsV.type)
            val lhsIntConst: Boolean = lhsV.op == "Const" && !lhsStr
            val rhsIntConst: Boolean = rhsV.op == "Const" && !rhsStr
            addIsStr = (lhsStr && !rhsIntConst) || (rhsStr && !lhsIntConst)
        }
        if (val.op == "Add" && addIsStr) {
            // P40x：语义拼接（Add 结果类型为 String）的非 String 操作数包一层
            // 字符串转换（str + 42 / "x" + true 家族）。开关读一次缓存——
            // 热点路径 Env.get = 驱动段错误（P40x-d）。VM 宿主构建不设
            // AURA_CONCAT_CONV → 保持 69/65 基线；AOT 套件脚本显式开启。
            if (this.concatConvCache < 0) {
                this.concatConvCache = if (Env.get("AURA_CONCAT_CONV", "") == "1") { 1 } else { 0 }
            }
            var convLhs: Int = lhsNode
            var convRhs: Int = rhsNode
            // P40x-l：门控放宽为 addIsStr（操作数启发）——`str + 整数变量`
            // 的 Add 类型在前端弱类型下常为 Basic（非 String），旧门控跳过
            // 转换 → strcat(str, 整数) → NULL 兜底空串（实测 06 nullInt=、
            // 08 cores=）。逐操作数转换自证安全：String → 恒等、标量 → toStr。
            if (this.concatConvCache == 1 && addIsStr
                    && this.lir != null && val.args.size >= 2) {
                convLhs = this.emitToStrConvNode(lhs, lhsNode)
                convRhs = this.emitToStrConvNode(rhs, rhsNode)
            }
            return this.emitStrcat(val, vid, convLhs, convRhs)
        }

        // 根据 op 选择 pattern。
        val patternId: Int = this.arithPatternId(val.op)

        // **结果使用新的虚拟寄存器节点**（kind="Reg"，交给分配器着色）：
        // 旧实现直接复用 lhsNode 的寄存器 —— 若 lhs 是常量/参数/其它活值，
        // 会被 `add`/`sub` 就地覆写（实测 `addq %rbx,%rbx` 把字符串常量
        // 变成整数相加并把地址翻倍）。
        val resNode: Int = this.dag.addNode("Reg", val.op, val.type,
                                            "", "", "", this.curChain, "")
        this.registerNode(vid, resNode)

        // mov %dst(resNode), %src(lhsNode)
        this.dag.selectPattern(7, MachineDagUtils.toStr(lhsNode), resNode)

        // 指令语义：dst = dst op src。
        val nodes: String = MachineDagUtils.toStr(resNode) + "," +
                            MachineDagUtils.toStr(rhsNode)
        this.dag.selectPattern(patternId, nodes, resNode)

        return resNode
    }

    /// 把源串字面量登记进字符串常量池并生成 `lea %dst, @str.N` 节点。
    ///
    /// `literal` 需要带引号（与 `emitConst` 的字符串分支一致，写入 .rdata 时
    /// 由 PhotonObjectWriter 去引号）。
    private fun emitStringConstNode(vid: Int, literal: String): Int {
        val strName: String = "@str." + this.strConstCount
        this.strConstCount = this.strConstCount + 1
        this.stringConstAdd(literal)

        val strTypeId: Int = this.types.fromTypeName("String")
        val nodeId: Int = this.dag.addNode("Const", "ConstImm", strTypeId,
                                           "", "", "", this.curChain, strName)
        this.registerNode(vid, nodeId)
        this.dag.selectPattern(63, MachineDagUtils.toStr(nodeId), nodeId)
        return nodeId
    }

    /// 发射字符串拼接（String + String → 调用 runtime strcat）。
    private fun emitStrcat(val: LirValue, vid: Int, lhsNode: Int, rhsNode: Int): Int {
        // 创建 Call 节点（被调函数 strcat）。
        val nodeId: Int = this.dag.addNode("Value", "Call", val.type,
                                           "", "", "", this.curChain, "strcat")
        this.registerNode(vid, nodeId)

        // 设置调用实参（lhs=rcx, rhs=rdx）。
        val callNode: DagNode = this.dag.nodeOf(nodeId)
        callNode.args = MachineDagUtils.toStr(lhsNode) + "," + MachineDagUtils.toStr(rhsNode)

        // 选择 call 模式（pattern 50: "call %func"）。
        this.dag.selectPattern(50, MachineDagUtils.toStr(nodeId), -1)
        return nodeId
    }

    /// P40x：发射「非 String 值 → String」的转换调用节点。
    ///
    /// Bool → boolToStr（"true"/"false"；toStr 只认整数会打 1/0）、Char →
    /// charToStr、String → 原样返回（恒等）、其余（Int/Long/Float）→ toStr。
    /// ⚠️ 不能用 runtime 裸 toString——恒等占位（mov rax,rcx;ret），实测
    /// toString(42) 原样返回 42 → strcat 解引用地址 42 段错误。
    private fun emitToStrConvNode(argLirId: Int, argNode: Int): Int {
        val argVal: LirValue = this.lir.valueOf(argLirId)
        if (Env.get("AURA_CONV_ENTRY", "") == "1") {
            println("[convE] op=[" + argVal.op + "] aux=[" + argVal.aux
                    + "] ty=" + MachineDagUtils.toStr(argVal.type)
                    + "=[" + this.types.nameOf(argVal.type) + "]")
        }
        // 类型名可能带 #public| 限定前缀（函数签名家族），裸名/限定名都认
        var argTyName: String = this.types.nameOf(argVal.type)
        if (this.types.isString(argVal.type) || argTyName == "String"
                || endsWithStr(argTyName, "|String")
                || argTyName == "Float" || argTyName == "Double"
                || endsWithStr(argTyName, "|Float") || endsWithStr(argTyName, "|Double")) {
            // String 恒等；Float/Double 恒等（P40x-k：浮点常量已物化为文本串，
            // 值即 C 串指针——再 toStr 会把指针打成十进制）
            return argNode
        }
        // 调用实参：优先查被调在 LIR 的返回类型（自举前端调用 LIR 类型不可靠
        // ——返回 String 的方法标成 Basic/Int，按类型判定会二次转换，实测 p5）。
        if (argVal.op == "Call") {
            val auxName: String = argVal.aux
            // 成员调用的 aux 是裸名（X.m() → aux="m"），先解析
            val resolvedCallee: String = this.resolveCalleeSymbol(auxName, "")
            // R44e：被调是 Box 臂或构造器（<Class>_init/__new*）⇒ 返回堆指针，
            // LIR 类型却常被标成 Int（前端对 runtime 臂无签名）→ 类型分派会走
            // toStr 把指针打整数（实测 10-memory Box: 140700…）。直接 refToStr。
            if (resolvedCallee == "Box" || endsWithStr(resolvedCallee, "_init")
                    || endsWithStr(resolvedCallee, "__new")) {
                val objConv: Int = this.dag.addNode("Value", "Call",
                                                    this.types.fromTypeName("String"),
                                                    "", "", "", this.curChain, "refToStr")
                val objNode: DagNode = this.dag.nodeOf(objConv)
                objNode.args = MachineDagUtils.toStr(argNode)
                this.dag.selectPattern(50, MachineDagUtils.toStr(objConv), -1)
                return objConv
            }
            var fi: Int = 0
            var found: Boolean = false
            while (fi < this.lirFuncNames.size) {
                if (this.lirFuncNames[fi] == resolvedCallee) {
                    found = true
                    break
                }
                fi = fi + 1
            }
            if (found) {
                val retTy: Int = this.lirFuncRetTys[fi]
                var retName: String = this.types.nameOf(retTy)
                if (this.types.isString(retTy) || retName == "String"
                        || endsWithStr(retName, "|String")) {
                    return argNode
                }
                // 非 String 返回（Int/Bool/…）→ 继续类型分派转换
            } else {
                // runtime 臂 / 跨模块：查「已知返回 C 串」名单，命中 → 恒等
                var isStrProducer: Boolean = false
                var si: Int = 0
                val producers: String = "toStr,strcat,boolToStr,charToStr,toString,String_substring,String_fromCharCode,env_get,Env_get,String_trim,String_split,String_substringBefore"
                while (si < producers.length) {
                    var ej: Int = si
                    while (ej < producers.length && producers.charCodeAt(ej) != 44) {
                        ej = ej + 1
                    }
                    if (ej - si == auxName.length) {
                        var match: Boolean = true
                        var mj: Int = 0
                        while (mj < auxName.length) {
                            if (producers.charCodeAt(si + mj) != auxName.charCodeAt(mj)) {
                                match = false
                                mj = auxName.length
                            }
                            mj = mj + 1
                        }
                        if (match) { isStrProducer = true; si = producers.length }
                    }
                    si = ej + 1
                }
                if (isStrProducer) {
                    return argNode
                }
            }
        }
        var fname: String = "toStr"
        // P40x-l：可空类型（Int?/Bool?/…）与 null 字面量 → toStrN
        //（null 渲染为 "null"；原生表示中 null = 0，语言测试 06 语义）
        var aName: String = argTyName
        if (aName == "" ) { aName = this.types.nameOf(argVal.type) }
        if (argVal.aux == "null"
                || (aName.length > 1 && (aName.charCodeAt(aName.length - 1) as Int) == 63)) {
            fname = "toStrN"
        } else if (this.types.isBool(argVal.type)) {
            fname = "boolToStr"
        } else {
            val tn: String = this.types.nameOf(argVal.type)
            if (tn == "Char") {
                fname = "charToStr"
            } else if (tn != "Int" && tn != "Long" && tn != "Short" && tn != "Byte"
                    && tn != "Basic" && tn != ""
                    && !endsWithStr(tn, "|Int") && !endsWithStr(tn, "|Long")
                    && !endsWithStr(tn, "|Short") && !endsWithStr(tn, "|Byte")) {
                // R44e：非标量非可空 ⇒ 对象类型。VM 参考把对象隐式转串渲染为
                // <ref#N>（N = 创建序号，字符串/列表不编号）——旧路径发 toStr
                // 把对象指针当整数打印（实测 10-memory §10.3 Box: 140700…）。
                fname = "refToStr"
            }
        }
        if (Env.get("AURA_MAP_TRACE", "") == "1") {
            println("[conv] argTy=[" + argTyName + "] eff=[" + this.types.nameOf(argVal.type)
                    + "] op=[" + argVal.op + "] -> " + fname)
        }
        val strTy: Int = this.types.fromTypeName("String")
        val convId: Int = this.dag.addNode("Value", "Call", strTy,
                                           "", "", "", this.curChain, fname)
        val convNode: DagNode = this.dag.nodeOf(convId)
        convNode.args = MachineDagUtils.toStr(argNode)
        // pattern 50 立即选择：保证转换调用先于消费它的外层调用编码
        this.dag.selectPattern(50, MachineDagUtils.toStr(convId), -1)
        return convId
    }

    /// 发射参数加载（从 Windows x64 ABI 寄存器读取）。
    ///
    /// 参数值一开始在 ABI 寄存器（rcx, rdx, r8, r9）中，但这些是**易失**寄存器：
    /// `call` 会无条件覆写它们。旧实现直接把参数节点钉在 ABI 寄存器上并让所有
    /// 使用点直接读它 —— 实测 `factorial(n) { return n * factorial(n-1) }` 中
    /// `n` 在递归调用后被读成 `n-1`（rcx 已被实参装载覆写），结果恒为 1。
    ///
    /// 现改为函数入口处发一条 `mov dst, abiReg`：
    ///   * 源节点 kind="Param" 钉在 ABI 寄存器（不参与着色，仅登记占用）；
    ///   * 目标节点 kind="Reg" 交给分配器着色 —— 可用颜色只有非易失寄存器
    ///     （rbx/rsi/rdi/r12-r15），因此参数值可以安全跨 `call` 存活。
    private fun emitParam(val: LirValue, vid: Int): Int {
        // 确定 ABI 寄存器。
        //
        // ⚠️ 第 5+ 参数走**栈传递**（Win64：调用方在 [rsp+0x20+i*8] 写 arg5+i，
        // 即影子空间之上）。被调方视野：入口 rsp=E 指向返回地址，arg5 在
        // **E+0x28**（返回地址 8 + 影子空间 0x20 之上）。X86Emitter 自 P226 起
        // 固定 push 7 个 callee-saved + push rbp = 8 push ⇒ rbp = E − 0x40。
        // arg_k 在 E+0x28+8*(k−5) ⇒ [rbp + 0x68 + (idx−4)*8)（idx 0 基，idx=4 即 arg5）。
        // ⚠️ 历史：基址按「当时的实际 push 数」手工校准过三次（0x10 影子空间 →
        // 0x30 → 0x48），每次只对当轮构建成立 ⇒ 栈参错位反复复发（0x5000016b
        // 打包值、constTags=tagged(1) 等实测）。P226 起序言固定 8 push，本基址
        // 0x68 结构恒定（0x40=8push 帧 + 0x28=ret+影子空间）。
        val abiRegs: List<String> = listOf("rcx", "rdx", "r8", "r9")
        val idx: Int = this.paramIndex
        this.paramIndex = this.paramIndex + 1
        val abiReg: String = if (idx < abiRegs.size) abiRegs[idx]
                             else "stack:" + toStr(0x68 + (idx - 4) * 8)

        // 源节点：固定 ABI 寄存器（易失寄存器，不参与着色）。
        val srcNode: Int = this.dag.addNode("Param", "Param", val.type,
                                            abiReg, "", "", this.curChain, val.aux)
        // 目标节点：可着色的虚拟寄存器（非易失池）。
        val dstNode: Int = this.dag.addNode("Reg", "Mov", val.type,
                                            "", "", "", this.curChain, "")
        this.registerNode(vid, dstNode)

        // 入口搬运：mov %dst, %src（pattern 7 的 nodes[0] 是 src，output 是 dst）。
        this.dag.selectPattern(7, MachineDagUtils.toStr(srcNode), dstNode)
        return dstNode
    }

    // ── 发射：内存操作 ──

    /// 发射 Load 指令。
    private fun emitLoad(val: LirValue, vid: Int): Int {
        // Load args: "base" 或 "base+offset" 或 "base+offset*scale"
        val addrStr: String = this.argsJoin(val.args)
        val nodeId: Int = this.dag.addNode("Value", "Load", val.type,
                                           "", "", "", this.curChain, addrStr)
        this.registerNode(vid, nodeId)

        // 创建 mov [mem], %dst 指令（pattern 10）。
        val nodes: String = MachineDagUtils.toStr(nodeId)
        this.dag.selectPattern(10, nodes, nodeId)
        return nodeId
    }

    /// 发射 Store 指令。
    private fun emitStore(val: LirValue, vid: Int): Int {
        // Store args: "value,addrMode" 或 "value,base,offset"
        var srcNode: Int = -1
        if (val.args.size > 0) {
            srcNode = this.resolveNode(val.args[0])
        }
        val nodeId: Int = this.dag.addNode("Value", "Store", val.type,
                                           "", "", "", this.curChain, this.argsJoin(val.args))
        this.registerNode(vid, nodeId)

        // 创建 mov %src, [mem] 指令（pattern 11）。
        if (srcNode >= 0) {
            val nodes: String = MachineDagUtils.toStr(srcNode)
            this.dag.selectPattern(11, nodes, -1)
        }
        return nodeId
    }

    // ── 发射：地址模式 ──

    /// 发射地址计算指令。
    private fun emitAddrMode(val: LirValue, vid: Int): Int {
        val nodeId: Int = this.dag.addNode("Value", val.op, val.type,
                                           "", "", "", this.curChain, this.argsJoin(val.args))
        this.registerNode(vid, nodeId)

        // 使用 LEA 指令（pattern 12）。
        val nodes: String = MachineDagUtils.toStr(nodeId)
        this.dag.selectPattern(12, nodes, nodeId)
        return nodeId
    }

    // ── 发射：MOV ──

    /// 发射 MOV 指令。
    private fun emitMovValue(val: LirValue, vid: Int): Int {
        if (val.args.size > 0) {
            val srcId: Int = val.args[0]
            val srcNode: Int = this.resolveNode(srcId)
            if (srcNode >= 0) {
                // R52: Mov 必须是**真实的寄存器→寄存器拷贝**，不能把
                // vid 别名到 srcNode。旧实现 selectPattern(7, srcNode, srcNode)
                // 产出自拷贝 `mov %rax, %rax`，且 registerNode(vid, srcNode)
                // 让 Mov 结果与源共享同一 DAG 节点 ⇒ 当源是 Phi 时，
                // phi 回边 MOV 把新值写入共享节点，Mov 快照退化为空操作：
                // `val temp = fib; fib = fib+fib2; fib2 = temp` 中 temp
                // 与 fib 同槽，fib 回边先执行覆盖了 temp 的值 ⇒
                // fib2 = new_fib（而非 old_fib）⇒ 循环输出 0,1,2,4,8
                // 而非 0,1,1,2,3（实测 04-control-flow §4.8）。
                // 修复：为 Mov 结果创建**独立 DAG 节点**作为 MOV 目标。
                val dstNode: Int = this.dag.addNode("Value", "Mov", val.type,
                                                    "", "", "", this.curChain, "")
                val nodes: String = MachineDagUtils.toStr(srcNode)
                this.dag.selectPattern(7, nodes, dstNode)
                this.registerNode(vid, dstNode)
                return dstNode
            }
        }
        val nodeId: Int = this.dag.addNode("Value", "Mov", val.type,
                                           "", "", "", this.curChain, "")
        this.registerNode(vid, nodeId)
        return nodeId
    }

    // ── 发射：CMP + SETcc ──

    /// 发射比较指令（CMP + SETcc）。
    private fun emitCmpSetcc(val: LirValue, vid: Int): Int {
        if (val.args.size < 2) {
            val nodeId: Int = this.dag.addNode("Value", val.op, val.type,
                                               "", "", "", this.curChain, "")
            this.registerNode(vid, nodeId)
            return nodeId
        }

        val lhs: Int = val.args[0]
        val rhs: Int = val.args[1]

        val lhsNode: Int = this.resolveNode(lhs)
        val rhsNode: Int = this.resolveNode(rhs)

        // ── 字符串判等：`==` / `!=` 必须比**内容**，不能比指针 ──
        //
        // `"a" + "b" == "ab"` 这类比较在 VM 参考实现里是内容比较；直接 `cmp`
        // 两个指针只有在字面量去重时才偶然成立。这里改为调用 runtime 的
        // `streq(rcx, rdx) → rax = 1/0`，再 `cmp rax, 0` + `setne/sete`。
        //
        // SsaBuilder 已经将字符串比较降级为 `streq` 调用 + `ICmpNe/ICmpEq`，
        // 所以这里还需要处理"streq 结果与 0 比较"的情况。
        if ((val.op == "ICmpEq" || val.op == "ICmpNe")
            && this.lir != null) {
            // Case 1: rhs 是常量 **0** → streq 结果比较
            // ⚠️ 零值判定只能看 aux：Const 节点的 args 恒为空，旧实现的
            // `|| rhsVal.args.size == 0` 子句让**任意值**的常量都命中 Case-1
            // ⇒ `x != 104` 被编成 `x != 0`（实测 probe_cmp：got=104 时
            // `got != 104` 恒真）。所有「整数 ==/!= 非零常量」比较在 photon
            // 产物里全部错判（`<`/`<=` 不走本路径，fib/bench_loop 幸免）。
            // Case-1 的真实用户是 `ICmpNe(streq结果, Const 0)`（aux="0"）与
            // null 常量（HatParser 修复后 aux="null"，strToInt 同样 = 0），
            // 两者语义都是「与 0 比较」，本分支保持正确。
            val rhsVal: LirValue = this.lir.valueOf(rhs)
            if (this.types.isInt(rhsVal.type)
                && rhsVal.isConst()
                && LirUtils.strToInt(rhsVal.aux) == 0) {
                // streq 已经返回 1/0，直接 cmp 0 + setcc
                this.dag.selectPattern(20, MachineDagUtils.toStr(lhsNode) + ",0", -1)
                val setccNode: Int = this.dag.addNode("Value", val.op, val.type,
                                                      "", "", "", this.curChain, val.op)
                this.registerNode(vid, setccNode)
                val setccId: Int = this.dag.selectPattern(40,
                                  MachineDagUtils.toStr(setccNode), setccNode)
                val instr: DagInstruction = this.dag.instrOf(setccId)
                if (val.op == "ICmpNe") { instr.cond = "ne" } else { instr.cond = "e" }
                return setccNode
            }
            // Case 2: lhs 是 String 类型 → 原始字符串比较
            if (this.types.isString(this.lir.valueOf(lhs).type)) {
                // ⚠️ null/0 常量比较必须走**指针相等**：`if (s == null)` /
                // 未初始化 String（`Const 0`）与字符串比较若也发 streq，
                // 就是对地址 0 做内容比较 ⇒ 0xC0000005（实测 fs 探针，
                // 2026-10-03；与 SsaBuilder.buildBinary 的同族守卫配套 ——
                // buildBinary 让 null 比较落回整数 ICmp 后，会在这里被
                // 重新改写成 streq，所以本层也要豁免）。
                val lhsV: LirValue = this.lir.valueOf(lhs)
                val rhsV: LirValue = this.lir.valueOf(rhs)
                val lhsNullish: Boolean = lhsV.isConst()
                        && (lhsV.aux == "null" || lhsV.aux == "0")
                val rhsNullish: Boolean = rhsV.isConst()
                        && (rhsV.aux == "null" || rhsV.aux == "0")
                if (!lhsNullish && !rhsNullish) {
                    return this.emitStreqSetcc(val, vid, lhsNode, rhsNode)
                }
                // null 比较：落到末尾的通用 CMP+SETcc（指针比较）
            }
        }

        // CMP 指令（pattern 20: "cmp %src, @imm" 或 pattern 21: "cmp %src1, %src2"）。
        //
        // pattern 20 的 `nodes[1]` 是**立即数本身**（不是节点 id）：
        // `X86Emitter.emitCmpImm` 直接 `strToInt(nodes[1])`。旧实现把 rhs 的
        // 节点 id 塞进去，编出来的立即数是节点编号。
        if (this.isConstNode(rhsNode)) {
            val rhsDag: DagNode = this.dag.nodeOf(rhsNode)
            if (rhsDag.aux.startsWith("@str.")) {
                // 字符串常量：比较指针，走寄存器形式
                val cmpNodes: String = MachineDagUtils.toStr(lhsNode) + "," +
                                       MachineDagUtils.toStr(rhsNode)
                this.dag.selectPattern(21, cmpNodes, -1)
            } else {
                val cmpNodes: String = MachineDagUtils.toStr(lhsNode) + "," + rhsDag.aux
                this.dag.selectPattern(20, cmpNodes, -1)
            }
        } else {
            val cmpNodes: String = MachineDagUtils.toStr(lhsNode) + "," +
                                   MachineDagUtils.toStr(rhsNode)
            this.dag.selectPattern(21, cmpNodes, -1)
        }

        // SETcc 指令（pattern 40: "setcc %dst"）。
        val setccNode: Int = this.dag.addNode("Value", val.op, val.type,
                                               "", "", "", this.curChain, val.op)
        this.registerNode(vid, setccNode)
        val setccNodes: String = MachineDagUtils.toStr(setccNode)
        val setccId: Int = this.dag.selectPattern(40, setccNodes, setccNode)
        val instr: DagInstruction = this.dag.instrOf(setccId)
        instr.cond = this.mapCmpOpToCond(val.op)
        return setccNode
    }

    /// 把 stdlib 方法名映射到 Photon runtime 的等价函数名。
    ///
    /// 被调名来自 SSA/HIR（如 `String.length`），而 runtime 只导出扁平符号
    ///（`strlen`）。前端不做映射的话，链接阶段会报
    /// `undefined symbol: String.length`（实测 P2/04_string_ops）。
    /// 未列出的名字原样返回 —— 用户函数保持原名。
    ///
    /// `recvTy` 是第一个实参（方法调用的接收者）的类型名。两种前端发出的
    /// 被调名形态不同，都要能命中：
    ///   * Rust 前端发**全限定名**（`String.length` / `Any.equals`）；
    ///   * Aura 自举前端 `HirLowerer.lowerCall` 只取**成员名**（`length` /
    ///     `equals`）—— 裸名落到 `undefined symbol: length`（实测 P2/04）。
    /// 与下方 `Collections.set` 的三种拼法（全限定 / `Collections.` / `.Collections.`）
    /// 是同一策略：按接收者类型把裸名补齐。
    private fun mapStdlibFuncName(name: String, recvTy: String, argCount: Int,
                                  lastIsMem: Boolean): String {
        if (Env.get("AURA_MAP_TRACE", "") == "1") {
            println("[map] name=[" + name + "] recvTy=[" + recvTy + "] n=" + toStr(argCount))
        }
        if (name == "String.length" || name == "String.size") { return "strlen" }
        // R62：`import aura.math.*` 通配导入（11-imports §11.1）——前端把
        // `sqrt(16.0)` / `cos(0.0)` 降级为**裸名**调用（`@call @sqrt(...)`），
        // 但 stdlib 侧 `aura.lang.std.Math` 已把 `sqrt` / `cos` 等数学函数
        // 定义为 `Math_sqrt` / `Math_cos`（Mangled 名，见 Math.aura +
        // MathOps.aura）。此前无映射 ⇒ 链接期 `undefined symbol: sqrt / cos /
        // sq`（11-imports §11.1/§11.3 全挂）。`sq` 是 `import aura.math.sqrt
        // as sq` 的别名导入（§11.3），同样落到裸名 `@call @sq(...)`。
        if (name == "sqrt") { return "MathOps_sqrtD" }
        if (name == "cos") { return "MathOps_cosD" }
        if (name == "sin") { return "MathOps_sinD" }
        if (name == "tan") { return "MathOps_tanD" }
        if (name == "round") { return "Math_round" }
        if (name == "floor") { return "Math_floor" }
        if (name == "ceil") { return "Math_ceil" }
        if (name == "pow") { return "MathOps_powD" }
        if (name == "sq") { return "MathOps_sqrtD" }
        if (name == "Math.sqrt" || name == "aura.lang.std.Math.sqrt") { return "MathOps_sqrtD" }
        if (name == "Math.cos" || name == "aura.lang.std.Math.cos") { return "MathOps_cosD" }
        if (name == "Math_sin" || name == "aura.lang.std.Math.sin") { return "MathOps_sinD" }
        if (name == "Math_tan" || name == "aura.lang.std.Math.tan") { return "MathOps_tanD" }
        if (name == "Math_abs" || name == "aura.lang.std.Math.abs") { return "Math_abs" }
        if (name == "Math_min" || name == "aura.lang.std.Math.min") { return "Math_min" }
        if (name == "Math_max" || name == "aura.lang.std.Math.max") { return "Math_max" }
        if (name == "Math_round" || name == "aura.lang.std.Math.round") { return "Math_round" }
        if (name == "Math_floor" || name == "aura.lang.std.Math.floor") { return "Math_floor" }
        if (name == "Math_ceil" || name == "aura.lang.std.Math.ceil") { return "Math_ceil" }
        if (name == "Math_pow" || name == "aura.lang.std.Math.pow") { return "MathOps_powD" }
        // `Env.get(name[, default])` → 运行库的 `env_get`（**真正的**环境变量读取）。
        //
        // ⚠️ 这里曾被**刻意**改写成占位实现 `Collections.getAt`（恒返回空串），
        // 原因是当时运行库那份 `env_get` 是 **PEB 链实现**：它靠逐字节扫描 UTF-16
        // 环境块，依赖 `emitMovzxRegMemByte`，而该原语在当前编码器上产出的字节流
        // 是错的（实测 `movzbq 0x4d(%r10), %r10` —— REX 前缀被当成位移）⇒ 扫描
        // 必然失败、恒返回空缓冲（`envProbe` 里 `V=[] L=0`）。
        //
        // 现在运行库改用 `emitEnvGetWin32`（`GetEnvironmentVariableA`，与运行库既有
        // 的 `__imp_WriteFile` 同一导入机制，链接器从 `kernel32.lib` 解析 ✓ 实测
        // `link=0`），已实测可用 ⇒ 映射切回 `env_get`。
        //
        // ⚠️ 前端发的是**限定后**的名字（`@call @Env_get(...)`），两种拼法都要映射；
        // 并把 `Env_get` 留在跳过名单里，避免 stdlib 那份（光子路径恒返回空串）被发射。
        if (name == "Env.get" || name == "Env_get") { return "env_get" }
        // `Console.println(msg)` / `Console.print(msg)` → runtime 的 `println` / `print`
        //
        // ⚠️ 前端把大写接收者名的成员调用写为 `ClassName_method`
        // （`Hir.aura::lowerCall` 的 P1 fix），因此 `Console.println(msg)`
        // 在 HAT IR 里是 `@Console_println(...)`，而 runtime 实现的名字是
        // `println`（`PhotonRuntime.aura::RUNTIME_SYMBOLS`）。
        // 不加映射会报 `undefined symbol: Console_println`（实测）。
        //
        // 同时覆盖 Rust 前端的 `aura_lang_std_Console_println` 形态
        // （`sanitizeLlvm("aura.lang.std.Console.println")`），
        // 以及 `.` 分隔的 `Console.println` 形态。
        if (name == "Console_println" || name == "Console.println"
            || name == "aura.lang.std.Console.println"
            || name == "aura_lang_std_Console_println") { return "println" }
        if (name == "Console_print" || name == "Console.print"
            || name == "aura.lang.std.Console.print"
            || name == "aura_lang_std_Console_print") { return "print" }
        // `IO.println(msg)` / `IO.print(msg)` → 同上
        if (name == "IO_println" || name == "IO.println"
            || name == "aura.lang.std.IO.println"
            || name == "aura_lang_std_IO_println") { return "println" }
        if (name == "IO_print" || name == "IO.print"
            || name == "aura.lang.std.IO.print"
            || name == "aura_lang_std_IO_print") { return "print" }
        // `Stdio.println(msg)` / `Stdio.print(msg)` → 同上
        if (name == "Stdio_println" || name == "Stdio.println"
            || name == "aura.lang.std.Stdio.println") { return "println" }
        if (name == "Stdio_print" || name == "Stdio.print"
            || name == "aura.lang.std.Stdio.print") { return "print" }
        if (name == "String.charCodeAt" || name == "charCodeAt") { return "charCodeAt" }
        // 2026-10-02：String.substring → runtime 的 String_substring
        //（heapArena bump 副本，越界钳位；薄 VM 宿主链接修复）
        if (name == "substring" || name == "String.substring") { return "String_substring" }
        // 2026-10-08 P1-3：前端闭包里其余 String 成员——TokenUtils / SsaBuilder
        // / MirUtils / Lowering 等大量使用，前端发射**裸名**（见 verify.hat 的
        // `@call @startsWith(@table, ...)`）⇒ 需要在这里按裸名映射到
        // runtime 的 `String_*` 扁平符号。缺一条就 `undefined symbol`。
        if (name == "startsWith" || name == "String.startsWith") { return "String_startsWith" }
        if (name == "charAt" || name == "String.charAt") { return "String_charAt" }
        if (name == "trim" || name == "String.trim") { return "String_trim" }
        // 宿主显式安装 VEH 崩溃转储（jit_vmhost 自检用）。无体 fun 的
        // 裸名映射到 runtime 的 veh_install。
        if (name == "jitVehInstall") { return "veh_install" }
        if (name == "substringBefore" || name == "String.substringBefore") { return "String_substringBefore" }
        if (name == "split" || name == "String.split") { return "String_split" }
        // ── `length()` / `size()` 无接收者显式类型的裸名兜底 ──
        //
        // Hir.aura `calleeNm.length()` / 类似 `str.length()` 在 recvTy 丢失时
        // （recvTy == "Basic" 或 ""）落到裸名 `@call @length(@str, @memTok)`
        // 形式；上面 `recvTy == "String"` 分支不会命中，链接期报
        // `undefined symbol: length`（实测 verify.hat 内 `HirLowerer_lowerValDecl`）。
        // 编译器前端里所有无类型标注的 `length` 都是对 String 的方法调用
        // （Hir/Span/Ast/Mir 的 length 都是 String 或 Span 的 .length），
        // 直接映射到 `strlen`。若将来有非 String 的裸 `length` 需求，需要
        // 在此按 argCount 或末实参类型分流。
        if (name == "length" || name == "size") { return "strlen" }
        // ── `min(a, b)` / `max(a, b)` 静态工具：编译器前端各处私有实现 ──
        // SsaBuilder / PhotonPipeline 各有一份同名 `min` 私有函数；HirLowerer
        // 与 Lowering 里的裸名 `@call @min` 通常都是**两整数取小**。runtime 提供
        // 一个扁平 `min`/`max` 供这些前端调用落地。
        if (name == "min") { return "min" }
        if (name == "max") { return "max" }
        // ── `or` / `and`：`InstructionSelector.analyzePhiPreds` 里的裸布尔 ──
        // HirLowerer 里的 `or` / `and` 都是 Int / Bool 位运算（编译器前端
        // 内部用整数表示布尔），runtime 提供扁平 `or`/`and` 桩即可。
        if (name == "or") { return "or" }
        if (name == "and") { return "and" }
        // ── `emitFunction` 裸名 → `X86Emitter_emitFunction` ──
        //
        // `PhotonPipeline.compileEncodeOnly` 里 `emitter.emitFunction(dag, moduleName)`
        // 在 HAT IR 中落成 `@call @emitFunction(@this, @dag, @moduleName, @MemToken)`
        // （4 参，末参为内存链 token，由 mapStdlibFuncName 的 lastIsMem 分流）。
        // 与 `add` 的三参形态同理——按元数 + 末参是 MemToken 判定：
        //   * 4 参且末为 MemToken → X86Emitter 方法调用（this + 2 实参 + mem）
        // 若不映射，链接期报 `undefined symbol: emitFunction`。
        if (name == "emitFunction" && argCount >= 3 && lastIsMem) {
            return "X86Emitter_emitFunction"
        }
        // ── 列表创建统一到 core 包（[count][cap][itemsPtr@0x10]，push 几何增长；
        // 与 getAt/listAppend 同源，根除两套布局交叉读写——2026-10-06）──
        if (name == "arrayListOf" || name == "mutableListOf") { return "Collections_emptyList" }
        // ── else-if 链修复（Hir.lowerBranch 补 If 用例）后暴露的裸名 ──
        // （2026-10-06，P0-2）先前这些调用随被丢弃的分支一起消失；分支活了
        // 之后第一次到达链接期。映射目标见 PhotonRuntime 各桩的说明。
        if (name == "typeof" || name == "Builtin_typeof") { return "aura_typeof" }
        // P239 诊断：分配器 bump 裸值读取（解码期写手追踪）
        if (name == "HeapDiag_heapbump" || name == "aura_heapbump") { return "aura_heapbump" }
        if (name == "__is_tagged_int") { return "aura_is_tagged_int" }
        // R55: `__range` → `Collections_range`——Hir.aura 的 Range 降级
        // 产出 `HirCall("__range", [start, end, inclusive])`，SsaBuilder
        // buildFor 的迭代器列表构建走这条映射。
        if (name == "__range") { return "Collections_range" }
        if (name == "removeAt") { return "Collections_listPop" }
        if (name == "Collections.count" || name == "aura.lang.std.Collections.count") { return "Collections_count" }
        if (name == "Collections.listAppend" || name == ".Collections.listAppend") { return "Collections_listAppend" }
        if (name == "contains") { return "Collections_contains" }
        if (name == "indexOf") { return "Collections_indexOf" }
        // Clock_clockGettime / ThreadOps_create / IO_readFile / IO_writeFile
        // 的 .hat 裸名即最终符号名，runtime 同名导出，无需映射。
        if (name == "Any.toString") { return "toString" }
        if (name == "Any.equals") { return "streq" }
        // 裸名 + 接收者类型：`s.length()` / `s.size()` / `a.equals(b)`。
        // 只认 String 接收者 —— runtime 的 `strlen` / `streq` 都是按 NUL 结尾
        // C 串实现的，其他接收者不能走这条路。
        if (recvTy == "String" || recvTy == "String?") {
            if (name == "length" || name == "size") { return "strlen" }
            if (name == "equals") { return "streq" }
            if (name == "toString") { return "toString" }
            if (name == "charCodeAt") { return "charCodeAt" }
            if (name == "charAt") { return "String_charAt" }
            if (name == "startsWith") { return "String_startsWith" }
            if (name == "trim") { return "String_trim" }
            if (name == "substringAfter") { return "String_substringAfter" }
            if (name == "substringBefore") { return "String_substringBefore" }
            if (name == "split") { return "String_split" }
            // R44f：裸 contains 兜底是 Collections_contains（列表句柄语义）——
            // String 接收者走它会把串当列表解引用段错误（实测 13 §13.2）。
            // 限定名形态 Collections.contains（recvTy=String 实测 probe_13_2）同治。
            if (name == "contains" || name == "Collections.contains") { return "String_contains" }
            // R44g：guest toUpperCase 在 AOT 下接收者断裂（rcx=0 ⇒ 空串），以臂绕过。
            if (name == "toUpperCase" || name == "String_toUpperCase") { return "String_toUpperCase" }
            // R44g：substring 落 guest 定义同样受接收者断裂影响；runtime 已有
            // String_substring 臂（rcx=str, rdx=begin, r8=end），直接映射。
            if (name == "substring") { return "String_substring" }
            // R44i：Path.join/basename——guest 单例方法接收者断裂家族，
            // runtime 臂零分配/组合实现（13-stdlib §13.5）。
            if (name == "Path_join" || name == "Path.join" || name == "join") { return "Path_join" }
            if (name == "Path_basename" || name == "Path.basename" || name == "basename") { return "Path_basename" }
            // R44i：Env.has——VM 空环境语义恒 false；落 guest 即接收者断裂崩溃。
            if (name == "Env_has" || name == "Env.has") { return "Env_has" }
            // R44i：FileUtils 三件套——VM 沙箱语义(写失败打消息/读空/不存在)。
            if (name == "FileUtils_writeText" || name == "FileUtils.writeText" || name == "writeText") { return "FileUtils_writeText" }
            // R44i：IO.fileExists 的调用点被解析到 guest Stdio_fileExists(模块真名
            // 是 Stdio;实测 probe_io main→Stdio_fileExists,接收者断裂 ⇒ 恒 true)。
            // 直接映射 runtime IO_fileExists 臂(io_access 真实语义)。
            if (name == "IO_fileExists" || name == "IO.fileExists"
                    || name == "Stdio_fileExists" || name == "fileExists") { return "IO_fileExists" }
            if (name == "FileUtils_readText" || name == "FileUtils.readText" || name == "readText") { return "FileUtils_readText" }
            if (name == "FileUtils_exists" || name == "FileUtils.exists" || name == "exists") { return "FileUtils_exists" }
        }
        // 堆列表：`arr[i] = v` 由 HIR 降级为 `.Collections.set(arr, i, v)`
        //（返回容器本身），对应 runtime 的 `__list_setat`。
        // 全限定名来自 Rust 前端；`Collections.set` / `.Collections.set` 来自
        // Aura 自举前端（`HirLowerer.lowerAssign` 直接写 `Collections.set`）——
        // 三种写法都要映射，否则链接期报 `undefined symbol: Collections.set`。
        if (name == "aura.lang.std.Collections.set" || name == "Collections.set"
            || name == ".Collections.set") { return "Collections_listSet" }
        if (name == "aura.lang.std.Collections.get" || name == "Collections.get"
            || name == ".Collections.get") { return "Collections_getAt" }
        // contains/indexOf：HIR 绑定的限定形式（点名直传 runtime 的旧路径已退役）
        if (name == "Collections.contains" || name == ".Collections.contains"
            || name == "aura.lang.std.Collections.contains") { return "Collections_contains" }
        if (name == "Collections.indexOf" || name == ".Collections.indexOf"
            || name == "aura.lang.std.Collections.indexOf") { return "Collections_indexOf" }
        // `Collections.getAt` / `Collections.at`：与 `get` 同语义（`arr[i]` 的读侧），
        // HIR 降级对「带下标的读」写出的名字与 `set` 侧不对称，三种拼法都要命中，
        // 否则链接期报 `undefined symbol: Collections.getAt`（实测自举 Main.aura）。
        if (name == "aura.lang.std.Collections.getAt" || name == "Collections.getAt"
            || name == ".Collections.getAt") { return "Collections_getAt" }
        if (name == "aura.lang.std.Collections.at" || name == "Collections.at"
            || name == ".Collections.at") { return "__list_get" }
        // syscall 封装：`Syscalls.exit(code)` → runtime 的 `exit`
        //（内部为 NtTerminateProcess syscall；参数已在 rcx）。
        if (name == "aura.lang.native.Syscalls.exit" || name == "Syscalls.exit") { return "exit" }
        // Memory 内置操作（首参为 Long 地址）：
        // `Memory.write(addr, val)` → Memory_write（区别于 `FileOps.write(fd, buf, count)` → io_write）
        if (name == "write" && recvTy == "Long") { return "Memory_write" }
        if (name == "read" && recvTy == "Long") { return "Memory_read" }
        if (name == "write16" && recvTy == "Long") { return "Memory_write16" }
        if (name == "read16" && recvTy == "Long") { return "Memory_read16" }
        if (name == "write32" && recvTy == "Long") { return "Memory_write32" }
        if (name == "read32" && recvTy == "Long") { return "Memory_read32" }
        if (name == "write64" && recvTy == "Long") { return "Memory_write64" }
        if (name == "read64" && recvTy == "Long") { return "Memory_read64" }
        if (name == "alloc" && recvTy == "Long") { return "Memory_alloc" }
        if (name == "free" && recvTy == "Long") { return "Memory_free" }
        // FileOps → io_* 避免与 Rust 编译器 native wrapper 符号冲突
        if (name == "write" && recvTy != "Long") { return "io_write" }
        if (name == "read" && recvTy != "Long") { return "io_read" }
        if (name == "open") { return "io_open" }
        if (name == "close") { return "io_close" }
        if (name == "access") { return "io_access" }
        // ⚠️ 前端有两种拼法：裸成员名（`open`，本方法上半段按 `recvTy` 分流）
        // 与**限定下划线名**（`FileOps_open`）。后者命不中上面的裸名规则，
        // 会原样透传 → `lld-link: error: undefined symbol: FileOps_open`
        //（实测自举 `Main.exe`）。这里补上限定形态的别名。
        if (name == "FileOps_open" || name == "FileOps.access") { return "io_open" }
        if (name == "FileOps_close") { return "io_close" }
        if (name == "FileOps_read") { return "io_read" }
        if (name == "FileOps_write") { return "io_write" }
        if (name == "FileOps_access") { return "io_access" }
        // `FileUtils.mkdir(path)` → 模块内**已编译**的 `FileUtils_mkdir`
        //（签名一致：1 个 String 参数）。前端把它发成限定名 `FileOps_mkdir`，
        // 而 runtime 没有 `io_mkdir`，直接映射到模块内实现最省事且语义正确。
        if (name == "FileOps_mkdir" || name == "FileUtils_mkdir" || name == "mkdir") { return "FileUtils_mkdir" }
        // ── 编译器自身的**同名工具函数**：两套定义，靠**元数**区分 ──
        //
        // HAT 实测（自举 Main.aura）：
        //     @fn MirUtils_mirNoKids() -> String                  ← 0 参（顶层函数）
        //     @fn MirUtils_mirKidsAdd(@list, @child) -> String     ← 2 参
        //     @fn Linearizer_mirNoKids(@this: Long) -> String      ← 1 参（方法形态）
        //     @fn Linearizer_mirKidsAdd(@this, @list, @child) -> String ← 3 参
        // 而调用点全是**裸名**（`@call @mirNoKids(...)` ×35、`@call @mirKidsAdd(...)` ×3）
        // 且带接收者（1 参 / 3 参）⇒ 应落到 `Linearizer_*`。此前一律映射到
        // `MirUtils_*`，元数对不上 ⇒ 仍报 `undefined symbol`（实测）。
        if (name == "mirNoKids") {
            if (argCount >= 1) { return "Linearizer_mirNoKids" }
            return "MirUtils_mirNoKids"
        }
        if (name == "mirKidsAdd") {
            if (argCount >= 3) { return "Linearizer_mirKidsAdd" }
            return "MirUtils_mirKidsAdd"
        }
        // ── 三类「arena add」同名方法：靠**接收者类型**消歧（与上面
        //    `Memory.write`（Long）/ `FileOps.write` 同一手法）──
        if (name == "add" && recvTy == "Ast") { return "Ast_add" }
        if (name == "add" && recvTy == "Hir") { return "Hir_add" }
        if (name == "add" && recvTy == "Mir") { return "Mir_add" }
        // ── AST/HIR/MIR arena 工具方法：接收者类型消歧 ──
        //
        // `leaf` / `kidsOf` / `spanOf` 同时被 `Ast`、`Hir`、`Mir` 三个类声明
        //（见各 .aura 的 `fun leaf/kidsOf/spanOf`），全局唯一属主回退必然歧义
        // ⇒ 调用点退化成裸名 ⇒ lld-link `undefined symbol: leaf/kidsOf/spanOf`。
        // 按接收者类型分流到各自的 `<Class>_<method>`。
        if (name == "leaf" && recvTy == "Ast") { return "Ast_leaf" }
        if (name == "leaf" && recvTy == "Hir") { return "Hir_leaf" }
        if (name == "leaf" && recvTy == "Mir") { return "Mir_leaf" }
        if (name == "kidsOf" && recvTy == "Ast") { return "Ast_kidsOf" }
        if (name == "kidsOf" && recvTy == "Hir") { return "Hir_kidsOf" }
        if (name == "kidsOf" && recvTy == "Mir") { return "Mir_kidsOf" }
        if (name == "spanOf" && recvTy == "Ast") { return "Ast_spanOf" }
        if (name == "spanOf" && recvTy == "Hir") { return "Hir_spanOf" }
        if (name == "spanOf" && recvTy == "Mir") { return "Mir_spanOf" }
        if (name == "kindOf" && recvTy == "Ast") { return "Ast_kindOf" }
        if (name == "kindOf" && recvTy == "Hir") { return "Hir_kindOf" }
        if (name == "kindOf" && recvTy == "Mir") { return "Mir_kindOf" }
        if (name == "textOf" && recvTy == "Ast") { return "Ast_textOf" }
        if (name == "textOf" && recvTy == "Hir") { return "Hir_textOf" }
        if (name == "textOf" && recvTy == "Mir") { return "Mir_textOf" }
        if (name == "childOf" && recvTy == "Ast") { return "Ast_childOf" }
        if (name == "childOf" && recvTy == "Hir") { return "Hir_childOf" }
        if (name == "childOf" && recvTy == "Mir") { return "Mir_childOf" }
        if (name == "tyOf" && recvTy == "Ast") { return "Ast_tyOf" }
        if (name == "tyOf" && recvTy == "Hir") { return "Hir_tyOf" }
        if (name == "tyOf" && recvTy == "Mir") { return "Mir_tyOf" }
        // ── 兜底：接收者类型未正确传播（`Basic` / `""`）时的启发式 ──
        //
        // `Hir.aura::lowerMember` 未把字段声明类型写到 HirNode.ty，导致
        // `receiverClassOf` 对 `this.kids` / `ast.kidsOf(id)` 这类调用返回 ""。
        // 此时 `resolveMethodSymbol` 的三级回退全部失手 ⇒ 裸名透传。
        // 这三个方法名在自举编译器里**只被 Ast/Hir/Mir 声明**，且它们的首参
        // 都是 `this`（接收者），其余实参个数各不相同：
        //   * leaf(kind, text, sp)   → argCount = 4（this + 3 参）
        //   * kidsOf(id)             → argCount = 2（this + 1 参）
        //   * spanOf(id)             → argCount = 2（this + 1 参）
        // 而 Hir/Mir 的同名方法签名完全相同 ⇒ 无法按元数区分。
        // 但实测（HANDOFF §P6）自举 `Main.exe` 的未定义符号全是 Ast 侧的
        // （Parser / Hir / SsaBuilder 调用 `ast.leaf` / `ast.kidsOf` / `ast.spanOf`）
        // ⇒ 兜底到 `Ast_*` 是最合理的默认。
        if (name == "leaf" && recvTy != "Hir" && recvTy != "Mir") { return "Ast_leaf" }
        if (name == "kidsOf" && recvTy != "Hir" && recvTy != "Mir") { return "Ast_kidsOf" }
        if (name == "spanOf" && recvTy != "Hir" && recvTy != "Mir") { return "Ast_spanOf" }
        // 同类 Ast 工具方法（`kindOf` / `textOf` / `childOf` / `tyOf`）：
        // 与 `leaf`/`kidsOf`/`spanOf` 同源 —— 三个类同时声明、`receiverClassOf`
        // 返回 ""、裸名透传。实测自举 Main.exe 全部是 Ast 侧的调用。
        if (name == "kindOf" && recvTy != "Hir" && recvTy != "Mir") { return "Ast_kindOf" }
        if (name == "textOf" && recvTy != "Hir" && recvTy != "Mir") { return "Ast_textOf" }
        if (name == "childOf" && recvTy != "Hir" && recvTy != "Mir") { return "Ast_childOf" }
        if (name == "tyOf" && recvTy != "Hir" && recvTy != "Mir") { return "Ast_tyOf" }
        // ── 集合方法（裸名）：接收者类型**带类型参数**（`List<Any>`、
        //    `Map<String,Int>`），按等值匹配必然失手，必须用**前缀**判定 ──
        //
        // 定义名取自 HAT：`ArrayList_add(@this, @item)`、`HashMap_keys(@this)`。
        // 实测自举 `Main.exe` 的两个残留未定义符号正是这两个：`add` ←
        // `VmStack_push`（`__field_get(this,0) : List<Any>` 后接 `.add(v)`）、
        // `keys` ← `Codegen_varTableStr`。用 `recvTy == "List"` 之类的等值判断
        // 永远命中不了（类型名里有 `<...>`），这是上一次改造没生效的原因。
        if (name == "add" && recvTy.indexOf("List") >= 0) { return "Collections_listAppend" }
        // ⚠️ 集合的 `add` 还有一种**三参**形态：`add(this, item, memToken)`
        //（调用点把内存链 token 作为最后一个实参，见 HAT 的 `@MemToken`）。
        // 这时**不能用类型判定**：接收者常来自 `arrayListOf(...)`，HAT 把它的类型
        // 标注成 `Basic`（不是 `List<...>`）⇒ 按类型的前缀/包含判定必然失手
        //（实测自举 `Main.exe` 最后的未定义符号 `add` 就来自
        // `HashMap_keys` 与 `AucLoaderUtils_loadModule` 里的这种调用）。
        //
        // 判据是**末实参为内存链 token**（`MemToken`），而不是单纯的「元数 ≥3」：
        // 后者会把 `Lexer_emit` 等处的同名三参 `add` 也映射成集合版 ——
        // 实测导致自举 `Main.exe` 在 `BOOT-1` 之后直接 `0xC0000005`。
        //
        // 集合版形如 `add(this, item, memToken)`；HAT 实测两处残余未定义
        //（`HashMap_keys`、`AucLoaderUtils_loadModule`）的第 3 实参正是
        // `@MemToken(...)` ✓，而 `Lexer_emit` 那处不是 ✓ —— 判据可精确区分。
        // `VmOps_add(@a, @b)`（VM 算术 `+`）两参、无 mem token，天然不受影响。
        // 目标 `ArrayList_add(@this, @item)` 只用 rcx/rdx，多传的 r8 被忽略，
        // 因此三参调用点绑到它**语义与 ABI 都安全**。
        if (name == "add" && lastIsMem) { return "Collections_listAppend" }
        if (name == "keys" && recvTy.indexOf("HashMap") >= 0) { return "HashMap_keys" }
        if (name == "keys" && recvTy.indexOf("Map") >= 0) { return "HashMap_keys" }
        // ── 元数兜底（判据来自**全量实测**，不是猜测）──
        //
        // HAT 实测自举 `Main.aura`：
        //     `@call @add(...)`  共 **217 处，全部 3 参**
        //     `@call @keys(...)` 共 **1 处，2 参**
        // 而候选实现在元数上是**唯一**的：
        //     `ArrayList_add(@this, @item)` 2 参 / `Ast_add`/`Hir_add`/`Mir_add` 各 **6 参**
        //     `HashMap_keys(@this)` 1 参 / `EnvOps_keys()` 0 参
        // ⇒ 3 参的 `add` 只可能是「集合 add + 内存链 token」，2 参的 `keys` 只可能是
        // `HashMap_keys`。前面基于接收者类型/MemToken 的判定在这些调用点上都不命中
        //（接收者类型常被标注成 `Basic`，见 HAT），故在此按元数兜底。
        // P40x-l：元数兜底加 **lastIsMem 门槛**——集合约定的 add(list, item, mem)
        // 尾参恒为 mem token；用户同名重载 add(1, 2, 3) 无 mem 尾参。无门槛时
        // 用户三参 add 被劫持成 listAppend（实测 17-function-overload：
        // add(1,2,3) → Collections_push 段错误）。
        if (name == "add" && lastIsMem && argCount >= 3) { return "Collections_listAppend" }
        if (name == "keys" && lastIsMem && argCount >= 2) { return "HashMap_keys" }
        // Collections.listRemove(list, idx) → 运行时移除元素
        if (name == "aura.lang.std.Collections.listRemove" || name == "Collections.listRemove"
            || name == ".Collections.listRemove" || name == "remove") { return "Collections_listPop" }
        // ── P40x-g：非 String 接收者的裸 toString → toStr ──
        // runtime 裸 toString 是恒等占位（mov rax,rcx;ret）——String 接收者
        // 恒等正确（recvTy=="String" 分支已返回），其余已知标量接收者恒等
        // = 原始值当串指针 → 拼接/打印段错误（实测 p15、01-lexer §1.3）。
        if (name == "toString"
                && (recvTy == "Int" || recvTy == "Long" || recvTy == "Boolean"
                    || recvTy == "Char" || recvTy == "Short" || recvTy == "Byte")) {
            return "toStr"
        }
        // ── P40x-m：裸 toStr 的接收者是 Any / 未知时 → toStrN ──
        // channelRecv 等返回 Any 的值可能是 null（原生表示 0）；VM 参考的
        // 裸 toStr 是 null 感知的（08-concurrency recv1=null）。标量接收者
        // （上一分支形态）保持 toStr 不变；String 恒等不经过这里。
        if (name == "toStr"
                && (recvTy == "Any" || recvTy == "Any?" || recvTy == ""
                    || recvTy == "Basic")) {
            return "toStrN"
        }
        // R44g：裸 toStr(Boolean) → boolToStr（VM 打 true/false，runtime toStr 只认整数打 1/0）。
        if (name == "toStr" && (recvTy == "Boolean" || recvTy == "Bool")) { return "boolToStr" }
        // ── P40x-m：Thread / Channel extern 单例 → runtime 原语臂 ──
        // guest 包装的内部原语调用被前端解析成返回 0 的裸桩（实测
        // 08-concurrency cores=0）；调用点直接映射到 runtime 同名臂。
        // VM 参考语义：threadId=1（主线程仿真）、parallelism==cores。
        if (name == "Thread_availableCores" || name == "Thread.availableCores") { return "ThreadOps_cores" }
        if (name == "Thread_parallelism" || name == "Thread.parallelism") { return "ThreadOps_cores" }
        if (name == "Thread_id" || name == "Thread.id") { return "ThreadOps_currentId" }
        if (name == "cores") { return "ThreadOps_cores" }
        if (name == "currentId") { return "ThreadOps_currentId" }
        // ── P40x-b：点归一兜底 ──
        // 限定名 Collections.pairOf 的模块定义是下划线形态 Collections_pairOf
        //（HAT 实测 01-lexer）。emitCall 侧 resolveCalleeSymbol 点归一后发射，
        // 但可达性的 mapped 入队只认本函数返回——不在此归一，定义被 DCE 剪掉。
        // ⚠️ 判点必须用 charCodeAt 扫描——String.indexOf 会被本函数映射到
        // Collections_indexOf（字符串被当列表走），实测驱动段错误。
        var hasDot: Boolean = false
        var di: Int = 0
        while (di < name.length) {
            if (name.charCodeAt(di) == 46) {
                hasDot = true
                di = name.length
            } else {
                di = di + 1
            }
        }
        if (hasDot) {
            val und: String = this.dotToUnderscore(name)
            if (this.listContains(this.lirFuncNames, und)) { return und }
        }
        // ── P40x-b：裸 get 歧义兜底 ──
        // Env.get("OS","unknown") 自举前端发裸名 get（扁平命名空间）。X_get
        // 候选多个 → resolveCalleeSymbol 歧义透传 → undefined（实测 13-stdlib）。
        // 语料中每个裸 get 都有唯一后缀命中（否则宿主早已链接失败），
        // 故仅在非唯一命中时落到 env_get，语料零影响。
        if (name == "get" && !this.listContains(this.lirFuncNames, "get")) {
            var gcnt: Int = 0
            var gi: Int = 0
            while (gi < this.lirFuncNames.size) {
                if (endsWithStr(this.lirFuncNames[gi], "_get")) {
                    gcnt = gcnt + 1
                    if (gcnt > 1) { return "env_get" }
                }
                gi = gi + 1
            }
            if (gcnt == 0) { return "env_get" }
        }
        return name
    }

    /// 发射字符串判等（`streq` 调用 + `cmp` + `setcc`）。
    ///
    /// 结果节点（= 本 LIR 值）是 setcc 节点；`streq` 调用结果先落在一个
    /// 临时 Call 节点上，再 `cmp <call>, 0`。
    private fun emitStreqSetcc(val: LirValue, vid: Int,
                               lhsNode: Int, rhsNode: Int): Int {
        val callNode: Int = this.dag.addNode("Value", "Call", val.type,
                                             "", "", "", this.curChain, "streq")
        val cn: DagNode = this.dag.nodeOf(callNode)
        cn.args = MachineDagUtils.toStr(lhsNode) + "," + MachineDagUtils.toStr(rhsNode)
        this.dag.selectPattern(50, MachineDagUtils.toStr(callNode), -1)

        // cmp <call>, 0 → ZF/其它标志位由 streq 的返回值决定。
        this.dag.selectPattern(20, MachineDagUtils.toStr(callNode) + ",0", -1)

        val setccNode: Int = this.dag.addNode("Value", val.op, val.type,
                                              "", "", "", this.curChain, val.op)
        this.registerNode(vid, setccNode)
        val setccId: Int = this.dag.selectPattern(40,
                              MachineDagUtils.toStr(setccNode), setccNode)
        val instr: DagInstruction = this.dag.instrOf(setccId)
        // streq 返回 1 表示相等：本 setcc 物化的是「streq 结果」这个布尔值。
        //   ICmpEq 的值 = (streq 结果 != 0) ⇒ setne；
        //   ICmpNe 的值 = (streq 结果 == 0) ⇒ sete。
        // ⚠️ 旧实现按比较符字面映射（Eq→"e" / Ne→"ne"），与 setcc 语义正好
        // 相反 ⇒ 所有走到本路径的判等**整体取反**：实测 fs 探针
        // `if (s == null)` 变成「非空才进 null 分支」⇒ strlen(NULL)
        // 0xC0000005（2026-10-03，与 HatParser 的 @null aux 丢失叠加）。
        if (val.op == "ICmpNe") {
            instr.cond = "e"
        } else {
            instr.cond = "ne"
        }
        return setccNode
    }

    // ── 发射：栈操作 ──

    /// 发射栈操作指令。
    private fun emitStackOp(val: LirValue, vid: Int): Int {
        val nodeId: Int = this.dag.addNode("Value", val.op, val.type,
                                           "", "", "", this.curChain, this.argsJoin(val.args))
        this.registerNode(vid, nodeId)
        return nodeId
    }

    // ── 发射：Call ──

    /// 取第一个实参（方法调用的接收者）的类型名，供裸名补齐用。
    ///
    /// `SsaBuilder.buildCall` 对方法调用把接收者放在**第一个**实参，所以
    /// `args[0]` 就是接收者。跳过内存链 token（`MemToken`）—— 它只可能是
    /// **最后一个**参数，这里只在 `args[0]` 上判断。
    private fun callReceiverTypeName(args: List<Int>): String {
        if (args.size < 1) { return "" }
        val a0: Int = args[0]
        if (a0 < 0) { return "" }
        val v: LirValue = this.lir.valueOf(a0)
        if (v.op == "MemToken" || v.aux == "entry_mem" || v.aux == "mem_after_store") {
            return ""
        }
        return this.types.typeNameOf(v.type)
    }

    /// 发射 Call 指令。
    private fun emitCall(val: LirValue, vid: Int): Int {
        // 解析参数（Lir P2.2：args 已是类型化 ValueID 列表，直接下标访问）。
        val args: List<Int> = val.args
        // P390 诊断：escapeConstValue 内的 emitCall 调用（独立计数，前 20）。
        if (this.phiDiagOn && this.diagCeCnt < 60
                && this.funcName == "AucLoaderUtils_escapeConstValue") {
            this.diagCeCnt = this.diagCeCnt + 1
            println("[CE] fn=[" + this.funcName + "] aux=" + val.aux
                    + " n=" + MachineDagUtils.toStr(args.size))
        }

        // ⚠️ 这里**不能**对 `args[0]` 调 `resolveNode`：`resolveNode` 在查不到
        // 映射时会**现场发射**该值（`selectValue`），于是把一个属于**后面的块**
        // 的值提前发射到当前块里。实测 P2/01_nested_loop：外层循环结束块里的
        // `toStr(sum)` 其实参是内层循环体里的 `sum + i + j`，提前发射后
        // 内层循环体里就只剩增量语句 —— 累加结果恒为 6。
        // 且 `funcNode` 从未被使用（被调函数名在 `val.aux`），本就是死代码。

        // 创建 Call 节点并据它选择 pattern 50（"call %func"）。
        //
        // ⚠ 顺序与指向很关键：`call` 指令的 `nodes` 必须指向**Call 节点本身**
        // （其 `aux` 才是被调函数名）。旧实现把「第一个实参的 DAG 节点」当成
        // funcNode 传进去，发射器于是读到该实参的 aux —— 对字符串实参就是
        // `@str.N`，会生成 `call @str.N`（即便寄存器就绪也会链到错误符号）。
        // 接收者类型（仅用于裸名补齐，见 `mapStdlibFuncName`）。
        // 只 `valueOf` 读类型，**不能** `resolveNode`（见上面的 ⚠️）。
        val recvTy: String = this.callReceiverTypeName(args)
        val funcName: String = this.mapStdlibFuncName(val.aux, recvTy, args.size,
                                                      this.lastArgIsMemToken(args))
        // 2026-10-02：映射后仍无定义的裸名 → 唯一后缀匹配兜底（见
        // `resolveCalleeSymbol` 的说明；与可达性入队配套，定义必已被编码）。
        val resolvedName: String = this.resolveCalleeSymbol(funcName, recvTy)

        // ── P40x-l：toString(<单实参>)（Parser 为 str + 非String / 插值合成）
        // → emitToStrConvNode 按类型分派。runtime 裸 toString = 恒等占位
        //（标量/null 被当串指针，实测 06 nullInt= 空串）。
        if ((resolvedName == "toString" || funcName == "toString")
                && args.size == 1) {
            val a0Node: Int = this.resolveNode(args[0])
            if (a0Node >= 0) {
                val convId: Int = this.emitToStrConvNode(args[0], a0Node)
                this.registerNode(vid, convId)
                return convId
            }
        }

        // ── P40x：`<X>_toString` mangle 兜底 ──
        // 前端把非类接收者的 .toString() 按 接收者文本_method mangle（如
        // DEC_INT_toString），既非本模块定义也非 runtime 符号 → 链接 undefined
        //（语言测试 01-lexer 实测 14 个）。识别后按接收者原始值的字符串转换
        // 处理；用户类真有 Foo_toString 定义时不触发。
        if (endsWithStr(resolvedName, "_toString")
                && !this.listContains(this.lirFuncNames, resolvedName)
                && !this.isRuntimeSymbol(resolvedName) && args.size >= 1) {
            val a0Node: Int = this.resolveNode(args[0])
            if (a0Node >= 0) {
                val convId: Int = this.emitToStrConvNode(args[0], a0Node)
                this.registerNode(vid, convId)
                return convId
            }
        }

        // ── P40x：println/print 的非 String 首实参 ⇒ 前置字符串转换 ──
        // runtime println 只认 char*；println(intVal) 裸传即解引用整数值
        //（实测 p10 AV @0x4）。
        val wrapPrintArg: Boolean = (resolvedName == "println" || resolvedName == "print")

        // ── 特例：`toStr(<Bool 常量>)` ──
        //
        // runtime 的 toStr 只认整数 → `toStr(true)` 会打印 `1`，而语言语义
        //（以及 VM 参考实现）要求 `true`。这里直接把常量折叠成字符串常量
        // `"true"` / `"false"`（生成 `lea %dst, @str.N`），无需改 runtime。
        if (funcName == "toStr" && args.size >= 1) {
            val a0: Int = args[0]
            if (a0 >= 0) {
                val argVal: LirValue = this.lir.valueOf(a0)
                // Lowering 把 `Const` 改写成 `ConstImm`，两种都认
                val isConst: Boolean = argVal.op == "Const" || argVal.op == "ConstImm"
                if (isConst && this.types.isBool(argVal.type)) {
                    val lit: String = if (argVal.aux == "1") "\"true\"" else "\"false\""
                    return this.emitStringConstNode(vid, lit)
                }
            }
        }

        val nodeId: Int = this.dag.addNode("Value", "Call", val.type,
                                           "", "", "", this.curChain, resolvedName)
        this.registerNode(vid, nodeId)

        // 把**实参节点**记到 Call 节点的 `args`，供发射器按 Win64 约定装载
        // rcx/rdx/r8/r9（见 `X86Emitter.emitCallArgs`）。
        //
        // 需要跳过内存链 token：`SsaBuilder.buildCall` 会把当前 mem 状态作为
        // **最后一个**实参追加进来（OP 为 `MemToken` / aux 为 entry_mem|mem_after_store），
        // 它只是内存依赖建模，不是真正的函数参数。
        // ⚠️ 2026-09-29：用 List<Int> 累积 argNode，避免每次 O(n) 字符串拼接。
        val argNodeList: List<Int> = arrayListOf<Int>()
        var k: Int = 0
        var seenReal: Boolean = false
        while (k < args.size) {
            val argLirId: Int = args[k]
            val argVal: LirValue = this.lir.valueOf(argLirId)
            val isMemToken: Boolean = argVal.op == "MemToken"
                || argVal.aux == "entry_mem" || argVal.aux == "mem_after_store"
            if (!isMemToken) {
                val argNode: Int = this.resolveNode(argLirId)
                if (this.phiDiagOn && this.diagCallArgCnt < 400
                        && (resolvedName == "VmOps_vmSubstr"
                            || resolvedName == "__field_get")) {
                    this.diagCallArgCnt = this.diagCallArgCnt + 1
                    println("[CAL] fn=" + this.funcName + " call=" + MachineDagUtils.toStr(vid)
                            + " arg" + MachineDagUtils.toStr(k) + " lir=" + MachineDagUtils.toStr(argLirId)
                            + " op=" + argVal.op + " node=" + MachineDagUtils.toStr(argNode))
                }
                if (argNode >= 0) {
                    // P40x：println/print 首个真实实参非 String ⇒ 包转换
                    if (wrapPrintArg && !seenReal
                            && !this.types.isString(argVal.type)
                            && this.types.nameOf(argVal.type) != "String"
                            && !endsWithStr(this.types.nameOf(argVal.type), "|String")) {
                        argNodeList.add(this.emitToStrConvNode(argLirId, argNode))
                    } else {
                        argNodeList.add(argNode)
                    }
                    seenReal = true
                }
            }
            k = k + 1
        }
        // 按需拼字符串（仅调用者需要逗号分隔字符串时）。
        var argNodes: String = ""
        var ai: Int = 0
        while (ai < argNodeList.size) {
            if (ai == 0) {
                argNodes = MachineDagUtils.toStr(argNodeList[ai])
            } else {
                argNodes = argNodes + "," + MachineDagUtils.toStr(argNodeList[ai])
            }
            ai = ai + 1
        }
        val callNode: DagNode = this.dag.nodeOf(nodeId)
        callNode.args = argNodes

        this.dag.selectPattern(50, MachineDagUtils.toStr(nodeId), -1)
        return nodeId
    }

    // ── 发射：Ret ──

    /// 发射 Ret 指令。
    ///
    /// ⚠️ 方法名必须唯一：Aura 的类方法分发**不支持同名重载**——后定义的同名
    /// 方法会整体遮蔽先定义者（实测 `emitRet(reg: Int)` 遮蔽本函数，导致 Ret
    /// 的返回值节点被写成 `vid` 而非值节点，函数返回值永远错）。
    private fun emitRetValue(val: LirValue, vid: Int): Int {
        var regNode: Int = -1
        if (val.args.size > 0) {
            regNode = this.resolveNode(val.args[0])
        }
        val nodes: String = ""
        if (regNode >= 0) {
            nodes = MachineDagUtils.toStr(regNode)
        }
        this.dag.selectPattern(30, nodes, -1)
        return -1
    }

    // ── 发射：Br ──

    /// 发射 Br（无条件跳转）指令。
    private fun emitBr(val: LirValue, vid: Int): Int {
        val args: List<Int> = val.args
        if (args.size > 0) {
            val targetBlockId: Int = args[0]
            val targetLabel: String = this.lookupLabel(targetBlockId)
            val nodes: String = targetLabel
            this.dag.selectPattern(31, nodes, -1)
        }
        return -1
    }

    // ── 发射：CondBr ──

    /// 发射 CondBr（条件跳转）指令。
    ///
    /// 语义：`CondBr(cond, thenBlock, elseBlock)` →
    /// ```asm
    /// cmp cond, 0
    /// jne thenLabel
    /// jmp elseLabel      ; 只有 args 给了第三个块才发
    /// ```
    /// 块布局：SSA 里 then/body 块紧跟在当前块之后创建，因此**落到 then**、
    /// 显式 `jmp else` 跳过 then 块才是正确的。
    ///
    /// 旧实现只发了一条裸 `jcc ne thenLabel`：既没有 `cmp`（标志位取自上一条
    /// 无关指令）、也没有 else 边 —— 实测 `if/else` 两个分支都执行，
    /// `while` 的退出块不可达（循环体后代码全被丢掉）。
    private fun emitCondBr(val: LirValue, vid: Int): Int {
        val args: List<Int> = val.args
        if (args.size >= 2) {
            val condId: Int = args[0]
            val thenBlockId: Int = args[1]
            val thenLabel: String = this.lookupLabel(thenBlockId)

            // cond 是 0/1（setcc + 零扩展），与 0 比较后按 ne 跳转。
            val condNode: Int = this.resolveNode(condId)
            if (condNode >= 0) {
                this.dag.selectPattern(20, MachineDagUtils.toStr(condNode) + ",0", -1)
            }

            val jccId: Int = this.dag.selectPattern(32, thenLabel, -1)
            val jccInstr: DagInstruction = this.dag.instrOf(jccId)
            jccInstr.cond = "ne"

            // else / 循环退出块：紧跟其后的无条件跳转
            if (args.size >= 3) {
                val elseBlockId: Int = args[2]
                val elseLabel: String = this.lookupLabel(elseBlockId)
                if (elseLabel != "") {
                    this.dag.selectPattern(31, elseLabel, -1)
                }
            }
        }
        return -1
    }

    // ── 辅助方法 ──

    /// 解析节点：如果已有映射则返回，否则创建占位。
    private fun resolveNode(vid: Int): Int {
        if (vid < 0) { return -1 }
        val mapped: Int = this.lookupNode(vid)
        if (mapped >= 0) {
            return mapped
        }
        // 如果 LIR 程序可用，尝试查找。
        if (this.lir != null) {
            val val: LirValue = this.lir.valueOf(vid)
            if (val.op != "") {
                return this.selectValue(vid, this.lir.blockOf(vid).id, this.lir)
            }
        }
        return -1
    }

    /// 检查节点是否为常量。
    private fun isConstNode(nodeId: Int): Boolean {
        if (nodeId < 0) { return false }
        val node: DagNode = this.dag.nodeOf(nodeId)
        return node.kind == "Const"
    }

    /// 获取算术运算的 pattern ID。
    private fun arithPatternId(op: String): Int {
        if (op == "Add") { return 1 }    // add %dst, %src
        if (op == "Sub") { return 3 }    // sub %dst, %src
        if (op == "Mul") { return 5 }    // imul %dst, %src
        if (op == "And") { return 8 }    // and %dst, %src
        if (op == "Or") { return 9 }     // or %dst, %src
        if (op == "Xor") { return 13 }   // xor %dst, %src
        if (op == "SDiv") { return 14 }  // div %dst, @imm
        if (op == "SRem") { return 15 }  // rem %dst, @imm
        if (op == "Shl") { return 18 }   // shl %dst, %src
        if (op == "Shr") { return 19 }   // shr %dst, %src
        // R57: 浮点运算——xmm 寄存器 VEX 指令
        if (op == "AddF") { return 70 }  // vaddpd %dst, %src
        if (op == "SubF") { return 71 }  // vsubpd %dst, %src
        if (op == "MulF") { return 72 }  // vmulpd %dst, %src
        if (op == "DivF") { return 73 }  // vdivpd %dst, %src
        return 1  // fallback to add
    }

    /// 映射比较操作到条件字符串。
    private fun mapCmpOpToCond(op: String): String {
        if (op == "SEq" || op == "ICmpEq" || op == "OEq" || op == "UEq") { return "eq" }
        if (op == "SNe" || op == "ICmpNe" || op == "ONe" || op == "UNe") { return "ne" }
        if (op == "Slt" || op == "ICmpSlt" || op == "Olt") { return "lt" }
        if (op == "Sgt" || op == "ICmpSgt" || op == "Ogt") { return "gt" }
        if (op == "Sle" || op == "ICmpSle" || op == "Ole") { return "le" }
        if (op == "Sge" || op == "ICmpSge" || op == "Oge") { return "ge" }
        if (op == "ICmpUlt" || op == "Ult") { return "ubl" }
        if (op == "ICmpUgt" || op == "Ugt") { return "uog" }
        if (op == "ICmpUle" || op == "Ule") { return "ule" }
        if (op == "ICmpUge" || op == "Uge") { return "uge" }
        if (op == "Ult") { return "ubl" }
        if (op == "Ugt") { return "uog" }
        if (op == "Ule") { return "ule" }
        if (op == "Uge") { return "uge" }
        return "eq"
    }

    // ── 标签管理 ──

    /// 注册块 ID → 标签名映射。
    private fun registerLabel(blockId: Int, label: String): Unit {
        if (blockId < 0) { return }
        while (this.labelNames.size <= blockId) { this.labelNames.add("") }
        this.labelNames[blockId] = label
    }

    /// 查找块 ID 对应的标签名。
    ///
    /// ⚠️ 行尾判定必须用 `charCodeAt(pos) == 10`：旧实现写的是
    /// `this.labelMap[pos] == "\n"`，而 **Aura 的 String 下标在本 VM 下不可用**
    /// （Char 与 String 比较恒不等），于是循环只在 `pos == len` 时进入行分支，
    /// 整个表被当成一行处理 —— 查找实际恒失败、只能走 `bb<id>` 兜底。
    /// 兜底名恰好与 `selectBlock` 现在的命名一致，所以此前“看起来能用”，
    /// 但任何命名约定变化都会立刻退化成标签解析失败。
    private fun lookupLabel(blockId: Int): String {
        if (blockId >= 0 && blockId < this.labelNames.size) {
            val s: String = this.labelNames[blockId]
            if (s != "") { return s }
        }
        return "bb" + LirUtils.toStr(blockId)
    }

    // ── 发射方法（保留向后兼容）──

    /// 发射 ADD 立即数指令。
    fun emitAddImm(dst: Int, src: Int, imm: Int): Int {
        val immStr: String = MachineDagUtils.toStr(imm)
        val nodes: String = MachineDagUtils.toStr(src) + "," +
                            MachineDagUtils.toStr(dst) + "," + immStr
        return this.dag.selectPattern(0, nodes, dst)
    }

    // ⚠️ 不要在此类中新增与 private 实现同名的 arity-1 helper（如
    // `emitMov(dst, src)` / `emitRet(reg)`）：Aura 类方法不支持重载，
    // 后定义者会遮蔽前面的 LirValue 版本，且遮蔽是**静默**的。

    /// 发射 MOV 内存操作数指令。
    fun emitMovMem(dst: Int, addr: Int, offset: Int): Int {
        val addrStr: String = "[" + MachineDagUtils.toStr(addr)
        if (offset != 0) {
            addrStr = addrStr + "+[offset:" + MachineDagUtils.toStr(offset) + "]"
        } else {
            addrStr = addrStr + "]"
        }
        val nodes: String = MachineDagUtils.toStr(dst) + "," + addrStr
        val outputNode: Int = dst
        val patternId: Int = if (dst >= 0) 10 else 11
        return this.dag.selectPattern(patternId, nodes, outputNode)
    }

    /// 发射 CALL 指令（按节点 ID 形态）。
    ///
    /// ⚠ 名字必须与 `emitCall(val: LirValue, vid: Int)` **不同**：
    /// Aura 是扁平命名空间、按**名字**解析（不按签名重载）。两者同名时，
    /// `selectInstr` 里的 `this.emitCall(val, vid)` 会绑到本重载 —— `val`
    /// （一个 `LirValue` 引用）被塞进 `funcNode: Int` 形参，`MachineDagUtils.toStr`
    /// 对它取不到数值 → 返回**空串** → 生成 `nodes=""` 的 `call %func` 指令，
    /// 发射器 `emitCall` 的 `nodes.size >= 1` 守卫直接跳过 → 机器码里**一个
    /// `e8` 都没有**（实测：helloworld 的 `println` 被整条丢掉）。
    /// 本重载当前**没有调用点**，保留供测试/外部使用。
    fun emitCallNode(funcNode: Int, argc: Int): Int {
        val nodes: String = MachineDagUtils.toStr(funcNode)
        return this.dag.selectPattern(50, nodes, -1)
    }

    /// 发射 SETcc 指令。
    fun emitSetcc(dst: Int, cond: String): Int {
        val nodes: String = MachineDagUtils.toStr(dst)
        val id: Int = this.dag.selectPattern(40, nodes, dst)
        val instr: DagInstruction = this.dag.instrOf(id)
        instr.cond = cond
        return id
    }

    /// 发射 CMP 指令。
    fun emitCmp(src: Int, imm: Int): Int {
        val nodes: String = MachineDagUtils.toStr(src) + "," +
                            MachineDagUtils.toStr(imm)
        return this.dag.selectPattern(20, nodes, -1)
    }


    /// 发射 JMP 指令。
    fun emitJmp(target: Int): Int {
        val nodes: String = MachineDagUtils.toStr(target)
        return this.dag.selectPattern(31, nodes, -1)
    }

    /// 发射 Jcc 条件跳转指令。
    fun emitJcc(cond: String, target: Int): Int {
        val id: Int = this.dag.selectPattern(32,
            MachineDagUtils.toStr(target), -1)
        val instr: DagInstruction = this.dag.instrOf(id)
        instr.cond = cond
        return id
    }

    // ── 节点映射管理 ──

    /// 注册 LIR ID → DAG ID 映射（首次注册优先，与旧「全表扫描取首条」语义一致）。
    ///
    /// ⚠️ 用下标读写 `List`：本 VM 下 `list.get(i)` 未链接（静默返回 null），
    /// `list.set(i, v)` 亦不可靠；`list[i]` / `list[i] = v` 才是可用路径。
    private fun registerNode(lirId: Int, dagId: Int): Unit {
        if (lirId < 0) { return }
        while (this.nodeMapIds.size <= lirId) { this.nodeMapIds.add(-1) }
        if (this.nodeMapIds[lirId] < 0) {
            this.nodeMapIds[lirId] = dagId
            // P372：该 vid 若被某 phi 认领，其**定义节点**的栈槽别名到
            // phi 节点的槽（定义写 = phi 写；MOV 退化为自拷贝）。
            val phiNode: Int = this.phiClaimTarget(lirId)
            if (phiNode >= 0 && dagId != phiNode) {
                this.slotAliasFrom.add(dagId)
                this.slotAliasTo.add(phiNode)
            }
        }
    }

    /// 查找 LIR ID 对应的 DAG ID（O(1)）。
    private fun lookupNode(lirId: Int): Int {
        if (lirId < 0 || lirId >= this.nodeMapIds.size) { return -1 }
        return this.nodeMapIds[lirId]
    }

    /// 生成下一个临时值计数器。
    private fun genTmp(): Int {
        val id: Int = this.tmpCount
        this.tmpCount = this.tmpCount + 1
        return id
    }

    // ── Phase C: 寻址模式融合 ──

    /// Load/Store 对消除（Phase C 寻址模式融合）。
    ///
    /// 查找 DAG 中 Load 后紧跟 Store 的模式（Load 的结果只被同一 Store 使用），
    /// 将 Load 和 Store 指令合并为 NOP（消除冗余内存操作）。
    /// 同时调用 DagPatterns.matchLoadStorePair 进行 DAG 级模式匹配。
    private fun fuseLoadStorePairs(): Unit {
        val instrs: List<DagInstruction> = this.dag.instrs
        var changed: Boolean = true
        var iterations: Int = 0

        while (changed && iterations < 10) {
            changed = false
            iterations = iterations + 1

            var i: Int = 0
            while (i < instrs.size - 1) {
                val instr: DagInstruction = instrs[i]
                val next: DagInstruction = instrs[i + 1]

                // 检查 Load → Store 紧邻对
                // 模板格式与 X86Emitter 一致
                if (instr.template == "mov %dst, [mem]" && next.template == "mov [mem], %src"
                    && instr.output >= 0 && next.nodeAt(0) == instr.output) {
                    // 合并：Load 后立即 Store 同一值 → 消除
                    instr.template = "nop"
                    instr.nodes = ""
                    instr.output = -1
                    next.template = "nop"
                    next.nodes = ""
                    next.output = -1
                    this.selectedCount = this.selectedCount - 2
                    changed = true
                }
                i = i + 1
            }

            // DAG 级模式匹配（补充检查）
            val fusedStoreId: Int = DagPatterns.matchLoadStorePair(this.dag)
            if (fusedStoreId >= 0) {
                // DAG 级匹配到 Load-Store 对，标记为已融合
                // （实际指令级消除已在上面的循环中完成）
                changed = changed || fusedStoreId >= 0
            }
        }
    }
}

// ─────────────────────────────────────────────────────────────
// InstructionSelectorUtils — 选择器工具对象
// ─────────────────────────────────────────────────────────────

object InstructionSelectorUtils {

    /// 创建空的指令选择器。
    fun emptySelector(): InstructionSelector {
        return InstructionSelector()
    }

    /// 创建空的指令选择器（带模式数据库配置）。
    fun emptySelectorEx(patterns: String): InstructionSelector {
        val sel: InstructionSelector = InstructionSelector()
        sel.patterns = patterns
        return sel
    }

    /// 将 LIR 操作符映射为条件字符串。
    fun icmpToCond(op: String): String {
        if (op == "ICmpEQ") { return "eq" }
        if (op == "ICmpNE") { return "ne" }
        if (op == "ICmpLT") { return "lt" }
        if (op == "ICmpGT") { return "gt" }
        if (op == "ICmpLE") { return "le" }
        if (op == "ICmpGE") { return "ge" }
        if (op == "ICmpULT") { return "ubl" }
        if (op == "ICmpUGT") { return "uog" }
        if (op == "ICmpULE") { return "ule" }
        if (op == "ICmpUGE") { return "uge" }
        return "eq"
    }

    /// 判断是否为比较指令。
    fun isICmp(op: String): Boolean {
        return op.startsWith("ICmp")
    }

    /// 判断是否为算术指令。
    fun isArith(op: String): Boolean {
        if (op == "Add" || op == "Sub" || op == "Mul" ||
            op == "SDiv" || op == "SRem" || op == "And" ||
            op == "Or" || op == "Xor" || op == "Shl" || op == "Shr") {
            return true
        }
        return false
    }

    /// 判断是否为常量指令。
    fun isConstOp(op: String): Boolean {
        return op == "Const" || op == "ConstImm"
    }

}
