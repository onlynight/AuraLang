// aura:///aura/lang/compiler/mir/TypeRegistry.aura
package aura.lang.compiler.mir
// ─────────────────────────────────────────────────────────────
// 类型注册表（TypeRegistry）— Phase A (任务 A.1)
//
// 用**类型句柄 + 去重**管理类型。所有类型引用通过 TypeID（整数句柄）完成。
// 类型比较 = 整数比较，序列化 = 整数写入。
//
// S1 修复：去重表从 HashMap<String, Int> 改为扁平字符串（key|id\n...），
// 以兼容 VM 的 HashMap 构造器限制（嵌套泛型不支持）。
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String

/// 类型注册表：管理所有类型的注册、去重和查询。
class TypeRegistry {

    /// 类型种类。
    private var kinds: List<String> = arrayListOf<String>()

    /// 类型位宽。
    private var widths: List<Int> = arrayListOf<Int>()

    /// 类型名称。
    private var names: List<String> = arrayListOf<String>()

    /// 字段类型 ID 列表（每项为逗号分隔的 TypeID 字符串）。
    private var fields: List<String> = arrayListOf<String>()

    /// 元素类型 ID。
    private var elems: List<Int> = arrayListOf<Int>()

    /// 数组长度。
    private var arrayLengths: List<Int> = arrayListOf<Int>()

    /// 类型名 → TypeID 去重表（扁平字符串："key|id\nkey|id\n..."）。
    private var dedup: String = ""

    /// [R104] `dedup` 的并行索引（key / id 各一份 + 开放寻址表）。
    ///
    /// ⚠️ 旧 `dedupLookup` 每次调用都从行首线性扫到命中或表尾：`dbgScanned`
    /// 实测累计 **11.9 亿字符**（25.5 万次调用 × 平均 ~4600 项），
    /// 而 `register` 在 SSA 每个值上都要跑一次 ⇒ O(N²)，是 buildAllFunctions
    /// 40.4s 与 synthSingletons/synthCtors 平方项的主体。
    /// 改为「追加即插入 + 容量翻倍重哈希」后查询 O(1)，且与 CSV 同步维护
    ///（CSV 仍照原样生成，序列化/调试输出不变）。
    private var dedupKeys: List<String> = arrayListOf<String>()
    private var dedupIds: List<Int> = arrayListOf<Int>()
    private var dedupTable: List<Int> = arrayListOf<Int>()
    private var dedupCap: Int = 0

    /// 已注册类型数。
    var count: Int = 0

    init() {
        this.kinds = arrayListOf<String>()
        this.widths = arrayListOf<Int>()
        this.names = arrayListOf<String>()
        this.fields = arrayListOf<String>()
        this.elems = arrayListOf<Int>()
        this.arrayLengths = arrayListOf<Int>()
        this.dedup = ""
        this.dedupKeys = arrayListOf<String>()
        this.dedupIds = arrayListOf<Int>()
        this.dedupTable = arrayListOf<Int>()
        this.dedupCap = 0
        this.count = 0

        // 预注册基本类型
        this.intType(8)
        this.intType(16)
        this.intType(32)
        this.intType(64)
        this.floatType(32)
        this.floatType(64)
        this.registerBasic("Bool")
        this.registerBasic("Unit")
        this.registerBasic("String")
    }

    // ── 基本操作 ──

    /// 注册一个类型，返回 TypeID。如果已存在则返回已有 ID。
    fun register(kind: String, width: Int, name: String,
                 fieldIds: String, elemId: Int, arrayLen: Int): Int {
        val key: String = kind + "|" + toStr(width) + "|" + name + "|"
            + fieldIds + "|" + toStr(elemId) + "|" + toStr(arrayLen)

        // 扁平字符串查找
        val existingId: Int = this.dedupLookup(key)
        if (existingId >= 0) {
            return existingId
        }

        val id: Int = this.kinds.size
        this.kinds.add(kind)
        this.widths.add(width)
        this.names.add(name)
        this.fields.add(fieldIds)
        this.elems.add(elemId)
        this.arrayLengths.add(arrayLen)
        this.dedupAppend(key, id)
        this.count = this.kinds.size
        return id
    }

    /// 注册一个基本类型（无字段、无元素）。
    private fun registerBasic(kind: String): Int {
        return this.register(kind, 0, "", "", -1, -1)
    }

    // ── 去重表操作 ──

    /// 临时性能探针：去重查找次数与累计扫描字符数。
    var dbgCalls: Int = 0
    var dbgScanned: Int = 0

    /// 在扁平字符串中去重查找。找到返回 ID，否则返回 -1。
    ///
    /// ⚠️ 原实现有两处致命问题：
    ///   1. 用**字符串下标** `this.dedup[pos]` / `line[i]` 判断 `\n` 与 `|` ——
    ///      Aura 的 String 下标在本 VM 下不成立（实测恒不等），于是循环永远
    ///      走不到行尾分支，查找**恒返回 -1**；
    ///   2. 恒 -1 ⇒ 每次 `register` 都追加新条目，去重表无界增长
    ///      （实测编译 `Main.aura` 时注册出 1500+ 个**完全相同**的基本类型），
    ///      而每次查找又要全表 O(N) 扫描 + 逐行 `substring` 分配 ⇒ Phase A
    ///      退化为 O(N²) 且内存暴涨。
    ///
    /// 现改为 `charCodeAt` 逐码点扫描（`\n`=10、`|`=124），零中间分配，
    /// 只在**命中**时切片一次。
    private fun dedupLookup(key: String): Int {
        this.dbgCalls = this.dbgCalls + 1
        // [R104] 语义变更：从「累计扫描字符数」改为「表内条目数」——
        // 查询已是 O(1)，字符数不再有诊断意义；条目数仍能反映表的增长。
        this.dbgScanned = this.dbgScanned + this.dedupKeys.size
        if (key == "" || this.dedupKeys.size == 0) { return -1 }
        // [R104] 开放寻址哈希查询（同 `X86Encoder.labelTable` 范式）：O(1)。
        // 语义与旧线性扫描一致 —— 返回**首次插入**的 id（重复 key 不会发生：
        // `dedupAppend` 只在 lookup 未命中后调用）。
        var h: Int = this.dedupSlot(key)
        var probes: Int = 0
        while (probes < this.dedupCap) {
            val slot: Int = this.dedupTable[h]
            if (slot == 0) { return -1 }
            if (this.dedupKeys[slot - 1] == key) { return this.dedupIds[slot - 1] }
            h = h + 1
            if (h >= this.dedupCap) { h = 0 }
            probes = probes + 1
        }
        return -1
    }

    /// [R104] key 的哈希槽（h*31 累加码点，模容量）。
    private fun dedupSlot(key: String): Int {
        var h: Int = 0
        var c: Int = 0
        while (c < key.length) {
            h = (h * 31 + (key.charCodeAt(c) as Int)) % this.dedupCap
            c = c + 1
        }
        return h
    }

    /// [R104] 把第 idx 条插入开放寻址表（同名保留先者，与旧扫描语义一致）。
    private fun dedupInsertAt(idx: Int): Unit {
        val nm: String = this.dedupKeys[idx]
        var h: Int = this.dedupSlot(nm)
        var probes: Int = 0
        while (probes < this.dedupCap) {
            val slot: Int = this.dedupTable[h]
            if (slot == 0) {
                this.dedupTable[h] = idx + 1
                probes = this.dedupCap
            } else if (this.dedupKeys[slot - 1] == nm) {
                probes = this.dedupCap
            } else {
                h = h + 1
                if (h >= this.dedupCap) { h = 0 }
            }
            probes = probes + 1
        }
    }

    /// [R104] 容量翻倍并重插全部条目（摊还 O(1)/次插入）。
    private fun dedupGrow(): Unit {
        var cap: Int = 16
        if (this.dedupCap > 0) { cap = this.dedupCap * 2 }
        val want: Int = (this.dedupKeys.size + 1) * 2
        while (cap < want) { cap = cap * 2 }
        this.dedupCap = cap
        this.dedupTable = arrayListOf<Int>()
        var k: Int = 0
        while (k < cap) {
            this.dedupTable.add(0)
            k = k + 1
        }
        var i: Int = 0
        while (i < this.dedupKeys.size) {
            this.dedupInsertAt(i)
            i = i + 1
        }
    }

    /// 检查字符串是否包含子串。
    private fun strContains(text: String, sub: String): Boolean {
        val tlen: Int = text.length
        val slen: Int = sub.length
        if (slen > tlen) { return false }
        var i: Int = 0
        while (i <= tlen - slen) {
            var match: Boolean = true
            var j: Int = 0
            while (j < slen) {
                // 字符串下标在本 VM 下不可用：一律 charCodeAt 比较码点
                if (text.charCodeAt(i + j) != sub.charCodeAt(j)) {
                    match = false
                    break
                }
                j = j + 1
            }
            if (match) { return true }
            i = i + 1
        }
        return false
    }

    /// 向扁平字符串追加一个去重记录。
    private fun dedupAppend(key: String, id: Int): Unit {
        val entry: String = key + "|" + toStr(id)
        if (this.dedup == "") {
            this.dedup = entry
        } else {
            this.dedup = this.dedup + "\n" + entry
        }
        // [R104] 同步维护哈希索引：追加即插入；装载因子到 0.5 就扩容重哈希。
        this.dedupKeys.add(key)
        this.dedupIds.add(id)
        if (this.dedupKeys.size * 2 >= this.dedupCap) {
            this.dedupGrow()
        } else {
            this.dedupInsertAt(this.dedupKeys.size - 1)
        }
    }

    // ── 类型构造工厂 ──

    fun intType(width: Int): Int {
        return this.register("Int", width, "", "", -1, -1)
    }

    fun floatType(width: Int): Int {
        return this.register("Float", width, "", "", -1, -1)
    }

    fun boolType(): Int {
        return this.registerBasic("Bool")
    }

    fun unitType(): Int {
        return this.registerBasic("Unit")
    }

    fun stringType(): Int {
        return this.registerBasic("String")
    }

    fun ptrType(pointee: Int): Int {
        return this.register("Ptr", 0, "", "", pointee, -1)
    }

    fun structType(name: String, fieldIds: String): Int {
        return this.register("Struct", 0, name, fieldIds, -1, -1)
    }

    fun arrayType(elemType: Int, length: Int): Int {
        return this.register("Array", 0, "", "", elemType, length)
    }

    fun funcType(paramIds: String, retId: Int): Int {
        return this.register("Func", 0, "", paramIds, retId, -1)
    }

    fun enumType(name: String, variantIds: String): Int {
        return this.register("Enum", 0, name, variantIds, -1, -1)
    }

    // ── 查询 ──

    fun kindOf(id: Int): String {
        if (id < 0 || id >= this.kinds.size) { return "" }
        return this.kinds[id]
    }

    /// 是否为整数类型。
    ///
    /// 除内部 `Int` 类型（`intType(width)`）外，还要认**按名字**注册的整型
    ///（`fromTypeName("Int")` / `"Long"` …）。HIR 里的类型都是名字形式，
    /// 不认它们会让 `buildLit` / 零值初始化退化成「非整数」分支。
    fun isInt(id: Int): Boolean {
        val k: String = this.kindOf(id)
        if (k == "Int") { return true }
        if (k != "Basic") { return false }
        val n: String = this.nameOf(id)
        return n == "Int" || n == "Long" || n == "Short" || n == "Byte"
            || n == "Int8" || n == "Int16" || n == "Int32" || n == "Int64"
            || n == "UInt" || n == "UByte" || n == "UShort" || n == "ULong"
    }

    /// 是否为浮点类型。
    fun isFloat(id: Int): Boolean {
        val k: String = this.kindOf(id)
        if (k == "Float") { return true }
        if (k != "Basic") { return false }
        val n: String = this.nameOf(id)
        return n == "Float" || n == "Double" || n == "Float32" || n == "Float64"
    }

    /// 是否为布尔类型（`Bool` 与 Aura 源码里的 `Boolean` 都算）。
    fun isBool(id: Int): Boolean {
        val k: String = this.kindOf(id)
        if (k == "Basic") {
            val n: String = this.nameOf(id)
            return n == "Bool" || n == "Boolean" || n == "bool"
        }
        return k == "Bool" || k == "Boolean"
    }

    /// 是否为字符串类型。
    fun isString(id: Int): Boolean {
        return this.kindOf(id) == "Basic" && this.nameOf(id) == "String"
    }

    /// 是否为指针类型。
    fun isPtr(id: Int): Boolean {
        return this.kindOf(id) == "Ptr"
    }

    /// 是否为结构体类型。
    fun isStruct(id: Int): Boolean {
        return this.kindOf(id) == "Struct"
    }

    /// 是否为函数类型。
    fun isFunc(id: Int): Boolean {
        return this.kindOf(id) == "Func"
    }

    fun widthOf(id: Int): Int {
        if (id < 0 || id >= this.widths.size) { return 0 }
        return this.widths[id]
    }

    fun nameOf(id: Int): String {
        if (id < 0 || id >= this.names.size) { return "" }
        return this.names[id]
    }

    fun fieldsOf(id: Int): String {
        if (id < 0 || id >= this.fields.size) { return "" }
        return this.fields[id]
    }

    fun elemOf(id: Int): Int {
        if (id < 0 || id >= this.elems.size) { return -1 }
        return this.elems[id]
    }

    fun arrayLenOf(id: Int): Int {
        if (id < 0 || id >= this.arrayLengths.size) { return -1 }
        return this.arrayLengths[id]
    }

    /// 从类型名查找 TypeID。未注册返回 -1。
    fun fromTypeName(name: String): Int {
        val id: Int = this.register("Basic", 0, name, "", -1, -1)
        return id
    }

    // ── 元信息 ──

    fun typeNameOf(id: Int): String {
        val kind: String = this.kindOf(id)
        val name: String = this.nameOf(id)
        if (kind == "Struct" || kind == "Enum") { return name }
        if (kind == "Basic") { return name }
        return this.typeStr(id)
    }

    /// 类型描述字符串。
    fun typeStr(id: Int): String {
        val kind: String = this.kindOf(id)
        if (kind == "") { return "" }
        if (kind == "Int") { return "i" + toStr(this.widthOf(id)) }
        if (kind == "Float") { return "f" + toStr(this.widthOf(id)) }
        if (kind == "Bool") { return "bool" }
        if (kind == "Unit") { return "unit" }
        if (kind == "String") { return "string" }
        if (kind == "Ptr") { return "*" + this.typeStr(this.elemOf(id)) }
        if (kind == "Array") {
            return "[" + toStr(this.arrayLenOf(id)) + "]" + this.typeStr(this.elemOf(id))
        }
        if (kind == "Struct") { return "struct" }
        if (kind == "Enum") { return "enum" }
        if (kind == "Func") { return "func" }
        return kind
    }

    /// 打印所有已注册类型。
    fun describe(): String {
        var result: String = ""
        var i: Int = 0
        while (i < this.count) {
            if (i > 0) { result = result + "\n" }
            result = result + toStr(i) + ": " + this.typeNameOf(i)
            i = i + 1
        }
        return result
    }

    // ── 大小 / 对齐 ──

    fun sizeOf(id: Int): Int {
        val kind: String = this.kindOf(id)
        if (kind == "Int") {
            val w: Int = this.widthOf(id)
            if (w <= 32) { return 4 }
            return 8
        }
        if (kind == "Float") {
            val w: Int = this.widthOf(id)
            if (w <= 32) { return 4 }
            return 8
        }
        if (kind == "Bool" || kind == "Unit") { return 1 }
        if (kind == "Ptr") { return 8 }
        if (kind == "String") { return 16 }
        if (kind == "Struct") {
            val f: String = this.fieldsOf(id)
            if (f == "") { return 0 }
            return strCountFields(f) * 8
        }
        if (kind == "Array") {
            val len: Int = this.arrayLenOf(id)
            if (len < 0) { return 8 }
            return this.sizeOf(this.elemOf(id)) * len
        }
        return 8
    }

    fun alignOf(id: Int): Int {
        val kind: String = this.kindOf(id)
        if (kind == "Int") {
            val w: Int = this.widthOf(id)
            if (w <= 8) { return 1 }
            if (w <= 16) { return 2 }
            if (w <= 32) { return 4 }
            return 8
        }
        if (kind == "Float") {
            val w: Int = this.widthOf(id)
            if (w <= 32) { return 4 }
            return 8
        }
        if (kind == "Bool" || kind == "Unit") { return 1 }
        return 8
    }

    // ── 字符串工具 ──

    private fun toStr(n: Int): String {
        if (n == 0) { return "0" }
        var neg: Boolean = false
        if (n < 0) { neg = true; n = -n }
        var result: String = ""
        while (n > 0) {
            result = digitChar(n % 10) + result
            n = n / 10
        }
        if (neg) { result = "-" + result }
        return result
    }

    private fun digitChar(value: Int): String {
        if (value < 0 || value > 9) { return "" }
        return "0123456789".substring(value, value + 1)
    }

    /// 十进制字符串转整数。
    ///
    /// 名字刻意带类前缀语义前缀 `dedup`：**不要**改回 `strToInt`。
    /// 本方法只能靠「全表唯一候选」兜底解析（`this.` 形式在旧前端下同样
    /// 退化为裸名），而同名方法在编译单元内至少还有 SsaMirUtils / LirUtils /
    /// MachineDagUtils 三份，重名即失败
    /// （`[bytecode] error: 未解析的函数调用 'strToInt'`）。
    private fun dedupStrToInt(text: String): Int {
        if (text == "") { return 0 }
        val len: Int = text.length
        var total: Int = 0
        var i: Int = 0
        var neg: Boolean = false
        // ⚠️ 原实现用字符串下标（`text[0] == "-"`、`text[i]`）与
        // `"0123456789".indexOf(char)`：String 下标在本 VM 下不可用，转换结果
        // 恒为 0 —— 去重表一旦命中也会返回错误的 TypeID（全部塌成 0）。
        // 改为 charCodeAt 直接算数字（45='-'，48='0'）。
        if (len > 0 && text.charCodeAt(0) == 45) { neg = true; i = 1 }
        while (i < len) {
            val c: Int = text.charCodeAt(i) - 48
            if (c >= 0 && c <= 9) { total = total * 10 + c }
            i = i + 1
        }
        if (neg) { return -total }
        return total
    }

    /// 统计逗号分隔字段数。
    private fun strCountFields(text: String): Int {
        if (text == "") { return 0 }
        var count: Int = 1
        var i: Int = 0
        val len: Int = text.length
        while (i < len) {
            if (text.charCodeAt(i) == 44) { count = count + 1 }   // ','
            i = i + 1
        }
        return count
    }
}

object TypeRegistryUtils {
    fun defaultRegistry(): TypeRegistry {
        return TypeRegistry()
    }
}
