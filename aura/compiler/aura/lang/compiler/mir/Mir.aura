// aura:///aura/lang/compiler/mir/Mir.aura
package aura.lang.compiler.mir
// ─────────────────────────────────────────────────────────────
// MIR（中间中间表示）— 纯 Aura 化迁移 · Phase 3 (任务 3.1)
//
// 对应 Rust `compiler/src/codegen/mir.rs`。
//
// ── 设计方式（与 Ast/Hir 一致）──────────────────────────────
//
// MIR 采用三地址码（TAC）表示，每个指令最多一个结果和两个操作数。
// 使用 List-based arena 表示（Phase Perf：从扁平字符串 arena 迁移到 List，
// 消除 O(n²) 字符串拼接，匹配 Hir.aura 的结构）。
//
// ── MIR 节点类型 ──
//
//   MirProgram  — 程序根节点
//   MirFunc     — 函数声明（params, retTy, blocks）
//   MirBlock    — 基本块（指令序列）
//   MirInstr    — 指令（kind = opcode, text = 操作数描述）
//   MirConst    — 常量（IntLiteral/FloatLiteral/StringLiteral 等）
//
// ── 指令 opcode 分类（存于 MirInstr.kind）──
//
//   常量加载:   LOAD_INT, LOAD_FLOAT, LOAD_STR, LOAD_BOOL, LOAD_NULL
//   栈操作:     LOAD_VAR, STORE_VAR, POP, DUP
//   算术运算:   ADD, SUB, MUL, DIV, MOD
//   比较运算:   EQ, NEQ, LT, GT, LE, GE
//   逻辑运算:   AND, OR, NOT
//   控制流:     JUMP, JUMP_IF_FALSE, JUMP_IF_TRUE, RETURN
//   函数调用:   CALL, CALL_METHOD
//   对象操作:   NEW_OBJECT, GET_FIELD, SET_FIELD
//   类型操作:   CAST, CHECK_TYPE
//   其他:       PHI, NOP, LABEL
//
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String
import aura.lang.compiler.lexer.Span

/// MIR 节点表示（List-based arena，与 Hir.aura 结构一致）。
class Mir {

    /// 节点种类（堆列表，每项一个节点种类）。
    private var kinds: List<String> = arrayListOf<String>()

    /// 节点主文本：标识符名 / 常量文本 / 操作数描述（堆列表，换行已转义）。
    private var texts: List<String> = arrayListOf<String>()

    /// 节点类型名（堆列表；无类型信息时为空串）。
    private var tys: List<String> = arrayListOf<String>()

    /// Span 分量（6 条**并列 Int 堆列表**）。
    private var spanStart: List<Int> = arrayListOf<Int>()
    private var spanEnd: List<Int> = arrayListOf<Int>()
    private var spanStartLine: List<Int> = arrayListOf<Int>()
    private var spanStartCol: List<Int> = arrayListOf<Int>()
    private var spanEndLine: List<Int> = arrayListOf<Int>()
    private var spanEndCol: List<Int> = arrayListOf<Int>()

    /// 子节点 id 列表（堆列表，每项为逗号分隔串，可为空串）。
    private var kids: List<String> = arrayListOf<String>()

    /// 节点总数。
    var count: Int = 0

    /// 根节点 id。
    var rootId: Int = 0

    // ── 构造 ──

    /// 追加一个节点，返回其 id。
    ///
    /// 注意：`id` 取 `kinds.size`、并在追加后回写 `count = kinds.size`。
    /// 这样即使 `Mir` 实例被浅拷贝（Rust AOT 后端对结构体参数/字段按值传递），
    /// 拷贝与原值仍共享同一组堆列表（`List` = `i8*`），`count` 也能自愈一致；
    /// 否则标量 `count` 会在拷贝间失步。
    fun add(kind: String, text: String, ty: String, sp: Span, children: String): Int {
        val id: Int = this.kinds.size
        this.kinds.add(kind)
        // 手动转义换行符（避免 replace 在 VM 内类调用时未链接）。
        var escaped: String = text
        if (text.contains("\n")) {
            val tlen: Int = text.length
            var buf: String = ""
            var i: Int = 0
            while (i < tlen) {
                if (text.charCodeAt(i) == 10) {
                    buf = buf + "\\n"
                } else {
                    buf = buf + text.substring(i, i + 1)
                }
                i = i + 1
            }
            escaped = buf
        }
        this.texts.add(escaped)
        this.tys.add(ty)
        this.spanStart.add(sp.start)
        this.spanEnd.add(sp.end)
        this.spanStartLine.add(sp.startLine)
        this.spanStartCol.add(sp.startCol)
        this.spanEndLine.add(sp.endLine)
        this.spanEndCol.add(sp.endCol)
        this.kids.add(children)
        this.count = this.kinds.size
        return id
    }

    /// 添加一个叶节点（无子节点）。
    fun leaf(kind: String, text: String, sp: Span): Int {
        return this.add(kind, text, "", sp, MirUtils.mirNoKids())
    }

    // ── 查询 ──

    /// 第 id 个节点的 kind。
    fun kindOf(id: Int): String {
        return MirUtils.mirItemAt(this.kinds, id)
    }

    /// 第 id 个节点的 text。
    fun textOf(id: Int): String {
        val raw: String = MirUtils.mirItemAt(this.texts, id)
        // 绝大多数 text 不含换行转义：单次 `contains` 判定后直接复用原串，
        // 避免每次访问都逐字符重建（textOf 是发射期最热访问之一）。
        if (!raw.contains("\\")) {
            return raw
        }
        // 手动反转义换行符（避免 replace 在 VM 内类调用时未链接）
        var result: String = ""
        var i: Int = 0
        var len: Int = raw.length
        while (i < len) {
            if (i + 1 < len && raw.charCodeAt(i) == 92 && raw.charCodeAt(i + 1) == 110) {
                result = result + "\n"
                i = i + 2
            } else {
                result = result + raw.substring(i, i + 1)
                i = i + 1
            }
        }
        return result
    }

    /// 第 id 个节点的 ty。
    fun tyOf(id: Int): String {
        return MirUtils.mirItemAt(this.tys, id)
    }

    /// 第 id 个节点的 span。
    fun spanOf(id: Int): Span {
        return Span(
            MirUtils.mirIntAt(this.spanStart, id), MirUtils.mirIntAt(this.spanEnd, id),
            MirUtils.mirIntAt(this.spanStartLine, id), MirUtils.mirIntAt(this.spanStartCol, id),
            MirUtils.mirIntAt(this.spanEndLine, id), MirUtils.mirIntAt(this.spanEndCol, id)
        )
    }

    /// 第 id 个节点的子节点列表。
    fun kidsOf(id: Int): String {
        return MirUtils.mirItemAt(this.kids, id)
    }

    // ── Dump ──

    /// 递归 dump 节点树（带缩进）。
    fun dumpNode(id: Int, depth: Int): String {
        var out: String = ""
        val pad: String = MirUtils.indent(depth)
        val kind: String = this.kindOf(id)
        val text: String = this.textOf(id)
        val ty: String = this.tyOf(id)
        out = pad + "Mir#" + toStr(id) + " " + kind
        if (text != "") {
            out = out + "(" + text + ")"
        }
        if (ty != "") {
            out = out + ":" + ty
        }
        out = out + "\n"

        val kids: String = this.kidsOf(id)
        val kCount: Int = MirUtils.mirKidsCount(kids)
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = MirUtils.mirKidsAt(kids, i)
            out = out + this.dumpNode(childId, depth + 1)
            i = i + 1
        }
        return out
    }
}

// ─────────────────────────────────────────────────────────────
// MirUtils — 顶层辅助函数
// ─────────────────────────────────────────────────────────────

object MirUtils {

    /// 空子节点列表。
    fun mirNoKids(): String {
        return ""
    }

    /// 列表安全取项（越界返回空串）；arena 各流（kinds/texts/tys/kids）
    /// 的下标访问统一走此处，O(1)。
    fun mirItemAt(items: List<String>, index: Int): String {
        if (index < 0 || index >= items.size) {
            return ""
        }
        return items[index]
    }

    /// Int 堆列表安全取项（越界返回 0）；span 的 6 条并列流下标访问统一走此处，O(1)。
    fun mirIntAt(items: List<Int>, index: Int): Int {
        if (index < 0 || index >= items.size) {
            return 0
        }
        return items[index]
    }

    /// 追加子节点 id。
    fun mirKidsAdd(list: String, child: Int): String {
        if (list == "") {
            return toStr(child)
        }
        return list + "," + toStr(child)
    }

    /// 子节点列表的长度（单次扫描计数；不再 split 分配整张表）。
    ///
    /// **性能关键**：改用 `charCodeAt` 比较（44 = `,`）。旧写法
    /// `toStr(list[i]) == ","` 每扫描一个字符就要分配一个临时字符串
    /// （AOT 下 `toStr` = malloc + snprintf），而该函数位于遍历子节点的
    /// 循环条件里 → 分配量与「(子节点数)² × 每 id 字符数」成正比，
    /// 自举编译时内存冲到 17 GB 的主因之一。
    fun mirKidsCount(list: String): Int {
        if (list == "") {
            return 0
        }
        var count: Int = 1
        var i: Int = 0
        val len: Int = list.length
        while (i < len) {
            if (list.charCodeAt(i) == 44) {
                count = count + 1
            }
            i = i + 1
        }
        return count
    }

    /// 取子节点列表的第 index 个 id。
    fun mirKidsAt(list: String, index: Int): Int {
        return MirUtils.mirToIntOf(MirUtils.mirFieldAt(list, index, ","))
    }

    /// 取第 index 个以 sep 分隔的字段。
    ///
    /// 单次扫描 + 一次切片：旧实现用 substringAfter 链，索引 i 的调用要
    /// 分配 i 个「剩余串」，配合无 GC 的 AOT 运行时是平方级内存黑洞。
    fun mirFieldAt(text: String, index: Int, sep: String): String {
        if (index < 0) {
            return ""
        }
        val len: Int = text.length
        val sepCode: Int = sep.charCodeAt(0)
        var cur: Int = 0
        var start: Int = 0
        var i: Int = 0
        while (i < len) {
            if (text.charCodeAt(i) == sepCode) {
                if (cur == index) {
                    return text.substring(start, i)
                }
                cur = cur + 1
                start = i + 1
            }
            i = i + 1
        }
        if (cur == index) {
            return text.substring(start, len)
        }
        return ""
    }

    /// 十进制字符串 → Int。
    ///
    /// 字符码直接算数字（48 = '0'）。旧写法对每个字符做 10 次
    /// 字符串比较，每次比较都要先分配一个临时字符串 —— 该函数被
    /// `mirKidsAt` 每个子节点调用一次，是热点分配源。
    fun mirToIntOf(text: String): Int {
        if (text == "") {
            return 0
        }
        val len: Int = text.length
        var total: Int = 0
        var i: Int = 0
        var neg: Boolean = false
        if (len > 0 && text.charCodeAt(0) == 45) {
            neg = true
            i = 1
        }
        while (i < len) {
            val digit: Int = text.charCodeAt(i) - 48
            if (digit >= 0 && digit <= 9) {
                total = total * 10 + digit
            }
            i = i + 1
        }
        if (neg) {
            return -total
        }
        return total
    }

    /// 以单字符分隔符切分字符串，返回**原生堆列表**（`List<String>`）。
    ///
    /// **不要用 `String.split`**：引导 VM 的内建 `String` 只有原生注册的那几个方法
    ///（`substring` / `contains` / `indexOf` / `lastIndexOf` / …），**没有 `split`**；
    /// 且它不从 `aura/core` 源码解析纯 Aura 实现，于是 `s.split(",")` 在**编译期**
    /// 就解析不到目标，被发射成占位调用 → 运行期
    /// 「call to undefined function #65535」。实测仓库自带的
    /// `tests/phase1_lexer_tests` / `phase3_mir_tests` / `phase8_stdlib_tests`
    /// 以及用旧 seed 预编译的 `build/auc/compiler/aura-compiler.auc` 均在首次
    /// `split` 处中断。
    ///
    /// 本实现按字符扫描 + `arrayListOf` 手工构造，与 `mirFieldAt` / `mirKidsCount`
    /// 同属「扁平字符串」约定；语义对齐 `String.split`（空串 → `[""]`，末尾必有一个字段）。
    fun mirSplit(text: String, separator: String): List<String> {
        // ⚠️ 不能再用 `arrayListOf<String>() + out.add(...)`：
        // 在本 VM 下 `List<String>.add(s)` 会让该槽位读回 **null**
        //（实测 `val l = arrayListOf<String>(); l.add("a"); l.size == 1` 但
        //  `l.get(0)` 为 null），于是所有按 `|` / `,` / `\n` 拆分的变量表、
        // 块表、值表解析全部失效（典型症状：`varMapLookup` 恒查不到变量 →
        // 变量引用退化成 `Const 0`）。
        // 改用**内建 `String.split`**：它返回的 List 元素读写正常
        //（实测 `"a,b".split(",")` → `[a][b]`，`"".split(",")` → `[""]`）。
        if (separator == "") {
            return listOf(text)
        }
        return text.split(separator)
    }

    /// 生成 depth 级缩进（每级 2 空格）。
    fun indent(depth: Int): String {
        var s: String = ""
        var i: Int = 0
        while (i < depth) {
            s = s + "  "
            i = i + 1
        }
        return s
    }
}
