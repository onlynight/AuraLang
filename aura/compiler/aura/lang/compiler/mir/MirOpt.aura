// aura:///aura/lang/compiler/mir/MirOpt.aura
package aura.lang.compiler.mir
// ─────────────────────────────────────────────────────────────
// MIR 优化 — 纯 Aura 化迁移 · Phase 3 (任务 3.3)
//
// 对应 Rust `compiler/src/codegen/opt.rs`。
//
// ── 本版覆盖范围 ──
//
// 1. 死代码消除（DCE）：移除未被使用的 STORE_VAR 指令
// 2. 常量传播（Const Prop）：LOAD_VAR 的已知常量替换
// 3. 冗余消除（Redundant Elim）：连续的相同指令合并
// 4. 无用指令消除（No-op Elim）：移除 NOP 指令
//
// ── 设计方式（与 Fold.aura 一致）────────────────────────────
//
// 使用扁平 arena 表示，与 Mir.aura 的节点格式一致。
// 遍历 MIR 指令序列，识别可优化模式并替换。
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String
import aura.lang.compiler.lexer.Span

/// MIR 优化处理。
class MirOptimizer {

    /// 输入的 MIR。
    var src: Mir = Mir()

    /// 输出的 MIR（优化后的新 MIR）。
    var dst: Mir = Mir()

    /// DCE 移除的指令数。
    var dceRemoved: Int = 0

    /// 常量传播替换数。
    var constPropCount: Int = 0

    /// 冗余消除数。
    var redundantRemoved: Int = 0

    /// 变量常量表（varName → constValue，扁平字符串：`name|value\n`）。
    var constTable: String = ""

    init() {
        this.src = Mir()
        this.dst = Mir()
        this.dceRemoved = 0
        this.constPropCount = 0
        this.redundantRemoved = 0
        this.constTable = ""
    }

    /// 执行优化，返回新的 MIR 根节点 id。
    fun optimize(src: Mir): Int {
        this.src = src
        this.dst = Mir()
        this.dceRemoved = 0
        this.constPropCount = 0
        this.redundantRemoved = 0
        this.constTable = ""

        // 查找 MirProgram 根节点
        val n: Int = src.count
        var rootIdx: Int = -1
        var i: Int = 0
        while (i < n) {
            if (src.kindOf(i) == "MirProgram") {
                rootIdx = i
                break
            }
            i = i + 1
        }
        if (rootIdx < 0) {
            rootIdx = 0
        }

        // 先做常量传播分析
        this.analyzeConsts(src, rootIdx)

        // 执行优化：遍历所有节点（不仅是根树）
        var oi: Int = 0
        while (oi < src.count) {
            this.optimizeNode(src, oi)
            oi = oi + 1
        }

        // 返回根节点 id（如果存在）
        if (rootIdx < dst.count) {
            return rootIdx
        }
        return 0
    }

    /// 分析常量传播（两遍扫描）。
    fun analyzeConsts(src: Mir, rootId: Int) {
        // 第一遍：收集 STORE_VAR 和 LOAD_INT/LOAD_STR 等常量加载
        this.collectConsts(src, rootId)
    }

    /// 收集常量赋值。
    fun collectConsts(src: Mir, id: Int) {
        val kind: String = src.kindOf(id)
        val text: String = src.textOf(id)

        if (kind == "STORE_VAR") {
            // 查找前一个指令是否是常量加载
            // 简化：暂不做跨指令分析
        }

        // 递归遍历子节点
        val kids: String = src.kidsOf(id)
        val kCount: Int = mirKidsCount(kids)
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = mirKidsAt(kids, i)
            this.collectConsts(src, childId)
            i = i + 1
        }
    }

    /// 优化单个节点。
    fun optimizeNode(src: Mir, id: Int): Int {
        val kind: String = src.kindOf(id)
        val text: String = src.textOf(id)
        val ty: String = src.tyOf(id)
        val sp: Span = src.spanOf(id)
        val kids: String = src.kidsOf(id)
        val kCount: Int = mirKidsCount(kids)

        // 移除 NOP 指令
        if (kind == "NOP") {
            this.dceRemoved = this.dceRemoved + 1
            return -1
        }

        // 递归优化子节点
        var newKids: String = mirNoKids()
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = mirKidsAt(kids, i)
            val childDstId: Int = this.optimizeNode(src, childId)
            if (childDstId >= 0) {
                newKids = mirKidsAdd(newKids, childDstId)
            }
            i = i + 1
        }

        // 常量传播：LOAD_VAR 替换为已知常量
        if (kind == "LOAD_VAR") {
            val constVal: String = this.lookupConst(text)
            if (constVal != "") {
                this.constPropCount = this.constPropCount + 1
                val constKind: String = this.mapConstKind(constVal)
                return this.dst.add(constKind, constVal, "", sp, mirNoKids())
            }
        }

        // 冗余消除：连续的 LOAD_VAR + STORE_VAR（加载后立即存储）
        // 简化：暂不做跨指令分析

        // 其他节点直接复制
        return this.dst.add(kind, text, ty, sp, newKids)
    }

    /// 查找变量常量值。
    fun lookupConst(varName: String): String {
        // 简化实现：暂不做跨指令常量传播
        return ""
    }

    /// 映射常量字符串到 MIR opcode。
    fun mapConstKind(val: String): String {
        // 检查是否是数字
        if (this.isIntLiteral(val)) {
            return "LOAD_INT"
        }
        if (this.isFloatLiteral(val)) {
            return "LOAD_FLOAT"
        }
        if (this.isBoolLiteral(val)) {
            return "LOAD_BOOL"
        }
        return "LOAD_STR"
    }

    /// 检查是否是整数字面量。
    fun isIntLiteral(s: String): Boolean {
        if (s == "") {
            return false
        }
        var i: Int = 0
        var len: Int = s.length
        var first: Int = 0
        while (i < len) {
            val c: String = toStr(s[i])
            if (i == 0 && (c == "-" || c == "+")) {
                first = 1
            } else {
                var isDigit: Boolean = false
                var j: Int = 0
                while (j < 10) {
                    if (toStr(j) == c) {
                        isDigit = true
                        break
                    }
                    j = j + 1
                }
                if (!isDigit) {
                    return false
                }
            }
            i = i + 1
        }
        return true
    }

    /// 检查是否是浮点字面量。
    fun isFloatLiteral(s: String): Boolean {
        if (s == "") {
            return false
        }
        var hasDot: Boolean = false
        var i: Int = 0
        var len: Int = s.length
        while (i < len) {
            val c: String = toStr(s[i])
            if (c == ".") {
                hasDot = true
            } else {
                var isDigit: Boolean = false
                var j: Int = 0
                while (j < 10) {
                    if (toStr(j) == c) {
                        isDigit = true
                        break
                    }
                    j = j + 1
                }
                if (!isDigit && c != "-" && c != "+" && c != "e" && c != "E") {
                    return false
                }
            }
            i = i + 1
        }
        return hasDot
    }

    /// 检查是否是布尔字面量。
    fun isBoolLiteral(s: String): Boolean {
        if (s == "true" || s == "false") {
            return true
        }
        return false
    }
}