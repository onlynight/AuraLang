// aura:///aura/lang/compiler/mir/SsaBuilder.aura
package aura.lang.compiler.mir
// ─────────────────────────────────────────────────────────────
// HIR → SSA MIR 构建器 — Phase A (任务 A.3)
//
// 将 HIR 树状结构降级为 SSA MIR（CFG + SSA + memory chain）。
// 核心算法：
//   1. 遍历 HIR 构建基本块和控制流
//   2. 表达式平坦化（HIR → 指令序列）
//   3. Phi 插入（Cytron 算法）
//   4. Memory chain 插入（显式内存依赖）
//
// ── 与现有 MirLower.aura 的关系 ──
//
//   * MirLower.aura: HIR → TAC MIR（VM 路径使用）
//   * SsaBuilder.aura: HIR → SSA MIR（AOT/JIT 路径使用）
//   * 两者独立，各自消费 HIR 产出不同的 IR
//
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String
import aura.lang.std.Env
import "../hir/Hir.aura"
import "../lexer/Span.aura"
// 同包依赖：输出程序类型 / 类型注册表 / 扁平字符串助手。
// 同包符号需显式导入才进入编译单元（否则退化为未解析调用 #65535）。
import "SsaMir.aura"
import "TypeRegistry.aura"
import "Mir.aura"
import "Linearizer.aura"

/// HIR → SSA MIR 构建器。
class SsaBuilder {

    /// 输出的 SSA MIR 程序。
    private var program: MirSsaProgram = MirSsaProgram()

    /// 类型注册表（快捷引用）。
    private var types: TypeRegistry = TypeRegistry()

    /// 当前函数索引。
    private var curFunc: Int = -1

    /// 当前块索引。
    private var curBlock: Int = 0

    /// 临时值计数器（用于调试命名）。
    private var tmpCount: Int = 0

    /// 临时性能探针：已构建函数数（用于定位 Phase A 的规模行为）。
    private var dbgFuncCount: Int = 0

    /// 临时性能探针：varMap/varVersion 查询次数与累计扫描字符数。
    private var dbgLookups: Int = 0
    private var dbgScanned: Int = 0

    /// 临时性能探针：各类操作调用次数。
    private var dbgStmts: Int = 0
    private var dbgExprs: Int = 0
    private var dbgBlocks: Int = 0
    private var dbgCalls: Int = 0
    private var dbgHasType: Int = 0

    /// 内存链当前值（memory chain head）。
    private var memHead: Int = -1

    /// 当前函数的参数值列表（ValueID 逗号分隔）。
    private var curParams: String = ""

    /// 局部变量名 → ValueID 映射（扁平字符串：name|vid\nname|vid\n…）。
    ///
    /// 采用与 MirLower.aura 一致的扁平字符串格式（`name|vid\n` 拼接），
    /// 避免 `HashMap<String, Int>` 在 VM 内类调用时未链接的问题。
    private var varMap: String = ""

    /// 循环退出块栈（逗号分隔 BlockID，用于 break/continue 的退出目标查找）。
    private var loopStack: String = ""

    /// Phase A S2: 变量版本号映射（扁平字符串：name|version\n）。
    ///
    /// 用于 SSA 变量重命名：每次赋值递增版本号，确保每个版本是独立的 SSA 值。
    private var varVersion: String = ""

    init() {
        this.program = MirSsaProgram()
        this.types = this.program.types
        this.curFunc = -1
        this.curBlock = 0
        this.tmpCount = 0
        this.memHead = -1
        this.curParams = ""
        this.varMap = ""
        this.varVersion = ""
        this.loopStack = ""
    }

    // ── 主入口 ──

    /// 执行 HIR → SSA 降级，返回 SSA MIR 程序。
    fun build(src: Hir): MirSsaProgram {
        this.program = MirSsaProgram()
        this.types = this.program.types
        this.tmpCount = 0

        // 查找 Program 根节点
        val n: Int = src.count
        var rootIdx: Int = -1
        var i: Int = 0
        while (i < n) {
            if (src.kindOf(i) == "HirProgram") {
                rootIdx = i
                break
            }
            i = i + 1
        }
        if (rootIdx < 0) {
            rootIdx = 0
        }

        // 递归构建子节点
        this.buildKidFunctions(src, src.kidsOf(rootIdx))

        return this.program
    }

    /// 遍历一个子节点列表，为其中每个函数建 SSA；容器节点（`object` / `class`）
    /// 递归下钻。
    ///
    /// **为什么要下钻**：`HirLowerer.lowerExternObject` 把 `object X { fun m() }`
    /// 降级为 `HirExternObject` 容器节点，**方法作为容器的子节点**（不是 `HirProgram`
    /// 的直接子节点）。若只扫根节点的 `HirFunction` 直接子节点，`object` 方法会被
    /// 整批丢掉 —— 实测自举 `Main.aura`：根只有 4 个顶层 `fun`，`object MainUtils`
    /// 的 11 个方法（`cliUsage` / `runCli` / `runSelfTest` / `compile` / …）全部缺失，
    /// 链接期 11 条 `undefined symbol`。
    ///
    /// 调用点无需改造：`HirLowerer.lowerCall` 对 `X.m()` 只取**成员名**作 calleeName
    /// （裸名），`lowerFunction` 也不为对象方法附加接收者参数，所以只要方法被建成
    /// 顶层函数，`call @m` 就能解析到。
    fun buildKidFunctions(src: Hir, kids: String): Int {
        val built: Int = this.countFunctionKids(src, kids)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            val childKind: String = src.kindOf(childId)
            if (childKind == "HirFunction") {
                this.dbgFuncCount = this.dbgFuncCount + 1
                val traceOn: Boolean = Env.get("AURA_PHOTON_TRACE", "") == "1"
                // 崩溃诊断：AURA_PHOTON_TRACE=1 时逐函数打印，定位精确崩溃点
                if (traceOn) {
                    println("      [ssab] n=" + this.dbgFuncCount + " " + src.textOf(childId))
                }
                this.buildFunction(src, childId)
                if (traceOn) {
                    println("      [ssae] n=" + this.dbgFuncCount + " values=" + this.program.valueCount +
                            " exprs=" + this.dbgExprs +
                            " tys=" + this.types.count)
                }
            } else if (childKind == "HirExternObject" || childKind == "HirObject") {
                // 容器本身不生成 IR（lowerExternObject 的约定），只承载方法分组信息。
                this.buildKidFunctions(src, src.kidsOf(childId))
            }
            i = i + 1
        }
        return built
    }

    /// 统计子节点列表（含容器递归）中的函数个数。
    fun countFunctionKids(src: Hir, kids: String): Int {
        var total: Int = 0
        val kCount: Int = HirUtils.hirKidsCount(kids)
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            val childKind: String = src.kindOf(childId)
            if (childKind == "HirFunction") {
                total = total + 1
            } else if (childKind == "HirExternObject" || childKind == "HirObject") {
                total = total + this.countFunctionKids(src, src.kidsOf(childId))
            }
            i = i + 1
        }
        return total
    }

    // ── 函数构建 ──

    /// 构建一个函数的 SSA MIR，返回 FunctionID。
    fun buildFunction(src: Hir, id: Int): Int {
        // 进度探针：大规模自举编译（111 模块 / 15 万 HIR 节点）时每 200 个函数
        // 汇报一次，用来定位「SSA 降级卡在第几个函数」。（计数在 build() 循环里）
        if (this.dbgFuncCount % 200 == 0) {
            println("[ssa-prog] funcs=" + toStr(this.dbgFuncCount) +
                    " values=" + toStr(this.program.valueCount))
        }
        if (Env.get("AURA_SSA_PERFN", "") == "1") {
            println("[ssa-fn] n=" + toStr(this.dbgFuncCount) + " " + src.textOf(id))
        }
        val traceOn: Boolean = Env.get("AURA_PHOTON_TRACE", "") == "1"
        val name: String = src.textOf(id)
        val retTy: String = src.tyOf(id)

        // 注册返回类型
        val retTypeId: Int = this.types.fromTypeName(retTy)

        // 创建函数
        val fid: Int = this.program.addFunction(name, retTypeId, retTypeId, false)
        this.curFunc = fid
        this.curParams = ""
        this.varMap = ""
        this.varVersion = ""

        // 创建入口块
        val entryBlock: Int = this.program.addBlock()
        if (traceOn) println("    [bf1] curBlock=" + entryBlock)
        this.curBlock = entryBlock
        if (traceOn) println("    [bf2] after curBlock set")

        // 初始化内存链（函数入口的 memory 状态）
        val memTypeId: Int = this.types.intType(64)
        if (traceOn) println("    [bf3] before addValue entry_mem")
        this.memHead = this.program.addValue("Const", memTypeId, "", "entry_mem", entryBlock)
        if (traceOn) println("    [bf4] after addValue entry_mem")

        // 处理参数
        val kids: String = src.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (traceOn) println("    [bf5] kCount=" + kCount)
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            val childKind: String = src.kindOf(childId)
            if (childKind == "HirParam") {
                val paramName: String = src.textOf(childId)
                val paramTy: String = src.tyOf(childId)
                val paramTypeId: Int = this.types.fromTypeName(paramTy)
                if (traceOn) println("    [bf6] param=" + paramName)

                // 创建参数值（作为入口块的指令）
                val paramVal: Int = this.program.addValue("Param", paramTypeId, "", paramName, entryBlock)

                // 添加到参数列表
                if (this.curParams == "") {
                    this.curParams = toStr(paramVal)
                } else {
                    this.curParams = this.curParams + "," + toStr(paramVal)
                }

                // 添加到变量映射
                this.varMapAdd(paramName, paramVal)

                // 更新函数参数列表
                val f: MirFunction = this.program.functionOf(this.curFunc)
                if (traceOn) println("    [bf7] before f.params=" + this.curParams)
                f.params = this.curParams
                if (traceOn) println("    [bf8] after f.params set")
            }
            i = i + 1
        }

        // 构建函数体
        i = 0
        if (traceOn) println("    [bf9] before buildStmt loop")
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            val childKind: String = src.kindOf(childId)
            if (childKind != "HirParam") {
                if (traceOn) println("    [bf10] buildStmt child=" + childId + " kind=" + childKind)
                this.buildStmt(src, childId)
                if (traceOn) println("    [bf11] after buildStmt child=" + childId)
            }
            i = i + 1
        }
        if (traceOn) println("    [bf12] after buildStmt loop")

        // 如果没有终结指令，添加默认的 Ret
        val b: MirBlock = this.program.blockOf(this.curBlock)
        if (b.term < 0) {
            this.program.setTerminator(this.curBlock, "Ret", retTypeId, "", "")
        }

        // 更新函数的块列表
        val func: MirFunction = this.program.functionOf(this.curFunc)
        func.entryBlock = entryBlock
        this.endCurrentFunction()

        return fid
    }

    /// 结束当前函数的构建。
    fun endCurrentFunction() {
        if (this.curFunc >= 0) {
            this.program.endFunction()
            this.curFunc = -1
        }
    }

    // ── 语句构建 ──

    /// 构建一个语句。
    fun buildStmt(src: Hir, id: Int) {
        this.dbgStmts = this.dbgStmts + 1
        val kind: String = src.kindOf(id)

        if (kind == "HirValDecl" || kind == "HirVarDecl") {
            this.buildVarDecl(src, id)
        } else if (kind == "HirIf") {
            this.buildIf(src, id)
        } else if (kind == "HirWhile") {
            this.buildWhile(src, id)
        } else if (kind == "HirBlock") {
            this.buildBlock(src, id)
        } else if (kind == "HirReturn") {
            this.buildReturn(src, id)
        } else if (kind == "HirExprStmt") {
            val kids: String = src.kidsOf(id)
            if (HirUtils.hirKidsCount(kids) > 0) {
                this.buildExpr(src, HirUtils.hirKidsAt(kids, 0))
            }
        } else if (kind == "HirAssign") {
            this.buildAssign(src, id)
        } else if (kind == "HirCall") {
            this.buildExpr(src, id)
        }
    }

    /// 构建变量声明（val/var）。
    fun buildVarDecl(src: Hir, id: Int) {
        val varName: String = src.textOf(id)
        val kids: String = src.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        // 降级初始化表达式
        var initVal: Int = -1
        if (kCount > 0) {
            initVal = this.buildExpr(src, HirUtils.hirKidsAt(kids, 0))
        } else {
            // 无初始化：创建零值常量
            val varTy: String = src.tyOf(id)
            val varTypeId: Int = this.types.fromTypeName(varTy)
            if (this.types.isInt(varTypeId)) {
                initVal = this.program.addValue("Const", varTypeId, "", "0", this.curBlock)
            } else if (this.types.isFloat(varTypeId)) {
                initVal = this.program.addValue("Const", varTypeId, "", "0.0", this.curBlock)
            } else {
                initVal = this.program.addValue("Const", varTypeId, "", "null", this.curBlock)
            }
        }

        // 存储到变量映射
        this.varMapAdd(varName, initVal)
    }

    /// 构建 if 语句。
    ///
    /// 创建 then/else/merge 三个基本块：
    ///   cond → CondBr(cond, then, else)
    ///   then → build then body → Br(merge)
    ///   else → build else body → Br(merge)
    ///   merge → Phi 插入（若有变量被两分支定义）
    fun buildIf(src: Hir, id: Int) {
        val traceOn: Boolean = Env.get("AURA_PHOTON_TRACE", "") == "1"
        val kids: String = src.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (kCount < 2) {
            return
        }

        // 降级条件
        val condVal: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, 0))
        if (traceOn) println("      [if1] condVal=" + condVal)

        // 创建 then 块、else 块、merge 块
        val thenBlock: Int = this.program.addBlock()
        val elseBlock: Int = this.program.addBlock()
        val mergeBlock: Int = this.program.addBlock()
        if (traceOn) println("      [if2] then=" + thenBlock + " else=" + elseBlock + " merge=" + mergeBlock)

        // 设置当前块的终结指令为 CondBr
        if (traceOn) println("      [if3] before setTerminator CondBr")
        this.program.setTerminator(this.curBlock, "CondBr", 0,
            toStr(condVal) + "," + toStr(thenBlock) + "," + toStr(elseBlock), "")
        if (traceOn) println("      [if4] after setTerminator CondBr")

        // 保存 varMap 快照（用于检测 then/else 中定义的变量）
        val varMapBefore: String = this.varMap

        // 构建 then 块
        this.curBlock = thenBlock
        this.buildBlock(src, HirUtils.hirKidsAt(kids, 1))
        if (traceOn) println("      [if5] after buildBlock then")

        // 设置 then 块到 merge 块的跳转
        val thenBlockObj: MirBlock = this.program.blockOf(this.curBlock)
        if (thenBlockObj.term < 0) {
            this.program.setTerminator(this.curBlock, "Br", 0, toStr(mergeBlock), "")
        }
        if (traceOn) println("      [if6] after then->merge Br")

        // 保存 then 块中定义的变量
        val varMapAfterThen: String = this.varMap
        if (traceOn) println("      [if7] varMapAfterThen saved")

        // 构建 else 块
        if (kCount > 2) {
            if (traceOn) println("      [if8] before buildBlock else")
            this.curBlock = elseBlock
            this.buildBlock(src, HirUtils.hirKidsAt(kids, 2))
            if (traceOn) println("      [if9] after buildBlock else")
            val elseBlockObj: MirBlock = this.program.blockOf(this.curBlock)
            if (elseBlockObj.term < 0) {
                this.program.setTerminator(this.curBlock, "Br", 0, toStr(mergeBlock), "")
            }
            if (traceOn) println("      [if10] after else->merge Br")
        } else {
            if (traceOn) println("      [if8b] no else, direct Br")
            // 无 else 分支：直接跳转到 merge
            this.curBlock = elseBlock
            this.program.setTerminator(this.curBlock, "Br", 0, toStr(mergeBlock), "")
            if (traceOn) println("      [if10b] after no-else Br")
        }

        // 保存 else 块中定义的变量
        val varMapAfterElse: String = this.varMap
        if (traceOn) println("      [if11] varMapAfterElse saved")

        // 在 merge 块插入 Phi 节点（for variables defined in both branches）
        if (traceOn) println("      [if12] before insertPhisAtMerge")
        this.insertPhisAtMerge(mergeBlock, varMapBefore, varMapAfterThen, varMapAfterElse)
        if (traceOn) println("      [if13] after insertPhisAtMerge")

        // 恢复 varMap 到 merge 块的状态（合并 then/else 的定义）
        this.varMap = varMapAfterElse  // else 块的定义优先

        // 继续构建 merge 块
        this.curBlock = mergeBlock
        if (traceOn) println("      [if14] curBlock=merge")
    }

    /// 在 merge 块插入 Phi 节点。
    ///
    /// 比较 then/else 分支中定义的变量，为两分支都定义的变量插入 Phi。
    /// varMap 格式：name|vid\nname|vid\n...
    private fun insertPhisAtMerge(mergeBlock: Int, before: String,
                                    afterThen: String, afterElse: String): Unit {
        // 找出 then 中新增/修改的变量
        val thenDefs: List<String> = this.findChangedVars(before, afterThen)
        // 找出 else 中新增/修改的变量
        val elseDefs: List<String> = this.findChangedVars(before, afterElse)

        // 对 then 中定义的变量，检查是否在 else 中也定义
        var i: Int = 0
        while (i < thenDefs.size) {
            val varName: String = thenDefs[i]
            // 检查 else 是否也定义了这个变量
            var foundInElse: Boolean = false
            var j: Int = 0
            while (j < elseDefs.size) {
                if (elseDefs[j] == varName) {
                    foundInElse = true
                    break
                }
                j = j + 1
            }
            if (foundInElse) {
                // 获取 then 和 else 中的 ValueID
                val thenVid: Int = this.lookupVar(before, varName, afterThen)
                val elseVid: Int = this.lookupVar(before, varName, afterElse)
                if (thenVid >= 0 && elseVid >= 0) {
                    // 插入 Phi 节点（返回 ValueID，但不更新 varMap）
                    val typeId: Int = 0  // 默认 Int 类型
                    val incoming: String = toStr(thenVid) + "," + toStr(elseVid)
                    this.makePhi(mergeBlock, typeId, incoming, "")
                }
            }
            i = i + 1
        }
    }

    /// 找出两个 varMap 快照之间新增/修改的变量。
    /// 返回变量名列表。
    private fun findChangedVars(before: String, after: String): List<String> {
        // ⚠️ 不能用 arrayListOf + add（VM bug：add 后 get 返回 null）。
        val csv: String = this.changedVarsCsv(before, after)
        if (csv == "") { return emptyList() }
        return csv.split(",")
    }

    /// 收集「最新 vid 发生变化」的变量名，返回逗号分隔串（最新优先，去重）。
    ///
    /// ⚠️ 性能关键：本函数**每个 `if` 语句**都会被调用（`insertPhisAtMerge`），
    /// 旧实现每次都对 `before`/`after` 整表 `split("\n")`，再对每个候选变量
    /// 逐行 `split("|")` 比对 —— 单次调用 O(A²) 次字符串分配（A = 变量表条目
    /// 数，随函数内赋值数增长）。编译 `Main.aura` 时，`Lexer.scanString` /
    /// `Lexer.scanChar` 这类「大函数 + 深层嵌套 if」把 Phase A 拖到
    /// 单函数 10–25 秒、峰值内存 800 MB+。
    ///
    /// 现改为纯整数索引扫描（`charCodeAt` 比较 + `\n`/`|` 码点定位），
    /// 只对**命中**的名字切片一次，整体 O(表长 × 变量数) 且零中间分配。
    private fun changedVarsCsv(before: String, after: String): String {
        if (before == after) { return "" }
        var resultStr: String = ""
        var end: Int = after.length
        while (end > 0) {
            var start: Int = end - 1
            // ⚠️ 反向扫描必须**只用合法下标**调 `charCodeAt`：
            //   AOT 把 `String.charCodeAt(i)` 降级成无边界检查的内联访存
            //   （`getelementptr i8, i8* s, i64 i` + `load i8`，见 Emit.aura §2.7），
            //   直接绕过 Aura 源码里的 `index < 0` 保护。一旦 `start` 走到 -1
            //   就会读到字符串缓冲区之前一个字节：轻则读到垃圾使扫描不终止，
            //   重则访问违规（0xC0000005）。原写法 `while (start >= 0 &&
            //   after.charCodeAt(start) != 10)` 就踩了这个坑。
            //   改为：循环体内只读 `start > 0` 的字节，下标 0 在循环外单独判定。
            while (start > 0) {
                if (after.charCodeAt(start) == 10) { start = start + 1; break }
                start = start - 1
            }
            if (start == 0) {
                if (after.charCodeAt(0) == 10) { start = 1 }
            }
            if (end > start) {
                var sep: Int = start
                while (sep < end) {
                    if (after.charCodeAt(sep) == 124) { break }
                    sep = sep + 1
                }
                if (sep < end) {
                    val name: String = after.substring(start, sep)
                    if (name != "" && !this.containsInFlat(resultStr, name)) {
                        val afterVid: Int = this.strToInt(after.substring(sep + 1, end))
                        val beforeVid: Int = this.mapVidOf(before, name)
                        // 新变量（before 中没有）或值发生了变化
                        if (beforeVid < 0 || beforeVid != afterVid) {
                            if (resultStr == "") {
                                resultStr = name
                            } else {
                                resultStr = resultStr + "," + name
                            }
                        }
                    }
                }
            }
            end = start - 1
        }
        return resultStr
    }

    /// 比较 `s[from, to)` 是否与 `token` 逐字符相等（**零分配**）。
    private fun tokenRangeEquals(s: String, from: Int, to: Int, token: String): Boolean {
        if (to - from != token.length) { return false }
        var i: Int = 0
        while (i < token.length) {
            if (s.charCodeAt(from + i) != token.charCodeAt(i)) { return false }
            i = i + 1
        }
        return true
    }

    /// 在 `name|vid\n…` 扁平变量表中，从末尾向前找 `name` 的最新 vid（未找到 -1）。
    ///
    /// 零分配：按 `\n` 定位行，行内按 `|`（124）定位，只对命中项切片一次。
    /// ⚠️ 所有 `charCodeAt` 调用都必须落在 `[0, len)` 内（AOT 内联访存无边界检查）。
    private fun mapVidOf(map: String, name: String): Int {
        if (map == "" || name == "") { return -1 }
        // Forward scan: iterate through each line, keep last match (backward scan crashes in AOT)
        val nlen: Int = name.length
        val mlen: Int = map.length
        var result: Int = -1
        var i: Int = 0
        while (i < mlen) {
            if (map.charCodeAt(i) == 10) { i = i + 1; continue }
            if (i + nlen < mlen) {
                var match: Boolean = true
                var k: Int = 0
                while (k < nlen) {
                    if (map.charCodeAt(i + k) != name.charCodeAt(k)) { match = false; break }
                    k = k + 1
                }
                if (match && map.charCodeAt(i + nlen) == 124) {
                    var j: Int = i + nlen + 1
                    while (j < mlen) {
                        if (map.charCodeAt(j) == 10) { break }
                        j = j + 1
                    }
                    val sub: String = map.substring(i + nlen + 1, j)
                    result = this.strToInt(sub)
                }
            }
            i = i + 1
        }
        return result
    }

    /// 检查扁平字符串（逗号分隔）中是否包含指定名称（零分配扫描，不拆分）。
    private fun containsInFlat(flat: String, name: String): Boolean {
        if (flat == "" || name == "") { return false }
        var start: Int = 0
        val len: Int = flat.length
        var i: Int = 0
        while (i <= len) {
            if (i == len || flat.charCodeAt(i) == 44) {
                if (this.tokenRangeEquals(flat, start, i, name)) { return true }
                start = i + 1
            }
            i = i + 1
        }
        return false
    }

    /// 在 varMap 中查找变量的 ValueID。
    ///
    /// `before` 参数保留以兼容调用点（原实现同样只查 `after`；
    /// `afterThen`/`afterElse` 快照本身已包含 `before` 的全部条目）。
    private fun lookupVar(before: String, name: String, after: String): Int {
        // 从末尾向前搜索以获取最新版本（零分配）
        return this.mapVidOf(after, name)
    }

    /// 在指定块插入 Phi 节点（for loop back-edge）。
    ///
    /// 比较块前状态和块后状态，为两状态都定义的变量插入 Phi。
    /// 用于 while 循环的回边 Phi 插入。
    private fun insertPhisAtBlock(blockId: Int, before: String,
                                    after: String, exitState: String): String {
        // 用逗号分隔的扁平字符串收集变更变量名（不能用 arrayListOf+add，VM bug）
        val afterDefsStr: String = this.findChangedVarsStr(before, after)
        if (afterDefsStr == "") { return this.varMap }

        val afterDefs: List<String> = afterDefsStr.split(",")
        var newVarMap: String = this.varMap
        var i: Int = 0
        while (i < afterDefs.size) {
            val varName: String = afterDefs[i]
            val beforeVid: Int = this.lookupVar("", varName, before)
            if (beforeVid >= 0) {
                val afterVid: Int = this.lookupVar("", varName, after)
                if (afterVid >= 0) {
                    val typeId: Int = 0
                    val incoming: String = toStr(beforeVid) + "," + toStr(afterVid)
                    val phiVid: Int = this.makePhi(blockId, typeId, incoming, "")
                    // 更新 varMap 指向 Phi 节点（追加新版本）
                    newVarMap = newVarMap + varName + "|" + toStr(phiVid) + "\n"
                }
            }
            i = i + 1
        }
        return newVarMap
    }

    /// 找出两个 varMap 快照之间新增/值变化的变量名，返回逗号分隔字符串。
    ///
    /// 与 `findChangedVars` 同源，共用零分配的 `changedVarsCsv`。
    private fun findChangedVarsStr(before: String, after: String): String {
        return this.changedVarsCsv(before, after)
    }

    /// 构建 while 语句。
    ///
    /// 创建 cond/body/end 三个基本块：
    ///   cond → 降级条件 → CondBr(cond, body, end)
    ///   body → 构建循环体 → Br(cond)
    ///   end  → 循环结束
    ///
    /// 使用 loopStack 记录循环退出块，供 break/continue 查找。
    ///
    /// ⚠️ Phi 的插入时机（循环变量正确性的关键）：
    /// Phi **必须在构建循环体之前**创建并写入 varMap。旧实现在循环体构建完
    /// 之后再插入 Phi —— 此时循环体里对 `i` 的每一处引用都已解析成**循环前的
    /// 旧值**（如 `var i = 0` 的常量 0），循环体读到的 `i` 永远是初值：
    /// 实测 `while (i < 5) { println(...); i = i + 1 }` 打印 "while i = 0" 无限
    /// 循环（`i + 1` 恒为 0+1，`i` 本身从不更新）。
    ///
    /// 现改为：
    ///   1. 预扫描循环体，收集被赋值的变量名；
    ///   2. 对「循环前已存在」的那些变量，先在 cond 块建 Phi（入边 0 = 循环前值，
    ///      入边 1 先占位）并把 varMap 指向 Phi；
    ///   3. 构建循环体 —— 所有引用自然解析到 Phi；
    ///   4. 回填 Phi 的入边 1 = 循环体末尾该变量的值。
    fun buildWhile(src: Hir, id: Int) {
        val kids: String = src.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (kCount < 2) {
            return
        }

        // 保存 varMap 快照（循环前的状态）
        val varMapBefore: String = this.varMap

        // 保存当前块（入口块），创建新的条件块
        val entryBlock: Int = this.curBlock
        val condBlock: Int = this.program.addBlock()
        val bodyBlock: Int = this.program.addBlock()
        val endBlock: Int = this.program.addBlock()

        // 将结束块推入循环栈
        this.loopStackPush(endBlock)

        // 入口块跳转到条件块（如果尚未设置终结指令）
        val entryBlockObj: MirBlock = this.program.blockOf(entryBlock)
        if (entryBlockObj.term < 0) {
            this.program.setTerminator(entryBlock, "Br", 0, toStr(condBlock), "")
        }

        val bodyKid: Int = HirUtils.hirKidsAt(kids, 1)

        // ── 步骤 1+2：预建循环变量 Phi ──
        // phiRecs：每行 "name|phiVid|beforeVid"
        val assignedNames: String = this.collectAssignedVars(src, bodyKid, "")
        var phiRecs: String = ""
        var phiVarEntries: String = ""
        if (assignedNames != "") {
            val names: List<String> = assignedNames.split(",")
            var ni: Int = 0
            while (ni < names.size) {
                val nm: String = names[ni]
                val beforeVid: Int = this.lookupVar("", nm, varMapBefore)
                if (beforeVid >= 0) {
                    // 入边 1 先占位为 beforeVid，稍后回填。
                    val incoming: String = toStr(beforeVid) + "," + toStr(beforeVid)
                    val phiVid: Int = this.makePhi(condBlock, 0, incoming, "")
                    this.varMap = this.varMap + nm + "|" + toStr(phiVid) + "\n"
                    phiVarEntries = phiVarEntries + nm + "|" + toStr(phiVid) + "\n"
                    phiRecs = phiRecs + nm + "|" + toStr(phiVid) + "|" + toStr(beforeVid) + "\n"
                }
                ni = ni + 1
            }
        }

        // ── 步骤 3：构建循环体（varMap 已指向 Phi）──
        this.curBlock = bodyBlock
        this.buildBlock(src, bodyKid)

        // 循环体结束：跳回条件块
        val bodyBlockObj: MirBlock = this.program.blockOf(this.curBlock)
        if (bodyBlockObj.term < 0) {
            this.program.setTerminator(this.curBlock, "Br", 0, toStr(condBlock), "")
        }

        // 保存循环体中定义的变量
        val varMapAfterBody: String = this.varMap

        // ── 步骤 4：回填 Phi 的第二条入边（循环体末尾的值）──
        if (phiRecs != "") {
            val recLines: List<String> = this.splitStr(phiRecs, "\n")
            var ri: Int = 0
            while (ri < recLines.size) {
                val rec: String = recLines[ri]
                if (rec != "") {
                    val recParts: List<String> = this.splitStr(rec, "|")
                    if (recParts.size >= 3) {
                        val nm: String = recParts[0]
                        val phiVid: Int = this.strToInt(recParts[1])
                        val beforeVid: Int = this.strToInt(recParts[2])
                        val afterVid: Int = this.lookupVar("", nm, varMapAfterBody)
                        if (phiVid >= 0 && afterVid >= 0) {
                            // ⚠️ 必须经**命名局部变量**中转写回，两个坑都不能踩：
                            //
                            // (1) 不能写成 `this.program.valueOf(id).args = …`
                            //     （链式临时值上直接赋字段）。AOT 载体下该模式
                            //     **丢失写回**：临时 MirValue 不是 arena 里的那个
                            //     对象，赋值落到死副本上 —— PHI 的第二条入边永远
                            //     停留在占位值（`@phi(@t13, @t13)`），循环变量
                            //     永不更新，产物死循环（实测 P1/04、P2/01、P2/02、
                            //     P2/03；同一份源码 3 次独立 AOT 构建结果一致，
                            //     不是非确定性问题）。先 `val pv = valueOf(id)`
                            //     再写 `pv.args`，则 VM 与 AOT 两侧都正确持久化。
                            //
                            // (2) 也不能 `this.values.set(id, v)` 重新插回槽位：
                            //     `ArrayList.set` 的实现是 `data[index] = value`，
                            //     而 `lowerAssign` 的下标分支产出的 `HirAssign`
                            //     **目标名为空**（`text=""`），AOT 发不出真正的
                            //     字段写回，反而把 arena 里该槽位的对象**毁掉**
                            //     （实测同一 ValueID 回写后读出 `args='i'`、
                            //     `op='??'`，PHI 与整个 SSA 变残骸）。
                            val pv: MirValue = this.program.valueOf(phiVid)
                            pv.args = toStr(beforeVid) + "," + toStr(afterVid)
                        }
                    }
                }
                ri = ri + 1
            }
        }

        // 切换到条件块，使用更新后的 varMap（包含 Phi 节点）
        this.curBlock = condBlock

        // ⚠️ 条件块看到的循环变量必须是 **Phi**，不能是循环体末尾的值：
        // `lookupVar` 从 varMap 末尾向前搜索（最新版本优先），而 varMapAfterBody
        // 末尾是循环体里 `i = i + 1` 的结果。若直接沿用，条件会退化成
        // `(i+1) < 5` —— 实测 while 循环只跑 4 次（for 只跑 2 次）。
        // 这里把 varMap 重置为「循环前状态 + Phi 条目」（Phi 在末尾 → 优先命中）。
        this.varMap = varMapBefore + phiVarEntries

        // 降级条件（使用 Phi 节点作为变量值）
        val condVal: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, 0))

        // 设置条件块的终结指令
        this.program.setTerminator(condBlock, "CondBr", 0,
            toStr(condVal) + "," + toStr(bodyBlock) + "," + toStr(endBlock), "")

        // 将结束块弹出循环栈
        this.loopStackPop()

        // ⚠️ 循环之后的变量值必须是 **Phi**，不能是循环体末尾的值。
        // 理由：`end` 块可以从条件块直接到达（循环一次都没进），此时循环体里的
        // 值**根本没有被求值**——它不支配 end 块，引用它就是非法 SSA。
        // 实测 P2/01_nested_loop：`sum` 被解析成内层循环体的 `sum + i + j`
        //（属于内层块），既违反支配关系，又让该表达式被发射到错误的块里。
        // Phi 恰好携带「最后写回的值 or 循环前的值」，是唯一正确的选择。
        // 因此这里不再还原 `varMapAfterBody`（varMap 已在上一步设为
        // `varMapBefore + phiVarEntries`）。

        // 继续构建结束块
        this.curBlock = endBlock
    }

    /// 递归收集 HIR 子树中被赋值（`HirAssign`）的变量名，返回逗号分隔串（去重）。
    ///
    /// 供 `buildWhile` 预判循环携带变量（loop-carried variables）。
    private fun collectAssignedVars(src: Hir, id: Int, out: String): String {
        var result: String = out
        if (src.kindOf(id) == "HirAssign") {
            val name: String = src.textOf(id)
            if (name != "" && !this.containsInFlat(result, name)) {
                if (result == "") {
                    result = name
                } else {
                    result = result + "," + name
                }
            }
        }
        val kids: String = src.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        var i: Int = 0
        while (i < kCount) {
            result = this.collectAssignedVars(src, HirUtils.hirKidsAt(kids, i), result)
            i = i + 1
        }
        return result
    }

    /// 构建块（HirBlock）。
    fun buildBlock(src: Hir, id: Int) {
        val traceOn: Boolean = Env.get("AURA_PHOTON_TRACE", "") == "1"
        this.dbgBlocks = this.dbgBlocks + 1
        val kids: String = src.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (traceOn) println("    [bb0] buildBlock id=" + id + " kCount=" + kCount)
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            val childKind: String = src.kindOf(childId)
            if (traceOn) println("    [bb1] child=" + i + " id=" + childId + " kind=" + childKind)
            this.buildStmt(src, childId)
            if (traceOn) println("    [bb2] after child=" + i)
            i = i + 1
        }
        if (traceOn) println("    [bb3] buildBlock done id=" + id)
    }

    /// 构建 return 语句。
    fun buildReturn(src: Hir, id: Int) {
        val traceOn: Boolean = Env.get("AURA_PHOTON_TRACE", "") == "1"
        if (traceOn) println("      [ret0] buildReturn id=" + id)
        val kids: String = src.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (traceOn) println("      [ret1] kCount=" + kCount)
        if (kCount > 0) {
            if (traceOn) println("      [ret2] before buildExpr")
            val retVal: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, 0))
            if (traceOn) println("      [ret3] retVal=" + retVal + " before setTerminator")
            this.program.setTerminator(this.curBlock, "Ret", 0, toStr(retVal), "")
            if (traceOn) println("      [ret4] after setTerminator")
        } else {
            if (traceOn) println("      [ret2b] no kids, before setTerminator")
            this.program.setTerminator(this.curBlock, "Ret", 0, "", "")
            if (traceOn) println("      [ret4b] after setTerminator")
        }
    }

    /// 构建赋值语句。
    /// 构建赋值语句（Phase A S2: 内存链 Store）。
    ///
    /// 赋值可能是寄存器赋值或内存 Store。
    /// 当 memHead >= 0 时，创建 Store 指令并更新内存链。
    fun buildAssign(src: Hir, id: Int) {
        val kids: String = src.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (kCount < 1) {
            return
        }
        val varName: String = src.textOf(id)
        // ⚠️ 取**最后一个** kid 作为右值：`HirAssign` 的 kids 形状有两个来源——
        //   * Rust 前端（.phir 路径）：kids = [右值]（目标名在 text，见 Bug C）；
        //   * Aura 自举前端 `HirLowerer.lowerAssign`：kids = [目标表达式…, 右值]
        //     （它遍历 AST 的全部 kids）。
        // 旧实现固定取 kids[0]：在自举前端下拿到的是**目标**（如 `c` 的当前值），
        // 于是 `c = c + 1` 退化成「把 c 的原值再存一次」，循环变量永不递增
        // （实测 04_control_flow 产物死循环、03_arithmetic 输出 `c = 5`）。
        val lastKid: Int = HirUtils.hirKidsCount(kids) - 1
        val val: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, lastKid))

        // Phase A S2: 内存链 — 赋值是内存写入操作
        if (this.memHead >= 0) {
            val varTy: String = src.tyOf(id)
            val varTypeId: Int = this.types.fromTypeName(varTy)
            var args: String = toStr(val)
            args = args + "," + toStr(this.memHead)
            this.program.addValue("Store", varTypeId, args, varName, this.curBlock)

            // 更新内存链 — Store 后创建新的 mem token
            val memTypeId: Int = this.types.intType(64)
            this.memHead = this.program.addValue("MemToken", memTypeId, toStr(val), "mem_after_store", this.curBlock)
        }

        // 存储到变量映射（无论是否内存链，都更新 varMap）
        this.varMapAdd(varName, val)
    }

    // ── 表达式构建 ──

    /// 构建一个表达式，返回 SSA ValueID。
    fun buildExpr(src: Hir, id: Int): Int {
        val traceOn: Boolean = Env.get("AURA_PHOTON_TRACE", "") == "1"
        this.dbgExprs = this.dbgExprs + 1
        val kind: String = src.kindOf(id)
        if (traceOn) println("        [expr] id=" + id + " kind=" + kind)

        if (kind == "HirLit") {
            return this.buildLit(src, id)
        }
        if (kind == "HirVar") {
            return this.buildVar(src, id)
        }
        if (kind == "HirBinary") {
            return this.buildBinary(src, id)
        }
        if (kind == "HirUnary") {
            return this.buildUnary(src, id)
        }
        if (kind == "HirCall") {
            return this.buildCall(src, id)
        }
        if (kind == "HirMember") {
            return this.buildMember(src, id)
        }
        if (kind == "HirIndex") {
            return this.buildIndex(src, id)
        }
        if (kind == "HirBlock") {
            // 块表达式：构建块，返回最后一个表达式的值
            val kids: String = src.kidsOf(id)
            val kCount: Int = HirUtils.hirKidsCount(kids)
            if (kCount == 0) {
                return -1
            }
            // 构建块中的所有语句
            var lastVal: Int = -1
            var i: Int = 0
            while (i < kCount) {
                val childKind: String = src.kindOf(HirUtils.hirKidsAt(kids, i))
                if (childKind == "HirExprStmt") {
                    val ek: String = src.kidsOf(HirUtils.hirKidsAt(kids, i))
                    if (HirUtils.hirKidsCount(ek) > 0) {
                        lastVal = this.buildExpr(src, HirUtils.hirKidsAt(ek, 0))
                    }
                } else if (childKind != "HirReturn" && childKind != "HirIf"
                    && childKind != "HirWhile" && childKind != "HirBlock") {
                    lastVal = this.buildExpr(src, HirUtils.hirKidsAt(kids, i))
                } else {
                    this.buildStmt(src, HirUtils.hirKidsAt(kids, i))
                }
                i = i + 1
            }
            return lastVal
        }

        // 默认：返回零值常量
        if (traceOn) println("        [expr] default branch for kind=" + kind)
        val ty: String = src.tyOf(id)
        val typeId: Int = this.types.fromTypeName(ty)
        if (this.types.isInt(typeId)) {
            return this.program.addValue("Const", typeId, "", "0", this.curBlock)
        } else if (this.types.isFloat(typeId)) {
            return this.program.addValue("Const", typeId, "", "0.0", this.curBlock)
        } else {
            return this.program.addValue("Const", typeId, "", "null", this.curBlock)
        }
    }

    /// 构建字面量。
    fun buildLit(src: Hir, id: Int): Int {
        val text: String = src.textOf(id)
        val ty: String = src.tyOf(id)
        val typeId: Int = this.types.fromTypeName(ty)

        if (this.types.isInt(typeId)) {
            return this.program.addValue("Const", typeId, "", text, this.curBlock)
        } else if (this.types.isFloat(typeId)) {
            return this.program.addValue("Const", typeId, "", text, this.curBlock)
        } else if (this.types.isBool(typeId)) {
            if (text == "true") {
                return this.program.addValue("Const", typeId, "", "1", this.curBlock)
            } else {
                return this.program.addValue("Const", typeId, "", "0", this.curBlock)
            }
        } else {
            return this.program.addValue("Const", typeId, "", text, this.curBlock)
        }
    }

    /// 构建变量引用。
    fun buildVar(src: Hir, id: Int): Int {
        val traceOn: Boolean = Env.get("AURA_PHOTON_TRACE", "") == "1"
        if (traceOn) println("          [var0] buildVar id=" + id)
        val name: String = src.textOf(id)
        if (traceOn) println("          [var1] name=" + name)
        if (traceOn) println("          [var2] before varMapLookup")
        val result: Int = this.varMapLookup(name)
        if (traceOn) println("          [var3] result=" + result)
        return result
    }

    /// 构建二元运算。
    fun buildBinary(src: Hir, id: Int): Int {
        val op: String = src.textOf(id)
        val kids: String = src.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (kCount < 2) {
            return -1
        }

        val left: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, 0))
        val right: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, 1))
        val args: String = toStr(left) + "," + toStr(right)

        // 映射运算符
        val mirOp: String = this.mapBinaryOp(op)
        val typeId: Int = this.types.fromTypeName(src.tyOf(id))

        return this.program.addValue(mirOp, typeId, args, "", this.curBlock)
    }

    /// 构建一元运算。
    fun buildUnary(src: Hir, id: Int): Int {
        val op: String = src.textOf(id)
        val kids: String = src.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (kCount < 1) {
            return -1
        }

        val operand: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, 0))
        val args: String = toStr(operand)

        // 映射运算符
        val mirOp: String = this.mapUnaryOp(op)
        val typeId: Int = this.types.fromTypeName(src.tyOf(id))

        return this.program.addValue(mirOp, typeId, args, "", this.curBlock)
    }

    /// 构建函数调用。
    fun buildCall(src: Hir, id: Int): Int {
        this.dbgCalls = this.dbgCalls + 1
        val funcName: String = src.textOf(id)
        val kids: String = src.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        // 构建参数列表
        var args: String = ""
        var i: Int = 0
        while (i < kCount) {
            val argVal: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, i))
            if (args == "") {
                args = toStr(argVal)
            } else {
                args = args + "," + toStr(argVal)
            }
            i = i + 1
        }

        // Phase A: 内存链 — 将当前 memHead 作为 Call 的附加参数
        // 这样 Call 的内存依赖被显式建模
        if (funcName == "__list_new") {
            return this.buildListNew(args, kCount)
        }
        if (this.memHead >= 0) {
            if (args == "") {
                args = toStr(this.memHead)
            } else {
                args = args + "," + toStr(this.memHead)
            }
        }

        val typeId: Int = this.types.fromTypeName(src.tyOf(id))
        val callVal: Int = this.program.addValue("Call", typeId, args, funcName, this.curBlock)

        // Phase A: 更新内存链 — Call 后创建新的 mem token
        // 新 token 依赖 Call 的结果，表示调用后的内存状态
        if (this.memHead >= 0) {
            val memTypeId: Int = this.types.intType(64)
            this.memHead = this.program.addValue("MemToken", memTypeId, toStr(callVal), "mem_after_call", this.curBlock)
        }

        return callVal
    }

    /// 把 n 元 `__list_new(e0, e1, …)` 降级为 `alloc(count)` + `count` 次 `setat`。
    ///
    /// 为什么要拆：`__list_new` 是 **n 元**调用，而 Photon 的调用约定
    ///（`X86Emitter.emitCallArgs`）只把前 4 个实参装进 rcx/rdx/r8/r9，第 5 个起
    /// **静默丢弃** —— `[1, 2, 3, 4, 5]` 会丢掉元素 5。拆成
    /// `__list_alloc(count)` / `__list_setat(list, i, ei)`（都 ≤3 元）后既不必
    /// 引入栈传参，列表布局也完全由 runtime 掌控
    ///（`[count][e0][e1]…`，见 `PhotonRuntime.emitListAlloc`）。
    ///
    /// `elems` 是已经构建好的元素值 id（逗号分隔）。
    private fun buildListNew(elems: String, count: Int): Int {
        val i64: Int = this.types.intType(64)
        // 计数常量（args 里必须是值 id，不能直接塞字面量）
        val cntVal: Int = this.program.addValue("Const", i64, "", toStr(count), this.curBlock)
        val listVal: Int = this.program.addValue("Call", i64, toStr(cntVal), "__list_alloc", this.curBlock)

        if (elems != "") {
            val parts: List<String> = elems.split(",")
            var i: Int = 0
            while (i < parts.size) {
                val idxVal: Int = this.program.addValue("Const", i64, "", toStr(i), this.curBlock)
                val setArgs: String = toStr(listVal) + "," + toStr(idxVal) + "," + parts[i]
                this.program.addValue("Call", i64, setArgs, "__list_setat", this.curBlock)
                i = i + 1
            }
        }

        // 与 buildCall 保持一致：调用后推进内存链
        if (this.memHead >= 0) {
            val memTypeId: Int = this.types.intType(64)
            this.memHead = this.program.addValue("MemToken", memTypeId, toStr(listVal),
                                                 "mem_after_call", this.curBlock)
        }
        return listVal
    }

    /// 构建成员访问。
    fun buildMember(src: Hir, id: Int): Int {
        val fieldName: String = src.textOf(id)
        val kids: String = src.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (kCount < 1) {
            return -1
        }

        val objVal: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, 0))
        var args: String = toStr(objVal)

        // Phase A: 内存链 — GetField 可能读取内存，依赖 memHead
        if (this.memHead >= 0) {
            args = args + "," + toStr(this.memHead)
        }

        val typeId: Int = this.types.fromTypeName(src.tyOf(id))
        val fieldVal: Int = this.program.addValue("GetField", typeId, args, fieldName, this.curBlock)

        // Phase A: 更新内存链 — GetField 后创建新的 mem token
        if (this.memHead >= 0) {
            val memTypeId: Int = this.types.intType(64)
            this.memHead = this.program.addValue("MemToken", memTypeId, toStr(fieldVal), "mem_after_get", this.curBlock)
        }

        return fieldVal
    }

    /// 构建数组/集合元素访问（Phase A S2: 内存链 Load）。
    ///
    /// HirIndex 表示 a[i] 形式的元素访问，属于内存读取操作。
    /// 依赖 memHead 建立内存顺序，访问后更新内存链。
    fun buildIndex(src: Hir, id: Int): Int {
        val kids: String = src.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (kCount < 2) {
            return -1
        }

        val baseVal: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, 0))
        val idxVal: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, 1))
        var args: String = toStr(baseVal) + "," + toStr(idxVal)

        // Phase A S2: 内存链 — 访问依赖 memHead
        if (this.memHead >= 0) {
            args = args + "," + toStr(this.memHead)
        }

        // ── 元素访问降级为 runtime 调用 `__list_get(container, index)` ──
        //
        // 为什么不发射 Load：Photon 的 Load/Store 路径（`Lowering.lowerLoad` →
        // `addValueWithChain`）**不把值登记进 `LirBlock.instrs`**，DAG 里根本
        // 没有加载/存储指令（实测嵌套循环的 Store 全部消失）。索引访问统一走
        // runtime 调用，与 `__list_new` / `.Collections.set` 共用同一套列表布局
        //（`[count][e0][e1]…`，元素 i 在 [8 + i*8]）。
        val typeId: Int = this.types.fromTypeName(src.tyOf(id))
        val getVal: Int = this.program.addValue("Call", typeId, args, "__list_get", this.curBlock)

        // Phase A S2: 更新内存链 — 访问后创建新的 mem token
        if (this.memHead >= 0) {
            val memTypeId: Int = this.types.intType(64)
            this.memHead = this.program.addValue("MemToken", memTypeId, toStr(getVal), "mem_after_get", this.curBlock)
        }

        return getVal
    }

    // ── Phi 节点 ──

    /// 向指定块添加 Phi 节点，返回 ValueID。
    fun makePhi(blockId: Int, typeId: Int, incoming: String, aux: String): Int {
        return this.program.addPhi(blockId, typeId, incoming, aux)
    }

    // ── 运算符映射 ──

    /// 映射二元运算符到 MIR 操作符。
    private fun mapBinaryOp(op: String): String {
        if (op == "+" || op == "Plus") { return "Add" }
        if (op == "-" || op == "Minus") { return "Sub" }
        if (op == "*" || op == "Star") { return "Mul" }
        if (op == "/" || op == "Slash") { return "SDiv" }
        if (op == "%" || op == "Percent") { return "SRem" }
        if (op == "==" || op == "EqEq") { return "ICmpEq" }
        if (op == "!=" || op == "Neq") { return "ICmpNe" }
        if (op == "<" || op == "Lt") { return "ICmpSlt" }
        if (op == ">" || op == "Gt") { return "ICmpSgt" }
        if (op == "<=" || op == "LtEq") { return "ICmpSle" }
        if (op == ">=" || op == "GtEq") { return "ICmpSge" }
        if (op == "<<" || op == "LtLt") { return "Shl" }
        if (op == ">>" || op == "GtGt") { return "Shr" }
        if (op == "&" || op == "Ampersand") { return "And" }
        if (op == "|" || op == "Pipe") { return "Or" }
        if (op == "^" || op == "Caret") { return "Xor" }
        return "Add"
    }

    /// 映射一元运算符到 MIR 操作符。
    private fun mapUnaryOp(op: String): String {
        if (op == "-" || op == "Minus") { return "Neg" }
        if (op == "!" || op == "Bang") { return "Not" }
        if (op == "+" || op == "Plus") { return "Pos" }
        return "Neg"
    }

    // ── 变量映射 ──

    /// 向变量映射表追加一个条目。
    ///
    /// 使用 `name|vid\n` 拼接格式，与 MirLower.aura 一致。
    private fun varMapAdd(name: String, vid: Int) {
        this.varMap = this.varMap + name + "|" + toStr(vid) + "\n"
        // Phase A S2: 变量重命名 — 每次赋值递增版本号
        this.bumpVarVersion(name)
    }

    /// Phase A S2: 递增变量版本号（SSA 变量重命名）。
    ///
    /// 每次赋值创建新的 SSA 版本，确保每个版本是独立的 SSA 值。
    private fun bumpVarVersion(name: String): Unit {
        val currentVersion: Int = this.getVarVersion(name)
        val newVersion: Int = currentVersion + 1
        this.setVarVersion(name, newVersion)
    }

    /// Phase A S2: 获取变量版本号。
    private fun getVarVersion(name: String): Int {
        // 零分配倒序扫描（见 mapVidOf）；未找到时与原实现一致返回 0。
        val v: Int = this.mapVidOf(this.varVersion, name)
        if (v < 0) { return 0 }
        return v
    }

    /// Phase A S2: 设置变量版本号。
    private fun setVarVersion(name: String, version: Int): Unit {
        this.varVersion = this.varVersion + name + "|" + toStr(version) + "\n"
    }

    /// 从变量映射表查找变量值，返回 SSA ValueID。
    ///
    /// 遍历所有 `name|vid\n` 行，按 `|` 拆分后匹配名称。
    private fun varMapLookup(name: String): Int {
        val traceOn: Boolean = Env.get("AURA_PHOTON_TRACE", "") == "1"
        if (traceOn) println("            [vml0] varMapLookup name=" + name)
        if (traceOn) println("            [vml1] varMap length=" + this.varMap.length)
        val vid: Int = this.mapVidOf(this.varMap, name)
        if (traceOn) println("            [vml3] vid=" + vid)
        if (vid >= 0) {
            return vid
        }
        val result: Int = this.program.addValue("Const", this.types.intType(64), "", "0", this.curBlock)
        return result
    }

    // ── 循环栈 ──

    /// 将块 ID 推入循环退出栈。
    private fun loopStackPush(blockId: Int) {
        if (this.loopStack == "") {
            this.loopStack = toStr(blockId)
        } else {
            this.loopStack = toStr(blockId) + "," + this.loopStack
        }
    }

    /// 从循环退出栈弹出块 ID。
    private fun loopStackPop() {
        if (this.loopStack == "") {
            return
        }
        val commaIdx: Int = this.loopStack.indexOf(",")
        if (commaIdx < 0) {
            this.loopStack = ""
        } else {
            this.loopStack = this.loopStack.substring(commaIdx + 1)
        }
    }

    // ── Phase A S2: 支配分析（Dominator Tree）──

    /// 计算支配树（Phase A S2）。
    ///
    /// 使用迭代算法计算每个基本块的立即支配者（idom）。
    /// 算法：从 entry 开始，迭代更新每个块的最早已定义支配者。
    ///
    /// 返回扁平字符串 "blockId|idomBlockId\n" 格式的支配树。
    fun computeDominatorTree(): String {
        val funcCount: Int = this.program.functionCount
        var result: String = ""

        var fi: Int = 0
        while (fi < funcCount) {
            val func: MirFunction = this.program.functionOf(fi)
            val entryBlock: Int = func.entryBlock
            val blocks: List<String> = this.splitStr(func.blocks, ",")

            // 初始化：每个块的 idom = -1（未知），entry 的 idom = entry 自身
            val idom: List<String> = arrayListOf<String>()
            var bi: Int = 0
            while (bi < blocks.size) {
                val bid: Int = this.strToInt(blocks[bi])
                if (bid == entryBlock) {
                    idom.add(toStr(entryBlock))
                } else {
                    idom.add(toStr(-1))
                }
                bi = bi + 1
            }

            // 迭代直到收敛
            var changed: Boolean = true
            var iterations: Int = 0
            while (changed && iterations < 100) {
                changed = false
                iterations = iterations + 1
                bi = 0
                while (bi < blocks.size) {
                    val bid: Int = this.strToInt(blocks[bi])
                    if (bid == entryBlock) { bi = bi + 1; continue }

                    val block: MirBlock = this.program.blockOf(bid)
                    val preds: List<String> = this.splitStr(block.preds, ",")

                    // 找到第一个已定义 idom 的前驱块
                    var newIdom: Int = -1
                    var pi: Int = 0
                    while (pi < preds.size) {
                        val predId: Int = this.strToInt(preds[pi])
                        if (predId >= 0) {
                            // 找到 predId 在 idom 列表中的位置
                            var ri: Int = 0
                            while (ri < blocks.size) {
                                if (this.strToInt(blocks[ri]) == predId) {
                                    if (this.strToInt(idom[ri]) >= 0) {
                                        newIdom = this.strToInt(idom[ri])
                                        break
                                    }
                                    break
                                }
                                ri = ri + 1
                            }
                            if (newIdom >= 0) { break }
                        }
                        pi = pi + 1
                    }

                    // 处理多个前驱的情况：取交集（简化为最早定义者）
                    if (newIdom >= 0) {
                        val curIdom: Int = this.strToInt(idom[bi])
                        if (curIdom != newIdom) {
                            idom[bi] = toStr(newIdom)
                            changed = true
                        }
                    }
                    bi = bi + 1
                }
            }

            // 输出支配树
            bi = 0
            while (bi < blocks.size) {
                val bid: Int = this.strToInt(blocks[bi])
                val idomVal: String = idom[bi]
                result = result + toStr(bid) + "|" + idomVal + "\n"
                bi = bi + 1
            }
            fi = fi + 1
        }
        return result
    }

    /// 获取支配树的扁平字符串（块ID → 立即支配者块ID）。
    fun getDominatorTree(): String {
        return this.computeDominatorTree()
    }

    // ── 工具方法 ──

    /// 字符串转整数。
    private fun strToInt(text: String): Int {
        return SsaMirUtils.strToInt(text)
    }

    /// 整数转字符串。
    private fun toStr(n: Int): String {
        return SsaMirUtils.toStr(n)
    }

    /// 按单字符分隔符分割字符串（VM 不支持 String.split）。
    private fun splitStr(text: String, sep: String): List<String> {
        // 见 MirUtils.mirSplit 的说明：`arrayListOf + add` 在本 VM 下会丢元素。
        if (text == "" || sep == "") { return emptyList() }
        return text.split(sep)
    }
}

// ─────────────────────────────────────────────────────────────
// SsaBuilder 工具对象
// ─────────────────────────────────────────────────────────────

object SsaBuilderUtils {

    /// 执行 HIR → SSA 降级。
    fun build(hir: Hir): MirSsaProgram {
        val builder: SsaBuilder = SsaBuilder()
        return builder.build(hir)
    }

    /// Phase A S2: 执行 HIR → SSA → TAC 降级（连接 Linearizer 到生产路径）。
    ///
    /// 完整 SSA 路径：
    ///   1. SsaBuilder.build(hir) — HIR → SSA MIR
    ///   2. Linearizer.linearize(ssa) — SSA MIR → TAC MIR
    ///
    /// 返回 TAC MIR，可直接传递给现有 Codegen.aura。
    /// 当 Linearizer 不可用时，回退到 MirLower（TAC 直出）。
    fun buildToTAC(hir: Hir): Mir {
        // Step 1: HIR → SSA MIR
        val builder: SsaBuilder = SsaBuilder()
        val ssa: MirSsaProgram = builder.build(hir)

        // Step 2: SSA → TAC MIR（通过 Linearizer）
        val lin: Linearizer = Linearizer()
        return lin.linearize(ssa)
    }
}
