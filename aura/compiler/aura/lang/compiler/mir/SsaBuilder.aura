// aura:///aura/lang/compiler/mir/SsaBuilder.aura
package aura.lang.compiler.mir
// ─────────────────────────────────────────────────────────────
// HIR → SSA MIR 构建器 — Phase A (任务 A.3)
//
// 将 HIR 树状结构降级为 SSA MIR（CFG + SSA + memory chain）。
// 核心算法：
//   1. 遍历 HIR 构建基本块和控制流
//   2. 表达式平坦化（HIR → 指令序列）
//   3. Phi 插入（Cytron 算法）
//   4. Memory chain 插入（显式内存依赖）
//
// ── 与现有 MirLower.aura 的关系 ──
//
//   * MirLower.aura: HIR → TAC MIR（VM 路径使用）
//   * SsaBuilder.aura: HIR → SSA MIR（AOT/JIT 路径使用）
//   * 两者独立，各自消费 HIR 产出不同的 IR
//
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String
import aura.lang.std.Env
import "../hir/Hir.aura"
import "../lexer/Span.aura"
// 同包依赖：输出程序类型 / 类型注册表 / 扁平字符串助手。
// 同包符号需显式导入才进入编译单元（否则退化为未解析调用 #65535）。
import "SsaMir.aura"
import "TypeRegistry.aura"
import "Mir.aura"
import "Linearizer.aura"

/// HIR → SSA MIR 构建器。
class SsaBuilder {

    /// 输出的 SSA MIR 程序。
    private var program: MirSsaProgram = MirSsaProgram()

    /// 类型注册表（快捷引用）。
    private var types: TypeRegistry = TypeRegistry()

    /// 当前函数索引。
    private var curFunc: Int = -1

    /// 当前块索引。
    private var curBlock: Int = 0

    /// 临时值计数器（用于调试命名）。
    private var tmpCount: Int = 0

    /// 临时性能探针：已构建函数数（用于定位 Phase A 的规模行为）。
    private var dbgFuncCount: Int = 0

    /// 临时性能探针：varMap/varVersion 查询次数与累计扫描字符数。
    private var dbgLookups: Int = 0
    private var dbgScanned: Int = 0

    /// 临时性能探针：各类操作调用次数。
    private var dbgStmts: Int = 0
    private var dbgExprs: Int = 0
    private var dbgBlocks: Int = 0
    private var dbgCalls: Int = 0
    private var dbgHasType: Int = 0

    /// 内存链当前值（memory chain head）。
    private var memHead: Int = -1

    /// 当前函数的参数值列表（ValueID 逗号分隔）。
    private var curParams: String = ""

    /// 局部变量名 → ValueID 映射（扁平字符串：name|vid\nname|vid\n…）。
    ///
    /// 采用与 MirLower.aura 一致的扁平字符串格式（`name|vid\n` 拼接），
    /// 避免 `HashMap<String, Int>` 在 VM 内类调用时未链接的问题。
    private var varMap: String = ""

    /// 循环退出块栈（逗号分隔 BlockID，用于 break/continue 的退出目标查找）。
    private var loopStack: String = ""

    /// Phase A S2: 变量版本号映射（扁平字符串：name|version\n）。
    ///
    /// 用于 SSA 变量重命名：每次赋值递增版本号，确保每个版本是独立的 SSA 值。
    private var varVersion: String = ""

    // ── 类/结构体元数据（Photon 对象模型 A-1/A-3）──
    //
    // HIR 的 `HirClass`/`HirStruct` 形状：
    //     HirClass(name, ty = 基类名, kids = [HirBlock(kids = [HirVarDecl/…, HirFunction/…])])
    // 类体块里的 `HirVarDecl`/`HirValDecl` 是**字段**，`HirFunction` 是方法。
    // 这里在建 SSA 之前做一次预扫描，得到三张表：
    //   · classNames / classParents —— 类名与继承关系
    //   · classFields —— `Class|field|index|auraTy|defaultNodeId`（index 为**最终布局序号**）
    //   · funcOwner —— `funcNodeId|classNodeId`（方法 → 属主类）
    // 字段字节偏移 = 16 + index * 8（对象头 [vtable:8][size:8]，见 PhotonRuntime）。

    // ⚠️ 下面这些表**一律用扁平字符串 + indexOf/charCodeAt 扫描**，禁止
    //    per-lookup 的 `split()`：自举 `Main.aura` 有 15 万 HIR 节点 / 2843 个
    //    函数 / 2 万个调用点，任何「每次查询都整表 split」的实现都会退化为
    //    O(N²) 分配（实测本文件初版直接触发框架内存闸门 abort）。
    //    `indexOf` 走 C 侧 strstr，扫描是 C 速度且零分配。

    /// 类名表（`\nName\n`）：`isClassName`。
    private var classNamesCsv: String = ""

    /// 类名（按 arena 顺序，供构造器合成等**冷路径**遍历用）。
    private var classList: List<String> = arrayListOf<String>()

    /// 继承关系（`\nChild|Parent\n`）。
    private var classParents: String = ""

    /// 字段表（`\nClass|field|index|auraTy|defaultNodeId\n`）。
    private var classFields: String = ""

    /// 方法节点 → 属主类名（下标 = HIR 节点 id）。
    ///
    /// ⚠️ 刻意**不用**扁平字符串：`funcOwners` 要登记 ~2800 个方法，逐条拼接
    /// 会累积 ~120 MB 不可回收的中间串（自举 `Main.aura` 直接把框架内存闸门
    /// 打爆）。下标数组是 O(N) 建立、O(1) 查询、且只占 ~1 MB。
    private var ownerByNode: List<String> = arrayListOf<String>()

    /// 类方法表（`\nClass|method\n`）：判定「某类是否声明某方法」。
    private var classMethods: String = ""

    /// 方法 → 唯一属主类（`\nmethod|Class\n`；重名时该行改写为 `\nmethod|\n`）。
    private var methodOwners: String = ""

    /// 方法 → **返回类型**（`\nmethod|retTy\n`；同名方法返回类型不一致置为歧义）。
    ///
    /// 用途：推断**未标注类型**的局部量的静态类型。
    /// `Hir.aura` 的 `lowerCall` 把 HirCall 的 type 一律写空串，所以
    /// `val peephole = PeepholeOptimizerUtils.emptyOptimizer()` 这种（本仓库的
    /// **主要写法**）在 HIR 里拿不到类型 → `localTypeOf("peephole")` 为空 →
    /// 接收者定型失败 → 调用点回落成裸名。
    /// 自举 `Main.aura` 实测因此有 11 个裸方法名未定义（`optimize` / `lower` /
    /// `emitFunction` / `link` / `setOutputType` / `getSize` / `emit` …）。
    private var methodRetTypes: String = ""

    /// 顶层自由函数名（`\nname\n`）。
    ///
    /// 调用点解析必须避开它们：`add(3, 4)` 这样的自由函数调用与
    /// `p.add(3, 4)` 在 HIR 里都是 `HirCall(text="add")`，若只按「唯一属主」
    /// 回退，会把 `add(3,4)` 误接到 `ArrayList_add`（实测 05_functions 崩溃）。
    private var freeFuncs: String = ""

    /// 当前函数所属类（空 = 自由函数）。
    private var curClass: String = ""

    /// 当前函数内「局部变量名 → 声明类型名」（每行 `name|TypeName`，倒序优先）。
    private var localTypes: String = ""

    init() {
        this.program = MirSsaProgram()
        this.types = this.program.types
        this.curFunc = -1
        this.curBlock = 0
        this.tmpCount = 0
        this.memHead = -1
        this.curParams = ""
        this.varMap = ""
        this.varVersion = ""
        this.loopStack = ""
        this.classNamesCsv = ""
        this.classList = arrayListOf<String>()
        this.classParents = ""
        this.classFields = ""
        this.classMethods = ""
        this.methodOwners = ""
        this.methodRetTypes = ""
        this.freeFuncs = ""
        this.ownerByNode = arrayListOf<String>()
        this.curClass = ""
        this.localTypes = ""
    }

    // ── 主入口 ──

    /// 执行 HIR → SSA 降级，返回 SSA MIR 程序。
    ///
    /// 函数收集走**单次线性 arena 扫描**（见 [`buildAllFunctions`]），
    /// 不再从 `HirProgram` 根递归下钻容器节点。
    fun build(src: Hir): MirSsaProgram {
        this.program = MirSsaProgram()
        this.types = this.program.types
        this.tmpCount = 0

        // 类元数据必须在建函数之前就绪：方法与调用点都要用它解析字段/构造器。
        this.buildClassIndex(src)
        this.synthesizeCtors(src)

        this.buildAllFunctions(src)

        return this.program
    }

    /// 线性扫描 HIR arena，为每个 `HirFunction` 建 SSA，返回已建函数数。
    ///
    /// **为什么用线性扫描而不是「从根递归下钻 + visited 去重」**
    ///
    /// 1. **正确性**：`object X { fun m() }` / `class C { fun m() }` 的方法被塞在
    ///    `HirObject`/`HirClass` 的 `HirBlock` 子节点里（不是 `HirProgram` 的直接
    ///    子节点）。递归下钻必须逐个容器特判（`HirExternObject` 直接挂函数、
    ///    `HirObject`/`HirClass` 还要再穿一层 `HirBlock`），漏一种就整批丢方法 ——
    ///    实测自举 `Main.aura`：只扫根节点的直接子节点会丢掉 `object MainUtils`
    ///    的全部方法，链接期一片 `undefined symbol`。
    /// 2. **避免指数级内存增长**：HIR 节点可被多处引用，递归下钻会重复展开子树；
    ///    实测自举 `Main.aura` 上内存从 ~300 MB 起翻倍增长（>16 GB 仍不够）。
    /// 3. **去重不可靠**：曾用 `HashSet<Int>` 做 visited 集合，但 `HashSet` 在本
    ///    VM/AOT 两侧都不可用 —— 种子 VM 下 `add` 静默失败（`size` 恒为 0），
    ///    AOT 产物直接访问违例（0xC0000005）。去重因此从未生效。
    ///
    /// HIR 是扁平 arena（`kindOf`/`textOf` 均为 O(1) 下标访问），所以按下标
    /// `0..count-1` 扫一遍即可覆盖**全部**函数（顶层 `fun`、`object`/`class` 方法、
    /// `init` 块），且每个节点恰好访问一次 ⇒ 严格 O(count)，无递归、无去重集合、
    /// 无栈溢出风险。这与 AOT 发射器「按 `hir.count` 全量扫描 `HirFunction`」的
    /// 收集口径一致。
    ///
    /// 调用点无需改造：`HirLowerer.lowerCall` 对 `X.m()` 只取**成员名**作 calleeName
    /// （裸名），`lowerFunction` 也不为对象方法附加接收者参数，所以只要方法被建成
    /// 顶层函数，`call @m` 就能解析到。
    fun buildAllFunctions(src: Hir): Int {
        val traceOn: Boolean = Env.get("AURA_PHOTON_TRACE", "") == "1"
        val n: Int = src.count
        var i: Int = 0
        while (i < n) {
            if (src.kindOf(i) == "HirFunction") {
                this.dbgFuncCount = this.dbgFuncCount + 1
                // 崩溃诊断：AURA_PHOTON_TRACE=1 时逐函数打印，定位精确崩溃点
                if (traceOn) {
                    println("      [ssab] n=" + this.dbgFuncCount + " " + src.textOf(i))
                }
                this.buildFunction(src, i)
                if (traceOn) {
                    println("      [ssae] n=" + this.dbgFuncCount + " values=" + this.program.valueCount +
                            " exprs=" + this.dbgExprs +
                            " tys=" + this.types.count)
                }
            }
            i = i + 1
        }
        return this.dbgFuncCount
    }

    // ── 函数构建 ──

    /// 构建一个函数的 SSA MIR，返回 FunctionID。
    fun buildFunction(src: Hir, id: Int): Int {
        // 进度探针：大规模自举编译（111 模块 / 15 万 HIR 节点）时每 200 个函数
        // 汇报一次，用来定位「SSA 降级卡在第几个函数」。（计数在 build() 循环里）
        // 默认关闭。`buildFunction` 每个函数都会走到这里，而 `Env.get` 每次都
        // 重读 environ 缓冲，所以只在真的到打印点时才读开关。
        if (this.dbgFuncCount % 200 == 0) {
            if (Env.get("AURA_PHOTON_VERBOSE", "") == "1"
                    || Env.get("AURA_PHOTON_TRACE", "") == "1"
                    || Env.get("AURA_SSA_PERFN", "") == "1") {
                println("[ssa-prog] funcs=" + toStr(this.dbgFuncCount) +
                        " values=" + toStr(this.program.valueCount))
            }
        }
        if (Env.get("AURA_SSA_PERFN", "") == "1") {
            println("[ssa-fn] n=" + toStr(this.dbgFuncCount) + " " + src.textOf(id))
        }
        val traceOn: Boolean = Env.get("AURA_PHOTON_TRACE", "") == "1"
        // ── 类方法符号限定：`Class_method` ──
        //
        // Aura 类方法之间没有名字作用域隔离，裸名会让重名方法在 COFF 里互相覆盖
        // （自举 `Main.aura`：2715 个 `@fn` 只有 2214 个唯一名，`init` 重复 85 次、
        // `push` 9 次 …）。这里统一加类前缀；对应调用点在 `buildCall` 里改写。
        val rawName: String = src.textOf(id)
        val ownerCls: String = this.ownerClassNameOf(id)
        var name: String = rawName
        if (ownerCls != "" && rawName != "") {
            name = ownerCls + "_" + rawName
        }
        val retTy: String = src.tyOf(id)

        // 注册返回类型
        val retTypeId: Int = this.types.fromTypeName(retTy)

        // 创建函数
        val fid: Int = this.program.addFunction(name, retTypeId, retTypeId, false)
        this.curFunc = fid
        this.curParams = ""
        this.varMap = ""
        this.varVersion = ""

        // 创建入口块
        val entryBlock: Int = this.program.addBlock()
        if (traceOn) println("    [bf1] curBlock=" + entryBlock)
        this.curBlock = entryBlock
        if (traceOn) println("    [bf2] after curBlock set")

        // 初始化内存链（函数入口的 memory 状态）
        val memTypeId: Int = this.types.intType(64)
        if (traceOn) println("    [bf3] before addValue entry_mem")
        this.memHead = this.program.addValue("Const", memTypeId, "", "entry_mem", entryBlock)
        if (traceOn) println("    [bf4] after addValue entry_mem")

        // ── 类方法：注入隐式 `this` 形参（接收者），且必须排在显式形参之前 ──
        //
        // HIR 的成员调用把接收者作为**第一个实参**传下来（Hat 里形如
        // `@call @method(@recv, @mem)`），而方法自身此前声明 0 个形参 —— 形参表
        // 与调用约定整体错位一位。补上 self 后，方法体里的字段访问才有基址。
        this.curClass = ""
        this.localTypes = ""
        if (ownerCls != "") {
            this.curClass = ownerCls
            val selfVal: Int = this.program.addValue("Param", this.types.fromTypeName("Long"),
                                                     "", "this", entryBlock)
            this.curParams = toStr(selfVal)
            this.varMapAdd("this", selfVal)
            this.program.functionOf(this.curFunc).params = this.curParams
        }

        // 处理参数
        val kids: String = src.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (traceOn) println("    [bf5] kCount=" + kCount)
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            val childKind: String = src.kindOf(childId)
            if (childKind == "HirParam") {
                val paramName: String = src.textOf(childId)
                val paramTy: String = src.tyOf(childId)
                val paramTypeId: Int = this.types.fromTypeName(paramTy)
                this.localTypeAdd(paramName, paramTy)
                if (traceOn) println("    [bf6] param=" + paramName)

                // 创建参数值（作为入口块的指令）
                val paramVal: Int = this.program.addValue("Param", paramTypeId, "", paramName, entryBlock)

                // 添加到参数列表
                if (this.curParams == "") {
                    this.curParams = toStr(paramVal)
                } else {
                    this.curParams = this.curParams + "," + toStr(paramVal)
                }

                // 添加到变量映射
                this.varMapAdd(paramName, paramVal)

                // 更新函数参数列表
                val f: MirFunction = this.program.functionOf(this.curFunc)
                if (traceOn) println("    [bf7] before f.params=" + this.curParams)
                f.params = this.curParams
                if (traceOn) println("    [bf8] after f.params set")
            }
            i = i + 1
        }

        // 构建函数体
        i = 0
        if (traceOn) println("    [bf9] before buildStmt loop")
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            val childKind: String = src.kindOf(childId)
            if (childKind != "HirParam") {
                if (traceOn) println("    [bf10] buildStmt child=" + childId + " kind=" + childKind)
                this.buildStmt(src, childId)
                if (traceOn) println("    [bf11] after buildStmt child=" + childId)
            }
            i = i + 1
        }
        if (traceOn) println("    [bf12] after buildStmt loop")

        // 如果没有终结指令，添加默认的 Ret
        val b: MirBlock = this.program.blockOf(this.curBlock)
        if (b.term < 0) {
            this.program.setTerminator(this.curBlock, "Ret", retTypeId, "", "")
        }

        // 更新函数的块列表
        val func: MirFunction = this.program.functionOf(this.curFunc)
        func.entryBlock = entryBlock
        this.endCurrentFunction()

        return fid
    }

    /// 结束当前函数的构建。
    fun endCurrentFunction() {
        if (this.curFunc >= 0) {
            this.program.endFunction()
            this.curFunc = -1
        }
    }

    // ── 语句构建 ──

    /// 构建一个语句。
    fun buildStmt(src: Hir, id: Int) {
        this.dbgStmts = this.dbgStmts + 1
        val kind: String = src.kindOf(id)

        if (kind == "HirValDecl" || kind == "HirVarDecl") {
            this.buildVarDecl(src, id)
        } else if (kind == "HirIf") {
            this.buildIf(src, id)
        } else if (kind == "HirWhile") {
            this.buildWhile(src, id)
        } else if (kind == "HirBlock") {
            this.buildBlock(src, id)
        } else if (kind == "HirReturn") {
            this.buildReturn(src, id)
        } else if (kind == "HirExprStmt") {
            val kids: String = src.kidsOf(id)
            if (HirUtils.hirKidsCount(kids) > 0) {
                this.buildExpr(src, HirUtils.hirKidsAt(kids, 0))
            }
        } else if (kind == "HirAssign") {
            this.buildAssign(src, id)
        } else if (kind == "HirCall") {
            this.buildExpr(src, id)
        }
    }

    /// 构建变量声明（val/var）。
    fun buildVarDecl(src: Hir, id: Int) {
        val varName: String = src.textOf(id)
        val kids: String = src.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        val declaredTy: String = src.tyOf(id)
        this.localTypeAdd(varName, declaredTy)

        // 未标注类型（本仓库主要写法：`val p = XxxUtils.emptyYyy()`）：
        // 用初始化调用的**返回类型**推断静态类型，供后面的 `resolveMethodSymbol`
        // 做接收者定型。`Hir.aura` 把 HirCall 的 type 一律写空串，所以这里必须
        // 查 `methodRetTypes`（见其说明）。仅接受**唯一且合法**的类名，
        // 拿不准就不登记 —— 宁可回落裸名也不要错误定型（会生成错误符号/偏移）。
        if (declaredTy == "" && kCount > 0) {
            val initNode: Int = HirUtils.hirKidsAt(kids, 0)
            if (src.kindOf(initNode) == "HirCall") {
                val callee: String = src.textOf(initNode)
                if (this.isClassName(callee)) {
                    // (1) **构造调用**：`val lowering = Lowering()` —— 被调名就是类名
                    //（与 `buildCall` 的 `isClassName(funcName) → funcName + "__new"`
                    // 同源约定）。这是本仓库第二主要写法。
                    this.localTypeAdd(varName, callee)
                } else {
                    // (2) **工厂方法**：`val peephole = PeepholeOptimizerUtils.emptyOptimizer()`
                    // → 用方法返回类型（见 `methodRetTypes` / `scanDeclMethodReturnTypes`）。
                    val retTy: String = this.uniqueMethodReturnType(callee)
                    if (retTy != "" && this.isClassName(retTy)) {
                        this.localTypeAdd(varName, retTy)
                    }
                }
            }
        }

        // 降级初始化表达式
        var initVal: Int = -1
        if (kCount > 0) {
            initVal = this.buildExpr(src, HirUtils.hirKidsAt(kids, 0))
        } else {
            // 无初始化：创建零值常量
            val varTy: String = src.tyOf(id)
            val varTypeId: Int = this.types.fromTypeName(varTy)
            if (this.types.isInt(varTypeId)) {
                initVal = this.program.addValue("Const", varTypeId, "", "0", this.curBlock)
            } else if (this.types.isFloat(varTypeId)) {
                initVal = this.program.addValue("Const", varTypeId, "", "0.0", this.curBlock)
            } else {
                initVal = this.program.addValue("Const", varTypeId, "", "null", this.curBlock)
            }
        }

        // 存储到变量映射
        this.varMapAdd(varName, initVal)
    }

    /// 构建 if 语句。
    ///
    /// 创建 then/else/merge 三个基本块：
    ///   cond → CondBr(cond, then, else)
    ///   then → build then body → Br(merge)
    ///   else → build else body → Br(merge)
    ///   merge → Phi 插入（若有变量被两分支定义）
    fun buildIf(src: Hir, id: Int) {
        val traceOn: Boolean = Env.get("AURA_PHOTON_TRACE", "") == "1"
        val kids: String = src.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (kCount < 2) {
            return
        }

        // 降级条件
        val condVal: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, 0))
        if (traceOn) println("      [if1] condVal=" + condVal)

        // 创建 then 块、else 块、merge 块
        val thenBlock: Int = this.program.addBlock()
        val elseBlock: Int = this.program.addBlock()
        val mergeBlock: Int = this.program.addBlock()
        if (traceOn) println("      [if2] then=" + thenBlock + " else=" + elseBlock + " merge=" + mergeBlock)

        // 设置当前块的终结指令为 CondBr
        if (traceOn) println("      [if3] before setTerminator CondBr")
        this.program.setTerminator(this.curBlock, "CondBr", 0,
            toStr(condVal) + "," + toStr(thenBlock) + "," + toStr(elseBlock), "")
        if (traceOn) println("      [if4] after setTerminator CondBr")

        // 保存 varMap 快照（用于检测 then/else 中定义的变量）
        val varMapBefore: String = this.varMap

        // 构建 then 块
        this.curBlock = thenBlock
        this.buildBlock(src, HirUtils.hirKidsAt(kids, 1))
        if (traceOn) println("      [if5] after buildBlock then")

        // 设置 then 块到 merge 块的跳转
        val thenBlockObj: MirBlock = this.program.blockOf(this.curBlock)
        if (thenBlockObj.term < 0) {
            this.program.setTerminator(this.curBlock, "Br", 0, toStr(mergeBlock), "")
        }
        if (traceOn) println("      [if6] after then->merge Br")

        // 保存 then 块中定义的变量
        val varMapAfterThen: String = this.varMap
        if (traceOn) println("      [if7] varMapAfterThen saved")

        // 构建 else 块
        if (kCount > 2) {
            if (traceOn) println("      [if8] before buildBlock else")
            this.curBlock = elseBlock
            this.buildBlock(src, HirUtils.hirKidsAt(kids, 2))
            if (traceOn) println("      [if9] after buildBlock else")
            val elseBlockObj: MirBlock = this.program.blockOf(this.curBlock)
            if (elseBlockObj.term < 0) {
                this.program.setTerminator(this.curBlock, "Br", 0, toStr(mergeBlock), "")
            }
            if (traceOn) println("      [if10] after else->merge Br")
        } else {
            if (traceOn) println("      [if8b] no else, direct Br")
            // 无 else 分支：直接跳转到 merge
            this.curBlock = elseBlock
            this.program.setTerminator(this.curBlock, "Br", 0, toStr(mergeBlock), "")
            if (traceOn) println("      [if10b] after no-else Br")
        }

        // 保存 else 块中定义的变量
        val varMapAfterElse: String = this.varMap
        if (traceOn) println("      [if11] varMapAfterElse saved")

        // 在 merge 块插入 Phi 节点（for variables defined in both branches）
        if (traceOn) println("      [if12] before insertPhisAtMerge")
        this.insertPhisAtMerge(mergeBlock, varMapBefore, varMapAfterThen, varMapAfterElse)
        if (traceOn) println("      [if13] after insertPhisAtMerge")

        // 恢复 varMap 到 merge 块的状态（合并 then/else 的定义）
        this.varMap = varMapAfterElse  // else 块的定义优先

        // 继续构建 merge 块
        this.curBlock = mergeBlock
        if (traceOn) println("      [if14] curBlock=merge")
    }

    /// 在 merge 块插入 Phi 节点。
    ///
    /// 比较 then/else 分支中定义的变量，为两分支都定义的变量插入 Phi。
    /// varMap 格式：name|vid\nname|vid\n...
    private fun insertPhisAtMerge(mergeBlock: Int, before: String,
                                    afterThen: String, afterElse: String): Unit {
        // 找出 then 中新增/修改的变量
        val thenDefs: List<String> = this.findChangedVars(before, afterThen)
        // 找出 else 中新增/修改的变量
        val elseDefs: List<String> = this.findChangedVars(before, afterElse)

        // 对 then 中定义的变量，检查是否在 else 中也定义
        var i: Int = 0
        while (i < thenDefs.size) {
            val varName: String = thenDefs[i]
            // 检查 else 是否也定义了这个变量
            var foundInElse: Boolean = false
            var j: Int = 0
            while (j < elseDefs.size) {
                if (elseDefs[j] == varName) {
                    foundInElse = true
                    break
                }
                j = j + 1
            }
            if (foundInElse) {
                // 获取 then 和 else 中的 ValueID
                val thenVid: Int = this.lookupVar(before, varName, afterThen)
                val elseVid: Int = this.lookupVar(before, varName, afterElse)
                if (thenVid >= 0 && elseVid >= 0) {
                    // 插入 Phi 节点（返回 ValueID，但不更新 varMap）
                    val typeId: Int = 0  // 默认 Int 类型
                    val incoming: String = toStr(thenVid) + "," + toStr(elseVid)
                    this.makePhi(mergeBlock, typeId, incoming, "")
                }
            }
            i = i + 1
        }
    }

    /// 找出两个 varMap 快照之间新增/修改的变量。
    /// 返回变量名列表。
    private fun findChangedVars(before: String, after: String): List<String> {
        // ⚠️ 不能用 arrayListOf + add（VM bug：add 后 get 返回 null）。
        val csv: String = this.changedVarsCsv(before, after)
        if (csv == "") { return emptyList() }
        return csv.split(",")
    }

    /// 收集「最新 vid 发生变化」的变量名，返回逗号分隔串（最新优先，去重）。
    ///
    /// ⚠️ 性能关键：本函数**每个 `if` 语句**都会被调用（`insertPhisAtMerge`），
    /// 旧实现每次都对 `before`/`after` 整表 `split("\n")`，再对每个候选变量
    /// 逐行 `split("|")` 比对 —— 单次调用 O(A²) 次字符串分配（A = 变量表条目
    /// 数，随函数内赋值数增长）。编译 `Main.aura` 时，`Lexer.scanString` /
    /// `Lexer.scanChar` 这类「大函数 + 深层嵌套 if」把 Phase A 拖到
    /// 单函数 10–25 秒、峰值内存 800 MB+。
    ///
    /// 现改为纯整数索引扫描（`charCodeAt` 比较 + `\n`/`|` 码点定位），
    /// 只对**命中**的名字切片一次，整体 O(表长 × 变量数) 且零中间分配。
    private fun changedVarsCsv(before: String, after: String): String {
        if (before == after) { return "" }
        var resultStr: String = ""
        var end: Int = after.length
        while (end > 0) {
            var start: Int = end - 1
            // ⚠️ 反向扫描必须**只用合法下标**调 `charCodeAt`：
            //   AOT 把 `String.charCodeAt(i)` 降级成无边界检查的内联访存
            //   （`getelementptr i8, i8* s, i64 i` + `load i8`，见 Emit.aura §2.7），
            //   直接绕过 Aura 源码里的 `index < 0` 保护。一旦 `start` 走到 -1
            //   就会读到字符串缓冲区之前一个字节：轻则读到垃圾使扫描不终止，
            //   重则访问违规（0xC0000005）。原写法 `while (start >= 0 &&
            //   after.charCodeAt(start) != 10)` 就踩了这个坑。
            //   改为：循环体内只读 `start > 0` 的字节，下标 0 在循环外单独判定。
            while (start > 0) {
                if (after.charCodeAt(start) == 10) { start = start + 1; break }
                start = start - 1
            }
            if (start == 0) {
                if (after.charCodeAt(0) == 10) { start = 1 }
            }
            if (end > start) {
                var sep: Int = start
                while (sep < end) {
                    if (after.charCodeAt(sep) == 124) { break }
                    sep = sep + 1
                }
                if (sep < end) {
                    // ⚠️ 名字**不能**先切片成 String：AOT 下 `substring` 每次都要
                    // `strlen(整个 after)`（O(|after|)），而本循环逐行调用 ——
                    // 巨型函数（`emitCall`：上万局部变量、上千分支块）上退化成
                    // O(行数 × 表长)。改为把 [start, sep) 当**区间**传下去，
                    // 只在确实要写进结果时才切片。
                    val nlen: Int = sep - start
                    if (nlen > 0 && !this.containsInFlatRange(resultStr, after, start, sep)) {
                        var afterVid: Int = 0
                        var p: Int = sep + 1
                        var neg: Boolean = false
                        if (p < end && after.charCodeAt(p) == 45) { neg = true; p = p + 1 }
                        while (p < end) {
                            val d: Int = after.charCodeAt(p) - 48
                            if (d >= 0 && d <= 9) { afterVid = afterVid * 10 + d }
                            p = p + 1
                        }
                        if (neg) { afterVid = 0 - afterVid }
                        val beforeVid: Int = this.mapVidOfRange(before, after, start, sep)
                        // 新变量（before 中没有）或值发生了变化
                        if (beforeVid < 0 || beforeVid != afterVid) {
                            val name: String = after.substring(start, sep)
                            if (resultStr == "") {
                                resultStr = name
                            } else {
                                resultStr = resultStr + "," + name
                            }
                        }
                    }
                }
            }
            end = start - 1
        }
        return resultStr
    }

    /// 比较 `s[from, to)` 是否与 `token` 逐字符相等（**零分配**）。
    private fun tokenRangeEquals(s: String, from: Int, to: Int, token: String): Boolean {
        if (to - from != token.length) { return false }
        var i: Int = 0
        while (i < token.length) {
            if (s.charCodeAt(from + i) != token.charCodeAt(i)) { return false }
            i = i + 1
        }
        return true
    }

    /// 在 `name|vid\n…` 扁平变量表中，从末尾向前找 `name` 的最新 vid（未找到 -1）。
    ///
    /// 零分配：按 `\n` 定位行，行内按 `|`（124）定位，只对命中项切片一次。
    /// ⚠️ 所有 `charCodeAt` 调用都必须落在 `[0, len)` 内（AOT 内联访存无边界检查）。
    private fun mapVidOf(map: String, name: String): Int {
        if (map == "" || name == "") { return -1 }
        val nlen: Int = name.length
        val mlen: Int = map.length
        // **倒序扫描**：正向实现「保留最后一次匹配」，而倒序遇到的**第一个**匹配
        // 就是它 —— 语义完全等价，但变量通常刚被写入表尾，几步即命中；
        // 正向则必须把整表扫完（表长 ≥ 数千字符 × 每个变量读取一次）。
        //
        // 下标安全：`p` 上界为 `mlen - nlen - 1`（保证 `p + nlen` 是表内下标，
        // 与正向的 `i + nlen < mlen` 判定等价），下界 0；所有 `charCodeAt`
        // 都落在 `[0, mlen)`（AOT 内联访存无边界检查，见 changedVarsCsv 的说明）。
        val c0: Int = name.charCodeAt(0)
        var p: Int = mlen - nlen - 1
        while (p >= 0) {
            if (map.charCodeAt(p) == c0 && map.charCodeAt(p + nlen) == 124) {
                var match: Boolean = true
                var k: Int = 1
                while (k < nlen) {
                    if (map.charCodeAt(p + k) != name.charCodeAt(k)) { match = false; break }
                    k = k + 1
                }
                if (match) {
                    // 就地解析 `|` 之后到行尾的十进制（零分配，不碰 substring）。
                    var j: Int = p + nlen + 1
                    var v: Int = 0
                    var neg: Boolean = false
                    if (j < mlen && map.charCodeAt(j) == 45) { neg = true; j = j + 1 }
                    while (j < mlen && map.charCodeAt(j) != 10) {
                        val d: Int = map.charCodeAt(j) - 48
                        if (d >= 0 && d <= 9) { v = v * 10 + d }
                        j = j + 1
                    }
                    if (neg) { return 0 - v }
                    return v
                }
            }
            p = p - 1
        }
        return -1
    }

    /// 检查扁平字符串（逗号分隔）中是否包含指定名称（零分配扫描，不拆分）。
    private fun containsInFlat(flat: String, name: String): Boolean {
        if (flat == "" || name == "") { return false }
        var start: Int = 0
        val len: Int = flat.length
        var i: Int = 0
        while (i <= len) {
            if (i == len || flat.charCodeAt(i) == 44) {
                if (this.tokenRangeEquals(flat, start, i, name)) { return true }
                start = i + 1
            }
            i = i + 1
        }
        return false
    }

    /// `containsInFlat` 的**区间**版本：候选名是 `text[from, to)`，不切片、不分配。
    ///
    /// 供 `changedVarsCsv` 使用：那里逐行扫描一个可能很大的 `after` 表，
    /// 若每行都先 `substring` 出名字，每次都要 `strlen(整个 after)`（O(|after|)）。
    private fun containsInFlatRange(flat: String, text: String, from: Int, to: Int): Boolean {
        if (flat == "" || to <= from) { return false }
        val tlen: Int = to - from
        val len: Int = flat.length
        var start: Int = 0
        var i: Int = 0
        while (i <= len) {
            if (i == len || flat.charCodeAt(i) == 44) {
                if (i - start == tlen) {
                    var k: Int = 0
                    var ok: Boolean = true
                    while (k < tlen) {
                        if (flat.charCodeAt(start + k) != text.charCodeAt(from + k)) { ok = false; break }
                        k = k + 1
                    }
                    if (ok) { return true }
                }
                start = i + 1
            }
            i = i + 1
        }
        return false
    }

    /// `mapVidOf` 的**区间**版本：名字是 `text[from, to)`（零分配）。
    private fun mapVidOfRange(map: String, text: String, from: Int, to: Int): Int {
        if (map == "" || to <= from) { return -1 }
        val nlen: Int = to - from
        val mlen: Int = map.length
        val c0: Int = text.charCodeAt(from)
        var p: Int = mlen - nlen - 1
        while (p >= 0) {
            if (map.charCodeAt(p) == c0 && map.charCodeAt(p + nlen) == 124) {
                var match: Boolean = true
                var k: Int = 1
                while (k < nlen) {
                    if (map.charCodeAt(p + k) != text.charCodeAt(from + k)) { match = false; break }
                    k = k + 1
                }
                if (match) {
                    var j: Int = p + nlen + 1
                    var v: Int = 0
                    var neg: Boolean = false
                    if (j < mlen && map.charCodeAt(j) == 45) { neg = true; j = j + 1 }
                    while (j < mlen && map.charCodeAt(j) != 10) {
                        val d: Int = map.charCodeAt(j) - 48
                        if (d >= 0 && d <= 9) { v = v * 10 + d }
                        j = j + 1
                    }
                    if (neg) { return 0 - v }
                    return v
                }
            }
            p = p - 1
        }
        return -1
    }

    /// 在 varMap 中查找变量的 ValueID。
    ///
    /// `before` 参数保留以兼容调用点（原实现同样只查 `after`；
    /// `afterThen`/`afterElse` 快照本身已包含 `before` 的全部条目）。
    private fun lookupVar(before: String, name: String, after: String): Int {
        // 从末尾向前搜索以获取最新版本（零分配）
        return this.mapVidOf(after, name)
    }

    /// 在指定块插入 Phi 节点（for loop back-edge）。
    ///
    /// 比较块前状态和块后状态，为两状态都定义的变量插入 Phi。
    /// 用于 while 循环的回边 Phi 插入。
    private fun insertPhisAtBlock(blockId: Int, before: String,
                                    after: String, exitState: String): String {
        // 用逗号分隔的扁平字符串收集变更变量名（不能用 arrayListOf+add，VM bug）
        val afterDefsStr: String = this.findChangedVarsStr(before, after)
        if (afterDefsStr == "") { return this.varMap }

        val afterDefs: List<String> = afterDefsStr.split(",")
        var newVarMap: String = this.varMap
        var i: Int = 0
        while (i < afterDefs.size) {
            val varName: String = afterDefs[i]
            val beforeVid: Int = this.lookupVar("", varName, before)
            if (beforeVid >= 0) {
                val afterVid: Int = this.lookupVar("", varName, after)
                if (afterVid >= 0) {
                    val typeId: Int = 0
                    val incoming: String = toStr(beforeVid) + "," + toStr(afterVid)
                    val phiVid: Int = this.makePhi(blockId, typeId, incoming, "")
                    // 更新 varMap 指向 Phi 节点（追加新版本）
                    newVarMap = newVarMap + varName + "|" + toStr(phiVid) + "\n"
                }
            }
            i = i + 1
        }
        return newVarMap
    }

    /// 找出两个 varMap 快照之间新增/值变化的变量名，返回逗号分隔字符串。
    ///
    /// 与 `findChangedVars` 同源，共用零分配的 `changedVarsCsv`。
    private fun findChangedVarsStr(before: String, after: String): String {
        return this.changedVarsCsv(before, after)
    }

    /// 构建 while 语句。
    ///
    /// 创建 cond/body/end 三个基本块：
    ///   cond → 降级条件 → CondBr(cond, body, end)
    ///   body → 构建循环体 → Br(cond)
    ///   end  → 循环结束
    ///
    /// 使用 loopStack 记录循环退出块，供 break/continue 查找。
    ///
    /// ⚠️ Phi 的插入时机（循环变量正确性的关键）：
    /// Phi **必须在构建循环体之前**创建并写入 varMap。旧实现在循环体构建完
    /// 之后再插入 Phi —— 此时循环体里对 `i` 的每一处引用都已解析成**循环前的
    /// 旧值**（如 `var i = 0` 的常量 0），循环体读到的 `i` 永远是初值：
    /// 实测 `while (i < 5) { println(...); i = i + 1 }` 打印 "while i = 0" 无限
    /// 循环（`i + 1` 恒为 0+1，`i` 本身从不更新）。
    ///
    /// 现改为：
    ///   1. 预扫描循环体，收集被赋值的变量名；
    ///   2. 对「循环前已存在」的那些变量，先在 cond 块建 Phi（入边 0 = 循环前值，
    ///      入边 1 先占位）并把 varMap 指向 Phi；
    ///   3. 构建循环体 —— 所有引用自然解析到 Phi；
    ///   4. 回填 Phi 的入边 1 = 循环体末尾该变量的值。
    fun buildWhile(src: Hir, id: Int) {
        val kids: String = src.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (kCount < 2) {
            return
        }

        // 保存 varMap 快照（循环前的状态）
        val varMapBefore: String = this.varMap

        // 保存当前块（入口块），创建新的条件块
        val entryBlock: Int = this.curBlock
        val condBlock: Int = this.program.addBlock()
        val bodyBlock: Int = this.program.addBlock()
        val endBlock: Int = this.program.addBlock()

        // 将结束块推入循环栈
        this.loopStackPush(endBlock)

        // 入口块跳转到条件块（如果尚未设置终结指令）
        val entryBlockObj: MirBlock = this.program.blockOf(entryBlock)
        if (entryBlockObj.term < 0) {
            this.program.setTerminator(entryBlock, "Br", 0, toStr(condBlock), "")
        }

        val bodyKid: Int = HirUtils.hirKidsAt(kids, 1)

        // ── 步骤 1+2：预建循环变量 Phi ──
        // phiRecs：每行 "name|phiVid|beforeVid"
        val assignedNames: String = this.collectAssignedVars(src, bodyKid, "")
        var phiRecs: String = ""
        var phiVarEntries: String = ""
        if (assignedNames != "") {
            val names: List<String> = assignedNames.split(",")
            var ni: Int = 0
            while (ni < names.size) {
                val nm: String = names[ni]
                val beforeVid: Int = this.lookupVar("", nm, varMapBefore)
                if (beforeVid >= 0) {
                    // 入边 1 先占位为 beforeVid，稍后回填。
                    val incoming: String = toStr(beforeVid) + "," + toStr(beforeVid)
                    val phiVid: Int = this.makePhi(condBlock, 0, incoming, "")
                    this.varMap = this.varMap + nm + "|" + toStr(phiVid) + "\n"
                    phiVarEntries = phiVarEntries + nm + "|" + toStr(phiVid) + "\n"
                    phiRecs = phiRecs + nm + "|" + toStr(phiVid) + "|" + toStr(beforeVid) + "\n"
                }
                ni = ni + 1
            }
        }

        // ── 步骤 3：构建循环体（varMap 已指向 Phi）──
        this.curBlock = bodyBlock
        this.buildBlock(src, bodyKid)

        // 循环体结束：跳回条件块
        val bodyBlockObj: MirBlock = this.program.blockOf(this.curBlock)
        if (bodyBlockObj.term < 0) {
            this.program.setTerminator(this.curBlock, "Br", 0, toStr(condBlock), "")
        }

        // 保存循环体中定义的变量
        val varMapAfterBody: String = this.varMap

        // ── 步骤 4：回填 Phi 的第二条入边（循环体末尾的值）──
        if (phiRecs != "") {
            val recLines: List<String> = this.splitStr(phiRecs, "\n")
            var ri: Int = 0
            while (ri < recLines.size) {
                val rec: String = recLines[ri]
                if (rec != "") {
                    val recParts: List<String> = this.splitStr(rec, "|")
                    if (recParts.size >= 3) {
                        val nm: String = recParts[0]
                        val phiVid: Int = this.strToInt(recParts[1])
                        val beforeVid: Int = this.strToInt(recParts[2])
                        val afterVid: Int = this.lookupVar("", nm, varMapAfterBody)
                        if (phiVid >= 0 && afterVid >= 0) {
                            // ⚠️ 必须经**命名局部变量**中转写回，两个坑都不能踩：
                            //
                            // (1) 不能写成 `this.program.valueOf(id).args = …`
                            //     （链式临时值上直接赋字段）。AOT 载体下该模式
                            //     **丢失写回**：临时 MirValue 不是 arena 里的那个
                            //     对象，赋值落到死副本上 —— PHI 的第二条入边永远
                            //     停留在占位值（`@phi(@t13, @t13)`），循环变量
                            //     永不更新，产物死循环（实测 P1/04、P2/01、P2/02、
                            //     P2/03；同一份源码 3 次独立 AOT 构建结果一致，
                            //     不是非确定性问题）。先 `val pv = valueOf(id)`
                            //     再写 `pv.args`，则 VM 与 AOT 两侧都正确持久化。
                            //
                            // (2) 也不能 `this.values.set(id, v)` 重新插回槽位：
                            //     `ArrayList.set` 的实现是 `data[index] = value`，
                            //     而 `lowerAssign` 的下标分支产出的 `HirAssign`
                            //     **目标名为空**（`text=""`），AOT 发不出真正的
                            //     字段写回，反而把 arena 里该槽位的对象**毁掉**
                            //     （实测同一 ValueID 回写后读出 `args='i'`、
                            //     `op='??'`，PHI 与整个 SSA 变残骸）。
                            val pv: MirValue = this.program.valueOf(phiVid)
                            pv.args = toStr(beforeVid) + "," + toStr(afterVid)
                        }
                    }
                }
                ri = ri + 1
            }
        }

        // 切换到条件块，使用更新后的 varMap（包含 Phi 节点）
        this.curBlock = condBlock

        // ⚠️ 条件块看到的循环变量必须是 **Phi**，不能是循环体末尾的值：
        // `lookupVar` 从 varMap 末尾向前搜索（最新版本优先），而 varMapAfterBody
        // 末尾是循环体里 `i = i + 1` 的结果。若直接沿用，条件会退化成
        // `(i+1) < 5` —— 实测 while 循环只跑 4 次（for 只跑 2 次）。
        // 这里把 varMap 重置为「循环前状态 + Phi 条目」（Phi 在末尾 → 优先命中）。
        this.varMap = varMapBefore + phiVarEntries

        // 降级条件（使用 Phi 节点作为变量值）
        val condVal: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, 0))

        // 设置条件块的终结指令
        this.program.setTerminator(condBlock, "CondBr", 0,
            toStr(condVal) + "," + toStr(bodyBlock) + "," + toStr(endBlock), "")

        // 将结束块弹出循环栈
        this.loopStackPop()

        // ⚠️ 循环之后的变量值必须是 **Phi**，不能是循环体末尾的值。
        // 理由：`end` 块可以从条件块直接到达（循环一次都没进），此时循环体里的
        // 值**根本没有被求值**——它不支配 end 块，引用它就是非法 SSA。
        // 实测 P2/01_nested_loop：`sum` 被解析成内层循环体的 `sum + i + j`
        //（属于内层块），既违反支配关系，又让该表达式被发射到错误的块里。
        // Phi 恰好携带「最后写回的值 or 循环前的值」，是唯一正确的选择。
        // 因此这里不再还原 `varMapAfterBody`（varMap 已在上一步设为
        // `varMapBefore + phiVarEntries`）。

        // 继续构建结束块
        this.curBlock = endBlock
    }

    /// 递归收集 HIR 子树中被赋值（`HirAssign`）的变量名，返回逗号分隔串（去重）。
    ///
    /// 供 `buildWhile` 预判循环携带变量（loop-carried variables）。
    private fun collectAssignedVars(src: Hir, id: Int, out: String): String {
        var result: String = out
        if (src.kindOf(id) == "HirAssign") {
            val name: String = src.textOf(id)
            if (name != "" && !this.containsInFlat(result, name)) {
                if (result == "") {
                    result = name
                } else {
                    result = result + "," + name
                }
            }
        }
        val kids: String = src.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        var i: Int = 0
        while (i < kCount) {
            result = this.collectAssignedVars(src, HirUtils.hirKidsAt(kids, i), result)
            i = i + 1
        }
        return result
    }

    /// 构建块（HirBlock）。
    fun buildBlock(src: Hir, id: Int) {
        val traceOn: Boolean = Env.get("AURA_PHOTON_TRACE", "") == "1"
        this.dbgBlocks = this.dbgBlocks + 1
        val kids: String = src.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (traceOn) println("    [bb0] buildBlock id=" + id + " kCount=" + kCount)
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            val childKind: String = src.kindOf(childId)
            if (traceOn) println("    [bb1] child=" + i + " id=" + childId + " kind=" + childKind)
            this.buildStmt(src, childId)
            if (traceOn) println("    [bb2] after child=" + i)
            i = i + 1
        }
        if (traceOn) println("    [bb3] buildBlock done id=" + id)
    }

    /// 构建 return 语句。
    fun buildReturn(src: Hir, id: Int) {
        val traceOn: Boolean = Env.get("AURA_PHOTON_TRACE", "") == "1"
        if (traceOn) println("      [ret0] buildReturn id=" + id)
        val kids: String = src.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (traceOn) println("      [ret1] kCount=" + kCount)
        if (kCount > 0) {
            if (traceOn) println("      [ret2] before buildExpr")
            val retVal: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, 0))
            if (traceOn) println("      [ret3] retVal=" + retVal + " before setTerminator")
            this.program.setTerminator(this.curBlock, "Ret", 0, toStr(retVal), "")
            if (traceOn) println("      [ret4] after setTerminator")
        } else {
            if (traceOn) println("      [ret2b] no kids, before setTerminator")
            this.program.setTerminator(this.curBlock, "Ret", 0, "", "")
            if (traceOn) println("      [ret4b] after setTerminator")
        }
    }

    /// 构建赋值语句。
    /// 构建赋值语句（Phase A S2: 内存链 Store）。
    ///
    /// 赋值可能是寄存器赋值或内存 Store。
    /// 当 memHead >= 0 时，创建 Store 指令并更新内存链。
    fun buildAssign(src: Hir, id: Int) {
        val kids: String = src.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (kCount < 1) {
            return
        }
        val varName: String = src.textOf(id)
        // ⚠️ 取**最后一个** kid 作为右值：`HirAssign` 的 kids 形状有两个来源——
        //   * Rust 前端（.phir 路径）：kids = [右值]（目标名在 text，见 Bug C）；
        //   * Aura 自举前端 `HirLowerer.lowerAssign`：kids = [目标表达式…, 右值]
        //     （它遍历 AST 的全部 kids）。
        // 旧实现固定取 kids[0]：在自举前端下拿到的是**目标**（如 `c` 的当前值），
        // 于是 `c = c + 1` 退化成「把 c 的原值再存一次」，循环变量永不递增
        // （实测 04_control_flow 产物死循环、03_arithmetic 输出 `c = 5`）。
        val lastKid: Int = HirUtils.hirKidsCount(kids) - 1
        val val: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, lastKid))

        // ── 类字段写入：`this.x = v` / `p.x = v` ──
        //
        // 目标在 kids[0]（`HirMember`），此时 `src.textOf(id)` 为空 —— 旧路径会
        // 把这个赋值当成「变量名为空」的 Store，等于整条丢掉。
        if (kCount >= 2) {
            val targetId: Int = HirUtils.hirKidsAt(kids, 0)
            if (src.kindOf(targetId) == "HirMember") {
                val fname: String = src.textOf(targetId)
                val tk: String = src.kidsOf(targetId)
                if (HirUtils.hirKidsCount(tk) >= 1) {
                    val recvNode: Int = HirUtils.hirKidsAt(tk, 0)
                    val owner: String = this.receiverClassOf(src, recvNode)
                    if (owner != "") {
                        val fIdx: Int = this.classFieldIndex(owner, fname)
                        if (fIdx >= 0) {
                            val recvVal: Int = this.buildExpr(src, recvNode)
                            this.emitFieldSet(recvVal, fIdx, val)
                            return
                        }
                    }
                }
            }
        }

        // Phase A S2: 内存链 — 赋值是内存写入操作
        if (this.memHead >= 0) {
            val varTy: String = src.tyOf(id)
            val varTypeId: Int = this.types.fromTypeName(varTy)
            var args: String = toStr(val)
            args = args + "," + toStr(this.memHead)
            this.program.addValue("Store", varTypeId, args, varName, this.curBlock)

            // 更新内存链 — Store 后创建新的 mem token
            val memTypeId: Int = this.types.intType(64)
            this.memHead = this.program.addValue("MemToken", memTypeId, toStr(val), "mem_after_store", this.curBlock)
        }

        // 存储到变量映射（无论是否内存链，都更新 varMap）
        this.varMapAdd(varName, val)
    }

    // ── 表达式构建 ──

    /// 构建一个表达式，返回 SSA ValueID。
    fun buildExpr(src: Hir, id: Int): Int {
        val traceOn: Boolean = Env.get("AURA_PHOTON_TRACE", "") == "1"
        this.dbgExprs = this.dbgExprs + 1
        val kind: String = src.kindOf(id)
        if (traceOn) println("        [expr] id=" + id + " kind=" + kind)

        if (kind == "HirLit") {
            return this.buildLit(src, id)
        }
        if (kind == "HirVar") {
            return this.buildVar(src, id)
        }
        if (kind == "HirBinary") {
            return this.buildBinary(src, id)
        }
        if (kind == "HirUnary") {
            return this.buildUnary(src, id)
        }
        if (kind == "HirCall") {
            return this.buildCall(src, id)
        }
        if (kind == "HirMember") {
            return this.buildMember(src, id)
        }
        if (kind == "HirIndex") {
            return this.buildIndex(src, id)
        }
        if (kind == "HirBlock") {
            // 块表达式：构建块，返回最后一个表达式的值
            val kids: String = src.kidsOf(id)
            val kCount: Int = HirUtils.hirKidsCount(kids)
            if (kCount == 0) {
                return -1
            }
            // 构建块中的所有语句
            var lastVal: Int = -1
            var i: Int = 0
            while (i < kCount) {
                val childKind: String = src.kindOf(HirUtils.hirKidsAt(kids, i))
                if (childKind == "HirExprStmt") {
                    val ek: String = src.kidsOf(HirUtils.hirKidsAt(kids, i))
                    if (HirUtils.hirKidsCount(ek) > 0) {
                        lastVal = this.buildExpr(src, HirUtils.hirKidsAt(ek, 0))
                    }
                } else if (childKind != "HirReturn" && childKind != "HirIf"
                    && childKind != "HirWhile" && childKind != "HirBlock") {
                    lastVal = this.buildExpr(src, HirUtils.hirKidsAt(kids, i))
                } else {
                    this.buildStmt(src, HirUtils.hirKidsAt(kids, i))
                }
                i = i + 1
            }
            return lastVal
        }

        // 默认：返回零值常量
        if (traceOn) println("        [expr] default branch for kind=" + kind)
        val ty: String = src.tyOf(id)
        val typeId: Int = this.types.fromTypeName(ty)
        if (this.types.isInt(typeId)) {
            return this.program.addValue("Const", typeId, "", "0", this.curBlock)
        } else if (this.types.isFloat(typeId)) {
            return this.program.addValue("Const", typeId, "", "0.0", this.curBlock)
        } else {
            return this.program.addValue("Const", typeId, "", "null", this.curBlock)
        }
    }

    /// 构建字面量。
    fun buildLit(src: Hir, id: Int): Int {
        val text: String = src.textOf(id)
        val ty: String = src.tyOf(id)
        val typeId: Int = this.types.fromTypeName(ty)

        if (this.types.isInt(typeId)) {
            return this.program.addValue("Const", typeId, "", text, this.curBlock)
        } else if (this.types.isFloat(typeId)) {
            return this.program.addValue("Const", typeId, "", text, this.curBlock)
        } else if (this.types.isBool(typeId)) {
            if (text == "true") {
                return this.program.addValue("Const", typeId, "", "1", this.curBlock)
            } else {
                return this.program.addValue("Const", typeId, "", "0", this.curBlock)
            }
        } else {
            return this.program.addValue("Const", typeId, "", text, this.curBlock)
        }
    }

    /// 构建变量引用。
    fun buildVar(src: Hir, id: Int): Int {
        val traceOn: Boolean = Env.get("AURA_PHOTON_TRACE", "") == "1"
        if (traceOn) println("          [var0] buildVar id=" + id)
        val name: String = src.textOf(id)
        if (traceOn) println("          [var1] name=" + name)

        // 真正的局部变量/形参优先（`varMapLookup` 未命中时会静默返回常量 0，
        // 因此这里必须先探测命中与否）。
        val direct: Int = this.mapVidOf(this.varMap, name)
        if (direct >= 0) {
            return direct
        }

        // ── 类体内裸字段名（`x` 而非 `this.x`）──
        // Aura 允许方法内直接写字段名；HIR 只留 `HirVar("x")`，这里按当前类的
        // 字段布局把它改写为 `self.x` 的读取。
        if (this.curClass != "") {
            val fIdx: Int = this.classFieldIndex(this.curClass, name)
            if (fIdx >= 0) {
                val selfVal: Int = this.mapVidOf(this.varMap, "this")
                if (selfVal >= 0) {
                    return this.emitFieldGet(selfVal,
                        this.classFieldTypeByName(this.curClass, name), fIdx)
                }
            }
        }

        return this.varMapLookup(name)
    }

    /// 构建二元运算。
    fun buildBinary(src: Hir, id: Int): Int {
        val op: String = src.textOf(id)
        val kids: String = src.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (kCount < 2) {
            return -1
        }

        val left: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, 0))
        val right: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, 1))
        val typeId: Int = this.types.fromTypeName(src.tyOf(id))

        // ── 字符串判等：`==` / `!=` 必须按**内容**比较 ──
        //
        // ⚠️ 旧实现一律走整数比较（`Eq` / `Ne`），对 String 等价于**指针比较**：
        // 两个内容相同的空串只要不是同一个字面量指针就不相等。实测探针
        //（`build/boot_probe.aura`，走完全相同的自举链路）：
        //     val s: String = Env.get("AURA_ARGV_COUNT")   // 返回静态空串
        //     println("len=" + toStr(s.length))            // 输出 0
        //     if (s == "") { println("M4-empty") }         // ← 不执行（判为 false）
        //
        // 运行库已提供按内容比较的 `streq(rcx=a, rdx=b) -> rax = 1/0`
        //（见 `PhotonRuntime.emitStreq`，注册名 `streq`），这里改为调用它。
        // 随后把结果与 0 比较取回布尔：`==` ⇔ `eqVal != 0`，`!=` ⇔ `eqVal == 0`。
        if (op == "==" || op == "!=") {
            val lt: Int = this.program.valueOf(left).type
            val rt: Int = this.program.valueOf(right).type
            if (this.types.isString(lt) || this.types.isString(rt)) {
                val i64: Int = this.types.intType(64)
                val eqVal: Int = this.program.addValue("Call", i64,
                    toStr(left) + "," + toStr(right), "streq", this.curBlock)
                // 与 `buildListNew` 一致：调用后推进内存链
                if (this.memHead >= 0) {
                    this.memHead = this.program.addValue("MemToken", i64, toStr(eqVal),
                        "mem_after_call", this.curBlock)
                }
                val zero: Int = this.program.addValue("Const", i64, "", "0", this.curBlock)
                val cmpOp: String = if (op == "==") { "!=" } else { "==" }
                return this.program.addValue(this.mapBinaryOp(cmpOp), typeId,
                    toStr(eqVal) + "," + toStr(zero), "", this.curBlock)
            }
        }

        val args: String = toStr(left) + "," + toStr(right)

        // 映射运算符
        val mirOp: String = this.mapBinaryOp(op)

        return this.program.addValue(mirOp, typeId, args, "", this.curBlock)
    }

    /// 构建一元运算。
    fun buildUnary(src: Hir, id: Int): Int {
        val op: String = src.textOf(id)
        val kids: String = src.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (kCount < 1) {
            return -1
        }

        val operand: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, 0))
        val args: String = toStr(operand)

        // 映射运算符
        val mirOp: String = this.mapUnaryOp(op)
        val typeId: Int = this.types.fromTypeName(src.tyOf(id))

        return this.program.addValue(mirOp, typeId, args, "", this.curBlock)
    }

    /// 构建函数调用。
    fun buildCall(src: Hir, id: Int): Int {
        this.dbgCalls = this.dbgCalls + 1
        var funcName: String = src.textOf(id)
        val kids: String = src.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        // 构建参数列表
        var args: String = ""
        var i: Int = 0
        while (i < kCount) {
            val argVal: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, i))
            if (args == "") {
                args = toStr(argVal)
            } else {
                args = args + "," + toStr(argVal)
            }
            i = i + 1
        }

        // Phase A: 内存链 — 将当前 memHead 作为 Call 的附加参数
        // 这样 Call 的内存依赖被显式建模
        if (funcName == "__list_new") {
            return this.buildListNew(args, kCount)
        }

        // ── 构造器调用：`Point(...)` → 合成函数 `Point__new` ──
        //
        // ⚠️ 刻意加 `__new` 后缀：`PhotonRuntime` 里硬编码了 47 个**编译器自身
        // 类**的零初始化构造器（符号名就是裸类名）。若沿用裸类名，用户类/自举类
        // 会与它们 `duplicate symbol`，且会静默拿到零初始化对象。加后缀后这批
        // 旧桩彻底不可达，构造器体统一由 `synthesizeCtors` 生成。
        if (this.isClassName(funcName)) {
            funcName = funcName + "__new"
        } else {
            // 成员方法调用：把裸方法名解析为声明类的限定符号（A-2）。
            funcName = this.resolveMethodSymbol(src, kids, kCount, funcName)
        }

        if (this.memHead >= 0) {
            if (args == "") {
                args = toStr(this.memHead)
            } else {
                args = args + "," + toStr(this.memHead)
            }
        }

        val typeId: Int = this.types.fromTypeName(src.tyOf(id))
        val callVal: Int = this.program.addValue("Call", typeId, args, funcName, this.curBlock)

        // Phase A: 更新内存链 — Call 后创建新的 mem token
        // 新 token 依赖 Call 的结果，表示调用后的内存状态
        if (this.memHead >= 0) {
            val memTypeId: Int = this.types.intType(64)
            this.memHead = this.program.addValue("MemToken", memTypeId, toStr(callVal), "mem_after_call", this.curBlock)
        }

        return callVal
    }

    /// 把 n 元 `__list_new(e0, e1, …)` 降级为 `alloc(count)` + `count` 次 `setat`。
    ///
    /// 为什么要拆：`__list_new` 是 **n 元**调用，而 Photon 的调用约定
    ///（`X86Emitter.emitCallArgs`）只把前 4 个实参装进 rcx/rdx/r8/r9，第 5 个起
    /// **静默丢弃** —— `[1, 2, 3, 4, 5]` 会丢掉元素 5。拆成
    /// `__list_alloc(count)` / `__list_setat(list, i, ei)`（都 ≤3 元）后既不必
    /// 引入栈传参，列表布局也完全由 runtime 掌控
    ///（`[count][e0][e1]…`，见 `PhotonRuntime.emitListAlloc`）。
    ///
    /// `elems` 是已经构建好的元素值 id（逗号分隔）。
    private fun buildListNew(elems: String, count: Int): Int {
        val i64: Int = this.types.intType(64)
        // 计数常量（args 里必须是值 id，不能直接塞字面量）
        val cntVal: Int = this.program.addValue("Const", i64, "", toStr(count), this.curBlock)
        val listVal: Int = this.program.addValue("Call", i64, toStr(cntVal), "__list_alloc", this.curBlock)

        if (elems != "") {
            val parts: List<String> = elems.split(",")
            var i: Int = 0
            while (i < parts.size) {
                val idxVal: Int = this.program.addValue("Const", i64, "", toStr(i), this.curBlock)
                val setArgs: String = toStr(listVal) + "," + toStr(idxVal) + "," + parts[i]
                this.program.addValue("Call", i64, setArgs, "__list_setat", this.curBlock)
                i = i + 1
            }
        }

        // 与 buildCall 保持一致：调用后推进内存链
        if (this.memHead >= 0) {
            val memTypeId: Int = this.types.intType(64)
            this.memHead = this.program.addValue("MemToken", memTypeId, toStr(listVal),
                                                 "mem_after_call", this.curBlock)
        }
        return listVal
    }

    /// 构建成员访问。
    fun buildMember(src: Hir, id: Int): Int {
        val fieldName: String = src.textOf(id)
        val kids: String = src.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (kCount < 1) {
            return -1
        }

        // ── 类字段读取：`this.x` / `p.x`（p 的声明类型是已知类）──
        val recvNode: Int = HirUtils.hirKidsAt(kids, 0)

        // ── 字符串 `s.length` / `s.size`（**属性式**，无括号）──
        //
        // ⚠️ 属性式访问走的是本方法，**不经过** `buildCall`，因此
        // `InstructionSelection.mapStdlibFuncName` 里那条
        // `recvTy == "String" && name == "length" → "strlen"` 映射**永远不会命中**。
        // 后果：`.length` 落到下面的通用 `GetField`，后端发射不出任何加载指令，
        // 读取的是一个**残留寄存器**（实测自举产物 `main` 的重定位表里**没有
        // `strlen`**）。`cliEnvArgCount()` 的 `while (k < s.length)` 因此拿着
        // 垃圾长度越界扫描 → `0xC0000005`（自举 `Main.exe` 启动崩溃的第二个根因）。
        // 这里直接降级为运行库 `strlen(s)`（按 NUL 结尾计算，与 AOT 侧一致）。
        if (fieldName == "length" || fieldName == "size") {
            val recvTy: String = this.receiverTypeNameOf(src, recvNode)
            if (recvTy == "String") {
                val i64: Int = this.types.intType(64)
                val sv: Int = this.buildExpr(src, recvNode)
                val lenVal: Int = this.program.addValue("Call", i64, toStr(sv),
                                                        "strlen", this.curBlock)
                if (this.memHead >= 0) {
                    this.memHead = this.program.addValue("MemToken", i64, toStr(lenVal),
                                                         "mem_after_call", this.curBlock)
                }
                return lenVal
            }
        }

        val owner: String = this.receiverClassOf(src, recvNode)
        if (owner != "") {
            val fIdx: Int = this.classFieldIndex(owner, fieldName)
            if (fIdx >= 0) {
                val recvVal: Int = this.buildExpr(src, recvNode)
                return this.emitFieldGet(recvVal,
                    this.classFieldTypeByName(owner, fieldName), fIdx)
            }
        }

        val objVal: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, 0))
        var args: String = toStr(objVal)

        // Phase A: 内存链 — GetField 可能读取内存，依赖 memHead
        if (this.memHead >= 0) {
            args = args + "," + toStr(this.memHead)
        }

        val typeId: Int = this.types.fromTypeName(src.tyOf(id))
        val fieldVal: Int = this.program.addValue("GetField", typeId, args, fieldName, this.curBlock)

        // Phase A: 更新内存链 — GetField 后创建新的 mem token
        if (this.memHead >= 0) {
            val memTypeId: Int = this.types.intType(64)
            this.memHead = this.program.addValue("MemToken", memTypeId, toStr(fieldVal), "mem_after_get", this.curBlock)
        }

        return fieldVal
    }

    /// 构建数组/集合元素访问（Phase A S2: 内存链 Load）。
    ///
    /// HirIndex 表示 a[i] 形式的元素访问，属于内存读取操作。
    /// 依赖 memHead 建立内存顺序，访问后更新内存链。
    fun buildIndex(src: Hir, id: Int): Int {
        val kids: String = src.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (kCount < 2) {
            return -1
        }

        val baseVal: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, 0))
        val idxVal: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, 1))
        var args: String = toStr(baseVal) + "," + toStr(idxVal)

        // Phase A S2: 内存链 — 访问依赖 memHead
        if (this.memHead >= 0) {
            args = args + "," + toStr(this.memHead)
        }

        // ── 元素访问降级为 runtime 调用 `__list_get(container, index)` ──
        //
        // 为什么不发射 Load：Photon 的 Load/Store 路径（`Lowering.lowerLoad` →
        // `addValueWithChain`）**不把值登记进 `LirBlock.instrs`**，DAG 里根本
        // 没有加载/存储指令（实测嵌套循环的 Store 全部消失）。索引访问统一走
        // runtime 调用，与 `__list_new` / `.Collections.set` 共用同一套列表布局
        //（`[count][e0][e1]…`，元素 i 在 [8 + i*8]）。
        val typeId: Int = this.types.fromTypeName(src.tyOf(id))
        val getVal: Int = this.program.addValue("Call", typeId, args, "__list_get", this.curBlock)

        // Phase A S2: 更新内存链 — 访问后创建新的 mem token
        if (this.memHead >= 0) {
            val memTypeId: Int = this.types.intType(64)
            this.memHead = this.program.addValue("MemToken", memTypeId, toStr(getVal), "mem_after_get", this.curBlock)
        }

        return getVal
    }

    // ── Phi 节点 ──

    /// 向指定块添加 Phi 节点，返回 ValueID。
    fun makePhi(blockId: Int, typeId: Int, incoming: String, aux: String): Int {
        return this.program.addPhi(blockId, typeId, incoming, aux)
    }

    // ── 运算符映射 ──

    /// 映射二元运算符到 MIR 操作符。
    private fun mapBinaryOp(op: String): String {
        if (op == "+" || op == "Plus") { return "Add" }
        if (op == "-" || op == "Minus") { return "Sub" }
        if (op == "*" || op == "Star") { return "Mul" }
        if (op == "/" || op == "Slash") { return "SDiv" }
        if (op == "%" || op == "Percent") { return "SRem" }
        if (op == "==" || op == "EqEq") { return "ICmpEq" }
        if (op == "!=" || op == "Neq") { return "ICmpNe" }
        if (op == "<" || op == "Lt") { return "ICmpSlt" }
        if (op == ">" || op == "Gt") { return "ICmpSgt" }
        if (op == "<=" || op == "LtEq") { return "ICmpSle" }
        if (op == ">=" || op == "GtEq") { return "ICmpSge" }
        if (op == "<<" || op == "LtLt") { return "Shl" }
        if (op == ">>" || op == "GtGt") { return "Shr" }
        if (op == "&" || op == "Ampersand") { return "And" }
        if (op == "|" || op == "Pipe") { return "Or" }
        if (op == "^" || op == "Caret") { return "Xor" }
        // ── 逻辑与 / 逻辑或（**必须显式列出**，否则落到末尾默认 `Add`）──
        //
        // ⚠️ 这里漏掉 `&&` / `||` 的后果不是「算错一个布尔」，而是**崩溃**：
        // 它们落进默认分支变成 `Add`，`InstructionSelection` 对 `Add` 会走
        // **字符串拼接**（`strcat`）路径，于是 `b1 && b2` 被发射成
        // `strcat(bool1, bool2)` —— 把 0/1 当指针传给 `strcat`，内部
        // `strlen(0)` 直接访问违规。
        //
        // 实测自举 `Main.aura` 的 `main`：
        //     if (cnt0 >= 3 && cliArg(1) == "run") { base = 2 }
        // 编译成
        //     de6f4: setne %dil ; de6fc: movq %rdi,%rdx ; de702: callq strcat
        // ⇒ `Main.exe` 在打印完 `BOOT-1b` 后立刻 `0xC0000005`。
        //
        // 布尔在光子链路里就是 0/1 整数，按位与/或与逻辑与/或在这些取值上
        // 完全等价（与 `&` / `|` 共用 `And` / `Or` 实现）。
        if (op == "&&" || op == "AmpAmp" || op == "AndAnd") { return "And" }
        if (op == "||" || op == "PipePipe" || op == "OrOr") { return "Or" }
        return "Add"
    }

    /// 映射一元运算符到 MIR 操作符。
    private fun mapUnaryOp(op: String): String {
        if (op == "-" || op == "Minus") { return "Neg" }
        if (op == "!" || op == "Bang") { return "Not" }
        if (op == "+" || op == "Plus") { return "Pos" }
        return "Neg"
    }

    // ── 变量映射 ──

    /// 向变量映射表追加一个条目。
    ///
    /// 使用 `name|vid\n` 拼接格式，与 MirLower.aura 一致。
    private fun varMapAdd(name: String, vid: Int) {
        this.varMap = this.varMap + name + "|" + toStr(vid) + "\n"
        // Phase A S2: 变量重命名 — 每次赋值递增版本号
        this.bumpVarVersion(name)
    }

    /// Phase A S2: 递增变量版本号（SSA 变量重命名）。
    ///
    /// 每次赋值创建新的 SSA 版本，确保每个版本是独立的 SSA 值。
    private fun bumpVarVersion(name: String): Unit {
        val currentVersion: Int = this.getVarVersion(name)
        val newVersion: Int = currentVersion + 1
        this.setVarVersion(name, newVersion)
    }

    /// Phase A S2: 获取变量版本号。
    private fun getVarVersion(name: String): Int {
        // 零分配倒序扫描（见 mapVidOf）；未找到时与原实现一致返回 0。
        val v: Int = this.mapVidOf(this.varVersion, name)
        if (v < 0) { return 0 }
        return v
    }

    /// Phase A S2: 设置变量版本号。
    private fun setVarVersion(name: String, version: Int): Unit {
        this.varVersion = this.varVersion + name + "|" + toStr(version) + "\n"
    }

    /// 从变量映射表查找变量值，返回 SSA ValueID。
    ///
    /// 遍历所有 `name|vid\n` 行，按 `|` 拆分后匹配名称。
    private fun varMapLookup(name: String): Int {
        val traceOn: Boolean = Env.get("AURA_PHOTON_TRACE", "") == "1"
        if (traceOn) println("            [vml0] varMapLookup name=" + name)
        if (traceOn) println("            [vml1] varMap length=" + this.varMap.length)
        val vid: Int = this.mapVidOf(this.varMap, name)
        if (traceOn) println("            [vml3] vid=" + vid)
        if (vid >= 0) {
            return vid
        }
        val result: Int = this.program.addValue("Const", this.types.intType(64), "", "0", this.curBlock)
        return result
    }

    // ═════════════════════════════════════════════════════════════
    // 类 / 结构体（Photon 对象模型 A-1 / A-3）
    //
    // 设计约束：Photon 的 `Load`/`Store` 路径不可用（`Lowering.lowerLoad`
    // 用 `addValueWithChain`，值不登记进 `LirBlock.instrs`，DAG 里加载/存储
    // 指令全部消失）。因此字段访问与列表访问一样，统一走 **runtime 调用**：
    //   · `__field_get(obj, index)` → rax = [obj + index*8 + 16]
    //   · `__field_set(obj, index, val)` → [obj + index*8 + 16] = val
    // 对象布局（与 `PhotonRuntime.emitClassConstructorWithVtable` 一致）：
    //   [0x00] vtable 指针(8B)  [0x08] 对象大小(8B)  [0x10+i*8] 字段 i
    // 索引而非字节偏移：复用编码器的 `emitLoadIndexed8`（SIB scale=8）。
    // ═════════════════════════════════════════════════════════════

    /// 取 `key` 之后到下一个 `\n` 之间的片段（未命中返回 ""）。
    ///
    /// 扁平表查找原语：`indexOf` 是 C 侧 `strstr`，再按字符码点扫到行尾，
    /// 一次 `substring` 产出结果 —— 全程**零 split 分配**。
    private fun flatFieldAfter(text: String, key: String): String {
        if (text == "" || key == "") {
            return ""
        }
        val pos: Int = text.indexOf(key)
        if (pos < 0) {
            return ""
        }
        val start: Int = pos + key.length
        var i: Int = start
        val len: Int = text.length
        while (i < len) {
            if (text.charCodeAt(i) == 10) {
                break
            }
            i = i + 1
        }
        if (i <= start) {
            return ""
        }
        return text.substring(start, i)
    }

    /// `text` 自 `pos` 起是否以 `key` 开头（逐码点比较，不分配）。
    private fun flatStartsWith(text: String, pos: Int, key: String): Boolean {
        if (pos < 0 || pos + key.length > text.length) {
            return false
        }
        var i: Int = 0
        while (i < key.length) {
            if (text.charCodeAt(pos + i) != key.charCodeAt(i)) {
                return false
            }
            i = i + 1
        }
        return true
    }

    /// `text` 中出现 `key` 的次数（逐位置滑窗，不分配）。
    private fun flatCount(text: String, key: String): Int {
        if (text == "" || key == "") {
            return 0
        }
        var n: Int = 0
        var i: Int = 0
        val last: Int = text.length - key.length
        while (i <= last) {
            if (this.flatStartsWith(text, i, key)) {
                n = n + 1
            }
            i = i + 1
        }
        return n
    }

    /// 是否为内建**值类型**（`value class String` / `open class Any` 等）。
    ///
    /// 这些类型**不作为对象模型类登记**。原因：它们的成员访问已由
    /// `InstructionSelection.mapStdlibFuncName` 按 `recvTy` 映射到 runtime
    /// （`String.length → strlen`、`Any.equals → streq`、`String.charCodeAt →
    /// charCodeAt` …）。若再按「类 + 字段偏移」处理，会产生 `String_charCodeAt`
    /// 这类**真实函数体**——与 runtime 符号语义重复，且把 DAG 节点数从 ~63k
    /// 推到 ~75k，Phase D（寄存器分配）在 8 GiB 内存闸门下直接退出码 70
    ///（AOT 运行时无 GC，撤下的中间串全部滞留）。
    private fun isBuiltinValueClass(name: String): Boolean {
        if (name == "String" || name == "Any") { return true }
        if (name == "Int" || name == "Long" || name == "Float" || name == "Double") { return true }
        if (name == "Boolean" || name == "Byte" || name == "Short" || name == "Char") { return true }
        if (name == "Unit" || name == "Basic") { return true }
        return false
    }

    /// 是否为已知类/结构体名。
    private fun isClassName(name: String): Boolean {
        if (name == "" || this.classNamesCsv == "") {
            return false
        }
        return this.classNamesCsv.indexOf("\n" + name + "\n") >= 0
    }

    /// 类的直接基类名（无继承返回 ""）。
    private fun parentOfClass(cls: String): String {
        if (cls == "") {
            return ""
        }
        return this.flatFieldAfter(this.classParents, "\n" + cls + "|")
    }

    /// 类**自有**字段数（不含继承）。
    private fun ownFieldCount(cls: String): Int {
        if (cls == "" || this.classFields == "") {
            return 0
        }
        return this.flatCount(this.classFields, "\n" + cls + "|")
    }

    /// 类字段布局的起始序号（= 祖先链上各代「自有字段数」之和）。
    ///
    /// 子类布局 = 父类字段前缀 + 自有字段，因此父类名必须**先**登记。
    /// HIR arena 顺序不保证这一点，所以这里按需递归计算而不是靠扫描顺序。
    private fun classBaseIndex(cls: String): Int {
        val p: String = this.parentOfClass(cls)
        if (p == "") {
            return 0
        }
        return this.classBaseIndex(p) + this.ownFieldCount(p)
    }

    /// 类字段总层数（含继承）。
    private fun classFieldTotal(cls: String): Int {
        return this.classBaseIndex(cls) + this.ownFieldCount(cls)
    }

    /// 对象分配大小（字节）：头 16B + 每个字段 8B。
    private fun classSizeOf(cls: String): Int {
        return 16 + this.classFieldTotal(cls) * 8
    }

    /// 取 `|` 分隔文本的第 `idx` 段（越界返回 ""）。只用于**短**字段尾部。
    private fun flatPart(text: String, idx: Int): String {
        if (text == "") {
            return ""
        }
        var cur: Int = 0
        var start: Int = 0
        var i: Int = 0
        val len: Int = text.length
        while (i <= len) {
            if (i == len || text.charCodeAt(i) == 124) {
                if (cur == idx) {
                    return text.substring(start, i)
                }
                cur = cur + 1
                start = i + 1
            }
            i = i + 1
        }
        return ""
    }

    /// 按「类 + 字段名」取字段记录**尾部**（`index|auraTy|defaultNodeId`）。
    ///
    /// 未命中时沿继承链向上查找 —— 子类字段布局保留父类前缀，因此父类记录
    /// 的序号对子类同样有效。
    private fun fieldTailByName(cls: String, field: String): String {
        if (cls == "" || field == "") {
            return ""
        }
        val key: String = "\n" + cls + "|" + field + "|"
        val pos: Int = this.classFields.indexOf(key)
        if (pos >= 0) {
            val start: Int = pos + key.length
            var i: Int = start
            val len: Int = this.classFields.length
            while (i < len) {
                if (this.classFields.charCodeAt(i) == 10) {
                    break
                }
                i = i + 1
            }
            if (i > start) {
                return this.classFields.substring(start, i)
            }
            return ""
        }
        val p: String = this.parentOfClass(cls)
        if (p != "") {
            return this.fieldTailByName(p, field)
        }
        return ""
    }

    /// 按布局序号取字段记录**尾部**（先本类，再沿继承链向上）。
    private fun fieldTailOfIndex(cls: String, idx: Int): String {
        val text: String = this.classFields
        val len: Int = text.length
        var i: Int = 0
        while (i < len) {
            if (text.charCodeAt(i) == 10) {
                val start: Int = i + 1
                var j: Int = start
                while (j < len) {
                    if (text.charCodeAt(j) == 10) {
                        break
                    }
                    j = j + 1
                }
                val line: String = text.substring(start, j)
                if (this.flatPart(line, 0) == cls
                    && this.parseIntDef(this.flatPart(line, 2), -1) == idx) {
                    return this.flatPart(line, 2) + "|" + this.flatPart(line, 3)
                        + "|" + this.flatPart(line, 4)
                }
                i = j
            } else {
                i = i + 1
            }
        }
        val p: String = this.parentOfClass(cls)
        if (p != "") {
            return this.fieldTailOfIndex(p, idx)
        }
        return ""
    }

    /// 字段在类（含继承链）中的布局序号；未命中返回 -1。
    private fun classFieldIndex(cls: String, field: String): Int {
        val tail: String = this.fieldTailByName(cls, field)
        if (tail == "") {
            return -1
        }
        return this.parseIntDef(this.flatPart(tail, 0), -1)
    }

    /// 字段声明类型名（沿继承链查找；未命中返回 ""）。
    private fun classFieldTypeByName(cls: String, field: String): String {
        return this.flatPart(this.fieldTailByName(cls, field), 1)
    }

    /// 按布局序号取字段声明类型（未命中返回 ""）。
    private fun fieldTypeOfIndex(cls: String, idx: Int): String {
        return this.flatPart(this.fieldTailOfIndex(cls, idx), 1)
    }

    /// 按布局序号取字段默认值表达式节点（无默认值返回 -1）。
    private fun fieldDefaultOfIndex(cls: String, idx: Int): Int {
        return this.parseIntDef(this.flatPart(this.fieldTailOfIndex(cls, idx), 2), -1)
    }

    /// 本类是否已登记该字段（去重，避免重复登记打乱序号）。
    private fun rawFieldIndex(cls: String, field: String): Int {
        if (cls == "" || field == "") {
            return -1
        }
        val key: String = "\n" + cls + "|" + field + "|"
        val pos: Int = this.classFields.indexOf(key)
        if (pos < 0) {
            return -1
        }
        val start: Int = pos + key.length
        var i: Int = start
        val len: Int = this.classFields.length
        while (i < len) {
            if (this.classFields.charCodeAt(i) == 10) {
                break
            }
            i = i + 1
        }
        return this.parseIntDef(this.classFields.substring(start, i), -1)
    }

    /// 整数解析（失败/越界返回默认值）。`SsaMirUtils.strToInt` 对非法输入
    /// 一律返回 0，无法区分「字段序号 0」与「解析失败」，故这里单独实现。
    private fun parseIntDef(s: String, def: Int): Int {
        val t: String = s.trim()
        if (t == "") {
            return def
        }
        var i: Int = 0
        var neg: Boolean = false
        if (t.charCodeAt(0) == 45) {
            neg = true
            i = 1
        }
        if (i >= t.length) {
            return def
        }
        var n: Int = 0
        while (i < t.length) {
            val c: Int = t.charCodeAt(i)
            if (c < 48 || c > 57) {
                return def
            }
            n = n * 10 + (c - 48)
            i = i + 1
        }
        if (neg) {
            return -n
        }
        return n
    }

    /// 登记局部变量/形参的声明类型（倒序查找，后声明者优先）。
    private fun localTypeAdd(name: String, ty: String) {
        if (name == "" || ty == "") {
            return
        }
        this.localTypes = this.localTypes + name + "|" + ty + "\n"
    }

    /// 局部变量声明类型名（未命中返回 ""）。
    private fun localTypeOf(name: String): String {
        if (this.localTypes == "") {
            return ""
        }
        val lines: List<String> = this.splitStr(this.localTypes, "\n")
        var i: Int = lines.size - 1
        while (i >= 0) {
            val parts: List<String> = this.splitStr(lines[i], "|")
            if (parts.size >= 2 && parts[0] == name) {
                return parts[1]
            }
            i = i - 1
        }
        return ""
    }

    /// 接收者表达式的静态类名（不可判定返回 ""）。
    ///
    /// 只用三种可靠来源：`this`（当前方法所属类）、「局部变量/形参的声明类型」、
    /// 以及「`<recv>.<字段>` 的**字段声明类型**」。
    /// Photon 链路没有 sema 信息，凭名字猜类会给出错误字段偏移 —— 那比不解析更糟
    /// （静默读写到别的字段）。
    private fun receiverClassOf(src: Hir, recvNode: Int): String {
        val kind: String = src.kindOf(recvNode)

        // ── `this.<字段>` / `<obj>.<字段>`：静态类型 = 字段的**声明类型** ──
        //
        // ⚠️ 旧实现只认 `HirVar`，于是 `this.dag.addInstr(...)` 的接收者
        //（`HirMember("dag", [HirVar("this")])`）一律返回 ""，调用点退化到
        // 「全局唯一属主」兜底；而 `addInstr` 被 `MirSsaProgram` / `MachineDag` /
        // `LirProgram` 同时声明 ⇒ 属主歧义 ⇒ 保底回落成**裸名**。
        // 自举 `Main.aura` 实测 29 个裸方法名未定义（`addInstr` / `optimize` /
        // `addBlock` / `leaf` / `emit` …），lld-link 因此失败。
        if (kind == "HirMember") {
            val fname: String = src.textOf(recvNode)
            val mk: String = src.kidsOf(recvNode)
            if (fname != "" && HirUtils.hirKidsCount(mk) >= 1) {
                val inner: Int = HirUtils.hirKidsAt(mk, 0)
                val recvCls: String = this.receiverClassOf(src, inner)
                if (recvCls != "") {
                    val fty: String = this.fieldAuraTypeName(recvCls, fname)
                    if (fty != "" && this.isClassName(fty)) {
                        return fty
                    }
                }
            }
            return ""
        }
        if (kind != "HirVar") {
            return ""
        }
        val n: String = src.textOf(recvNode)
        if (n == "this") {
            return this.curClass
        }
        val ty: String = this.localTypeOf(n)
        if (ty != "" && this.isClassName(ty)) {
            return ty
        }
        return ""
    }

    /// 字段的声明类型名（沿继承链查找；未命中返回 ""）。
    private fun fieldAuraTypeName(cls: String, field: String): String {
        var cur: String = cls
        var depth: Int = 0
        while (cur != "" && depth < 16) {
            val ty: String = this.rawFieldAuraType(cur, field)
            if (ty != "") {
                return ty
            }
            cur = this.parentOfClass(cur)
            depth = depth + 1
        }
        return ""
    }

    /// 类**自身**声明的字段类型（不含继承；"" 表示未命中）。
    ///
    /// `classFields` 每行格式：`Class|field|index|auraTy|defaultNodeId`
    ///（见 `addField`），此处取 `key` 之后的第 1 段（0 基）即 `auraTy`。
    private fun rawFieldAuraType(cls: String, field: String): String {
        if (cls == "" || field == "" || this.classFields == "") {
            return ""
        }
        val key: String = "\n" + cls + "|" + field + "|"
        val pos: Int = this.classFields.indexOf(key)
        if (pos < 0) {
            return ""
        }
        val start: Int = pos + key.length
        val len: Int = this.classFields.length
        var i: Int = start
        var seg: Int = 0
        var segStart: Int = start
        while (i <= len) {
            // 结尾补一个换行哨兵，触发最后一次结算
            val c: Int = if (i == len) { 10 } else { (this.classFields.charCodeAt(i) as Int) }
            if (c == 124 || c == 10) {
                if (seg == 1) {
                    return this.classFields.substring(segStart, i)
                }
                seg = seg + 1
                segStart = i + 1
            }
            i = i + 1
        }
        return ""
    }

    /// 方法节点 → 属主类名（自由函数返回 ""）。
    private fun ownerClassNameOf(funcNode: Int): String {
        if (funcNode < 0 || funcNode >= this.ownerByNode.size) {
            return ""
        }
        return this.ownerByNode[funcNode]
    }

    /// 预扫描 HIR，建立「类名 / 继承 / 字段布局 / 方法属主 / 自由函数」五张表。
    private fun buildClassIndex(src: Hir) {
        val n: Int = src.count
        // 属主数组先按 arena 大小铺满空串：registerClass 阶段按下标回填。
        var pre: Int = 0
        while (pre < n) {
            this.ownerByNode.add("")
            pre = pre + 1
        }
        var i: Int = 0
        while (i < n) {
            val k: String = src.kindOf(i)
            if (k == "HirClass" || k == "HirStruct") {
                this.registerClass(src, i)
            }
            i = i + 1
        }

        // ── 类型声明体的「方法返回类型」扫描 ──
        //
        // ⚠️ `Hir.aura:915` 一共产出**四种**类型声明 kind：
        // `HirStruct` / `HirClass` / `HirObject` / `HirEnum`
        //（AOT 参考实现 `Emit.aura:432` 也是四种一视同仁）。旧实现只扫前两种，
        // 于是 `object` 单例的**工厂方法**返回类型缺失 —— 而本仓库的主要写法是
        // `val peephole = PeepholeOptimizerUtils.emptyOptimizer()`（**不标注类型**），
        // `Hir.aura:1781` 又把 HirCall 的 type 一律写空串 ⇒ 局部量无法定型
        // ⇒ 调用点回落成裸名。自举 `Main.aura` 实测 11 个未定义符号
        //（`optimize` / `lower` / `emitFunction` / `setOutputType` / `link` / …）。
        //
        // `HirExternObject` 一并扫（其成员多为 `@native`，无函数体，登记无害）。
        i = 0
        while (i < n) {
            val dk: String = src.kindOf(i)
            if (dk == "HirClass" || dk == "HirStruct" || dk == "HirObject"
                || dk == "HirEnum" || dk == "HirExternObject") {
                this.scanDeclMethodReturnTypes(src, i)
            }
            i = i + 1
        }
        // 第二遍：`funcOwner` 已就绪，可判定哪些 HirFunction 是顶层自由函数。
        i = 0
        while (i < n) {
            if (src.kindOf(i) == "HirFunction") {
                if (this.ownerClassNameOf(i) == "") {
                    val fn: String = src.textOf(i)
                    if (fn != "") {
                        this.freeFuncs = this.freeFuncs + "\n" + fn + "\n"
                    }
                }
            }
            i = i + 1
        }
    }

    /// 是否为顶层自由函数。
    private fun isFreeFunc(name: String): Boolean {
        if (name == "" || this.freeFuncs == "") {
            return false
        }
        return this.freeFuncs.indexOf("\n" + name + "\n") >= 0
    }

    /// 登记单个类/结构体：继承关系 + 字段布局 + 方法属主。
    private fun registerClass(src: Hir, id: Int) {
        val name: String = src.textOf(id)
        if (name == "" || this.isClassName(name) || this.isBuiltinValueClass(name)) {
            return
        }
        this.classNamesCsv = this.classNamesCsv + "\n" + name + "\n"
        this.classList.add(name)

        val parent: String = src.tyOf(id)
        if (parent != "" && parent != name) {
            if (this.classParents == "") {
                this.classParents = name + "|" + parent
            } else {
                this.classParents = this.classParents + "\n" + name + "|" + parent
            }
        }

        // 字段序号起点 = 继承链上祖先的字段总数（父类字段占据前缀）
        var idx: Int = this.classBaseIndex(name)
        val kids: String = src.kidsOf(id)
        val kn: Int = HirUtils.hirKidsCount(kids)
        var j: Int = 0
        while (j < kn) {
            val child: Int = HirUtils.hirKidsAt(kids, j)
            val ck: String = src.kindOf(child)
            if (ck == "HirBlock") {
                idx = this.registerClassBody(src, name, child, idx, id)
            } else if (ck == "HirVarDecl" || ck == "HirValDecl") {
                this.addField(src, name, child, idx)
                idx = idx + 1
            } else if (ck == "HirFunction") {
                this.addMethodOwner(child, name)
            }
            j = j + 1
        }
    }

    /// 登记类体块（字段 + 方法），返回下一个可用字段序号。
    private fun registerClassBody(src: Hir, cls: String, blockId: Int,
                                  startIdx: Int, classNode: Int): Int {
        var idx: Int = startIdx
        val kids: String = src.kidsOf(blockId)
        val kn: Int = HirUtils.hirKidsCount(kids)
        var j: Int = 0
        while (j < kn) {
            val child: Int = HirUtils.hirKidsAt(kids, j)
            val ck: String = src.kindOf(child)
            if (ck == "HirVarDecl" || ck == "HirValDecl") {
                this.addField(src, cls, child, idx)
                idx = idx + 1
            } else if (ck == "HirFunction") {
                this.addMethodOwner(child, cls)
                this.addClassMethod(cls, src.textOf(child))
                this.addMethodReturnType(src.textOf(child), src.tyOf(child))
            } else if (ck == "HirBlock") {
                // 嵌套块（极少见）：继续下钻
                idx = this.registerClassBody(src, cls, child, idx, classNode)
            }
            j = j + 1
        }
        return idx
    }

    /// 登记一个字段：`Class|field|index|auraTy|defaultNodeId`。
    private fun addField(src: Hir, cls: String, declNode: Int, index: Int) {
        val fname: String = src.textOf(declNode)
        if (fname == "" || this.rawFieldIndex(cls, fname) >= 0) {
            return
        }
        val fty: String = src.tyOf(declNode)
        val defId: Int = this.fieldDefaultNode(src, declNode)
        this.classFields = this.classFields + "\n" + cls + "|" + fname + "|"
            + toStr(index) + "|" + fty + "|" + toStr(defId) + "\n"
    }

    /// 字段默认值表达式节点（仅接受字面量；其余走零初始化）。
    ///
    /// 只认字面量是刻意的：默认值在「构造器合成」阶段求值，那里没有
    /// `this`/局部变量上下文，复杂表达式会退化成读 null。
    private fun fieldDefaultNode(src: Hir, declNode: Int): Int {
        val kids: String = src.kidsOf(declNode)
        if (HirUtils.hirKidsCount(kids) < 1) {
            return -1
        }
        val kid: Int = HirUtils.hirKidsAt(kids, 0)
        if (src.kindOf(kid) == "HirLit") {
            return kid
        }
        return -1
    }

    /// 登记「方法 → 属主类」。
    private fun addMethodOwner(funcNode: Int, cls: String) {
        if (cls == "" || funcNode < 0 || funcNode >= this.ownerByNode.size) {
            return
        }
        this.ownerByNode[funcNode] = cls
    }

    /// 登记类方法名（`Class|method`），并维护「唯一属主」表。
    ///
    /// `methodOwners` 里出现第二个不同属主时，把该行改写为 `\nmethod|\n`
    /// （空属主 = 歧义），这样调用点的「唯一属主回退」只需一次 `indexOf`。
    private fun addClassMethod(cls: String, method: String) {
        if (cls == "" || method == "") {
            return
        }
        if (this.classDeclaresMethod(cls, method)) {
            return
        }
        this.classMethods = this.classMethods + "\n" + cls + "|" + method + "\n"

        val key: String = "\n" + method + "|"
        val pos: Int = this.methodOwners.indexOf(key)
        if (pos < 0) {
            this.methodOwners = this.methodOwners + key + cls + "\n"
            return
        }
        // 已存在：不同属主 → 置为歧义（属主片段留空）
        val start: Int = pos + key.length
        var i: Int = start
        val len: Int = this.methodOwners.length
        while (i < len) {
            if (this.methodOwners.charCodeAt(i) == 10) {
                break
            }
            i = i + 1
        }
        val prevOwner: String = this.methodOwners.substring(start, i)
        if (prevOwner != "" && prevOwner != cls) {
            this.methodOwners = this.methodOwners.substring(0, start)
                + this.methodOwners.substring(i, len)
        }
    }

    /// 类自身（不含继承）是否声明了该方法。
    private fun classDeclaresMethod(cls: String, method: String): Boolean {
        if (cls == "" || method == "" || this.classMethods == "") {
            return false
        }
        return this.classMethods.indexOf("\n" + cls + "|" + method + "\n") >= 0
    }

    /// 沿继承链找**声明**该方法的类（未命中返回 ""）。
    ///
    /// 返回「声明类」而不是「接收者类」：符号名由声明处决定（`Parent_m`），
    /// 子类未 override 时调用点也要落到 `Parent_m`。虚分派由 A-6 的 vtable 负责。
    private fun methodOwnerClass(cls: String, method: String): String {
        var cur: String = cls
        var depth: Int = 0
        while (cur != "" && depth < 16) {
            if (this.classDeclaresMethod(cur, method)) {
                return cur
            }
            cur = this.parentOfClass(cur)
            depth = depth + 1
        }
        return ""
    }

    /// 全局只有一个类声明该方法时返回该类，否则返回 ""（重名/未命中）。
    private fun uniqueMethodOwner(method: String): String {
        if (method == "") {
            return ""
        }
        return this.flatFieldAfter(this.methodOwners, "\n" + method + "|")
    }

    /// 登记「方法 → 返回类型」（同名方法返回类型不一致时置为歧义）。
    ///
    /// 刻意**不在登记时**用 `isClassName` 过滤：本表在 `buildClassIndex` 预扫描
    /// 期间建立，而 `classNamesCsv` 要到预扫描结束才完整 —— 中途过滤会把多数
    /// 类名误判为「非类」而丢掉。类型合法性改在**使用点**判断。
    private fun addMethodReturnType(method: String, ty: String) {
        if (method == "" || ty == "") {
            return
        }
        val key: String = "\n" + method + "|"
        val pos: Int = this.methodRetTypes.indexOf(key)
        if (pos < 0) {
            this.methodRetTypes = this.methodRetTypes + key + ty + "\n"
            return
        }
        val start: Int = pos + key.length
        var i: Int = start
        val len: Int = this.methodRetTypes.length
        while (i < len) {
            if (this.methodRetTypes.charCodeAt(i) == 10) {
                break
            }
            i = i + 1
        }
        val prev: String = this.methodRetTypes.substring(start, i)
        if (prev != ty) {
            // 歧义：抹掉类型片段（留下 `\nmethod|\n`）
            this.methodRetTypes = this.methodRetTypes.substring(0, start)
                + this.methodRetTypes.substring(i, len)
        }
    }

    /// 方法的唯一返回类型（歧义 / 未命中返回 ""）。
    private fun uniqueMethodReturnType(method: String): String {
        if (method == "") {
            return ""
        }
        return this.flatFieldAfter(this.methodRetTypes, "\n" + method + "|")
    }

    /// 接收者表达式的**原始声明类型名**。
    ///
    /// 与 `receiverClassOf` 的区别：不要求是「已知类」，集合类型（`List<Int>` /
    /// `HashMap<String,Int>`）也会原样返回 —— 集合成员要走运行库符号，不是类前缀。
    private fun receiverTypeNameOf(src: Hir, recvNode: Int): String {
        val kind: String = src.kindOf(recvNode)
        if (kind == "HirMember") {
            // 字段接收者：类型 = 字段声明类型（先定出「哪个类」，再查字段表）
            val fname: String = src.textOf(recvNode)
            val mk: String = src.kidsOf(recvNode)
            if (fname != "" && HirUtils.hirKidsCount(mk) >= 1) {
                val inner: Int = HirUtils.hirKidsAt(mk, 0)
                val recvCls: String = this.receiverClassOf(src, inner)
                if (recvCls != "") {
                    return this.fieldAuraTypeName(recvCls, fname)
                }
            }
            return ""
        }
        if (kind != "HirVar") {
            return ""
        }
        val n: String = src.textOf(recvNode)
        if (n == "this") {
            return this.curClass
        }
        return this.localTypeOf(n)
    }

    /// 是否为集合族类型名。
    private fun isCollectionTypeName(ty: String): Boolean {
        if (ty == "") {
            return false
        }
        return ty.startsWith("List") || ty.startsWith("ArrayList")
            || ty.startsWith("LinkedList") || ty.startsWith("Deque")
            || ty.startsWith("Map") || ty.startsWith("HashMap")
            || ty.startsWith("LinkedHashMap") || ty.startsWith("TreeMap")
            || ty.startsWith("Set") || ty.startsWith("HashSet")
            || ty.startsWith("LinkedHashSet") || ty.startsWith("TreeSet")
    }

    /// 集合成员 → 运行库符号（接收者不是集合族 / 成员无映射时返回 ""）。
    ///
    /// 符号名与 `PhotonRuntime` 注册的名字**必须一致**
    ///（`Collections.count` / `clear` / `getAt` / `contains` / `indexOf`）。
    private fun collectionRuntimeSymbol(recvTy: String, bare: String): String {
        if (bare == "" || !this.isCollectionTypeName(recvTy)) {
            return ""
        }
        if (bare == "size" || bare == "getSize" || bare == "count" || bare == "length") {
            return "Collections.count"
        }
        if (bare == "clear") {
            return "Collections.clear"
        }
        if (bare == "get" || bare == "getAt") {
            return "Collections.getAt"
        }
        if (bare == "contains") {
            return "Collections.contains"
        }
        if (bare == "indexOf") {
            return "Collections.indexOf"
        }
        return ""
    }

    /// 扫描一个**类型声明**体，登记其方法的**返回类型**（仅元数据）。
    ///
    /// 供未标注类型局部量的定型使用（见 `methodRetTypes`）。
    ///
    /// ⚠️ 刻意**不**登记属主类名：`object` 的方法在自举链路里发射成**裸符号**
    ///（实测 `Main.hat` 有 `@fn emptyOptimizer`、没有 `@fn PeepholeOptimizerUtils_*`），
    /// 把 object 当类登记会连带改掉**定义端**的符号名（调用端/定义端两张表
    /// 必须成对改，属高风险）。只有 `HirClass` / `HirStruct` 需要属主前缀，
    /// 由 `registerClass` 负责。
    private fun scanDeclMethodReturnTypes(src: Hir, declNode: Int) {
        val kids: String = src.kidsOf(declNode)
        val kn: Int = HirUtils.hirKidsCount(kids)
        var j: Int = 0
        while (j < kn) {
            val child: Int = HirUtils.hirKidsAt(kids, j)
            val ck: String = src.kindOf(child)
            if (ck == "HirFunction") {
                this.addMethodReturnType(src.textOf(child), src.tyOf(child))
            } else if (ck == "HirBlock") {
                this.scanBlockMethodReturnTypes(src, child)
            }
            j = j + 1
        }
    }

    /// 下钻块登记 `HirFunction` 的返回类型（含嵌套块）。
    private fun scanBlockMethodReturnTypes(src: Hir, blockNode: Int) {
        val kids: String = src.kidsOf(blockNode)
        val kn: Int = HirUtils.hirKidsCount(kids)
        var j: Int = 0
        while (j < kn) {
            val child: Int = HirUtils.hirKidsAt(kids, j)
            val ck: String = src.kindOf(child)
            if (ck == "HirFunction") {
                this.addMethodReturnType(src.textOf(child), src.tyOf(child))
            } else if (ck == "HirBlock") {
                this.scanBlockMethodReturnTypes(src, child)
            }
            j = j + 1
        }
    }

    /// 裸名是否属于 runtime 提供的符号（这些名字**不能**加类前缀）。
    ///
    /// 与 `InstructionSelection.isRuntimeSymbol` / `mapStdlibFuncName` 的目标集合
    /// 保持一致：运行时函数是全局唯一的，类方法重名时以 runtime 为准。
    private fun isRuntimeBareName(name: String): Boolean {
        if (name == "println" || name == "print" || name == "puts") { return true }
        if (name == "toStr" || name == "strcat" || name == "toInt") { return true }
        if (name == "toFloat" || name == "toString" || name == "charCodeAt") { return true }
        if (name == "strlen" || name == "streq" || name == "strcmp") { return true }
        if (name == "exit" || name == "exitGroup") { return true }
        if (name == "arrayListOf" || name == "transform" || name == "fromCharCode") { return true }
        if (name == "ReadCStr" || name == "aura_mem_used_mb" || name == "__throw") { return true }
        if (name.startsWith("__")) { return true }
        if (name.startsWith("Memory_")) { return true }
        if (name.startsWith("Collections.")) { return true }
        if (name.startsWith("io_")) { return true }
        if (name.startsWith("String")) { return true }
        if (name == "get" || name == "set" || name == "size" || name == "count") { return true }
        return false
    }

    /// 调用点的被调名解析：裸名 → `Class_method`（无法判定时原样返回）。
    private fun resolveMethodSymbol(src: Hir, kids: String, kCount: Int, bare: String): String {
        if (bare == "") {
            return bare
        }

        // 0) **集合族接收者 → 运行库符号**（先于其它一切判定，且不依赖 `classMethods`）
        //
        // `Hir.aura` 层也维护了同一张表，但它在 AST 上**拿不到标识符的类型**
        //（`ast.tyOf(ident)` 为空），所以 `tags.size` / `x.clear()` 这类调用
        // 屡次漏映射、退化成裸名。这里在 SSA 侧做：`localTypes` 里有
        // `tags: List<Int>`、字段表里有 `HashMap<..>` 这类**真实声明类型**。
        //
        // 自举 `Main.aura` 实测剩最后的 `size` / `getSize` / `clear`
        // （HAT: `@call @size(@tags, @memtoken)`），运行库侧
        // `Collections.count` / `Collections.clear` 已就位。
        if (kCount >= 1) {
            val recvTy: String = this.receiverTypeNameOf(src, HirUtils.hirKidsAt(kids, 0))
            val rtSym: String = this.collectionRuntimeSymbol(recvTy, bare)
            if (rtSym != "") {
                return rtSym
            }
        }

        if (this.classMethods == "") {
            return bare
        }
        // 1) 接收者静态类型已知 → 沿继承链找声明类
        if (kCount >= 1) {
            val recvCls: String = this.receiverClassOf(src, HirUtils.hirKidsAt(kids, 0))
            if (recvCls != "") {
                val owner: String = this.methodOwnerClass(recvCls, bare)
                if (owner != "") {
                    return owner + "_" + bare
                }
            }
        }
        // 2) **隐式 `this`**：无接收者可判时（`hexDigit(hi)` 这种类内裸调用），
        //    当前方法所属类若声明了该方法就用它 —— 私有 helper 的常规形态。
        //
        // ⚠️ 必须排在「唯一属主」之前：`hexDigit` 被 `X86Encoder` 与
        //    `PhotonObjectWriter` **同时**声明，唯一属主判定会得到「歧义」→
        //    回落到裸名 → lld-link `undefined symbol: hexDigit`。
        if (this.curClass != "" && !this.isFreeFunc(bare)
            && this.classDeclaresMethod(this.curClass, bare)) {
            return this.curClass + "_" + bare
        }
        // 3) 全局唯一属主（且与 runtime 符号、顶层自由函数都不冲突）
        if (!this.isRuntimeBareName(bare) && !this.isFreeFunc(bare)) {
            val only: String = this.uniqueMethodOwner(bare)
            if (only != "") {
                return only + "_" + bare
            }
        }
        // 3) 保底：维持裸名（runtime 函数 / object 方法 / 无法判定）
        return bare
    }

    /// 零值常量（按声明类型选整型/浮点/指针）。
    private fun zeroConstOf(ty: String): Int {
        if (ty != "") {
            val typeId: Int = this.types.fromTypeName(ty)
            if (this.types.isInt(typeId)) {
                return this.program.addValue("Const", typeId, "", "0", this.curBlock)
            }
            if (this.types.isFloat(typeId)) {
                return this.program.addValue("Const", typeId, "", "0.0", this.curBlock)
            }
        }
        return this.program.addValue("Const", this.types.intType(64), "", "0", this.curBlock)
    }

    /// 字段读取：`__field_get(obj, index)`。
    private fun emitFieldGet(objVal: Int, ty: String, fieldIndex: Int): Int {
        val idxVal: Int = this.program.addValue("Const", this.types.intType(64), "",
                                                toStr(fieldIndex), this.curBlock)
        val args: String = toStr(objVal) + "," + toStr(idxVal)
        var useTy: String = ty
        if (useTy == "") {
            useTy = "Long"
        }
        val typeId: Int = this.types.fromTypeName(useTy)
        val v: Int = this.program.addValue("Call", typeId, args, "__field_get", this.curBlock)
        // ⚠️ 读取**不推进内存链**：字段读不改内存，额外的 MemToken 只是让 DAG
        //    多一个节点。自举 Main.aura 的字段读有几万处，每个 MemToken 都会让
        //    Phase D（寄存器分配）的 O(N²) 扫描多一格 —— 实测这一项就是 8 GiB
        //    内存闸门被打穿的临界差额。写操作（emitFieldSet）仍推进内存链。
        return v
    }

    /// 字段写入：`__field_set(obj, index, val)`。
    private fun emitFieldSet(objVal: Int, fieldIndex: Int, valVal: Int): Int {
        val idxVal: Int = this.program.addValue("Const", this.types.intType(64), "",
                                                toStr(fieldIndex), this.curBlock)
        val args: String = toStr(objVal) + "," + toStr(idxVal) + "," + toStr(valVal)
        val v: Int = this.program.addValue("Call", this.types.fromTypeName("Long"),
                                           args, "__field_set", this.curBlock)
        if (this.memHead >= 0) {
            val memTypeId: Int = this.types.intType(64)
            this.memHead = this.program.addValue("MemToken", memTypeId, toStr(v),
                                                 "mem_after_set", this.curBlock)
        }
        return v
    }

    /// 为每个类合成构造器 `<Class>__new`（0 形参，返回对象指针）。
    ///
    /// 形参表刻意留空：调用点会把构造实参 + 内存链 token 一起压进
    /// rcx/rdx/r8/r9，被调方不读它们 —— 多传的实参无害；0 形参让
    /// `applyCallingConvention`（按**实参个数**装寄存器）与 callee 侧完全解耦，
    /// 不必先知道每个类的 `init` 重载元数。
    private fun synthesizeCtors(src: Hir) {
        val savedMem: Int = this.memHead
        val savedBlock: Int = this.curBlock
        val savedClass: String = this.curClass
        val savedVarMap: String = this.varMap
        val savedParams: String = this.curParams
        val savedLocalTypes: String = this.localTypes

        val lty: Int = this.types.fromTypeName("Long")
        var ci: Int = 0
        while (ci < this.classList.size) {
            val cname: String = this.classList[ci]
            val fid: Int = this.program.addFunction(cname + "__new", 0, lty, false)
            val entry: Int = this.program.addBlock()
            this.curBlock = entry
            this.curClass = cname
            this.memHead = -1
            this.varMap = ""
            this.curParams = ""
            this.localTypes = ""

            val sizeVal: Int = this.program.addValue("Const", this.types.intType(64), "",
                                                     toStr(this.classSizeOf(cname)), this.curBlock)
            val objVal: Int = this.program.addValue("Call", lty, toStr(sizeVal),
                                                    "Memory_alloc", this.curBlock)

            val total: Int = this.classFieldTotal(cname)
            var fi: Int = 0
            while (fi < total) {
                val fty: String = this.fieldTypeOfIndex(cname, fi)
                val defNode: Int = this.fieldDefaultOfIndex(cname, fi)
                var dv: Int = -1
                if (defNode >= 0) {
                    dv = this.buildExpr(src, defNode)
                } else {
                    dv = this.zeroConstOf(fty)
                }
                this.emitFieldSet(objVal, fi, dv)
                fi = fi + 1
            }

            this.program.setTerminator(this.curBlock, "Ret", 0, toStr(objVal), "")
            this.program.functionOf(fid).entryBlock = entry
            this.program.functionOf(fid).params = ""
            this.program.endFunction()
            ci = ci + 1
        }

        this.memHead = savedMem
        this.curBlock = savedBlock
        this.curClass = savedClass
        this.varMap = savedVarMap
        this.curParams = savedParams
        this.localTypes = savedLocalTypes
    }

    // ── 循环栈 ──

    /// 将块 ID 推入循环退出栈。
    private fun loopStackPush(blockId: Int) {
        if (this.loopStack == "") {
            this.loopStack = toStr(blockId)
        } else {
            this.loopStack = toStr(blockId) + "," + this.loopStack
        }
    }

    /// 从循环退出栈弹出块 ID。
    private fun loopStackPop() {
        if (this.loopStack == "") {
            return
        }
        val commaIdx: Int = this.loopStack.indexOf(",")
        if (commaIdx < 0) {
            this.loopStack = ""
        } else {
            this.loopStack = this.loopStack.substring(commaIdx + 1)
        }
    }

    // ── Phase A S2: 支配分析（Dominator Tree）──

    /// 计算支配树（Phase A S2）。
    ///
    /// 使用迭代算法计算每个基本块的立即支配者（idom）。
    /// 算法：从 entry 开始，迭代更新每个块的最早已定义支配者。
    ///
    /// 返回扁平字符串 "blockId|idomBlockId\n" 格式的支配树。
    fun computeDominatorTree(): String {
        val funcCount: Int = this.program.functionCount
        var result: String = ""

        var fi: Int = 0
        while (fi < funcCount) {
            val func: MirFunction = this.program.functionOf(fi)
            val entryBlock: Int = func.entryBlock
            val blocks: List<String> = this.splitStr(func.blocks, ",")

            // 初始化：每个块的 idom = -1（未知），entry 的 idom = entry 自身
            val idom: List<String> = arrayListOf<String>()
            var bi: Int = 0
            while (bi < blocks.size) {
                val bid: Int = this.strToInt(blocks[bi])
                if (bid == entryBlock) {
                    idom.add(toStr(entryBlock))
                } else {
                    idom.add(toStr(-1))
                }
                bi = bi + 1
            }

            // 迭代直到收敛
            var changed: Boolean = true
            var iterations: Int = 0
            while (changed && iterations < 100) {
                changed = false
                iterations = iterations + 1
                bi = 0
                while (bi < blocks.size) {
                    val bid: Int = this.strToInt(blocks[bi])
                    if (bid == entryBlock) { bi = bi + 1; continue }

                    val block: MirBlock = this.program.blockOf(bid)
                    val preds: List<String> = this.splitStr(block.preds, ",")

                    // 找到第一个已定义 idom 的前驱块
                    var newIdom: Int = -1
                    var pi: Int = 0
                    while (pi < preds.size) {
                        val predId: Int = this.strToInt(preds[pi])
                        if (predId >= 0) {
                            // 找到 predId 在 idom 列表中的位置
                            var ri: Int = 0
                            while (ri < blocks.size) {
                                if (this.strToInt(blocks[ri]) == predId) {
                                    if (this.strToInt(idom[ri]) >= 0) {
                                        newIdom = this.strToInt(idom[ri])
                                        break
                                    }
                                    break
                                }
                                ri = ri + 1
                            }
                            if (newIdom >= 0) { break }
                        }
                        pi = pi + 1
                    }

                    // 处理多个前驱的情况：取交集（简化为最早定义者）
                    if (newIdom >= 0) {
                        val curIdom: Int = this.strToInt(idom[bi])
                        if (curIdom != newIdom) {
                            idom[bi] = toStr(newIdom)
                            changed = true
                        }
                    }
                    bi = bi + 1
                }
            }

            // 输出支配树
            bi = 0
            while (bi < blocks.size) {
                val bid: Int = this.strToInt(blocks[bi])
                val idomVal: String = idom[bi]
                result = result + toStr(bid) + "|" + idomVal + "\n"
                bi = bi + 1
            }
            fi = fi + 1
        }
        return result
    }

    /// 获取支配树的扁平字符串（块ID → 立即支配者块ID）。
    fun getDominatorTree(): String {
        return this.computeDominatorTree()
    }

    // ── 工具方法 ──

    /// 字符串转整数。
    private fun strToInt(text: String): Int {
        return SsaMirUtils.strToInt(text)
    }

    /// 整数转字符串。
    private fun toStr(n: Int): String {
        return SsaMirUtils.toStr(n)
    }

    /// 按单字符分隔符分割字符串（VM 不支持 String.split）。
    private fun splitStr(text: String, sep: String): List<String> {
        // 见 MirUtils.mirSplit 的说明：`arrayListOf + add` 在本 VM 下会丢元素。
        if (text == "" || sep == "") { return emptyList() }
        return text.split(sep)
    }
}

// ─────────────────────────────────────────────────────────────
// SsaBuilder 工具对象
// ─────────────────────────────────────────────────────────────

object SsaBuilderUtils {

    /// 执行 HIR → SSA 降级。
    fun build(hir: Hir): MirSsaProgram {
        val builder: SsaBuilder = SsaBuilder()
        return builder.build(hir)
    }

    /// Phase A S2: 执行 HIR → SSA → TAC 降级（连接 Linearizer 到生产路径）。
    ///
    /// 完整 SSA 路径：
    ///   1. SsaBuilder.build(hir) — HIR → SSA MIR
    ///   2. Linearizer.linearize(ssa) — SSA MIR → TAC MIR
    ///
    /// 返回 TAC MIR，可直接传递给现有 Codegen.aura。
    /// 当 Linearizer 不可用时，回退到 MirLower（TAC 直出）。
    fun buildToTAC(hir: Hir): Mir {
        // Step 1: HIR → SSA MIR
        val builder: SsaBuilder = SsaBuilder()
        val ssa: MirSsaProgram = builder.build(hir)

        // Step 2: SSA → TAC MIR（通过 Linearizer）
        val lin: Linearizer = Linearizer()
        return lin.linearize(ssa)
    }
}
