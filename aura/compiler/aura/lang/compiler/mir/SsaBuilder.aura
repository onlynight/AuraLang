// aura:///aura/lang/compiler/mir/SsaBuilder.aura
package aura.lang.compiler.mir
// ─────────────────────────────────────────────────────────────
// HIR → SSA MIR 构建器 — Phase A (任务 A.3)
//
// 将 HIR 树状结构降级为 SSA MIR（CFG + SSA + memory chain）。
// 核心算法：
//   1. 遍历 HIR 构建基本块和控制流
//   2. 表达式平坦化（HIR → 指令序列）
//   3. Phi 插入（Cytron 算法）
//   4. Memory chain 插入（显式内存依赖）
//
// ── 与现有 MirLower.aura 的关系 ──
//
//   * MirLower.aura: HIR → TAC MIR（VM 路径使用）
//   * SsaBuilder.aura: HIR → SSA MIR（AOT/JIT 路径使用）
//   * 两者独立，各自消费 HIR 产出不同的 IR
//
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String
import aura.lang.std.Env
import aura.lang.compiler.hir.Hir
import aura.lang.compiler.lexer.Span
import aura.lang.compiler.mir.SsaMir
import aura.lang.compiler.mir.TypeRegistry
import aura.lang.compiler.mir.Mir
import aura.lang.compiler.mir.Linearizer
import aura.lang.compiler.aot.AotUtil

/// HIR → SSA MIR 构建器。
class SsaBuilder {

    /// 输出的 SSA MIR 程序。
    private var program: MirSsaProgram = MirSsaProgram()

    /// 类型注册表（快捷引用）。
    private var types: TypeRegistry = TypeRegistry()

    /// 当前函数索引。
    private var curFunc: Int = -1

    /// 当前块索引。
    private var curBlock: Int = 0

    /// 临时值计数器（用于调试命名）。
    private var tmpCount: Int = 0

    /// 临时性能探针：已构建函数数（用于定位 Phase A 的规模行为）。
    private var dbgFuncCount: Int = 0

    /// 临时性能探针：varMap/varVersion 查询次数与累计扫描字符数。
    private var dbgLookups: Int = 0
    private var dbgScanned: Int = 0

    /// 临时性能探针：各类操作调用次数。
    private var dbgStmts: Int = 0
    private var dbgExprs: Int = 0
    private var dbgBlocks: Int = 0
    private var dbgCalls: Int = 0

    /// 最近一次 resolveMethodSymbol 是否走了「隐式 this」规则（规则 2）。
    /// buildCall 据此把 this 值前置到实参首位：被调的类实例方法形参表首项
    /// 是 this，隐式调用（readFileToBuffer(path)）的 HIR kids 只有实参、
    /// 无接收者 kid，不前置则被调方整体错位一位（this=首实参、首实参=
    /// memtoken；实测 Photon 版 VM runner：readFileToBuffer(path) 的 path
    /// 在被调方读成 memtoken/垃圾，stringToBuffer 对 NULL 写循环崩。
    /// 种子 AOT 的 emit.rs 有对应处理，photon 后端漏了，2026-10-04）。
    /// 单例方法（无 this 形参）不前置。
    private var lastResolveImplicitThis: Boolean = false

    private var dbgHasType: Int = 0

    /// 内存链当前值（memory chain head）。
    private var memHead: Int = -1

    /// 当前函数的参数值列表（ValueID 逗号分隔）。
    private var curParams: String = ""

    /// 局部变量名 → ValueID 映射（扁平字符串：name|vid\nname|vid\n…）。
    ///
    /// 采用与 MirLower.aura 一致的扁平字符串格式（\name|vid\n` 拼接），
    /// 避免 `HashMap<String, Int>` 在 VM 内类调用时未链接的问题。
    private var varMap: String = ""

    /// 循环退出块栈（逗号分隔 BlockID，用于 break/continue 的退出目标查找）。
    private var loopStack: String = ""

    /// continue 目标栈（condBlock），与 loopStack 平行维护。
    private var loopContStack: String = ""

    /// 每层循环的 Phi 变量条目（phiVarEntries 快照），与 loopContStack 平行。
    private var loopPhiVarsStack: String = ""

    /// continue 点值登记，行格式 condId|phiVid|curVid。buildWhile 回填时把
    /// 同 condId 的记录追加为对应 Phi 的**额外入边**（pass② 精确匹配按
    /// def 块分配；continue 值通常定义于更早块，落到 (b) 兜底——单 continue
    /// 点场景正确，多 continue 点退化为共享一个值，见文档）。
    private var loopContRecs: String = ""

    /// Phase A S2: 变量版本号映射（扁平字符串：name|version\n）。
    ///
    /// 用于 SSA 变量重命名：每次赋值递增版本号，确保每个版本是独立的 SSA 值。
    private var varVersion: String = ""

    // ── 类/结构体元数据（Photon 对象模型 A-1/A-3）──
    //
    // HIR 的 `HirClass`/`HirStruct` 形状：
    //     HirClass(name, ty = 基类名, kids = [HirBlock(kids = [HirVarDecl/…, HirFunction/…])])
    // 类体块里的 `HirVarDecl`/`HirValDecl` 是**字段**，`HirFunction` 是方法。
    // 这里在建 SSA 之前做一次预扫描，得到三张表：
    //   · classNames / classParents —— 类名与继承关系
    //   · classFields —— `Class|field|index|auraTy|defaultNodeId`（index 为**最终布局序号**）
    //   · funcOwner —— `funcNodeId|classNodeId`（方法 → 属主类）
    // 字段字节偏移 = 16 + index * 8（对象头 [vtable:8][size:8]，见 PhotonRuntime）。

    // ⚠️ 下面这些表**一律用扁平字符串 + indexOf/charCodeAt 扫描**，禁止
    //    per-lookup 的 `split()`：自举 `Main.aura` 有 15 万 HIR 节点 / 2843 个
    //    函数 / 2 万个调用点，任何「每次查询都整表 split」的实现都会退化为
    //    O(N²) 分配（实测本文件初版直接触发框架内存闸门 abort）。
    //    `indexOf` 走 C 侧 strstr，扫描是 C 速度且零分配。

    /// 类名表（`\nName\n`）：`isClassName`。
    private var classNamesCsv: String = ""

    /// 类名（按 arena 顺序，供构造器合成等**冷路径**遍历用）。
    private var classList: List<String> = arrayListOf<String>()

    /// 继承关系（`\nChild|Parent\n`）。
    private var classParents: String = ""

    /// 字段表（`\nClass|field|index|auraTy|defaultNodeId\n`）。
    private var classFields: String = ""

    // ── 类字段布局缓存（`buildClassIndex` 收尾一次性填充）──
    //
    // ⚠️ `classFields` 只在此阶段被写入，`buildClassIndex` 返回后**只读** ——
    // 因此可以在登记阶段结束后一次性把每张字段记录解析成下标表，运行期查表 O(1)。
    // 此前的 `fieldTailOfIndex` 对整张 CSV 逐字符线性扫描、且每个字段被
    // `fieldTypeOfIndex` 与 `fieldDefaultOfIndex` **各扫一遍**；构造器/单例合成
    // 阶段合计约 8000 次全量扫描（每次数千字符比较），是 SSA 阶段的可归因热点。
    //
    // ⚠️ 不能用 `mutableListOf<Int>`：本仓库已记录 `List<Int>` + 索引/`add` 组合
    // 在 AOT 运行时下的崩溃坑（见 `scanInitArities` 注释、`Emit.aura:9502`）。
    // 因此整型表沿用本文件惯例 —— **定宽 8 字符**的 `|` 分隔字符串
    // （`|` 兼作填充与分隔，槽宽恒为 9），下标 `k` 的值起于偏移 `1 + k * 9`。
    // 类型行槽宽可变（类型名长度不定），用 `flatPart` 按需切到第 `idx` 段。
    //
    // 下标 = 类序（`names` 列表下标），只覆盖**有字段**的类；类名 → 类序走
    // `nameToIdx`（`names` 规模小，线性扫描可接受）。
    private var names: List<String> = arrayListOf<String>()
    private var clsLayoutTys: List<String> = arrayListOf<String>()
    private var clsLayoutDefaults: List<String> = arrayListOf<String>()
    private var clsLayoutTotal: List<String> = arrayListOf<String>()
    private var clsLayoutSize: List<String> = arrayListOf<String>()
    private var clsOwnCount: List<String> = arrayListOf<String>()

    /// 方法节点 → 属主类名（下标 = HIR 节点 id）。
    ///
    /// ⚠️ 刻意**不用**扁平字符串：`funcOwners` 要登记 ~2800 个方法，逐条拼接
    /// 会累积 ~120 MB 不可回收的中间串（自举 `Main.aura` 直接把框架内存闸门
    /// 打爆）。下标数组是 O(N) 建立、O(1) 查询、且只占 ~1 MB。
    private var ownerByNode: List<String> = arrayListOf<String>()

    /// 类方法表（`\nClass|method\n`）：判定「某类是否声明某方法」。
    private var classMethods: String = ""

    /// 方法 → 唯一属主类（`\nmethod|Class\n`；重名时该行改写为 `\nmethod|\n`）。
    private var methodOwners: String = ""

    /// 方法 → **返回类型**（`\nmethod|retTy\n`；同名方法返回类型不一致置为歧义）。
    ///
    /// 用途：推断**未标注类型**的局部量的静态类型。
    /// `Hir.aura` 的 `lowerCall` 把 HirCall 的 type 一律写空串，所以
    /// `val peephole = PeepholeOptimizerUtils.emptyOptimizer()` 这种（本仓库的
    /// **主要写法**）在 HIR 里拿不到类型 → `localTypeOf("peephole")` 为空 →
    /// 接收者定型失败 → 调用点回落成裸名。
    /// 自举 `Main.aura` 实测因此有 11 个裸方法名未定义（`optimize` / `lower` /
    /// `emitFunction` / `link` / `setOutputType` / `getSize` / `emit` …）。
    private var methodRetTypes: String = ""

    /// 类限定「方法 → 返回类型」（`\nClass|method|retTy\n`）。
    ///
    /// 与 `methodRetTypes` 的区别：不做歧义合并 —— `init` / `isLocked` /
    /// `getUsedSize` 这类方法在多个类里都有，全局表只能置为「歧义」，
    /// 但调用点的接收者类型是确定的 ⇒ 由本表判定真实返回类型。
    /// 用途：布尔真值化（`toStr(ArenaAllocator.init(...))`）等「按返回类型分派」的改写。
    private var classMethodRetTypes: String = ""

    /// 顶层自由函数名（`\nname\n`）。
    ///
    /// 调用点解析必须避开它们：`add(3, 4)` 这样的自由函数调用与
    /// `p.add(3, 4)` 在 HIR 里都是 `HirCall(text="add")`，若只按「唯一属主」
    /// 回退，会把 `add(3,4)` 误接到 `ArrayList_add`（实测 05_functions 崩溃）。
    private var freeFuncs: String = ""

    /// 当前函数所属类（空 = 自由函数）。
    private var curClass: String = ""

    /// 当前函数内「局部变量名 → 声明类型名」（每行 \name|TypeName`，倒序优先）。
    private var localTypes: String = ""

    /// `object`（`HirObject`）/ `extern interface`（`HirExternObject`）声明名表
    /// （`\nName\n`）。
    ///
    /// ⚠️ 只有**单例模块**声明进表；`HirClass`/`HirStruct` 不进表。两者的方法
    /// **都不接收**接收者实参（见 `buildFunction` / `buildCall`），但承载字段
    /// 状态的那一批，`this` 要解析到 `synthesizeSingletons` 惰性分配的实例上。
    private var singletonCsv: String = ""

    /// 对象声明名 → 是否带**字段状态**（`\nName|1\n`）。
    ///
    /// `ArenaAllocator` / `MemoryManager` / `GC` 这类 `object` 既被当成模块用
    ///（`GC.isEnabled()`）又被实例化（`ArenaAllocator()`）；`Mutex` / `Thread` /
    /// `Cpu` 只有静态方法、无字段。只有带字段的那批需要「惰性单例实例」来承载
    /// 字段（`__field_get`/`__field_set` 需要一个真实对象指针）。
    private var objFieldStateCsv: String = ""

    /// 单例模块名（按 arena 顺序，供 `synthesizeSingletons` 冷路径遍历）。
    private var singletonList: List<String> = arrayListOf<String>()

    /// `extern interface`（`HirExternObject`）声明名表（`\nName\n`）。
    ///
    /// 成员由编译器/运行库实现（`Memory_alloc` 在 `aura_runtime.obj`），
    /// **只被调用、从不生成函数体** —— `buildAllFunctions` 对它们的
    /// 属主直接跳过，否则链接期 `duplicate symbol: Memory_alloc`。
    private var externCsv: String = ""

    /// `extern interface` **声明的方法**（`\nOwner|method\n`）。
    ///
    /// `buildAllFunctions` 只跳过**这些**，而不是「属主名出现在 externCsv 里」的
    /// 所有函数：同一模块里可能既有 `extern interface Runtime`（4 个 asm 成员）
    /// 又有 `object Runtime`（`init` / `isInitialized` / `cleanup` … 的真实 Aura 实现，
    /// 见 `aura/lang/native/Runtime.aura`）。按名字整体跳过会把后者的实现也丢掉
    /// ⇒ 调用点 `Runtime_init` 未定义（实测 P4/test_runtime_init 链接失败）。
    private var externMethodsCsv: String = ""

    /// `init` 节点声明的元数表（`\nClass|arity\n`）。
    ///
    /// 由 `scanInitArities` 在建函数之前一次性填充；`synthesizeCtors` 用它决定
    /// 要给每个类生成哪些 `<Class>__new<N>`，`buildFunction` 用它判断
    /// `<Class>_init` 要不要按元数加后缀。
    ///
    /// 只能是字符串 CSV，不能是 `List[Int]`：`mutableListOf` 泛型路径在 AOT
    /// 自举下会崩（见 `scanInitArities` 的注释）。

    private var initArityCsv: String = ""

    init() {
        this.program = MirSsaProgram()
        this.types = this.program.types
        this.curFunc = -1
        this.curBlock = 0
        this.tmpCount = 0
        this.memHead = -1
        this.curParams = ""
        this.varMap = ""
        this.varVersion = ""
        this.loopStack = ""
        this.loopContStack = ""
        this.loopPhiVarsStack = ""
        this.loopContRecs = ""
        this.classNamesCsv = ""
        this.classList = arrayListOf<String>()
        this.classParents = ""
        this.classFields = ""
        this.clsLayoutTys = arrayListOf<String>()
        this.clsLayoutDefaults = arrayListOf<String>()
        this.clsLayoutTotal = arrayListOf<String>()
        this.clsLayoutSize = arrayListOf<String>()
        this.clsOwnCount = arrayListOf<String>()
        this.classMethods = ""
        this.methodOwners = ""
        this.methodRetTypes = ""
        this.classMethodRetTypes = ""
        this.freeFuncs = ""
        this.ownerByNode = arrayListOf<String>()
        this.curClass = ""
        this.localTypes = ""
        this.singletonCsv = ""
        this.externCsv = ""
        this.externMethodsCsv = ""
        this.objFieldStateCsv = ""
        this.singletonList = arrayListOf<String>()
        this.initArityCsv = ""
    }

    // ── 主入口 ──

    /// 执行 HIR → SSA 降级，返回 SSA MIR 程序。
    ///
    /// 函数收集走**单次线性 arena 扫描**（见 [`buildAllFunctions`]），
    /// 不再从 `HirProgram` 根递归下钻容器节点。
    fun build(src: Hir): MirSsaProgram {
        this.program = MirSsaProgram()
        this.types = this.program.types
        this.tmpCount = 0

        // 类元数据必须在建函数之前就绪：方法与调用点都要用它解析字段/构造器。
        this.buildClassIndex(src)
        // 溶解对象的 getter 缺口由 `ensureSingletonGetter` 在 buildCall 发射点
        // 自愈（HirLowerer 对部分 `object X` 采用「方法限定名 + 体提升」的输出
        // 形态，对象声明节点不进降级 HIR，buildClassIndex 捕不到；方法体里被
        // 注入的 `X_getInstance()` 调用若没有 getter，链接期即 undefined
        // symbol——实测 VM runner 的 MirUtils：10 处调用 0 定义，2026-10-06）。
        // `init` 重载元数（决定 `<Class>_init<N>` 后缀与要生成哪些 `__new<N>`）。
        this.scanInitArities(src)
        // 构造器 `<Class>__new<N>`：每个类每个元数一份，必须早于用户函数。
        this.synthesizeCtors(src)
        // 单例字段实例访问器（<Name>_getInstance）必须在用户函数之前建好：
        // buildFunction 会把单例方法里的 this 解析成对它的一次调用。
        this.synthesizeSingletons(src)

        this.buildAllFunctions(src)
        // 溶解对象 getter 收尾（MirUtils 缺口，2026-10-06）：HirLowerer 对部分
        // `object X` 采用「方法限定名 + 体提升」形态输出，对象声明节点不进降级
        // HIR，buildClassIndex 捕不到 ⇒ 方法体里被注入的 `X_getInstance()` 调用
        // 没有对应 getter ⇒ 链接期 `undefined symbol`（实测 VM runner 的
        // MirUtils：方法体 10 处调用 0 定义）。此处扫**建好的 SSA 函数名表**：
        // 「大写前缀_」且前缀未登记为类/单例/extern ⇒ 补登记 + 补合成 getter。
        // 在全部函数建完后跑 ⇒ 对 csv 的增补不再影响任何调用点解析，纯增益。
        this.synthesizeDissolvedGetters(src)

        return this.program
    }

    /// 线性扫描 HIR arena，为每个 `HirFunction` 建 SSA，返回已建函数数。
    ///
    /// **为什么用线性扫描而不是「从根递归下钻 + visited 去重」**
    ///
    /// 1. **正确性**：`object X { fun m() }` / `class C { fun m() }` 的方法被塞在
    ///    `HirObject`/`HirClass` 的 `HirBlock` 子节点里（不是 `HirProgram` 的直接
    ///    子节点）。递归下钻必须逐个容器特判（`HirExternObject` 直接挂函数、
    ///    `HirObject`/`HirClass` 还要再穿一层 `HirBlock`），漏一种就整批丢方法 ——
    ///    实测自举 `Main.aura`：只扫根节点的直接子节点会丢掉 `object MainUtils`
    ///    的全部方法，链接期一片 `undefined symbol`。
    /// 2. **避免指数级内存增长**：HIR 节点可被多处引用，递归下钻会重复展开子树；
    ///    实测自举 `Main.aura` 上内存从 ~300 MB 起翻倍增长（>16 GB 仍不够）。
    /// 3. **去重不可靠**：曾用 `HashSet<Int>` 做 visited 集合，但 `HashSet` 在本
    ///    VM/AOT 两侧都不可用 —— 种子 VM 下 `add` 静默失败（`size` 恒为 0），
    ///    AOT 产物直接访问违例（0xC0000005）。去重因此从未生效。
    ///
    /// HIR 是扁平 arena（`kindOf`/`textOf` 均为 O(1) 下标访问），所以按下标
    /// `0..count-1` 扫一遍即可覆盖**全部**函数（顶层 `fun`、`object`/`class` 方法、
    /// `init` 块），且每个节点恰好访问一次 ⇒ 严格 O(count)，无递归、无去重集合、
    /// 无栈溢出风险。这与 AOT 发射器「按 `hir.count` 全量扫描 `HirFunction`」的
    /// 收集口径一致。
    ///
    /// 调用点无需改造：`HirLowerer.lowerCall` 对 `X.m()` 只取**成员名**作 calleeName
    /// （裸名），`lowerFunction` 也不为对象方法附加接收者参数，所以只要方法被建成
    /// 顶层函数，`call @m` 就能解析到。
    fun buildAllFunctions(src: Hir): Int {
        val traceOn: Boolean = Env.get("AURA_PHOTON_TRACE", "") == "1"
        val n: Int = src.count
        // P40x-f：名为 main 的 HirFunction 若有多个（顶层 splice 以新 main
        // 替换旧 main，arena 中两者并存），只建最后一个（含拼接体）。
        // main 在语料中唯一，此规则对其它同名函数零影响。
        var lastMain: Int = -1
        var pi: Int = 0
        while (pi < n) {
            if (src.kindOf(pi) == "HirFunction" && src.textOf(pi) == "main") {
                lastMain = pi
            }
            pi = pi + 1
        }
        var i: Int = 0
        while (i < n) {
            if (src.kindOf(i) == "HirFunction" && !this.isExternObjMethod(src, i)) {
                if (src.textOf(i) == "main" && i != lastMain) {
                    i = i + 1
                    continue
                }
                this.dbgFuncCount = this.dbgFuncCount + 1
                // 崩溃诊断：AURA_PHOTON_TRACE=1 时逐函数打印，定位精确崩溃点
                if (traceOn) {
                    println("      [ssab] n=" + this.dbgFuncCount + " " + src.textOf(i))
                }
                this.buildFunction(src, i)
                if (traceOn) {
                    println("      [ssae] n=" + this.dbgFuncCount + " values=" + this.program.valueCount +
                            " exprs=" + this.dbgExprs +
                            " tys=" + this.types.count)
                }
            }
            i = i + 1
        }
        return this.dbgFuncCount
    }

    // ── 函数构建 ──

    /// 构建一个函数的 SSA MIR，返回 FunctionID。
    fun buildFunction(src: Hir, id: Int): Int {
        // 进度探针：大规模自举编译（111 模块 / 15 万 HIR 节点）时每 200 个函数
        // 汇报一次，用来定位「SSA 降级卡在第几个函数」。（计数在 build() 循环里）
        // 默认关闭。`buildFunction` 每个函数都会走到这里，而 `Env.get` 每次都
        // 重读 environ 缓冲，所以只在真的到打印点时才读开关。
        if (this.dbgFuncCount % 200 == 0) {
            if (Env.get("AURA_PHOTON_VERBOSE", "") == "1"
                    || Env.get("AURA_PHOTON_TRACE", "") == "1"
                    || Env.get("AURA_SSA_PERFN", "") == "1") {
                println("[ssa-prog] funcs=" + toStr(this.dbgFuncCount) +
                        " values=" + toStr(this.program.valueCount))
            }
        }
        if (Env.get("AURA_SSA_PERFN", "") == "1") {
            println("[ssa-fn] n=" + toStr(this.dbgFuncCount) + " " + src.textOf(id))
        }
        val traceOn: Boolean = Env.get("AURA_PHOTON_TRACE", "") == "1"
        // ── 类方法符号限定：`Class_method` ──
        //
        // Aura 类方法之间没有名字作用域隔离，裸名会让重名方法在 COFF 里互相覆盖
        // （自举 `Main.aura`：2715 个 `@fn` 只有 2214 个唯一名，`init` 重复 85 次、
        // `push` 9 次 …）。这里统一加类前缀；对应调用点在 `buildCall` 里改写。
        val rawName: String = src.textOf(id)
        val ownerCls: String = this.ownerClassNameOf(id)
        var name: String = rawName
        if (ownerCls != "" && rawName != "") {
            name = ownerCls + "_" + rawName
        }
        if (rawName == "init" && this.initOverloaded(ownerCls)) {
            // 构造器重载：`init` 在同类里出现多次（`constructor()` /
            // `constructor(m)`），而 COFF 只保留同名符号的**一份** ⇒ 必须按
            // 元数加后缀（`Exception_init0` / `Exception_init1`），否则三个
            // `Exception_init` 互相覆盖、构造器拿不到正确的字段布局。
            // 调用点见 `buildCall` 的 `super` 分支与构造器调用分支。
            //
            // 只在**真有重载**时加后缀：`ArenaAllocator.init(size)` /
            // `MemoryManager.init(size)` 这类**普通同名方法**只有一个 `init`，
            // 加后缀会让定义落成 `ArenaAllocator_init1` 而调用点仍是
            // `ArenaAllocator_init`（P4 `probe_arena` / `test_memory_alloc`
            // 的 undefined symbol）。
            name = name + toStr(this.hirExplicitParamCount(src, id))
        }

        val retTy: String = src.tyOf(id)

        // 注册返回类型
        val retTypeId: Int = this.types.fromTypeName(retTy)

        // 创建函数
        val fid: Int = this.program.addFunction(name, retTypeId, retTypeId, false)
        this.curFunc = fid
        this.curParams = ""
        this.varMap = ""
        this.varVersion = ""

        // 创建入口块
        val entryBlock: Int = this.program.addBlock()
        if (traceOn) println("    [bf1] curBlock=" + entryBlock)
        this.curBlock = entryBlock
        if (traceOn) println("    [bf2] after curBlock set")

        // 初始化内存链（函数入口的 memory 状态）
        val memTypeId: Int = this.types.intType(64)
        if (traceOn) println("    [bf3] before addValue entry_mem")
        this.memHead = this.program.addValue("Const", memTypeId, "", "entry_mem", entryBlock)
        if (traceOn) println("    [bf4] after addValue entry_mem")

        // ── 类方法：注入隐式 `this` 形参（接收者），且必须排在显式形参之前 ──
        //
        // HIR 的成员调用把接收者作为**第一个实参**传下来（Hat 里形如
        // `@call @method(@recv, @mem)`），而方法自身此前声明 0 个形参 —— 形参表
        // 与调用约定整体错位一位。补上 self 后，方法体里的字段访问才有基址。
            this.curClass = ""
        this.localTypes = ""
        if (ownerCls != "") {
            this.curClass = ownerCls
            if (this.isSingletonObj(ownerCls)) {
                // ── 单例模块方法：**无** `this` 形参 ──
                //
                // `Mutex.lock(m)` / `GC.isEnabled()` 在 HIR 里被降级成带接收者
                // 实参的成员调用（`Hir.aura` 对 Member callee 一律把接收者作
                // kids[0]），但单例本身不是对象：没有可传的接收者值，`buildCall`
                // 已把它丢弃。这里也**不能**再注入 `this` 形参 —— 注入后形参表
                // 整体右移一位，`lock(lock_id)` 的 `lock_id` 会落进「接收者」槽。
                //
                // 带字段状态的单例（`GC`/`ARC`/`MemoryManager`/`Runtime`）：`this`
                // 解析到 `synthesizeSingletons` 生成的 `<Owner>_getInstance()` ——
                // 惰性分配一个真实对象承载字段，后续 `__field_get`/`__field_set`
                // 照常工作。用 **Call** 而非 Param：单例首次访问才有副作用
                //（分配对象），且调用点不传任何实参。
                val getInstanceSym: String = ownerCls + "_getInstance"
                val instVal: Int = this.program.addValue("Call",
                        this.types.fromTypeName("Long"), "", getInstanceSym, entryBlock)
                this.varMapAdd("this", instVal)
            } else {
                val selfVal: Int = this.program.addValue("Param", this.types.fromTypeName("Long"),
                                                         "", "this", entryBlock)
                this.curParams = toStr(selfVal)
                this.varMapAdd("this", selfVal)
                this.program.functionOf(this.curFunc).params = this.curParams
            }
        }

        // 处理参数
        val kids: List<Int> = src.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (traceOn) println("    [bf5] kCount=" + kCount)
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            val childKind: String = src.kindOf(childId)
            if (childKind == "HirParam") {
                val paramName: String = src.textOf(childId)
                val paramTy: String = src.tyOf(childId)
                val paramTypeId: Int = this.types.fromTypeName(paramTy)
                this.localTypeAdd(paramName, paramTy)
                if (traceOn) println("    [bf6] param=" + paramName)

                // 创建参数值（作为入口块的指令）
                val paramVal: Int = this.program.addValue("Param", paramTypeId, "", paramName, entryBlock)

                // 添加到参数列表
                if (this.curParams == "") {
                    this.curParams = toStr(paramVal)
                } else {
                    this.curParams = this.curParams + "," + toStr(paramVal)
                }

                // 添加到变量映射
                this.varMapAdd(paramName, paramVal)

                // 更新函数参数列表
                val f: MirFunction = this.program.functionOf(this.curFunc)
                if (traceOn) println("    [bf7] before f.params=" + this.curParams)
                f.params = this.curParams
                if (traceOn) println("    [bf8] after f.params set")
            }
            i = i + 1
        }

        // 构建函数体
        i = 0
        if (traceOn) println("    [bf9] before buildStmt loop")
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            val childKind: String = src.kindOf(childId)
            if (childKind != "HirParam") {
                if (traceOn) println("    [bf10] buildStmt child=" + childId + " kind=" + childKind)
                this.buildStmt(src, childId)
                if (traceOn) println("    [bf11] after buildStmt child=" + childId)
            }
            i = i + 1
        }
        if (traceOn) println("    [bf12] after buildStmt loop")

        // 如果没有终结指令，添加默认的 Ret
        val b: MirBlock = this.program.blockOf(this.curBlock)
        if (b.term < 0) {
            this.program.setTerminator(this.curBlock, "Ret", retTypeId, "", "")
        }

        // 更新函数的块列表
        val func: MirFunction = this.program.functionOf(this.curFunc)
        func.entryBlock = entryBlock
        this.endCurrentFunction()

        return fid
    }

    /// 结束当前函数的构建。
    fun endCurrentFunction() {
        if (this.curFunc >= 0) {
            this.program.endFunction()
            this.curFunc = -1
        }
    }

    // ── 语句构建 ──

    /// 构建一个语句。
    fun buildStmt(src: Hir, id: Int) {
        this.dbgStmts = this.dbgStmts + 1
        val kind: String = src.kindOf(id)

        if (kind == "HirValDecl" || kind == "HirVarDecl") {
            this.buildVarDecl(src, id)
        } else if (kind == "HirIf") {
            this.buildIf(src, id)
        } else if (kind == "HirIfExpr") {
            // ⚠️ 裸 if 表达式落语句位置（旧缺陷路径：else-if 链经 lowerExpr
            // 产出裸 HirIfExpr，见 Hir.lowerBranch 的说明）。此前无此用例 ⇒
            // 整条分支**静默丢弃**（实测 readConstValue 的 else-if 链坍缩）。
            // 表达式值在此处无消费者，丢弃返回值即可。
            this.buildIfExpr(src, id)
        } else if (kind == "HirWhile") {
            this.buildWhile(src, id)
        } else if (kind == "HirFor") {
            // R55: for-in 循环——降级为 while 循环。
            // HIR 形状：HirFor("", "", sp, [HirVarDecl(name), iterable, HirBlock(body)])。
            this.buildFor(src, id)
        } else if (kind == "HirBlock") {
            this.buildBlock(src, id)
        } else if (kind == "HirBreak") {
            this.buildBreak()
        } else if (kind == "HirContinue") {
            this.buildContinue()
        } else if (kind == "HirReturn") {
            this.buildReturn(src, id)
        } else if (kind == "HirExprStmt") {
            val kids: List<Int> = src.kidsOfList(id)
            if (HirUtils.hirKidsCount(kids) > 0) {
                this.buildExpr(src, HirUtils.hirKidsAt(kids, 0))
            }
        } else if (kind == "HirAssign") {
            this.buildAssign(src, id)
        } else if (kind == "HirCall") {
            this.buildExpr(src, id)
        } else if (kind == "HirExpr") {
            // HirExpr 是 unknown-expression 叶子（Hir.aura:1494 默认分支产出）。
            // 旧实现遗漏此分支，导致 buildStmt 对 HirExpr 静默跳过，
            // 函数体在 HIR→SSA 转换中丢失（实测 fun main() { 1+1 } 生成空体）。
            this.buildExpr(src, id)
        }
    }

    /// 构建变量声明（val/var）。
    fun buildVarDecl(src: Hir, id: Int) {
        val varName: String = src.textOf(id)
        val kids: List<Int> = src.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        val declaredTy: String = src.tyOf(id)
        this.localTypeAdd(varName, declaredTy)

        // 未标注类型（本仓库主要写法：`val p = XxxUtils.emptyYyy()`）：
        // 用初始化调用的**返回类型**推断静态类型，供后面的 `resolveMethodSymbol`
        // 做接收者定型。`Hir.aura` 把 HirCall 的 type 一律写空串，所以这里必须
        // 查 `methodRetTypes`（见其说明）。仅接受**唯一且合法**的类名，
        // 拿不准就不登记 —— 宁可回落裸名也不要错误定型（会生成错误符号/偏移）。
        if (declaredTy == "" && kCount > 0) {
            val initNode: Int = HirUtils.hirKidsAt(kids, 0)
            if (src.kindOf(initNode) == "HirCall") {
                val callee: String = src.textOf(initNode)
                if (this.isClassName(callee)) {
                    // (1) **构造调用**：`val lowering = Lowering()` —— 被调名就是类名
                    //（与 `buildCall` 的 `isClassName(funcName) → funcName + "__new"`
                    // 同源约定）。这是本仓库第二主要写法。
                    this.localTypeAdd(varName, callee)
                } else {
                    // (2) **工厂方法**：`val peephole = PeepholeOptimizerUtils.emptyOptimizer()`
                    // → 用方法返回类型（见 `methodRetTypes` / `scanDeclMethodReturnTypes`）。
                    val retTy: String = this.uniqueMethodReturnType(callee)
                    if (retTy != "" && this.isClassName(retTy)) {
                        this.localTypeAdd(varName, retTy)
                    }
                }
            }
        }

        // 降级初始化表达式
        var initVal: Int = -1
        if (kCount > 0) {
            val initNode: Int = HirUtils.hirKidsAt(kids, 0)
            initVal = this.buildExpr(src, initNode)
            // R52: val temp = fib —— 初始化来自 HirVar 且该变量解析到 Phi
            // (循环变量)时，必须物化一份独立 SSA 值(Mov 快照)。否则
            // temp 别名 fib 的 Phi，后续 `fib2 = temp` 的回边指向 fib 的
            // Phi 本身 ⇒ fib2_next = fib_current(而非 fib_old) ⇒
            // 循环里 `temp = fib; fib = fib + fib2; fib2 = temp`
            // 退化为 `fib = 2*fib`(fib2 恒等于当前 fib)⇒
            // 实测 04-control-flow 的 §4.8 输出 0,1,2,4,8 而非 0,1,1,2,3。
            // 仅对 Phi 做快照：非 Phi(常量/普通值)无需物化。
            if (src.kindOf(initNode) == "HirVar" && initVal >= 0) {
                val iv: MirValue = this.program.valueOf(initVal)
                if (iv.isPhi()) {
                    initVal = this.program.addValue("Mov", iv.type,
                            toStr(initVal), varName, this.curBlock)
                }
            }
        } else {
            // 无初始化：创建零值常量
            val varTy: String = src.tyOf(id)
            val varTypeId: Int = this.types.fromTypeName(varTy)
            if (this.types.isInt(varTypeId)) {
                initVal = this.program.addValue("Const", varTypeId, "", "0", this.curBlock)
            } else if (this.types.isFloat(varTypeId)) {
                initVal = this.program.addValue("Const", varTypeId, "", "0.0", this.curBlock)
            } else {
                initVal = this.program.addValue("Const", varTypeId, "", "null", this.curBlock)
            }
        }

        // 局部量类型兜底：声明标注在 HIR 层丢失（`Hir.aura` 把类型一律写空串）
        // 且初始化**不是调用**（`var s3: String = s1 + " " + s2` 这类表达式形态，
        // 上面的推断分支只认 HirCall）时，用 SSA 值的**实际类型**登记。
        // 缺这一步：`s3.length()` 的接收者定型失败 → `length` 落到「唯一属主」
        // `StringBuilder` → 把字符串指针当 StringBuilder 读字段 ⇒ 0xC0000005
        //（实测 tests/photon/P2/04_string_ops.aura）。
        if (this.localTypeOf(varName) == "" && initVal >= 0) {
            val initTyName: String = this.types.typeNameOf(this.program.valueOf(initVal).type)
            if (initTyName != "") {
                this.localTypeAdd(varName, initTyName)
            }
        }

        // 存储到变量映射
        this.varMapAdd(varName, initVal)
    }

    /// 构建 `if` **表达式**（值位置）。
    ///
    /// 旧实现没有这条分支：`val x = if (c) a else b`（以及 `toStr(if …)` 这类实参位）
    /// 直接落到 `buildExpr` 的默认分支，产出 `null`/`0` 常量 —— 实测
    /// `tests/photon/P0/01_string_eq.aura` 的三个判等全变 `@null`，打印 `0/0/0`
    ///（VM 为 `1/0/1`）。
    ///
    /// 实现：条件 → CondBr(then, else)；两分支各求值并把值留作 Phi 的 incoming
    ///（then 在前、else 在后，与 CondBr 的操作数顺序一致，后端据此配对前驱）；
    /// merge 块取 Phi 作为表达式值。
    fun buildIfExpr(src: Hir, id: Int): Int {
        val kids: List<Int> = src.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (kCount < 2) {
            return -1
        }
        val condVal: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, 0))
        val thenBlock: Int = this.program.addBlock()
        val elseBlock: Int = this.program.addBlock()
        val mergeBlock: Int = this.program.addBlock()
        this.program.setTerminator(this.curBlock, "CondBr", 0,
            toStr(condVal) + "," + toStr(thenBlock) + "," + toStr(elseBlock), "")
        val varMapBefore: String = this.varMap

        // ── then 分支 ──
        this.curBlock = thenBlock
        var thenVal: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, 1))
        if (thenVal < 0) {
            thenVal = this.zeroValueOf(src.tyOf(id))
        }
        if (this.program.blockOf(this.curBlock).term < 0) {
            this.program.setTerminator(this.curBlock, "Br", 0, toStr(mergeBlock), "")
        }
        val varMapAfterThen: String = this.varMap

        // ── else 分支 ──
        this.curBlock = elseBlock
        var elseVal: Int = -1
        if (kCount > 2) {
            elseVal = this.buildExpr(src, HirUtils.hirKidsAt(kids, 2))
        }
        if (elseVal < 0) {
            // 无 else（或分支无值）：补零值，保持与 `buildVarDecl` 的零值约定一致
            elseVal = this.zeroValueOf(src.tyOf(id))
        }
        if (this.program.blockOf(this.curBlock).term < 0) {
            this.program.setTerminator(this.curBlock, "Br", 0, toStr(mergeBlock), "")
        }
        val varMapAfterElse: String = this.varMap

        // 说明：这里**不**调用语句形式的 `insertPhisAtMerge` —— 值位置语义下，
        // 分支内声明的变量不该泄漏到表达式之外；本表达式的值由下面的 Phi 给出。
        //（`varMapBefore/AfterThen/AfterElse` 保留给将来需要时使用。）

        // 本表达式的值 = merge 块的 Phi（类型取 then 分支的实值类型，最准确）
        // ⚠️ 2026-10-06 P228：phi 入边改为 **`前驱块:值`** 对——后端 ISel 按
        // 前驱精确配边，取代「定义块/传递闭包/尾兜底」启发式链（该链在
        // 多分支汇合时错配，实测 decodeNumeric 的 name/a0/a1 串值互相
        // 串块：迭代 1 的 name 泄漏进迭代 2）。
        this.curBlock = mergeBlock
        // phi 类型:HIR 声明类型优先(安全调用 `recv?.len` 的 HirIfExpr 带
        // "Int?" —— then 实值是 strlen 的 Int,旧实现取 then 类型 ⇒ 可空性
        // 丢失 ⇒ nullLen.toString() 打 "0" 而非 "null",实测 06 §6.4)。
        // 声明缺失时退 then 实值类型。
        var phiType: Int = this.program.valueOf(thenVal).type
        val declTy: String = src.tyOf(id)
        if (declTy != "") {
            val declId: Int = this.types.fromTypeName(declTy)
            if (declId >= 0) {
                phiType = declId
            }
        }
        return this.makePhi(mergeBlock, phiType,
            toStr(thenBlock) + ":" + toStr(thenVal) + "," +
            toStr(elseBlock) + ":" + toStr(elseVal), "")
    }

    /// 按 Aura 类型名生成零值常量（`Int` → `0`、`Float` → `0.0`、其余 → `null`）。
    private fun zeroValueOf(tyName: String): Int {
        val typeId: Int = this.types.fromTypeName(tyName)
        if (this.types.isInt(typeId)) {
            return this.program.addValue("Const", typeId, "", "0", this.curBlock)
        }
        if (this.types.isFloat(typeId)) {
            return this.program.addValue("Const", typeId, "", "0.0", this.curBlock)
        }
        return this.program.addValue("Const", typeId, "", "null", this.curBlock)
    }

    /// `<Boolean> → "true"/"false"`：两个字符串常量 + 条件分支 + Phi。
    ///
    /// 不改运行库/ABI（`toStr` 仍是整数→十进制），纯前端改写。
    private fun buildBoolToString(boolVal: Int): Int {
        val strType: Int = this.types.fromTypeName("String")
        val thenBlock: Int = this.program.addBlock()
        val elseBlock: Int = this.program.addBlock()
        val mergeBlock: Int = this.program.addBlock()
        this.program.setTerminator(this.curBlock, "CondBr", 0,
            toStr(boolVal) + "," + toStr(thenBlock) + "," + toStr(elseBlock), "")
        this.curBlock = thenBlock
        val tv: Int = this.program.addValue("Const", strType, "", "true", this.curBlock)
        this.program.setTerminator(this.curBlock, "Br", 0, toStr(mergeBlock), "")
        val varMapAfterThen: String = this.varMap
        this.curBlock = elseBlock
        val fv: Int = this.program.addValue("Const", strType, "", "false", this.curBlock)
        this.program.setTerminator(this.curBlock, "Br", 0, toStr(mergeBlock), "")
        this.curBlock = mergeBlock
        return this.makePhi(mergeBlock, strType,
            toStr(thenBlock) + ":" + toStr(tv) + "," +
            toStr(elseBlock) + ":" + toStr(fv), "")
    }

    /// 该 HIR 表达式是否**静态类型为 Boolean**（判定 `toStr` 实参需不需要真值化）。
    ///
    /// 覆盖四种来源：局部/形参的声明类型、`!x`、返回 Boolean 的调用、
    /// 比较类二元运算；最后兜底看 HIR 自己记的类型。
    private fun isBoolExpr(src: Hir, nodeId: Int): Boolean {
        if (nodeId < 0) {
            return false
        }
        val t: String = src.tyOf(nodeId)
        if (t == "Boolean" || t == "Bool") {
            return true
        }
        val k: String = src.kindOf(nodeId)
        if (k == "HirVar") {
            return this.localTypeOf(src.textOf(nodeId)) == "Boolean"
        }
        if (k == "HirUnary") {
            val op: String = src.textOf(nodeId)
            return op == "!" || op == "Not"
        }
        if (k == "HirCall") {
            val callee: String = src.textOf(nodeId)
            // (a) 全局唯一返回类型
            if (this.uniqueMethodReturnType(callee) == "Boolean") {
                return true
            }
            // (b) `Class_method` 形式（HIR 对 `Uppercase.m()` 的限定写法）
            val us: Int = callee.indexOf("_")
            if (us > 0) {
                val short: String = callee.substring(us + 1, callee.length)
                if (this.classMethodReturnType(callee.substring(0, us), short) == "Boolean") {
                    return true
                }
            }
            // (c) 裸名 + 接收者：先定出接收者的类，再查类限定返回类型
            val ck: List<Int> = src.kidsOfList(nodeId)
            if (HirUtils.hirKidsCount(ck) >= 1) {
                val recvCls: String = this.receiverClassOf(src, HirUtils.hirKidsAt(ck, 0))
                if (recvCls != "") {
                    return this.classMethodReturnType(recvCls, callee) == "Boolean"
                }
            }
            return false
        }
        if (k == "HirBinary") {
            val op: String = src.textOf(nodeId)
            return op == "==" || op == "!=" || op == "<" || op == ">"
                || op == "<=" || op == ">=" || op == "&&" || op == "||"
        }
        return false
    }

    /// 构建 if 语句。
    ///
    /// 创建 then/else/merge 三个基本块：
    ///   cond → CondBr(cond, then, else)
    ///   then → build then body → Br(merge)
    ///   else → build else body → Br(merge)
    ///   merge → Phi 插入（若有变量被两分支定义）
    fun buildIf(src: Hir, id: Int) {
        val traceOn: Boolean = Env.get("AURA_PHOTON_TRACE", "") == "1"
        val kids: List<Int> = src.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (kCount < 2) {
            return
        }

        // 降级条件
        val condVal: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, 0))
        if (traceOn) println("      [if1] condVal=" + condVal)

        // 创建 then 块、else 块、merge 块
        val thenBlock: Int = this.program.addBlock()
        val elseBlock: Int = this.program.addBlock()
        val mergeBlock: Int = this.program.addBlock()
        if (traceOn) println("      [if2] then=" + thenBlock + " else=" + elseBlock + " merge=" + mergeBlock)

        // 设置当前块的终结指令为 CondBr
        if (traceOn) println("      [if3] before setTerminator CondBr")
        this.program.setTerminator(this.curBlock, "CondBr", 0,
            toStr(condVal) + "," + toStr(thenBlock) + "," + toStr(elseBlock), "")
        if (traceOn) println("      [if4] after setTerminator CondBr")

        // 保存 varMap 快照（用于检测 then/else 中定义的变量）
        val varMapBefore: String = this.varMap

        // 构建 then 块
        this.curBlock = thenBlock
        this.buildBlock(src, HirUtils.hirKidsAt(kids, 1))
        if (traceOn) println("      [if5] after buildBlock then")

        // then 分支是否以**自身终结指令**结束（continue/break/return ——
        // 注意必须在下面的自动 Br 补发**之前**判定）。
        val thenSelfTerm: Boolean = this.program.blockOf(this.curBlock).term >= 0

        // 设置 then 块到 merge 块的跳转
        val thenBlockObj: MirBlock = this.program.blockOf(this.curBlock)
        if (thenBlockObj.term < 0) {
            this.program.setTerminator(this.curBlock, "Br", 0, toStr(mergeBlock), "")
        }
        if (traceOn) println("      [if6] after then->merge Br")

        // 保存 then 块中定义的变量
        val varMapAfterThen: String = this.varMap
        if (traceOn) println("      [if7] varMapAfterThen saved")

        // 构建 else 块
        if (kCount > 2) {
            if (traceOn) println("      [if8] before buildBlock else")
            this.curBlock = elseBlock
            // ⚠️ P326（2026-10-06）：then 分支以终结指令结束时，then 路径**永不
            // 经过 else**——else 分支的变量可见性必须回滚到 if 之前的状态。
            // 旧行为让 else 直接继承 then 之后的 varMap ⇒ 支配关系违规：
            // else 臂引用 then 臂的定义值（如 `if (c) { count = count + 1; continue }
            // else if …` 中第二臂的 count 读到第一臂的 count+1 值）——运行期
            // 该值是上一轮迭代的残渣。实测 decodeNumeric 的 count/offset 每轮
            // 回滚（decoded 恒 3/1）、AucLoader 全函数解码量塌缩。
            if (thenSelfTerm) {
                this.varMap = varMapBefore
            }
            this.buildBlock(src, HirUtils.hirKidsAt(kids, 2))
            if (traceOn) println("      [if9] after buildBlock else")
            val elseBlockObj: MirBlock = this.program.blockOf(this.curBlock)
            if (elseBlockObj.term < 0) {
                this.program.setTerminator(this.curBlock, "Br", 0, toStr(mergeBlock), "")
            }
            if (traceOn) println("      [if10] after else->merge Br")
        } else {
            if (traceOn) println("      [if8b] no else, direct Br")
            // 无 else 分支：直接跳转到 merge
            this.curBlock = elseBlock
            this.program.setTerminator(this.curBlock, "Br", 0, toStr(mergeBlock), "")
            if (traceOn) println("      [if10b] after no-else Br")
        }

        // 保存 else 块中定义的变量
        val varMapAfterElse: String = this.varMap
        if (traceOn) println("      [if11] varMapAfterElse saved")

        // 在 merge 块插入 Phi 节点（合并两分支的变量定值）
        if (traceOn) println("      [if12] before insertPhisAtMerge")
        this.insertPhisAtMerge(mergeBlock, varMapBefore, varMapAfterThen,
                               varMapAfterElse, kCount > 2,
                               thenBlock, elseBlock)
        if (traceOn) println("      [if13] after insertPhisAtMerge")

        // varMap 回到入口状态：merge 后每个改动变量的最新值由
        // insertPhisAtMerge 以 **Phi 节点 id** 重新登记（见其说明）。
        // ⚠️ 旧实现 `this.varMap = varMapAfterElse`（else 优先）——对无 else
        // 的 if，afterElse 就是 then 的 varMap ⇒ `if (c) { ok = false }` 之后
        // varMap["ok"] **永久指向 false 常量**（分支执行与否无关）⇒ 该变量
        // 在 SSA 层恒为 false（实测 probe_obj3 的 COPY-BAD，2026-10-04）。

        // 继续构建 merge 块
        this.curBlock = mergeBlock
        if (traceOn) println("      [if14] curBlock=merge")
    }

    /// 在 merge 块插入 Phi 节点。
    ///
    /// 比较 then/else 分支中定义的变量，为两分支都定义的变量插入 Phi。
    /// varMap 格式：name|vid\nname|vid\n...
    private fun insertPhisAtMerge(mergeBlock: Int, before: String,
                                    afterThen: String, afterElse: String,
                                    hasElse: Boolean,
                                    thenBlock: Int, elseBlock: Int): Unit {
        // 找出 then / else 中新增/修改的变量（无 else 时 else 改动集为空，
        // else 出值一律取 before 值）。
        val thenDefs: List<String> = this.findChangedVars(before, afterThen)
        val elseDefs: List<String> = if (hasElse) {
            this.findChangedVars(before, afterElse)
        } else {
            arrayListOf<String>()
        }

        // 合并名单：then ∪ else（去重，then 序优先，else 追加）。
        // ⚠️ 用扁平 CSV + indexOf 去重，禁止 arrayListOf+add（种子 AOT 下
        // add 后 get 返回 null ⇒ 段错误，见 findChangedVars 的说明）。
        var unionCsv: String = ""
        var i: Int = 0
        while (i < thenDefs.size) {
            val v: String = thenDefs[i]
            if (this.unionCsvContains(unionCsv, v) == false) {
                if (unionCsv == "") { unionCsv = v } else { unionCsv = unionCsv + "," + v }
            }
            i = i + 1
        }
        i = 0
        while (i < elseDefs.size) {
            val v: String = elseDefs[i]
            if (this.unionCsvContains(unionCsv, v) == false) {
                if (unionCsv == "") { unionCsv = v } else { unionCsv = unionCsv + "," + v }
            }
            i = i + 1
        }

        // 为每个改动变量建 merge Phi，并**把 varMap 更新到 Phi id**。
        //
        // ⚠️ 旧实现只为「两分支都赋值」的变量建 Phi（单分支赋值不建），
        // 且从不更新 varMap（buildIf 里 `varMap = varMapAfterElse`）——
        // 无 else 的 `if (c) { x = v }` 之后 x 的 SSA 值**恒为 v**（分支
        // 执行与否无关）⇒ 条件赋值全部失效（实测 probe_obj3 的 ok 标志
        // COPY-BAD、本轮 runner 读循环，2026-10-04）。
        // 出值规则：then 出值 = lookupVar(afterThen)（未改 = before 值）；
        // else 出值 = hasElse ? lookupVar(afterElse) : before 值。
        var i2: Int = 0
        while (i2 < this.unionCsvCount(unionCsv)) {
            val varName: String = this.unionCsvName(unionCsv, i2)
            val thenVid: Int = this.lookupVar(before, varName, afterThen)
            val elseVid: Int = if (hasElse) {
                this.lookupVar(before, varName, afterElse)
            } else {
                this.lookupVar(before, varName, before)
            }
            if (thenVid >= 0 && elseVid >= 0 && thenVid != elseVid) {
                // ⚠️ P228：入边带前驱块（`then块:值,else块:值`），见 buildIfExpr
                val incoming: String = toStr(thenBlock) + ":" + toStr(thenVid) + "," +
                                       toStr(elseBlock) + ":" + toStr(elseVid)
                // ⚠️ phi 类型必须继承**入边值**的类型——旧实现硬编码 0（Int），
                // 与 buildWhile 的同名缺陷同族（该处 2026-10-06 已修）。String
                // 变量经 if/else 合并后 phi 被定型 Int ⇒ ISel 的 strcat 判定
                // 失败 ⇒ concat 编成**整数指针加法**（实测 loadModule 类定义段
                // fnLine = fnLine + readStr 变 addq → 堆指针 + 垃圾 →
                // streq 野指针崩溃，2026-10-06）。
                val phiTy: Int = this.program.valueOf(thenVid).type
                val phiId: Int = this.makePhi(mergeBlock, phiTy, incoming, "")
                this.varMapAdd(varName, phiId)
            } else {
                val v: Int = if (thenVid >= 0) { thenVid } else { elseVid }
                if (v >= 0) {
                    this.varMapAdd(varName, v)
                }
            }
            i2 = i2 + 1
        }
    }

    /// CSV 名单去重包含判定（精确 token 匹配，逗号分隔）。
    /// ⚠️ 禁用 String.indexOf（带 from 的 indexOf 在 seed AOT 下失效——
    /// from 参数被忽略/返回错位下标 ⇒ 扫描不前进 ⇒ 死循环），一律
    /// 纯 charCodeAt 逐字符扫描（与 localTypeOf/mapVidOf 同一纪律）。
    private fun unionCsvContains(csv: String, name: String): Boolean {
        if (csv == "" || name == "") { return false }
        var i: Int = 0
        while (i < csv.length) {
            var end: Int = i
            while (end < csv.length) {
                if ((csv.charCodeAt(end) as Int) == 44) { break }
                end = end + 1
            }
            // token = [i, end)
            if (end - i == name.length) {
                var k: Int = 0
                var same: Boolean = true
                while (k < name.length) {
                    if ((csv.charCodeAt(i + k) as Int) != (name.charCodeAt(k) as Int)) {
                        same = false
                        break
                    }
                    k = k + 1
                }
                if (same) { return true }
            }
            if (end >= csv.length) { break }
            i = end + 1
        }
        return false
    }

    /// CSV 名单条目数。
    /// ⚠️ 禁用 indexOf（同上），纯 charCodeAt 扫描。
    private fun unionCsvCount(csv: String): Int {
        if (csv == "") { return 0 }
        var n: Int = 1
        var i: Int = 0
        while (i < csv.length) {
            if ((csv.charCodeAt(i) as Int) == 44) { n = n + 1 }
            i = i + 1
        }
        return n
    }

    /// CSV 名单第 idx 个名字（0 基；越界返回 ""）。
    /// ⚠️ 禁用 indexOf（同 unionCsvContains 说明），纯 charCodeAt 扫描。
    private fun unionCsvName(csv: String, idx: Int): String {
        var start: Int = 0
        var seen: Int = 0
        var i: Int = 0
        while (i <= csv.length) {
            if (i == csv.length || (csv.charCodeAt(i) as Int) == 44) {
                if (seen == idx) {
                    if (i > start) { return csv.substring(start, i) }
                    return ""
                }
                seen = seen + 1
                start = i + 1
            }
            i = i + 1
        }
        return ""
    }

    /// 找出两个 varMap 快照之间新增/修改的变量。
    /// 返回变量名列表。
    private fun findChangedVars(before: String, after: String): List<String> {
        // ⚠️ 不能用 arrayListOf + add（VM bug：add 后 get 返回 null）。
        val csv: String = this.changedVarsCsv(before, after)
        if (csv == "") { return emptyList() }
        return csv.split(",")
    }

    /// 收集「最新 vid 发生变化」的变量名，返回逗号分隔串（最新优先，去重）。
    ///
    /// ⚠️ 性能关键：本函数**每个 `if` 语句**都会被调用（`insertPhisAtMerge`），
    /// 旧实现每次都对 `before`/`after` 整表 `split("\n")`，再对每个候选变量
    /// 逐行 `split("|")` 比对 —— 单次调用 O(A²) 次字符串分配（A = 变量表条目
    /// 数，随函数内赋值数增长）。编译 `Main.aura` 时，`Lexer.scanString` /
    /// `Lexer.scanChar` 这类「大函数 + 深层嵌套 if」把 Phase A 拖到
    /// 单函数 10–25 秒、峰值内存 800 MB+。
    ///
    /// 现改为纯整数索引扫描（`charCodeAt` 比较 + `\n`/`|` 码点定位），
    /// 只对**命中**的名字切片一次，整体 O(表长 × 变量数) 且零中间分配。
    private fun changedVarsCsv(before: String, after: String): String {
        if (before == after) { return "" }
        var resultStr: String = ""
        var end: Int = after.length
        while (end > 0) {
            var start: Int = end - 1
            // ⚠️ 反向扫描必须**只用合法下标**调 `charCodeAt`：
            //   AOT 把 `String.charCodeAt(i)` 降级成无边界检查的内联访存
            //   （`getelementptr i8, i8* s, i64 i` + `load i8`，见 Emit.aura §2.7），
            //   直接绕过 Aura 源码里的 `index < 0` 保护。一旦 `start` 走到 -1
            //   就会读到字符串缓冲区之前一个字节：轻则读到垃圾使扫描不终止，
            //   重则访问违规（0xC0000005）。原写法 `while (start >= 0 &&
            //   after.charCodeAt(start) != 10)` 就踩了这个坑。
            //   改为：循环体内只读 `start > 0` 的字节，下标 0 在循环外单独判定。
            while (start > 0) {
                if (after.charCodeAt(start) == 10) { start = start + 1; break }
                start = start - 1
            }
            if (start == 0) {
                if (after.charCodeAt(0) == 10) { start = 1 }
            }
            if (end > start) {
                var sep: Int = start
                while (sep < end) {
                    if (after.charCodeAt(sep) == 124) { break }
                    sep = sep + 1
                }
                if (sep < end) {
                    // ⚠️ 名字**不能**先切片成 String：AOT 下 `substring` 每次都要
                    // `strlen(整个 after)`（O(|after|)），而本循环逐行调用 ——
                    // 巨型函数（`emitCall`：上万局部变量、上千分支块）上退化成
                    // O(行数 × 表长)。改为把 [start, sep) 当**区间**传下去，
                    // 只在确实要写进结果时才切片。
                    val nlen: Int = sep - start
                    if (nlen > 0 && !this.containsInFlatRange(resultStr, after, start, sep)) {
                        var afterVid: Int = 0
                        var p: Int = sep + 1
                        var neg: Boolean = false
                        if (p < end && after.charCodeAt(p) == 45) { neg = true; p = p + 1 }
                        while (p < end) {
                            val d: Int = after.charCodeAt(p) - 48
                            if (d >= 0 && d <= 9) { afterVid = afterVid * 10 + d }
                            p = p + 1
                        }
                        if (neg) { afterVid = 0 - afterVid }
                        val beforeVid: Int = this.mapVidOfRange(before, after, start, sep)
                        // 新变量（before 中没有）或值发生了变化
                        if (beforeVid < 0 || beforeVid != afterVid) {
                            val name: String = after.substring(start, sep)
                            if (resultStr == "") {
                                resultStr = name
                            } else {
                                resultStr = resultStr + "," + name
                            }
                        }
                    }
                }
            }
            end = start - 1
        }
        return resultStr
    }

    /// 比较 `s[from, to)` 是否与 `token` 逐字符相等（**零分配**）。
    private fun tokenRangeEquals(s: String, from: Int, to: Int, token: String): Boolean {
        if (to - from != token.length) { return false }
        var i: Int = 0
        while (i < token.length) {
            if (s.charCodeAt(from + i) != token.charCodeAt(i)) { return false }
            i = i + 1
        }
        return true
    }

    /// 在 \name|vid\n…` 扁平变量表中，从末尾向前找 \name` 的最新 vid（未找到 -1）。
    ///
    /// 零分配：按 `\n` 定位行，行内按 `|`（124）定位，只对命中项切片一次。
    /// ⚠️ 所有 `charCodeAt` 调用都必须落在 `[0, len)` 内（AOT 内联访存无边界检查）。
    private fun mapVidOf(map: String, name: String): Int {
        if (map == "" || name == "") { return -1 }
        val nlen: Int = name.length
        val mlen: Int = map.length
        // **倒序扫描**：正向实现「保留最后一次匹配」，而倒序遇到的**第一个**匹配
        // 就是它 —— 语义完全等价，但变量通常刚被写入表尾，几步即命中；
        // 正向则必须把整表扫完（表长 ≥ 数千字符 × 每个变量读取一次）。
        //
        // 下标安全：`p` 上界为 `mlen - nlen - 1`（保证 `p + nlen` 是表内下标，
        // 与正向的 `i + nlen < mlen` 判定等价），下界 0；所有 `charCodeAt`
        // 都落在 `[0, mlen)`（AOT 内联访存无边界检查，见 changedVarsCsv 的说明）。
        val c0: Int = name.charCodeAt(0)
        var p: Int = mlen - nlen - 1
        while (p >= 0) {
            // ⚠️ 必须要求 `p` 是**行首**（`p == 0` 或前一字符是 `\n`）。
            //
            // 原实现只检查「名字首字符 + 后面紧跟 `|`」，于是在
            //     a|537\nb|538\neq_aa|548\n
            // 里查 `a` 会命中 `eq_aa|548` 的**末尾那个 a**（它后面正好是 `|`），
            // 且倒序扫描还优先命中它 ⇒ `a` 被解析成 `eq_aa` 的值。
            // 实测 `tests/photon/P0/01_string_eq.aura`：
            //     val eq_aa = if (a == a) 1 else 0
            //     val eq_ab = if (a == b) 1 else 0      ← 这里的 a 变成 eq_aa（当前 if 的上一个结果）
            //     val eq_ne_ab = if (a != b) 1 else 0   ← a→eq_aa、b→eq_ab
            // HAT 里成了 `@call @streq(@t548, @t538)`（应为 @t537）⇒ 判等结果全错。
            val atLineStart: Boolean = (p == 0) || (map.charCodeAt(p - 1) == 10)
            if (atLineStart && map.charCodeAt(p) == c0 && map.charCodeAt(p + nlen) == 124) {
                var match: Boolean = true
                var k: Int = 1
                while (k < nlen) {
                    if (map.charCodeAt(p + k) != name.charCodeAt(k)) { match = false; break }
                    k = k + 1
                }
                if (match) {
                    // 就地解析 `|` 之后到行尾的十进制（零分配，不碰 substring）。
                    var j: Int = p + nlen + 1
                    var v: Int = 0
                    var neg: Boolean = false
                    if (j < mlen && map.charCodeAt(j) == 45) { neg = true; j = j + 1 }
                    while (j < mlen && map.charCodeAt(j) != 10) {
                        val d: Int = map.charCodeAt(j) - 48
                        if (d >= 0 && d <= 9) { v = v * 10 + d }
                        j = j + 1
                    }
                    if (neg) { return 0 - v }
                    return v
                }
            }
            p = p - 1
        }
        return -1
    }

    /// 检查扁平字符串（逗号分隔）中是否包含指定名称（零分配扫描，不拆分）。
    private fun containsInFlat(flat: String, name: String): Boolean {
        if (flat == "" || name == "") { return false }
        var start: Int = 0
        val len: Int = flat.length
        var i: Int = 0
        while (i <= len) {
            if (i == len || flat.charCodeAt(i) == 44) {
                if (this.tokenRangeEquals(flat, start, i, name)) { return true }
                start = i + 1
            }
            i = i + 1
        }
        return false
    }

    /// `containsInFlat` 的**区间**版本：候选名是 `text[from, to)`，不切片、不分配。
    ///
    /// 供 `changedVarsCsv` 使用：那里逐行扫描一个可能很大的 `after` 表，
    /// 若每行都先 `substring` 出名字，每次都要 `strlen(整个 after)`（O(|after|)）。
    private fun containsInFlatRange(flat: String, text: String, from: Int, to: Int): Boolean {
        if (flat == "" || to <= from) { return false }
        val tlen: Int = to - from
        val len: Int = flat.length
        var start: Int = 0
        var i: Int = 0
        while (i <= len) {
            if (i == len || flat.charCodeAt(i) == 44) {
                if (i - start == tlen) {
                    var k: Int = 0
                    var ok: Boolean = true
                    while (k < tlen) {
                        if (flat.charCodeAt(start + k) != text.charCodeAt(from + k)) { ok = false; break }
                        k = k + 1
                    }
                    if (ok) { return true }
                }
                start = i + 1
            }
            i = i + 1
        }
        return false
    }

    /// `mapVidOf` 的**区间**版本：名字是 `text[from, to)`（零分配）。
    private fun mapVidOfRange(map: String, text: String, from: Int, to: Int): Int {
        if (map == "" || to <= from) { return -1 }
        val nlen: Int = to - from
        val mlen: Int = map.length
        val c0: Int = text.charCodeAt(from)
        var p: Int = mlen - nlen - 1
        while (p >= 0) {
            if (map.charCodeAt(p) == c0 && map.charCodeAt(p + nlen) == 124) {
                var match: Boolean = true
                var k: Int = 1
                while (k < nlen) {
                    if (map.charCodeAt(p + k) != text.charCodeAt(from + k)) { match = false; break }
                    k = k + 1
                }
                if (match) {
                    var j: Int = p + nlen + 1
                    var v: Int = 0
                    var neg: Boolean = false
                    if (j < mlen && map.charCodeAt(j) == 45) { neg = true; j = j + 1 }
                    while (j < mlen && map.charCodeAt(j) != 10) {
                        val d: Int = map.charCodeAt(j) - 48
                        if (d >= 0 && d <= 9) { v = v * 10 + d }
                        j = j + 1
                    }
                    if (neg) { return 0 - v }
                    return v
                }
            }
            p = p - 1
        }
        return -1
    }

    /// 在 varMap 中查找变量的 ValueID。
    ///
    /// `before` 参数保留以兼容调用点（原实现同样只查 `after`；
    /// `afterThen`/`afterElse` 快照本身已包含 `before` 的全部条目）。
    private fun lookupVar(before: String, name: String, after: String): Int {
        // 从末尾向前搜索以获取最新版本（零分配）
        return this.mapVidOf(after, name)
    }

    /// 在指定块插入 Phi 节点（for loop back-edge）。
    ///
    /// 比较块前状态和块后状态，为两状态都定义的变量插入 Phi。
    /// 用于 while 循环的回边 Phi 插入。
    private fun insertPhisAtBlock(blockId: Int, before: String,
                                    after: String, exitState: String): String {
        // 用逗号分隔的扁平字符串收集变更变量名（不能用 arrayListOf+add，VM bug）
        val afterDefsStr: String = this.findChangedVarsStr(before, after)
        if (afterDefsStr == "") { return this.varMap }

        val afterDefs: List<String> = afterDefsStr.split(",")
        var newVarMap: String = this.varMap
        var i: Int = 0
        while (i < afterDefs.size) {
            val varName: String = afterDefs[i]
            val beforeVid: Int = this.lookupVar("", varName, before)
            if (beforeVid >= 0) {
                val afterVid: Int = this.lookupVar("", varName, after)
                if (afterVid >= 0) {
                    val typeId: Int = 0
                    val incoming: String = toStr(beforeVid) + "," + toStr(afterVid)
                    val phiVid: Int = this.makePhi(blockId, typeId, incoming, "")
                    // 更新 varMap 指向 Phi 节点（追加新版本）
                    newVarMap = newVarMap + varName + "|" + toStr(phiVid) + "\n"
                }
            }
            i = i + 1
        }
        return newVarMap
    }

    /// 找出两个 varMap 快照之间新增/值变化的变量名，返回逗号分隔字符串。
    ///
    /// 与 `findChangedVars` 同源，共用零分配的 `changedVarsCsv`。
    private fun findChangedVarsStr(before: String, after: String): String {
        return this.changedVarsCsv(before, after)
    }

    /// 构建 while 语句。
    ///
    /// 创建 cond/body/end 三个基本块：
    ///   cond → 降级条件 → CondBr(cond, body, end)
    ///   body → 构建循环体 → Br(cond)
    ///   end  → 循环结束
    ///
    /// 使用 loopStack 记录循环退出块，供 break/continue 查找。
    ///
    /// ⚠️ Phi 的插入时机（循环变量正确性的关键）：
    /// Phi **必须在构建循环体之前**创建并写入 varMap。旧实现在循环体构建完
    /// 之后再插入 Phi —— 此时循环体里对 `i` 的每一处引用都已解析成**循环前的
    /// 旧值**（如 `var i = 0` 的常量 0），循环体读到的 `i` 永远是初值：
    /// 实测 `while (i < 5) { println(...); i = i + 1 }` 打印 "while i = 0" 无限
    /// 循环（`i + 1` 恒为 0+1，`i` 本身从不更新）。
    ///
    /// 现改为：
    ///   1. 预扫描循环体，收集被赋值的变量名；
    ///   2. 对「循环前已存在」的那些变量，先在 cond 块建 Phi（入边 0 = 循环前值，
    ///      入边 1 先占位）并把 varMap 指向 Phi；
    ///   3. 构建循环体 —— 所有引用自然解析到 Phi；
    ///   4. 回填 Phi 的入边 1 = 循环体末尾该变量的值。
    fun buildWhile(src: Hir, id: Int) {
        val kids: List<Int> = src.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (kCount < 2) {
            return
        }

        // 保存 varMap 快照（循环前的状态）
        val varMapBefore: String = this.varMap

        // 保存当前块（入口块），创建新的条件块
        val entryBlock: Int = this.curBlock
        val condBlock: Int = this.program.addBlock()
        val bodyBlock: Int = this.program.addBlock()
        val endBlock: Int = this.program.addBlock()

        // 循环栈压入「condBlock,endBlock」成对项：break 取栈顶(endBlock)、
        // continue 取第二项(condBlock)。⚠️ 旧实现只压 endBlock 一项，
        // loopStackContinueTarget 找不到逗号就退回 endBlock ⇒ continue 变成
        // break（实测 probe_break：cont 后整个循环提前退出，2026-10-05）。
        this.loopStackPush(endBlock)
        if (this.loopStack == "") {
            this.loopStack = toStr(condBlock)
        } else {
            this.loopStack = toStr(condBlock) + "," + this.loopStack
        }
        if (this.loopContStack == "") {
            this.loopContStack = toStr(condBlock)
        } else {
            this.loopContStack = toStr(condBlock) + "," + this.loopContStack
        }

        // 入口块跳转到条件块（如果尚未设置终结指令）
        val entryBlockObj: MirBlock = this.program.blockOf(entryBlock)
        if (entryBlockObj.term < 0) {
            this.program.setTerminator(entryBlock, "Br", 0, toStr(condBlock), "")
        }

        val bodyKid: Int = HirUtils.hirKidsAt(kids, 1)

        // ── 步骤 1+2：预建循环变量 Phi ──
        // phiRecs：每行 "name|phiVid|beforeVid"
        val assignedNames: String = this.collectAssignedVars(src, bodyKid, "")
        var phiRecs: String = ""
        var phiVarEntries: String = ""
        if (assignedNames != "") {
            val names: List<String> = assignedNames.split(",")
            var ni: Int = 0
            while (ni < names.size) {
                val nm: String = names[ni]
                val beforeVid: Int = this.lookupVar("", nm, varMapBefore)
                if (beforeVid >= 0) {
                    // 入边 1 先占位为 beforeVid，稍后回填。
                    // ⚠️ P228：入边带前驱块——pred0 = entryBlock（入循环块）；
                    // pred1（循环回边 latch）此刻未知，占位 -1，回填时补。
                    val incoming: String = toStr(entryBlock) + ":" + toStr(beforeVid) + "," +
                                           toStr(-1) + ":" + toStr(beforeVid)
                    // ⚠️ phi 类型必须继承**入口入边值**的类型——旧实现硬编码
                    // 0（Int），String 循环变量（`result = result + …`）的 phi
                    // 被定型成 Int ⇒ ISel 的 emitStrcat 判定
                    // isString(Add.type) 失败 ⇒ 字符串 concat 被编译成
                    // **整数指针加法** ⇒ 循环退出后读到 0x200 垃圾（实测
                    // VM runner 的 AucReader.readMagic strlen(0x200) 崩，
                    // 2026-10-06）。
                    val phiTy: Int = this.program.valueOf(beforeVid).type
                    val phiVid: Int = this.makePhi(condBlock, phiTy, incoming, "")
                    this.varMap = this.varMap + nm + "|" + toStr(phiVid) + "\n"
                    phiVarEntries = phiVarEntries + nm + "|" + toStr(phiVid) + "\n"
                    phiRecs = phiRecs + nm + "|" + toStr(phiVid) + "|" + toStr(beforeVid) + "\n"
                }
                ni = ni + 1
            }
        }

        // Phi 变量条目入 continue 栈（buildContinue 读取以登记 continue 值）
        if (this.loopPhiVarsStack == "") {
            this.loopPhiVarsStack = phiVarEntries
        } else {
            this.loopPhiVarsStack = phiVarEntries + "\n" + this.loopPhiVarsStack
        }

        // ── 步骤 3：构建循环体（varMap 已指向 Phi）──
        this.curBlock = bodyBlock
        this.buildBlock(src, bodyKid)

        // 循环体结束：跳回条件块
        val bodyBlockObj: MirBlock = this.program.blockOf(this.curBlock)
        if (bodyBlockObj.term < 0) {
            this.program.setTerminator(this.curBlock, "Br", 0, toStr(condBlock), "")
        }

        // 保存循环体中定义的变量
        val varMapAfterBody: String = this.varMap

        // ── 步骤 4：回填 Phi 的第二条入边（循环体末尾的值）──
        if (phiRecs != "") {
            val recLines: List<String> = this.splitStr(phiRecs, "\n")
            var ri: Int = 0
            while (ri < recLines.size) {
                val rec: String = recLines[ri]
                if (rec != "") {
                    val recParts: List<String> = this.splitStr(rec, "|")
                    if (recParts.size >= 3) {
                        val nm: String = recParts[0]
                        val phiVid: Int = this.strToInt(recParts[1])
                        val beforeVid: Int = this.strToInt(recParts[2])
                        val afterVid: Int = this.lookupVar("", nm, varMapAfterBody)
                        if (phiVid >= 0 && afterVid >= 0) {
                            // ⚠️ 必须经**命名局部变量**中转写回，两个坑都不能踩：
                            //
                            // (1) 不能写成 `this.program.valueOf(id).args = …`
                            //     （链式临时值上直接赋字段）。AOT 载体下该模式
                            //     **丢失写回**：临时 MirValue 不是 arena 里的那个
                            //     对象，赋值落到死副本上 —— PHI 的第二条入边永远
                            //     停留在占位值（`@phi(@t13, @t13)`），循环变量
                            //     永不更新，产物死循环（实测 P1/04、P2/01、P2/02、
                            //     P2/03；同一份源码 3 次独立 AOT 构建结果一致，
                            //     不是非确定性问题）。先 `val pv = valueOf(id)`
                            //     再写 `pv.args`，则 VM 与 AOT 两侧都正确持久化。
                            //
                            // (2) 也不能 `this.values.set(id, v)` 重新插回槽位：
                            //     `ArrayList.set` 的实现是 `data[index] = value`，
                            //     而 `lowerAssign` 的下标分支产出的 `HirAssign`
                            //     **目标名为空**（`text=""`），AOT 发不出真正的
                            //     字段写回，反而把 arena 里该槽位的对象**毁掉**
                            //     （实测同一 ValueID 回写后读出 `args='i'`、
                            //     `op='??'`，PHI 与整个 SSA 变残骸）。
                            val pv: MirValue = this.program.valueOf(phiVid)
                            // ⚠️ P228：回填时补上 latch（回边前驱块）——此刻
                            // this.curBlock 仍是循环体末块（下一步才跳出）。
                            pv.args = toStr(entryBlock) + ":" + toStr(beforeVid) + "," +
                                      toStr(this.curBlock) + ":" + toStr(afterVid)
                            // continue 点值：追加为额外入边（纯 charCodeAt
                            // 扫描，禁 indexOf——seed AOT 下带 from 的 indexOf
                            // 失效导致死循环/错位）。
                            var ci: Int = 0
                            val recsLen: Int = this.loopContRecs.length
                            while (ci < recsLen) {
                                var eEnd: Int = ci
                                while (eEnd < recsLen) {
                                    if ((this.loopContRecs.charCodeAt(eEnd) as Int) == 10) { break }
                                    eEnd = eEnd + 1
                                }
                                val rec: String = this.loopContRecs.substring(ci, eEnd)
                                if (rec != "") {
                                    var p1: Int = -1
                                    var p2: Int = -1
                                    var k: Int = 0
                                    while (k < rec.length) {
                                        if ((rec.charCodeAt(k) as Int) == 124) {
                                            if (p1 < 0) { p1 = k } else { if (p2 < 0) { p2 = k; break } }
                                        }
                                        k = k + 1
                                    }
                                    if (p1 > 0 && p2 > p1) {
                                        val recCond: String = rec.substring(0, p1)
                                        val recPhi: String = rec.substring(p1 + 1, p2)
                                        // ⚠️ 必须显式 2 参 substring：1 参
                                        // `rec.substring(p2 + 1)` 在 seed AOT 下
                                        // 落到双参 C 符号、`to` 为垃圾 ⇒ 返回
                                        // 空串 ⇒ phi 额外入边静默丢失（实测
                                        // [contAPPEND] args=…, 尾部空，
                                        // 2026-10-06）。
                                        val recVid: String = rec.substring(p2 + 1, rec.length)
                                        if (recCond == toStr(condBlock) && recPhi == toStr(phiVid)) {
                                            pv.args = pv.args + "," + recVid
                                        }
                                    }
                                }
                                if (eEnd >= recsLen) { break }
                                ci = eEnd + 1
                            }
                        }
                    }
                }
                ri = ri + 1
            }
        }

        // 切换到条件块，使用更新后的 varMap（包含 Phi 节点）
        this.curBlock = condBlock

        // ⚠️ 条件块看到的循环变量必须是 **Phi**，不能是循环体末尾的值：
        // `lookupVar` 从 varMap 末尾向前搜索（最新版本优先），而 varMapAfterBody
        // 末尾是循环体里 `i = i + 1` 的结果。若直接沿用，条件会退化成
        // `(i+1) < 5` —— 实测 while 循环只跑 4 次（for 只跑 2 次）。
        // 这里把 varMap 重置为「循环前状态 + Phi 条目」（Phi 在末尾 → 优先命中）。
        this.varMap = varMapBefore + phiVarEntries

        // 降级条件（使用 Phi 节点作为变量值）
        val condVal: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, 0))

        // 设置条件块的终结指令
        this.program.setTerminator(condBlock, "CondBr", 0,
            toStr(condVal) + "," + toStr(bodyBlock) + "," + toStr(endBlock), "")

        // 将结束块弹出循环栈
        this.loopStackPop()
        this.loopStackPop()
        if (this.loopContStack == "") {
            // 空
        } else {
            val cIdx: Int = this.loopContStack.indexOf(",")
            if (cIdx < 0) {
                this.loopContStack = ""
            } else {
                this.loopContStack = this.loopContStack.substring(cIdx + 1)
            }
        }
        if (this.loopPhiVarsStack == "") {
            // 空
        } else {
            val pIdx: Int = this.loopPhiVarsStack.indexOf("\n")
            if (pIdx < 0) {
                this.loopPhiVarsStack = ""
            } else {
                this.loopPhiVarsStack = this.loopPhiVarsStack.substring(pIdx + 1)
            }
        }

        // ⚠️ 循环之后的变量值必须是 **Phi**，不能是循环体末尾的值。
        // 理由：`end` 块可以从条件块直接到达（循环一次都没进），此时循环体里的
        // 值**根本没有被求值**——它不支配 end 块，引用它就是非法 SSA。
        // 实测 P2/01_nested_loop：`sum` 被解析成内层循环体的 `sum + i + j`
        //（属于内层块），既违反支配关系，又让该表达式被发射到错误的块里。
        // Phi 恰好携带「最后写回的值 or 循环前的值」，是唯一正确的选择。
        // 因此这里不再还原 `varMapAfterBody`（varMap 已在上一步设为
        // `varMapBefore + phiVarEntries`）。

        // 继续构建结束块
        this.curBlock = endBlock

        // R58: 创建循环后的新块——endBlock 是循环退出块，不应包含循环后的代码。
        // 设置 endBlock → Br → 新块，后续代码在新块中构建。
        val afterBlock2: Int = this.program.addBlock()
        this.program.setTerminator(endBlock, "Br", 0, toStr(afterBlock2), "")
        this.curBlock = afterBlock2
    }

    /// 递归收集 HIR 子树中被赋值（`HirAssign`）的变量名，返回逗号分隔串（去重）。
    ///
    /// 供 `buildWhile` 预判循环携带变量（loop-carried variables）。
    private fun collectAssignedVars(src: Hir, id: Int, out: String): String {
        var result: String = out
        if (src.kindOf(id) == "HirAssign") {
            val name: String = src.textOf(id)
            if (name != "" && !this.containsInFlat(result, name)) {
                if (result == "") {
                    result = name
                } else {
                    result = result + "," + name
                }
            }
        }
        val kids: List<Int> = src.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        var i: Int = 0
        while (i < kCount) {
            result = this.collectAssignedVars(src, HirUtils.hirKidsAt(kids, i), result)
            i = i + 1
        }
        return result
    }

    /// 构建 for-in 循环（HirFor）。
    ///
    /// HIR 形状：HirFor("", "", sp, [HirVarDecl(name), HirCall(__range, [start,end,inc]), HirBlock(body)])。
    /// 降级为 while 循环：
    ///   list = __range(start, end, inc)
    ///   i = 0
    ///   while (i < count(list)) {
    ///       name = getAt(list, i)
    ///       body
    ///       i = i + 1
    ///   }
    ///
    /// 实现策略：复用 buildWhile 的 phi 机制。在 bodyBlock 里先执行
    /// `name = getAt(list, i)`，再执行用户循环体。`i` 和 `name` 都是
    /// 循环变量，需要 phi 节点。
    /// 复用 buildWhile 的 phi 机制。在 condBlock 里计算 count(list)，
    /// 在 bodyBlock 里赋值 loopVarName = getAt(list, i) 并执行用户循环体。
    fun buildFor(src: Hir, id: Int) {
        val kids: List<Int> = src.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (kCount < 3) {
            return
        }

        val entryBlock: Int = this.curBlock
        val varMapBefore: String = this.varMap

        // kids[0] = HirVarDecl(name) —— 循环变量名
        val varDeclNode: Int = HirUtils.hirKidsAt(kids, 0)
        val loopVarName: String = src.textOf(varDeclNode)

        // kids[1] = 迭代器表达式（可以是 HirCall(__range, ...) / HirVar(list) / 等）
        val iterNode: Int = HirUtils.hirKidsAt(kids, 1)
        val listVal: Int = this.buildExpr(src, iterNode)

        // kids[2] = HirBlock(body) —— 循环体
        val bodyKid: Int = HirUtils.hirKidsAt(kids, 2)

        // 创建块结构（同 buildWhile）
        val condBlock: Int = this.program.addBlock()
        val bodyBlock: Int = this.program.addBlock()
        val endBlock: Int = this.program.addBlock()

        // 循环栈：break → endBlock，continue → condBlock
        this.loopStackPush(endBlock)
        if (this.loopStack == "") {
            this.loopStack = toStr(condBlock)
        } else {
            this.loopStack = toStr(condBlock) + "," + this.loopStack
        }
        if (this.loopContStack == "") {
            this.loopContStack = toStr(condBlock)
        } else {
            this.loopContStack = toStr(condBlock) + "," + this.loopContStack
        }

        // 入口块跳转到条件块
        val entryBlockObj: MirBlock = this.program.blockOf(entryBlock)
        if (entryBlockObj.term < 0) {
            this.program.setTerminator(entryBlock, "Br", 0, toStr(condBlock), "")
        }

        // ── 条件块：初始化 i=0，计算 count(list) ──
        this.curBlock = condBlock
        val i64: Int = this.types.intType(64)
        val zeroVal: Int = this.program.addValue("Const", i64, "", "0", this.curBlock)

        // count(list)
        val countVal: Int = this.program.addValue("Call", i64, toStr(listVal),
                                                  "Collections_count", this.curBlock)

        // 保存 loopVarName 的旧值（如果有）
        val loopVarBefore: Int = this.lookupVar("", loopVarName, varMapBefore)

        // ── 步骤 1+2：预建循环变量 Phi（同 buildWhile 的 collectAssignedVars 机制） ──
        // 预扫描循环体，收集被赋值的变量名
        val assignedNames: String = this.collectAssignedVars(src, bodyKid, "")
        var phiRecs: String = ""
        var phiVarEntries: String = ""

        // 先创建计数器 i 的 phi（i 是 for-loop 内部变量，不在 assignedNames 中）
        val iPhiIncoming: String = toStr(entryBlock) + ":" + toStr(zeroVal) + "," +
                                   toStr(-1) + ":" + toStr(zeroVal)
        val iPhi: Int = this.makePhi(condBlock, i64, iPhiIncoming, "i")
        this.varMap = this.varMap + "i|" + toStr(iPhi) + "\n"
        phiVarEntries = phiVarEntries + "i|" + toStr(iPhi) + "\n"
        phiRecs = phiRecs + "i|" + toStr(iPhi) + "|" + toStr(zeroVal) + "\n"

        // 为 body 中赋值的变量创建 phi（包括 sum 等循环携带变量）
        if (assignedNames != "") {
            val names: List<String> = assignedNames.split(",")
            var ni: Int = 0
            while (ni < names.size) {
                val nm: String = names[ni]
                if (nm != "i") {
                    val beforeVid: Int = this.lookupVar("", nm, varMapBefore)
                    if (beforeVid >= 0) {
                        val incoming: String = toStr(entryBlock) + ":" + toStr(beforeVid) + "," +
                                               toStr(-1) + ":" + toStr(beforeVid)
                        val phiTy: Int = this.program.valueOf(beforeVid).type
                        val phiVid: Int = this.makePhi(condBlock, phiTy, incoming, "")
                        this.varMap = this.varMap + nm + "|" + toStr(phiVid) + "\n"
                        phiVarEntries = phiVarEntries + nm + "|" + toStr(phiVid) + "\n"
                        phiRecs = phiRecs + nm + "|" + toStr(phiVid) + "|" + toStr(beforeVid) + "\n"
                    }
                }
                ni = ni + 1
            }
        }

        // 保存 loopVarName 的旧值用于 phi
        // loopVarName 也需要 phi：它在 bodyBlock 里被赋值（getAt），每次迭代更新
        // 但它不是通过 HirAssign 赋值的（它是由 buildFor 在 bodyBlock 里创建的 Mov/Call），
        // 所以 collectAssignedVars 不会收集它。需要手动创建。
        // 但 loopVarName 在 entryBlock 可能不存在（for-loop 变量是全新的），
        // 所以 phi 只有单条入边（来自 bodyBlock）。
        // 实际上，loopVarName 在 condBlock 里作为 getAt 的结果被赋值，
        // 它不需要 phi——每次迭代都是新的值，直接存储即可。
        // 但为了让 bodyBlock 里的代码能引用 loopVarName，
        // 需要在 condBlock 里创建 getAt 并注册到 varMap。
        // 但这只在第一次迭代有效——后续迭代的值在 bodyBlock 末尾被覆盖。
        // 这正是 while 循环需要 phi 的原因：loopVarName 在 bodyBlock 里被赋值，
        // 后续迭代需要上一次的循环携带值。
        // 但 for-loop 的 loopVarName 不需要携带——每次都是 getAt(list, i) 的新值。
        // 所以 loopVarName 不需要 phi！
        // 只需要在 bodyBlock 里创建 getAt 并注册到 varMap。

        // Phi 变量条目入 continue 栈（buildContinue 读取以登记 continue 值）
        if (this.loopPhiVarsStack == "") {
            this.loopPhiVarsStack = phiVarEntries
        } else {
            this.loopPhiVarsStack = phiVarEntries + "\n" + this.loopPhiVarsStack
        }

        // 条件：i < count
        val cmpVal: Int = this.program.addValue("ICmpSlt", this.types.intType(1),
                                                toStr(iPhi) + "," + toStr(countVal), "", this.curBlock)

        // 条件跳转
        this.program.setTerminator(condBlock, "CondBr", 0,
            toStr(cmpVal) + "," + toStr(bodyBlock) + "," + toStr(endBlock), "")

        // ── bodyBlock：赋值循环变量，执行用户循环体 ──
        this.curBlock = bodyBlock

        // 赋值 loopVarName = getAt(list, i)
        // ⚠️ Plan A 解箱：Collections.range 推送 (i<<1)|1 格式，
        // getAt 返回装箱值，需要 >>1 提取原始整数。
        val getAtArgs: String = toStr(listVal) + "," + toStr(iPhi)
        val getAtRaw: Int = this.program.addValue("Call", i64, getAtArgs,
                                                   "Collections_getAt", this.curBlock)
        val oneVal0: Int = this.program.addValue("Const", i64, "", "1", this.curBlock)
        val getAtVal: Int = this.program.addValue("Shr", i64,
                                                   toStr(getAtRaw) + "," + toStr(oneVal0), "", this.curBlock)
        // 注册 loopVarName 到 varMap
        this.varMap = this.varMap + loopVarName + "|" + toStr(getAtVal) + "\n"

        // 执行用户循环体
        this.buildBlock(src, bodyKid)

        // 循环体结束：跳回条件块
        val bodyBlockObj: MirBlock = this.program.blockOf(this.curBlock)
        if (bodyBlockObj.term < 0) {
            this.program.setTerminator(this.curBlock, "Br", 0, toStr(condBlock), "")
        }

        // 保存循环体后的 varMap
        val varMapAfterBody: String = this.varMap

        // ── 步骤 4：回填 Phi 的第二条入边（循环体末尾的值）──
        // i 的新值：i + 1
        val oneVal: Int = this.program.addValue("Const", i64, "", "1", this.curBlock)
        val iNew: Int = this.program.addValue("Add", i64, toStr(iPhi) + "," + toStr(oneVal), "", this.curBlock)

        // 更新 i phi
        val iPhiVal: MirValue = this.program.valueOf(iPhi)
        iPhiVal.args = toStr(entryBlock) + ":" + toStr(zeroVal) + "," +
                       toStr(this.curBlock) + ":" + toStr(iNew)
        // R58: i phi 的 continue 点值——修正「continue 跳过 latch 导致 i 永不递增」
        // （2026-10-14 R63）。
        //
        // 根因：buildFor 的循环体在 bodyBlock 里执行，其中 buildContinue
        // 为 `i` 登记的是 `Mov(iPhi)`（原值拷贝，定义于 continue 前驱块）。
        // 但 for-loop 的 `i` 递增在 latch 块末尾 `iNew = iPhi + 1`，
        // continue 跳过 latch 块 ⇒ i 的 continue 入边拿到未递增值 ⇒
        // 循环条件 `i < count` 永不满足，无限循环（实测 04-control-flow
        // §4.10 两个 for 都死循环）。
        //
        // 修法：buildContinue 在 for-loop 内为 `i` 直接生成 `Add(iPhi, 1)`
        // 而非 `Mov(iPhi)`——Add 定义于 continue 前驱块（与 Mov 位置一致），
        // 作为 continue 入边值，等价于「continue 跳过用户体但仍执行 i++」。
        // while 循环栈顶首个变量名不会是 "i"，故此特化只影响 for-loop。
        var ci2: Int = 0
        val recsLen2: Int = this.loopContRecs.length
        while (ci2 < recsLen2) {
            var eEnd2: Int = ci2
            while (eEnd2 < recsLen2) {
                if ((this.loopContRecs.charCodeAt(eEnd2) as Int) == 10) { break }
                eEnd2 = eEnd2 + 1
            }
            val rec2: String = this.loopContRecs.substring(ci2, eEnd2)
            if (rec2 != "") {
                var p1: Int = -1
                var p2: Int = -1
                var k: Int = 0
                while (k < rec2.length) {
                    if ((rec2.charCodeAt(k) as Int) == 124) {
                        if (p1 < 0) { p1 = k } else { if (p2 < 0) { p2 = k; break } }
                    }
                    k = k + 1
                }
                if (p1 > 0 && p2 > p1) {
                    val recCond: String = rec2.substring(0, p1)
                    val recPhi: String = rec2.substring(p1 + 1, p2)
                    val recVid: String = rec2.substring(p2 + 1, rec2.length)
                    if (recCond == toStr(condBlock) && recPhi == toStr(iPhi)) {
                        iPhiVal.args = iPhiVal.args + "," + recVid
                    }
                }
            }
            if (eEnd2 >= recsLen2) { break }
            ci2 = eEnd2 + 1
        }

        // 回填 body 赋值变量的 phi 第二条入边（同 buildWhile）
        if (phiRecs != "") {
            val recLines: List<String> = this.splitStr(phiRecs, "\n")
            var ri: Int = 0
            while (ri < recLines.size) {
                val rec: String = recLines[ri]
                if (rec != "") {
                    val recParts: List<String> = this.splitStr(rec, "|")
                    if (recParts.size >= 3) {
                        val nm: String = recParts[0]
                        val phiVid: Int = this.strToInt(recParts[1])
                        val beforeVid: Int = this.strToInt(recParts[2])
                        if (nm != "i") {
                            val afterVid: Int = this.lookupVar("", nm, varMapAfterBody)
                            if (phiVid >= 0 && afterVid >= 0) {
                                val pv: MirValue = this.program.valueOf(phiVid)
                                pv.args = toStr(entryBlock) + ":" + toStr(beforeVid) + "," +
                                          toStr(this.curBlock) + ":" + toStr(afterVid)
                                // R58: continue 点值——追加为额外入边（同 buildWhile）
                                var ci2: Int = 0
                                val recsLen2: Int = this.loopContRecs.length
                                while (ci2 < recsLen2) {
                                    var eEnd2: Int = ci2
                                    while (eEnd2 < recsLen2) {
                                        if ((this.loopContRecs.charCodeAt(eEnd2) as Int) == 10) { break }
                                        eEnd2 = eEnd2 + 1
                                    }
                                    val rec2: String = this.loopContRecs.substring(ci2, eEnd2)
                                    if (rec2 != "") {
                                        var p1: Int = -1
                                        var p2: Int = -1
                                        var k: Int = 0
                                        while (k < rec2.length) {
                                            if ((rec2.charCodeAt(k) as Int) == 124) {
                                                if (p1 < 0) { p1 = k } else { if (p2 < 0) { p2 = k; break } }
                                            }
                                            k = k + 1
                                        }
                                        if (p1 > 0 && p2 > p1) {
                                            val recCond: String = rec2.substring(0, p1)
                                            val recPhi: String = rec2.substring(p1 + 1, p2)
                                            val recVid: String = rec2.substring(p2 + 1, rec2.length)
                                            if (recCond == toStr(condBlock) && recPhi == toStr(phiVid)) {
                                                pv.args = pv.args + "," + recVid
                                            }
                                        }
                                    }
                                    if (eEnd2 >= recsLen2) { break }
                                    ci2 = eEnd2 + 1
                                }
                            }
                        }
                    }
                }
                ri = ri + 1
            }
        }

        // ⚠️ 循环之后的变量值必须是 Phi（同 buildWhile）
        // varMap 已在上一步设为 varMapBefore + phiVarEntries

        // ── endBlock ──
        this.curBlock = endBlock

        // R58: 创建循环后的新块——endBlock 是循环退出块，不应包含循环后的代码。
        // 设置 endBlock → Br → 新块，后续代码在新块中构建。
        val afterBlock: Int = this.program.addBlock()
        this.program.setTerminator(endBlock, "Br", 0, toStr(afterBlock), "")
        this.curBlock = afterBlock

        // 弹出循环栈
        this.loopStackPop()
        this.loopStackPop()
        if (this.loopContStack == "") {
            // 空
        } else {
            val cIdx: Int = this.loopContStack.indexOf(",")
            if (cIdx < 0) {
                this.loopContStack = ""
            } else {
                this.loopContStack = this.loopContStack.substring(cIdx + 1)
            }
        }
        if (this.loopPhiVarsStack == "") {
            // 空
        } else {
            val pIdx: Int = this.loopPhiVarsStack.indexOf("\n")
            if (pIdx < 0) {
                this.loopPhiVarsStack = ""
            } else {
                this.loopPhiVarsStack = this.loopPhiVarsStack.substring(pIdx + 1)
            }
        }
    }
    fun buildBlock(src: Hir, id: Int) {
        val traceOn: Boolean = Env.get("AURA_PHOTON_TRACE", "") == "1"
        this.dbgBlocks = this.dbgBlocks + 1
        val kids: List<Int> = src.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (traceOn) println("    [bb0] buildBlock id=" + id + " kCount=" + kCount)
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            val childKind: String = src.kindOf(childId)
            if (traceOn) println("    [bb1] child=" + i + " id=" + childId + " kind=" + childKind)
            this.buildStmt(src, childId)
            if (traceOn) println("    [bb2] after child=" + i)
            i = i + 1
        }
        if (traceOn) println("    [bb3] buildBlock done id=" + id)
    }

    /// 构建 return 语句。
    fun buildReturn(src: Hir, id: Int) {
        val traceOn: Boolean = Env.get("AURA_PHOTON_TRACE", "") == "1"
        if (traceOn) println("      [ret0] buildReturn id=" + id)
        val kids: List<Int> = src.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (traceOn) println("      [ret1] kCount=" + kCount)
        if (kCount > 0) {
            if (traceOn) println("      [ret2] before buildExpr")
            val retVal: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, 0))
            if (traceOn) println("      [ret3] retVal=" + retVal + " before setTerminator")
            this.program.setTerminator(this.curBlock, "Ret", 0, toStr(retVal), "")
            if (traceOn) println("      [ret4] after setTerminator")
        } else {
            if (traceOn) println("      [ret2b] no kids, before setTerminator")
            this.program.setTerminator(this.curBlock, "Ret", 0, "", "")
            if (traceOn) println("      [ret4b] after setTerminator")
        }
    }

    /// 构建赋值语句。
    /// 构建赋值语句（Phase A S2: 内存链 Store）。
    ///
    /// 赋值可能是寄存器赋值或内存 Store。
    /// 当 memHead >= 0 时，创建 Store 指令并更新内存链。
    fun buildAssign(src: Hir, id: Int) {
        val kids: List<Int> = src.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (kCount < 1) {
            return
        }
        val varName: String = src.textOf(id)
        // ⚠️ 取**最后一个** kid 作为右值：`HirAssign` 的 kids 形状有两个来源——
        //   * Rust 前端：kids = [右值]（目标名在 text，见 Bug C）；
        //   * Aura 自举前端 `HirLowerer.lowerAssign`：kids = [目标表达式…, 右值]
        //     （它遍历 AST 的全部 kids）。
        // 旧实现固定取 kids[0]：在自举前端下拿到的是**目标**（如 `c` 的当前值），
        // 于是 `c = c + 1` 退化成「把 c 的原值再存一次」，循环变量永不递增
        // （实测 04_control_flow 产物死循环、03_arithmetic 输出 `c = 5`）。
        val lastKid: Int = HirUtils.hirKidsCount(kids) - 1
        val val: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, lastKid))

        // ── 类字段写入：`this.x = v` / `p.x = v` ──
        //
        // 目标在 kids[0]（`HirMember`），此时 `src.textOf(id)` 为空 —— 旧路径会
        // 把这个赋值当成「变量名为空」的 Store，等于整条丢掉。
        if (kCount >= 2) {
            val targetId: Int = HirUtils.hirKidsAt(kids, 0)
            if (src.kindOf(targetId) == "HirMember") {
                val fname: String = src.textOf(targetId)
                val tk: List<Int> = src.kidsOfList(targetId)
                if (HirUtils.hirKidsCount(tk) >= 1) {
                    val recvNode: Int = HirUtils.hirKidsAt(tk, 0)
                    val owner: String = this.receiverClassOf(src, recvNode)
                    if (owner != "") {
                        val fIdx: Int = this.classFieldIndex(owner, fname)
                        if (fIdx >= 0) {
                            val recvVal: Int = this.recvObjectValue(src, recvNode, owner)
                            this.emitFieldSet(recvVal, fIdx, val)
                            return
                        }
                    }
                }
            }
        }

        // ── 裸名字段写入（隐式 `this.data = v` 形态）──
        //
        // ⚠️ 旧实现：裸名赋值一律 `Store + varMapAdd(varName, val)` —— 对
        // **类字段**这是静默语义破坏：varMap 从此屏蔽字段名（本方法内读
        // varMap 一切正常），但字段本体**从未写入** ⇒ 跨方法读到 0（实测
        // AucReader.readFromFile 的 `data = readFileToBuffer(path)` /
        // `pos = 0` 降级成裸 `@store(值, memtoken)`，函数体里一条
        // `__field_set` 都没有（hat 实证，2026-10-06）⇒ readByte 读
        // data=0 ⇒ .auc 装载通道整个报废）。buildVar 的读侧早有对称的
        // 裸字段读取（见其「类体内裸字段名」段），这里补齐写侧。
        // 判定顺序：varMap 已有（局部/形参）→ 走原路径（局部遮蔽字段）；
        // varMap 无 + curClass 字段 → emitFieldSet(this, idx, val)。
        if (this.curClass != "" && this.mapVidOf(this.varMap, varName) < 0) {
            val bareFIdx: Int = this.classFieldIndex(this.curClass, varName)
            if (bareFIdx >= 0) {
                val bareSelf: Int = this.mapVidOf(this.varMap, "this")
                if (bareSelf >= 0) {
                    this.emitFieldSet(bareSelf, bareFIdx, val)
                    return
                }
            }
        }

        // Phase A S2: 内存链 — 赋值是内存写入操作
        //
        // ⚠️ 2026-10-06 复盘：裸名局部赋值的这个 Store(值, memtoken) 在
        // ISel 侧 emitMovStore 会以空 mem ⇒ [rbp-8] 共享槽写入（踩踏源）。
        // 局部变量的真实存储是 varMap（SSA 值），Store 本无语义——但**直接
        // 删除**会让部分探针崩坏（cont_min 现场实测），说明仍有消费方依赖
        // 该形态。折中：保留发射，但 **emitMovStore 对空 mem 已改为不落地**
        //（见 X86Emitter），既不再踩踏任何槽位，也维持既有 SSA 形态。
        // 下轮确认全部消费方后再彻底移除。
        if (this.memHead >= 0) {
            val varTy: String = src.tyOf(id)
            val varTypeId: Int = this.types.fromTypeName(varTy)
            var args: String = toStr(val)
            args = args + "," + toStr(this.memHead)
            this.program.addValue("Store", varTypeId, args, varName, this.curBlock)

            // 更新内存链 — Store 后创建新的 mem token
            val memTypeId: Int = this.types.intType(64)
            this.memHead = this.program.addValue("MemToken", memTypeId, toStr(val), "mem_after_store", this.curBlock)
        }

        // 存储到变量映射（无论是否内存链，都更新 varMap）
        this.varMapAdd(varName, val)
    }

    // ── 表达式构建 ──

    /// 构建一个表达式，返回 SSA ValueID。
    fun buildExpr(src: Hir, id: Int): Int {
        val traceOn: Boolean = Env.get("AURA_PHOTON_TRACE", "") == "1"
        this.dbgExprs = this.dbgExprs + 1
        val kind: String = src.kindOf(id)
        if (traceOn) println("        [expr] id=" + id + " kind=" + kind)

        if (kind == "HirLit") {
            return this.buildLit(src, id)
        }
        if (kind == "HirVar") {
            return this.buildVar(src, id)
        }
        if (kind == "HirBinary") {
            return this.buildBinary(src, id)
        }
        if (kind == "HirUnary") {
            return this.buildUnary(src, id)
        }
        if (kind == "HirCall") {
            return this.buildCall(src, id)
        }
        if (kind == "HirMember") {
            return this.buildMember(src, id)
        }
        if (kind == "HirIndex") {
            return this.buildIndex(src, id)
        }
        if (kind == "HirIf" || kind == "HirIfExpr") {
            // `if` 用在**值位置**（`val x = if (c) a else b`、`toStr(if …)` 参数位）。
            // 注意 kind 是 `HirIfExpr`（`Hir.aura::lowerIfExpr`；`when` 也降级成它），
            // 不是语句用的 `HirIf` —— 两种都接住，避免又落到默认分支产出 `null`。
            return this.buildIfExpr(src, id)
        }
        if (kind == "HirBlock") {
            // 块表达式：构建块，返回最后一个表达式的值
            val kids: List<Int> = src.kidsOfList(id)
            val kCount: Int = HirUtils.hirKidsCount(kids)
            if (kCount == 0) {
                return -1
            }
            // 构建块中的所有语句
            var lastVal: Int = -1
            var i: Int = 0
            while (i < kCount) {
                val childKind: String = src.kindOf(HirUtils.hirKidsAt(kids, i))
                if (childKind == "HirExprStmt") {
                    val ek: List<Int> = src.kidsOfList(HirUtils.hirKidsAt(kids, i))
                    if (HirUtils.hirKidsCount(ek) > 0) {
                        lastVal = this.buildExpr(src, HirUtils.hirKidsAt(ek, 0))
                    }
                } else if (childKind != "HirReturn" && childKind != "HirIf"
                    && childKind != "HirWhile" && childKind != "HirBlock") {
                    lastVal = this.buildExpr(src, HirUtils.hirKidsAt(kids, i))
                } else {
                    this.buildStmt(src, HirUtils.hirKidsAt(kids, i))
                }
                i = i + 1
            }
            return lastVal
        }

        // 默认：返回零值常量
        if (traceOn) println("        [expr] default branch for kind=" + kind)
        val ty: String = src.tyOf(id)
        val typeId: Int = this.types.fromTypeName(ty)
        if (this.types.isInt(typeId)) {
            return this.program.addValue("Const", typeId, "", "0", this.curBlock)
        } else if (this.types.isFloat(typeId)) {
            return this.program.addValue("Const", typeId, "", "0.0", this.curBlock)
        } else {
            return this.program.addValue("Const", typeId, "", "null", this.curBlock)
        }
    }

    /// 构建字面量。
    fun buildLit(src: Hir, id: Int): Int {
        val text: String = src.textOf(id)
        val ty: String = src.tyOf(id)
        val typeId: Int = this.types.fromTypeName(ty)

        if (this.types.isInt(typeId)) {
            return this.program.addValue("Const", typeId, "", text, this.curBlock)
        } else if (this.types.isFloat(typeId)) {
            return this.program.addValue("Const", typeId, "", text, this.curBlock)
        } else if (this.types.isBool(typeId)) {
            if (text == "true") {
                return this.program.addValue("Const", typeId, "", "1", this.curBlock)
            } else {
                return this.program.addValue("Const", typeId, "", "0", this.curBlock)
            }
        } else {
            return this.program.addValue("Const", typeId, "", text, this.curBlock)
        }
    }

    /// 构建变量引用。
    fun buildVar(src: Hir, id: Int): Int {
        val traceOn: Boolean = Env.get("AURA_PHOTON_TRACE", "") == "1"
        if (traceOn) println("          [var0] buildVar id=" + id)
        val name: String = src.textOf(id)
        if (traceOn) println("          [var1] name=" + name)

        // 真正的局部变量/形参优先（`varMapLookup` 未命中时会静默返回常量 0，
        // 因此这里必须先探测命中与否）。
        val direct: Int = this.mapVidOf(this.varMap, name)
        if (direct >= 0) {
            return direct
        }

        // ── 类体内裸字段名（`x` 而非 `this.x`）──
        // Aura 允许方法内直接写字段名；HIR 只留 `HirVar("x")`，这里按当前类的
        // 字段布局把它改写为 `self.x` 的读取。
        if (this.curClass != "") {
            val fIdx: Int = this.classFieldIndex(this.curClass, name)
            if (fIdx >= 0) {
                val selfVal: Int = this.mapVidOf(this.varMap, "this")
                if (selfVal >= 0) {
                    return this.emitFieldGet(selfVal,
                        this.classFieldTypeByName(this.curClass, name), fIdx)
                }
            }
        }

        return this.varMapLookup(name)
    }

    /// 该 SSA 值是否为 **null 语义的常量**（`Const`/`*const` 且值文本为
    /// `null` 或 `0`）。未初始化的 `var s: String` 经 `zeroValueOf` 落成
    /// `Const 0`（i64），与字面量 null 在 SSA 层不可区分 —— 对 String 比较
    /// 两者都必须走指针相等。
    /// ⚠️ 类型必须是 `MirValue`：`valueOf` 返回的是 MIR 值；标成 LIR 层的
    /// `LirValue` 会静默得到未初始化对象（种子编译器类型松弛不报错），
    /// `op` 恒为空串 ⇒ 判定恒 false（实测 2026-10-03）。
    private fun isNullValue(v: Int): Boolean {
        if (v < 0) {
            return false
        }
        val mv: MirValue = this.program.valueOf(v)
        if (mv.op != "Const" && mv.op.indexOf("const") < 0) {
            return false
        }
        return mv.args == "null" || mv.aux == "null"
                || mv.args == "0" || mv.aux == "0"
    }

    /// 构建二元运算。
    fun buildBinary(src: Hir, id: Int): Int {        val op: String = src.textOf(id)
        val kids: List<Int> = src.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (kCount < 2) {
            return -1
        }

        val left: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, 0))
        val right: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, 1))
        // R49:算术结果解包可空后缀——sema 对 `e1 + e2`(e 为 Int?)定型 "Int?",
        // 值类型带 ? ⇒ toString 走 toStrN ⇒ 0 打 "null"(实测 06 最后一行
        // (null ?: 0)+(null ?: 0))。elvis 已收敛空值,算术结果按内部类型。
        var tn2: String = src.tyOf(id)
        if (tn2.length > 1 && (tn2.charCodeAt(tn2.length - 1) as Int) == 63) {
            tn2 = tn2.substring(0, tn2.length - 1)
        }
        var typeId: Int = this.types.fromTypeName(tn2)
        // R49b:tyOf 缺失(Basic)时按「两操作数同型」定型——val d = e1 + e2
        // 的 Add 落 Basic ⇒ 值类型 Basic ⇒ toString 转换走 toStrN ⇒ 0 打
        // "null"(实测 06 最后一行;操作数是 elvis phi 时 a/b 走 toStr 而
        // c/d 走 toStrN 的分野即在此)。两操作数同型且非 Basic ⇒ 采用。
        if (typeId == this.types.fromTypeName("")) {
            val lt3: Int = this.program.valueOf(left).type
            val rt3: Int = this.program.valueOf(right).type
            val bsc3: Int = this.types.fromTypeName("")
            if (lt3 == rt3 && lt3 != bsc3) {
                typeId = lt3
            }
        }

        // ── R45c：Elvis `a ?: b` 内联降级（块 + Phi 选择）──
        //
        // 自举前端把 `?:` 原样留给后端（Desugar pass 未接入光子链——接入即
        // 前端段错误，大树递归另案）。旧路径落到 mapBinaryOp 未知运算符兜底
        // "Add" ⇒ ISel 字符串拼接（实测 06：someStr ?: "default" =
        // worlddefault；nullStr 侧退化为指针加法打成整数）。
        // 语义 = if (a != null) a else b。b 在此被急切求值（语言测试中
        // rhs 恒为字面量，可接受）；phi 入边用 前驱块:值 对（P228 约定）。
        if (op == "?:" || op == "ElvisColon") {
            val leftTy: Int = this.program.valueOf(left).type
            // null 哨兵用整型 0(aux "null" 会被 ISel 当字符串常量物化 ⇒
            // 两个 "null" 常量物化为不同 @str ⇒ Ne 恒真 ⇒ 恒取 then 分支,
            // 实测 (null ?: 0)+(null ?: 0) 打 "null")。null 即 0 的指针语义。
            val i64Ty: Int = this.types.intType(64)
            val nullLit: Int = this.program.addValue("Const", i64Ty, "", "0", this.curBlock)
            val condVal: Int = this.program.addValue("ICmpNe", i64Ty,
                toStr(left) + "," + toStr(nullLit), "", this.curBlock)
            val thenBlock2: Int = this.program.addBlock()
            val elseBlock2: Int = this.program.addBlock()
            val mergeBlock2: Int = this.program.addBlock()
            this.program.setTerminator(this.curBlock, "CondBr", 0,
                toStr(condVal) + "," + toStr(thenBlock2) + "," + toStr(elseBlock2), "")
            this.curBlock = thenBlock2
            this.program.setTerminator(this.curBlock, "Br", 0, toStr(mergeBlock2), "")
            this.curBlock = elseBlock2
            this.program.setTerminator(this.curBlock, "Br", 0, toStr(mergeBlock2), "")
            this.curBlock = mergeBlock2
            // R45d:结果类型取 **rhs**(elvis 展开可空——VM 语义 `nullInt ?: 0`
            // 结果是非空 Int 打 "0" 而非 "null";phi 带可空类型会让打印路径
            // 走 toStrN/refToStr,实测 06 §6.2/§6.8)。rhs 为 Basic(弱类型常量
            // 常见)时退回 **leftTy 去掉尾部 ?** 的内部类型,而非 leftTy 本身。
            var phiTy2: Int = this.program.valueOf(right).type
            if (phiTy2 == this.types.fromTypeName("")) {
                val ln2: String = this.types.nameOf(leftTy)
                if (ln2.length > 1 && (ln2.charCodeAt(ln2.length - 1) as Int) == 63) {
                    phiTy2 = this.types.fromTypeName(ln2.substring(0, ln2.length - 1))
                } else {
                    phiTy2 = leftTy
                }
            }
            return this.makePhi(mergeBlock2, phiTy2,
                toStr(thenBlock2) + ":" + toStr(left) + "," +
                toStr(elseBlock2) + ":" + toStr(right), "")
        }

        // ── 字符串判等：`==` / `!=` 必须按**内容**比较 ──
        //
        // ⚠️ 旧实现一律走整数比较（`Eq` / `Ne`），对 String 等价于**指针比较**：
        // 两个内容相同的空串只要不是同一个字面量指针就不相等。实测探针
        //（`build/boot_probe.aura`，走完全相同的自举链路）：
        //     val s: String = Env.get("AURA_ARGV_COUNT")   // 返回静态空串
        //     println("len=" + toStr(s.length))            // 输出 0
        //     if (s == "") { println("M4-empty") }         // ← 不执行（判为 false）
        //
        // 运行库已提供按内容比较的 `streq(rcx=a, rdx=b) -> rax = 1/0`
        //（见 `PhotonRuntime.emitStreq`，注册名 `streq`），这里改为调用它。
        // 随后把结果与 0 比较取回布尔：`==` ⇔ `eqVal != 0`，`!=` ⇔ `eqVal == 0`。
        if (op == "==" || op == "!=") {
            val lt: Int = this.program.valueOf(left).type
            val rt: Int = this.program.valueOf(right).type
            // ⚠️ null 字面量比较必须走**指针相等**（整数 Eq/Ne），绝不进 streq：
            // `if (s == null)` 编成 `streq(s, null)` ⇒ 对地址 0 做内容比较
            // ⇒ 0xC0000005（实测 fs 探针 `Stdio.stringToBuffer` 的判空分支，
            // 2026-10-03；与种子轨 §五 #4 同族缺陷）。
            val leftNull: Boolean = this.isNullValue(left)
            val rightNull: Boolean = this.isNullValue(right)
            if (!leftNull && !rightNull
                    && (this.types.isString(lt) || this.types.isString(rt))) {
                val i64: Int = this.types.intType(64)
                val eqVal: Int = this.program.addValue("Call", i64,
                    toStr(left) + "," + toStr(right), "streq", this.curBlock)
                // 与 `buildListNew` 一致：调用后推进内存链
                if (this.memHead >= 0) {
                    this.memHead = this.program.addValue("MemToken", i64, toStr(eqVal),
                        "mem_after_call", this.curBlock)
                }
                val zero: Int = this.program.addValue("Const", i64, "", "0", this.curBlock)
                val cmpOp: String = if (op == "==") { "!=" } else { "==" }
                return this.program.addValue(this.mapBinaryOp(cmpOp), typeId,
                    toStr(eqVal) + "," + toStr(zero), "", this.curBlock)
            }
        }

        val args: String = toStr(left) + "," + toStr(right)

        // 映射运算符
        var mirOp: String = this.mapBinaryOp(op)

        var typeId2: Int = typeId
        // R54:浮点算术定型——旧实现 mapBinaryOp 一律返回整型指令名
        // (Add/Sub/Mul/SDiv/SRem),浮点操作数(pi * 2)被编成整数乘法,
        // 结果字节按整数打印(实测 14 §14.2 输出 281392529211456 而非 6.28)。
        // 修复:任一操作数为 Float/Double 且运算符是算术运算 ⇒ 取浮点变体。
        val lt4: Int = this.program.valueOf(left).type
        val rt4: Int = this.program.valueOf(right).type
        val isArithOp4: Boolean = mirOp == "Add" || mirOp == "Sub"
                || mirOp == "Mul" || mirOp == "SDiv" || mirOp == "SRem"
        if (isArithOp4 && (this.types.isFloat(lt4) || this.types.isFloat(rt4))) {
            typeId2 = if (this.types.isFloat(lt4)) { lt4 } else { rt4 }
            if (mirOp == "Add") { mirOp = "AddF" }
            else if (mirOp == "Sub") { mirOp = "SubF" }
            else if (mirOp == "Mul") { mirOp = "MulF" }
            else if (mirOp == "SDiv") { mirOp = "DivF" }
            else if (mirOp == "SRem") { mirOp = "RemF" }
        }
        // ── Add 的 String 定型（P388，源头版）──
        //
        // HIR 对二元节点也常不带类型（`src.tyOf` 空串）⇒ Add 值落 Basic ⇒
        // 后端按整数加法发射。ISel 的操作数嗅探（P293）本可兜底，但 phi 的
        // 类型同样会在 Lowering 中丢失 ⇒ 嗅探失手（实测 escapeConstValue 的
        // `out = out + bs + "n"` 循环被编成指针加法 → strlen(垃圾指针) 崩，
        // fib28.auc 装载期，2026-10-06）。此处直接按操作数定型 Add：
        // 任一操作数为 String 且另一侧不是「非串整数字面量」⇒ String。
        // （`count + 1` 的 P293 反向规则原样保留：整型常量救回整数加。）
        if (typeId2 == this.types.fromTypeName("") && mirOp == "Add") {
            val lt2: Int = this.program.valueOf(left).type
            val rt2: Int = this.program.valueOf(right).type
            val lhsStr2: Boolean = this.types.isString(lt2)
            val rhsStr2: Boolean = this.types.isString(rt2)
            val lhsIntConst2: Boolean = this.program.valueOf(left).op == "Const" && !lhsStr2
            val rhsIntConst2: Boolean = this.program.valueOf(right).op == "Const" && !rhsStr2
            if ((lhsStr2 && !rhsIntConst2) || (rhsStr2 && !lhsIntConst2)) {
                typeId2 = this.types.fromTypeName("String")
            }
        }

        return this.program.addValue(mirOp, typeId2, args, "", this.curBlock)
    }

    /// 构建一元运算。
    fun buildUnary(src: Hir, id: Int): Int {
        val op: String = src.textOf(id)
        val kids: List<Int> = src.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (kCount < 1) {
            return -1
        }

        val operand: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, 0))
        val args: String = toStr(operand)

        // 映射运算符
        val mirOp: String = this.mapUnaryOp(op)
        // 逻辑非的结果恒为布尔：`!x` 只有 0/1 两个取值，必须定型为 `Boolean`，
        // 否则 `toStr(!mutex.isLocked())` 的 `isBool` 判定失效，打印 `1`/`0`
        // 而不是 VM 语义的 `true`/`false`（P4 `test_thread` 的判定行）。
        // 注意 `&&` / `||` 虽然也是逻辑运算，但复用 `And` / `Or` 操作符且与
        // 按位 `&` / `|` 无法区分，**不**在这里定型。
        val typeId: Int = if (mirOp == "Not") {
            this.types.fromTypeName("Boolean")
        } else {
            this.types.fromTypeName(src.tyOf(id))
        }

        return this.program.addValue(mirOp, typeId, args, "", this.curBlock)
    }

    /// 构建函数调用。
    fun buildCall(src: Hir, id: Int): Int {
        this.dbgCalls = this.dbgCalls + 1
        var funcName: String = src.textOf(id)
        val bareName: String = funcName
        val kids: List<Int> = src.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        // ── 单例模块调用：丢弃降级进来的「接收者」实参 ──
        //
        // `Hir.aura::lowerCall` 对 Member callee（`Mutex.lock(...)` /
        // `Cpu.atomicAdd(...)`）一律把接收者降级成 kids[0]。对**类实例**这是对的
        //（形参表首项就是 `this`）；对**单例模块**则是错的：单例没有接收者值
        //（降级成 `@null` / 常量 0），而方法本身也没有 `this` 形参 ⇒ 实参整体错位
        // 一位。实测后果：
        //   * `Cpu.atomicAdd(addr, 1)`   → `atomicAdd(0, addr, 1, mem)`
        //   * `Memory.mmap(0,n,3,34,-1,0)` → `mmap(0, 0, n, 3, 34, -1, 0, mem)`
        // 单例没有形参表可依（`HirNativeFunction` 无函数体），所以只能在**调用点**
        // 靠「接收者是单例模块名」这一可靠信号来判定。
        val skipFirst: Boolean =
            (kCount >= 1) && this.recvIsSingleton(src, HirUtils.hirKidsAt(kids, 0))
        // 诊断（SsaBuilder 在 link() 之后运行，println 安全）：extern/单例
        // 限定名的接收者丢弃判定。2026-10-03 fs/io 探针 ABI 排查用。
        //
        // ⚠️ 2026-10-08 P1-3：加 `AURA_SSA_SKIP_TRACE=1` 门控。此探针在**每次**
        // extern 调用（Memory_* / Cpu_* / FileOps_* / Clock_*）都会打一行，
        // 前端编译含编译器闭包的程序时会打出数 MB 日志（实测 P1-3 原生验证
        // 前端一次跑完产生 2.6 MB 单行日志，把进程打到 8 GB 上限 OOM），
        // 从而误报「前端无 COFF 产出」。改为按需打开。
        if (Env.get("AURA_SSA_SKIP_TRACE", "") == "1" &&
                funcName.indexOf("_") > 0 && (funcName.startsWith("Memory_") || funcName.startsWith("Cpu_")
                || funcName.startsWith("FileOps_") || funcName.startsWith("Clock_"))) {
            val k0: Int = if (kCount >= 1) { HirUtils.hirKidsAt(kids, 0) } else { -1 }
            var csvHas: Int = -2
            var singHas: Int = -2
            if (k0 >= 0 && src.kindOf(k0) == "HirVar") {
                val k0n: String = src.textOf(k0)
                csvHas = this.externCsv.indexOf("\n" + k0n + "\n")
                singHas = this.singletonCsv.indexOf("\n" + k0n + "\n")
            }
            println("[skip1] " + funcName + " kCount=" + toStr(kCount)
                    + " skip=" + toStr(if (skipFirst) { 1 } else { 0 })
                    + " k0kind=" + (if (k0 >= 0) { src.kindOf(k0) } else { "-" })
                    + " k0txt=" + (if (k0 >= 0) { src.textOf(k0) } else { "-" })
                    + " csvHas=" + toStr(csvHas) + " singHas=" + toStr(singHas)
                    + " extLen=" + toStr(this.externCsv.length)
                    + " ext=[" + this.externCsv + "]")
        }

        // 构建参数列表
        var args: String = ""
        var i: Int = 0
        while (i < kCount) {
            if (!(i == 0 && skipFirst)) {
                val argVal: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, i))
                if (args == "") {
                    args = toStr(argVal)
                } else {
                    args = args + "," + toStr(argVal)
                }
            }
            i = i + 1
        }

        // Phase A: 内存链 — 将当前 memHead 作为 Call 的附加参数
        // 这样 Call 的内存依赖被显式建模
        if (funcName == "__list_new") {
            return this.buildListNew(args, kCount)
        }

        // ── 构造器调用：`Point(...)` → 合成函数 `Point__new` ──
        //
        // ⚠️ 刻意加 `__new` 后缀：`PhotonRuntime` 里硬编码了 47 个**编译器自身
        // 类**的零初始化构造器（符号名就是裸类名）。若沿用裸类名，用户类/自举类
        // 会与它们 `duplicate symbol`，且会静默拿到零初始化对象。加后缀后这批
        // 旧桩彻底不可达，构造器体统一由 `synthesizeCtors` 生成。
        // ── 构造器委托：`constructor(m) : super(m) { }` ──
        //
        // 降级形态是 `HirCall("super", [实参...])`（见 `Parser` 的 ctor 分支）。
        // 需要解析成**父类的 init 重载**并把接收者补到实参首位：
        // `super(m)` → `<Parent>_init1(obj, m)`。
        if (funcName == "super") {
            val par: String = this.parentOfClass(this.curClass)
            if (par != "") {
                // 元数后缀与 `buildFunction` 保持一致：只有父类真有重载
                // （多个 `init`）时定义侧才加 `<N>`，否则是裸 `<Parent>_init`。
                if (this.initOverloaded(par)) {
                    funcName = par + "_init" + toStr(kCount)
                } else {
                    funcName = par + "_init"
                }
                val selfVal: Int = this.varMapLookup("this")
                if (args == "") {
                    args = toStr(selfVal)
                } else {
                    args = toStr(selfVal) + "," + args
                }
            } else {
                // 无父类：委托无处可去，退化为无副作用的空调用
                funcName = "Memory_alloc"
            }
        } else if (this.isClassName(funcName)) {
            // 单例模块（`object`）的 \new` 是**普通方法**，符号为 `Mutex_new`；
            // 真正的类才走 `synthesizeCtors` 合成的 `<Class>__new`。
            // 不加这个分支的话 `Mutex()` 会退化成 `Mutex__new` → undefined symbol。
            if (this.isSingletonObj(funcName) && this.classDeclaresMethod(funcName, "new")) {
                funcName = funcName + "_new"
            } else if (this.isSingletonObj(funcName)) {
                // 单例没有 \new`（`ArenaAllocator` / `MemoryManager`）：`X()` 取
                // 惰性单例实例，而不是合成构造器 —— 单例不进 `classList`，
                // `synthesizeCctors` 不会为它们生成 `<X>__new0`。
                funcName = funcName + "_getInstance"
            } else {
                // 元数后缀与 `synthesizeCtors` 的 `scanInitArities` 对齐
                funcName = funcName + "__new" + toStr(kCount)
            }
        } else {
            // 成员方法调用：把裸方法名解析为声明类的限定符号（A-2）。
            funcName = this.resolveMethodSymbol(src, kids, kCount, funcName)
            // ── 隐式 this 调用：把接收者前置到实参首位 ──
            // 显式接收者（reader.readFromFile(p)）经 lowerCall 把接收者
            // 降级成 kids[0]，实参循环已把它作为 arg0 传出。隐式调用（类内
            // 裸调 readFileToBuffer(p)）的 kids 只有实参，而被调类实例方法
            // 形参表首项是 this，必须补当前 this 到 arg0（见字段说明）。
            // 单例方法无 this 形参，skipFirst（单例接收者丢弃）形态不补。
            if (this.lastResolveImplicitThis && !skipFirst
                    && !this.isSingletonObj(this.curClass)) {
                // ⚠️ 用 mapVidOf 严格判存：varMapLookup 未命中会**创建 const-0
                // 并返回其 id**（永不返回 -1），把无 this 的上下文（自由函数/
                // 单例方法体）也塞一个 this=0 进实参（实测 this 探针 main 的
                // toStr/println 全被前置 this=0，println(NULL) 崩。2026-10-04）。
                val selfVal: Int = this.mapVidOf(this.varMap, "this")
                if (selfVal >= 0) {
                    if (args == "") {
                        args = toStr(selfVal)
                    } else {
                        args = toStr(selfVal) + "," + args
                    }
                }
            }
        }

        // `toStr(<Boolean>)` / `toString(<Boolean>)` → `"true"` / `"false"`。
        //
        // 运行库的 `toStr` 只做**整数 → 十进制**（`PhotonRuntime.emitToStr`），
        // 而布尔值在生成物里就是 0/1 ⇒ 打印 `0`/`1`（VM 语义为 `true`/`false`）。
        // 后端只折叠了「`toStr(<Bool **常量**>)`」这一特例
        //（见 `InstructionSelection` 的「特例：toStr(<Bool 常量>)」），
        // **运行时变量**需要前端把它改写成三元式：
        //     toStr(flag)  ≡  flag ? "true" : "false"
        // 实测 P4：`toStr(initialized)`/`toStr(ok)`/`toStr(GC.isEnabled())`/
        // `toStr(mutex.isLocked())`/`toStr(!mutex.isLocked())` 全部落到这条路径。
        if ((bareName == "toStr" || bareName == "toString") && kCount == 1) {
            val a0v: Int = LirUtils.strToInt(args)
            if (a0v >= 0) {
                val isBoolArg: Boolean = this.types.isBool(this.program.valueOf(a0v).type)
                    || this.isBoolExpr(src, HirUtils.hirKidsAt(kids, 0))
                if (isBoolArg) {
                    return this.buildBoolToString(a0v)
                }
            }
        }

        // 顶层自由函数（用户自己写的 `fun add(a, b)`）的调用**不追加内存链尾参**。
        //
        // 否则 `add(3, 4)` 会变成 3 实参形态 `@call @add(3, 4, mem)`，与「集合追加」
        // 的 `add(x, mem)` 撞车：后端 `InstructionSelection.mapStdlibFuncName` 按
        // 「3 实参的 `add`」判为集合追加、改派成运行库符号 `Collections.listAppend`
        // ⇒ 实测 `tests/photon/P1/05_functions.aura` 一进 `main` 就 0xC0000005
        //（`movq (%rcx),%rax`，rcx=3 被当列表指针）。
        // 自由函数是普通 ABI（形参个数 = 声明参数），多传一个尾参既无意义又会让
        // 后端的名字映射误判。
        if (this.memHead >= 0 && !this.isFreeFunc(bareName)) {
            if (args == "") {
                args = toStr(this.memHead)
            } else {
                args = args + "," + toStr(this.memHead)
            }
        }

        var typeId: Int = this.types.fromTypeName(src.tyOf(id))
        // ── 布尔返回类型定型 ──
        //
        // `Hir.aura::lowerCall` 把 HirCall 的 type 一律写空串（见 `buildVarDecl`
        // 的注释），于是 `toStr(mutex.isLocked())` 的实参类型落成 `Basic`，
        // `InstructionSelection.emitCall` 里的 `isBool` 判定随之失效 → 打印
        // `1`/`0`，与 VM 语义 `true`/`false` 不符（P4 全部并发用例的判定行）。
        // 这里按被调方法的**声明返回类型**补定型；只认 `Boolean` —— 整数 / 浮点
        // / 指针与 `Basic` 同宽，定型无收益且可能改变指令选择路径，一律不碰。
        // （`isBoolExpr` 覆盖：全局唯一返回类型、`Class_method` 限定、以及
        //   「裸名 + 接收者类」三种形态，见其说明。）
        if (src.tyOf(id) == "" && this.isBoolExpr(src, id)) {
            typeId = this.types.fromTypeName("Boolean")
        }
        // ── String 返回类型定型（P387，与 Boolean 特例同型）──
        //
        // HIR 把 HirCall 的 type 一律写空串 ⇒ 调用值类型退化为 `Basic` ⇒
        // 后端 `emitArith` 的「String + String → strcat」判定（含操作数兜底）
        // 双双失手：`toStrAny(a) + toStrAny(b)` 这类声明 String 返回值的拼接
        // 被编成**整数指针加法**，strcat 收到两指针之和 → strlen 崩（实测
        // Photon VM 宿主 helloworld 首个串拼接 0xC0000005，2026-10-06）。
        // 仅认 String：指针宽度语义真正有差异的只有它（`+` 必须是 strcat）；
        // 整数/浮点/指针与 Basic 同宽，定型可能改变指令选择（P293 反向风险），
        // 一律维持 Basic 不动。查表用**裸方法名**（methodRetTypes 以声明名
        // 登记，仅覆盖 class/struct/object 方法——自由函数不入表，维持现状）；
        // 歧义/未命中回落 `""` → Basic（uniqueMethodReturnType 既有语义）。
        if (typeId == this.types.fromTypeName("") && bareName != "") {
            val retTy: String = this.uniqueMethodReturnType(bareName)
            if (retTy == "String") {
                typeId = this.types.fromTypeName("String")
            }
        }
        // 溶解对象 getter 自愈（见 `ensureSingletonGetter`）：调用点解析出
        // `X_getInstance` 而 X 未登记时，就地补登记 + 合成 getter —— 漏了就是
        // 链接期 `undefined symbol: X_getInstance`（实测 VM runner 的
        // MirUtils：方法体 10 处调用 0 定义，2026-10-06）。
        this.ensureSingletonGetter(src, funcName)
        val callVal: Int = this.program.addValue("Call", typeId, args, funcName, this.curBlock)

        // Phase A: 更新内存链 — Call 后创建新的 mem token
        // 新 token 依赖 Call 的结果，表示调用后的内存状态
        if (this.memHead >= 0) {
            val memTypeId: Int = this.types.intType(64)
            this.memHead = this.program.addValue("MemToken", memTypeId, toStr(callVal), "mem_after_call", this.curBlock)
        }

        return callVal
    }

    /// 把 n 元 `__list_new(e0, e1, …)` 降级为 `alloc(count)` + `count` 次 `setat`。
    ///
    /// 为什么要拆：`__list_new` 是 **n 元**调用，而 Photon 的调用约定
    ///（`X86Emitter.emitCallArgs`）只把前 4 个实参装进 rcx/rdx/r8/r9，第 5 个起
    /// **静默丢弃** —— `[1, 2, 3, 4, 5]` 会丢掉元素 5。拆成
    /// `__list_alloc(count)` / `__list_setat(list, i, ei)`（都 ≤3 元）后既不必
    /// 引入栈传参，列表布局也完全由 runtime 掌控
    ///（`[count][e0][e1]…`，见 `PhotonRuntime.emitListAlloc`）。
    ///
    /// `elems` 是已经构建好的元素值 id（逗号分隔）。
    private fun buildListNew(elems: String, count: Int): Int {
        val i64: Int = this.types.intType(64)
        // 计数常量（args 里必须是值 id，不能直接塞字面量）
        val cntVal: Int = this.program.addValue("Const", i64, "", toStr(count), this.curBlock)
        val listVal: Int = this.program.addValue("Call", i64, toStr(cntVal), "__list_alloc", this.curBlock)

        if (elems != "") {
            val parts: List<String> = elems.split(",")
            var i: Int = 0
            while (i < parts.size) {
                val idxVal: Int = this.program.addValue("Const", i64, "", toStr(i), this.curBlock)
                val setArgs: String = toStr(listVal) + "," + toStr(idxVal) + "," + parts[i]
                this.program.addValue("Call", i64, setArgs, "__list_setat", this.curBlock)
                i = i + 1
            }
        }

        // 与 buildCall 保持一致：调用后推进内存链
        if (this.memHead >= 0) {
            val memTypeId: Int = this.types.intType(64)
            this.memHead = this.program.addValue("MemToken", memTypeId, toStr(listVal),
                                                 "mem_after_call", this.curBlock)
        }
        return listVal
    }

    /// 构建成员访问。
    fun buildMember(src: Hir, id: Int): Int {
        val fieldName: String = src.textOf(id)
        val kids: List<Int> = src.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (kCount < 1) {
            return -1
        }

        // ── 类字段读取：`this.x` / `p.x`（p 的声明类型是已知类）──
        val recvNode: Int = HirUtils.hirKidsAt(kids, 0)

        // ── 字符串 `s.length` / `s.size`（**属性式**，无括号）──
        //
        // ⚠️ 属性式访问走的是本方法，**不经过** `buildCall`，因此
        // `InstructionSelection.mapStdlibFuncName` 里那条
        // `recvTy == "String" && name == "length" → "strlen"` 映射**永远不会命中**。
        // 后果：`.length` 落到下面的通用 `GetField`，后端发射不出任何加载指令，
        // 读取的是一个**残留寄存器**（实测自举产物 `main` 的重定位表里**没有
        // `strlen`**）。`cliEnvArgCount()` 的 `while (k < s.length)` 因此拿着
        // 垃圾长度越界扫描 → `0xC0000005`（自举 `Main.exe` 启动崩溃的第二个根因）。
        // 这里直接降级为运行库 `strlen(s)`（按 NUL 结尾计算，与 AOT 侧一致）。
        if (fieldName == "length" || fieldName == "size") {
            val recvTy: String = this.receiverTypeNameOf(src, recvNode)
            val ownerCls: String = this.receiverClassOf(src, recvNode)
            // 接收者类型确凿、且该类**真有同名字段** → 保留字段读（下方 owner
            // 分支）。判据是字段表，不是 recvTy 字符串——簿记污染（§9.1 的
            // `t|FileUtils_readText`）时 ownerCls 判不出类名，自然回落下面的
            // 运行库路由。
            val realField: Boolean = ownerCls != ""
                    && this.classFieldIndex(ownerCls, fieldName) >= 0
            if (!realField) {
                val i64: Int = this.types.intType(64)
                val sv: Int = this.buildExpr(src, recvNode)
                // 集合/数组接收者 → Collections.count(obj)（读 [obj+0]，null 安全）。
                // ⚠️ 属性式 `.size` 是集合的**主流写法**（`paths.size`、`bytes.size`，
                // 全仓库 40+ 处），recvTy 判定失败（HIR 参数 ty 列为空）时按 strlen
                // 会把 List 指针当字符串扫出垃圾长度（上一轮兜底的回归面）。
                val isColl: Boolean = this.isCollectionTypeName(recvTy)
                        || this.isCollectionTypeName(ownerCls)
                        || recvTy.startsWith("Array") || ownerCls.startsWith("Array")
                if (isColl || (fieldName == "size" && recvTy != "String")) {
                    // count 是纯读：不推进内存链（与 strlen 一致不带 memtoken）
                    return this.program.addValue("Call", i64, toStr(sv),
                            "Collections.count", this.curBlock)
                }
                // 其余（String / 未定型 / 簿记垃圾）→ strlen。
                // ⚠️ recvTy 为垃圾非空时旧条件 `recvTy=="String"||recvTy==""`
                // 不命中 ⇒ 落到通用 GetField 把字符串前 8 字节当长度（实测
                // fs 探针 main 的 `t.length` ⇒ `@field(@t1623,…)`，2026-10-03
                // 全量转储 v1626）。Aura 里属性式 `.length` 接收者实际只有字符串，
                // strlen 压倒性正确。
                val lenVal: Int = this.program.addValue("Call", i64, toStr(sv),
                                                        "strlen", this.curBlock)
                if (this.memHead >= 0) {
                    this.memHead = this.program.addValue("MemToken", i64, toStr(lenVal),
                                                         "mem_after_call", this.curBlock)
                }
                return lenVal
            }
        }

        val owner: String = this.receiverClassOf(src, recvNode)
        if (owner != "") {
            val fIdx: Int = this.classFieldIndex(owner, fieldName)
            if (fIdx >= 0) {
                val recvVal: Int = this.recvObjectValue(src, recvNode, owner)
                return this.emitFieldGet(recvVal,
                    this.classFieldTypeByName(owner, fieldName), fIdx)
            }
        }

        // ── 单例模块字段：`GC.gcEnabled`（接收者是模块名，不是实例值）──
        //
        // `receiverClassOf` 对非 `this`、非定型局部量返回 ""，于是**外部**直接读
        // 单例字段会落到下面的「无法定型」通用分支（拿 `HirVar("GC")` 降级成
        // 常量 0 当对象指针）。补一条：接收者是带字段的单例模块名时，等价于在
        // `<Name>_getInstance()` 返回的惰性实例上读字段。
        if (owner == "" && this.recvIsSingleton(src, recvNode)) {
            val sName: String = src.textOf(recvNode)
            val sIdx: Int = this.classFieldIndex(sName, fieldName)
            if (sIdx >= 0) {
                val instVal: Int = this.program.addValue("Call",
                        this.types.fromTypeName("Long"), "", sName + "_getInstance",
                        this.curBlock)
                return this.emitFieldGet(instVal,
                    this.classFieldTypeByName(sName, fieldName), sIdx)
            }
        }

        val objVal: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, 0))
        // ── P390-b：兜底 GetField 改走 emitFieldGet 常规降级 ──
        //
        // 旧兜底产 `GetField args=[obj, memHead]`——**字段索引被 mem token
        // 占位**（残缺形态）：后端对该 op 按 index 0 降级读 field0，且其发射
        // 路径的实参装载缺失（实测 escapeConstValue 的 `this.escTrace != 0`
        // 落此处 → field_get 内联读未装载的 rcx/rdx → 非规范地址 #GP，崩点
        // 随布局漂移、探针「承重」全家桶，2026-10-07）。改为
        // emitFieldGet(obj, ty, 0)：与 ISel GetField 分支的降级语义一致
        // （读 field0），但走 `Call __field_get(obj, idx)` 常规形态——实参
        // 装载、活跃区间、发射路径全部回归主干。字段读不改内存，不推进链。
        return this.emitFieldGet(objVal, src.tyOf(id), 0)
    }

    /// 构建数组/集合元素访问（Phase A S2: 内存链 Load）。
    ///
    /// HirIndex 表示 a[i] 形式的元素访问，属于内存读取操作。
    /// 依赖 memHead 建立内存顺序，访问后更新内存链。
    fun buildIndex(src: Hir, id: Int): Int {
        val kids: List<Int> = src.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (kCount < 2) {
            return -1
        }

        val baseVal: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, 0))
        val idxVal: Int = this.buildExpr(src, HirUtils.hirKidsAt(kids, 1))
        var args: String = toStr(baseVal) + "," + toStr(idxVal)

        // Phase A S2: 内存链 — 访问依赖 memHead
        if (this.memHead >= 0) {
            args = args + "," + toStr(this.memHead)
        }

        // ── 元素访问降级为 runtime 调用 `__list_get(container, index)` ──
        //
        // 为什么不发射 Load：Photon 的 Load/Store 路径（`Lowering.lowerLoad` →
        // `addValueWithChain`）**不把值登记进 `LirBlock.instrs`**，DAG 里根本
        // 没有加载/存储指令（实测嵌套循环的 Store 全部消失）。索引访问统一走
        // runtime 调用，与 `__list_new` / `.Collections.set` 共用同一套列表布局
        //（`[count][e0][e1]…`，元素 i 在 [8 + i*8]）。
        val typeId: Int = this.types.fromTypeName(src.tyOf(id))
        val getVal: Int = this.program.addValue("Call", typeId, args, "__list_get", this.curBlock)

        // Phase A S2: 更新内存链 — 访问后创建新的 mem token
        if (this.memHead >= 0) {
            val memTypeId: Int = this.types.intType(64)
            this.memHead = this.program.addValue("MemToken", memTypeId, toStr(getVal), "mem_after_get", this.curBlock)
        }

        return getVal
    }

    // ── Phi 节点 ──

    /// 向指定块添加 Phi 节点，返回 ValueID。
    fun makePhi(blockId: Int, typeId: Int, incoming: String, aux: String): Int {
        return this.program.addPhi(blockId, typeId, incoming, aux)
    }

    // ── 运算符映射 ──

    /// 映射二元运算符到 MIR 操作符。
    private fun mapBinaryOp(op: String): String {
        if (op == "+" || op == "Plus") { return "Add" }
        if (op == "-" || op == "Minus") { return "Sub" }
        if (op == "*" || op == "Star") { return "Mul" }
        if (op == "/" || op == "Slash") { return "SDiv" }
        if (op == "%" || op == "Percent") { return "SRem" }
        if (op == "==" || op == "EqEq") { return "ICmpEq" }
        if (op == "!=" || op == "Neq") { return "ICmpNe" }
        if (op == "<" || op == "Lt") { return "ICmpSlt" }
        if (op == ">" || op == "Gt") { return "ICmpSgt" }
        if (op == "<=" || op == "LtEq") { return "ICmpSle" }
        if (op == ">=" || op == "GtEq") { return "ICmpSge" }
        if (op == "<<" || op == "LtLt") { return "Shl" }
        if (op == ">>" || op == "GtGt") { return "Shr" }
        if (op == "&" || op == "Ampersand") { return "And" }
        if (op == "|" || op == "Pipe") { return "Or" }
        if (op == "^" || op == "Caret") { return "Xor" }
        // ── 逻辑与 / 逻辑或（**必须显式列出**，否则落到末尾默认 `Add`）──
        //
        // ⚠️ 这里漏掉 `&&` / `||` 的后果不是「算错一个布尔」，而是**崩溃**：
        // 它们落进默认分支变成 `Add`，`InstructionSelection` 对 `Add` 会走
        // **字符串拼接**（`strcat`）路径，于是 `b1 && b2` 被发射成
        // `strcat(bool1, bool2)` —— 把 0/1 当指针传给 `strcat`，内部
        // `strlen(0)` 直接访问违规。
        //
        // 实测自举 `Main.aura` 的 `main`：
        //     if (cnt0 >= 3 && cliArg(1) == "run") { base = 2 }
        // 编译成
        //     de6f4: setne %dil ; de6fc: movq %rdi,%rdx ; de702: callq strcat
        // ⇒ `Main.exe` 在打印完 `BOOT-1b` 后立刻 `0xC0000005`。
        //
        // 布尔在光子链路里就是 0/1 整数，按位与/或与逻辑与/或在这些取值上
        // 完全等价（与 `&` / `|` 共用 `And` / `Or` 实现）。
        if (op == "&&" || op == "AmpAmp" || op == "AndAnd") { return "And" }
        if (op == "||" || op == "PipePipe" || op == "OrOr") { return "Or" }
        return "Add"
    }

    /// 映射一元运算符到 MIR 操作符。
    private fun mapUnaryOp(op: String): String {
        if (op == "-" || op == "Minus") { return "Neg" }
        if (op == "!" || op == "Bang") { return "Not" }
        if (op == "+" || op == "Plus") { return "Pos" }
        return "Neg"
    }

    // ── 变量映射 ──

    /// 向变量映射表追加一个条目。
    ///
    /// 使用 \name|vid\n` 拼接格式，与 MirLower.aura 一致。
    private fun varMapAdd(name: String, vid: Int) {
        this.varMap = this.varMap + name + "|" + toStr(vid) + "\n"
        // Phase A S2: 变量重命名 — 每次赋值递增版本号
        this.bumpVarVersion(name)
    }

    /// Phase A S2: 递增变量版本号（SSA 变量重命名）。
    ///
    /// 每次赋值创建新的 SSA 版本，确保每个版本是独立的 SSA 值。
    private fun bumpVarVersion(name: String): Unit {
        val currentVersion: Int = this.getVarVersion(name)
        val newVersion: Int = currentVersion + 1
        this.setVarVersion(name, newVersion)
    }

    /// Phase A S2: 获取变量版本号。
    private fun getVarVersion(name: String): Int {
        // 零分配倒序扫描（见 mapVidOf）；未找到时与原实现一致返回 0。
        val v: Int = this.mapVidOf(this.varVersion, name)
        if (v < 0) { return 0 }
        return v
    }

    /// Phase A S2: 设置变量版本号。
    private fun setVarVersion(name: String, version: Int): Unit {
        this.varVersion = this.varVersion + name + "|" + toStr(version) + "\n"
    }

    /// 从变量映射表查找变量值，返回 SSA ValueID。
    ///
    /// 遍历所有 \name|vid\n` 行，按 `|` 拆分后匹配名称。
    private fun varMapLookup(name: String): Int {
        val traceOn: Boolean = Env.get("AURA_PHOTON_TRACE", "") == "1"
        if (traceOn) println("            [vml0] varMapLookup name=" + name)
        if (traceOn) println("            [vml1] varMap length=" + this.varMap.length)
        val vid: Int = this.mapVidOf(this.varMap, name)
        if (traceOn) println("            [vml3] vid=" + vid)
        if (vid >= 0) {
            return vid
        }
        val result: Int = this.program.addValue("Const", this.types.intType(64), "", "0", this.curBlock)
        return result
    }

    // ═════════════════════════════════════════════════════════════
    // 类 / 结构体（Photon 对象模型 A-1 / A-3）
    //
    // 设计约束：Photon 的 `Load`/`Store` 路径不可用（`Lowering.lowerLoad`
    // 用 `addValueWithChain`，值不登记进 `LirBlock.instrs`，DAG 里加载/存储
    // 指令全部消失）。因此字段访问与列表访问一样，统一走 **runtime 调用**：
    //   · `__field_get(obj, index)` → rax = [obj + index*8 + 16]
    //   · `__field_set(obj, index, val)` → [obj + index*8 + 16] = val
    // 对象布局（与 `PhotonRuntime.emitClassConstructorWithVtable` 一致）：
    //   [0x00] vtable 指针(8B)  [0x08] 对象大小(8B)  [0x10+i*8] 字段 i
    // 索引而非字节偏移：复用编码器的 `emitLoadIndexed8`（SIB scale=8）。
    // ═════════════════════════════════════════════════════════════

    /// 取 `key` 之后到下一个 `\n` 之间的片段（未命中返回 ""）。
    ///
    /// 扁平表查找原语：`indexOf` 是 C 侧 `strstr`，再按字符码点扫到行尾，
    /// 一次 `substring` 产出结果 —— 全程**零 split 分配**。
    private fun flatFieldAfter(text: String, key: String): String {
        if (text == "" || key == "") {
            return ""
        }
        val pos: Int = text.indexOf(key)
        if (pos < 0) {
            return ""
        }
        val start: Int = pos + key.length
        var i: Int = start
        val len: Int = text.length
        while (i < len) {
            if (text.charCodeAt(i) == 10) {
                break
            }
            i = i + 1
        }
        if (i <= start) {
            return ""
        }
        return text.substring(start, i)
    }

    /// `text` 自 `pos` 起是否以 `key` 开头（逐码点比较，不分配）。
    private fun flatStartsWith(text: String, pos: Int, key: String): Boolean {
        if (pos < 0 || pos + key.length > text.length) {
            return false
        }
        var i: Int = 0
        while (i < key.length) {
            if (text.charCodeAt(pos + i) != key.charCodeAt(i)) {
                return false
            }
            i = i + 1
        }
        return true
    }

    /// `text` 中出现 `key` 的次数（逐位置滑窗，不分配）。
    private fun flatCount(text: String, key: String): Int {
        if (text == "" || key == "") {
            return 0
        }
        var n: Int = 0
        var i: Int = 0
        val last: Int = text.length - key.length
        while (i <= last) {
            if (this.flatStartsWith(text, i, key)) {
                n = n + 1
            }
            i = i + 1
        }
        return n
    }

    /// 是否为内建**值类型**（`value class String` / `open class Any` 等）。
    ///
    /// 这些类型**不作为对象模型类登记**。原因：它们的成员访问已由
    /// `InstructionSelection.mapStdlibFuncName` 按 `recvTy` 映射到 runtime
    /// （`String.length → strlen`、`Any.equals → streq`、`String.charCodeAt →
    /// charCodeAt` …）。若再按「类 + 字段偏移」处理，会产生 `String_charCodeAt`
    /// 这类**真实函数体**——与 runtime 符号语义重复，且把 DAG 节点数从 ~63k
    /// 推到 ~75k，Phase D（寄存器分配）在 8 GiB 内存闸门下直接退出码 70
    ///（AOT 运行时无 GC，撤下的中间串全部滞留）。
    private fun isBuiltinValueClass(name: String): Boolean {
        if (name == "String" || name == "Any") { return true }
        if (name == "Int" || name == "Long" || name == "Float" || name == "Double") { return true }
        if (name == "Boolean" || name == "Byte" || name == "Short" || name == "Char") { return true }
        if (name == "Unit" || name == "Basic") { return true }
        return false
    }

    /// 是否为已知类/结构体名。
    private fun isClassName(name: String): Boolean {
        if (name == "" || this.classNamesCsv == "") {
            return false
        }
        return this.classNamesCsv.indexOf("\n" + name + "\n") >= 0
    }

    /// 是否为**单例模块**（`object` / `extern interface`）声明。
    ///
    /// 与 `isClassName` 的区别：单例的调用点**没有接收者实参**
    ///（`Mutex.lock(m)` 只传 `m`），调用点解析必须丢弃降级进来的接收者，
    /// 否则实参整体错位一位（实测 `Cpu.atomicAdd(addr, 1)` 的 `addr` 落进
    /// 「接收者」槽、`1` 落进 `addr` 槽）。
    private fun isSingletonObj(name: String): Boolean {
        if (name == "" || this.singletonCsv == "") {
            return false
        }
        return this.singletonCsv.indexOf("\n" + name + "\n") >= 0
    }

    /// 是否属于 `extern interface`（`HirExternObject`）成员。
    ///
    /// 这类成员的实现由编译器/运行库提供（`Memory_alloc` 在 `aura_runtime.obj`），
    /// `buildAllFunctions` 必须跳过 —— 生成用户函数体会在链接期
    /// `duplicate symbol: Memory_alloc`。
    private fun isExternObj(name: String): Boolean {
        if (name == "" || this.externCsv == "") {
            return false
        }
        return this.externCsv.indexOf("\n" + name + "\n") >= 0
    }

    /// 该 `HirFunction` 是否是 `extern interface` **声明**的方法（只有这些跳过代码生成）。
    private fun isExternObjMethod(src: Hir, node: Int): Boolean {
        val owner: String = this.ownerClassNameOf(node)
        if (owner == "" || this.externMethodsCsv == "") {
            return false
        }
        return this.externMethodsCsv.indexOf("\n" + owner + "|" + src.textOf(node) + "\n") >= 0
    }

    /// 单例模块是否带**字段状态**。
    ///
    /// `GC` / `ARC` / `MemoryManager` / `Runtime` 带字段，字段必须有一个真实
    /// 对象指针承载（`__field_get(obj, i)` 需要非零 obj）；`Mutex` / `Thread` /
    /// `Condvar` / `Cpu` 无字段，是纯静态方法。
    private fun hasFieldState(name: String): Boolean {
        if (name == "" || !this.isSingletonObj(name)) {
            return false
        }
        return this.flatCount(this.classFields, "\n" + name + "|") > 0
    }

    /// 调用/成员访问的**第一个子节点**是否为单例模块引用。
    ///
    /// 只认 `HirVar` 直接命名（`Mutex.lock` 降级后的接收者子节点就是
    /// `HirVar("Mutex")`）：`this` 与局部实例仍走原有接收者路径。
    private fun recvIsSingleton(src: Hir, node: Int): Boolean {
        if (node < 0 || src.kindOf(node) != "HirVar") {
            return false
        }
        val n: String = src.textOf(node)
        if (n == "" || n == "this") {
            return false
        }
        // 局部实例（`val vm: VmRunner` → 大写局部变量）是真实值，绝不丢弃
        if (this.localTypeOf(n) != "") {
            return false
        }
        if (this.isSingletonObj(n)) {
            return true
        }
        // extern interface (Memory/Cpu/ThreadOps) 也没有接收者形参
        if (this.isExternObj(n)) {
            return true
        }
        // 形状兜底（2026-10-03）：大写 + 非局部 + 两本登记簿都没有 ⇒ 模块名
        // 引用。Aura 没有「类静态方法」形态 —— `X.m()` 里大写 X 只能是
        // 单例/extern，接收者恒无值。登记簿可能不完整（实测 Cpu/Memory 的
        // extern 接口缺席 externCsv ⇒ self 占位进实参，ABI 错位一格），
        // 这里不依赖登记完整性。
        val fc: Int = n.substring(0, 1).charCodeAt(0)
        return fc >= 65 && fc <= 90
    }

    /// 接收者是否是**裸单例模块引用**（`HirVar` 且名字本身就是单例模块名）。
    ///
    /// 局部实例（`var a: ArenaAllocator = ArenaAllocator()`）不算裸引用：
    /// `localTypeOf` 命中即排除，继续走 `buildExpr`。
    private fun recvIsBareSingleton(src: Hir, node: Int): Boolean {
        if (node < 0 || src.kindOf(node) != "HirVar") {
            return false
        }
        val n: String = src.textOf(node)
        if (n == "" || n == "this") {
            return false
        }
        if (this.localTypeOf(n) != "") {
            return false
        }
        return this.isSingletonObj(n)
    }

    /// 取成员访问/赋值的接收者**对象指针**值。
    ///
    /// ⚠️ 裸单例引用（`ArenaAllocator.x` / `MemoryManager.y = v`）的接收者子节点
    /// 是 `HirVar("ArenaAllocator")`，它**不是实例值**。而 `receiverClassOf` 对
    /// 它返回模块名（非 ""），于是调用点走 `buildExpr`，`HirVar` 查不到局部量
    /// 就降级成常量 0；`__field_get(0, i)` 的「对象为 0 → 返回 0」兜底让**所有
    /// 外部单例字段读恒为 0、写被静默丢弃**。
    ///
    /// 实测（probe_arena）：`ArenaAllocator.usedSize` 恒 0，而 `getUsedSize()`
    /// 返回正确值 64 —— 方法体里的 `this` 走 `receiverClassOf → curClass`，
    /// 再由 `buildFunction` 解析成 `ArenaAllocator_getInstance()` 调用，所以是对的。
    ///
    /// 这里对裸单例引用改为发射一次 `<Name>_getInstance()` 取惰性实例。
    private fun recvObjectValue(src: Hir, recvNode: Int, owner: String): Int {
        if (this.recvIsBareSingleton(src, recvNode)) {
            val lty: Int = this.types.fromTypeName("Long")
            return this.program.addValue("Call", lty, "", owner + "_getInstance", this.curBlock)
        }
        return this.buildExpr(src, recvNode)
    }

    /// 类的直接基类名（无继承返回 ""）。
    private fun parentOfClass(cls: String): String {
        if (cls == "") {
            return ""
        }
        return this.flatFieldAfter(this.classParents, "\n" + cls + "|")
    }

    /// 类**自有**字段数（不含继承）。
    ///
    /// 只在 `buildClassIndex` 的登记期被 `registerClass` / `classBaseIndex` 调用
    /// （算字段序号起点）—— 缓存要到登记全部结束才构建，故这里只能扫 CSV。
    /// 缓存期所有调用方改走 `classFieldTotal` / `classSizeOf`，本函数不在热路径。
    private fun ownFieldCount(cls: String): Int {
        if (cls == "") {
            return 0
        }
        return this.flatCount(this.classFields, "\n" + cls + "|")
    }

    /// 类字段布局的起始序号（= 祖先链上各代「自有字段数」之和）。
    ///
    /// 子类布局 = 父类字段前缀 + 自有字段，因此父类名必须**先**登记。
    /// HIR arena 顺序不保证这一点，所以这里按需递归计算而不是靠扫描顺序。
    ///
    /// 只在 `buildClassIndex` 的登记期被 `registerClass` 调用（算字段序号起点）；
    /// 缓存构建完成后所有调用方改走 `classFieldTotal` / `classSizeOf`。
    private fun classBaseIndex(cls: String): Int {
        if (cls == "") {
            return 0
        }
        val p: String = this.parentOfClass(cls)
        if (p == "") {
            return 0
        }
        return this.classBaseIndex(p) + this.ownFieldCount(p)
    }

    /// 类字段总层数（含继承）。
    private fun classFieldTotal(cls: String): Int {
        val ci: Int = this.nameToIdx(cls)
        if (ci < 0) {
            return this.classBaseIndex(cls) + this.ownFieldCount(cls)
        }
        return this.fwInt(this.clsLayoutTotal[ci], 0, 0)
    }

    private fun classSizeOf(cls: String): Int {
        val ci: Int = this.nameToIdx(cls)
        if (ci < 0) {
            return 16 + this.classFieldTotal(cls) * 8
        }
        return this.fwInt(this.clsLayoutSize[ci], 0, 16)
    }

    /// 字符串名 → 该名字在 `names` 列表中的**首次**下标（不存在返回 -1）。
    ///
    /// 列表内不重复（本文件所有名表都以「名唯一」为约定），首次命中即正确。
    /// 下标数组查找，不产生临时分配。`names` 只含**有字段**的类（几十~几百项），
    /// 且只被 `buildFieldLayoutCache` 与冷路径的 `classFieldTotal`/`classSizeOf`
    /// 调用，线性扫描可接受。
    private fun nameToIdx(name: String): Int {
        if (name == "") {
            return -1
        }
        var j: Int = 0
        while (j < this.names.size) {
            if (this.names[j] == name) {
                return j
            }
            j = j + 1
        }
        return -1
    }

    /// 整数值格式化为**定宽 8 字符**（不足右侧补空格，超长截断前 8 字符）。
    ///
    /// ⚠️ 填充**不能**用 `|`：`|` 在本文件惯例里是行分隔符（`|<槽>|<槽>|`），
    /// 拿它当填充会与分隔符混淆，使「值 + 填充」在拼接后无法切回槽位 ——
    /// `fwGet` 读到全 `|` 槽位、`fwSlotCount` 也算错（实测整表退化为默认值，
    /// 构造器因此丢字段）。填充字符选 ` `（空格）：类型名/字段名从不以纯空格
    /// 结尾，`parseIntDef` 也容忍尾随空白。槽宽恒 8，分隔符 1，槽 `k` 起于
    /// 偏移 `1 + k * 9`，取数无需切分、不分配。
    private fun fw(v: String): String {
        if (v.length >= 8) {
            return v.substring(0, 8)
        }
        var pad: String = ""
        var g: Int = 8 - v.length
        while (g > 0) {
            pad = pad + " "
            g = g - 1
        }
        return v + pad
    }

    /// 从定宽整型行（`|<8>|<8>|…`，槽内右补空格）取下标 `idx` 的值；越界返回 ""。
    private fun fwGet(row: String, idx: Int): String {
        if (row == "" || idx < 0) {
            return ""
        }
        val start: Int = 1 + idx * 9
        if (start + 8 > row.length) {
            return ""
        }
        return row.substring(start, start + 8)
    }

    /// 定宽整型行取下标 `idx` 的整数值；越界/空返回 `def`。
    private fun fwInt(row: String, idx: Int, def: Int): Int {
        return this.parseIntDef(this.fwGet(row, idx), def)
    }

    /// 定宽行的**槽数**（非字符数）。
    ///
    /// 行形态为 `|<8>|<8>|…`（首字符为分隔符，每槽 8 值 + 1 分隔 = 9 字符），
    /// 故槽数 = `length / 9`。⚠️ 用 `length` 直接当槽数会把字符数（含 `|` 分隔符
    /// 与填充空格）误当槽位，导致「按最大序号扩槽」的判断整体错位。
    private fun fwSlotCount(row: String): Int {
        if (row == "") {
            return 0
        }
        return row.length / 9
    }

    /// 取 `|` 分隔文本的第 `idx` 段（越界返回 ""）。只用于**短**字段尾部。
    private fun flatPart(text: String, idx: Int): String {
        if (text == "") {
            return ""
        }
        var cur: Int = 0
        var start: Int = 0
        var i: Int = 0
        val len: Int = text.length
        while (i <= len) {
            if (i == len || text.charCodeAt(i) == 124) {
                if (cur == idx) {
                    return text.substring(start, i)
                }
                cur = cur + 1
                start = i + 1
            }
            i = i + 1
        }
        return ""
    }

    /// 按「类 + 字段名」取字段记录**尾部**（`index|auraTy|defaultNodeId`）。
    ///
    /// 未命中时沿继承链向上查找 —— 子类字段布局保留父类前缀，因此父类记录
    /// 的序号对子类同样有效。
    private fun fieldTailByName(cls: String, field: String): String {
        if (cls == "" || field == "") {
            return ""
        }
        val key: String = "\n" + cls + "|" + field + "|"
        val pos: Int = this.classFields.indexOf(key)
        if (pos >= 0) {
            val start: Int = pos + key.length
            var i: Int = start
            val len: Int = this.classFields.length
            while (i < len) {
                if (this.classFields.charCodeAt(i) == 10) {
                    break
                }
                i = i + 1
            }
            if (i > start) {
                return this.classFields.substring(start, i)
            }
            return ""
        }
        val p: String = this.parentOfClass(cls)
        if (p != "") {
            return this.fieldTailByName(p, field)
        }
        return ""
    }

    /// 按布局序号取字段声明类型（未命中返回 ""）。
    private fun fieldTypeOfIndex(cls: String, idx: Int): String {
        val ci: Int = this.fieldRowOfClass(cls, idx)
        if (ci < 0) {
            return ""
        }
        // ⚠️ 行首有**前导 `|`**（`|t0|t1|…`），flatPart 的段 0 是空串 ⇒
        // 槽 k 的类型在段 k+1。旧实现直接 flatPart(row, idx) ⇒ 类型整体
        // **-1 错位**（slot0 恒空、slot1 拿到 name 的 String……实测
        // AucModule 全部字段类型错位一格，2026-10-06）。
        return this.flatPart(this.clsLayoutTys[ci], idx + 1)
    }

    /// 按布局序号取字段默认值表达式节点（无默认值返回 -1）。
    private fun fieldDefaultOfIndex(cls: String, idx: Int): Int {
        val ci: Int = this.fieldRowOfClass(cls, idx)
        if (ci < 0) {
            return -1
        }
        return this.fwInt(this.clsLayoutDefaults[ci], idx, -1)
    }

    /// 字段在类（含继承链）中的布局序号；未命中返回 -1。
    private fun classFieldIndex(cls: String, field: String): Int {
        val tail: String = this.fieldTailByName(cls, field)
        if (tail == "") {
            return -1
        }
        return this.parseIntDef(this.flatPart(tail, 0), -1)
    }

    /// 字段声明类型名（沿继承链查找；未命中返回 ""）。
    private fun classFieldTypeByName(cls: String, field: String): String {
        return this.flatPart(this.fieldTailByName(cls, field), 1)
    }

    /// 定位字段缓存行：返回（类序, idx）对应的行下标，未命中返回 -1。
    ///
    /// ⚠️ `fieldTypeOfIndex` 与 `fieldDefaultOfIndex` 共用此入口，
    /// 保证两类字段号的一致性校验只做一次（旧实现里两次全量 CSV 扫描）。
    private fun fieldRowOfClass(cls: String, idx: Int): Int {
        val ci: Int = this.nameToIdx(cls)
        if (ci < 0 || idx < 0) {
            return -1
        }
        val total: Int = this.fwInt(this.clsLayoutTotal[ci], 0, 0)
        if (idx >= total) {
            return -1
        }
        return ci
    }

    /// 本类是否已登记该字段（去重，避免重复登记打乱序号）。
    private fun rawFieldIndex(cls: String, field: String): Int {
        if (cls == "" || field == "") {
            return -1
        }
        val key: String = "\n" + cls + "|" + field + "|"
        val pos: Int = this.classFields.indexOf(key)
        if (pos < 0) {
            return -1
        }
        val start: Int = pos + key.length
        var i: Int = start
        val len: Int = this.classFields.length
        while (i < len) {
            if (this.classFields.charCodeAt(i) == 10) {
                break
            }
            i = i + 1
        }
        return this.parseIntDef(this.classFields.substring(start, i), -1)
    }

    /// 整数解析（失败/越界返回默认值）。`SsaMirUtils.strToInt` 对非法输入
    /// 一律返回 0，无法区分「字段序号 0」与「解析失败」，故这里单独实现。
    private fun parseIntDef(s: String, def: Int): Int {
        val t: String = s.trim()
        if (t == "") {
            return def
        }
        var i: Int = 0
        var neg: Boolean = false
        if (t.charCodeAt(0) == 45) {
            neg = true
            i = 1
        }
        if (i >= t.length) {
            return def
        }
        var n: Int = 0
        while (i < t.length) {
            val c: Int = t.charCodeAt(i)
            if (c < 48 || c > 57) {
                return def
            }
            n = n * 10 + (c - 48)
            i = i + 1
        }
        if (neg) {
            return -n
        }
        return n
    }

    /// 登记局部变量/形参的声明类型（倒序查找，后声明者优先）。
    private fun localTypeAdd(name: String, ty: String) {
        if (name == "" || ty == "") {
            return
        }
        // 归一化：HIR 把可见性修饰符以 `#<vis>|` 前缀写进声明节点的 `ty` 字段
        //（见 `Parser.aura` 的 `prsCurVis` 注释）⇒ `ty` 实为 `#public|String`。
        // 不剥掉的话本表记录成 `s3|#public|String`，而 `localTypeOf` 按 `|` 切分
        // 只取到 `#public` ⇒ 接收者类型判定全部失手：`s3.length()` 落进
        // 「方法属主唯一候选」兜底 ⇒ `StringBuilder_length(s3)`（把字符串指针当
        // StringBuilder 读字段）⇒ 实测 `P2/04_string_ops.aura` 打印
        // `len = 4404577004589182066`（VM 为 11）；同理 `List<Int>` 局部量会
        // 退化成 `#public`，集合映射也一起失效。
        val norm: String = this.normAuraType(ty)
        if (norm == "") {
            return
        }
        // ⚠️ 空表必须先垫一个前导 `\n`：`localTypeOf` 的 needle 是
        // `"\n" + name + "|"`，而首条目直接从串首开始、没有前导换行 ⇒
        // **函数内第一个登记的局部量永远查不中** ⇒ 接收者定型失败 →
        // 属性访问落到通用 GetField（实测 R12 探针 main 的第一个局部
        // `a`：`a.pathBuf` 定型失败 → ISel 丢基址 → 值错 + 活跃区间
        // 断裂 → 寄存器被后续构造覆写。2026-10-03）。
        if (this.localTypes == "") {
            this.localTypes = "\n"
        }
        this.localTypes = this.localTypes + name + "|" + norm + "\n"
    }

    /// 归一化 HIR 类型名：剥掉 `#<vis>|` 可见性前缀；纯可见性（无类型）返回 ""。
    private fun normAuraType(ty: String): String {
        var s: String = ty
        if (s.startsWith("#")) {
            val bar: Int = s.indexOf("|")
            if (bar < 0) {
                return ""
            }
            s = s.substring(bar + 1, s.length)
        }
        return s
    }

    /// 局部变量声明类型名（未命中返回 ""）。
    ///
    /// 旧实现在每次调用时 `splitStr` 切分整个 `localTypes` 字符串（O(n) 每次），
    /// 循环内多次调用 → O(n²)。修复：用 `lastIndexOf` 逆序查找目标行，
    /// 用 `substringAt` 提取类型名（O(1) 每次，无中间 List 分配）。
    private fun localTypeOf(name: String): String {
        if (this.localTypes == "" || name == "") {
            return ""
        }
        // ⚠️ 手写逆序扫描，不用 `lastIndexOf` / 静态三参 `String.indexOf` /
        // `substringAt`：三者经 AOT 编译后失效（实测 2026-10-02，AOT 驱动下
        // 本函数恒返回 "" ⇒ 局部量定型全废 ⇒ `s3.length()` 落到
        // `StringBuilder_length` 把字符串指针当对象读 ⇒ 0xC0000005；
        // 种子 VM 下三者正常，故 VM 侧套件无症状）。只依赖
        // `charCodeAt` / `substring` —— 与 `LirUtils.strToInt` 等手写原语同一动机。
        // 逆序：后声明的局部变量覆盖先声明者。
        val needle: String = "\n" + name + "|"
        val nl: Int = needle.length
        val hayLen: Int = this.localTypes.length
        var pos: Int = hayLen - nl
        while (pos >= 0) {
            var matched: Boolean = true
            var ci: Int = 0
            while (ci < nl) {
                val hc: Int = this.localTypes.charCodeAt(pos + ci) as Int
                val nc: Int = needle.charCodeAt(ci) as Int
                if (hc != nc) {
                    matched = false
                }
                ci = ci + 1
            }
            if (matched) {
                val tyStart: Int = pos + nl
                var tyEnd: Int = tyStart
                // ⚠️ 不用 `tyEnd < hayLen && charCodeAt(..)` —— AOT 不保证 &&
                // 短路（见 aot/Emit.aura 的 charCodeAt 陷阱），越界路径必须
                // 结构上不可达：先判界，再入内读字符。
                while (tyEnd < hayLen) {
                    val ec: Int = this.localTypes.charCodeAt(tyEnd) as Int
                    if (ec == 10) {
                        break
                    }
                    tyEnd = tyEnd + 1
                }
                return this.localTypes.substring(tyStart, tyEnd)
            }
            pos = pos - 1
        }
        return ""
    }

    /// 接收者表达式的静态类名（不可判定返回 ""）。
    ///
    /// 只用三种可靠来源：`this`（当前方法所属类）、「局部变量/形参的声明类型」、
    /// 以及「`<recv>.<字段>` 的**字段声明类型**」。
    /// Photon 链路没有 sema 信息，凭名字猜类会给出错误字段偏移 —— 那比不解析更糟
    /// （静默读写到别的字段）。
    private fun receiverClassOf(src: Hir, recvNode: Int): String {
        val kind: String = src.kindOf(recvNode)

        // ── `this.<字段>` / `<obj>.<字段>`：静态类型 = 字段的**声明类型** ──
        //
        // ⚠️ 旧实现只认 `HirVar`，于是 `this.dag.addInstr(...)` 的接收者
        //（`HirMember("dag", [HirVar("this")])`）一律返回 ""，调用点退化到
        // 「全局唯一属主」兜底；而 `addInstr` 被 `MirSsaProgram` / `MachineDag` /
        // `LirProgram` 同时声明 ⇒ 属主歧义 ⇒ 保底回落成**裸名**。
        // 自举 `Main.aura` 实测 29 个裸方法名未定义（`addInstr` / `optimize` /
        // `addBlock` / `leaf` / `emit` …），lld-link 因此失败。
        if (kind == "HirMember") {
            val fname: String = src.textOf(recvNode)
            val mk: List<Int> = src.kidsOfList(recvNode)
            if (fname != "" && HirUtils.hirKidsCount(mk) >= 1) {
                val inner: Int = HirUtils.hirKidsAt(mk, 0)
                val recvCls: String = this.receiverClassOf(src, inner)
                if (recvCls != "") {
                    val fty: String = this.fieldAuraTypeName(recvCls, fname)
                    if (fty != "" && this.isClassName(fty)) {
                        return fty
                    }
                }
            }
            return ""
        }
        if (kind == "HirCall") {
            // `File(path).exists()`：接收者是**构造器调用结果**，静态类型 =
            // 被构造的类。旧实现返回 ""，调用点落到「隐式 this」兜底 ——
            // 外层类恰声明同名方法时（FileUtils.exists / FileUtils.readText）
            // 限定成 `FileUtils_exists` **自递归**：每层再 alloc + 调自己，
            // 直至爆栈（实测 fs 探针崩入 runtime_emitObjectAlloc，
            // 2026-10-03）。
            val cn: String = src.textOf(recvNode)
            if (cn != "" && this.isClassName(cn) && !this.isSingletonObj(cn)) {
                return cn
            }
            return ""
        }
        if (kind != "HirVar") {
            return ""
        }
        val n: String = src.textOf(recvNode)
        if (n == "this") {
            return this.curClass
        }
        val ty: String = this.localTypeOf(n)
        // 单例模块名也要认（`var mutex: Mutex` 后 `mutex.isLocked()` 的接收者
        // 静态类型就是 `Mutex`）；不认的话调用点退化成裸名 `isLocked`，
        // 而定义侧是 `Mutex_isLocked` ⇒ 链接期 undefined symbol。
        if (ty != "" && (this.isClassName(ty) || this.isSingletonObj(ty))) {
            return ty
        }
        // `Memory.alloc(8L)` / `Cpu.atomicAdd(addr, 1)` / `MemoryManager.alloc(n)`：
        // 接收者子节点就是**类名/模块名本身**，不是某个局部变量。此时静态类型
        // 就是这个名字。不认的话 `alloc` 落进「全局唯一属主」兜底（重名歧义）
        // 退化成裸名 `alloc`，链接期 undefined symbol。
        if (this.isClassName(n) || this.isSingletonObj(n)) {
            return n
        }
        return ""
    }

    /// 字段的声明类型名（沿继承链查找；未命中返回 ""）。
    private fun fieldAuraTypeName(cls: String, field: String): String {
        var cur: String = cls
        var depth: Int = 0
        while (cur != "" && depth < 16) {
            val ty: String = this.rawFieldAuraType(cur, field)
            if (ty != "") {
                return ty
            }
            cur = this.parentOfClass(cur)
            depth = depth + 1
        }
        return ""
    }

    /// 类**自身**声明的字段类型（不含继承；"" 表示未命中）。
    ///
    /// `classFields` 每行格式：`Class|field|index|auraTy|defaultNodeId`
    ///（见 `addField`），此处取 `key` 之后的第 1 段（0 基）即 `auraTy`。
    private fun rawFieldAuraType(cls: String, field: String): String {
        if (cls == "" || field == "" || this.classFields == "") {
            return ""
        }
        val key: String = "\n" + cls + "|" + field + "|"
        val pos: Int = this.classFields.indexOf(key)
        if (pos < 0) {
            return ""
        }
        val start: Int = pos + key.length
        val len: Int = this.classFields.length
        var i: Int = start
        var seg: Int = 0
        var segStart: Int = start
        while (i <= len) {
            // 结尾补一个换行哨兵，触发最后一次结算
            val c: Int = if (i == len) { 10 } else { (this.classFields.charCodeAt(i) as Int) }
            if (c == 124 || c == 10) {
                if (seg == 1) {
                    return this.classFields.substring(segStart, i)
                }
                seg = seg + 1
                segStart = i + 1
            }
            i = i + 1
        }
        return ""
    }

    /// 方法节点 → 属主类名（自由函数返回 ""）。
    private fun ownerClassNameOf(funcNode: Int): String {
        if (funcNode < 0 || funcNode >= this.ownerByNode.size) {
            return ""
        }
        return this.ownerByNode[funcNode]
    }

    /// 预扫描 HIR，建立「类名 / 继承 / 字段布局 / 方法属主 / 自由函数」五张表。
    private fun buildClassIndex(src: Hir) {
        val n: Int = src.count
        // 属主数组先按 arena 大小铺满空串：registerClass 阶段按下标回填。
        var pre: Int = 0
        while (pre < n) {
            this.ownerByNode.add("")
            pre = pre + 1
        }
        var i: Int = 0
        while (i < n) {
            val k: String = src.kindOf(i)
            if (k == "HirClass" || k == "HirStruct") {
                this.registerClass(src, i, k)
            } else if (k == "HirObject" || k == "HirExternObject") {
                // ⚠️ P4：`object` 单例与 `extern interface` 的成员此前**完全没有属主**
                //（`registerClass` 只认 `HirClass`/`HirStruct`），于是 `Mutex.lock` /
                // `Cpu.atomicAdd` / `Memory.mmap` 一律落成裸名 —— `init`×6、`alloc`×3、
                // `free`×3 在 COFF 里互相覆盖，调用点整体错位（P4 全 7 例链接失败的
                // 第一根因）。这里登记属主/字段表，但**不进** `classList`
                //（`synthesizeCtors` 只为真正的类合成 `<Class>__new`）。
                this.registerClass(src, i, k)
            }
            i = i + 1
        }

        // ── 类型声明体的「方法返回类型」扫描 ──
        //
        // ⚠️ `Hir.aura:915` 一共产出**四种**类型声明 kind：
        // `HirStruct` / `HirClass` / `HirObject` / `HirEnum`
        //（AOT 参考实现 `Emit.aura:432` 也是四种一视同仁）。旧实现只扫前两种，
        // 于是 `object` 单例的**工厂方法**返回类型缺失 —— 而本仓库的主要写法是
        // `val peephole = PeepholeOptimizerUtils.emptyOptimizer()`（**不标注类型**），
        // `Hir.aura:1781` 又把 HirCall 的 type 一律写空串 ⇒ 局部量无法定型
        // ⇒ 调用点回落成裸名。自举 `Main.aura` 实测 11 个未定义符号
        //（`optimize` / `lower` / `emitFunction` / `setOutputType` / `link` / …）。
        //
        // `HirExternObject` 一并扫（其成员多为 `@native`，无函数体，登记无害）。
        i = 0
        while (i < n) {
            val dk: String = src.kindOf(i)
            if (dk == "HirClass" || dk == "HirStruct" || dk == "HirObject"
                || dk == "HirEnum" || dk == "HirExternObject") {
                this.scanDeclMethodReturnTypes(src, i)
            }
            i = i + 1
        }
        // 第二遍：`funcOwner` 已就绪，可判定哪些 HirFunction 是顶层自由函数。
        //
        // 旧实现逐条字符串拼接（O(n²)）：每次追加都拷贝整串。
        // 修复：先收进 List，循环后一次 join（沿用 joinChunks 范式）。
        // ⚠️ 2026-10-02：**字符串直接累加**，不经 `List<String>` 中转。
        // 实测（AOT 自举驱动、05_functions.aura）：owner 判定全部正确
        // （add/multiply/main 的 owner 均为空、逐条打印可证），但
        // `ArrayList<String>.add(fn)` 之后列表 size 仍为 0 —— AOT 运行时的
        // 真实负载下它会**静默丢元素**（同 `scanInitArities` 注释记录的
        // 「`ArrayList<Any>` 泛型装箱路径不可靠」，也同本日
        // InstructionSelection 前驱表嵌套列表损坏）。此表一函数只建一次、
        // 规模 ~千条 × ~20 字符，O(n²) 拼接总复制量 ~几十 MB，可接受。
        // 格式：`\nfn1\nfn2\n`（首尾各一个 \n，便于 indexOf("\n" + name + "\n")）。
        this.freeFuncs = "\n"
        i = 0
        while (i < n) {
            if (src.kindOf(i) == "HirFunction") {
                if (this.ownerClassNameOf(i) == "") {
                    val fn: String = src.textOf(i)
                    if (fn != "") {
                        this.freeFuncs = this.freeFuncs + fn + "\n"
                    }
                }
            }
            i = i + 1
        }

        // 字段布局缓存：登记阶段到此结束，`classFields` 后续只读。
        // 必须放在**最后**（见 `buildFieldLayoutCache` 的注释）。
        this.buildFieldLayoutCache(src)
    }

    /// 是否为顶层自由函数。
    private fun isFreeFunc(name: String): Boolean {
        if (name == "" || this.freeFuncs == "") {
            return false
        }
        return this.freeFuncs.indexOf("\n" + name + "\n") >= 0
    }

    /// 把自由函数列表拼接成 `\nfn1\nfn2\n` 格式（供 `isFreeFunc` 的 indexOf 匹配）。
    /// 避免逐条 `this.freeFuncs + x` 的 O(n²) 拼接。
    private fun joinFreeFuncs(fns: List<String>): String {
        if (fns.size == 0) {
            return ""
        }
        // 不能用 StringBuilder（它是 object 单例，无法 new 独立实例）。
        // 用 List<String> 分步收集，最后一次 + 拼接（O(n) 而非 O(n²)）。
        val parts: ArrayList<String> = arrayListOf<String>()
        parts.add("\n")
        var i: Int = 0
        while (i < fns.size) {
            parts.add(fns[i])
            parts.add("\n")
            i = i + 1
        }
        // ⚠️ 必须显式传 `sep=""`：joinPieces 的签名是 `(parts, sep)` 双参。
        // 漏写实参时种子编译器**不报错**，缺失参数落成未初始化内存（垃圾字节）
        // ⇒ freeFuncs 整串损坏 ⇒ isFreeFunc 永远 false ⇒ 用户自由函数
        // `add(3,4)` 落进「唯一属主」回退被改写成 `ArrayList_add`
        // （实测 tests/photon/P1/05_functions.aura 一进 main 即 0xC0000005）。
        return joinPieces(parts, "")
    }

    /// 一次性构建**类字段布局缓存**（`buildClassIndex` 的收尾步骤）。
    ///
    /// 把 `classFields` 里 `Class|field|index|auraTy|defaultNodeId` 的每张记录
    /// 按「(类名, 布局序号)」填进两张下标数组，使
    /// `classFieldTotal` / `classSizeOf` / `fieldTypeOfIndex` / `fieldDefaultOfIndex`
    /// 从「整张 CSV 全量线性扫描」降为 O(1)。
    ///
    /// **必须放在 `buildClassIndex` 的**最后**（见其注释）**：缓存只覆盖
    /// `classList`（真类）与 `singletonList`（`object` 单例）—— 而
    /// `HirExternObject` 的成员虽走 `registerClassBodyEx` 登记字段，却**不**进
    /// 这两张遍历列表。它们从不走 `classFieldTotal`（`classSizeOf` 只对 `__new`
    /// 与 `_getInstance` 调用），缓存缺它们是**有意为之**；把它们纳入遍历反而会
    /// 在布局查找里引入空项。
    ///
    /// ⚠️ 不能用 `mutableListOf<Int>`：本仓库已在多处记录 `List<Int>` +
    /// 索引/`add` 组合在 AOT 运行时下的崩溃坑（见 `scanInitArities` 注释、
    /// `Emit.aura:9502`）。因此整型表沿用本文件惯例 —— **定宽 8 字符**的
    /// `|` 分隔字符串，槽宽恒为 9 字符，下标 `k` 的值起于偏移 `1 + k * 9`。
    /// 缓存构建是一次性、规模小（类数 + 字段数），字符串拼接总量可忽略。
    private fun buildFieldLayoutCache(src: Hir) {
        val text: String = this.classFields
        if (text == "") {
            return
        }

        // ── 第一遍：解析全部记录（每条只 `substring` 一次，之后不再触碰 CSV）──
        // ⚠️ 每条记录都要自己解析属主，**不能**复用上一张的：单例
        // （`HirObject`/`HirExternObject`）的成员挂在节点下、无 HirBlock 包裹，
        // 字段与方法的登记顺序交错，相邻字段属主可能不同。
        val recs: List<String> = arrayListOf<String>()
        val recNames: List<String> = arrayListOf<String>()
        val recIdxs: List<String> = arrayListOf<String>()
        val recTys: List<String> = arrayListOf<String>()
        val recDefs: List<String> = arrayListOf<String>()
        // ⚠️ 用 `i <= textLen` 并在 `i == textLen` 时把边界字符视作换行：
        // `classFields` 由 `addField` 拼成 `\nClass|...|...\n` 串，**不**保证结尾有
        // 换行（`addField` 只在追加时补 `\n`，最后一个字符可能就是记录内容）。
        // 用 `i < textLen` 会静默丢掉**最后一条记录** —— 实测自举 `ArrayList` /
        // `ObjectHeader` 的字段布局因此整体丢失，构造器退化成
        // `Memory_alloc(16)`（无字段初始化）+ exit 16 空输出。
        val textLen: Int = text.length
        var i: Int = 0
        while (i <= textLen) {
            val c: Int = if (i == textLen) { 10 } else { text.charCodeAt(i) }
            if (c == 10) {
                val recStart: Int = i + 1
                var j: Int = recStart
                while (j < textLen && text.charCodeAt(j) != 10) {
                    j = j + 1
                }
                if (j > recStart) {
                    val rec: String = text.substring(recStart, j)
                    recs.add(rec)
                    // 行格式（2026-10-06 起）：`Class|field|index|auraTy|defNodeId`。
                    // `addField` 现在**归一化**可见性前缀（`#public|String` →
                    // `String`）后落盘——旧行格式 `Class|field|index|vis|auraTy|def`
                    // 是为绕开前缀错位而设的（ty 取第 4 段、def 取第 5 段），
                    // 归一化后多余段消失；若这里仍按旧段位取值，ty 会取到
                    // defNodeId、def 取到空串 ⇒ 所有字段默认值 -1（实例字段
                    // 全 NULL，实测 AucModule.constPool 未初始化 →
                    // strcat(NULL) 崩溃）。两端必须同步改。
                    recNames.add(this.recPart(rec, 0))
                    recIdxs.add(this.recPart(rec, 2))
                    recTys.add(this.recPart(rec, 3))
                    recDefs.add(this.recPart(rec, 4))
                }
                if (i == textLen) {
                    break
                }
                i = j
            } else {
                i = i + 1
            }
        }

        val rn: Int = recs.size
        if (rn == 0) {
            return
        }

        // ── 第二遍：收集**用到的类名**（`names` 下标 == 类序）──
        this.names = arrayListOf<String>()
        var r: Int = 0
        while (r < rn) {
            if (this.nameToIdx(recNames[r]) < 0) {
                this.names.add(recNames[r])
            }
            r = r + 1
        }
        val nc: Int = this.names.size

        // ── 第三遍：按「(类序, 布局序号)」归位 ──
        // 每类一条记录：`|<槽0 固定宽度>|<槽1>|…`。槽宽 = 8 字符（整型表）或
        // 原样拼接（类型表，类型名无分隔符）。布局序号在同一类内连续
        // （`registerClass` 用 `classBaseIndex` 递推起点、登记时 `idx + 1`），
        // 故每类字段数 = 该类最大序号 + 1，必然无缺号。
        this.clsLayoutTys = arrayListOf<String>()
        this.clsLayoutDefaults = arrayListOf<String>()
        this.clsLayoutTotal = arrayListOf<String>()
        this.clsLayoutSize = arrayListOf<String>()
        this.clsOwnCount = arrayListOf<String>()
        var c: Int = 0
        while (c < nc) {
            this.clsLayoutTys.add("|")
            this.clsLayoutDefaults.add("|")
            // ⚠️ 行格式要求**前导 `|` 分隔符**（fwGet 从偏移 1 + idx*9 读）。
            // 旧实现裸 fw(...) 无管道符 ⇒ fwGet 恒返回 "" ⇒ classSizeOf 恒落
            // 默认 16、classFieldTotal 恒 0 ⇒ 所有类实例分配不含字段区
            //（2026-10-04 缺陷 B 的最后一段：回填数值正确但读不出来）。
            this.clsLayoutTotal.add("|" + this.fw("0"))
            this.clsLayoutSize.add("|" + this.fw("16"))
            // 槽 0 留空占位（定宽 `8` 字符宽），字段数在第三遍末尾统一回填。
            this.clsOwnCount.add("|" + this.fw(""))
            c = c + 1
        }
        r = 0
        while (r < rn) {
            val ci: Int = this.nameToIdx(recNames[r])
            if (ci < 0) {
                r = r + 1
                continue
            }
            val idx: Int = this.parseIntDef(recIdxs[r], -1)
            if (idx < 0) {
                r = r + 1
                continue
            }
            // ⚠️ 布局序号在类内**连续且按声明序递增**（registerClass 用
            // classBaseIndex 递推、addField 按声明序 +1，CSV 行序 = 扫描序），
            // 故**无条件追加**即落在正确位置。
            //
            // ⚠️ 旧实现按 `fwSlotCount(clsOwnCount[ci])` 判「需否扩槽」——但
            // clsOwnCount 在循环中**从不增长**（恒 1 槽），于是 idx ≥ 2 的记录
            // 全部触发 gap 填充 ⇒ 插入 idx−1 个**空槽**：实测 fs 闭包
            // Allocator 11 字段被插成 21 槽（10 空）、FileUtils 3 字段 4 槽、
            // Syscalls 119 槽 ⇒ 类型整体错位 ⇒ fieldTypeOfIndex/默认值取错 ⇒
            // 单例 getter 的字段默认值表达式引用到无关调用（Console_writeStdout
            // undefined symbol），实例字段初值也全错（2026-10-04）。
            // `clsOwnCount` 的字段数由第三遍半按分隔符计数回填，与槽数脱钩。
            this.clsLayoutTys[ci] = this.clsLayoutTys[ci] + this.normAuraType(recTys[r]) + "|"
            // ⚠️ 每槽必须带**尾部分隔符**：fwGet 按 `1 + idx*9` 定位（每槽
            // 8 值 + 1 分隔），旧实现追加裸 `fw(def)`（stride 8、无分隔）⇒
            // 读写步长失配，读到的是**漂移后的别的槽**（实测 AucModule 的
            // 默认值整列错位：deps 拿到 slotMethodNames 的 arrayListOf、
            // 字符串字段成片 NULL → strcat(NULL) 崩溃，2026-10-06）。
            this.clsLayoutDefaults[ci] = this.clsLayoutDefaults[ci] + this.fw(recDefs[r]) + "|"
            r = r + 1
        }

        // ── 第三遍半：回填每类**自有**字段数（= 该类布局槽位数）──
        //
        // ⚠️ 字段数必须从 `clsLayoutTys` 行里的**分隔符个数**推导（fields =
        // '|' 数 − 1，行首尾各有一个装饰分隔符）。旧实现用
        // `fwSlotCount(clsLayoutTys[c]) - 1` —— 但 `clsLayoutTys` 是**变长类型
        // 名行**（如单字段类 `|Long|` 全长 7 字符），`length / 9` 的定宽槽数
        // 推导对它无意义：`|Long|` → 0 槽 → n = −1 → 0 ⇒ **所有类字段数恒
        // 0** ⇒ `classSizeOf` 恒 16 ⇒ `<Class>__new` 分配不含字段区，
        // `__field_set/get` 的 `[obj+0x10+idx*8]` 全部落在分配区之外、踩进
        // 相邻分配（实测 2026-10-04：std File 2 字段 alloc 16、路径串被
        // field_set 覆盖 ⇒ open 收到 ERROR_INVALID_NAME(123)；R13 第二次
        // 构造 stringToBuffer 内容坏；fs 探针 READLEN 截断——缺陷 B 根因）。
        // 类型名不含 `|`（泛型用 `<>`），分隔符计数可靠。
        c = 0
        while (c < nc) {
            val row: String = this.clsLayoutTys[c]
            var seps: Int = 0
            var si: Int = 0
            val slen: Int = row.length
            while (si < slen) {
                if (row.charCodeAt(si) == 124) {
                    seps = seps + 1
                }
                si = si + 1
            }
            val n: Int = seps - 1
            this.clsOwnCount[c] = "|" + this.fw(toStr(if (n < 0) 0 else n))
            c = c + 1
        }

        // ── 第四遍：算每类的**含继承**字段总数与对象大小 ──
        c = 0
        while (c < nc) {
            var total: Int = 0
            var cur: String = this.names[c]
            var depth: Int = 0
            while (cur != "" && depth < 16) {
                val ci2: Int = this.nameToIdx(cur)
                if (ci2 < 0) {
                    break
                }
                total = total + this.clsOwnCountOf(ci2)
                cur = this.parentOfClass(cur)
                depth = depth + 1
            }
            this.clsLayoutTotal[c] = "|" + this.fw(toStr(total))
            this.clsLayoutSize[c] = "|" + this.fw(toStr(16 + total * 8))
            c = c + 1
        }
    }

    /// 类**自有**字段数（缓存，下标 = 类序）。
    private fun clsOwnCountOf(ci: Int): Int {
        return this.fwInt(this.clsOwnCount[ci], 0, 0)
    }

    /// 取 `|` 分隔记录的第 `idx` 段（越界返回 ""）。只用于**单行短记录**。
    private fun recPart(rec: String, idx: Int): String {
        if (rec == "") {
            return ""
        }
        var cur: Int = 0
        var start: Int = 0
        var i: Int = 0
        val len: Int = rec.length
        while (i <= len) {
            if (i == len || rec.charCodeAt(i) == 124) {
                if (cur == idx) {
                    return rec.substring(start, i)
                }
                cur = cur + 1
                start = i + 1
            }
            i = i + 1
        }
        return ""
    }


    /// 登记单个类/结构体：继承关系 + 字段布局 + 方法属主。
    /// `kind` 区分真类（`HirClass`/`HirStruct`）与单例模块
    ///（`HirObject`/`HirExternObject`）：后者**不进** `classList`。
    private fun registerClass(src: Hir, id: Int, kind: String) {
        val name: String = src.textOf(id)
        if (name == "" || this.isBuiltinValueClass(name)) {
            return
        }
        // ⚠️ `classNamesCsv` 里已有该名**不代表**这个声明登记过：同一模块里可能
        // 同时有 `extern interface Runtime`（asm 成员）与 `object Runtime`
        //（`init` / `isInitialized` / `cleanup` 的真实 Aura 实现，见
        // `aura/lang/native/Runtime.aura`）。旧实现见到「名字已知」就整体 return，
        // 于是后者的方法既不进 `classMethods` 也不进 `ownerByNode` —— 其函数体被
        // 当成**自由函数**发射（符号 `init` 而非 `Runtime_init`），调用点
        // `@call @Runtime_init` 在链接期未定义（P4/test_runtime_init 的根因）。
        // 现在按「同类重复」判重：object / extern 各自查各自的表。
        // 同类重复才跳过：`HirExternObject` 查 `externCsv`，`HirObject` 查 `singletonCsv`。
        if (kind == "HirExternObject") {
            if (this.externCsv.indexOf("\n" + name + "\n") >= 0) {
                return
            }
        } else if (kind == "HirObject") {
            if (this.singletonCsv.indexOf("\n" + name + "\n") >= 0) {
                return
            }
        } else if (this.isClassName(name)) {
            return
        }
        this.classNamesCsv = this.classNamesCsv + "\n" + name + "\n"
        if (kind == "HirExternObject") {
            // `extern interface`：成员由编译器/运行库实现，只被调用、
            // 从不生成函数体（见 `buildAllFunctions` 的跳过逻辑）。
            this.externCsv = this.externCsv + "\n" + name + "\n"
        } else if (kind == "HirObject") {
            this.singletonCsv = this.singletonCsv + "\n" + name + "\n"
            this.singletonList.add(name)
        } else {
            this.classList.add(name)
        }
        val parent: String = src.tyOf(id)
        // ⚠️ 必须始终加 `\n` 前缀：`parentOfClass` 用 `"\n" + cls + "|"` 做
        // 唯一性查找（避免 `A` 命中 `AB`）。旧实现在 `classParents` 为空时省略
        // 前缀，导致**第一条继承记录**永远查不到 —— `Exception : Throwable()`
        // 恰好是第一个有父类的类，于是 `classFieldIndex("Exception", "message")`
        // 沿不到 `Throwable` 的字段表，`ex.message` 退化成通用 `GetField`
        // （后端不发射加载指令，返回残留寄存器）→ `strcat` 拿垃圾指针 →
        // `0xC0000005`（P4 `test_exception` 的根因）。
        if (parent != "" && parent != name) {
            this.classParents = this.classParents + "\n" + name + "|" + parent
        }

        // 字段序号起点 = 继承链上祖先的字段总数（父类字段占据前缀）
        var idx: Int = this.classBaseIndex(name)
        val kids: List<Int> = src.kidsOfList(id)
        val kn: Int = HirUtils.hirKidsCount(kids)
        var j: Int = 0
        while (j < kn) {
            val child: Int = HirUtils.hirKidsAt(kids, j)
            val ck: String = src.kindOf(child)
            if (ck == "HirBlock") {
                idx = this.registerClassBodyEx(src, name, child, idx, id, kind == "HirExternObject")
            } else if (ck == "HirVarDecl" || ck == "HirValDecl") {
                this.addField(src, name, child, idx)
                idx = idx + 1
            } else if (ck == "HirFunction" || ck == "HirNativeFunction") {
                // `HirNativeFunction` = `@native` 成员（`Memory.mmap` /
                // `Cpu.atomicAdd` / `ThreadOps.currentId`）：无函数体，
                // 登记属主只为让调用点拿到限定名。
                //
                // ⚠️ 必须**同时**调 `addClassMethod`：`classMethods` 只在
                // `registerClassBody`（类体块）里登记，而 `extern interface`
                // 的成员**直接挂在节点下**、没有 HirBlock 包裹 ⇒
                // `Memory|alloc` / `Cpu|atomicAdd` / `ThreadOps|currentId`
                // 查不到 ⇒ `methodOwnerClass` 返回 "" ⇒ 调用点退化成裸名
                // `alloc` / `write64` / `currentId`，链接期 undefined symbol。
                this.addMethodOwner(child, name)
                this.addClassMethod(name, src.textOf(child))
                // `extern interface` 的成员逐个登记（列表路径在 registerClassBodyEx 里）
                if (kind == "HirExternObject") {
                    this.externMethodsCsv = this.externMethodsCsv + "\n" + name + "|" + src.textOf(child) + "\n"
                }
            }
            j = j + 1
        }

        // 字段状态登记：只有带字段的单例才需要「惰性实例」承载字段。
        if (kind == "HirObject" && this.flatCount(this.classFields, "\n" + name + "|") > 0) {
            this.objFieldStateCsv = this.objFieldStateCsv + "\n" + name + "|1\n"
        }
    }

    /// 登记类体块（字段 + 方法），返回下一个可用字段序号。
    private fun registerClassBody(src: Hir, cls: String, blockId: Int,
                                  startIdx: Int, classNode: Int): Int {
        return this.registerClassBodyEx(src, cls, blockId, startIdx, classNode, false)
    }

    /// R62：伴生对象体降级。伴生函数在 HIR 层已带 `Class_` 前缀
    /// （见 Hir.aura `lowerBlockWithKind` 的 "HirCompanionBlock" 分支），
    /// 此处登记为**自由函数**：不设 ownerCls（否则 buildFunction 会再加
    /// 一层前缀变成 `MathUtil_MathUtil_add`）、不加 addClassMethod（伴生
    /// 函数不是实例方法，接收者定型用不上）。
    ///
    /// 伴生 `val`/`var`（如 `val BASE: Int = 100`）：暂不登记为字段——
    /// 后续 `MathUtil.BASE` 走 `__field_get` 时会因 `rawFieldIndex` 未命中
    /// 退化成通用路径（可能返回 0/崩溃）。要正确支持需单例承载伴生 val，
    /// 留作后续轮次。当前先解决函数调用链接失败。
    private fun registerCompanionBody(src: Hir, blockId: Int, startIdx: Int): Int {
        val kids: List<Int> = src.kidsOfList(blockId)
        val kn: Int = HirUtils.hirKidsCount(kids)
        var j: Int = 0
        while (j < kn) {
            // 伴生函数：名字已带前缀，作为自由函数发射，不注入 @this。
            // 无需调用 addMethodOwner / addClassMethod / addField。
            j = j + 1
        }
        return startIdx
    }

    /// `registerClassBody` 的实现体；`isExternDecl` 表示**当前声明**是
    /// `extern interface`（只有它的成员才登记进 `externMethodsCsv`）。
    ///
    /// ⚠️ 不能改用 `isExternObj(cls)` 来判断：同一模块里可能既有
    /// `extern interface Runtime` 又有 `object Runtime`，后者扫描时
    /// `isExternObj("Runtime")` 也为真 ⇒ 会把**真实实现的 Aura 方法**也登记成
    /// 「外部实现」而跳过代码生成（`Runtime_init` 未定义）。
    private fun registerClassBodyEx(src: Hir, cls: String, blockId: Int,
                                    startIdx: Int, classNode: Int,
                                    isExternDecl: Boolean): Int {
        var idx: Int = startIdx
        val kids: List<Int> = src.kidsOfList(blockId)
        val kn: Int = HirUtils.hirKidsCount(kids)
        var j: Int = 0
        while (j < kn) {
            val child: Int = HirUtils.hirKidsAt(kids, j)
            val ck: String = src.kindOf(child)
            if (ck == "HirVarDecl" || ck == "HirValDecl") {
                this.addField(src, cls, child, idx)
                idx = idx + 1
            } else if (ck == "HirFunction" || ck == "HirNativeFunction") {
                this.addMethodOwner(child, cls)
                this.addClassMethod(cls, src.textOf(child))
                if (isExternDecl) {
                    this.externMethodsCsv = this.externMethodsCsv + "\n" + cls + "|" + src.textOf(child) + "\n"
                }
                this.addMethodReturnType(src.textOf(child), src.tyOf(child))
                // 同时登记**类限定**的返回类型：同名方法（`init` / `isLocked` /
                // `getUsedSize` …）在多个类里声明时上面那张全局表会置为歧义，
                // 而调用点（`ArenaAllocator.init(...)` / `mutex.isLocked()`）
                // 的接收者类型是确定的 —— 需要这张表才能判定「返回 Boolean」。
                this.addClassMethodReturnType(cls, src.textOf(child), src.tyOf(child))
            } else if (ck == "HirBlock") {
                // 嵌套块（极少见）：继续下钻
                idx = this.registerClassBody(src, cls, child, idx, classNode)
            } else if (ck == "HirCompanionBlock") {
                // ⚠️ R62：伴生对象体（`companion object { fun add(a,b) ... }`）。
                // 伴生函数是「静态」成员：调用点 `MathUtil.add(3, 4)` 视作
                // 自由函数（不加接收者），SsaBuilder `buildFunction` 若注入
                // `@this` 形参，调用点与定义 ABI 错位一位（实测 05-classes
                // §5.8 段错误）。
                //
                // HIR 层已把伴生函数名从 `add` 改为 `MathUtil_add`
                // （`lowerBlockWithKind` 里加前缀，见 Hir.aura 同处注释）。
                // 这里不再设 ownerCls（否则 buildFunction 会再加一层前缀变
                // 成 `MathUtil_MathUtil_add`），也不加 addClassMethod
                // （伴生函数不是实例方法，接收者定型用不上）。
                idx = this.registerCompanionBody(src, child, idx)
            }
            j = j + 1
        }
        return idx
    }

    /// 登记一个字段：`Class|field|index|auraTy|defaultNodeId`。
    private fun addField(src: Hir, cls: String, declNode: Int, index: Int) {
        val fname: String = src.textOf(declNode)
        if (fname == "" || this.rawFieldIndex(cls, fname) >= 0) {
            return
        }
        // ⚠️ 记录是 `|` 分隔的，而 `tyOf` 带 `#<vis>|` 前缀（`#public|String`，
        // sealed 还会是 `#public|sealed|String`）——不归一化的话
        // `classFieldTypeByName`（flatPart 按 `|` 切）只取到 `#public` ⇒
        // 字段读取的类型全变可见性名 ⇒ `mod.constPool + escape(...)` 的
        // 拼接判不出 String → 编成**整数指针加法**（实测 .auc 装载链
        // constPool = 两个 .rdata 指针之和 → streq 野指针，2026-10-06；
        // 同族：局部量表 localTypeAdd 早已归一化，唯独字段表漏了）。
        var fty: String = this.normAuraType(src.tyOf(declNode))
        while (fty.startsWith("sealed|")) {
            fty = fty.substring(7, fty.length)
        }
        val defId: Int = this.fieldDefaultNode(src, declNode)
        this.classFields = this.classFields + "\n" + cls + "|" + fname + "|"
            + toStr(index) + "|" + fty + "|" + toStr(defId) + "\n"
    }

    /// 字段默认值表达式节点。
    ///
    /// 接受字面量（`HirLit`）和函数调用（`HirCall`，如 `arrayListOf<String>()`）。
    /// 此前只认字面量，导致 `= arrayListOf<String>()` 这类**非字面量默认值**被
    /// 忽略、字段零初始化为 null —— 自举 `Hir` / `Ast` / `Mir` 等核心类的
    /// 列表字段全部为 null，构造后首次 `add` 即触发 `movq (%rcx), %rcx`（rcx=0）崩溃。
    /// `HirCall` 不引用 `this`/局部变量（`arrayListOf()` 是纯函数调用），
    /// 在构造器合成阶段求值安全。
    private fun fieldDefaultNode(src: Hir, declNode: Int): Int {
        val kids: List<Int> = src.kidsOfList(declNode)
        if (HirUtils.hirKidsCount(kids) < 1) {
            return -1
        }
        val kid: Int = HirUtils.hirKidsAt(kids, 0)
        val k: String = src.kindOf(kid)
        if (k == "HirLit" || k == "HirCall") {
            return kid
        }
        return -1
    }

    /// 登记「方法 → 属主类」。
    private fun addMethodOwner(funcNode: Int, cls: String) {
        if (cls == "" || funcNode < 0 || funcNode >= this.ownerByNode.size) {
            return
        }
        this.ownerByNode[funcNode] = cls
    }

    /// 登记类方法名（`Class|method`），并维护「唯一属主」表。
    ///
    /// `methodOwners` 里出现第二个不同属主时，把该行改写为 `\nmethod|\n`
    /// （空属主 = 歧义），这样调用点的「唯一属主回退」只需一次 `indexOf`。
    private fun addClassMethod(cls: String, method: String) {
        if (cls == "" || method == "") {
            return
        }
        if (this.classDeclaresMethod(cls, method)) {
            return
        }
        this.classMethods = this.classMethods + "\n" + cls + "|" + method + "\n"

        val key: String = "\n" + method + "|"
        val pos: Int = this.methodOwners.indexOf(key)
        if (pos < 0) {
            this.methodOwners = this.methodOwners + key + cls + "\n"
            return
        }
        // 已存在：不同属主 → 置为歧义（属主片段留空）
        val start: Int = pos + key.length
        var i: Int = start
        val len: Int = this.methodOwners.length
        while (i < len) {
            if (this.methodOwners.charCodeAt(i) == 10) {
                break
            }
            i = i + 1
        }
        val prevOwner: String = this.methodOwners.substring(start, i)
        if (prevOwner != "" && prevOwner != cls) {
            this.methodOwners = this.methodOwners.substring(0, start)
                + this.methodOwners.substring(i, len)
        }
    }

    /// 类自身（不含继承）是否声明了该方法。
    private fun classDeclaresMethod(cls: String, method: String): Boolean {
        if (cls == "" || method == "" || this.classMethods == "") {
            return false
        }
        return this.classMethods.indexOf("\n" + cls + "|" + method + "\n") >= 0
    }

    /// 沿继承链找**声明**该方法的类（未命中返回 ""）。
    ///
    /// 返回「声明类」而不是「接收者类」：符号名由声明处决定（`Parent_m`），
    /// 子类未 override 时调用点也要落到 `Parent_m`。虚分派由 A-6 的 vtable 负责。
    private fun methodOwnerClass(cls: String, method: String): String {
        var cur: String = cls
        var depth: Int = 0
        while (cur != "" && depth < 16) {
            if (this.classDeclaresMethod(cur, method)) {
                return cur
            }
            cur = this.parentOfClass(cur)
            depth = depth + 1
        }
        return ""
    }

    /// 全局只有一个类声明该方法时返回该类，否则返回 ""（重名/未命中）。
    private fun uniqueMethodOwner(method: String): String {
        if (method == "") {
            return ""
        }
        return this.flatFieldAfter(this.methodOwners, "\n" + method + "|")
    }

    /// 登记「方法 → 返回类型」（同名方法返回类型不一致时置为歧义）。
    ///
    /// 刻意**不在登记时**用 `isClassName` 过滤：本表在 `buildClassIndex` 预扫描
    /// 期间建立，而 `classNamesCsv` 要到预扫描结束才完整 —— 中途过滤会把多数
    /// 类名误判为「非类」而丢掉。类型合法性改在**使用点**判断。
    private fun addMethodReturnType(method: String, rawTy: String) {
        // 归一化：声明节点的 `ty` 带 `#<vis>|` 可见性前缀（见 `normAuraType`），
        // 不剥掉的话 `Boolean` 会存成 `#public|Boolean`，所有「按返回类型分派」
        // 的判定（布尔定型 / 真值化）全部失手。
        val ty: String = this.normAuraType(rawTy)
        if (method == "" || ty == "") {
            return
        }
        val key: String = "\n" + method + "|"
        val pos: Int = this.methodRetTypes.indexOf(key)
        if (pos < 0) {
            this.methodRetTypes = this.methodRetTypes + key + ty + "\n"
            return
        }
        val start: Int = pos + key.length
        var i: Int = start
        val len: Int = this.methodRetTypes.length
        while (i < len) {
            if (this.methodRetTypes.charCodeAt(i) == 10) {
                break
            }
            i = i + 1
        }
        val prev: String = this.methodRetTypes.substring(start, i)
        if (prev != ty) {
            // 歧义：抹掉类型片段（留下 `\nmethod|\n`）
            this.methodRetTypes = this.methodRetTypes.substring(0, start)
                + this.methodRetTypes.substring(i, len)
        }
    }

    /// 登记「类限定：类|方法 → 返回类型」（不做歧义合并，见字段说明）。
    private fun addClassMethodReturnType(cls: String, method: String, rawTy: String) {
        val ty: String = this.normAuraType(rawTy)
        if (cls == "" || method == "" || ty == "") {
            return
        }
        val key: String = "\n" + cls + "|" + method + "|"
        if (this.classMethodRetTypes.indexOf(key) < 0) {
            this.classMethodRetTypes = this.classMethodRetTypes + key + ty + "\n"
        }
    }

    /// 类限定方法的返回类型（未命中返回 ""）。
    private fun classMethodReturnType(cls: String, method: String): String {
        if (cls == "" || method == "") {
            return ""
        }
        return this.flatFieldAfter(this.classMethodRetTypes, "\n" + cls + "|" + method + "|")
    }

    /// 方法的唯一返回类型（歧义 / 未命中返回 ""）。
    private fun uniqueMethodReturnType(method: String): String {
        if (method == "") {
            return ""
        }
        return this.flatFieldAfter(this.methodRetTypes, "\n" + method + "|")
    }

    /// 接收者表达式的**原始声明类型名**。
    ///
    /// 与 `receiverClassOf` 的区别：不要求是「已知类」，集合类型（`List<Int>` /
    /// `HashMap<String,Int>`）也会原样返回 —— 集合成员要走运行库符号，不是类前缀。
    private fun receiverTypeNameOf(src: Hir, recvNode: Int): String {
        val kind: String = src.kindOf(recvNode)
        if (kind == "HirMember") {
            // 字段接收者：类型 = 字段声明类型（先定出「哪个类」，再查字段表）
            val fname: String = src.textOf(recvNode)
            val mk: List<Int> = src.kidsOfList(recvNode)
            if (fname != "" && HirUtils.hirKidsCount(mk) >= 1) {
                val inner: Int = HirUtils.hirKidsAt(mk, 0)
                val recvCls: String = this.receiverClassOf(src, inner)
                if (recvCls != "") {
                    return this.fieldAuraTypeName(recvCls, fname)
                }
            }
            return ""
        }
        if (kind == "HirCall") {
            // 与 `receiverClassOf` 同源：构造器调用结果的接收者类型 = 被构造的类
            val cn: String = src.textOf(recvNode)
            if (cn != "" && this.isClassName(cn) && !this.isSingletonObj(cn)) {
                return cn
            }
            return ""
        }
        if (kind != "HirVar") {
            return ""
        }
        val n: String = src.textOf(recvNode)
        if (n == "this") {
            return this.curClass
        }
        return this.localTypeOf(n)
    }

    /// 是否为集合族类型名。
    private fun isCollectionTypeName(ty: String): Boolean {
        if (ty == "") {
            return false
        }
        return ty.startsWith("List") || ty.startsWith("ArrayList")
            || ty.startsWith("LinkedList") || ty.startsWith("Deque")
            || ty.startsWith("Map") || ty.startsWith("HashMap")
            || ty.startsWith("LinkedHashMap") || ty.startsWith("TreeMap")
            || ty.startsWith("Set") || ty.startsWith("HashSet")
            || ty.startsWith("LinkedHashSet") || ty.startsWith("TreeSet")
    }

    /// 集合成员 → 运行库符号（接收者不是集合族 / 成员无映射时返回 ""）。
    ///
    /// 符号名与 `PhotonRuntime` 注册的名字**必须一致**
    ///（`Collections.count` / `clear` / `getAt` / `contains` / `indexOf`）。
    private fun collectionRuntimeSymbol(recvTy: String, bare: String): String {
        if (bare == "" || !this.isCollectionTypeName(recvTy)) {
            return ""
        }
        if (bare == "size" || bare == "getSize" || bare == "count" || bare == "length") {
            return "Collections.count"
        }
        if (bare == "clear") {
            return "Collections.clear"
        }
        if (bare == "get" || bare == "getAt") {
            return "Collections.getAt"
        }
        if (bare == "contains") {
            return "Collections.contains"
        }
        if (bare == "indexOf") {
            return "Collections.indexOf"
        }
        if (bare == "add") {
            return "Collections.listAppend"
        }
        return ""
    }

    /// 扫描一个**类型声明**体，登记其方法的**返回类型**（仅元数据）。
    ///
    /// 供未标注类型局部量的定型使用（见 `methodRetTypes`）。
    ///
    /// ⚠️ 刻意**不**登记属主类名：`object` 的方法在自举链路里发射成**裸符号**
    ///（实测 `Main.hat` 有 `@fn emptyOptimizer`、没有 `@fn PeepholeOptimizerUtils_*`），
    /// 把 object 当类登记会连带改掉**定义端**的符号名（调用端/定义端两张表
    /// 必须成对改，属高风险）。只有 `HirClass` / `HirStruct` 需要属主前缀，
    /// 由 `registerClass` 负责。
    private fun scanDeclMethodReturnTypes(src: Hir, declNode: Int) {
        val kids: List<Int> = src.kidsOfList(declNode)
        val kn: Int = HirUtils.hirKidsCount(kids)
        var j: Int = 0
        while (j < kn) {
            val child: Int = HirUtils.hirKidsAt(kids, j)
            val ck: String = src.kindOf(child)
            if (ck == "HirFunction") {
                this.addMethodReturnType(src.textOf(child), src.tyOf(child))
            } else if (ck == "HirBlock") {
                this.scanBlockMethodReturnTypes(src, child)
            }
            j = j + 1
        }
    }

    /// 下钻块登记 `HirFunction` 的返回类型（含嵌套块）。
    private fun scanBlockMethodReturnTypes(src: Hir, blockNode: Int) {
        val kids: List<Int> = src.kidsOfList(blockNode)
        val kn: Int = HirUtils.hirKidsCount(kids)
        var j: Int = 0
        while (j < kn) {
            val child: Int = HirUtils.hirKidsAt(kids, j)
            val ck: String = src.kindOf(child)
            if (ck == "HirFunction") {
                this.addMethodReturnType(src.textOf(child), src.tyOf(child))
            } else if (ck == "HirBlock") {
                this.scanBlockMethodReturnTypes(src, child)
            }
            j = j + 1
        }
    }

    /// 裸名是否属于 runtime 提供的符号（这些名字**不能**加类前缀）。
    ///
    /// 与 `InstructionSelection.isRuntimeSymbol` / `mapStdlibFuncName` 的目标集合
    /// 保持一致：运行时函数是全局唯一的，类方法重名时以 runtime 为准。
    private fun isRuntimeBareName(name: String): Boolean {
        if (name == "println" || name == "print" || name == "puts") { return true }
        if (name == "toStr" || name == "strcat" || name == "toInt") { return true }
        if (name == "toFloat" || name == "toString" || name == "charCodeAt") { return true }
        if (name == "strlen" || name == "streq" || name == "strcmp") { return true }
        if (name == "exit" || name == "exitGroup") { return true }
        if (name == "arrayListOf" || name == "transform" || name == "fromCharCode") { return true }
        if (name == "ReadCStr" || name == "aura_mem_used_mb" || name == "__throw") { return true }
        if (name == "RegionEnter" || name == "RegionReset") { return true }
        if (name.startsWith("__")) { return true }
        if (name.startsWith("Memory_")) { return true }
        if (name.startsWith("Collections.")) { return true }
        if (name.startsWith("io_")) { return true }
        if (name.startsWith("String")) { return true }
        // P4: 原子操作 / ARC / 线程桥 runtime 符号
        if (name == "atomicAdd" || name == "atomicDec" || name == "cas") { return true }
        if (name == "arcIncrement" || name == "arcDecrement") { return true }
        if (name.startsWith("ThreadOps_")) { return true }
        if (name == "get" || name == "set" || name == "size" || name == "count") { return true }
        return false
    }

    /// 调用点的被调名解析：裸名 → `Class_method`（无法判定时原样返回）。
    private fun resolveMethodSymbol(src: Hir, kids: List<Int>, kCount: Int, bare: String): String {
        this.lastResolveImplicitThis = false
        if (bare == "") {
            return bare
        }
        // 0) **运行库全局裸名优先**（`exit` / `exitGroup` / `strlen` / `toStr` …）
        //
        // 这些符号在运行库里是**裸名**（`aura_runtime.obj` 导出 `exit` / `exitGroup`），
        // 若先走下面的「属主类前缀」就会生成 `Syscalls_exit` ⟶ 链接期
        // `undefined symbol: Syscalls_exit`（实测 `tests/photon/P3/06_syscall_exit.aura`：
        // `Syscalls.exit(0)` 是 `extern interface` 声明，实现由运行库提供）。
        if (this.isRuntimeBareName(bare)) {
            return bare
        }
        // 0.1) **`extern interface` 的 `Obj_method` → 运行库裸名**
        //
        // `Hir.aura::lowerCall` 的 P1 fix 把 `Uppercase.m(...)` 一律限定成
        // `Uppercase_m`，但 `extern interface`（`Syscalls` / …）的实现由运行库
        // 以**裸名**提供：`Syscalls.exit(0)` 因此成了 `Syscalls_exit` ⟶
        // 链接期 `undefined symbol: Syscalls_exit`（实测 P3/06_syscall_exit.aura）。
        // 只在「前缀是 `extern interface` 名」**且**「后缀确实是运行库裸名」时剥前缀，
        // 避免误伤本就带前缀的 `Memory_alloc` / `ProcessOps_execve` / `ThreadOps_*`。
        val us: Int = bare.indexOf("_")
        if (us > 0 && this.externCsv.indexOf("\n" + bare.substring(0, us) + "\n") >= 0) {
            val tail: String = bare.substring(us + 1, bare.length)
            if (this.isRuntimeBareName(tail)) {
                return tail
            }
        }
        // `length`/`size`（字符串）与集合映射都需要接收者的**真实声明类型**，
        // 见 `localTypeAdd` 的归一化说明。

        // 0) **集合族接收者 → 运行库符号**（先于其它一切判定，且不依赖 `classMethods`）
        //
        // `Hir.aura` 层也维护了同一张表，但它在 AST 上**拿不到标识符的类型**
        //（`ast.tyOf(ident)` 为空），所以 `tags.size` / `x.clear()` 这类调用
        // 屡次漏映射、退化成裸名。这里在 SSA 侧做：`localTypes` 里有
        // `tags: List<Int>`、字段表里有 `HashMap<..>` 这类**真实声明类型**。
        //
        // 自举 `Main.aura` 实测剩最后的 `size` / `getSize` / `clear`
        // （HAT: `@call @size(@tags, @memtoken)`），运行库侧
        // `Collections.count` / `Collections.clear` 已就位。
        if (kCount >= 1) {
            val recvTy: String = this.receiverTypeNameOf(src, HirUtils.hirKidsAt(kids, 0))
            val rtSym: String = this.collectionRuntimeSymbol(recvTy, bare)
            if (rtSym != "") {
                return rtSym
            }
            // 0.5) **字符串 `s.length()` / `s.size()`（带括号）→ 运行库 `strlen`**
            //
            // 属性式（`s.length`，无括号）在 `buildFieldGet` 里已降级为 `strlen`；
            // 带括号的形式走 `buildCall`→本方法，若不在这里映射，会落到下面的
            // 「方法属主」兜底 —— `length` 的**唯一属主**是 `StringBuilder`
            // ⇒ 生成 `@call @StringBuilder_length(s, mem)`，把字符串指针当
            // StringBuilder 读字段 ⇒ 长度变成垃圾大整数
            //（实测 `tests/photon/P2/04_string_ops.aura`：`len = 4404577004589182066`，
            //  VM 为 11）。与属性式保持一致，直接映射 `strlen`（按 NUL 结尾计算）。
            if ((bare == "length" || bare == "size") && recvTy == "String") {
                return "strlen"
            }
        }

        if (this.classMethods == "") {
            return bare
        }
        // 1) 接收者静态类型已知 → 沿继承链找声明类
        if (kCount >= 1) {
            val recvCls: String = this.receiverClassOf(src, HirUtils.hirKidsAt(kids, 0))
            if (recvCls != "") {
                val owner: String = this.methodOwnerClass(recvCls, bare)
                if (owner != "") {
                    val sym: String = owner + "_" + bare
                    if (bare == "init" && this.initOverloaded(owner)) {
                        return sym + toStr(kCount)
                    }
                    return sym
                }
            }
        }
        // 2) **隐式 `this`**：无接收者可判时（`hexDigit(hi)` 这种类内裸调用），
        //    当前方法所属类若声明了该方法就用它 —— 私有 helper 的常规形态。
        //
        // ⚠️ 必须排在「唯一属主」之前：`hexDigit` 被 `X86Encoder` 与
        //    `PhotonObjectWriter` **同时**声明，唯一属主判定会得到「歧义」→
        //    回落到裸名 → lld-link `undefined symbol: hexDigit`。
        if (this.curClass != "" && !this.isFreeFunc(bare)
            && this.classDeclaresMethod(this.curClass, bare)) {
            this.lastResolveImplicitThis = true
            return this.curClass + "_" + bare
        }
        // 3) 全局唯一属主（且与 runtime 符号、顶层自由函数都不冲突）
        if (!this.isRuntimeBareName(bare) && !this.isFreeFunc(bare)) {
            val only: String = this.uniqueMethodOwner(bare)
            if (only != "") {
                return only + "_" + bare
            }
        }
        // 3) 保底：维持裸名（runtime 函数 / object 方法 / 无法判定）
        return bare
    }

    /// 零值常量（按声明类型选整型/浮点/指针）。
    private fun zeroConstOf(ty: String): Int {
        if (ty != "") {
            val typeId: Int = this.types.fromTypeName(ty)
            if (this.types.isInt(typeId)) {
                return this.program.addValue("Const", typeId, "", "0", this.curBlock)
            }
            if (this.types.isFloat(typeId)) {
                return this.program.addValue("Const", typeId, "", "0.0", this.curBlock)
            }
        }
        return this.program.addValue("Const", this.types.intType(64), "", "0", this.curBlock)
    }

    /// 字段读取：`__field_get(obj, index)`。
    private fun emitFieldGet(objVal: Int, ty: String, fieldIndex: Int): Int {
        val idxVal: Int = this.program.addValue("Const", this.types.intType(64), "",
                                                toStr(fieldIndex), this.curBlock)
        val args: String = toStr(objVal) + "," + toStr(idxVal)
        var useTy: String = ty
        if (useTy == "") {
            useTy = "Long"
        }
        val typeId: Int = this.types.fromTypeName(useTy)
        val v: Int = this.program.addValue("Call", typeId, args, "__field_get", this.curBlock)
        // ⚠️ 读取**不推进内存链**：字段读不改内存，额外的 MemToken 只是让 DAG
        //    多一个节点。自举 Main.aura 的字段读有几万处，每个 MemToken 都会让
        //    Phase D（寄存器分配）的 O(N²) 扫描多一格 —— 实测这一项就是 8 GiB
        //    内存闸门被打穿的临界差额。写操作（emitFieldSet）仍推进内存链。
        return v
    }

    /// 字段写入：`__field_set(obj, index, val)`。
    private fun emitFieldSet(objVal: Int, fieldIndex: Int, valVal: Int): Int {
        val idxVal: Int = this.program.addValue("Const", this.types.intType(64), "",
                                                toStr(fieldIndex), this.curBlock)
        val args: String = toStr(objVal) + "," + toStr(idxVal) + "," + toStr(valVal)
        val v: Int = this.program.addValue("Call", this.types.fromTypeName("Long"),
                                           args, "__field_set", this.curBlock)
        if (this.memHead >= 0) {
            val memTypeId: Int = this.types.intType(64)
            this.memHead = this.program.addValue("MemToken", memTypeId, toStr(v),
                                                 "mem_after_set", this.curBlock)
        }
        return v
    }

    /// 统计 HIR 函数节点的**显式**形参个数（不含隐式 `this`）。
    ///
    /// `lowerFunction` 把 `Params` 展开成若干同级 `HirParam`，所以直接数
    /// kids 里的 `HirParam` 即可。供构造器重载按元数消歧
    ///（`Exception_init1` / `Exception__new1`）。
    private fun hirExplicitParamCount(src: Hir, id: Int): Int {
        val kids: List<Int> = src.kidsOfList(id)
        val kn: Int = HirUtils.hirKidsCount(kids)
        var cnt: Int = 0
        var j: Int = 0
        while (j < kn) {
            if (src.kindOf(HirUtils.hirKidsAt(kids, j)) == "HirParam") {
                cnt = cnt + 1
            }
            j = j + 1
        }
        return cnt
    }

    /// 预扫描全部 `init` 节点，把「属主类 → 去重元数集合」登记进
    /// `initArityCsv`。必须在 `synthesizeCtors` 之前跑。
    ///
    /// ⚠️ 只做**字符串拼接 + `indexOf`**：不能用 `mutableListOf<Int>` 收集
    /// 元数。实测 `List<Int>` + `contains`/`add`/`isEmpty`/索引 + 手写插入排序
    /// 组合下来，driver 自举在字符串工具函数里 `0xC0000005`（P1 全挂、
    /// 崩溃偏移与输入无关）—— `ArrayList<Any>` 与泛型装箱路径在 AOT 运行时
    /// 下不可靠（同 `Emit.aura:9502` 的 `MutableList<...>` 递归坑）。
    private fun scanInitArities(src: Hir) {
        val n: Int = src.count
        var i: Int = 0
        while (i < n) {
            if (src.kindOf(i) == "HirFunction" && src.textOf(i) == "init") {
                val owner: String = this.ownerClassNameOf(i)
                if (owner != "") {
                    val ar: String = toStr(this.hirExplicitParamCount(src, i))
                    this.addCtorArity(owner, this.hirExplicitParamCount(src, i))
                }
            }
            // ── 调用点：`Foo(a, b, …)` → 需要 `Foo__new<n>` ──
            //
            // ⚠️ 只扫 `init` **声明**是不够的：`buildCall` 用的是**调用点实参个数**
            //（`funcName + "__new" + kCount`），而很多类根本没写 `init`
            //（`class Span(a,b,c,d,e,f)` 这种**主构造参数**写法），于是声明侧扫出的
            // 元数集合里没有调用点那个数 ⇒ `Span__new6` / `Parser__new1` /
            // `AotOptions__new4` 等 7 个符号未定义（实测自举 `Main.exe` 链接失败）。
            //
            // HIR call 节点的 kids 是否含 callee 子节点不必确定：`kn` 与 `kn-1`
            // 两种都登记，多合成一个 `__new` 是无害的（幂等且体积可忽略）。
            if (src.kindOf(i) == "HirCall") {
                val callee: String = src.textOf(i)
                // ⚠️ P40x 改为按元数去重补登记。旧实现 initAritiesOf == "" 是
                // 整类跳闸：首个调用点的元数定终身——同类后续不同元数的调用点
                // 永不登记（实测语言测试 05-classes：Score("Math",90) 登记
                // __new2 后，Score__new3 / Money__new2 永不合成 → 链接 undefined）。
                if (callee != "" && this.isClassName(callee)) {
                    val kn: Int = HirUtils.hirKidsCount(src.kidsOfList(i))
                    if (kn > 0) {
                        val known: String = this.initAritiesOf(callee)
                        if (known.indexOf("\n" + toStr(kn) + "\n") < 0) {
                            this.addCtorArity(callee, kn)
                        }
                        val km1: Int = kn - 1
                        if (km1 >= 0 && known.indexOf("\n" + toStr(km1) + "\n") < 0) {
                            this.addCtorArity(callee, km1)
                        }
                    }
                }
            }
            i = i + 1
        }
    }

    /// 把「类名 | 元数」登记进 `initArityCsv`（幂等；CSV 格式 `\nOwner|arity\n`）。
    private fun addCtorArity(cls: String, ar: Int): Unit {
        if (cls == "" || ar < 0) {
            return
        }
        val key: String = "\n" + cls + "|" + toStr(ar) + "\n"
        if (this.initArityCsv.indexOf(key) < 0) {
            this.initArityCsv = this.initArityCsv + key
        }
    }

    /// 本类的**全部** `init` 元数（去重、扫描顺序）。
    /// CSV 格式 `\nOwner|arity\n`；按 `\n<cls>|` 定位行首、取 `|` 到行尾为元数。
    private fun initAritiesOf(cls: String): String {
        if (cls == "") {
            return "0"
        }
        var out: String = ""
        var csv: String = this.initArityCsv
        val clsLen: Int = cls.length
        val len: Int = csv.length
        var i: Int = 0
        while (i + clsLen + 2 <= len) {
            if (csv.charCodeAt(i) == 10
                    && cls == csv.substring(i + 1, i + 1 + clsLen)
                    && csv.charCodeAt(i + 1 + clsLen) == 124) {
                val arStart: Int = i + 2 + clsLen
                var arEnd: Int = arStart
                while (arEnd < len && csv.charCodeAt(arEnd) != 10) {
                    arEnd = arEnd + 1
                }
                if (arEnd > arStart) {
                    val ar: String = csv.substring(arStart, arEnd)
                    if (out.indexOf("\n" + ar + "\n") < 0) {
                        out = out + "\n" + ar + "\n"
                    }
                }
                i = arEnd + 1
            } else {
                i = i + 1
            }
        }
        return out
    }

    /// 本类的 `init` 是否有**真重载**（多个不同元数）。
    ///
    /// 只有真有重载时才按元数消歧（`Exception` 有 3 个构造器 →
    /// `Exception_init0/1/2`）；`ArenaAllocator.init(size)` 这类**普通同名方法**
    /// 只有 1 个 `init`，加后缀会把定义落成 `ArenaAllocator_init1` 而调用点
    /// 仍是 `ArenaAllocator_init`（P4 `probe_arena` / `test_memory_alloc` 的
    /// undefined symbol）。
    private fun initOverloaded(cls: String): Boolean {
        var csv: String = this.initAritiesOf(cls)
        var n: Int = 0
        var j: Int = 0
        val len: Int = csv.length
        while (j < len) {
            if (csv.charCodeAt(j) == 10) {
                n = n + 1
            }
            j = j + 1
        }
        return n > 2
    }

    /// 为每个类、每个**观测到的元数**合成构造器 `<Class>__new<ar>`。
    ///
    /// 元数集合 = 声明侧（`scanInitArities`）∪ {0}。裸 `Class()` 构造必须总能
    /// 落到 `__new0`；多参构造（`Exception("m")`）落到 `__new1`。
    ///
    /// P1 优化：按 chunk 处理（每 32 个类），每个 chunk 结束后释放中间状态，
    /// 降低峰值内存并避免长时间持有大量 SSA 中间表示。
    private fun synthesizeCtors(src: Hir) {
        val savedMem: Int = this.memHead
        val savedBlock: Int = this.curBlock
        val savedClass: String = this.curClass
        val savedVarMap: String = this.varMap
        val savedParams: String = this.curParams
        val savedLocalTypes: String = this.localTypes

        val lty: Int = this.types.fromTypeName("Long")
        val CHUNK_SIZE: Int = 32
        var ci: Int = 0
        while (ci < this.classList.size) {
            val chunkEnd: Int = min(ci + CHUNK_SIZE, this.classList.size)
            // 每个 chunk 开始前保存状态（synthesizeCctorBody 会修改这些）
            val chunkMem: Int = this.memHead
            val chunkBlock: Int = this.curBlock
            val chunkClass: String = this.curClass
            val chunkVarMap: String = this.varMap
            val chunkParams: String = this.curParams
            val chunkLocalTypes: String = this.localTypes

            while (ci < chunkEnd) {
                val cname: String = this.classList[ci]
                // 「0,\n<元数>\n」前缀保证裸构造总有落点；`initAritiesOf` 已去重，
                // 这里只需再对 0 去一次。
                var arStr: String = "0" + this.initAritiesOf(cname)
                if (arStr.indexOf("\n0\n") < 0) {
                    arStr = arStr + "\n0\n"
                }
                var ai: Int = 0
                val alen: Int = arStr.length
                while (ai < alen) {
                    if (arStr.charCodeAt(ai) == 10) {
                        val astart: Int = ai + 1
                        var ae: Int = astart
                        while (ae < alen && arStr.charCodeAt(ae) != 10) {
                            ae = ae + 1
                        }
                        if (ae > astart) {
                            this.synthesizeCctorBody(src, cname, arStr.substring(astart, ae), lty)
                        }
                        ai = ae + 1
                    } else {
                        ai = ai + 1
                    }
                }
                ci = ci + 1
            }

            // chunk 结束后恢复状态，释放 chunk 内的中间 SSA
            this.memHead = chunkMem
            this.curBlock = chunkBlock
            this.curClass = chunkClass
            this.varMap = chunkVarMap
            this.curParams = chunkParams
            this.localTypes = chunkLocalTypes
        }

        this.memHead = savedMem
        this.curBlock = savedBlock
        this.curClass = savedClass
        this.varMap = savedVarMap
        this.curParams = savedParams
        this.localTypes = savedLocalTypes
    }

    /// 合成单个构造器 `<Class>__new<ar>`（`ar` 个形参，返回对象指针）。
    ///
    /// 形参统一按 64 位建模：调用点会把构造实参 + 内存链 token 一起压进
    /// rcx/rdx/r8/r9，本函数只读前 `ar` 个，多出来的实参无害。
    ///
    /// ⚠️ 构造体**不**写在这里：分配与字段默认值做完后，把实参原样转发给
    /// `<Class>_init<ar>`（真构造器体：`super(...)` 委托 + 字段初始化）。
    /// 此前 init 体被完全忽略，构造参数无处落地 —— P4 `test_exception` 的
    /// `Exception("Test exception").message` 恒为空。只有父类**真有重载**
    /// （多个 `init`）时才有 `<N>` 后缀，与 `buildFunction` / `buildCall` 一致。
    private fun synthesizeCctorBody(src: Hir, cname: String, ar: String, lty: Int) {
        val fid: Int = this.program.addFunction(cname + "__new" + ar, 0, lty, false)
        val entry: Int = this.program.addBlock()
        this.curBlock = entry
        this.curClass = cname
        this.memHead = -1
        this.varMap = ""
        this.curParams = ""
        this.localTypes = ""

        // 构造实参：Aura 的 Int / Long / Double / 指针都是 8 字节，统一按 64 位
        // 建模；顺序与 `<Class>_init<ar>` 的声明顺序一致。
        val l64: Int = this.types.intType(64)
        val total: Int = SsaMirUtils.strToInt(ar)
        var pi: Int = 0
        while (pi < total) {
            val pv: Int = this.program.addValue("Param", l64, "", "p" + toStr(pi), entry)
            if (this.curParams == "") {
                this.curParams = toStr(pv)
            } else {
                this.curParams = this.curParams + "," + toStr(pv)
            }
            pi = pi + 1
        }

        val sizeVal: Int = this.program.addValue("Const", l64, "",
                toStr(this.classSizeOf(cname)), this.curBlock)
        val objVal: Int = this.program.addValue("Call", lty, toStr(sizeVal),
                "Memory_alloc", this.curBlock)

        val fieldTotal: Int = this.classFieldTotal(cname)
        var fi: Int = 0
        while (fi < fieldTotal) {
            val fty: String = this.fieldTypeOfIndex(cname, fi)
            val defNode: Int = this.fieldDefaultOfIndex(cname, fi)
            var dv: Int = -1
            if (defNode >= 0) {
                dv = this.buildExpr(src, defNode)
            } else {
                dv = this.zeroConstOf(fty)
            }
            this.emitFieldSet(objVal, fi, dv)
            fi = fi + 1
        }

        // 把构造实参转发给 `<Class>_init` / `<Class>_init<ar>`：
        // `constructor(m) : super(m) { }` 的字段初始化写在 init 体里
        //（经 `super` 降级），`__new` 只负责分配与默认值。
        //
        // ⚠️ 此前只在 `initOverloaded(cname)` 为 true 时调用，导致**单
        // init 类**（如 `Exception("msg")`）的 init 体被完全跳过 —— 构造参数
        // 无处落地，字段初始化也全部丢失（P4 `test_exception` 的
        // `message` 恒为空）。现在只要有 init 就调用：重载时加 `<ar>` 后缀，
        // 非重载时用裸名，与 `buildFunction` / `buildCall` 一致。
        if (this.classDeclaresMethod(cname, "init")) {
            var initArgs: String = toStr(objVal)
            if (this.curParams != "") {
                initArgs = initArgs + "," + this.curParams
            }
            val initFunc: String = if (this.initOverloaded(cname))
                cname + "_init" + ar else cname + "_init"
            this.program.addValue("Call", lty, initArgs, initFunc, this.curBlock)
            // 父类 init 由 `<Sub>_init<ar>` 体内的 `super(...)` 降级处理
            //（见 `buildCall` 的 `super` 分支），这里不再重复调用。
        }

        this.program.setTerminator(this.curBlock, "Ret", 0, toStr(objVal), "")
        this.program.functionOf(fid).entryBlock = entry
        this.program.functionOf(fid).params = this.curParams
        this.program.endFunction()
    }

    /// 为每个**带字段状态**的单例模块合成 `<Name>_getInstance()`
    ///（0 形参，返回对象指针）。
    ///
    /// ⚠️ 单例模块（`object` / `extern interface`）**没有 `this` 形参**
    ///（`Mutex.lock(m)` 的调用点不传接收者，见 `buildFunction` / `buildCall`），
    /// 于是 `this.x` 这类字段访问落不到真实对象指针上。实测后果：
    /// `GC.isEnabled()` 降级成 `@field(0, mem)`（对象指针恒 0），
    /// `__field_get` 的「对象为 0 → 返回 0」兜底让**所有单例字段读恒返回 0**、
    /// 写也一律被丢弃 —— `GC.collect()` 的 `gcCount` 永远加不上去（P4 全 0 的
    /// 第二根因）。
    ///
    /// 解法：`this` 在单例方法里解析成一次 `<Name>_getInstance()` 调用。本方法
    /// 生成该函数：先用 `.data` 里的 `objSlots` 表判空，为空则
    /// `Memory_alloc(classSizeOf)` + 逐字段写默认值，之后返回缓存指针。
    /// 对象布局与 `synthesizeCtors` 完全一致（`[0] vtable [8] size [16+i*8] 字段`），
    /// `__field_get` / `__field_set` 无需任何改动。
    ///
    /// P1 优化：按 chunk 处理（每 32 个单例），降低峰值内存。
    private fun synthesizeSingletons(src: Hir) {
        val savedMem: Int = this.memHead
        val savedBlock: Int = this.curBlock
        val savedClass: String = this.curClass
        val savedVarMap: String = this.varMap
        val savedParams: String = this.curParams
        val savedLocalTypes: String = this.localTypes

        val lty: Int = this.types.fromTypeName("Long")
        val CHUNK_SIZE: Int = 32
        // ⚠️ 单例名单必须遍历 **singletonCsv**（串表），不能遍历
        // `singletonList`（ArrayList）：红线①——`List.add` 在 seed AOT 载体下
        // 会**静默丢元素**（实测 MirUtils 的 add 丢失 ⇒ getter 未合成 ⇒
        // VM runner 链接失败 `undefined symbol: MirUtils_getInstance`，
        // 2026-10-06）。singletonCsv 与 singletonList 在 registerClass
        // 同步登记，串表无丢失。
        val csv: String = this.singletonCsv
        // 数非空行（条目以 \n 分隔；registerClass 的 `\n + name + \n` 追加
        // 会在条目间产生空行，必须跳过）。
        var total: Int = 0
        var p0: Int = 0
        while (p0 < csv.length) {
            var e0: Int = p0
            while (e0 < csv.length) {
                if ((csv.charCodeAt(e0) as Int) == 10) { break }
                e0 = e0 + 1
            }
            if (e0 > p0) { total = total + 1 }
            if (e0 >= csv.length) { break }
            p0 = e0 + 1
        }
        var ci: Int = 0
        while (ci < total) {
            val chunkEnd: Int = min(ci + CHUNK_SIZE, total)
            // 每个 chunk 开始前保存状态
            val chunkMem: Int = this.memHead
            val chunkBlock: Int = this.curBlock
            val chunkClass: String = this.curClass
            val chunkVarMap: String = this.varMap
            val chunkParams: String = this.curParams
            val chunkLocalTypes: String = this.localTypes

            while (ci < chunkEnd) {
                val sname: String = this.singletonCsvLineAt(csv, ci)
                // 纯静态单例（`Mutex` / `Thread` / `Cpu`，无字段）也要生成：
                // `buildFunction` 对**所有**单例方法都把 `this` 解析成
                // `<Owner>_getInstance()` 的一次调用（见下），不生成就会在链接期
                // `undefined symbol: Mutex_getInstance`。无字段时它只分配 16 字节
                // 空壳，代价可忽略。
                if (sname != "") {
                    this.synthesizeSingletonGetter(src, sname, lty, ci)
                }
                ci = ci + 1
            }

            // chunk 结束后恢复状态，释放 chunk 内的中间 SSA
            this.memHead = chunkMem
            this.curBlock = chunkBlock
            this.curClass = chunkClass
            this.varMap = chunkVarMap
            this.curParams = chunkParams
            this.localTypes = chunkLocalTypes
        }

        this.memHead = savedMem
        this.curBlock = savedBlock
        this.curClass = savedClass
        this.varMap = savedVarMap
        this.curParams = savedParams
        this.localTypes = savedLocalTypes
    }

    /// 溶解对象 getter 收尾（见 `build` 内调用点说明）。
    ///
    /// 两段式：先扫函数名表把缺失前缀收进 CSV 串（禁 ArrayList.add——红线①），
    /// 再按行补合成，槽位接在已注册单例之后（runtime `objSlots` 512 槽，充裕）。
    private fun synthesizeDissolvedGetters(src: Hir) {
        var missingCsv: String = ""
        var vi: Int = 0
        val vn: Int = this.program.valueCount
        while (vi < vn) {
            // ⚠️ 红线⑤：链式临时值（valueOf(...).aux）必须先落**局部变量**
            // 再读字段 —— seed AOT 下链式读取会失真。
            val vv: MirValue = this.program.valueOf(vi)
            val aux: String = vv.aux
            // 精确后缀 `_getInstance`（`"_getInstance".length == 12`）。
            val us: Int = aux.indexOf("_getInstance")
            if (us > 0 && aux.length == us + 12) {
                val prefix: String = aux.substring(0, us)
                if (prefix != "") {
                    val c0: Int = prefix.charCodeAt(0) as Int
                    // ⚠️ 只查 singletonCsv：被溶解对象的漏登记恰恰是「进了
                    // classNamesCsv（以类形态）却没进 singletonCsv」——若这里
                    // 还查 isClassName，MirUtils 会被挡住（实测 P130）。
                    if (c0 >= 65 && c0 <= 90 && !this.isSingletonObj(prefix)
                            && missingCsv.indexOf("\n" + prefix + "\n") < 0) {
                        missingCsv = missingCsv + "\n" + prefix + "\n"
                    }
                }
            }
            vi = vi + 1
        }
        if (missingCsv == "") {
            return
        }
        val savedMem: Int = this.memHead
        val savedBlock: Int = this.curBlock
        val savedClass: String = this.curClass
        val savedVarMap: String = this.varMap
        val savedParams: String = this.curParams
        val savedLocalTypes: String = this.localTypes
        val lty: Int = this.types.fromTypeName("Long")
        // 槽位起点 = singletonCsv 现有非空行数
        var slot: Int = 0
        var p0: Int = 0
        while (p0 < this.singletonCsv.length) {
            var e0: Int = p0
            while (e0 < this.singletonCsv.length) {
                if ((this.singletonCsv.charCodeAt(e0) as Int) == 10) { break }
                e0 = e0 + 1
            }
            if (e0 > p0) { slot = slot + 1 }
            if (e0 >= this.singletonCsv.length) { break }
            p0 = e0 + 1
        }
        // 补登记 + 逐个合成
        var p: Int = 0
        while (p < missingCsv.length) {
            var e: Int = p
            while (e < missingCsv.length) {
                if ((missingCsv.charCodeAt(e) as Int) == 10) { break }
                e = e + 1
            }
            if (e > p) {
                val nm: String = missingCsv.substring(p, e)
                this.singletonCsv = this.singletonCsv + nm + "\n"
                this.synthesizeSingletonGetter(src, nm, lty, slot)
                slot = slot + 1
            }
            if (e >= missingCsv.length) { break }
            p = e + 1
        }
        this.memHead = savedMem
        this.curBlock = savedBlock
        this.curClass = savedClass
        this.varMap = savedVarMap
        this.curParams = savedParams
        this.localTypes = savedLocalTypes
    }

    /// buildCall 发射点的 getter 自愈（挂在最终 `Call` 发射之前，见其注释）。
    ///
    /// `funcName` 此刻已终定（`resolveMethodSymbol` / 构造器改写之后），
    /// 命中 `X_getInstance` 且 X 未登记 ⇒ X 是被 HirLowerer「溶解」的对象：
    /// 补登记进 singletonCsv 并**就地**合成 getter（完整保存/恢复构建现场，
    /// 与 synthesizeSingletons 的 chunk 逻辑一致）。槽位取当前非空行数 ——
    /// runtime 侧 `objSlots` 固定 4096 字节 = 512 槽，迟到的槽位远不会越界。
    private fun ensureSingletonGetter(src: Hir, callee: String) {
        val us: Int = callee.indexOf("_getInstance")
        if (us <= 0 || callee.length != us + 12) {
            return
        }
        val nm: String = callee.substring(0, us)
        if (nm == "" || this.isClassName(nm) || this.isSingletonObj(nm)
                || this.isExternObj(nm)) {
            return
        }
        // 诊断探针（按需打开）：println("[singFIX] " + nm)
        this.singletonCsv = this.singletonCsv + "\n" + nm + "\n"
        this.classNamesCsv = this.classNamesCsv + "\n" + nm + "\n"
        val savedMem: Int = this.memHead
        val savedBlock: Int = this.curBlock
        val savedClass: String = this.curClass
        val savedVarMap: String = this.varMap
        val savedParams: String = this.curParams
        val savedLocalTypes: String = this.localTypes
        // slot = 当前非空行数（补登记条目在 csv 末尾）
        val csv: String = this.singletonCsv
        var slot: Int = 0
        var p: Int = 0
        while (p < csv.length) {
            var e: Int = p
            while (e < csv.length) {
                if ((csv.charCodeAt(e) as Int) == 10) { break }
                e = e + 1
            }
            if (e > p) { slot = slot + 1 }
            if (e >= csv.length) { break }
            p = e + 1
        }
        this.synthesizeSingletonGetter(src, nm, this.types.fromTypeName("Long"),
                                       slot - 1)
        this.memHead = savedMem
        this.curBlock = savedBlock
        this.curClass = savedClass
        this.varMap = savedVarMap
        this.curParams = savedParams
        this.localTypes = savedLocalTypes
    }

    /// 取 CSV 串的第 idx 个**非空**行（纯 charCodeAt 扫描；越界返回 ""）。
    /// 与 `synthesizeSingletons` 的行计数口径一致（空行不计入下标）。
    private fun singletonCsvLineAt(csv: String, idx: Int): String {
        var p: Int = 0
        var k: Int = 0
        while (p < csv.length) {
            var e: Int = p
            while (e < csv.length) {
                if ((csv.charCodeAt(e) as Int) == 10) { break }
                e = e + 1
            }
            if (e > p) {
                if (k == idx) { return csv.substring(p, e) }
                k = k + 1
            }
            if (e >= csv.length) { break }
            p = e + 1
        }
        return ""
    }

    /// 合成单个单例的惰性实例访问器（见 `synthesizeSingletons`）。
    private fun synthesizeSingletonGetter(src: Hir, sname: String, lty: Int, slot: Int) {
        val fid: Int = this.program.addFunction(sname + "_getInstance", 0, lty, false)
        val entry: Int = this.program.addBlock()
        val thenBlock: Int = this.program.addBlock()
        val elseBlock: Int = this.program.addBlock()

        this.curBlock = entry
        this.curClass = sname
        this.memHead = -1
        this.varMap = ""
        this.curParams = ""
        this.localTypes = ""

        val i64: Int = this.types.intType(64)
        val zero: Int = this.program.addValue("Const", i64, "", "0", this.curBlock)
        val slotVal: Int = this.program.addValue("Const", i64, "", toStr(slot), this.curBlock)
        val cur: Int = this.program.addValue("Call", lty, toStr(slotVal),
                                             "__obj_slot_get", this.curBlock)
        // `icmp eq(cur, 0)`：true = 尚未分配。为避免依赖 `i32_ne` 支持，
        // 用 eq + **交换 CondBr 目标块**来表达「非空则返回缓存」。
        val isNull: Int = this.program.addValue("ICmpEq", i64,
                toStr(cur) + "," + toStr(zero), "i32_eq", this.curBlock)
        this.program.setTerminator(entry, "CondBr", 0,
                toStr(isNull) + "," + toStr(elseBlock) + "," + toStr(thenBlock), "")

        // 已分配：直接返回缓存指针
        this.curBlock = thenBlock
        this.program.setTerminator(thenBlock, "Ret", lty, toStr(cur), "")

        // 未分配：`Memory_alloc(size)` + 逐字段写默认值 + 回填槽
        this.curBlock = elseBlock
        // ⚠️ 尺寸下限 128：字段索引簿记（const 占位等）与尺寸表可能不一致，
        // 欠量分配会被字段写越界、踩相邻分配（实测 Allocator 字段写 [inst+0x50]
        // 而分配仅 16B ⇒ 后续字符串缓冲区内容随机损坏，2026-10-03 fs/io 探针）。
        // 单例每进程至多一份，过量分配无害。
        var singletonSize: Int = this.classSizeOf(sname)
        if (singletonSize < 512) {
            singletonSize = 512
        }
        val sizeVal: Int = this.program.addValue("Const", i64, "",
                toStr(singletonSize), this.curBlock)
        val obj: Int = this.program.addValue("Call", lty, toStr(sizeVal),
                                             "Memory_alloc", this.curBlock)
        val total: Int = this.classFieldTotal(sname)
        var fi: Int = 0
        while (fi < total) {
            val fty: String = this.fieldTypeOfIndex(sname, fi)
            val defNode: Int = this.fieldDefaultOfIndex(sname, fi)
            var dv: Int = -1
            if (defNode >= 0) {
                dv = this.buildExpr(src, defNode)
            } else {
                dv = this.zeroConstOf(fty)
            }
            this.emitFieldSet(obj, fi, dv)
            fi = fi + 1
        }
        this.program.addValue("Call", lty, toStr(slotVal) + "," + toStr(obj),
                              "__obj_slot_set", this.curBlock)
        this.program.setTerminator(this.curBlock, "Ret", lty, toStr(obj), "")

        this.program.functionOf(fid).entryBlock = entry
        this.program.endFunction()
    }

    // ── 循环栈 ──

    /// 将块 ID 推入循环退出栈。
    private fun loopStackPush(blockId: Int) {
        if (this.loopStack == "") {
            this.loopStack = toStr(blockId)
        } else {
            this.loopStack = toStr(blockId) + "," + this.loopStack
        }
    }

    /// 从循环退出栈弹出块 ID。
    private fun loopStackPop() {
        if (this.loopStack == "") {
            return
        }
        val commaIdx: Int = this.loopStack.indexOf(",")
        if (commaIdx < 0) {
            this.loopStack = ""
        } else {
            this.loopStack = this.loopStack.substring(commaIdx + 1)
        }
    }

    /// break 目标 = 循环栈顶（endBlock）。
    /// 首个逗号下标（纯 charCodeAt；带参 indexOf 在 seed AOT 下失效）。
    private fun csvFirstComma(text: String): Int {
        var i: Int = 0
        while (i < text.length) {
            if ((text.charCodeAt(i) as Int) == 44) { return i }
            i = i + 1
        }
        return -1
    }

    /// break 目标 = 循环栈**第二项**（endBlock）。栈格式「condId,endId,…」
    /// 成对压入（2026-10-05）——⚠️ 栈顶是 continue 目标(condBlock)，
    /// break 取错项会变成 continue 死循环。
    private fun loopStackBreakTarget(): Int {
        if (this.loopStack == "") { return -1 }
        val c1: Int = this.csvFirstComma(this.loopStack)
        if (c1 < 0) { return MachineDagUtils.strToInt(this.loopStack) }
        val rest: String = this.loopStack.substring(c1 + 1)
        val c2: Int = this.csvFirstComma(rest)
        if (c2 < 0) { return MachineDagUtils.strToInt(rest) }
        return MachineDagUtils.strToInt(rest.substring(0, c2))
    }

    /// continue 目标 = 循环栈**栈顶**（condBlock）。
    private fun loopStackContinueTarget(): Int {
        if (this.loopStack == "") { return -1 }
        val c1: Int = this.csvFirstComma(this.loopStack)
        if (c1 < 0) {
            return MachineDagUtils.strToInt(this.loopStack)
        }
        return MachineDagUtils.strToInt(this.loopStack.substring(0, c1))
    }

    /// `break` 语句：Br 到当前循环的 endBlock。
    ///
    /// ⚠️ 旧实现完全没有 HirBreak/HirContinue 的分派——`break` 语句被
    /// **静默丢弃**：`while (true) { ... if (n <= 0) { break } ... }` 的
    /// 循环永不退出（实测 Photon 版 VM runner 装载 .auc 的读循环：
    /// ReadFile 因 count=0 恒返 n=0，break 又不存在 ⇒ 100% CPU 挂死，
    /// 2026-10-04）。
    private fun buildBreak(): Unit {
        val target: Int = this.loopStackBreakTarget()
        if (target < 0) { return }
        val blockObj: MirBlock = this.program.blockOf(this.curBlock)
        if (blockObj.term < 0) {
            this.program.setTerminator(this.curBlock, "Br", 0, toStr(target), "")
        }
    }

    /// `continue` 语句：Br 到当前循环的 condBlock（phi 回边值取循环体
    /// 末值——continue 点与体末值不一致时为已知不精确，见文档）。
    private fun buildContinue(): Unit {
        val target: Int = this.loopStackContinueTarget()
        if (target < 0) { return }
        // 取栈顶 phiVarEntries 的**整段**（到首个空行为止——层级间以空行
        // 分隔：buildWhile 压栈为 `phiVarEntries + "\n" + 旧栈`，而
        // phiVarEntries 每条目自带行尾换行 ⇒ 层间呈「\n\n」）。
        // ⚠️ 旧实现只取到**首个换行**——多循环变量时只有第一个变量拿到
        // continue Mov，其余变量的 continue 边无专属入边值（实测
        // probe_cont_min：i 有 Mov、total 没有 ⇒ total 的 continue 边
        // 被兜底乱配，2026-10-06）。
        val stackStr: String = this.loopPhiVarsStack
        var segEnd: Int = stackStr.length
        var si: Int = 0
        var prevNl: Boolean = false
        while (si < stackStr.length) {
            val cch: Int = stackStr.charCodeAt(si) as Int
            if (cch == 10) {
                if (prevNl) {
                    segEnd = si - 1
                    break
                }
                prevNl = true
            } else {
                prevNl = false
            }
            si = si + 1
        }
        var top: String = stackStr.substring(0, segEnd)
        // 逐条目扫描（条目以真实换行分隔；字段以 | 分隔），纯 charCodeAt
        var i: Int = 0
        while (i < top.length) {
            var eEnd: Int = i
            while (eEnd < top.length) {
                if ((top.charCodeAt(eEnd) as Int) == 10) { break }
                eEnd = eEnd + 1
            }
            val entry: String = top.substring(i, eEnd)
            if (entry != "") {
                var bar: Int = -1
                var k: Int = 0
                while (k < entry.length) {
                    if ((entry.charCodeAt(k) as Int) == 124) { bar = k; break }
                    k = k + 1
                }
                if (bar > 0) {
                    val nm: String = entry.substring(0, bar)
                    val curVid: Int = this.mapVidOf(this.varMap, nm)
                    if (curVid >= 0) {
                        // ── for 计数器递增特化（R63）──
                        // 栈顶 phiVarEntries 的第一个变量名恒为 "i"（buildFor
                        // 在收集其他变量前先创建 i phi 并压栈首位）。
                        // 对 `i` 生成 `Add(iPhi, 1)`——定义于 continue 前驱块
                        // 本身（与 Mov 位置一致），作为 continue 入边值，等价
                        // 于「continue 跳过用户体但仍执行 i++」。避免 i 的
                        // continue 入边拿到未递增值（导致循环条件永不满足，
                        // 04-control-flow §4.10 两个 for 都死循环）。
                        // while 循环栈顶首个变量名不会是 "i"（buildWhile 不
                        // 创建名为 i 的 phi），故此特化只影响 for-loop。
                        // ⚠️ 依赖 buildFor 的压栈顺序（i 在首位），故用栈顶
                        // 段首个条目的名字匹配——若将来调整 buildFor 需同步。
                        var contVid: Int = -1
                        // 判断本条目是否为栈顶段首条目（对应对应 i 变量）
                        var isFirstEntry: Boolean = (i == 0)
                        if (isFirstEntry && nm == "i") {
                            val iType: Int = this.program.valueOf(curVid).type
                            val oneCst: Int = this.program.addValue("Const", iType, "", "1", this.curBlock)
                            contVid = this.program.addValue("Add", iType, toStr(curVid) + "," + toStr(oneCst), "", this.curBlock)
                        } else {
                            // Mov 值定义于本块：phi 入边匹配（ISel pass2）按
                            // 「入边值定义块 == 前驱块」精确配对；curVid 的定义
                            // 块是 continue 前驱的支配者，精确匹配永远轮不到
                            // continue 边（2026-10-05 probe_break/runner 实证）。
                            contVid = this.program.addValue("Mov",
                                    this.program.valueOf(curVid).type, toStr(curVid),
                                    "", this.curBlock)
                        }
                        this.loopContRecs = this.loopContRecs + toStr(target) + "|" +
                                entry.substring(bar + 1) + "|" + toStr(contVid) + "\n"
                    }
                }
            }
            if (eEnd >= top.length) { break }
            i = eEnd + 1
        }
        val blockObj: MirBlock = this.program.blockOf(this.curBlock)
        if (blockObj.term < 0) {
            this.program.setTerminator(this.curBlock, "Br", 0, toStr(target), "")
        }
    }

    // ── Phase A S2: 支配分析（Dominator Tree）──

    /// 计算支配树（Phase A S2）。
    ///
    /// 使用迭代算法计算每个基本块的立即支配者（idom）。
    /// 算法：从 entry 开始，迭代更新每个块的最早已定义支配者。
    ///
    /// 返回扁平字符串 "blockId|idomBlockId\n" 格式的支配树。
    fun computeDominatorTree(): String {
        val funcCount: Int = this.program.functionCount
        var result: String = ""

        var fi: Int = 0
        while (fi < funcCount) {
            val func: MirFunction = this.program.functionOf(fi)
            val entryBlock: Int = func.entryBlock
            val blocks: List<String> = this.splitStr(func.blocks, ",")

            // 初始化：每个块的 idom = -1（未知），entry 的 idom = entry 自身
            val idom: List<String> = arrayListOf<String>()
            var bi: Int = 0
            while (bi < blocks.size) {
                val bid: Int = this.strToInt(blocks[bi])
                if (bid == entryBlock) {
                    idom.add(toStr(entryBlock))
                } else {
                    idom.add(toStr(-1))
                }
                bi = bi + 1
            }

            // 迭代直到收敛
            var changed: Boolean = true
            var iterations: Int = 0
            while (changed && iterations < 100) {
                changed = false
                iterations = iterations + 1
                bi = 0
                while (bi < blocks.size) {
                    val bid: Int = this.strToInt(blocks[bi])
                    if (bid == entryBlock) { bi = bi + 1; continue }

                    val block: MirBlock = this.program.blockOf(bid)
                    val preds: List<String> = this.splitStr(block.preds, ",")

                    // 找到第一个已定义 idom 的前驱块
                    var newIdom: Int = -1
                    var pi: Int = 0
                    while (pi < preds.size) {
                        val predId: Int = this.strToInt(preds[pi])
                        if (predId >= 0) {
                            // 找到 predId 在 idom 列表中的位置
                            var ri: Int = 0
                            while (ri < blocks.size) {
                                if (this.strToInt(blocks[ri]) == predId) {
                                    if (this.strToInt(idom[ri]) >= 0) {
                                        newIdom = this.strToInt(idom[ri])
                                        break
                                    }
                                    break
                                }
                                ri = ri + 1
                            }
                            if (newIdom >= 0) { break }
                        }
                        pi = pi + 1
                    }

                    // 处理多个前驱的情况：取交集（简化为最早定义者）
                    if (newIdom >= 0) {
                        val curIdom: Int = this.strToInt(idom[bi])
                        if (curIdom != newIdom) {
                            idom[bi] = toStr(newIdom)
                            changed = true
                        }
                    }
                    bi = bi + 1
                }
            }

            // 输出支配树
            bi = 0
            while (bi < blocks.size) {
                val bid: Int = this.strToInt(blocks[bi])
                val idomVal: String = idom[bi]
                result = result + toStr(bid) + "|" + idomVal + "\n"
                bi = bi + 1
            }
            fi = fi + 1
        }
        return result
    }

    /// 获取支配树的扁平字符串（块ID → 立即支配者块ID）。
    fun getDominatorTree(): String {
        return this.computeDominatorTree()
    }

    // ── 工具方法 ──

    /// 字符串转整数。
    private fun strToInt(text: String): Int {
        return SsaMirUtils.strToInt(text)
    }

    /// 整数转字符串。
    private fun toStr(n: Int): String {
        return SsaMirUtils.toStr(n)
    }

    /// 按单字符分隔符分割字符串（VM 不支持 String.split）。
    private fun splitStr(text: String, sep: String): List<String> {
        // 见 MirUtils.mirSplit 的说明：`arrayListOf + add` 在本 VM 下会丢元素。
        if (text == "" || sep == "") { return emptyList() }
        return text.split(sep)
    }
}

// ─────────────────────────────────────────────────────────────
// SsaBuilder 工具对象
// ─────────────────────────────────────────────────────────────

object SsaBuilderUtils {

    /// 执行 HIR → SSA 降级。
    fun build(hir: Hir): MirSsaProgram {
        val builder: SsaBuilder = SsaBuilder()
        return builder.build(hir)
    }

    /// Phase A S2: 执行 HIR → SSA → TAC 降级（连接 Linearizer 到生产路径）。
    ///
    /// 完整 SSA 路径：
    ///   1. SsaBuilder.build(hir) — HIR → SSA MIR
    ///   2. Linearizer.linearize(ssa) — SSA MIR → TAC MIR
    ///
    /// 返回 TAC MIR，可直接传递给现有 Codegen.aura。
    /// 当 Linearizer 不可用时，回退到 MirLower（TAC 直出）。
    fun buildToTAC(hir: Hir): Mir {
        // Step 1: HIR → SSA MIR
        val builder: SsaBuilder = SsaBuilder()
        val ssa: MirSsaProgram = builder.build(hir)

        // Step 2: SSA → TAC MIR（通过 Linearizer）
        val lin: Linearizer = Linearizer()
        return lin.linearize(ssa)
    }
}
