// aura:///aura/lang/compiler/lexer/Token.aura
package aura.lang.compiler.lexer
// ─────────────────────────────────────────────────────────────
// Token 数据模型 — 纯 Aura 化迁移 · Phase 1
//
// 对应 Rust `compiler/src/token.rs`。
//
// 设计说明（受当前 VM 能力约束）：
//   * `TokenKind` 以**名称字符串**表示（取值与 Rust `TokenKind` 的 Debug 名称一致，
//     如 `"Val"` / `"IntLiteral"` / `"LParen"`），因此可直接与 Rust 基线比对。
//   * `Token` 的 span 以 6 个 Int 字段平铺存放（避免类字段初始化器调用构造函数的限制）；
//     需要 `Span` 对象时调用 `span()` 物化。
// ─────────────────────────────────────────────────────────────

/// 关键字 → TokenKind 名称映射表（**每行一条 `word|Kind`**）。
///
/// 顺序与 Rust `KEYWORDS` 保持一致；`Int`/`String` 等基本类型名映射为 `Ident`。
///
/// 条目以 `\n` 分隔（而非 `|`）：这样「键」一定出现在行首，用 `\nword|` 即可
/// **无歧义**定位，无需给键加 `#` 前缀再二次拼接（见 [`keywordSearchTable`]）。
fun keywordTable(): String {
    return "val|Val\nvar|Var\nfun|Fun\nstruct|Struct\nclass|Class\ninterface|Interface"
        + "\nenum|Enum\nactor|Actor\nsealed|Sealed\nreturn|Return\nif|If\nelse|Else\nwhen|When"
        + "\nfor|For\nin|In\nwhile|While\ndo|Do\nbreak|Break\ncontinue|Continue\ntry|Try"
        + "\ncatch|Catch\nfinally|Finally\nthrow|Throw\nis|Is\nas|As\npublic|Public"
        + "\nprivate|Private\nprotected|Protected\nnull|Null\nthis|This\nsuper|Super"
        + "\nobject|Object\nunit|Unit\ntypealias|Typealias\noverride|Override\nsuspend|Suspend"
        + "\ninline|Inline\nconst|Const\ncomptime|Comptime\ndefer|Defer\nextern|Extern"
        + "\nimport|Import\nlazy|Lazy\nlateinit|Lateinit\ndata|Data\nvalue|Value\nawait|Await"
        + "\nto|To\nasync|Async\nselect|Select\nbox|Box\nweak|Weak\nmalloc|Malloc\nfree|Free"
        + "\nretain|Retain\nrelease|Release"
        + "\nInt|Ident\nLong|Ident\nShort|Ident\nByte|Ident\nFloat|Ident\nDouble|Ident"
        + "\nBoolean|Ident\nChar|Ident\nString|Ident\nAny|Ident\nNothing|Ident\nUnit|Unit"
        + "\ntrue|BoolLiteral\nfalse|BoolLiteral\nit|Ident\nby|Ident"
}

/// 关键字查询表（保留旧入口名；与 [`keywordTable`] 同形）。
///
/// 旧实现把 `keywordTable()` 先 `split("|")` 成 ~200 段、再逐项
/// `out = out + "#" + key + "|" + kind + "|"` 重建整表：每次 `Lexer` 构造
/// （每个源文件一次，且 `Parser` 的字段初值还会多构造一个哑实例）都要
/// ~200 次切片 + O(n²) 拼接。实测**词法阶段 `init` 单项即 8.8MB**。
///
/// 新格式把条目以 `\n` 分隔，键天然位于行首，`\nword|` 定位即可，无需 `#`
/// 前缀与二次拼接，故本函数退化为一次转发。
fun keywordSearchTable(): String {
    return keywordTable()
}

/// 查询标识符对应的 TokenKind 名称；非关键字返回 `"Ident"`。
///
/// 与 Rust `lookup_keyword` 等价（首次命中即返回）。本函数会重建查询表，
/// 仅适合冷路径；热路径（`Lexer.scanIdentifier`）请用缓存的表 +
/// [`keywordLookup`]（见 `Lexer.lxKwKind`）。
fun keywordKind(word: String): String {
    return keywordLookup(keywordSearchTable(), word)
}

/// 在 `word|Kind` 逐行排列的关键字查询表上查 `word` 的 Kind。
///
/// **零 `split`、零表重建**：`startsWith` / `contains` 定位 + 两次切片。
/// `\n` 分隔保证 kind 值（`Box`/`Ident`/`Unit` …）不会被误当作键命中。
fun keywordLookup(table: String, word: String): String {
    if (word == "") {
        return "Ident"
    }
    val needle: String = word + "|"
    var rest: String = ""
    if (table.startsWith(needle)) {
        rest = table.substringAfter(needle)
    } else {
        val mid: String = "\n" + needle
        if (!table.contains(mid)) {
            return "Ident"
        }
        rest = table.substringAfter(mid)
    }
    return rest.substringBefore("\n")
}

/// 是否为关键字词。
fun isKeywordWord(word: String): Boolean {
    return keywordKind(word) != "Ident"
}

/// 词法单元。
class Token {

    /// TokenKind 名称（与 Rust Debug 名一致）。
    var kind: String = ""

    /// 原始字面量文本（标识符名、字面量内容、运算符拼写等）。
    var literal: String = ""

    /// 起始字符偏移。
    var start: Int = 0

    /// 结束字符偏移（不含）。
    var end: Int = 0

    /// 起始行。
    var startLine: Int = 1

    /// 起始列。
    var startCol: Int = 1

    /// 结束行。
    var endLine: Int = 1

    /// 结束列。
    var endCol: Int = 1

    init(k: String, lit: String) {
        this.kind = k
        this.literal = lit
    }

    /// 写入 span 信息，返回自身（链式构造）。
    fun withSpan(s: Int, e: Int, sl: Int, sc: Int, el: Int, ec: Int): Token {
        this.start = s
        this.end = e
        this.startLine = sl
        this.startCol = sc
        this.endLine = el
        this.endCol = ec
        return this
    }

    /// 物化为 `Span` 对象。
    fun span(): Span {
        return Span(this.start, this.end, this.startLine, this.startCol, this.endLine, this.endCol)
    }

    /// 是否关键字。
    fun isKeyword(): Boolean {
        return isKeywordWord(this.literal)
    }

    /// 人类可读展示（对齐 Rust `Token::display`）。
    fun display(): String {
        if (this.kind == "Ident" && this.literal != "") {
            return this.literal
        }
        if (this.kind == "EOF") {
            return "<EOF>"
        }
        if (this.kind == "Error") {
            return "<Error: " + this.literal + ">"
        }
        return this.kind
    }
}
