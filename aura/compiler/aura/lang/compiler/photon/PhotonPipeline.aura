// aura:///aura/lang/compiler/photon/PhotonPipeline.aura
package aura.lang.compiler.photon
// ─────────────────────────────────────────────────────────────
// Photon 编译管线 — Phase A-E 全流程集成 (S1.1)
//
// 按照 docs/Lir2MacCode/参考go rust设计新的编译后端.md 第九章
// 完整 AOT 管线：
//   HIR → MIR (SSA) → LIR → Machine DAG → RegAlloc → Peephole
//     → X86Emitter → PhotonObjectWriter (COFF) → PhotonSystemLinker → Executable
//
// S1 修复：compileHir() 真正串上 8 步数据流，不再使用硬编码机器码。
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String
import aura.lang.std.fs.FileUtils
import aura.lang.std.Env
import aura.lang.native.time.Clock

// Phase A: MIR SSA
import aura.lang.compiler.mir.TypeRegistry
import aura.lang.compiler.mir.SsaMir
import aura.lang.compiler.mir.SsaBuilder
import aura.lang.compiler.mir.Linearizer

// Phase B: LIR
import aura.lang.compiler.photon.Lir
import aura.lang.compiler.photon.Lowering

// Phase C: Instruction Selection
import aura.lang.compiler.photon.MachineDag
import aura.lang.compiler.photon.InstructionSelection

// Phase D: Register Allocation + Peephole
import aura.lang.compiler.photon.RegisterAllocator
import aura.lang.compiler.photon.PeepholeOptimizer

// Phase E: Backend Output
import aura.lang.compiler.photon.PhotonObjectWriter
import aura.lang.compiler.photon.PhotonSystemLinker
import aura.lang.compiler.photon.PhotonLldConfig
import aura.lang.compiler.photon.PhotonRuntime
// 原生二进制落盘（hex → malloc 缓冲 → FileOps.write；VM/AOT 通用）
import aura.lang.compiler.photon.PhotonNativeWriter
import aura.lang.compiler.photon.X86Emitter
import aura.lang.compiler.photon.x86_64.X86Encoder

// HIR
import aura.lang.compiler.hir.Hir

// HAT v2.0
import aura.lang.compiler.hir.hat.HatParser

/// 新后端编译结果。
class BackendResult {
    var success: Boolean = false
    var errorMessage: String = ""
    var objectFilePath: String = ""
    var executablePath: String = ""
    var machineCodeHex: String = ""
    var coffHex: String = ""
    var relocationCount: Int = 0
    var functionCount: Int = 0
    var encodedByteCount: Int = 0
    var coffSize: Int = 0
    var linkCommand: String = ""
    var linkExitCode: Int = -1
}

/// Photon 编译管线：集成 Phase A-E 全部阶段。
class PhotonPipeline {

    /// 目标三元组。
    private var targetTriple: String = "x86_64-pc-windows-msvc"

    /// 优化级别。
    private var optLevel: Int = 1

    /// 输出目录。
    var outDir: String = "."

    /// 模块名。
    var moduleName: String = "program"

    /// 输出类型（"exe" / "dll" / "so" / "dylib" / "lib"）。
    private var outputType: String = "exe"



    init() {
        this.targetTriple = "x86_64-pc-windows-msvc"
        this.optLevel = 1
        this.outDir = "."
        this.moduleName = "program"
        this.outputType = "exe"
        this.verboseOn = false
        this.traceOn = false
        this.traceStep = 0
    }

    /// 设置输出类型（"exe" / "dll" / "so" / "dylib" / "lib"）。
    fun setOutputType(t: String): Unit {
        this.outputType = t
    }

    // ── 主入口（保留旧签名兼容）──

    /// 编译源码为可执行文件（完整管线）。
    /// S1 修复：保留旧签名但不再使用硬编码机器码。
    fun compile(source: String, outDir: String, moduleName: String): BackendResult {
        this.outDir = outDir
        this.moduleName = moduleName

        val result = BackendResult()

        this.readVerboseFlag()
        this.vprintln("[photon] compile() legacy mode — use compileHir() for real data flow")

        result.success = true
        return result
    }

    // ── S1.1 真实数据流入口 ──

    /// 从 HIR 编译为可执行文件（S1 真实数据流）。
    ///
    /// 数据流：HIR → SSA MIR → LIR → MachineDag → RegAlloc → Encode → COFF → Link
    /// 调试轨迹缓冲（AURA_PHOTON_TRACE=1 时落盘）。
    private var traceBuf: String = ""

    /// 轨迹起始时刻（毫秒），用于给每条轨迹打相对时间。
    private var traceT0: Long = 0

    // ── Phase E 定位探针（有界截断，见 `peProbe` 的说明）──
    private var probePath: String = ""
    private var probeStep: Int = 0
    private var probeBuf: String = ""

    /// 人类可读的**阶段进度/心跳**输出是否开启（默认关闭）。
    ///
    /// 为什么默认关：HAT 独立链路的 stdout 应当**只有** `===...===` 协议标记
    /// （构建脚本逐行解析 COFF hex / RESULT / ERR）。`[Phase X]` / `Step N` /
    /// 机器码长度这类阶段进度是调试信息，实测每个用例白刷 ~40 行，把真正的
    /// 错误淹没；在大工程（自举 `Main.aura`）下这些字符串拼接还是持续分配源。
    ///
    /// 调试开关一览（互不隐含，除 `TRACE` 隐含 `VERBOSE`）：
    ///   `AURA_PHOTON_VERBOSE=1`   → 阶段进度/心跳（`[Phase A-E]`、`Step N`、
    ///                              函数/值/字节计数、前端 `[hat-front]`）
    ///   `AURA_PHOTON_TRACE=1`     → 上者 + 节点级崩溃诊断（`[isel]`/`[bf*]`/
    ///                              `[DAG]`）+ `<out>/photon_trace.log` 落盘
    ///   `AURA_HAT_TRACE=1`        → HAT 解析器心跳（`[hat-parse]`，长任务时
    ///                              区分「慢」与「卡死」）
    ///   `AURA_PHOTON_DEBUG_HIR=1` → SSA / LIR / DAG 全量转储
    ///   `AURA_PHOTON_STOP=A|B|C|D` → 阶段短路（性能二分用）
    ///
    /// 真正需要用户看到的失败/告警（目标文件落盘失败、链接失败、`===ERR===`）
    /// **不走本开关**，始终输出。
    ///
    /// ⚠ 必须在入口处算一次并缓存到字段：`Env.get` 每次调用都要重新读一遍
    /// environ 缓冲（`EnvOps.readEnviron` + `Allocator.free`），放进循环是
    /// 持续分配源。
    private var verboseOn: Boolean = false

    /// `AURA_PHOTON_TRACE=1` 时缓存为 true（入口处读一次，避免 `traceMark`
    /// 每次调用都读 environ）。与 `verboseOn` 分离：verbose 包含 VERBOSE+TRACE，
    /// trace 只包含 TRACE（`traceMark` 只在该开关下落盘）。
    private var traceOn: Boolean = false

    /// `traceMark` 的步骤序号（有界截断后仍保留计数，便于定位）。
    private var traceStep: Int = 0



    /// 追加一条调试轨迹并**定期落盘**。
    ///
    /// 为什么落盘而不是 `println`：VM 的 stdout 是带缓冲的，进程被 OOM killer
    /// 终止时缓冲区内容整体丢失（实测大工程编译崩溃时终端一行都看不到），
    /// 无法定位崩溃点。文件写入每条都同步，崩溃前的进度得以保留。
    ///
    /// ⚠️ 2026-09-29 P1.8 优化：有界截断 + 定期落盘。
    /// 旧写法每次调用都整文件重写（O(行数²)）：编译 Main.aura 时 traceBuf
    /// 累积到数万行后每次追加都整段拷贝，verbose 模式从 1.2s 退化到 140s。
    /// 修复：只保留尾部 2.5KB + 每 50 步落盘一次，平衡调试可见性与性能。
    private fun traceMark(msg: String): Unit {
        if (!this.traceOn) { return }
        this.traceStep = this.traceStep + 1
        this.traceBuf = this.traceBuf + "[s" + this.traceStep + "] " + msg + "\n"
        if (this.traceBuf.length > 3000) {
            this.traceBuf = this.traceBuf.substring(this.traceBuf.length - 2500)
        }
        // 每 50 步落盘一次，避免 O(n²) 整文件重写
        if (this.traceStep % 50 == 0) {
            FileUtils.writeText(this.outDir + "/photon_trace.log", this.traceBuf)
        }
    }

    /// 读取 Phase E 探针输出路径；空串表示关闭。
    ///
    /// 与 Phase C/D 同一套开关：`AURA_PE_PROBE=1` / `AURA_SEL_PROBE=1` /
    /// `AURA_MEM_STATS=1`；`AURA_PE_PROBE_PATH` 可覆盖输出文件。
    private fun readProbePath(): String {
        if (Env.get("AURA_PE_PROBE", "") != "1" &&
            Env.get("AURA_SEL_PROBE", Env.get("AURA_MEM_STATS", "")) != "1") {
            return ""
        }
        val p: String = Env.get("AURA_PE_PROBE_PATH", "")
        if (p != "") { return p }
        val dir: String = Env.get("AURA_HAT_OUT", this.outDir)
        if (dir == "") { return "" }
        return dir + "/pe_probe.log"
    }

    /// Phase E **定位探针**：把当前上下文立即落盘（锁定内存失控点）。
    ///
    /// 与 `InstructionSelection.selProbe` / `RegisterAllocator.raProbe` 同法：
    /// 有界截断（只保留尾部 2.5KB，每次重写一个 ≤3KB 小文件）——累积式落盘
    /// 本身就会成为持续分配源，那正是我们要抓的病。OOM 时本文件的最后几行
    /// 就是出事的精确上下文。
    private fun peProbe(msg: String): Unit {
        if (this.probePath == "") { return }
        this.probeStep = this.probeStep + 1
        this.probeBuf = this.probeBuf + "[s" + this.probeStep + "] " + msg + "\n"
        if (this.probeBuf.length > 3000) {
            this.probeBuf = this.probeBuf.substring(this.probeBuf.length - 2500)
        }
        FileUtils.writeText(this.probePath, this.probeBuf)
    }

    /// 读取一次进度开关并缓存到 `verboseOn`（见字段说明）。
    private fun readVerboseFlag(): Unit {
        this.verboseOn = Env.get("AURA_PHOTON_VERBOSE", "") == "1"
                || Env.get("AURA_PHOTON_TRACE", "") == "1"
        this.traceOn = Env.get("AURA_PHOTON_TRACE", "") == "1"
        this.traceStep = 0
    }

    /// 阶段进度/心跳输出：`verboseOn` 为假时直接丢弃。
    ///
    /// 所有「进度类」输出统一走这里，保持默认输出只有 `===...===` 协议标记。
    /// 真正的失败/告警（落盘失败、链接失败、`===ERR===`）仍用裸 `println`。
    private fun vprintln(msg: String): Unit {
        if (this.verboseOn) {
            println(msg)
        }
    }

    fun compileHir(hir: Hir, outDir: String, moduleName: String): BackendResult {
        this.outDir = outDir
        this.moduleName = moduleName

        val result = BackendResult()

        this.readVerboseFlag()
        this.probePath = this.readProbePath()
        this.vprintln("╔══════════════════════════════════════════════╗")
        this.vprintln("║   Photon AOT 编译管线 — S1 真实数据流        ║")
        this.vprintln("╚══════════════════════════════════════════════╝")

        // 输出目录必须先存在。
        //
        // VM 路径下 `FileUtils.writeText` **不会**自动创建父目录 → 目录缺失时
        // 写目标文件/runtime 对象全部静默失败，随后链接必然报 rc=-1。
        FileUtils.mkdirP(this.outDir)

        // ── Phase A: HIR → SSA MIR ──
        this.traceMark("phaseA")
        this.vprintln("[Phase A] HIR → SSA MIR (SsaBuilder)")
        var ssaBuilder = SsaBuilderUtils.build(hir)
        this.vprintln("  functions=" + ssaBuilder.functionCount +
                " values=" + ssaBuilder.valueCount +
                " blocks=" + ssaBuilder.blockCount)
        if (Env.get("AURA_PHOTON_DEBUG_HIR") == "1") {
            this.photonDumpSsa(ssaBuilder)
        }
        // 阶段短路开关（性能诊断用）：AURA_PHOTON_STOP=A|B|C|D
        // ⚠️ 2026-09-29 P1.9 调试：打印环境变量值定位「stop 不生效」问题
        val stopVal: String = Env.get("AURA_PHOTON_STOP", "")
        if (this.traceOn || this.verboseOn) {
            println("[STOP-CHECK] AURA_PHOTON_STOP=[" + stopVal + "]")
        }
        if (stopVal == "A") {
            result.errorMessage = "STOPPED_AFTER_PHASE_A"
            return result
        }

        // ── Phase B: MIR → LIR ──
        this.traceMark("phaseB")
        this.vprintln("[Phase B] MIR → LIR (Lowering)")
        val lowering = Lowering()
        var lir = lowering.lower(ssaBuilder)
        this.vprintln("  LIR functions=" + lir.functionCount +
                " values=" + lir.valueCount +
                " blocks=" + lir.blockCount)
        if (Env.get("AURA_PHOTON_DEBUG_HIR") == "1") {
            this.photonDumpLir(lir)
        }
        // ⚠️ 2026-09-29 阶段释放点：SSA 表在 Phase B 产出 LIR 后不再需要。
        // 无 GC 运行时下 ARC 引用不释放则常驻——把 ssaBuilder 置空让 ARC 回收
        // （Phase B 是整条管线最重的阶段，SSA 表常达数百 MB）。
        ssaBuilder = SsaBuilder()
        if (Env.get("AURA_PHOTON_STOP") == "B") {
            result.errorMessage = "STOPPED_AFTER_PHASE_B"
            return result
        }

        // ── Phase C: LIR → Machine DAG ──
        this.traceMark("phaseC")
        this.vprintln("[Phase C] LIR → Machine DAG (InstructionSelection)")
        val selector = InstructionSelectorUtils.emptySelector()
        var dag = selector.select(lir)
        this.vprintln("  DAG nodes=" + dag.nodeCount +
                " instrs=" + dag.instrCount)
        // ⚠️ 2026-09-29 阶段释放点：LIR 在 Phase C 产出 DAG 后不再需要。
        // DAG 是 Phase D/E 的唯一输入，LIR 是中间产物。
        lir = LirProgram()
        if (Env.get("AURA_PHOTON_STOP") == "C") {
            result.errorMessage = "STOPPED_AFTER_PHASE_C"
            return result
        }
        // ── Phase D: 寄存器分配 + 窥孔 ──
        this.traceMark("phaseD")
        this.vprintln("[Phase D] Register Allocation + Peephole")
        val allocator = RegisterAllocatorUtils.emptyAllocator()
        allocator.allocate(dag)
        this.vprintln("  spillSlots=" + allocator.getSpillSlots() +
                " dag=" + dag.nodeCount + "/" + dag.instrCount)
        if (Env.get("AURA_PHOTON_DEBUG_HIR") == "1") {
            var di: Int = 0
            while (di < dag.nodeCount) {
                val dn: DagNode = dag.nodeOf(di)
                println("    n" + di + " kind=" + dn.kind + " op=" + dn.op +
                        " reg=" + dn.reg + " args=" + dn.args + " aux=" + dn.aux)
                di = di + 1
            }
            var ii: Int = 0
            while (ii < dag.instrCount) {
                val ins: DagInstruction = dag.instrOf(ii)
                println("    i" + ii + " tpl=[" + ins.template + "] nodes=" + ins.nodes +
                        " out=" + ins.output + " cond=" + ins.cond)
                ii = ii + 1
            }
        }

        // 窥孔优化
        val peephole = PeepholeOptimizerUtils.emptyOptimizer()
        peephole.optimize(dag)
        this.vprintln("  peephole passes=" + peephole.getPassCount() +
                " dag=" + dag.nodeCount + "/" + dag.instrCount)
        if (Env.get("AURA_PHOTON_STOP") == "D") {
            result.errorMessage = "STOPPED_AFTER_PHASE_D"
            return result
        }
        if (Env.get("AURA_PHOTON_DEBUG_HIR") == "1") {
            var pi2: Int = 0
            while (pi2 < dag.instrCount) {
                val ins2: DagInstruction = dag.instrOf(pi2)
                println("    P" + pi2 + " tpl=[" + ins2.template + "] nodes=" + ins2.nodes +
                        " out=" + ins2.output + " cond=" + ins2.cond)
                pi2 = pi2 + 1
            }
        }

        // ── Phase E: 指令编码 → 目标文件 → 链接 ──
        this.traceMark("phaseE")
        this.peProbe("phaseE enter instrs=" + toStr(dag.instrCount) +
                " nodes=" + toStr(dag.nodeCount))
        this.vprintln("[Phase E] Instruction Encoding → Object → Link")

        // Step 4: 指令编码
        this.vprintln("  Step 4: X86Emitter — 指令编码")
        this.vprintln("    Step 4a: emptyEmitter")
        val emitter = X86EmitterUtils.emptyEmitter()
        this.vprintln("    Step 4b: setAllocator")
        emitter.setAllocator(allocator)
        this.vprintln("    Step 4c: emitFunction(dag)")
        emitter.emitFunction(dag, moduleName)
        this.vprintln("    Step 4d: emit done")
        this.peProbe("emit done hexChars=" + toStr(emitter.getOutputHex().length) +
                " relocs=" + toStr(emitter.getRelocRecords().length) +
                " funcOffsets=" + toStr(emitter.getFuncOffsets().length))
        val machineCodeHex: String = emitter.getOutputHex()
        val relocRecords: String = emitter.getRelocRecords()
        result.machineCodeHex = machineCodeHex
        result.encodedByteCount = machineCodeHex.length / 2
        this.vprintln("    机器码: " + this.substring(machineCodeHex, 0, this.min(result.encodedByteCount * 2, 80)))
        this.vprintln("    字节数: " + result.encodedByteCount)

        // Step 5: 目标文件组装
        this.vprintln("  Step 5: PhotonObjectWriter — COFF 目标文件组装")
        val writer = PhotonObjectWriterUtils.emptyBackend()

        // 获取函数偏移表（多函数发射支持）。
        val funcOffsets: String = emitter.getFuncOffsets()
        this.vprintln("    函数偏移: " + funcOffsets)

        // 获取字符串常量列表。
        val stringConsts: String = selector.stringConstants
        if (stringConsts != "") {
            this.vprintln("    字符串常量: " + stringConsts)
        }

        // 设置 COFF 写入器的多函数数据。
        writer.textSection = machineCodeHex
        writer.relocs = relocRecords
        writer.stringConsts = stringConsts
        writer.functionOffsets = funcOffsets

        // 从函数偏移表解析函数名列表。
        val funcNames: List<String> = this.parseFuncNames(funcOffsets)
        writer.functions = this.joinComma(funcNames)
        this.vprintln("    函数列表: " + writer.functions)

        // 构建符号表和 COFF/ELF 文件（按 OS 分派）。
        writer.buildSymbols(writer.functions, writer.stringConsts)
        this.peProbe("buildSymbols done symChars=" + toStr(writer.symbols.length) +
                " relocChars=" + toStr(writer.relocs.length))
        val coffHex: String = writer.emit()
        this.peProbe("emit done coffChars=" + toStr(coffHex.length))
        result.coffHex = coffHex
        result.coffSize = coffHex.length / 2
        this.vprintln("    COFF 大小: " + result.coffSize + " 字节")

        // 生成目标文件路径
        val objPath = this.outDir + "/" + this.moduleName + ".obj"
        result.objectFilePath = objPath
        this.vprintln("    [pipe0] objPath=" + objPath + " coffHex.len=" + coffHex.length)

        val wroteObj: Boolean = PhotonNativeWriter.writeObjectFile(objPath, coffHex)
        this.vprintln("    [pipe1] wroteObj=" + wroteObj)
        if (!wroteObj) {
            println("    ⚠ 二进制落盘失败，回退 hex 文本（需外部脚本转换）：" + objPath + ".hex")
            writer.writeObjectBinaryFile(objPath)
        }

        // Step 6: 系统链接（S1.6：链接 main 对象；共享库不链接 runtime 入口对象）
        this.vprintln("  Step 6: PhotonSystemLinker — 系统链接")
        this.peProbe("preLinkStep runtimeObjPath=empty")

        // 生成 runtime 目标文件（定义 println，供 main 引用）；Unix 共享库不需要 runtime 入口对象
        //
        // ⚠️ 2026-09-29 缓存：runtime 对象对给定平台是常量，编译多次内容完全一致。
        // 旧实现每次编译都重新走一遍 50+ 个函数的编码 + 落盘（~50 MB 字符串
        // 分配）。先检查文件是否已存在——存在则直接复用，跳过整个生成过程。
        var runtimeObjPath: String = ""
        if (this.outputType != "so" && this.outputType != "dylib") {
            runtimeObjPath = this.outDir + "/aura_runtime.obj"
            var runtimeResult: Boolean = FileUtils.exists(runtimeObjPath)
            if (!runtimeResult) {
                this.peProbe("genRuntimeObj path=" + runtimeObjPath)
                val runtimeHex: String = PhotonRuntime.buildRuntimeObject()
                this.peProbe("runtimeObjHex chars=" + this.toStr(runtimeHex.length))
                runtimeResult =
                    PhotonNativeWriter.writeObjectFile(runtimeObjPath, runtimeHex)
                if (!runtimeResult) {
                    runtimeResult = PhotonRuntimeUtils.writeRuntimeObjectHexFile(runtimeObjPath)
                }
            }
            this.peProbe("writeRuntimeObj ok=" + this.toStr(runtimeResult) +
                    (if (runtimeResult) " (cached)" else ""))
            this.vprintln("    runtime 对象: " + runtimeObjPath +
                    (if (runtimeResult) " ✓" else " ⚠ 写入失败"))
        } else {
            this.peProbe("skipRuntimeObj outputType=" + this.outputType)
            this.vprintln("    runtime 对象: 跳过（Unix 共享库输出不链接 runtime）")
        }

        // 设置链接器：main 对象 + 可选 runtime 对象
        val linker = PhotonSystemLinkerUtils.defaultLinker()
        linker.setOutputType(this.outputType)
        if (runtimeObjPath == "") {
            linker.objectFiles = objPath
        } else {
            linker.objectFiles = objPath + " " + runtimeObjPath
        }
        if (this.outputType == "exe") {
            linker.addFlag("/SUBSYSTEM:CONSOLE")
            linker.addFlag("/ENTRY:main")
            linker.addFlag("/MACHINE:X64")
            linker.addFlag("/NODEFAULTLIB")
        }
        linker.useDefaultLibs = false
        // ⚠️ runtime **确实**需要 kernel32 了：`env_get` 走 `GetEnvironmentVariableA`
        // （见 `PhotonRuntime.emitEnvGetWin32`，与既有的 `__imp_WriteFile` /
        // `__imp_GetStdHandle` 同一导入机制）。不传该库就是
        //     lld-link: error: undefined symbol: __declspec(dllimport) GetEnvironmentVariableA
        // ⇒ 内置链接失败、产物不生成（实测自举流程一直靠手动链接绕过 ✓）。
        // 路径优先取环境变量 `AURA_K32LIB`（便于切换 Windows SDK 版本），
        // 否则退回本机默认位置。
        val k32Lib: String = Env.get("AURA_K32LIB",
                "C:/Program Files (x86)/Windows Kits/10/Lib/10.0.26100.0/um/x64/kernel32.lib")
        if (k32Lib != "") {
            linker.libs = k32Lib
        }
        // P2: runtime 使用 syscall 直接调用 Nt*，不再需要 kernel32 导入
        // linker.libs = ""  // 零依赖：无 DLL 导入
        // 输出名必须显式设置：`buildCommand()` 用的是 `this.outputName`，
        // 不设置时为空串 → `/OUT:` 会退化成 `/OUT:.exe`（把产物写到当前目录下
        // 一个名为 ".exe" 的文件里），而 `result.executablePath` 却报
        // `build/photon_test/<module>.exe`，两者不一致。
        linker.outputName = this.outDir + "/" + this.moduleName
        val linkCmd = linker.buildCommand()
        result.linkCommand = linkCmd
        this.peProbe("linkCmd len=" + this.toStr(linkCmd.length))
        // 根据输出类型设置可执行文件路径
        if (this.outputType == "exe") {
            result.executablePath = this.outDir + "/" + this.moduleName + ".exe"
        } else if (this.outputType == "dll") {
            result.executablePath = this.outDir + "/" + this.moduleName + ".dll"
        } else if (this.outputType == "lib") {
            result.executablePath = this.outDir + "/" + this.moduleName + ".lib"
        } else if (this.outputType == "so") {
            result.executablePath = this.outDir + "/lib" + this.moduleName + ".so"
        } else if (this.outputType == "dylib") {
            result.executablePath = this.outDir + "/lib" + this.moduleName + ".dylib"
        } else {
            result.executablePath = this.outDir + "/" + this.moduleName + ".exe"
        }
        this.vprintln("    链接命令: " + linkCmd)

        // Step 6b: 执行链接（如果链接器可用）
        this.peProbe("preLink cmdLen=" + toStr(linkCmd.length))
        val linkRc: Int = linker.runLinker(linkCmd)
        if (linkRc == 0) {
            this.vprintln("    ✓ 链接成功: " + result.executablePath)
        } else {
            println("    ⚠ 链接失败 (rc=" + this.toStr(linkRc) + ")")
        }

        result.functionCount = lir.functionCount
        result.success = true

        this.vprintln("")
        this.vprintln("══════════════════════════════════════════════")
        this.vprintln("Photon 管线完成 — 目标文件已生成")
        this.vprintln("══════════════════════════════════════════════")

        return result
    }

    // ── .hat 入口 (HAT v2.0) ──

    /// 从 .hat 文本文件编译为可执行文件。
    ///
    /// 数据流：读取 .hat → 解析为 SSA MIR → LIR → MachineDag → RegAlloc → Encode → COFF → Link
    /// 注意：HAT 路径跳过 HIR → SSA 转换，直接从 SSA MIR 开始管线。
    fun compileHat(hatPath: String): BackendResult {
        this.readVerboseFlag()
        this.vprintln("[photon] compileHat: " + hatPath)

        // Step 1: 读取 .hat 文件
        val hatText: String = FileUtils.readText(hatPath)
        if (hatText == "" || hatText == null) {
            val result = BackendResult()
            result.errorMessage = "Failed to read .hat file: " + hatPath
            return result
        }
        this.vprintln("  .hat size: " + hatText.length + " chars")

        // Step 2: 解析 .hat → SSA MIR
        val parser = HatParserUtils.emptyParser()
        val ssaMIR: MirSsaProgram = parser.parse(hatText)
        this.traceMark("ssa functions=" + ssaMIR.functionCount + " values=" + ssaMIR.valueCount)
        this.vprintln("  SSA functions=" + ssaMIR.functionCount +
                " values=" + ssaMIR.valueCount +
                " blocks=" + ssaMIR.blockCount)
        if (Env.get("AURA_PHOTON_DEBUG_HIR") == "1") {
            this.photonDumpSsa(ssaMIR)
        }

        // Step 3: 从 SSA MIR 继续管线（Phase B-E）
        return this.compileFromSsa(ssaMIR)
    }

    /// 从 SSA MIR 继续管线（Phase B-E）。
    ///
    /// 数据流：SSA MIR → LIR → MachineDag → RegAlloc → Peephole → Encode → COFF → Link
    private fun compileFromSsa(ssaMIR: MirSsaProgram): BackendResult {
        this.readVerboseFlag()
        this.probePath = this.readProbePath()
        this.traceMark("compileFromSsa")
        this.vprintln("[Phase B-E] SSA MIR → LIR → ... → Executable")

        val result = BackendResult()

        // ── Phase B: MIR → LIR ──
        this.traceMark("phaseB")
        this.vprintln("[Phase B] MIR → LIR (Lowering)")
        val lowering = Lowering()
        var lir = lowering.lower(ssaMIR)
        this.vprintln("  LIR functions=" + lir.functionCount +
                " values=" + lir.valueCount +
                " blocks=" + lir.blockCount)
        if (Env.get("AURA_PHOTON_DEBUG_HIR") == "1") {
            this.photonDumpLir(lir)
        }
        // ⚠️ 2026-09-29 阶段释放点：SSA MIR 在 Phase B 后不再需要。
        // 注意：ssaMIR 是参数，不在此处置空（调用方可能仍持有引用）。
        if (Env.get("AURA_PHOTON_STOP") == "B") {
            result.errorMessage = "STOPPED_AFTER_PHASE_B"
            return result
        }

        // ── Phase C: LIR → Machine DAG ──
        this.traceMark("phaseC")
        this.vprintln("[Phase C] LIR → Machine DAG (InstructionSelection)")
        val selector = InstructionSelectorUtils.emptySelector()
        var dag = selector.select(lir)
        this.vprintln("  DAG nodes=" + dag.nodeCount +
                " instrs=" + dag.instrCount)
        // ⚠️ 2026-09-29 阶段释放点：LIR 在 Phase C 产出 DAG 后不再需要。
        lir = LirProgram()
        if (Env.get("AURA_PHOTON_STOP") == "C") {
            result.errorMessage = "STOPPED_AFTER_PHASE_C"
            return result
        }

        // ── Phase D: 寄存器分配 + 窥孔 ──
        this.traceMark("phaseD")
        this.vprintln("[Phase D] Register Allocation + Peephole")
        val allocator = RegisterAllocatorUtils.emptyAllocator()
        allocator.allocate(dag)
        this.vprintln("  spillSlots=" + allocator.getSpillSlots() +
                " dag=" + dag.nodeCount + "/" + dag.instrCount)
        if (Env.get("AURA_PHOTON_DEBUG_HIR") == "1") {
            var di: Int = 0
            while (di < dag.nodeCount) {
                val dn: DagNode = dag.nodeOf(di)
                println("    n" + di + " kind=" + dn.kind + " op=" + dn.op +
                        " reg=" + dn.reg + " args=" + dn.args + " aux=" + dn.aux)
                di = di + 1
            }
            var ii: Int = 0
            while (ii < dag.instrCount) {
                val ins: DagInstruction = dag.instrOf(ii)
                println("    i" + ii + " tpl=[" + ins.template + "] nodes=" + ins.nodes +
                        " out=" + ins.output + " cond=" + ins.cond)
                ii = ii + 1
            }
        }

        // 窥孔优化
        val peephole = PeepholeOptimizerUtils.emptyOptimizer()
        peephole.optimize(dag)
        this.vprintln("  peephole passes=" + peephole.getPassCount() +
                " dag=" + dag.nodeCount + "/" + dag.instrCount)
        if (Env.get("AURA_PHOTON_STOP") == "D") {
            result.errorMessage = "STOPPED_AFTER_PHASE_D"
            return result
        }
        if (Env.get("AURA_PHOTON_DEBUG_HIR") == "1") {
            var pi2: Int = 0
            while (pi2 < dag.instrCount) {
                val ins2: DagInstruction = dag.instrOf(pi2)
                println("    P" + pi2 + " tpl=[" + ins2.template + "] nodes=" + ins2.nodes +
                        " out=" + ins2.output + " cond=" + ins2.cond)
                pi2 = pi2 + 1
            }
        }

        // ── Phase E: 指令编码 → 目标文件 → 链接 ──
        this.traceMark("phaseE")
        this.peProbe("phaseE enter instrs=" + toStr(dag.instrCount) +
                " nodes=" + toStr(dag.nodeCount))
        this.vprintln("[Phase E] Instruction Encoding → Object → Link")

        // Step 4: 指令编码
        this.vprintln("  Step 4: X86Emitter — 指令编码")
        this.vprintln("    Step 4a: emptyEmitter")
        val emitter = X86EmitterUtils.emptyEmitter()
        this.vprintln("    Step 4b: setAllocator")
        emitter.setAllocator(allocator)
        this.vprintln("    Step 4c: emitFunction(dag)")
        emitter.emitFunction(dag, moduleName)
        this.vprintln("    Step 4d: emit done")
        this.peProbe("emit done hexChars=" + toStr(emitter.getOutputHex().length) +
                " relocs=" + toStr(emitter.getRelocRecords().length) +
                " funcOffsets=" + toStr(emitter.getFuncOffsets().length))
        val machineCodeHex: String = emitter.getOutputHex()
        val relocRecords: String = emitter.getRelocRecords()
        result.machineCodeHex = machineCodeHex
        result.encodedByteCount = machineCodeHex.length / 2
        this.vprintln("    机器码: " + this.substring(machineCodeHex, 0, this.min(result.encodedByteCount * 2, 80)))
        this.vprintln("    字节数: " + result.encodedByteCount)

        // Step 5: 目标文件组装
        this.vprintln("  Step 5: PhotonObjectWriter — COFF 目标文件组装")
        val writer = PhotonObjectWriterUtils.emptyBackend()

        // 获取函数偏移表（多函数发射支持）。
        val funcOffsets: String = emitter.getFuncOffsets()
        this.vprintln("    函数偏移: " + funcOffsets)

        // 获取字符串常量列表。
        val stringConsts: String = selector.stringConstants
        if (stringConsts != "") {
            this.vprintln("    字符串常量: " + stringConsts)
        }

        // 设置 COFF 写入器的多函数数据。
        writer.textSection = machineCodeHex
        writer.relocs = relocRecords
        writer.stringConsts = stringConsts
        writer.functionOffsets = funcOffsets

        // 从函数偏移表解析函数名列表。
        val funcNames: List<String> = this.parseFuncNames(funcOffsets)
        writer.functions = this.joinComma(funcNames)
        this.vprintln("    函数列表: " + writer.functions)

        // 构建符号表和 COFF/ELF 文件（按 OS 分派）。
        writer.buildSymbols(writer.functions, writer.stringConsts)
        this.peProbe("buildSymbols done symChars=" + toStr(writer.symbols.length) +
                " relocChars=" + toStr(writer.relocs.length))
        val coffHex: String = writer.emit()
        this.peProbe("emit done coffChars=" + toStr(coffHex.length))
        result.coffHex = coffHex
        result.coffSize = coffHex.length / 2
        this.vprintln("    COFF 大小: " + result.coffSize + " 字节")

        // 生成目标文件路径
        val objPath = this.outDir + "/" + this.moduleName + ".obj"
        result.objectFilePath = objPath

        // 落盘为**二进制** COFF。
        this.peProbe("preWriteObj path=" + objPath + " chars=" + toStr(coffHex.length))
        val wroteObj: Boolean = PhotonNativeWriter.writeObjectFile(objPath, coffHex)
        this.peProbe("writeObj ok=" + this.toStr(wroteObj))
        if (!wroteObj) {
            println("    ⚠ 二进制落盘失败，回退 hex 文本（需外部脚本转换）：" + objPath + ".hex")
            writer.writeObjectBinaryFile(objPath)
        }

        // Step 6: 系统链接
        this.vprintln("  Step 6: PhotonSystemLinker — 系统链接")
        this.peProbe("preLinkStep runtimeObjPath=empty")

        // 生成 runtime 目标文件（定义 println，供 main 引用）；Unix 共享库不需要 runtime 入口对象
        // ⚠️ 2026-09-29 缓存：同 compileHir 路径，已存在则跳过重建。
        var runtimeObjPath: String = ""
        if (this.outputType != "so" && this.outputType != "dylib") {
            runtimeObjPath = this.outDir + "/aura_runtime.obj"
            var runtimeResult: Boolean = FileUtils.exists(runtimeObjPath)
            if (!runtimeResult) {
                this.peProbe("genRuntimeObj path=" + runtimeObjPath)
                val runtimeHex: String = PhotonRuntime.buildRuntimeObject()
                this.peProbe("runtimeObjHex chars=" + this.toStr(runtimeHex.length))
                runtimeResult =
                    PhotonNativeWriter.writeObjectFile(runtimeObjPath, runtimeHex)
                if (!runtimeResult) {
                    runtimeResult = PhotonRuntimeUtils.writeRuntimeObjectHexFile(runtimeObjPath)
                }
            }
            this.peProbe("writeRuntimeObj ok=" + this.toStr(runtimeResult) +
                    (if (runtimeResult) " (cached)" else ""))
            this.vprintln("    runtime 对象: " + runtimeObjPath +
                    (if (runtimeResult) " ✓" else " ⚠ 写入失败"))
        } else {
            this.peProbe("skipRuntimeObj outputType=" + this.outputType)
            this.vprintln("    runtime 对象: 跳过（Unix 共享库输出不链接 runtime）")
        }

        // 设置链接器：main 对象 + 可选 runtime 对象
        val linker = PhotonSystemLinkerUtils.defaultLinker()
        linker.setOutputType(this.outputType)
        if (runtimeObjPath == "") {
            linker.objectFiles = objPath
        } else {
            linker.objectFiles = objPath + " " + runtimeObjPath
        }
        if (this.outputType == "exe") {
            linker.addFlag("/SUBSYSTEM:CONSOLE")
            linker.addFlag("/ENTRY:main")
            linker.addFlag("/MACHINE:X64")
            linker.addFlag("/NODEFAULTLIB")
        }
        linker.useDefaultLibs = false
        // 同另一条链接路径：`env_get` 需要 kernel32（见上）。
        val k32Lib2: String = Env.get("AURA_K32LIB",
                "C:/Program Files (x86)/Windows Kits/10/Lib/10.0.26100.0/um/x64/kernel32.lib")
        if (k32Lib2 != "") {
            linker.libs = k32Lib2
        }
        linker.outputName = this.outDir + "/" + this.moduleName
        val linkCmd = linker.buildCommand()
        result.linkCommand = linkCmd
        this.peProbe("linkCmd len=" + this.toStr(linkCmd.length))

        // 根据输出类型设置可执行文件路径
        if (this.outputType == "exe") {
            result.executablePath = this.outDir + "/" + this.moduleName + ".exe"
        } else if (this.outputType == "dll") {
            result.executablePath = this.outDir + "/" + this.moduleName + ".dll"
        } else if (this.outputType == "lib") {
            result.executablePath = this.outDir + "/" + this.moduleName + ".lib"
        } else if (this.outputType == "so") {
            result.executablePath = this.outDir + "/lib" + this.moduleName + ".so"
        } else if (this.outputType == "dylib") {
            result.executablePath = this.outDir + "/lib" + this.moduleName + ".dylib"
        } else {
            result.executablePath = this.outDir + "/" + this.moduleName + ".exe"
        }
        this.vprintln("    链接命令: " + linkCmd)

        // Step 6b: 执行链接（如果链接器可用）
        this.peProbe("preLink cmdLen=" + toStr(linkCmd.length))
        val linkRc: Int = linker.runLinker(linkCmd)
        if (linkRc == 0) {
            this.vprintln("    ✓ 链接成功: " + result.executablePath)
        } else {
            println("    ⚠ 链接失败 (rc=" + this.toStr(linkRc) + ")")
        }

        result.functionCount = lir.functionCount
        result.success = true

        this.vprintln("")
        this.vprintln("══════════════════════════════════════════════")
        this.vprintln("Photon 管线完成 (HAT) — 目标文件已生成")
        this.vprintln("══════════════════════════════════════════════")

        return result
    }

    /// 调试：转储 SSA MIR（设 AURA_PHOTON_DEBUG_HIR=1）。
    private fun photonDumpSsa(p: MirSsaProgram): Unit {
        println("  [SSA] functions=" + p.functionCount + " values=" + p.valueCount)
        var fi: Int = 0
        while (fi < p.functionCount) {
            val f: MirFunction = p.functionOf(fi)
            println("    fun " + f.name + " blocks=" + f.blocks + " params=" + f.params)
            fi = fi + 1
        }
        var vi: Int = 0
        while (vi < p.valueCount) {
            val v: MirValue = p.valueOf(vi)
            println("    v" + vi + " " + v.op + " ty=" + v.type + " args=" + v.args +
                    " aux=" + v.aux + " blk=" + v.block)
            vi = vi + 1
        }
    }

    /// 调试：转储 LIR（设 AURA_PHOTON_DEBUG_HIR=1）。
    private fun photonDumpLir(p: LirProgram): Unit {
        println("  [LIR] functions=" + p.functionCount + " values=" + p.valueCount)
        var fi: Int = 0
        while (fi < p.functionCount) {
            val f: LirFunction = p.functionOf(fi)
            println("    fun " + f.name + " blocks=" + f.blocks)
            fi = fi + 1
        }
        var vi: Int = 0
        while (vi < p.valueCount) {
            val v: LirValue = p.valueOf(vi)
            println("    v" + vi + " " + v.op + " ty=" + v.type + " args=" + v.args +
                    " aux=" + v.aux + " blk=" + v.block)
            vi = vi + 1
        }
    }

    // ── JIT 专用：仅编码（不做 COFF/link） ──

    /// 从 HIR 编译为机器码（仅编码，不做 COFF 组装与链接）。
    ///
    /// JIT 路径专用：只需要裸机器码 hex，不需要目标文件或链接。
    /// 数据流：HIR → SSA MIR → LIR → MachineDag → RegAlloc → Peephole → Encode
    fun compileEncodeOnly(hir: Hir, outDir: String, moduleName: String): BackendResult {
        this.outDir = outDir
        this.moduleName = moduleName

        val result = BackendResult()

        this.readVerboseFlag()
        this.vprintln("╔══════════════════════════════════════════════╗")
        this.vprintln("║   Photon JIT 编码管线（仅编码，无 COFF/link）  ║")
        this.vprintln("╚══════════════════════════════════════════════╝")

        // ── Phase A: HIR → SSA MIR ──
        this.vprintln("[Phase A] HIR → SSA MIR (SsaBuilder)")
        val ssaBuilder = SsaBuilderUtils.build(hir)
        this.vprintln("  functions=" + ssaBuilder.functionCount +
                " values=" + ssaBuilder.valueCount +
                " blocks=" + ssaBuilder.blockCount)

        // ── Phase B: MIR → LIR ──
        this.vprintln("[Phase B] MIR → LIR (Lowering)")
        val lowering = Lowering()
        val lir = lowering.lower(ssaBuilder)
        this.vprintln("  LIR functions=" + lir.functionCount +
                " values=" + lir.valueCount +
                " blocks=" + lir.blockCount)

        // ── Phase C: LIR → Machine DAG ──
        this.vprintln("[Phase C] LIR → Machine DAG (InstructionSelection)")
        val selector = InstructionSelectorUtils.emptySelector()
        val dag = selector.select(lir)
        this.vprintln("  DAG nodes=" + dag.nodeCount +
                " instrs=" + dag.instrCount)
        // ── Phase D: 寄存器分配 + 窥孔 ──
        this.vprintln("[Phase D] Register Allocation + Peephole")
        val allocator = RegisterAllocatorUtils.emptyAllocator()
        allocator.allocate(dag)
        this.vprintln("  spillSlots=" + allocator.getSpillSlots() +
                " dag=" + dag.nodeCount + "/" + dag.instrCount)

        val peephole = PeepholeOptimizerUtils.emptyOptimizer()
        peephole.optimize(dag)
        this.vprintln("  peephole passes=" + peephole.getPassCount() +
                " dag=" + dag.nodeCount + "/" + dag.instrCount)

        // ── Phase E Step 4: 指令编码（仅此一步，不做 COFF/link） ──
        this.vprintln("[Phase E] Instruction Encoding only")
        val emitter = X86EmitterUtils.emptyEmitter()
        emitter.setAllocator(allocator)
        emitter.emitFunction(dag, moduleName)
        val machineCodeHex: String = emitter.getOutputHex()
        result.machineCodeHex = machineCodeHex
        result.encodedByteCount = machineCodeHex.length / 2
        this.vprintln("  机器码 hex（前 80 字符）: " + this.substring(machineCodeHex, 0, this.min(result.encodedByteCount * 2, 80)))
        this.vprintln("  字节数: " + result.encodedByteCount)

        result.functionCount = lir.functionCount
        result.success = true

        this.vprintln("")
        this.vprintln("══════════════════════════════════════════════")
        this.vprintln("Photon JIT 编码完成 — 机器码已生成")
        this.vprintln("══════════════════════════════════════════════")

        return result
    }

    // ── JIT 专用入口（VM 安全） ──

    /// 从 HIR 编译为裸机器码（JIT 出口，不组装 COFF、不链接）。
    ///
    /// 与 [`compileEncodeOnly`] 等价的命名入口。此入口**不触碰 `Memory`**，
    /// 因此在 VM（种子）与原生（AOT / 自举）两种环境下都可调用：
    ///
    ///   - VM 模式：返回的机器码 hex 仅作为数据（供诊断 / 桥接测试）；
    ///   - 原生模式：hex 交给 `JitBackend.emitFunction` 写入 W^X 可执行内存。
    fun compileJit(hir: Hir, moduleName: String): BackendResult {
        return this.compileEncodeOnly(hir, this.outDir, moduleName)
    }

    // ── 辅助方法 ──

    /// 字符串截取。
    private fun substring(s: String, start: Int, end: Int): String {
        if (start >= s.length) { return "" }
        if (end >= s.length) { return s.substring(start) }
        return s.substring(start, end)
    }

    /// 返回两个整数中的较小值。
    private fun min(a: Int, b: Int): Int {
        if (a < b) { return a }
        return b
    }

    /// 整数转字符串。
    private fun toStr(n: Int): String {
        if (n == 0) { return "0" }
        var neg: Boolean = false
        if (n < 0) { neg = true; n = -n }
        var result: String = ""
        while (n > 0) {
            result = this.digitChar(n % 10) + result
            n = n / 10
        }
        if (neg) { result = "-" + result }
        return result
    }

    /// 将单个数字转为字符串。
    private fun digitChar(d: Int): String {
        if (d == 0) { return "0" }
        if (d == 1) { return "1" }
        if (d == 2) { return "2" }
        if (d == 3) { return "3" }
        if (d == 4) { return "4" }
        if (d == 5) { return "5" }
        if (d == 6) { return "6" }
        if (d == 7) { return "7" }
        if (d == 8) { return "8" }
        if (d == 9) { return "9" }
        return ""
    }

    /// 从函数偏移表解析函数名列表（格式 "funcName|offset;;funcName|offset"）。
    private fun parseFuncNames(funcOffsets: String): List<String> {
        val result: List<String> = arrayListOf<String>()
        if (funcOffsets == "") { return result }
        val parts: List<String> = this.splitDoubleSemi(funcOffsets)
        var i: Int = 0
        while (i < parts.size) {
            val part: String = parts[i]
            val pipeIdx: Int = this.indexOf(part, "|")
            if (pipeIdx > 0) {
                result.add(part.substring(0, pipeIdx))
            }
            i = i + 1
        }
        return result
    }

    /// 将列表用逗号连接。
    ///
    /// ⚠️ 旧实现是 `result = result + items[i]`：自举 `Main.aura` 有 2,647 个
    /// 函数（总长约 106KB），逐条拼接的理论拷贝量约 140 MB。现改为
    /// 「片段列表 + 两两归并」（追加 O(1)、归并 O(总长 · log 片段数)），与
    /// `X86Encoder.joinBytes` / `PhotonObjectWriter.coffJoinList` 同一手法。
    private fun joinComma(items: List<String>): String {
        val parts: List<String> = arrayListOf<String>()
        var i: Int = 0
        while (i < items.size) {
            if (i > 0) { parts.add(",") }
            parts.add(items[i])
            i = i + 1
        }
        return this.joinPairwise(parts)
    }

    /// 把片段列表两两归并成单个字符串（每层拷贝总量 O(总长)，共 O(log 层)）。
    private fun joinPairwise(parts: List<String>): String {
        if (parts.size == 0) {
            return ""
        }
        var cur: List<String> = parts
        while (cur.size > 1) {
            val next: List<String> = arrayListOf<String>()
            var i: Int = 0
            while (i < cur.size) {
                if (i + 1 < cur.size) {
                    next.add(cur[i] + cur[i + 1])
                } else {
                    next.add(cur[i])
                }
                i = i + 2
            }
            cur = next
        }
        return cur[0]
    }

    /// 按 `;;` 分隔字符串。
    private fun splitDoubleSemi(text: String): List<String> {
        val result: List<String> = arrayListOf<String>()
        if (text == "") { return result }
        var start: Int = 0
        var i: Int = 0
        var len: Int = text.length
        while (i < len - 1) {
            if (text.substring(i, i + 2) == ";;") {
                result.add(text.substring(start, i))
                start = i + 2
            }
            i = i + 1
        }
        if (start < len) {
            result.add(text.substring(start, len))
        }
        return result
    }

    /// 查找字符在字符串中的位置（返回 -1 表示未找到）。
    private fun indexOf(text: String, ch: String): Int {
        var i: Int = 0
        while (i < text.length) {
            if (text.charAt(i).toString() == ch) {
                return i
            }
            i = i + 1
        }
        return -1
    }
}

// ─────────────────────────────────────────────────────────────
// 工具对象
// ─────────────────────────────────────────────────────────────

object PhotonPipelineUtils {

    /// 创建默认管线。
    fun emptyPipeline(): PhotonPipeline {
        return PhotonPipeline()
    }

    /// 检测操作系统。
    fun detectOS(): String {
        return "windows"
    }

    /// 检测架构。
    fun detectArch(): String {
        return "x86_64"
    }

    /// 构建目标三元组。
    fun buildTriple(os: String, arch: String): String {
        if (os == "windows") {
            return arch + "-pc-windows-msvc"
        }
        return arch + "-unknown-linux-gnu"
    }

    /// Phase 列表。
    fun phaseList(): String {
        return "A:MIR SSA,B:LIR,C:MachineDag,D:RegAlloc+Peephole,E:X86Emitter+ObjectWriter+SystemLinker"
    }
}
