// aura:///aura/lang/compiler/backend/photon/PhotonNativeWriter.aura
package aura.lang.compiler.backend.photon

import aura.lang.native.Memory
import aura.lang.native.memory.Allocator
import aura.lang.native.file.FileOps
import aura.lang.native.io.Stdio
import aura.lang.std.Env

object PhotonNativeWriter {

    val O_WRONLY_CREAT_TRUNC: Int = 1 | 0x40 | 0x200

    /// 把 COFF hex 文本解码为字节并写入 path。
    /// 单次大缓冲区写入，避免循环中的 FileOps.write 崩溃。
    fun writeObjectFile(path: String, coffHex: String): Boolean {
        val hexLen: Int = coffHex.length
        val total: Int = hexLen / 2
        if (total <= 0) {
            return false
        }

        // 分配路径缓冲区
        val pathLen: Int = path.length
        val pathBuf: Long = Memory.alloc((pathLen + 1) as Long)
        if (pathBuf == 0) {
            return false
        }
        var pi: Int = 0
        while (pi < pathLen) {
            Memory.write(pathBuf + (pi as Long), path.charCodeAt(pi) as Byte)
            pi = pi + 1
        }
        Memory.write(pathBuf + (pathLen as Long), 0 as Byte)

        // 打开文件
        val fd: Int = FileOps.open(pathBuf, PhotonNativeWriter.O_WRONLY_CREAT_TRUNC)
        if (fd < 0) {
            Memory.free(pathBuf)
            return false
        }

        // 分配整个数据的缓冲区
        val dataBuf: Long = Memory.alloc(total as Long)
        if (dataBuf == 0) {
            FileOps.close(fd)
            Memory.free(pathBuf)
            return false
        }

        // 解码 hex 到缓冲区
        var di: Int = 0
        var hi: Int = 0
        while (di < total) {
            val c1: Int = coffHex.charCodeAt(hi)
            val c2: Int = coffHex.charCodeAt(hi + 1)
            val nibble1: Int = if (c1 >= 48 && c1 <= 57) c1 - 48
                             else if (c1 >= 97 && c1 <= 102) c1 - 87
                             else if (c1 >= 65 && c1 <= 70) c1 - 55
                             else 0
            val nibble2: Int = if (c2 >= 48 && c2 <= 57) c2 - 48
                             else if (c2 >= 97 && c2 <= 102) c2 - 87
                             else if (c2 >= 65 && c2 <= 70) c2 - 55
                             else 0
            Memory.write(dataBuf + (di as Long), ((nibble1 * 16 + nibble2) as Byte))
            di = di + 1
            hi = hi + 2
        }

        // 一次性写入
        val n: Long = FileOps.write(fd, dataBuf, total as Long)

        FileOps.close(fd)
        Memory.free(dataBuf)
        Memory.free(pathBuf)
        return n == total as Long
    }

    /// 取 hex 文本中第 index 个字节的值（0..255）。
    fun hexByteAt(hex: String, index: Int): Int {
        return PhotonNativeWriter.hexNibble(hex, index * 2) * 16
            + PhotonNativeWriter.hexNibble(hex, index * 2 + 1)
    }

    /// 单个 hex 字符 → 半字节（非法字符按 0 处理）。
    fun hexNibble(hex: String, at: Int): Int {
        if (at < 0 || at >= hex.length) {
            return 0
        }
        val c: Int = hex.charCodeAt(at)
        if (c >= 48 && c <= 57) { return c - 48 }
        if (c >= 97 && c <= 102) { return c - 87 }
        if (c >= 65 && c <= 70) { return c - 55 }
        return 0
    }
}