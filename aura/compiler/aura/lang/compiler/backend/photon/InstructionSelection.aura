// aura:///aura/lang/compiler/backend/InstructionSelection.aura
package aura.lang.compiler.backend.photon
// ─────────────────────────────────────────────────────────────
// DAG Tiling 指令选择器 — Phase C (任务 C.2)
//
// 将 LIR（Lir.aura）通过 DAG Tiling 选择为 MachineDag（MachineDag.aura）
// 中的机器指令序列。
//
// ── 设计方式（与 Mir/SsaMir/Lir 一致）───────────────────────
//
// 遍历 LirProgram → LirFunction → LirBlock → LirValue，
// 对每条 LIR 指令执行模式匹配，选择最优机器指令模板。
//
// ── 选择策略 ──
//
//   常量加载:   Const/ConstImm → 立即数 MOV 指令
//   算术运算:   Add/Sub/Mul/SDiv/SRem → ADD/SUB/MUL/IDIV/IMUL
//   内存操作:   Load/Store → MOV [mem], reg / MOV reg, [mem]
//   函数调用:   Call → CALL 指令（含调用约定）
//   地址计算:   Gep → LEA 指令
//   比较运算:   ICmp* → CMP + SETcc 指令序列
//   控制流:     Ret → RET, Br → JMP, CondBr → Jcc
//   Phi:        由后续寄存器分配阶段处理
//
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String
// 同包依赖：LIR 定义 / 机器 DAG / 工具函数。
import "Lir.aura"
import "MachineDag.aura"

/// DAG Tiling 指令选择器。
///
/// 将 LIR 程序转换为 MachineDag，为后续寄存器分配和代码发射做准备。
class InstructionSelector {

    /// 输出的机器级 DAG。
    var dag: MachineDag = MachineDag()

    /// 当前正在处理的函数名。
    var funcName: String = ""

    /// 模式数据库（逗号分隔的模式 ID 列表，用于调试/配置）。
    var patterns: String = ""

    /// 已选择的指令数量计数器。
    var selectedCount: Int = 0

    /// LIR → DAG 节点 ID 映射（扁平字符串："lirId|dagId\n..."）。
    private var nodeMap: String = ""

    /// 当前内存链头节点 ID（-1 表示无内存依赖）。
    private var curChain: Int = -1

    /// 临时值计数器（用于生成虚拟节点名）。
    private var tmpCount: Int = 0

    init() {
        this.dag = MachineDag()
        this.funcName = ""
        this.patterns = ""
        this.selectedCount = 0
        this.nodeMap = ""
        this.curChain = -1
        this.tmpCount = 0
    }

    // ── 主入口 ──

    /// 将 LIR 程序转换为 MachineDag（主入口）。
    fun select(src: LirProgram): MachineDag {
        this.dag = MachineDag()
        this.nodeMap = ""
        this.curChain = -1
        this.tmpCount = 0
        this.selectedCount = 0
        this.funcName = ""

        // 遍历所有函数。
        var fi: Int = 0
        while (fi < src.functions.size) {
            val func: LirFunction = src.functions[fi]
            this.selectFunction(func)
            fi = fi + 1
        }
        return this.dag
    }

    // ── 函数级选择 ──

    /// 选择单个函数的指令。
    fun selectFunction(func: LirFunction): Unit {
        this.funcName = func.name

        // 遍历所有基本块。
        val blockParts: List<String> = LirUtils.splitArgs(func.blocks)
        var bi: Int = 0
        while (bi < blockParts.size) {
            val blockId: Int = LirUtils.strToInt(blockParts[bi])
            // LirBlock 通过 LirProgram 获取。
            val block: LirBlock = LirBlock()
            block.id = blockId
            this.selectBlock(block)
            bi = bi + 1
        }
    }

    // ── 块级选择 ──

    /// 选择单个基本块的指令。
    fun selectBlock(block: LirBlock): Unit {
        // 处理 Phi 节点（暂由寄存器分配处理，此处跳过）。
        val phiParts: List<String> = LirUtils.splitArgs(block.phis)
        var pi: Int = 0
        while (pi < phiParts.size) {
            pi = pi + 1
        }

        // 处理普通指令。
        val instrParts: List<String> = LirUtils.splitArgs(block.instrs)
        var ii: Int = 0
        while (ii < instrParts.size) {
            val vid: Int = LirUtils.strToInt(instrParts[ii])
            this.selectValue(vid, block.id)
            ii = ii + 1
        }

        // 处理终结指令。
        if (block.term >= 0) {
            this.selectValue(block.term, block.id)
        }
    }

    // ── 值级选择（核心）──

    /// 选择单个 LIR 值的指令。
    ///
    /// 根据 LirValue.op 进行模式匹配，创建 DAG 节点并选择机器指令。
    /// 返回 DAG 中的节点 ID。
    fun selectInstr(val: LirValue): Int {
        return this.selectValue(val.id, val.block)
    }

    /// 选择指定 ID 的 LIR 值（通过 nodeMap 获取）。
    private fun selectValue(vid: Int, blockId: Int): Int {
        // 如果是常量，直接创建 Const 节点。
        // 由于我们不在 LirProgram 上下文中，需要检查 nodeMap。
        val mapped: Int = this.lookupNode(vid)
        if (mapped >= 0) {
            return mapped
        }

        // 默认：创建一个新的 Value 节点。
        val nodeId: Int = this.dag.addNode("Value", "Unknown", 0,
                                             "", "", "", this.curChain, "")
        this.registerNode(vid, nodeId)
        return nodeId
    }

    // ── 发射方法 ──

    /// 发射 ADD 立即数指令：`add $imm, %dst, %src`。
    /// 返回新创建的指令 ID。
    fun emitAddImm(dst: Int, src: Int, imm: Int): Int {
        val immStr: String = MachineDagUtils.toStr(imm)
        val nodes: String = MachineDagUtils.toStr(src) + "," +
                            MachineDagUtils.toStr(dst) + "," + immStr
        return this.dag.selectPattern(0, nodes, dst)
    }

    /// 发射 MOV 寄存器间移动指令：`mov %dst, %src`。
    fun emitMov(dst: Int, src: Int): Int {
        val nodes: String = MachineDagUtils.toStr(src) + "," +
                            MachineDagUtils.toStr(dst)
        return this.dag.selectPattern(7, nodes, dst)
    }

    /// 发射 MOV 内存操作数指令：`mov %dst, [addr+offset]` 或 `mov [addr+offset], %src`。
    ///
    /// `dst` 为目标节点 ID，`addr` 为地址节点 ID，`offset` 为偏移量。
    /// 当 `dst` 为 -1 时表示 Store（存入内存）。
    fun emitMovMem(dst: Int, addr: Int, offset: Int): Int {
        val addrStr: String = "[" + MachineDagUtils.toStr(addr)
        if (offset != 0) {
            addrStr = addrStr + "+[offset:" + MachineDagUtils.toStr(offset) + "]"
        } else {
            addrStr = addrStr + "]"
        }
        val nodes: String = MachineDagUtils.toStr(dst) + "," + addrStr
        val outputNode: Int = dst
        // pattern 10 = mov %dst, [mem] (load), pattern 11 = mov [mem], %src (store)
        val patternId: Int = if (dst >= 0) 10 else 11
        return this.dag.selectPattern(patternId, nodes, outputNode)
    }

    /// 发射 CALL 指令，包含调用约定设置。
    ///
    /// `funcNode` 为函数地址节点 ID，`argc` 为参数个数。
    fun emitCall(funcNode: Int, argc: Int): Int {
        val nodes: String = MachineDagUtils.toStr(funcNode)
        return this.dag.selectPattern(50, nodes, -1)
    }

    /// 发射 SETcc 指令：`setcc %dst`。
    ///
    /// `dst` 为目标节点 ID，`cond` 为条件字符串（如 "eq"、"ne"、"lt"）。
    fun emitSetcc(dst: Int, cond: String): Int {
        val nodes: String = MachineDagUtils.toStr(dst)
        val id: Int = this.dag.selectPattern(40, nodes, dst)
        // 更新指令的条件字符串。
        val instr: DagInstruction = this.dag.instrOf(id)
        instr.cond = cond
        return id
    }

    /// 发射 CMP 指令：`cmp %src, $imm`。
    ///
    /// `src` 为源节点 ID，`imm` 为立即数比较值。
    fun emitCmp(src: Int, imm: Int): Int {
        val nodes: String = MachineDagUtils.toStr(src) + "," +
                            MachineDagUtils.toStr(imm)
        return this.dag.selectPattern(20, nodes, -1)
    }

    /// 发射 RET 指令。
    ///
    /// `reg` 为返回值寄存器节点 ID（-1 表示无返回值）。
    fun emitRet(reg: Int): Int {
        val nodes: String = ""
        if (reg >= 0) {
            nodes = MachineDagUtils.toStr(reg)
        }
        return this.dag.selectPattern(30, nodes, -1)
    }

    /// 发射 JMP 指令：`jmp $target`。
    ///
    /// `target` 为目标块/节点 ID。
    fun emitJmp(target: Int): Int {
        val nodes: String = MachineDagUtils.toStr(target)
        return this.dag.selectPattern(31, nodes, -1)
    }

    /// 发射 Jcc 条件跳转指令：`jcc $target`。
    ///
    /// `cond` 为条件字符串（如 "eq"、"ne"、"lt"、"gt"），
    /// `target` 为目标块/节点 ID。
    fun emitJcc(cond: String, target: Int): Int {
        val id: Int = this.dag.selectPattern(32,
            MachineDagUtils.toStr(target), -1)
        val instr: DagInstruction = this.dag.instrOf(id)
        instr.cond = cond
        return id
    }

    // ── 节点映射管理 ──

    /// 在节点映射中注册一个 LIR ID → DAG ID 映射。
    private fun registerNode(lirId: Int, dagId: Int): Unit {
        if (this.nodeMap == "") {
            this.nodeMap = MachineDagUtils.toStr(lirId) + "|" +
                           MachineDagUtils.toStr(dagId) + "\n"
        } else {
            this.nodeMap = this.nodeMap + MachineDagUtils.toStr(lirId) + "|" +
                           MachineDagUtils.toStr(dagId) + "\n"
        }
    }

    /// 查找 LIR ID 对应的 DAG ID（未找到返回 -1）。
    private fun lookupNode(lirId: Int): Int {
        if (this.nodeMap == "") {
            return -1
        }
        val targetStr: String = MachineDagUtils.toStr(lirId) + "|"
        var start: Int = 0
        var len: Int = this.nodeMap.length
        var i: Int = 0
        while (i < len) {
            if (this.nodeMap[i] == "\n") {
                if (this.nodeMap.substring(start, i).startsWith(targetStr)) {
                    val dagIdStr: String = this.nodeMap.substring(
                        start + targetStr.length, i)
                    return MachineDagUtils.strToInt(dagIdStr)
                }
                start = i + 1
                i = start
            } else {
                i = i + 1
            }
        }
        // 检查最后一个条目（无换行结尾）。
        if (this.nodeMap.substring(start, len).startsWith(targetStr)) {
            val dagIdStr: String = this.nodeMap.substring(
                start + targetStr.length, len)
            return MachineDagUtils.strToInt(dagIdStr)
        }
        return -1
    }

    /// 生成下一个临时值计数器。
    private fun genTmp(): Int {
        val id: Int = this.tmpCount
        this.tmpCount = this.tmpCount + 1
        return id
    }
}

// ─────────────────────────────────────────────────────────────
// InstructionSelectorUtils — 选择器工具对象
// ─────────────────────────────────────────────────────────────

object InstructionSelectorUtils {

    /// 创建空的指令选择器。
    fun emptySelector(): InstructionSelector {
        return InstructionSelector()
    }

    /// 创建空的指令选择器（带模式数据库配置）。
    fun emptySelectorEx(patterns: String): InstructionSelector {
        val sel: InstructionSelector = InstructionSelector()
        sel.patterns = patterns
        return sel
    }

    /// 将 LIR 操作符映射为条件字符串。
    ///
    /// `op` 为 LIR 比较操作符（如 "ICmpEQ"、"ICmpNE" 等）。
    fun icmpToCond(op: String): String {
        if (op == "ICmpEQ") { return "eq" }
        if (op == "ICmpNE") { return "ne" }
        if (op == "ICmpLT") { return "lt" }
        if (op == "ICmpGT") { return "gt" }
        if (op == "ICmpLE") { return "le" }
        if (op == "ICmpGE") { return "ge" }
        if (op == "ICmpULT") { return "ubl" }
        if (op == "ICmpUGT") { return "uog" }
        if (op == "ICmpULE") { return "ule" }
        if (op == "ICmpUGE") { return "uge" }
        return "eq"
    }

    /// 判断是否为比较指令。
    fun isICmp(op: String): Boolean {
        return op.startsWith("ICmp")
    }

    /// 判断是否为算术指令。
    fun isArith(op: String): Boolean {
        if (op == "Add" || op == "Sub" || op == "Mul" ||
            op == "SDiv" || op == "SRem" || op == "And" ||
            op == "Or" || op == "Xor" || op == "Shl" || op == "Shr") {
            return true
        }
        return false
    }

    /// 判断是否为常量指令。
    fun isConstOp(op: String): Boolean {
        return op == "Const" || op == "ConstImm"
    }
}
