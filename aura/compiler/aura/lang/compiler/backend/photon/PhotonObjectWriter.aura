// aura:///aura/lang/compiler/backend/AotBackend.aura
package aura.lang.compiler.backend.photon
// ─────────────────────────────────────────────────────────────
// AOT 后端 — COFF/ELF 发射 — Phase E (任务 E.1)
//
// 按照 docs/Lir2MacCode/参考go rust设计新的编译后端.md 第九章
// 完整实现：指令编码 → 目标文件组装 → 系统链接
//
// ── COFF 目标文件格式（Windows .obj）──
//
//   文件头 (20 字节)
//   节表 (40 字节/节)
//   字符串表
//   符号表
//   重定位表
//   节数据
//
// ── x86_64 调用约定（Windows x64）──
//
//   参数传递:    rcx, rdx, r8, r9, 然后栈（8 字节对齐）
//   返回值:      rax (整数) / xmm0 (浮点)
//   被调用者保存: rbx, rbp, r12, r13, r14, r15
//   影子空间:    32 字节（4 × 8 字节）
//   栈对齐:      16 字节
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String
import aura.lang.std.FileSystem
import aura.lang.std.Process
import aura.lang.std.Env

import "x86_64/X86Encoder.aura"

// ─────────────────────────────────────────────────────────────
// AotBackend — COFF/ELF 目标文件发射器
// ─────────────────────────────────────────────────────────────

/// AOT 后端：从 MachineDag + LirProgram 发射 COFF/ELF 目标文件。
class PhotonObjectWriter {

    /// 目标架构。
    var target: String = "x86_64"

    /// 操作系统。
    var os: String = "windows"

    /// 优化级别。
    var optimizeLevel: Int = 2

    /// 是否包含调试信息。
    var debugInfo: Boolean = false

    /// .text 节内容（hex 编码）。
    var textSection: String = ""

    /// .rdata 节内容（hex 编码）。
    var rdataSection: String = ""

    /// .data 节内容（hex 编码）。
    var dataSection: String = ""

    /// .bss 节内容（hex 编码）。
    var bssSection: String = ""

    /// 重定位表（格式: offset|symbol|type）。
    var relocs: String = ""

    /// 符号表（格式: name|value|section|type|storage）。
    var symbols: String = ""

    /// 字符串常量列表（逗号分隔）。
    var stringConsts: String = ""

    /// .data 节符号名（为空则不添加 .data 符号）。
    var dataSymbolName: String = ""

    /// 函数列表（逗号分隔）。
    var functions: String = ""

    /// 每个函数在 .text 节内的起始字节偏移（格式: name|offset|offsets...）。
    ///
    /// 多函数单 obj（S2）需要为每个函数定义独立符号，并且把函数内重定位
    /// 偏移转换为 .text 节内绝对偏移。单函数时首函数 offset 固定为 0。
    var functionOffsets: String = ""

    /// 节数据偏移（运行时计算）。
    var textOffset: Int = 0
    var rdataOffset: Int = 0
    var dataOffset: Int = 0

    /// 节大小。
    var textSize: Int = 0
    var rdataSize: Int = 0
    var dataSize: Int = 0

    /// COFF 布局缓存（buildCoffFile 内部使用）。
    var coffSectionCount: Int = 0
    var coffSymTabOffset: Int = 0
    var coffSymCount: Int = 0
    var coffRelocOffset: Int = 0
    var coffRelocCount: Int = 0
    var coffStrTabSize: Int = 0
    var coffStrTabHex: String = ""

    /// `composeRelocations()` 的结果缓存。
    ///
    /// 该函数只依赖 `symbols` / `relocs`（二者在 `buildSymbols` 之后即固定），
    /// 但 `buildCoffFile` 与 `buildRelocationTable` 各调一次 —— 自举规模下
    /// 单次就要扫描全部重定位 × 全部符号，重复一次即翻倍。这里缓存结果，
    /// 并在 `appendFunction` / `buildRelocs`（唯一会改动 `relocs` 的入口）
    /// 里失效。
    var coffRelocCache: List<String> = arrayListOf<String>()
    var coffRelocCacheValid: Boolean = false

    /// COFF 字节缓冲（**逐片段列表**，`buildCoffFile` 内部使用）。
    ///
    /// ⚠ 旧实现是 `var buf: String = ""` + `buf = buf + chunk`。Aura 的 String
    /// 不可变，每次拼接都要把**已组装的全部节**整段拷贝。自举 `Main.aura` 的
    /// .text 约 1 MB（hex 2 MB），符号表 / 重定位表又有数万条目且**逐字段**
    /// 拼接 —— 实测 Phase E 在 `buildCoffFile` 里产生 8,134,060 次
    /// `aura_string_concat`、7,013 MB 常驻分配（AOT 运行时无 GC，`free_calls=0`
    /// 全部驻留），8 GiB 上限被打穿（退出码 70）。
    ///
    /// 改为列表累积 + 结束时两两归并（见 `coffJoin`），与 `X86Encoder` 的
    /// `byteHex` / `joinBytes` 同一手法：追加 O(1)、归并 O(总长 · log 片段数)。
    var coffBuf: List<String> = arrayListOf<String>()

    init() {
        this.target = "x86_64"
        this.os = "windows"
        this.optimizeLevel = 2
        this.debugInfo = false
        this.textSection = ""
        this.rdataSection = ""
        this.dataSection = ""
        this.bssSection = ""
        this.relocs = ""
        this.symbols = ""
        this.stringConsts = ""
        this.dataSymbolName = ""
        this.functions = ""
        this.functionOffsets = ""
        this.textOffset = 0
        this.rdataOffset = 0
        this.dataOffset = 0
        this.textSize = 0
        this.rdataSize = 0
        this.dataSize = 0
    }

    // ── 主入口 ──

    /// 主入口：生成目标文件（hex 编码）。
    fun emit(): String {
        if (this.os == "windows") {
            return this.buildCoffFile()
        }
        if (this.os == "linux") {
            return this.buildElfFile()
        }
        return ""
    }

    /// 从机器码 hex 字符串发射 COFF 文件。
    ///
    /// @param machineCodeHex  .text 节机器码（hex）
    /// @param relocEntries    重定位项（格式: offset|symbol）
    /// @param stringConsts    字符串常量（逗号分隔）
    /// @param functionName    入口函数名
    fun emitFromMachineCode(machineCodeHex: String, relocEntries: String,
                            stringConsts: String, functionName: String): String {
        this.textSection = machineCodeHex
        this.stringConsts = stringConsts
        this.functions = functionName
        this.relocs = relocEntries

        // 单函数 API 的后向兼容入口：首函数永远位于 .text 偏移 0。
        this.functionOffsets = functionName + "|0"

        // 符号表依赖重定位表：重定位引用的外部符号要登记为「未定义符号」
        this.buildSymbols(functionName, stringConsts)

        // 按 OS 分派：windows → COFF，linux → ELF。
        return this.emit()
    }

    /// 追加额外函数的机器码到 .text 节（多函数支持）。
    ///
    /// @param machineCodeHex  该函数的机器码（hex）
    /// @param functionName    该函数名
    /// @param relocEntries    该函数的重定位项（格式: offset|symbol）
    fun appendFunction(machineCodeHex: String, functionName: String,
                        relocEntries: String): Unit {
        // 多函数单 obj：先记录本函数在 .text 内的基准偏移，再追加机器码。
        this.coffRelocCacheValid = false
        // 后续重定位项会按这个基准换算为节内绝对偏移。
        val funcOffset: Int = this.hexByteCount(this.textSection)
        if (this.functions == "") {
            this.functions = functionName
            this.functionOffsets = functionName + "|0"
        } else {
            this.functions = this.functions + "," + functionName
            this.functionOffsets = this.functionOffsets + ";;" + functionName + "|" + this.toStr(funcOffset)
        }

        // 追加机器码到 textSection
        this.textSection = this.textSection + machineCodeHex

        // 追加重定位项：将每个条目的偏移加上 funcOffset，变为节内绝对偏移。
        // 用 `;;` 分隔函数边界。
        val rebasedEntries: String = this.rebaseRelocEntries(relocEntries, funcOffset)
        if (this.relocs == "") {
            this.relocs = rebasedEntries
        } else {
            this.relocs = this.relocs + ";;" + rebasedEntries
        }
    }

    /// 将重定位条目中的偏移加上基准偏移，变为节内绝对偏移。
    ///
    /// 条目格式：`offset|symbol|type`，以 `;` 分隔多个条目。
    private fun rebaseRelocEntries(entries: String, baseOffset: Int): String {
        if (entries == "") {
            return ""
        }
        val parts: List<String> = this.splitSemi(entries)
        var out: String = ""
        var i: Int = 0
        while (i < parts.size) {
            if (parts[i] != "") {
                if (i > 0) { out = out + ";" }
                val fields: List<String> = this.splitPipe(parts[i])
                if (fields.size >= 3) {
                    val newOffset: Int = this.strToInt(fields[0]) + baseOffset
                    out = out + this.toStr(newOffset) + "|" + fields[1] + "|" + fields[2]
                } else {
                    out = out + parts[i]
                }
            }
            i = i + 1
        }
        return out
    }

    // ── 符号表构建 ──

    /// 构建符号表。
    ///
    /// 记录格式：`name|value|section|type|storage`
    ///
    /// | 字段 | 含义 |
    /// |------|------|
    /// | section | 0 = 未定义（外部引用），1 = .text，2 = .rdata |
    /// | type    | 0x0020 = 函数，0x0000 = 数据 |
    /// | storage | 2 = IMAGE_SYM_CLASS_EXTERNAL，3 = IMAGE_SYM_CLASS_STATIC |
    ///
    /// **顺序即符号索引**：函数 → 字符串常量 → 重定位引用的外部符号。
    /// 重定位表通过符号名在本表中的位置解析出 SymbolTableIndex。
    // ── 定位探针（有界截断，仅诊断用）──
    private var probePath: String = ""
    private var probeStep: Int = 0
    private var probeBuf: String = ""

    /// 探测 `AURA_PE_PROBE_PATH`（或默认 `build/hat-bootstrap/objw_probe.log`）。
    private fun readProbePath(): String {
        val p: String = Env.get("AURA_PE_PROBE_PATH", "")
        if (p != "") {
            return p
        }
        if (Env.get("AURA_SEL_PROBE", Env.get("AURA_MEM_STATS", "")) != "1") {
            return ""
        }
        return "build/hat-bootstrap/objw_probe.log"
    }

    /// 追加一行探针输出；超过 3000 字符时截断保留尾部 2500。
    private fun objwProbe(msg: String): Unit {
        if (this.probePath == "") {
            return
        }
        this.probeStep = this.probeStep + 1
        this.probeBuf = this.probeBuf + "[s" + this.toStr(this.probeStep) + "] " + msg + "\n"
        if (this.probeBuf.length > 12000) {
            this.probeBuf = this.probeBuf.substring(this.probeBuf.length - 10000)
        }
        FileSystem.writeText(this.probePath, this.probeBuf)
    }

    fun buildSymbols(functionName: String, stringConsts: String): Unit {
        this.probePath = this.readProbePath()
        this.objwProbe("buildSymbols enter fnChars=" + this.toStr(functionName.length) +
                " strChars=" + this.toStr(stringConsts.length))
        val recs: List<String> = arrayListOf<String>()

        // 1) 函数符号：支持逗号分隔的多函数列表。
        //    单函数场景 offset=0；多函数场景必须用 functionOffsets 为每个函数写独立 .text 偏移，
        //    否则 call helper 会被链接到 .text 起点（main），导致调用错位。
        if (functionName != "") {
            val funcParts: List<String> = this.splitComma(functionName)
            val offsetParts: List<String> = this.splitDoubleSemi(this.functionOffsets)
            var fi: Int = 0
            while (fi < funcParts.size) {
                if (funcParts[fi] != "") {
                    val symOffset: Int = 0
                    if (fi < offsetParts.size) {
                        val of: List<String> = this.splitPipe(offsetParts[fi])
                        if (of.size >= 2 && of[0] == funcParts[fi]) {
                            symOffset = this.strToInt(of[1])
                        } else if (of.size >= 2) {
                            symOffset = this.strToInt(of[1])
                        }
                    }
                    recs.add(funcParts[fi] + "|" + this.toStr(symOffset) + "|1|0x0020|2")
                }
                fi = fi + 1
            }
        }

        this.objwProbe("sym1 funcs done recs=" + this.toStr(recs.size))

        // 2) 字符串常量符号：值 = 该字符串在 .rdata 内的字节偏移
        //    （必须逐个累加，否则 @str.1/@str.2 会全部指向 .rdata 起点）
        val parts: List<String> = this.splitCommaQuoted(stringConsts)
        var rdataOff: Int = 0
        var i: Int = 0
        while (i < parts.size) {
            if (parts[i] != "") {
                recs.add("@str." + this.toStr(i) + "|" + this.toStr(rdataOff) + "|2|0|3")
                // 偏移按**去引号后**的载荷长度累加，必须与 `stringConstsToHex`
                // 实际写入的字节数一致（两处都用 `unquote`），否则 @str.N 错位。
                rdataOff = rdataOff + this.unquote(parts[i]).length + 1  // 内容 + NUL 终止符
            }
            i = i + 1
        }

        this.objwProbe("sym2 strConsts done recs=" + this.toStr(recs.size) +
                " rdataOff=" + this.toStr(rdataOff))

        // 2b) .data 节符号：值为节内偏移，section 按实际节顺序计算。
        //     有 .rdata 时 .data 为第 3 节，否则为第 2 节。
        //
        //     `dataSymbolName` 支持逗号分隔的多个条目，形如 `name` 或 `name:size`
        //    （如 "toStrBuffer:32,strcatBuffer:128"）。偏移按声明顺序累加，
        //     未写 size 时默认 8 字节。
        //
        //     ⚠ 旧实现固定「第 i 个名字 → 偏移 8*i」，于是 toStrBuffer 与
        //     strcatBuffer 各只有 8 字节并互相重叠 —— toStr 写 32 字节就会
        //     踩坏相邻缓冲区。
        if (this.dataSymbolName != "" && this.dataSection != "") {
            var dataSecNum: Int = 2
            if (this.stringConsts != "") {
                dataSecNum = 3
            }
            val dparts: List<String> = this.splitComma(this.dataSymbolName)
            var dataOff: Int = 0
            var di: Int = 0
            while (di < dparts.size) {
                val spec: String = dparts[di]
                if (spec != "") {
                    var nm: String = spec
                    var sz: Int = 8
                    val colon: Int = spec.indexOf(":")
                    if (colon > 0) {
                        nm = spec.substring(0, colon)
                        sz = this.strToInt(spec.substring(colon + 1))
                    }
                    recs.add(nm + "|" + this.toStr(dataOff) + "|" + this.toStr(dataSecNum) + "|0|2")
                    dataOff = dataOff + sz
                }
                di = di + 1
            }
        }

        // 3) 重定位引用的外部符号（section = 0 表示未定义，由链接器解析）
        this.objwProbe("sym3 collecting externals recs=" + this.toStr(recs.size))
        val externals: List<String> = this.collectExternalSymbols()
        this.objwProbe("sym3 externals done recs=" + this.toStr(recs.size) +
                " ext=" + this.toStr(externals.size))
        var j: Int = 0
        while (j < externals.size) {
            recs.add(externals[j] + "|0|0|0x0020|2")
            j = j + 1
        }

        this.objwProbe("sym4 joining recs=" + this.toStr(recs.size))
        this.symbols = this.joinRecords(recs)
        this.objwProbe("sym4 done symChars=" + this.toStr(this.symbols.length))
    }

    // ── 重定位表构建 ──

    /// 设置重定位表原始内容（格式：条目以 `;;` 分隔，每条 `offset|symbol|type`）。
    private fun buildRelocs(relocEntries: String): Unit {
        this.relocs = relocEntries
        this.coffRelocCacheValid = false
    }

    /// 解析重定位条目列表。
    ///
    /// 兼容两种拼接形式：
    ///   - 条目间以 `;;` 分隔（`X86Encoder.getRelocations()` 的标准拼接）
    ///   - 条目首尾直接以 `|` 相连（每 3 个字段为一条记录）
    private fun parseRelocEntries(text: String): List<String> {
        val out: List<String> = arrayListOf<String>()
        if (text == "") {
            return out
        }
        // 紧凑形式：多条记录以 `|` 直连、整串无 `;`/`;;`
        // （`X86Emitter.joinRelocRecords` 的输出，见 X86Emitter.aura:452）。
        // 必须先判空再走 `;;`/`;` 分支，否则整串会被当作**单条** 6+ 字段记录，
        // 除首条外的所有重定位（典型如 `main` 里 `call println` 的 REL32）
        // 会连带其外部符号一起丢失，链接器便无 relocation 可回填。
        // 判据：无 `;` 时 `splitSemi` 只返回 1 个元素。
        if (this.splitSemi(text).size <= 1) {
            val fields: List<String> = this.splitPipe(text)
            var k: Int = 0
            while (k + 2 < fields.size) {
                out.add(fields[k] + "|" + fields[k + 1] + "|" + fields[k + 2])
                k = k + 3
            }
            return out
        }
        // 分组形式：先按 `;;` 分隔函数组，再按 `;` 分隔组内条目
        val byDoubleSemi: List<String> = this.splitDoubleSemi(text)
        var gi: Int = 0
        while (gi < byDoubleSemi.size) {
            val group: String = byDoubleSemi[gi]
            if (group != "") {
                // 按 `;` 分隔组内的条目
                val bySemi: List<String> = this.splitSemi(group)
                var si: Int = 0
                while (si < bySemi.size) {
                    if (bySemi[si] != "") {
                        out.add(bySemi[si])
                    }
                    si = si + 1
                }
            }
            gi = gi + 1
        }
        return out
    }

    /// 收集「被重定位引用、但本模块未定义」的外部符号（去重，保持出现顺序）。
    ///
    /// `functions` / `dataSymbolName` 的切分结果**只算一次**并传入
    /// `isDefinedSymbolIn`：本方法对每条重定位各查一次，旧实现每次都在
    /// `isDefinedSymbol` 里重新 `splitComma(this.functions)`（2,647 个函数名
    /// → 2,647 次切片分配 + 1 次列表分配），17,066 条重定位 × 2,647 是纯重复
    /// 分配。
    private fun collectExternalSymbols(): List<String> {
        val out: List<String> = arrayListOf<String>()
        val funcs: List<String> = this.splitComma(this.functions)
        val dnames: List<String> = if (this.dataSymbolName != "") {
            this.splitComma(this.dataSymbolName)
        } else {
            arrayListOf<String>()
        }
        val entries: List<String> = this.parseRelocEntries(this.relocs)
        var i: Int = 0
        while (i < entries.size) {
            val fields: List<String> = this.splitPipe(entries[i])
            if (fields.size >= 2) {
                val sym: String = fields[1]
                if (!this.isDefinedSymbolIn(sym, funcs, dnames) && !this.containsString(out, sym)) {
                    out.add(sym)
                }
            }
            i = i + 1
        }
        return out
    }

    /// 判断符号是否由本模块定义（函数名，或 `@str.N` 形式的字符串常量，或 .data 符号）。
    ///
    /// `funcs` / `dnames` 由调用方预切分传入（见 `collectExternalSymbols` 的说明），
    /// 内部只做指针比较，**零分配**。
    private fun isDefinedSymbolIn(name: String, funcs: List<String>, dnames: List<String>): Boolean {
        if (this.hasPrefix(name, "@str.")) {
            return true
        }
        var dn: Int = 0
        while (dn < dnames.size) {
            // 条目可能带 `:size` 后缀，必须去掉后再比较
            if (dnames[dn] != "" && this.dataSymbolBaseName(dnames[dn]) == name) {
                return true
            }
            dn = dn + 1
        }
        var i: Int = 0
        while (i < funcs.size) {
            if (funcs[i] != "" && funcs[i] == name) {
                return true
            }
            i = i + 1
        }
        return false
    }

    /// 组成重定位记录（`offset|symbolIndex|coffType`），解析符号名到符号表索引。
    ///
    /// 重定位偏移已在 `appendFunction` 中按函数基准换算为节内绝对偏移，
    /// 此处仅需解析符号名到符号表索引。
    private fun composeRelocations(): List<String> {
        if (this.coffRelocCacheValid) {
            return this.coffRelocCache
        }
        val out: List<String> = arrayListOf<String>()
        val symRecs: List<String> = this.splitDoubleSemi(this.symbols)

        // 符号名只切分一次：`symbolIndexOf` 的线性扫描在每个重定位条目上各跑
        // 一遍，旧写法每比较一次都要 `splitPipe` 分配一次列表 + 子串，AOT 无
        // GC 下全部常驻。预切分后扫描只做指针比较。
        val symNames: List<String> = arrayListOf<String>()
        var sn: Int = 0
        while (sn < symRecs.size) {
            symNames.add(this.symbolName(symRecs[sn]))
            sn = sn + 1
        }

        // 按 `;;` 分隔函数组，每个组内的条目属于同一个函数
        val groups: List<String> = this.splitDoubleSemi(this.relocs)
        var fi: Int = 0
        while (fi < groups.size) {
            val group: String = groups[fi]
            if (group != "") {
                // 解析该组内的重定位条目
                val entries: List<String> = this.parseRelocEntries(group)
                var i: Int = 0
                while (i < entries.size) {
                    val fields: List<String> = this.splitPipe(entries[i])
                    if (fields.size >= 3) {
                        val idx: Int = this.indexOfName(symNames, fields[1])
                        if (idx >= 0) {
                            val absoluteOffset: Int = this.strToInt(fields[0])
                            out.add(this.toStr(absoluteOffset) + "|" + this.toStr(idx) + "|" + this.toStr(this.coffRelocType(fields[2])))
                        }
                    }
                    i = i + 1
                }
            }
            fi = fi + 1
        }
        this.coffRelocCache = out
        this.coffRelocCacheValid = true
        return out
    }

    /// 在**已切分**的符号名列表中按名字查找索引（未找到返回 -1）。
    ///
    /// 纯指针比较，零分配。旧版 `symbolIndexOf` 每次比较都 `splitPipe`。
    private fun indexOfName(names: List<String>, name: String): Int {
        var i: Int = 0
        while (i < names.size) {
            if (names[i] == name) {
                return i
            }
            i = i + 1
        }
        return -1
    }

    /// 按重定位条目序号（已按 appendFunction 调用顺序展平）定位所属函数的 .text 基准。
    private fun textOffsetForEntryIndex(entryIndex: Int, offsetParts: List<String>): Int {
        if (offsetParts.size == 0) {
            return 0
        }
        if (entryIndex < offsetParts.size) {
            val of: List<String> = this.splitPipe(offsetParts[entryIndex])
            if (of.size >= 2) {
                return this.strToInt(of[1])
            }
        }
        // 没有精确元数据时保持旧行为：所有条目都视为属于首函数。
        val first: List<String> = this.splitPipe(offsetParts[0])
        if (first.size >= 2) {
            return this.strToInt(first[1])
        }
        return 0
    }

    /// 在符号记录列表中按名字查找索引（未找到返回 -1）。
    private fun symbolIndexOf(symRecs: List<String>, name: String): Int {
        var i: Int = 0
        while (i < symRecs.size) {
            val f: List<String> = this.splitPipe(symRecs[i])
            if (f.size > 0 && f[0] == name) {
                return i
            }
            i = i + 1
        }
        return -1
    }

    /// 重定位类型名 → COFF 类型码。
    ///
    /// IMAGE_REL_AMD64_REL32 = 0x0004（RIP 相对 32 位，适用于 `call rel32`
    /// 与 `[rip+disp32]`），IMAGE_REL_AMD64_ADDR64 = 0x0001。
    private fun coffRelocType(typeName: String): Int {
        if (typeName == "R_X86_64_REL32" || typeName == "R_X86_64_PLT32" ||
            typeName == "R_X86_64_PC32" || typeName == "REL32") {
            return 0x0004
        }
        if (typeName == "R_X86_64_64" || typeName == "ADDR64") {
            return 0x0001
        }
        return this.strToInt(typeName)
    }

    /// 取符号记录中的名字（第一个 `|` 之前的字段）。
    private fun symbolName(rec: String): String {
        val f: List<String> = this.splitPipe(rec)
        if (f.size > 0) {
            return f[0]
        }
        return ""
    }

    /// 以 `;;` 连接记录列表。
    ///
    /// ⚠️ 旧实现是 `out = out + recs[i]`：Aura 的 String 不可变，每拼一条都要
    /// 把**已累积的全部记录**整段拷贝 ⇒ O(记录数²)。自举 `Main.aura` 有
    /// 2,647 个函数符号 + **57,232 个字符串常量符号**（共约 6 万条、总长 ~1.2MB），
    /// 这一步单独的理论拷贝量约 12 GB，AOT 运行时无 GC（`free_calls=0`）全部
    /// 驻留 —— Phase E 在 `buildSymbols` 里把 8 GiB 上限打穿（退出码 70）。
    ///
    /// 现改为「先逐条入列表（含分隔符），再两两归并」（`coffJoinList`）：
    /// 追加 O(1)、归并 O(总长 · log 记录数)。
    private fun joinRecords(recs: List<String>): String {
        val parts: List<String> = arrayListOf<String>()
        var i: Int = 0
        while (i < recs.size) {
            if (i > 0) { parts.add(";;") }
            parts.add(recs[i])
            i = i + 1
        }
        return this.coffJoinList(parts)
    }

    /// 判断字符串列表是否包含指定元素。
    private fun containsString(list: List<String>, value: String): Boolean {
        var i: Int = 0
        while (i < list.size) {
            if (list[i] == value) {
                return true
            }
            i = i + 1
        }
        return false
    }

    // ── COFF 文件构建 ──

    /// 构建完整的 COFF 目标文件（返回 hex 字符串）。
    ///
    /// ── 布局（严格按 Microsoft PE/COFF 规范）──
    ///
    /// ```
    ///   0            IMAGE_FILE_HEADER            20 字节
    ///   20           IMAGE_SECTION_HEADER × N     40 字节/节
    ///   20+40N       .text 原始数据                （16 字节对齐）
    ///   …            .rdata 原始数据               （4 字节对齐）
    ///   …            .text 重定位表                （10 字节/项）
    ///   …            符号表                        （18 字节/项）
    ///   …            字符串表                      （4 字节长度前缀 + 名称串）
    /// ```
    ///
    /// **关键约束**：所有 PointerToXxx 都必须由「实际写入的字节数」推出。
    /// 原实现把字符串表按 20 字节记账、实际只写 18 字节，并且节头多写了 4 字节
    /// （44 vs 40），导致符号表实际位置比声明位置早 2 字节 —— 链接器按声明偏移
    /// 读取时，符号名整体错位 2 字节（"main" → "in"、"@str.0" → "tr.0"）。
    fun buildCoffFile(): String {
        this.objwProbe("coff enter textChars=" + this.toStr(this.textSection.length) +
                " strConstChars=" + this.toStr(this.stringConsts.length) +
                " dataChars=" + this.toStr(this.dataSection.length))
        // ── 1. 规整节内容 ──
        this.textSection = this.normalizeHex(this.textSection)
        this.objwProbe("coff 1a normalizeHex(text) ok len=" + this.toStr(this.textSection.length))
        this.textSize = this.hexByteCount(this.textSection)
        this.objwProbe("coff 1b textSize=" + this.toStr(this.textSize))
        this.rdataSection = this.stringConstsToHex(this.stringConsts)
        this.objwProbe("coff 1c stringConstsToHex ok rdataChars=" +
                this.toStr(this.rdataSection.length))
        this.rdataSize = this.hexByteCount(this.rdataSection)
        this.objwProbe("coff 1d rdataSize=" + this.toStr(this.rdataSize))
        this.dataSection = this.normalizeHex(this.dataSection)
        // 把 .data 补齐到 `dataSymbolName` 声明的总大小。
        //
        // 为什么需要：`dataSection` 的 hex 是**逐字节**写死的，而符号大小写在
        // `dataSymbolName`（`name:size`）。若 hex 比声明短，节的实际大小就以
        // hex 为准 —— 符号会指向节尾之外（读/写越界）。字符串堆 arena 有
        // 数千字节，不可能在 Aura 源码里手写等长的零 hex，因此由 writer
        // 按声明大小补零。
        this.dataSection = this.padDataSectionToDeclaredSize()
        this.dataSize = this.hexByteCount(this.dataSection)

        // ── 2. 计数 ──
        this.coffSectionCount = 1
        if (this.rdataSize > 0) {
            this.coffSectionCount = 2
        }
        if (this.dataSize > 0) {
            this.coffSectionCount = this.coffSectionCount + 1
        }
        val symRecs: List<String> = this.splitDoubleSemi(this.symbols)
        this.coffSymCount = symRecs.size
        this.objwProbe("coff2 symCount=" + this.toStr(this.coffSymCount))
        val relocRecs: List<String> = this.composeRelocations()
        this.coffRelocCount = relocRecs.size
        this.objwProbe("coff3 relocCount=" + this.toStr(this.coffRelocCount))

        // ── 3. 长符号名 → 字符串表 ──
        // ⚠ `coffStrTabHex = coffStrTabHex + ...` 是 O(条目数²)：符号数上万、
        // 表体上 MB 时每次拼接都整段拷贝。同样改用列表累积。
        val strTabParts: List<String> = arrayListOf<String>()
        this.coffStrTabSize = 4
        var s: Int = 0
        while (s < this.coffSymCount) {
            val nm: String = this.symbolName(symRecs[s])
            if (nm.length >= 8) {
                strTabParts.add(this.asciiToHex(nm, -1) + "00")
                this.coffStrTabSize = this.coffStrTabSize + nm.length + 1
            }
            s = s + 1
        }
        this.coffStrTabHex = this.coffJoinList(strTabParts)
        this.objwProbe("coff4 strTab done parts=" + this.toStr(strTabParts.size) +
                " strTabHexChars=" + this.toStr(this.coffStrTabHex.length))

        // ── 4. 布局偏移 ──
        val headerSize: Int = 20
        val sectionHeaderSize: Int = 42
        val sectionTableEnd: Int = headerSize + sectionHeaderSize * this.coffSectionCount
        val textRawOffset: Int = this.alignUp(sectionTableEnd, 16)
        val textRawEnd: Int = textRawOffset + this.textSize
        val rdataRawOffset: Int = this.alignUp(textRawEnd, 4)
        val rdataRawEnd: Int = rdataRawOffset + this.rdataSize
        val dataRawOffset: Int = this.alignUp(rdataRawEnd, 4)
        val dataRawEnd: Int = dataRawOffset + this.dataSize
        this.coffRelocOffset = this.alignUp(dataRawEnd, 4)
        this.coffSymTabOffset = this.coffRelocOffset + 10 * this.coffRelocCount

        this.textOffset = textRawOffset
        this.rdataOffset = rdataRawOffset
        this.dataOffset = dataRawOffset

        // ── 5. 构建缓冲区 ──
        // ⚠ 见 `coffBuf` 的说明：必须用列表累积，不能用 `buf = buf + ...`。
        this.coffReset()
        this.objwProbe("coff5 layout textOff=" + this.toStr(this.textOffset) +
                " rdataOff=" + this.toStr(this.rdataOffset) +
                " dataOff=" + this.toStr(this.dataOffset) +
                " relocOff=" + this.toStr(this.coffRelocOffset))
        this.buildCoffHeader()
        this.buildSectionHeaders()
        this.coffAppend(this.padToBytes(textRawOffset))
        this.coffAppend(this.textSection)
        if (this.rdataSize > 0) {
            this.coffAppend(this.padToBytes(rdataRawOffset))
            this.coffAppend(this.rdataSection)
        }
        if (this.dataSize > 0) {
            this.coffAppend(this.padToBytes(dataRawOffset))
            this.coffAppend(this.dataSection)
        }
        this.objwProbe("coff6 sections done bufParts=" + this.toStr(this.coffBuf.size) +
                " bufHexChars=" + this.toStr(this.coffBufHexLen()))
        this.buildRelocationTable()
        this.objwProbe("coff7 relocTable done bufHexChars=" + this.toStr(this.coffBufHexLen()))
        this.buildSymbolTable()
        this.objwProbe("coff8 symTable done bufHexChars=" + this.toStr(this.coffBufHexLen()))
        this.buildStringTable()
        this.objwProbe("coff9 strTable done bufHexChars=" + this.toStr(this.coffBufHexLen()))

        return this.coffJoin()
    }

    /// 追加一个片段到 COFF 缓冲（O(1)）。
    private fun coffAppend(part: String): Unit {
        this.coffBuf.add(part)
    }

    /// 清空 COFF 缓冲。
    private fun coffReset(): Unit {
        this.coffBuf = arrayListOf<String>()
    }

    /// 把 COFF 缓冲归并成完整 hex 串。
    ///
    /// 两两归并：每层拷贝总量恒为 O(总长)，共 O(log 片段数) 层
    /// ⇒ 总分配 O(总长 · log 片段数)，避免 `buf = buf + part` 的 O(总长²)。
    /// 与 `X86Encoder.joinBytes` 同一手法。
    private fun coffJoin(): String {
        return this.coffJoinList(this.coffBuf)
    }

    /// 把片段列表两两归并成单个字符串。
    ///
    /// 每层拷贝总量恒为 O(总长)，共 O(log 片段数) 层 ⇒ 总分配
    /// O(总长 · log 片段数)，避免 `out = out + part` 的 O(总长²)。
    /// 与 `X86Encoder.joinBytes` 同一手法。
    private fun coffJoinList(parts: List<String>): String {
        if (parts.size == 0) {
            return ""
        }
        var cur: List<String> = parts
        while (cur.size > 1) {
            val next: List<String> = arrayListOf<String>()
            var i: Int = 0
            while (i < cur.size) {
                if (i + 1 < cur.size) {
                    next.add(cur[i] + cur[i + 1])
                } else {
                    next.add(cur[i])
                }
                i = i + 2
            }
            cur = next
        }
        return cur[0]
    }

    /// 生成 (target - 当前 COFF 缓冲字节数) 的 0 字节填充。
    ///
    /// ⚠ 用**倍增**生成：逐字节 `out = out + "00"` 是 O(填充²)（每次整段拷贝），
    /// 填充上万字节时不可接受。倍增把已有块自身翻倍：拷贝量 2,4,8,…,need，
    /// 总计 O(need)。
    private fun padToBytes(target: Int): String {
        var need: Int = target * 2 - this.coffBufHexLen()
        if (need <= 0) {
            return ""
        }
        var block: String = "00"
        while (block.length < need) {
            block = block + block
        }
        if (block.length > need) {
            block = block.substring(0, need)
        }
        return block
    }

    /// 生成 (target - current 字节数) 的 0 字节填充。
    ///
    /// `buildElfFile`（Linux 路径）沿用显式传 buf 的旧写法；不能与上面的
    /// `padToBytes` 同名 —— Aura 无重载，后定义会静默遮蔽前者。同样用倍增。
    private fun padToBytesAt(current: String, target: Int): String {
        var need: Int = target * 2 - current.length
        if (need <= 0) {
            return ""
        }
        var block: String = "00"
        while (block.length < need) {
            block = block + block
        }
        if (block.length > need) {
            block = block.substring(0, need)
        }
        return block
    }

    /// 当前 COFF 缓冲的 hex 字符总数。
    private fun coffBufHexLen(): Int {
        var n: Int = 0
        var i: Int = 0
        while (i < this.coffBuf.size) {
            n = n + this.coffBuf[i].length
            i = i + 1
        }
        return n
    }

    /// 构建 COFF 文件头（20 字节）。
    private fun buildCoffHeader(): Unit {
        this.coffAppend(this.writeIntLe(0x8664, 2))        // Machine = IMAGE_FILE_MACHINE_AMD64
        this.coffAppend(this.writeIntLe(this.coffSectionCount, 2))  // NumberOfSections
        this.coffAppend(this.writeIntLe(0, 4))             // TimeDateStamp
        this.coffAppend(this.writeIntLe(this.coffSymTabOffset, 4))  // PointerToSymbolTable
        this.coffAppend(this.writeIntLe(this.coffSymCount, 4))      // NumberOfSymbols
        this.coffAppend(this.writeIntLe(0, 2))             // SizeOfOptionalHeader
        this.coffAppend(this.writeIntLe(0, 2))             // Characteristics（.obj 为 0）
    }

    /// 构建节头条目（42 字节/节）。
    private fun buildSectionHeaders(): Unit {
        this.coffAppend(this.padSectionName(".text", 8))
        this.coffAppend(this.writeIntLe(0, 4))              // VirtualSize（.obj 为 0）
        this.coffAppend(this.writeIntLe(0, 4))              // VirtualAddress
        this.coffAppend(this.writeIntLe(this.textSize, 4))  // SizeOfRawData
        this.coffAppend(this.writeIntLe(this.textOffset, 4))  // PointerToRawData
        this.coffAppend(this.writeIntLe(this.coffRelocOffset, 4))    // PointerToRelocations
        this.coffAppend(this.writeIntLe(0, 4))              // PointerToLinenumbers
        this.coffAppend(this.writeIntLe(this.coffRelocCount, 2))     // NumberOfRelocations
        this.coffAppend(this.writeIntLe(0, 2))              // NumberOfLinenumbers
        this.coffAppend(this.writeIntLe(0x60500020, 4))     // CNT_CODE|MEM_EXECUTE|MEM_READ|ALIGN_16

        if (this.rdataSize > 0) {
            this.coffAppend(this.padSectionName(".rdata", 8))
            this.coffAppend(this.writeIntLe(0, 4))
            this.coffAppend(this.writeIntLe(0, 4))
            this.coffAppend(this.writeIntLe(this.rdataSize, 4))
            this.coffAppend(this.writeIntLe(this.rdataOffset, 4))
            this.coffAppend(this.writeIntLe(0, 4))          // 无重定位
            this.coffAppend(this.writeIntLe(0, 4))
            this.coffAppend(this.writeIntLe(0, 2))
            this.coffAppend(this.writeIntLe(0, 2))
            this.coffAppend(this.writeIntLe(0x40300040, 4)) // CNT_INITIALIZED_DATA|MEM_READ|ALIGN_4
        }
        if (this.dataSize > 0) {
            this.coffAppend(this.padSectionName(".data", 8))
            this.coffAppend(this.writeIntLe(0, 4))
            this.coffAppend(this.writeIntLe(0, 4))
            this.coffAppend(this.writeIntLe(this.dataSize, 4))
            this.coffAppend(this.writeIntLe(this.dataOffset, 4))
            this.coffAppend(this.writeIntLe(0, 4))          // 无重定位
            this.coffAppend(this.writeIntLe(0, 4))
            this.coffAppend(this.writeIntLe(0, 2))
            this.coffAppend(this.writeIntLe(0, 2))
            this.coffAppend(this.writeIntLe(0xC0400040, 4)) // CNT_INITIALIZED_DATA|MEM_READ|MEM_WRITE|ALIGN_4
        }
    }

    /// 构建重定位表（10 字节/项：VA(4) + SymbolTableIndex(4) + Type(2)）。
    private fun buildRelocationTable(): Unit {
        val relocRecs: List<String> = this.composeRelocations()
        this.coffAppend(this.padToBytes(this.coffRelocOffset))
        var r: Int = 0
        while (r < this.coffRelocCount) {
            val rf: List<String> = this.splitPipe(relocRecs[r])
            this.coffAppend(this.writeIntLe(this.strToInt(rf[0]), 4))  // 节内偏移 (VirtualAddress)
            this.coffAppend(this.writeIntLe(this.strToInt(rf[1]), 4))  // 符号索引 (SymbolTableIndex)
            this.coffAppend(this.writeIntLe(this.strToInt(rf[2]), 2))  // 类型 (Type: REL32 = 4)
            r = r + 1
        }
    }

    /// 构建符号表（18 字节/项）。
    private fun buildSymbolTable(): Unit {
        val symRecs: List<String> = this.splitDoubleSemi(this.symbols)
        this.coffAppend(this.padToBytes(this.coffSymTabOffset))

        // 计算长符号名偏移
        val strNameOffsets: List<Int> = arrayListOf<Int>()
        var strTabSize: Int = 4
        var s: Int = 0
        while (s < this.coffSymCount) {
            val nm: String = this.symbolName(symRecs[s])
            if (nm.length >= 8) {
                strNameOffsets.add(strTabSize)
                strTabSize = strTabSize + nm.length + 1
            } else {
                strNameOffsets.add(-1)
            }
            s = s + 1
        }

        var i: Int = 0
        while (i < this.coffSymCount) {
            val f: List<String> = this.splitPipe(symRecs[i])
            if (strNameOffsets[i] >= 0) {
                // 长名：4 字节 0 + 4 字节字符串表偏移
                this.coffAppend(this.writeIntLe(0, 4))
                this.coffAppend(this.writeIntLe(strNameOffsets[i], 4))
            } else {
                this.coffAppend(this.padSectionName(f[0], 8))          // Name（短名内联）
            }
            this.coffAppend(this.writeIntLe(this.strToInt(f[1]), 4))   // Value
            this.coffAppend(this.writeIntLe(this.strToInt(f[2]), 2))   // SectionNumber
            this.coffAppend(this.writeIntLe(this.hexToInt(f[3]), 2))   // Type
            this.coffAppend(this.writeIntLe(this.strToInt(f[4]), 1))   // StorageClass
            this.coffAppend(this.writeIntLe(0, 1))                     // NumberOfAuxSymbols
            i = i + 1
        }
    }

    /// 构建字符串表（长度前缀 + 长名串）。
    private fun buildStringTable(): Unit {
        this.coffAppend(this.writeIntLe(this.coffStrTabSize, 4))
        this.coffAppend(this.coffStrTabHex)
    }

    // ── 布局辅助 ──

    /// 向上对齐到 alignment 的整数倍。
    private fun alignUp(value: Int, alignment: Int): Int {
        if (alignment <= 1) {
            return value
        }
        return ((value + alignment - 1) / alignment) * alignment
    }

    // ── 种子 VM 安全的字符串原语 ──
    //
    // 背景：经 `aura/seed/aura.exe`（字节码 VM）执行时，stdio/stdlib 里的
    // `String.substring` / `String.charCodeAt` / `String.startsWith` / `List.get`
    // 都是**未链接外部函数**（`[vm] Unlinked external function`），一律返回
    // 默认值 —— `substring(...)` 恒返回 `"0"`、`charCodeAt(...)` 恒返回 0 号字符的
    // 码值。实测可用的只有 `s[i]` 索引、`s.length`、`==` 与 `+`。
    //
    // 因此 COFF 组装不能依赖上述方法，这里用「索引 + 已知字符表」重建它们。

    /// 取第 i 个字符（1 字符字符串）；越界返回空串。
    private fun chAt(s: String, i: Int): String {
        if (i < 0 || i >= s.length) {
            return ""
        }
        return s[i]
    }

    /// 判断 `s` 在 `i` 处是否为字符 `c`。
    ///
    /// ⚠️ 必须用 `charCodeAt` 而**不能**用 `s[i]`：`s[i]` 在 AOT 下发射为对
    /// `String_charAt` 的调用 —— 每次索引都新建一个**单字符字符串**
    /// （`String_charAt` → `aura_string_charAt` → `aura_dup_n`）。而本方法被
    /// `splitComma` / `splitPipe` / `splitSemi` / `splitDoubleSemi` /
    /// `isDoubleSemi` 等所有切分原语**逐字符**调用，自举 `Main.aura` 全管线
    /// 累计 **3.67 亿次**单字符分配（`aura_dup_n` 归因 367,357,759 次 /
    /// 963 MB 常驻），AOT 运行时无 GC（`free_calls=0`）全部驻留。
    /// `charCodeAt` 是内联访存（见 `String.aura:279` 的说明），零分配。
    private fun chEq(s: String, i: Int, c: String): Boolean {
        if (c.length != 1) {
            return false
        }
        // ⚠️ 绝不能在这里取 `s.length`：AOT 下 `String.length` 是 `strlen(s)`
        // （O(|s|)），而本方法被 splitPipe / splitSemi / splitDoubleSemi /
        // splitComma 等**逐字符**调用 —— `while (i < len) { chEq(s, i, ";") }`
        // 于是退化成 O(|s|²)。实测：对 500KB 的重定位串做一次 splitSemi
        // 就要扫描 ~250 GB 字节，composeRelocations 单次耗时 84 秒（且被
        // 调用两次）、collectExternalSymbols 43 秒，COFF 组装合计 212 秒。
        // 越界判定交给 `charCodeAt`：它对越界（含 i<0）返回 -1，与任何
        // 合法字符码（≥0）都不相等 → 语义与旧写法一致，且零 strlen。
        return (s.charCodeAt(i) as Int) == (c.charCodeAt(0) as Int)
    }

    /// 判断 `s` 在 `i` 处是否为 `";;"`（符号条目分隔符）。
    private fun isDoubleSemi(s: String, i: Int): Boolean {
        return this.chEq(s, i, ";") && this.chEq(s, i + 1, ";")
    }

    /// 切片 `[start, end)`。
    ///
    /// ⚠️ 旧实现是 `while (i < e) { out = out + s[i] }` —— **逐字符拼接**，
    /// 每次都要复制已累积前缀 ⇒ 对长度为 L 的切片是 O(L²)（L 次
    /// `aura_string_concat` + 累计 O(L²) 字节）。而本方法是**所有切分辅助
    /// （`splitComma` / `splitCommaQuoted` / `splitPipe` / `splitSemi` /
    /// `splitDoubleSemi` / `unquote`）的唯一底层切片**，又被 `isDefinedSymbol`
    /// 在**每条重定位**上各调一遍 —— 自举 `Main.aura`（17,066 条重定位 ×
    /// 2,647 个函数名符号）实测在 Phase E 单独吃掉约 7 GB 常驻分配
    /// （`aura_string_concat` 归因 7,013 MB / 8,400,000+ 次调用），AOT 运行时
    /// 无 GC（`free_calls=0`）全部驻留，8 GiB 上限在此被打穿（退出码 70）。
    ///
    /// `String.substring` 本身就是「一次 `malloc(n+1)` + 逐字节写入」（见
    /// `aura/core/aura/lang/String.aura` 的 `substring` 说明），零中间串，
    /// 直接委托即可。
    private fun sliceOf(s: String, start: Int, end: Int): String {
        // ⚠️ 不能再取 `s.length`：AOT 下它是 `strlen(s)`（O(|s|)），而本方法
        // 是**所有**切分辅助（splitComma / splitCommaQuoted / splitPipe /
        // splitSemi / splitDoubleSemi / unquote）的唯一底层切片，对大串切 N 刀
        // 就是 O(N·|s|)。`start`/`end` 一律来自对 `s` 自身的扫描（chEq /
        // charCodeAt），天然落在串内；越界的情形由 `substring` 的 NUL 截断
        // 兜住（见 C 侧 `aura_string_substring` 的有界扫描说明）。
        var st: Int = start
        if (st < 0) { st = 0 }
        var en: Int = end
        if (en <= st) { return "" }
        return s.substring(st, en)
    }

    /// 判断 `s` 是否以 `prefix` 开头（`startsWith` 的种子 VM 安全替代）。
    private fun hasPrefix(s: String, prefix: String): Boolean {
        // 先判长度：否则 `s.charCodeAt(i)` 越界返回 -1 也能算对，
        // 但每次比较都白付两次 `strlen`。
        if (prefix.length > s.length) {
            return false
        }
        var i: Int = 0
        while (i < prefix.length) {
            // `charCodeAt` 直取码值：`s[i]` 每次索引都新建单字符字符串（见 `chEq` 说明）。
            if ((s.charCodeAt(i) as Int) != (prefix.charCodeAt(i) as Int)) {
                return false
            }
            i = i + 1
        }
        return true
    }

    /// 取字符的 ASCII 码（`charCodeAt` 的种子 VM 安全替代）。
    ///
    /// 实现为「已知字符表 + 线性查找」：可打印 ASCII 被切成若干连续段，
    /// 段内 `code = base + index`。未收录字符（如反引号）返回 -1，
    /// 由调用方降级为 `00`。
    private fun codeOf(c: String): Int {
        if (c == "") { return -1 }
        if (c == " ") { return 32 }
        if (c == "!") { return 33 }
        if (c == "\"") { return 34 }
        if (c == "#") { return 35 }
        if (c == "$") { return 36 }
        if (c == "[") { return 91 }
        if (c == "\\") { return 92 }
        if (c == "]") { return 93 }
        if (c == "^") { return 94 }
        if (c == "_") { return 95 }
        if (c == "{") { return 123 }
        if (c == "|") { return 124 }
        if (c == "}") { return 125 }
        if (c == "~") { return 126 }

        var i: Int = 0
        val seg1: String = "%&'()*+,-./"
        while (i < seg1.length) {
            if (c == seg1[i]) { return 37 + i }
            i = i + 1
        }
        val digits: String = "0123456789"
        i = 0
        while (i < digits.length) {
            if (c == digits[i]) { return 48 + i }
            i = i + 1
        }
        val seg2: String = ":;<=>?@"
        i = 0
        while (i < seg2.length) {
            if (c == seg2[i]) { return 58 + i }
            i = i + 1
        }
        val upper: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        i = 0
        while (i < upper.length) {
            if (c == upper[i]) { return 65 + i }
            i = i + 1
        }
        val lower: String = "abcdefghijklmnopqrstuvwxyz"
        i = 0
        while (i < lower.length) {
            if (c == lower[i]) { return 97 + i }
            i = i + 1
        }
        return -1
    }

    /// 码值 → 2 位 hex（无效码值降级为 `00`）。
    private fun byteHex(code: Int): String {
        if (code < 0 || code > 255) {
            return "00"
        }
        return this.hexDigit(code / 16) + this.hexDigit(code % 16)
    }

    /// 十进制数字字符 → 数值（非数字返回 0）。
    private fun digitOf(c: String): Int {
        var i: Int = 0
        val digits: String = "0123456789"
        while (i < digits.length) {
            if (c == digits[i]) { return i }
            i = i + 1
        }
        return 0
    }

    /// 十六进制数字字符 → 数值（无效返回 0）。
    private fun hexValOf(c: String): Int {
        var i: Int = 0
        val lower: String = "0123456789abcdef"
        while (i < lower.length) {
            if (c == lower[i]) { return i }
            i = i + 1
        }
        val upper: String = "0123456789ABCDEF"
        i = 0
        while (i < upper.length) {
            if (c == upper[i]) { return i }
            i = i + 1
        }
        return 0
    }

    // ── 辅助方法 ──

    /// 计算节数量。
    private fun countSections(): Int {
        var count: Int = 1  // .text
        if (this.rdataSize > 0) {
            count = count + 1  // .rdata
        }
        return count
    }

    /// 计算重定位项数量。
    private fun countRelocs(): Int {
        if (this.relocs == "") {
            return 0
        }
        return this.splitDoubleSemi(this.relocs).size
    }

    /// 计算符号数量。
    private fun countSymbols(): Int {
        if (this.symbols == "") {
            return 0
        }
        var count: Int = 0
        var start: Int = 0
        var i: Int = 0
        var len: Int = this.symbols.length
        while (i < len - 1) {
            if (this.isDoubleSemi(this.symbols, i)) {
                count = count + 1
                start = i + 2
            }
            i = i + 1
        }
        if (start < len) {
            count = count + 1
        }
        return count
    }

    /// 规范化 hex 字符串（确保偶数长度）。
    private fun normalizeHex(hex: String): String {
        if (hex.length % 2 != 0) {
            return "0" + hex
        }
        return hex
    }

    /// 计算 hex 字符串的字节数。
    private fun hexByteCount(hex: String): Int {
        return hex.length / 2
    }

    /// 把 `.data` hex 内容补齐到 `dataSymbolName` 声明的总字节数（补零）。
    ///
    /// `dataSymbolName` 形如 `toStrBuffer:32,strcatArena:4096,strcatBump:8`；
    /// 声明大小即符号跨距，节的实际大小必须 ≥ 该跨距，否则符号指向节外。
    private fun padDataSectionToDeclaredSize(): String {
        if (this.dataSymbolName == "") { return this.dataSection }
        val specs: List<String> = this.splitComma(this.dataSymbolName)
        var declared: Int = 0
        var i: Int = 0
        while (i < specs.size) {
            val spec: String = specs[i]
            if (spec != "") {
                val colon: Int = spec.indexOf(":")
                if (colon > 0) {
                    declared = declared + this.strToInt(spec.substring(colon + 1))
                } else {
                    declared = declared + 8
                }
            }
            i = i + 1
        }
        var out: String = this.dataSection
        var have: Int = this.hexByteCount(out)
        var need: Int = declared - have
        if (need <= 0) { return out }
        // ⚠ 填充必须是**倍增**（`block = block + block`）：逐字节
        // `out = out + "00"` 是 O(need²)（每次整段拷贝），arena 达数十 KB 时
        // 完全不可接受；倍增的拷贝量为 2,4,8,…,need，总计 O(need)。
        // `block` 长度按 hex 字符计（每字节 2 个字符）。
        var block: String = "00"
        val needChars: Int = need * 2
        while (block.length < needChars) {
            block = block + block
        }
        if (block.length > needChars) {
            block = block.substring(0, needChars)
        }
        return out + block
    }

    /// 去掉 `dataSymbolName` 条目里的 `:size` 后缀，取纯符号名。
    private fun dataSymbolBaseName(spec: String): String {
        val colon: Int = spec.indexOf(":")
        if (colon > 0) {
            return spec.substring(0, colon)
        }
        return spec
    }

    /// 字符串常量列表转 hex。
    private fun stringConstsToHex(consts: String): String {
        if (consts == "") {
            return ""
        }
        val parts: List<String> = this.splitCommaQuoted(consts)
        this.objwProbe("s2h split ok parts=" + this.toStr(parts.size))
        // ⚠ 逐常量 `out = out + ...` 是 O(常量数²)：自举时字符串常量数
        // 上万、.rdata 达数百 KB，每次拼接都整段拷贝。改用列表累积。
        val outParts: List<String> = arrayListOf<String>()
        var i: Int = 0
        while (i < parts.size) {
            // `unquote`：.rdata 里放不带引号的载荷（与 `buildSymbols` 的偏移口径一致）
            val one: String = this.asciiToHex(this.unquote(parts[i]), -1) + "00"  // NUL 终止
            outParts.add(one)
            i = i + 1
            if (i % 50 == 0) {
                this.objwProbe("s2h i=" + this.toStr(i) + "/" + this.toStr(parts.size) +
                        " outParts=" + this.toStr(outParts.size) +
                        " lastHex=" + this.toStr(one.length))
            }
        }
        this.objwProbe("s2h loop done outParts=" + this.toStr(outParts.size))
        return this.coffJoinList(outParts)
    }

    /// ASCII 字符串转 hex（带 NUL 填充到指定长度）。
    ///
    /// ⚠️ 两处平方级问题（旧实现）：
    ///   1. `out = out + …` 逐字符拼接 —— 对长度 L 的串是 O(L²)；
    ///   2. `text[i]` 发射为 `String_charAt` 调用，**每次索引都新建一个
    ///      单字符字符串**（见 `chEq` 的说明）。
    /// 本方法对**每个字符串常量**各调一次（自举 `Main.aura` 有 57,232 个），
    /// 因此两处都必须修：现改为列表累积 + `charCodeAt` 直取码值。
    private fun asciiToHex(text: String, padLen: Int): String {
        val outParts: List<String> = arrayListOf<String>()
        val len: Int = text.length
        var i: Int = 0
        while (i < len) {
            outParts.add(this.byteHex(text.charCodeAt(i) as Int))
            i = i + 1
        }
        // 填充
        if (padLen > 0) {
            var need: Int = padLen * 2 - this.coffJoinList(outParts).length
            while (need > 0) {
                outParts.add("00")
                need = need - 2
            }
        }
        return this.coffJoinList(outParts)
    }

    /// 节名填充到 8 字节。
    private fun padSectionName(name: String, len: Int): String {
        val outParts: List<String> = arrayListOf<String>()
        var i: Int = 0
        while (i < len) {
            if (i < name.length) {
                outParts.add(this.byteHex(name.charCodeAt(i) as Int))
            } else {
                outParts.add("00")
            }
            i = i + 1
        }
        return this.coffJoinList(outParts)
    }

    /// 写小端整数到 hex 字符串。
    ///
    /// ⚠️ 必须**按字节取低位再拆分 nibble**，不能直接用 `v % 16` / `v / 256`：
    /// COFF 的节特征位里存在**超出 i32 范围**的常量（`.data` 的
    /// `0xC0400040 = CNT_INITIALIZED_DATA|MEM_READ|MEM_WRITE|ALIGN_4`），
    /// 而 Aura 的 `Int` 在 AOT 下是 i32 —— 字面量回绕成负数后，
    /// 负数的 `%` 取余得到负的 nibble，`hexDigit` 输出垃圾，于是 `.data` 的
    /// Characteristics 被写成 `0xFFFFFFF0`（含 `LNK_REMOVE` 位）⇒ lld-link 报
    ///   `relocation against symbol in discarded section: toStrBuffer/heapArena/...`
    /// 链接直接失败。VM 的 `Int` 更宽（字面量不回绕），因此该缺陷只在原生自举
    /// 路径暴露（实测：同一 runtime 目标文件仅此 4 字节不同）。
    ///
    /// `v & 255` 对 i32 二进制补码恒为非负，故对正负值都给出正确字节，且与原
    /// 实现（正值路径）逐字节一致。
    private fun writeIntLe(value: Int, bytes: Int): String {
        var out: String = ""
        var v: Int = value
        var i: Int = 0
        while (i < bytes) {
            out = out + this.byteHex(v & 255)
            v = v >> 8
            i = i + 1
        }
        return out
    }

    /// 按 `;;` 分割（用于符号条目）。
    private fun splitDoubleSemi(text: String): List<String> {
        val result: List<String> = arrayListOf<String>()
        if (text == "") {
            return result
        }
        var start: Int = 0
        var i: Int = 0
        var len: Int = text.length
        while (i < len - 1) {
            if (this.isDoubleSemi(text, i)) {
                result.add(this.sliceOf(text, start, i))
                start = i + 2
            }
            i = i + 1
        }
        if (start < len) {
            result.add(this.sliceOf(text, start, len))
        }
        return result
    }

    /// 按 `;` 分割（用于单个函数内的重定位条目）。
    private fun splitSemi(text: String): List<String> {
        val result: List<String> = arrayListOf<String>()
        if (text == "") {
            return result
        }
        var start: Int = 0
        var i: Int = 0
        var len: Int = text.length
        while (i < len) {
            if (this.chEq(text, i, ";")) {
                result.add(this.sliceOf(text, start, i))
                start = i + 1
            }
            i = i + 1
        }
        if (start < len) {
            result.add(this.sliceOf(text, start, len))
        }
        return result
    }

    /// 按管道符分割。
    private fun splitPipe(text: String): List<String> {
        val result: List<String> = arrayListOf<String>()
        if (text == "") {
            return result
        }
        var start: Int = 0
        var i: Int = 0
        var len: Int = text.length
        while (i < len) {
            if (this.chEq(text, i, "|")) {
                result.add(this.sliceOf(text, start, i))
                start = i + 1
            }
            i = i + 1
        }
        if (start < len) {
            result.add(this.sliceOf(text, start, len))
        }
        return result
    }

    /// 按逗号分割。
    private fun splitPipe2(text: String): List<String> {
        val result: List<String> = arrayListOf<String>()
        if (text == "") {
            return result
        }
        var start: Int = 0
        var i: Int = 0
        var len: Int = text.length
        while (i < len) {
            if (this.chEq(text, i, ",")) {
                result.add(this.sliceOf(text, start, i))
                start = i + 1
            }
            i = i + 1
        }
        if (start < len) {
            result.add(this.sliceOf(text, start, len))
        }
        return result
    }

    /// 字符串转整数。
    ///
    /// 用 `charCodeAt` 直取码值：**不能**用 `text[i]` —— 它发射为
    /// `String_charAt` 调用，每次索引都新建一个单字符字符串（见 `chEq` 说明）。
    private fun strToInt(text: String): Int {
        val len: Int = text.length
        if (len == 0) { return 0 }
        var total: Int = 0
        var neg: Boolean = false
        var i: Int = 0
        if ((text.charCodeAt(0) as Int) == 45) { neg = true; i = 1 }
        while (i < len) {
            val d: Int = (text.charCodeAt(i) as Int) - 48
            if (d >= 0 && d <= 9) { total = total * 10 + d }
            i = i + 1
        }
        if (neg) { return -total }
        return total
    }

    /// 十六进制字符串转整数（同样用 `charCodeAt`，零分配）。
    private fun hexToInt(text: String): Int {
        val len: Int = text.length
        if (len == 0) { return 0 }
        var total: Int = 0
        var i: Int = 0
        while (i < len) {
            total = total * 16 + this.hexValOfCode(text.charCodeAt(i) as Int)
            i = i + 1
        }
        return total
    }

    /// 十六进制数字码值 → 数值（无效返回 0）。
    private fun hexValOfCode(code: Int): Int {
        if (code >= 48 && code <= 57) { return code - 48 }
        if (code >= 97 && code <= 102) { return code - 97 + 10 }  // 'a'..'f'
        if (code >= 65 && code <= 70) { return code - 65 + 10 }   // 'A'..'F'
        return 0
    }

    /// 整数转十六进制数字字符。
    private fun hexDigit(d: Int): String {
        if (d == 0) return "0"
        if (d == 1) return "1"
        if (d == 2) return "2"
        if (d == 3) return "3"
        if (d == 4) return "4"
        if (d == 5) return "5"
        if (d == 6) return "6"
        if (d == 7) return "7"
        if (d == 8) return "8"
        if (d == 9) return "9"
        if (d == 10) return "a"
        if (d == 11) return "b"
        if (d == 12) return "c"
        if (d == 13) return "d"
        if (d == 14) return "e"
        return "f"
    }

    /// 整数转十进制字符串。
    ///
    /// 原实现写成 `result = toStr(n % 10) + result`：当 n 为个位数时
    /// `n % 10 == n`，于是 `toStr(n)` 调用自身 → 无限递归
    /// （VM 报 `call stack overflow (max depth 4096)`）。
    /// 此前只在 `toStr(0)` 处被调用（恰好直接返回 "0"）而侥幸未暴露。
    private fun toStr(n: Int): String {
        if (n == 0) { return "0" }
        var value: Int = n
        var neg: Boolean = false
        if (value < 0) { neg = true; value = -value }
        var result: String = ""
        while (value > 0) {
            result = this.hexDigit(value % 10) + result
            value = value / 10
        }
        if (neg) { result = "-" + result }
        return result
    }

    /// 按逗号切分，**不切分双引号内的逗号**（字符串常量表专用）。
    ///
    /// 字符串常量表以逗号分隔，而**值本身可以含逗号**（`"Hello, World!"`）。
    /// 用 `splitComma` 会把它切成 `"Hello` 与 ` World!"` 两条：.rdata 里同一句
    /// 被拆成两段、`@str.N` 偏移全部错位，最终 `println` 打印出被截断的内容。
    /// 单次扫描跟踪引号状态；`\` 后一个字符整体跳过（转义引号不改变状态）。
    private fun splitCommaQuoted(text: String): List<String> {
        val result: List<String> = arrayListOf<String>()
        if (text == "") {
            return result
        }
        var start: Int = 0
        var i: Int = 0
        var inStr: Boolean = false
        val len: Int = text.length
        while (i < len) {
            val c: Int = text.charCodeAt(i)
            if (c == 92) {
                i = i + 2
            } else {
                if (c == 34) {
                    inStr = !inStr
                    i = i + 1
                } else {
                    if (c == 44 && !inStr) {
                        result.add(this.sliceOf(text, start, i))
                        start = i + 1
                    }
                    i = i + 1
                }
            }
        }
        if (start < len) {
            result.add(this.sliceOf(text, start, len))
        }
        return result
    }

    /// 去掉字符串常量外层的一对双引号（没有引号则原样返回）。
    ///
    /// `.phir` 里的字面量带引号（`HirLit` 的 text 就是带引号的原文），而
    /// .rdata 里要放**不带引号**的字节（`println` 直接写这些字节）。
    /// 对不含引号的入参（如 `PhotonRuntime.buildMainObject(text)` 直接传裸文本）
    /// 保持原样，避免破坏既有调用方。
    private fun unquote(text: String): String {
        val len: Int = text.length
        if (len >= 2 && text.charCodeAt(0) == 34 && text.charCodeAt(len - 1) == 34) {
            return this.sliceOf(text, 1, len - 1)
        }
        return text
    }

    /// 按逗号分割字符串。
    private fun splitComma(text: String): List<String> {
        val result: List<String> = arrayListOf<String>()
        if (text == "") {
            return result
        }
        var start: Int = 0
        var i: Int = 0
        var len: Int = text.length
        while (i < len) {
            if (this.chEq(text, i, ",")) {
                result.add(this.sliceOf(text, start, i))
                start = i + 1
            }
            i = i + 1
        }
        if (start < len) {
            result.add(this.sliceOf(text, start, len))
        }
        return result
    }

    // ── 目标文件落盘 ──

    /// 把当前目标文件写成 **hex 文本**（VM 路径的落盘通道）。
    ///
    /// 建议路径形如 `build/hello.obj.hex`，随后由构建脚本把 hex 转成二进制 `.obj`。
    /// 返回文件是否确实落盘（`FileSystem.writeText` 自身不返回状态）。
    ///
    /// **为什么不在这里直接写二进制**：VM 执行路径没有可用的原始字节写盘原语 ——
    /// `FileSystem.writeBytes` 依赖 `Array<Byte>` + `String.fromCharCode`（LLVM IR 链路，
    /// 本项目不使用）；`Memory.write` / `Allocator` / `FileOps` 属 `extern interface`
    /// builtin，只有在 AOT / 自举运行时才存在。原生落盘见 `PhotonNativeWriter`。
    fun writeObjectHexFile(path: String): Boolean {
        FileSystem.writeText(path, this.emit())
        return FileSystem.exists(path)
    }

    /// 把当前目标文件写成 **二进制**（通过 hex 中转）。
    ///
    /// 先用 `writeObjectHexFile` 写 hex 临时文件，再通过 PowerShell 脚本转二进制。
    /// 注意：PowerShell 脚本需要 `$` 变量，而 Aura 字符串中 `$` 是插值符号，
    /// 因此此方法在 VM 路径下暂不可用，需由外部构建脚本完成 hex→binary 转换。
    fun writeObjectBinaryFile(path: String): Boolean {
        val hexPath: String = path + ".hex"
        this.writeObjectHexFile(hexPath)
        // PowerShell 脚本需 $ 变量，Aura 字符串无法直接表示，
        // 因此仅写 hex 文件，由外部脚本完成 hex→binary 转换。
        return FileSystem.exists(hexPath)
    }

    /// 由目标文件路径推导 hex 文本路径：`build/hello.obj` → `build/hello.obj.hex`。
    fun hexPathFor(objectPath: String): String {
        return objectPath + ".hex"
    }

    // ── ELF 目标文件生成 ──

    private fun buildElfFile(): String {
        // ── 1. 规整节内容 ──
        this.textSection = this.normalizeHex(this.textSection)
        this.textSize = this.hexByteCount(this.textSection)
        this.rdataSection = this.stringConstsToHex(this.stringConsts)
        this.rdataSize = this.hexByteCount(this.rdataSection)

        // ── 2. 计数 ──
        val symRecs: List<String> = this.splitDoubleSemi(this.symbols)
        val symCount: Int = symRecs.size
        val relocRecs: List<String> = this.composeRelocations()
        val relocCount: Int = relocRecs.size

        // ── 3. 构建符号名字符串表（strtab）──
        var strTabSize: Int = 1
        var strTabHex: String = ""
        val symNameOffsets: List<Int> = arrayListOf<Int>()
        symNameOffsets.add(0)
        var s: Int = 0
        while (s < symCount) {
            val nm: String = this.symbolName(symRecs[s])
            symNameOffsets.add(strTabSize)
            strTabHex = strTabHex + this.asciiToHex(nm, -1) + "00"
            strTabSize = strTabSize + nm.length + 1
            s = s + 1
        }

        // ── 4. 布局偏移 ──
        val headerSize: Int = 64
        val sectionHeaderSize: Int = 64

        var numSections: Int = 5
        if (this.rdataSize > 0) { numSections = numSections + 1 }
        if (relocCount > 0) { numSections = numSections + 1 }

        val sectionTableEnd: Int = headerSize + sectionHeaderSize * numSections

        val textOff: Int = this.alignUp(sectionTableEnd, 16)
        val textEnd: Int = textOff + this.textSize

        var rdataOff: Int = textEnd
        var rdataEnd: Int = textEnd
        if (this.rdataSize > 0) {
            rdataOff = this.alignUp(textEnd, 4)
            rdataEnd = rdataOff + this.rdataSize
        }

        var relocOff: Int = rdataEnd
        var relocEnd: Int = rdataEnd
        if (relocCount > 0) {
            relocOff = this.alignUp(rdataEnd, 8)
            relocEnd = relocOff + 24 * relocCount
        }

        val symTabOff: Int = this.alignUp(relocEnd, 8)
        val symTabEnd: Int = symTabOff + 24 * (symCount + 1)

        val strTabOff: Int = this.alignUp(symTabEnd, 1)
        val strTabEnd: Int = strTabOff + strTabSize

        val shStrTabOff: Int = this.alignUp(strTabEnd, 1)

        // ── 5. 构建节名字符串表（shstrtab）──
        var shStrTabSize: Int = 1
        var shTextNameOff: Int = shStrTabSize
        shStrTabSize = shStrTabSize + 5 + 1

        var shRdataNameOff: Int = 0
        if (this.rdataSize > 0) {
            shRdataNameOff = shStrTabSize
            shStrTabSize = shStrTabSize + 7 + 1
        }

        var shRelNameOff: Int = 0
        if (relocCount > 0) {
            shRelNameOff = shStrTabSize
            shStrTabSize = shStrTabSize + 9 + 1
        }

        var shSymNameOff: Int = shStrTabSize
        shStrTabSize = shStrTabSize + 7 + 1

        var shStrNameOff: Int = shStrTabSize
        shStrTabSize = shStrTabSize + 7 + 1

        var shShStrNameOff: Int = shStrTabSize
        shStrTabSize = shStrTabSize + 9 + 1

        // ── 6. 节索引 ──
        var secRdata: Int = -1
        var secRel: Int = -1
        var secSym: Int = 2
        var secStr: Int = 3
        var secShStr: Int = 4

        if (this.rdataSize > 0) {
            secRdata = 2
            secSym = 3
            secStr = 4
            secShStr = 5
        }
        if (relocCount > 0) {
            secRel = secSym
            secSym = secSym + 1
            secStr = secStr + 1
            secShStr = secShStr + 1
        }

        this.textOffset = textOff
        this.rdataOffset = rdataOff

        // ── 7. 写 ELF Header (64 字节) ──
        var buf: String = ""
        buf = buf + "7f" + "45" + "4c" + "46"
        buf = buf + "02"
        buf = buf + "01"
        buf = buf + "01"
        buf = buf + "00"
        buf = buf + "0000000000000000"
        buf = buf + this.writeIntLe(1, 2)
        buf = buf + this.writeIntLe(62, 2)
        buf = buf + this.writeIntLe(1, 4)
        buf = buf + this.writeIntLe(0, 8)
        buf = buf + this.writeIntLe(0, 8)
        buf = buf + this.writeIntLe(sectionTableEnd, 8)
        buf = buf + this.writeIntLe(0, 4)
        buf = buf + this.writeIntLe(64, 2)
        buf = buf + this.writeIntLe(0, 2)
        buf = buf + this.writeIntLe(0, 2)
        buf = buf + this.writeIntLe(64, 2)
        buf = buf + this.writeIntLe(numSections, 2)
        buf = buf + this.writeIntLe(secShStr, 2)

        // ── 8. 写 Section Headers ──
        buf = buf + this.writeIntLe(0, 4)
        buf = buf + this.writeIntLe(0, 4)
        buf = buf + this.writeIntLe(0, 8)
        buf = buf + this.writeIntLe(0, 8)
        buf = buf + this.writeIntLe(0, 8)
        buf = buf + this.writeIntLe(0, 4)
        buf = buf + this.writeIntLe(0, 4)
        buf = buf + this.writeIntLe(0, 8)
        buf = buf + this.writeIntLe(0, 8)

        buf = buf + this.writeIntLe(shTextNameOff, 4)
        buf = buf + this.writeIntLe(1, 4)
        buf = buf + this.writeIntLe(6, 8)
        buf = buf + this.writeIntLe(0, 8)
        buf = buf + this.writeIntLe(textOff, 8)
        buf = buf + this.writeIntLe(this.textSize, 8)
        buf = buf + this.writeIntLe(0, 4)
        buf = buf + this.writeIntLe(0, 4)
        buf = buf + this.writeIntLe(16, 8)
        buf = buf + this.writeIntLe(0, 8)

        if (this.rdataSize > 0) {
            buf = buf + this.writeIntLe(shRdataNameOff, 4)
            buf = buf + this.writeIntLe(1, 4)
            buf = buf + this.writeIntLe(2, 8)
            buf = buf + this.writeIntLe(0, 8)
            buf = buf + this.writeIntLe(rdataOff, 8)
            buf = buf + this.writeIntLe(this.rdataSize, 8)
            buf = buf + this.writeIntLe(0, 4)
            buf = buf + this.writeIntLe(0, 4)
            buf = buf + this.writeIntLe(4, 8)
            buf = buf + this.writeIntLe(0, 8)
        }

        if (relocCount > 0) {
            buf = buf + this.writeIntLe(shRelNameOff, 4)
            buf = buf + this.writeIntLe(9, 4)
            buf = buf + this.writeIntLe(0, 8)
            buf = buf + this.writeIntLe(0, 8)
            buf = buf + this.writeIntLe(relocOff, 8)
            buf = buf + this.writeIntLe(24 * relocCount, 8)
            buf = buf + this.writeIntLe(1, 4)
            buf = buf + this.writeIntLe(secSym, 4)
            buf = buf + this.writeIntLe(8, 8)
            buf = buf + this.writeIntLe(24, 8)
        }

        buf = buf + this.writeIntLe(shSymNameOff, 4)
        buf = buf + this.writeIntLe(2, 4)
        buf = buf + this.writeIntLe(0, 8)
        buf = buf + this.writeIntLe(0, 8)
        buf = buf + this.writeIntLe(symTabOff, 8)
        buf = buf + this.writeIntLe(24 * (symCount + 1), 8)
        buf = buf + this.writeIntLe(secStr, 4)
        buf = buf + this.writeIntLe(1, 4)
        buf = buf + this.writeIntLe(8, 8)
        buf = buf + this.writeIntLe(24, 8)

        buf = buf + this.writeIntLe(shStrNameOff, 4)
        buf = buf + this.writeIntLe(3, 4)
        buf = buf + this.writeIntLe(0, 8)
        buf = buf + this.writeIntLe(0, 8)
        buf = buf + this.writeIntLe(strTabOff, 8)
        buf = buf + this.writeIntLe(strTabSize, 8)
        buf = buf + this.writeIntLe(0, 4)
        buf = buf + this.writeIntLe(0, 4)
        buf = buf + this.writeIntLe(1, 8)
        buf = buf + this.writeIntLe(0, 8)

        buf = buf + this.writeIntLe(shShStrNameOff, 4)
        buf = buf + this.writeIntLe(3, 4)
        buf = buf + this.writeIntLe(0, 8)
        buf = buf + this.writeIntLe(0, 8)
        buf = buf + this.writeIntLe(shStrTabOff, 8)
        buf = buf + this.writeIntLe(shStrTabSize, 8)
        buf = buf + this.writeIntLe(0, 4)
        buf = buf + this.writeIntLe(0, 4)
        buf = buf + this.writeIntLe(1, 8)
        buf = buf + this.writeIntLe(0, 8)

        // ── 9. 写 .text 节数据 ──
        buf = buf + this.padToBytesAt(buf, textOff)
        buf = buf + this.textSection

        // ── 10. 写 .rodata 节数据 ──
        if (this.rdataSize > 0) {
            buf = buf + this.padToBytesAt(buf, rdataOff)
            buf = buf + this.rdataSection
        }

        // ── 11. 写 .rel.text 重定位表 ──
        if (relocCount > 0) {
            buf = buf + this.padToBytesAt(buf, relocOff)
            var r: Int = 0
            while (r < relocCount) {
                val rf: List<String> = this.splitPipe(relocRecs[r])
                buf = buf + this.writeIntLe(this.strToInt(rf[0]), 8)
                val symIdx: Int = this.strToInt(rf[1]) + 1
                val coffType: Int = this.strToInt(rf[2])
                val elfType: Int = this.elfRelocType(coffType)
                buf = buf + this.writeIntLe(elfType, 4)
                buf = buf + this.writeIntLe(symIdx, 4)
                r = r + 1
            }
        }

        // ── 12. 写 .symtab 符号表 ──
        buf = buf + this.padToBytesAt(buf, symTabOff)
        buf = buf + this.writeIntLe(0, 4)
        buf = buf + this.writeIntLe(0, 1)
        buf = buf + this.writeIntLe(0, 1)
        buf = buf + this.writeIntLe(0, 2)
        buf = buf + this.writeIntLe(0, 8)
        buf = buf + this.writeIntLe(0, 8)

        var i: Int = 0
        while (i < symCount) {
            val f: List<String> = this.splitPipe(symRecs[i])
            buf = buf + this.writeIntLe(symNameOffsets[i + 1], 4)
            val coffType2: Int = this.hexToInt(f[3])
            var elfType2: Int = 1
            if (coffType2 == 0x0020) { elfType2 = 2 }
            val storage: Int = this.strToInt(f[4])
            var binding: Int = 0
            if (storage == 2) { binding = 1 }
            buf = buf + this.writeIntLe(elfType2 * 16 + binding, 1)
            buf = buf + this.writeIntLe(0, 1)
            val coffSection: Int = this.strToInt(f[2])
            var elfShndx: Int = 0
            if (coffSection == 1) { elfShndx = 1 }
            else if (coffSection == 2 && this.rdataSize > 0) { elfShndx = secRdata }
            buf = buf + this.writeIntLe(elfShndx, 2)
            buf = buf + this.writeIntLe(this.strToInt(f[1]), 8)
            buf = buf + this.writeIntLe(0, 8)
            i = i + 1
        }

        // ── 13. 写 .strtab 符号名字符串表 ──
        buf = buf + this.padToBytesAt(buf, strTabOff)
        buf = buf + "00"
        buf = buf + strTabHex

        // ── 14. 写 .shstrtab 节名字符串表 ──
        buf = buf + this.padToBytesAt(buf, shStrTabOff)
        buf = buf + "00"
        buf = buf + this.asciiToHex(".text", -1) + "00"
        if (this.rdataSize > 0) {
            buf = buf + this.asciiToHex(".rodata", -1) + "00"
        }
        if (relocCount > 0) {
            buf = buf + this.asciiToHex(".rel.text", -1) + "00"
        }
        buf = buf + this.asciiToHex(".symtab", -1) + "00"
        buf = buf + this.asciiToHex(".strtab", -1) + "00"
        buf = buf + this.asciiToHex(".shstrtab", -1) + "00"

        return buf
    }

    /// COFF 重定位类型 → ELF 重定位类型。
    ///
    /// IMAGE_REL_AMD64_REL32 (4) → R_X86_64_PLT32 (20)
    /// IMAGE_REL_AMD64_ADDR64 (1) → R_X86_64_64 (1)
    private fun elfRelocType(coffType: Int): Int {
        if (coffType == 4) { return 20 }
        if (coffType == 1) { return 1 }
        return 0
    }
}

// ─────────────────────────────────────────────────────────────
// PhotonObjectWriterUtils — 工具对象
// ─────────────────────────────────────────────────────────────

object PhotonObjectWriterUtils {

    /// COFF 常量。
    val COFF_MACHINE_AMD64: Int = 0x8664
    val COFF_CHAR_EXECUTABLE: Int = 0x0102
    val SECTION_CODE: Int = 0x20
    val SECTION_MEM_READ: Int = 0x40000000
    val SECTION_MEM_EXECUTE: Int = 0x20000000
    val SECTION_MEM_WRITE: Int = 0x80000000
    val SECTION_ALIGN_16: Int = 0x0010
    val REL32: Int = 0x04

    /// ELF 常量。
    val ELF_MAGIC: Int = 0x7F454C46
    val ELF_CLASS64: Int = 2
    val ELF_DATA_LE: Int = 1
    val ELF_TYPE_REL: Int = 1
    val ELF_MACHINE_X86_64: Int = 62
    val ELF_VERSION: Int = 1

    /// 创建空的 AOT 后端。
    fun emptyBackend(): PhotonObjectWriter {
        return PhotonObjectWriter()
    }

    /// 创建 helloworld 的机器码。
    ///
    /// ⚠️ 这里的 `call println` 指向一个**尚未实现**的 runtime 符号，
    /// 因此产出的 .obj 无法链接成 exe（lld-link 会报 undefined symbol: println）。
    /// 用于验证「编码 + COFF 组装」链路；需要真正可运行的产物请用
    /// `buildHelloWorldObject()`。
    fun helloworldMachineCode(): String {
        val enc = X86EncoderUtils.emptyEncoder()
        enc.emitPrologue(48)
        enc.emitLeaRIP("rcx", "@str.0")
        enc.emitCallRel("println")
        enc.emitXorRR("eax", "eax")
        enc.emitEpilogue()
        return enc.toHex()
    }

    /// 获取 helloworld 的重定位项。
    fun helloworldRelocs(): String {
        val enc = X86EncoderUtils.emptyEncoder()
        enc.emitPrologue(48)
        enc.emitLeaRIP("rcx", "@str.0")
        enc.emitCallRel("println")
        enc.emitXorRR("eax", "eax")
        enc.emitEpilogue()
        return PhotonObjectWriterUtils.joinRelocRecords(enc.getRelocations())
    }

    // ── 可运行的 helloworld（Phase E3 冒烟目标）──

    /// 把 `X86Encoder` 的重定位记录拼成 `;;` 分隔的字符串。
    fun joinRelocRecords(relocs: List<String>): String {
        var out: String = ""
        var i: Int = 0
        while (i < relocs.size) {
            if (i > 0) { out = out + ";" }
            out = out + relocs[i]
            i = i + 1
        }
        return out
    }

    /// 把 COFF hex 文本写入文件（**VM 路径**的落盘通道）。
    ///
    /// 走 `FileSystem.writeText` → 预编译 stdlib 的 `Stdio.writeFile`，在种子编译器下可解析。
    /// 返回文件是否确实落盘；随后由构建脚本把 `.hex` 转成二进制 `.obj`。
    ///
    /// 与 `PhotonObjectWriter.writeObjectHexFile()` 的分工：
    /// 本方法面向"手上已有 hex 字符串"的调用方（例如 `PhotonRuntime.buildMainObject()`）；
    /// 后者面向"已配置好的 writer 实例"，由 writer 重新序列化后写文件。
    fun saveHexFile(path: String, coffHex: String): Boolean {
        FileSystem.writeText(path, coffHex)
        return FileSystem.exists(path)
    }

    /// 生成「可直接链接运行」的 helloworld `main`。
    ///
    /// 与 `helloworldMachineCode()` 的差别：不依赖任何 runtime 符号，
    /// 直接通过导入表调用 kernel32（Windows x64 调用约定）：
    ///
    /// ```asm
    /// main:
    ///   push rbp
    ///   mov  rbp, rsp
    ///   sub  rsp, 0x30            ; 32 字节影子空间 + 16 字节栈对齐
    ///   mov  ecx, -11             ; STD_OUTPUT_HANDLE
    ///   call [rip + __imp_GetStdHandle]
    ///   mov  rcx, rax             ; hStdOut
    ///   lea  rdx, [rip + @str.0]  ; lpBuffer
    ///   mov  r8d, <len>           ; nNumberOfBytesToWrite
    ///   xor  r9, r9               ; lpNumberOfBytesWritten = NULL
    ///   mov  [rbp - 0x10], r9     ; lpOverlapped = NULL（第 5 参数在 [rsp+0x20]）
    ///   call [rip + __imp_WriteFile]
    ///   xor  rcx, rcx             ; exit code = 0
    ///   call [rip + __imp_ExitProcess]
    ///   ret                       ; 不可达，仅为函数完整性
    /// ```
    ///
    /// 栈偏移推导：`push rbp` 后 rbp ≡ 0 (mod 16)，`sub rsp,0x30` 后
    /// rsp = rbp-0x30 且 ≡ 0 (mod 16)（满足 call 前对齐要求）；
    /// 影子空间起点为 rsp，第 5 参数槽 = rsp+0x20 = rbp-0x10。
    fun emitHelloWorldMain(enc: X86Encoder, text: String): Unit {
        enc.emitPrologue(0x30)
        enc.emitMovRI32("rcx", -11)              // GetStdHandle(STD_OUTPUT_HANDLE)
        enc.emitCallImport("GetStdHandle")
        enc.emitMovRR("rcx", "rax")              // hFile = hStdOut
        enc.emitLeaRIP("rdx", "@str.0")          // lpBuffer
        enc.emitMovRI32("r8", text.length)       // nNumberOfBytesToWrite
        enc.emitXorRR("r9", "r9")                // lpNumberOfBytesWritten = NULL
        enc.emitStackStore(-0x10, "r9")          // lpOverlapped = NULL
        enc.emitCallImport("WriteFile")
        enc.emitXorRR("rcx", "rcx")              // ExitProcess(0)
        enc.emitCallImport("ExitProcess")
        enc.emitRet()
    }

    /// 生成可运行的 helloworld 目标文件（返回 COFF hex）。
    ///
    /// 产出可直接交给 lld-link 链接：
    ///
    /// ```
    /// lld-link /SUBSYSTEM:CONSOLE /ENTRY:main /MACHINE:X64 /NODEFAULTLIB \
    ///          /OUT:hello.exe hello.obj kernel32.lib
    /// ```
    fun buildHelloWorldObject(text: String): String {
        val enc = X86EncoderUtils.emptyEncoder()
        PhotonObjectWriterUtils.emitHelloWorldMain(enc, text)

        val writer = PhotonObjectWriter()
        return writer.emitFromMachineCode(
            enc.toHex(),
            PhotonObjectWriterUtils.joinRelocRecords(enc.getRelocations()),
            text,
            "main"
        )
    }

    /// S2 多函数单 obj 测试/驱动辅助：把首函数用 `emitFromMachineCode`，后续函数用
    /// `appendFunction` 追加，返回最终 COFF hex。
    fun buildMultiFunctionObject(
        firstMachineCodeHex: String,
        firstRelocEntries: String,
        stringConsts: String,
        firstFunctionName: String,
        restFunctions: List<String>,
        restMachineCodes: List<String>,
        restRelocEntries: List<String>
    ): String {
        val writer = PhotonObjectWriter()
        writer.emitFromMachineCode(
            firstMachineCodeHex,
            firstRelocEntries,
            stringConsts,
            firstFunctionName
        )

        var i = 1
        while (i < restFunctions.size) {
            val relocs = ""
            if (i - 1 < restRelocEntries.size) {
                relocs = restRelocEntries[i - 1]
            }
            writer.appendFunction(
                restMachineCodes[i - 1],
                restFunctions[i],
                relocs
            )
            i = i + 1
        }

        return writer.emit()
    }
}
