// Test splitPipe with charCodeAt fix
package aura.lang.compiler.backend.photon
import aura.lang.std.String

fun main() {
    val text: String = "main|0|1|0x0001|0x01|@str.0|0|2|0x0001|0x02"
    println("Input: " + text)
    println("Length: " + text.length)
    
    var start: Int = 0
    var i: Int = 0
    var len: Int = text.length
    var count: Int = 0
    while (i < len) {
        val c: Int = text.substring(i, i + 1).charCodeAt(0)
        if (c == 124) {  // '|'
            println("Pipe at " + i + ", part: " + text.substring(start, i - start))
            start = i + 1
            count = count + 1
        }
        i = i + 1
    }
    println("Total pipes: " + count)
    println("Last part: " + text.substring(start, len - start))
}
