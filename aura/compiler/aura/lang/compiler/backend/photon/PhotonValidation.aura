// aura:///aura/lang/compiler/backend/PhaseEValidation.aura
package aura.lang.compiler.backend.photon
// ─────────────────────────────────────────────────────────────
// Phase E 验证 — 仅使用已修复的组件
//
// 验证内容：
//   1. X86Encoder: 指令编码
//   2. AotBackend: COFF 目标文件生成
//   3. COFF 文件结构验证
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String
import "x86_64/X86Encoder.aura"
import "PhotonObjectWriter.aura"

/// 手动字符串分割辅助函数。
fun splitStr(text: String, sep: String): List<String> {
    val result: List<String> = arrayListOf<String>()
    if (text == "") {
        return result
    }
    var start: Int = 0
    var i: Int = 0
    var len: Int = text.length
    while (i < len) {
        if (sep.length == 1 && text.charCodeAt(i) == sep.charCodeAt(0)) {
            result.add(text.substring(start, i - start))
            start = i + 1
        }
        i = i + 1
    }
    if (start < len) {
        result.add(text.substring(start, len - start))
    }
    return result
}

/// 整数转字符串。
fun toStr2(n: Int): String {
    if (n == 0) { return "0" }
    var neg: Boolean = false
    if (n < 0) { neg = true; n = -n }
    var result: String = ""
    while (n > 0) {
        result = toStr2(n % 10) + result
        n = n / 10
    }
    if (neg) { result = "-" + result }
    return result
}

/// 测试入口。
fun main() {
    println("╔══════════════════════════════════════════════════════╗")
    println("║   Phase E 验证 — AOT 管线组件测试                    ║")
    println("║   按照 参考go rust设计新的编译后端.md 第九章         ║")
    println("╚══════════════════════════════════════════════════════╝")
    println("")

    var failures: Int = 0
    var tests: Int = 0

    // ── 测试 1: X86Encoder helloworld 机器码 ──
    tests = tests + 1
    println("[Test 1] X86Encoder: helloworld 机器码生成")
    val encoder = X86EncoderUtils.emptyEncoder()
    encoder.emitPrologue(48)
    encoder.emitLeaRIP("rcx", "@str.0")
    encoder.emitCallRel("println")
    encoder.emitXorRR("eax", "eax")
    encoder.emitEpilogue()
    val mcHex = encoder.toHex()
    val mcRelocs = encoder.getRelocations()
    println("  机器码: " + mcHex)
    println("  字节数: " + encoder.byteCount())
    println("  重定位数: " + mcRelocs.size)
    if (mcHex != "" && mcRelocs.size == 2) {
        println("  ✓ PASS")
    } else {
        println("  ✗ FAIL")
        failures = failures + 1
    }

    // ── 测试 2: 机器码解码验证 ──
    tests = tests + 1
    println("")
    println("[Test 2] 机器码解码验证")
    println("  55                   = push rbp")
    println("  48 89 E5             = mov rbp, rsp")
    println("  48 81 EC 30 00 00 00 = sub rsp, 0x30")
    println("  48 8D 0D ?? ?? ?? ?? = lea rcx, [rip+disp32]  (reloc: @str.0)")
    println("  E8 ?? ?? ?? ??       = call rel32              (reloc: println)")
    println("  48 31 C0             = xor rax, rax")
    println("  C9                   = leave")
    println("  C3                   = ret")
    // 注意：`sub rsp, imm32` 是 REX.W 81 /5 id（7 字节）。
    // 早期实现误用 0x83（只接受 imm8）却写了 4 字节立即数，
    // 多出的 3 个 0 字节会被 CPU 当作后续指令执行。
    if (mcHex.startsWith("554889e54881ec30000000")) {
        println("  ✓ 机器码结构正确")
    } else {
        println("  ✗ 机器码结构不正确")
        failures = failures + 1
    }

    // ── 测试 3: PhotonObjectWriter COFF 生成 ──
    tests = tests + 1
    println("")
    println("[Test 3] AotBackend: COFF 目标文件生成")
    val aot = PhotonObjectWriterUtils.emptyBackend()
    // 构建重定位字符串
    var relocHex: String = ""
    var i: Int = 0
    while (i < mcRelocs.size) {
        if (relocHex != "") { relocHex = relocHex + "|" }
        relocHex = relocHex + mcRelocs[i]
        i = i + 1
    }
    println("  重定位项: " + relocHex)
    val coffHex = aot.emitFromMachineCode(mcHex, relocHex, "hello", "main")
    println("  COFF hex 长度: " + coffHex.length + " 字符")
    println("  COFF 字节数: " + (coffHex.length / 2))
    if (coffHex != "" && coffHex.length > 100) {
        println("  ✓ PASS")
    } else {
        println("  ✗ FAIL")
        failures = failures + 1
    }

    // ── 测试 4: COFF 文件头验证 ──
    tests = tests + 1
    println("")
    println("[Test 4] COFF 文件头验证")
    if (coffHex.length >= 4) {
        val headerStart = coffHex.substring(0, 4)
        println("  文件头前 2 字节 (Machine): " + headerStart)
        // AMD64 = 0x8664, 小端 = 64 86
        if (headerStart == "6486") {
            println("  ✓ Machine = AMD64 (0x8664)")
        } else {
            println("  ✗ Machine 值不正确")
            failures = failures + 1
        }
    } else {
        println("  ✗ COFF 太短")
        failures = failures + 1
    }

    // ── 测试 5: COFF 节表验证 ──
    tests = tests + 1
    println("")
    println("[Test 5] COFF 节表验证")
    // 节表从第 20 字节 (hex 40) 开始
    if (coffHex.length >= 56) {
        // .text 节名从第 20 字节开始，8 字节
        val textNameHex = coffHex.substring(40, 56)
        println("  .text 节名 (hex): " + textNameHex)
        // ".text" = 2E 74 65 78 74
        if (textNameHex.substring(0, 10) == "2e74657874") {
            println("  ✓ .text 节名正确")
        } else {
            println("  ✗ .text 节名不正确")
            failures = failures + 1
        }
    } else {
        println("  ✗ COFF 太短")
        failures = failures + 1
    }

    // ── 测试 6: .rdata 节验证 ──
    tests = tests + 1
    println("")
    println("[Test 6] .rdata 节验证")
    // 搜索 .rdata 节名 (hex: 2e7264617461)
    var foundRdata: Boolean = false
    var k: Int = 0
    while (k < coffHex.length - 12) {
        if (coffHex.substring(k, k + 12) == "2e7264617461") {
            foundRdata = true
            println("  .rdata 节名位置: hex offset " + k)
            break
        }
        k = k + 2
    }
    if (foundRdata) {
        println("  ✓ .rdata 节名正确")
    } else {
        println("  ✗ 未找到 .rdata 节名")
        failures = failures + 1
    }

    // ── 测试 7: COFF 重定位表验证 ──
    tests = tests + 1
    println("")
    println("[Test 7] COFF 重定位表验证")
    // 重定位类型应该是 0x04 (REL32)
    // 重定位表在节数据之后
    // 查找 REL32 类型 (hex: 0400)
    var foundReloc: Boolean = false
    var j: Int = 0
    while (j < coffHex.length - 2) {
        if (coffHex.substring(j, j + 4) == "0400") {
            foundReloc = true
            break
        }
        j = j + 2
    }
    println("  找到 REL32 重定位: " + foundReloc)
    if (foundReloc) {
        println("  ✓ PASS")
    } else {
        println("  ✗ 未找到 REL32 重定位")
        failures = failures + 1
    }

    // ── 测试 8: PhotonObjectWriterUtils 验证 ──
    tests = tests + 1
    println("")
    println("[Test 8] PhotonObjectWriterUtils: helloworld 机器码")
    val hwMc = PhotonObjectWriterUtils.helloworldMachineCode()
    println("  机器码: " + hwMc)
    if (hwMc != "" && hwMc.length > 10) {
        println("  ✓ PASS")
    } else {
        println("  ✗ FAIL")
        failures = failures + 1
    }

    // ── 测试 9: PhotonObjectWriterUtils 重定位 ──
    tests = tests + 1
    println("")
    println("[Test 9] PhotonObjectWriterUtils: helloworld 重定位项")
    val hwRelocs = PhotonObjectWriterUtils.helloworldRelocs()
    println("  重定位: " + hwRelocs)
    if (hwRelocs != "" && hwRelocs.contains("R_X86_64_REL32")) {
        println("  ✓ PASS")
    } else {
        println("  ✗ FAIL")
        failures = failures + 1
    }

    // ── 测试 10: COFF 常量验证 ──
    tests = tests + 1
    println("")
    println("[Test 10] COFF 常量验证")
    println("  COFF_MACHINE_AMD64 = " + PhotonObjectWriterUtils.COFF_MACHINE_AMD64 + " (0x" + toHexStr(PhotonObjectWriterUtils.COFF_MACHINE_AMD64) + ")")
    println("  SECTION_CODE = " + PhotonObjectWriterUtils.SECTION_CODE + " (0x" + toHexStr(PhotonObjectWriterUtils.SECTION_CODE) + ")")
    println("  SECTION_MEM_READ = 0x" + toHexStr(PhotonObjectWriterUtils.SECTION_MEM_READ))
    println("  SECTION_MEM_EXECUTE = 0x" + toHexStr(PhotonObjectWriterUtils.SECTION_MEM_EXECUTE))
    println("  REL32 = " + PhotonObjectWriterUtils.REL32 + " (0x" + toHexStr(PhotonObjectWriterUtils.REL32) + ")")
    if (PhotonObjectWriterUtils.COFF_MACHINE_AMD64 == 34404 &&
        PhotonObjectWriterUtils.SECTION_CODE == 32 &&
        PhotonObjectWriterUtils.REL32 == 4) {
        println("  ✓ PASS")
    } else {
        println("  ✗ FAIL")
        failures = failures + 1
    }

    // ── 汇总 ──
    println("")
    println("══════════════════════════════════════════════════════")
    println("测试结果: " + (tests - failures) + "/" + tests + " 通过")
    if (failures == 0) {
        println("RESULT: PASS — Phase E 组件验证全部通过")
        println("")
        println("Phase E 组件清单:")
        println("  ✓ X86Encoder — x86_64 指令编码器 (28 字节机器码)")
        println("  ✓ AotBackend — COFF 目标文件生成 (含 .text/.rdata 节)")
        println("  ✓ COFF 文件结构 — 文件头/节表/字符串表/重定位表/符号表")
        println("  ✓ 重定位项 — REL32 类型正确")
        println("  ✓ 常量定义 — COFF/ELF 常量完整")
    } else {
        println("RESULT: FAIL (" + failures + " 失败)")
    }
    println("══════════════════════════════════════════════════════")
}

/// 整数转十六进制字符串。
fun toHexStr(n: Int): String {
    val digits: String = "0123456789abcdef"
    if (n == 0) { return "0" }
    var result: String = ""
    var neg: Boolean = false
    if (n < 0) { neg = true; n = -n }
    while (n > 0) {
        result = digits.substring(n % 16, n % 16 + 1) + result
        n = n / 16
    }
    if (neg) { result = "-" + result }
    return result
}
