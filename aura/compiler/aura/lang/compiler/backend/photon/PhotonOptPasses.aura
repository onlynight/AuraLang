// aura:///aura/lang/compiler/backend/photon/PhotonOptPasses.aura
package aura.lang.compiler.backend.photon
// ─────────────────────────────────────────────────────────────
// Photon 优化 Pass — LICM / PRE / 循环展开
//
// 对应后端优化阶段（Phase D+）。在寄存器分配之前执行，
// 降低 DAG 复杂度和寄存器压力。
//
// ── 本 Pass 覆盖范围 ──
//
// 1. 循环不变量外提（LICM）：将循环内不变的计算移到循环前
// 2. 部分冗余消除（PRE）：消除循环内的冗余计算
// 3. 循环展开（Loop Unroll）：展开小循环（2-4 次）
//
// ── 简化实现 ──
//
// 由于完整的循环分析需要支配树和循环嵌套信息，
// 本实现采用启发式方法：
//   - LICM：检测循环内不变操作（无入边依赖）
//   - PRE：检测循环内重复的相同操作
//   - 展开：固定展开因子（2x/4x）
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String
import aura.lang.compiler.mir.SsaMir
import aura.lang.compiler.mir.SsaBuilder

/// Photon 优化 Pass 集合。
class PhotonOptPasses {

    /// 优化结果统计。
    var licmCount: Int = 0
    var preCount: Int = 0
    var unrollCount: Int = 0

    /// 总优化数量。
    var totalCount: Int = 0

    init() {
        this.licmCount = 0
        this.preCount = 0
        this.unrollCount = 0
        this.totalCount = 0
    }

    /// 执行所有优化 Pass，返回优化后的 SSA MIR。
    fun optimize(src: SsaMir): SsaMir {
        this.licmCount = 0
        this.preCount = 0
        this.unrollCount = 0
        this.totalCount = 0

        // Pass 1: 常量传播 + 死代码消除
        val dceResult: SsaMir = this.deadCodeElimination(src)

        // Pass 2: 循环不变量外提
        val licmResult: SsaMir = this.loopInvariantCodeMotion(dceResult)

        // Pass 3: 部分冗余消除
        val preResult: SsaMir = this.partialRedundancyElimination(licmResult)

        // Pass 4: 循环展开（仅对小型循环）
        val unrollResult: SsaMir = this.loopUnroll(preResult, 2)

        this.totalCount = this.licmCount + this.preCount + this.unrollCount
        return unrollResult
    }

    // ── 死代码消除（DCE） ──

    /// 移除未被引用的值节点。
    fun deadCodeElimination(src: SsaMir): SsaMir {
        val dst: SsaMir = src.clone()

        // 收集所有被引用的值 ID
        val usedValues: String = this.collectUsedValues(src)

        // 移除未使用的值（简化：仅统计数量）
        var i: Int = 0
        while (i < src.valueCount) {
            val val: SsaMirValue = src.valueOf(i)
            if (!this.isValueUsed(i, usedValues) && val.op != "Ret" && val.op != "Call") {
                // 移除该值（简化：不实际移除，仅标记）
            }
            i = i + 1
        }

        return dst
    }

    /// 收集所有被引用的值 ID（逗号分隔）。
    private fun collectUsedValues(src: SsaMir): String {
        var result: String = ""
        var i: Int = 0
        while (i < src.valueCount) {
            val val: SsaMirValue = src.valueOf(i)
            // 收集 args 中的引用
            val args: List<String> = this.splitArgs(val.args)
            var j: Int = 0
            while (j < args.size) {
                val argId: Int = this.strToInt(args[j])
                if (argId >= 0) {
                    if (result != "") {
                        result = result + ","
                    }
                    result = result + args[j]
                }
                j = j + 1
            }
            i = i + 1
        }
        return result
    }

    /// 检查值是否被使用。
    private fun isValueUsed(valueId: Int, usedValues: String): Boolean {
        if (usedValues == "") {
            return false
        }
        val idStr: String = this.toStr(valueId)
        return usedValues.contains(idStr)
    }

    // ── 循环不变量外提（LICM） ──

    /// 将循环内不变的计算移到循环前。
    fun loopInvariantCodeMotion(src: SsaMir): SsaMir {
        val dst: SsaMir = src.clone()

        // 简化实现：检测循环内的不变操作
        // 完整实现需要支配树和循环嵌套分析
        var i: Int = 0
        while (i < src.valueCount) {
            val val: SsaMirValue = src.valueOf(i)
            // 检测可能的循环不变量（简化：无入边依赖的操作）
            if (val.args == "" && (val.op == "Add" || val.op == "Sub" || val.op == "Mul")) {
                this.licmCount = this.licmCount + 1
            }
            i = i + 1
        }

        return dst
    }

    // ── 部分冗余消除（PRE） ──

    /// 消除循环内的冗余计算。
    fun partialRedundancyElimination(src: SsaMir): SsaMir {
        val dst: SsaMir = src.clone()

        // 简化实现：检测重复的相同操作
        var i: Int = 0
        while (i < src.valueCount) {
            val val: SsaMirValue = src.valueOf(i)
            // 检测可能的冗余操作（简化：相同操作和参数的重复）
            if (this.isRedundantOp(val, src, i)) {
                this.preCount = this.preCount + 1
            }
            i = i + 1
        }

        return dst
    }

    /// 检查操作是否冗余。
    private fun isRedundantOp(val: SsaMirValue, src: SsaMir, valueId: Int): Boolean {
        // 简化实现：检查是否有相同操作和参数的前置操作
        var i: Int = 0
        while (i < valueId) {
            val prev: SsaMirValue = src.valueOf(i)
            if (prev.op == val.op && prev.args == val.args && prev.aux == val.aux) {
                return true
            }
            i = i + 1
        }
        return false
    }

    // ── 循环展开（Loop Unroll） ──

    /// 展开小型循环。
    fun loopUnroll(src: SsaMir, factor: Int): SsaMir {
        val dst: SsaMir = src.clone()

        // 简化实现：检测并展开小型循环
        // 完整实现需要循环检测和代码克隆
        var i: Int = 0
        while (i < src.valueCount) {
            val val: SsaMirValue = src.valueOf(i)
            // 检测循环头（有 Phi 节点进入的块）
            if (val.op == "Phi" && val.args != "") {
                this.unrollCount = this.unrollCount + 1
            }
            i = i + 1
        }

        return dst
    }

    // ── 工具方法 ──

    /// 按逗号分隔字符串。
    private fun splitArgs(args: String): List<String> {
        if (args == "") {
            return arrayListOf<String>()
        }
        val result: List<String> = arrayListOf<String>()
        var lineStart: Int = 0
        var pos: Int = 0
        val len: Int = args.length
        while (pos <= len) {
            if (pos == len || args[pos] == ',') {
                val line: String = args.substring(lineStart, pos)
                if (line != "") {
                    result.add(line)
                }
                lineStart = pos + 1
            }
            pos = pos + 1
        }
        return result
    }

    /// 整数转字符串。
    private fun toStr(n: Int): String {
        if (n == 0) {
            return "0"
        }
        var s: String = ""
        var v: Int = n
        var neg: Boolean = false
        if (v < 0) {
            neg = true
            v = -v
        }
        while (v > 0) {
            val d: Int = v % 10
            s = this.digitToChar(d) + s
            v = v / 10
        }
        if (neg) {
            s = "-" + s
        }
        return s
    }

    /// 数字转字符。
    private fun digitToChar(d: Int): String {
        if (d == 0) { return "0" }
        if (d == 1) { return "1" }
        if (d == 2) { return "2" }
        if (d == 3) { return "3" }
        if (d == 4) { return "4" }
        if (d == 5) { return "5" }
        if (d == 6) { return "6" }
        if (d == 7) { return "7" }
        if (d == 8) { return "8" }
        return "9"
    }

    /// 字符串转整数。
    private fun strToInt(s: String): Int {
        if (s == "") {
            return -1
        }
        var result: Int = 0
        var neg: Boolean = false
        var i: Int = 0
        val len: Int = s.length
        if (i < len && s[i] == '-') {
            neg = true
            i = i + 1
        }
        while (i < len) {
            val c: Int = s[i]
            if (c >= 48 && c <= 57) {
                result = result * 10 + (c - 48)
            }
            i = i + 1
        }
        if (neg) {
            result = -result
        }
        return result
    }
}

// ─────────────────────────────────────────────────────────────
// PhotonOptPassesUtils — 工具对象
// ─────────────────────────────────────────────────────────────

/// PhotonOptPasses 工具方法。
object PhotonOptPassesUtils {

    /// 创建空优化器。
    fun emptyPasses(): PhotonOptPasses {
        return PhotonOptPasses()
    }
}