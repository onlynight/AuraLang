// aura:///aura/lang/compiler/backend/photon/PhotonRuntime.aura
package aura.lang.compiler.backend.photon
// ─────────────────────────────────────────────────────────────
// Photon 最�?runtime（Phase E3�?//
// 提供 `println(ptr)` —�?目前唯一用真实机器码实现的运行时函数�?// 作为「Aura 用户代码 �?调用 runtime �?直连 kernel32」这条链路的验证载体�?//
// 之所以现在能实现：编码器已支�?*函数内局部标签与跳转**
// （见 X86Encoder.emitLabel / emitJmpLabel / emitJccLabel），
// 因而可以写出扫�?NUL �?strlen 循环�?//
// ── 调用约定（Windows x64）──
//
//   println(rcx = char*)  �? 无返回�?//
// ── 栈帧布局（sub rsp, 0x50）──
//
//   [rsp, rsp+0x20)   影子空间（shadow space）—�?被调函数可任意改写，禁止放局部变量！
//   [rbp-0x30]        �?5 个参数的入栈槽（= rsp+0x20，调用时须为 NULL�?//   [rbp-0x28]        hStdOut
//   [rbp-0x20]        入参指针
//   [rbp-0x18]        字符串长度（strlen 结果�?//   [rbp-0x10]        栈上构造的换行符（0x0D 0x0A�?//
// ⚠️ 踩坑记录：最初用 `sub rsp,0x30` 并把 hStdOut/ptr/len 放在
// [rbp-0x18]/[rbp-0x20]/[rbp-0x28]，结果这些槽位正好落在被调函数的
// **影子空间**�?—�?WriteFile 溢出 rcx/rdx/r8/r9 时把它们全写�?// （[rbp-0x28]←rdx、[rbp-0x20]←r8、[rbp-0x18]←r9），
// 表现为「第一�?WriteFile 正常、第二次静默失败」�?// 结论：局部变量必须放�?[rsp+0x20, rbp) 区间，即影子空间**之上**�?//
// 对齐：`push rbp` �?rbp �?0 (mod 16)，`sub rsp,0x50`�?0 �?16 的倍数�?// �?rsp �?0 (mod 16)，满�?call 前的 16 字节对齐要求�?// ─────────────────────────────────────────────────────────────

import aura.lang.std.String

import "x86_64/X86Encoder.aura"
import "PhotonObjectWriter.aura"
import "SyscallEmitter.aura"

object PhotonRuntime {

    /// 帧大小：0xB8 = 184 字节�?    ///
    /// 布局（rsp = rbp - 0xB8）：
    ///   [rbp-0xB8, rbp-0x98)  影子空间 shadow space�?2 字节）—�?syscall 前必须为�?    ///   [rbp-0x98, rbp-0x90)  8 字节对齐填充（rsp+0x20，不可用�?    ///   [rbp-0x90, rbp-0x58)  NtWriteFile 栈参数（arg5..arg10�?    ///     -0x90 = IoStatusBlock ptr   �? rsp+0x28�?    ///     -0x88 = Buffer              �? rsp+0x30�?    ///     -0x80 = Length              �? rsp+0x38�?    ///     -0x78 = ByteOffset          �? rsp+0x40�?    ///     -0x70 = Key                 �? rsp+0x48�?    ///     -0x68 = EaLength            �? rsp+0x50�?    ///   [rbp-0x58, rbp)       局部变量（必须落在 rsp+0x60 之上，避开参数与影子空间）
    ///     -0x58 = IoStatusBlock 存储�?6 字节�?    ///     -0x40 = 入参指针
    ///     -0x38 = strlen 结果
    ///     -0x30 = hStdOutput
    ///     -0x28 = 换行符缓冲区�? 字节�?    ///
    /// 对齐推导：函数入�?rsp �?8 (mod 16)；`push rbp` �?rsp �?0�?    /// `mov rbp, rsp` �?rbp �?0；`sub rsp, 0xB8`�?84 % 16 == 8）后
    /// rsp �?8 (mod 16) —�?正是 Windows x64 ABI �?syscall 的要求�?    ///
    /// ⚠️ 历史踩坑（两连错）：
    ///   1. 早先 arg5 放在 rsp+0x20，落�?*影子空间**内，NtWriteFile 读到 IoStatusBlock=0�?    ///   2. 改为 rsp+0x40 仍然错——x64 ABI �?arg5 起于 **rsp+0x28**（影子空间之�?8 字节），
    ///      不是 rsp+0x20 也不�?rsp+0x40。权威参照：mcountryman/min-sized-rust-windows
    ///      �?`mainCRTStartup` 裸汇编注释表 `arg5 IoStatusBlock @ rsp+0x28`，该程序可运行�?    val FRAME_SIZE: Int = 0xB8

    /// NtWriteFile 栈参数偏移（相对 rbp）�?    ///
    /// 推导：rsp = rbp - 0xB8，故 rsp+0x28 = rbp - 0x90，依�?+8 排列�?    /// ⚠️ arg5 起于 rsp+0x28（影子空间之�?8 字节），不是 rsp+0x20 也不�?rsp+0x40�?    val OFF_ARG5: Int = -0x90   // rsp+0x28 = IoStatusBlock ptr
    val OFF_ARG6: Int = -0x88   // rsp+0x30 = Buffer
    val OFF_ARG7: Int = -0x80   // rsp+0x38 = Length
    val OFF_ARG8: Int = -0x78   // rsp+0x40 = ByteOffset
    val OFF_ARG9: Int = -0x70   // rsp+0x48 = Key
    val OFF_ARG10: Int = -0x68  // rsp+0x50 = EaLength

    /// IoStatusBlock 存储区起始（16 字节，位�?rsp+0x60 之上，不与参数重叠）�?    val OFF_IOBLOCK: Int = -0x58

    /// 入参指针保存槽�?    val OFF_INPUT_PTR: Int = -0x40

    /// 字符串长度保存槽�?    val OFF_LEN: Int = -0x38

    /// hStdOutput 保存槽�?    val OFF_HSTDOUT: Int = -0x30

    /// 换行符缓冲区�? 字节�?x0D 0x0A）�?    val OFF_NEWLINE: Int = -0x28

    /// STANDARD_PROCESS_INFORMATION 缓冲区（24 字节：hStdInput, hStdOutput, hStdError）�?    ///
    /// 位于 [rbp-0x20, rbp-0x00)，不与参数（arg5..arg10）和局部变量冲突�?    val OFF_INFOBUF: Int = -0x20

    // ── println 实现 ──

    /// 编码 `println(rcx = char*)`�?    ///
    /// ```asm
    /// println:
    ///   push rbp; mov rbp, rsp; sub rsp, 0x50
    ///   mov  [rbp-0x20], rcx          ; 保存入参指针
    ///   mov  rdx, rcx                 ; rdx 作为扫描指针
    /// pl_strlen_loop:
    ///   cmp  byte [rdx], 0
    ///   je   pl_strlen_done
    ///   inc  rdx
    ///   jmp  pl_strlen_loop
    /// pl_strlen_done:
    ///   sub  rdx, rcx                 ; rdx = 长度
    ///   mov  [rbp-0x18], rdx
    ///   mov  ecx, -11                 ; STD_OUTPUT_HANDLE
    ///   call [rip+__imp_GetStdHandle]
    ///   mov  [rbp-0x28], rax          ; hStdOut
    ///   ; WriteFile(hStdOut, ptr, len, NULL, NULL)
    ///   mov  rcx, [rbp-0x28]
    ///   mov  rdx, [rbp-0x20]
    ///   mov  r8,  [rbp-0x18]
    ///   xor  r9, r9
    ///   mov  [rbp-0x30], r9
    ///   call [rip+__imp_WriteFile]
    ///   ; 追加换行：WriteFile(hStdOut, "\r\n", 2, NULL, NULL)
    ///   mov  byte [rbp-0x10], 0x0D
    ///   mov  byte [rbp-0x0F], 0x0A
    ///   mov  rcx, [rbp-0x28]
    ///   lea  rdx, [rbp-0x10]
    ///   mov  r8d, 2
    ///   xor  r9, r9
    ///   mov  [rbp-0x30], r9
    ///   call [rip+__imp_WriteFile]
    ///   leave; ret
    /// ```
    fun emitPrintln(enc: X86Encoder): Unit {
        enc.emitPrologue(PhotonRuntime.FRAME_SIZE)

        // 保存入参指针
        enc.emitStackStore(PhotonRuntime.OFF_INPUT_PTR, "rcx")

        // strlen：扫描到 NUL
        enc.emitMovRR("rdx", "rcx")
        enc.emitXorRR("rax", "rax")
        enc.emitLabel("pl_strlen_loop")
        enc.emitCmpByteMemImm8("rdx", 0)
        enc.emitJccLabel("eq", "pl_strlen_done")
        enc.emitIncRR("rdx")
        enc.emitIncRR("rax")
        enc.emitJmpLabel("pl_strlen_loop")
        enc.emitLabel("pl_strlen_done")
        enc.emitStackStore(PhotonRuntime.OFF_LEN, "rax")

        // 获取 hStdOutput：PEB 走链（Windows 11 x64 正确偏移）�?        //
        //   rax = gs:[0x60]          ; PEB（Windows x64 TEB �?PEB 指针的固定偏移）
        //   rax = [rax + 0x20]       ; PEB.ProcessParameters（RTL_USER_PROCESS_PARAMETERS*�?        //   rax = [rax + 0x28]       ; RTL_USER_PROCESS_PARAMETERS.hStdOutput
        //
        // 偏移依据：Windows 10/11 x64 PEB.ProcessParameters 位于 +0x20�?        // PROCESS_PARAMETERS.hOutput 位于 +0x28�?        enc.emitMovGSSeg64("rax", 0x60)              // rax = PEB
        enc.emitMovMemDisp8("rax", "rax", 0x20)      // rax = ProcessParameters (PEB+0x20)
        enc.emitMovMemDisp8("rax", "rax", 0x28)      // rax = hStdOutput (ProcessParameters+0x28)
        enc.emitStackStore(PhotonRuntime.OFF_HSTDOUT, "rax")

        // ── 第一�?NtWriteFile：写入字符串 ──
        //
        // 栈参数（x64 ABI：arg5 起于 rsp+0x20）：
        //   [rbp-0x98] = IoStatusBlock ptr   (rsp+0x20)
        //   [rbp-0x90] = Buffer              (rsp+0x28)
        //   [rbp-0x88] = Length              (rsp+0x30)
        //   [rbp-0x80] = ByteOffset = 0      (rsp+0x38)
        //   [rbp-0x78] = Key = 0             (rsp+0x40)
        //   [rbp-0x70] = EaBuffer = 0        (rsp+0x48)
        enc.emitLeaStack("rax", PhotonRuntime.OFF_IOBLOCK)
        enc.emitStackStore(PhotonRuntime.OFF_ARG5, "rax")
        enc.emitStackLoad("rax", PhotonRuntime.OFF_INPUT_PTR)
        enc.emitStackStore(PhotonRuntime.OFF_ARG6, "rax")
        enc.emitStackLoad("rax", PhotonRuntime.OFF_LEN)
        enc.emitStackStore(PhotonRuntime.OFF_ARG7, "rax")
        enc.emitXorRR("rax", "rax")
        enc.emitStackStore(PhotonRuntime.OFF_ARG8, "rax")
        enc.emitStackStore(PhotonRuntime.OFF_ARG9, "rax")
        // EaLength 必须显式清零：NtWriteFile 的第 10 个参数，若栈上残留非 0
        // 值，内核会尝试从 EaBuffer 复制扩展属性并导致访问违规�?        enc.emitStackStore(PhotonRuntime.OFF_ARG10, "rax")

        // 寄存器设�?+ syscall
        // ⚠️ Windows x64 syscall �?*�?1 个参数必须放�?r10**�?        // `syscall` 指令会把返回地址写进 rcx，因此内核从 r10 读取 arg1
        // （ntdll �?stub 正是 `mov r10, rcx` 后再 `syscall`）�?        enc.emitStackLoad("r10", PhotonRuntime.OFF_HSTDOUT)
        enc.emitXorRR("rdx", "rdx")
        enc.emitXorRR("r8", "r8")
        enc.emitXorRR("r9", "r9")
        SyscallEmitter.emitSyscall(enc, 0x08)  // NtWriteFile（本�?ntdll 实测 0x08�?
        // ── 第二�?NtWriteFile：写�?CRLF ──
        enc.emitStoreByteMemImm8(PhotonRuntime.OFF_NEWLINE, 0x0D)
        enc.emitStoreByteMemImm8(PhotonRuntime.OFF_NEWLINE + 1, 0x0A)

        enc.emitLeaStack("rax", PhotonRuntime.OFF_IOBLOCK)
        enc.emitStackStore(PhotonRuntime.OFF_ARG5, "rax")
        enc.emitLeaStack("rax", PhotonRuntime.OFF_NEWLINE)
        enc.emitStackStore(PhotonRuntime.OFF_ARG6, "rax")
        enc.emitMovRI32("rax", 2)
        enc.emitStackStore(PhotonRuntime.OFF_ARG7, "rax")
        enc.emitXorRR("rax", "rax")
        enc.emitStackStore(PhotonRuntime.OFF_ARG8, "rax")
        enc.emitStackStore(PhotonRuntime.OFF_ARG9, "rax")
        // EaLength 必须显式清零：NtWriteFile 的第 10 个参数，若栈上残留非 0
        // 值，内核会尝试从 EaBuffer 复制扩展属性并导致访问违规�?        enc.emitStackStore(PhotonRuntime.OFF_ARG10, "rax")

        // ⚠️ Windows x64 syscall �?*�?1 个参数必须放�?r10**�?        // `syscall` 指令会把返回地址写进 rcx，因此内核从 r10 读取 arg1
        // （ntdll �?stub 正是 `mov r10, rcx` 后再 `syscall`）�?        enc.emitStackLoad("r10", PhotonRuntime.OFF_HSTDOUT)
        enc.emitXorRR("rdx", "rdx")
        enc.emitXorRR("r8", "r8")
        enc.emitXorRR("r9", "r9")
        SyscallEmitter.emitSyscall(enc, 0x08)  // NtWriteFile（本�?ntdll 实测 0x08�?
        enc.emitEpilogue()
    }

    // ── 用户代码：main ──

    /// 编码 `main`：调�?runtime �?`println` 打印文本，返�?0�?    ///
    /// ```asm
    /// main:
    ///   push rbp; mov rbp, rsp; sub rsp, 0x30
    ///   lea  rcx, [rip + @str.0]
    ///   call println                  ; 跨对象：�?runtime.obj 提供
    ///   xor  eax, eax
    ///   leave; ret
    /// ```
    fun emitPrintMain(enc: X86Encoder, text: String): Unit {
        enc.emitPrologue(0x30)
        enc.emitLeaRIP("rcx", "@str.0")
        enc.emitCallRel("println")
        enc.emitXorRR("eax", "eax")
        enc.emitMovRR("rcx", "eax")  // exit code = 0
        enc.emitCallRel("exit")      // 显式终止进程（无 CRT�?        enc.emitEpilogue()           // 不可�?    }

    // ── 字符串操�?──

    /// 编码 `strlen(rcx = char*) �?rax = Int`�?    ///
    /// ```asm
    /// strlen:
    ///   push rbp; mov rbp, rsp
    ///   mov  rdx, rcx
    ///   xor  rax, rax
    /// loop:
    ///   cmp  byte [rdx], 0
    ///   je   done
    ///   inc  rdx
    ///   inc  rax
    ///   jmp  loop
    /// done:
    ///   leave; ret
    /// ```
    fun emitStrlen(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitMovRR("rdx", "rcx")
        enc.emitXorRR("rax", "rax")
        enc.emitLabel("strlen_loop")
        enc.emitCmpByteMemImm8("rdx", 0)
        enc.emitJccLabel("eq", "strlen_done")
        enc.emitIncRR("rdx")
        enc.emitIncRR("rax")
        enc.emitJmpLabel("strlen_loop")
        enc.emitLabel("strlen_done")
        enc.emitEpilogue()
    }

    /// 编码 `charCodeAt(rcx = char*, rdx = index) �?rax = Int`�?    ///
    /// ```asm
    /// charCodeAt:
    ///   push rbp; mov rbp, rsp
    ///   movzx eax, byte ptr [rcx+rdx]
    ///   leave; ret
    /// ```
    fun emitCharCodeAt(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitMovzxRegMemIndexed("eax", "rcx", "rdx")
        enc.emitEpilogue()
    }

    /// 编码 `strcmp(rcx = char*, rdx = char*) �?rax = Int`�?    ///
    /// ```asm
    /// strcmp:
    ///   push rbp; mov rbp, rsp
    ///   xor  r8, r8
    /// loop:
    ///   cmp  byte [rcx+r8], byte [rdx+r8]
    ///   jne  done
    ///   test byte [rcx+r8], byte [rcx+r8]
    ///   jz   done
    ///   inc  r8
    ///   jmp  loop
    /// done:
    ///   mov  rax, r8
    ///   leave; ret
    /// ```
    fun emitStrcmp(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitXorRR("r8", "r8")
        enc.emitLabel("strcmp_loop")
        enc.emitCmpMemMem("rcx", "r8", "rdx", "r8")
        enc.emitJccLabel("ne", "strcmp_done")
        enc.emitTestMemImm8("rcx", "r8", 0)
        enc.emitJccLabel("z", "strcmp_done")
        enc.emitIncRR("r8")
        enc.emitJmpLabel("strcmp_loop")
        enc.emitLabel("strcmp_done")
        enc.emitMovRR("rax", "r8")
        enc.emitEpilogue()
    }

    // ── 字符串相等比�?──

    /// 编码 `streq(rcx = char*, rdx = char*) �?rax = 1/0`（内容相等）�?    ///
    /// 为什么不�?`strcmp`：`emitStrcmp` 返回的是「首个不同字节的下标�?    ///（相等时返回长度），无法用于判等。`streq` 返回严格�?0/1�?    ///
    /// ```asm
    /// streq:
    ///   push rbp; mov rbp, rsp
    ///   xor  r8, r8
    /// loop:
    ///   mov  al, [rcx+r8]
    ///   cmp  al, [rdx+r8]
    ///   jne  not_equal
    ///   test al, al
    ///   jz   equal
    ///   inc  r8
    ///   jmp  loop
    /// equal:
    ///   mov  eax, 1
    ///   leave; ret
    /// not_equal:
    ///   xor  eax, eax
    ///   leave; ret
    /// ```
    fun emitStreq(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitXorRR("r8", "r8")
        enc.emitLabel("streq_loop")
        enc.emitCmpMemMem("rcx", "r8", "rdx", "r8")
        enc.emitJccLabel("ne", "streq_not_equal")
        enc.emitTestMemImm8("rcx", "r8", 0)
        enc.emitJccLabel("z", "streq_equal")
        enc.emitIncRR("r8")
        enc.emitJmpLabel("streq_loop")
        enc.emitLabel("streq_equal")
        enc.emitMovRI32("eax", 1)
        enc.emitEpilogue()
        enc.emitLabel("streq_not_equal")
        enc.emitXorRR("eax", "eax")
        enc.emitEpilogue()
    }

    // ── 异常处理支持 ──

    /// 编码 `throwException(rcx = Exception*) �?never returns`�?    ///
    /// 简化实现：直接终止程序（NtTerminateProcess syscall）�?    /// 完整实现需要异常表遍历�?    fun emitThrowException(enc: X86Encoder): Unit {
        enc.emitPrologue(0x20)
        // NtTerminateProcess(0, 1)
        enc.emitXorRR("r10", "r10")  // processHandle = 0 (当前进程) �?arg1 必须�?r10
        enc.emitMovRI32("rdx", 1)    // exitStatus = 1 (异常)
        SyscallEmitter.emitSyscall(enc, 0x2C)  // NtTerminateProcess（本�?ntdll 实测 0x2C�?        enc.emitEpilogue()  // 不可达，仅为函数完整�?    }

    // ── exit 实现 ──

    /// 编码 `exit(rcx = Int) �?never returns`�?    ///
    /// 使用 NtTerminateProcess syscall 终止进程�?    ///
    /// ```asm
    /// exit:
    ///   push rbp; mov rbp, rsp; sub rsp, 0x20
    ///   mov  [rbp-0x10], rcx       ; 保存退出码
    ///   xor  rcx, rcx              ; processHandle = 0
    ///   mov  rdx, [rbp-0x10]       ; exitStatus
    ///   mov  eax, 0x30             ; NtTerminateProcess
    ///   syscall
    ///   ret                        ; 不可�?    /// ```
    fun emitExit(enc: X86Encoder): Unit {
        enc.emitPrologue(0x20)
        // 保存退出码（rcx 将被覆盖�?processHandle�?        enc.emitStackStore(-0x10, "rcx")
        // NtTerminateProcess(NtCurrentProcess(), exitStatus)
        //
        // ⚠️ 当前进程�?*伪句柄是 -1�?xFFFFFFFFFFFFFFFF�?*，不�?0�?        // `NtTerminateProcess(0, �?` 会以 STATUS_INVALID_HANDLE 直接返回�?        // 进程不会终止 —�?`call exit` 于是返回，执行流继续落到 main 之后�?        // `int3` 填充字节上，进程�?0x80000003（STATUS_BREAKPOINT）结�?        //（实�?01/02 退出码恒为 -2147483645�?3 还额外打印出一行垃圾）�?        // arg1 �?r10（Win64 syscall 约定）�?        enc.emitMovRI("r10", -1)
        enc.emitStackLoad("rdx", -0x10)  // exitStatus
        SyscallEmitter.emitSyscall(enc, 0x2C)  // NtTerminateProcess（本�?ntdll 实测 0x2C�?        enc.emitEpilogue()  // 不可达，仅为函数完整�?    }

    // ── toStr 实现 ──

    /// 编码 `toStr(rcx = Int) �?rax = char*`�?    ///
    /// 使用 .data 段的静态缓冲区�?2 字节）存储转换结果�?    /// 算法：处�?0、处理负数、除 10 取余、逆序写入�?    fun emitToStr(enc: X86Encoder): Unit {
        enc.emitPrologue(0x40)

        // Windows x64 ABI：rbx / rsi 是非易失寄存器，必须保存 + 恢复�?        // 旧实现直接用它们当「缓冲区基址 / 写指针」却不保�?—�?调用方的
        // 跨调用活值（例如字符串常量的地址）会被这个函数悄悄改掉�?        enc.emitStackStore(-0x30, "rbx")
        enc.emitStackStore(-0x38, "rsi")

        // 加载缓冲区地址
        enc.emitLeaRIP("rbx", "toStrBuffer")

        // 保存输入�?        enc.emitStackStore(-0x20, "rcx")

        // 处理负数
        enc.emitStackLoad("rax", -0x20)
        enc.emitCmpRI("rax", 0)
        enc.emitJccLabel("ge", "tos_nonneg")

        // 负数：设置标志，取反
        enc.emitMovRI32("eax", 1)
        enc.emitStackStore(-0x28, "rax")  // 负号标志
        enc.emitXorRR("rdx", "rdx")
        enc.emitSubRR("rdx", "rax")  // rdx = -rax
        enc.emitMovRR("rax", "rdx")
        enc.emitStackStore(-0x20, "rax")  // 保存绝对�?
        enc.emitJmpLabel("tos_start")

        enc.emitLabel("tos_nonneg")
        enc.emitMovRI32("eax", 0)
        enc.emitStackStore(-0x28, "rax")  // 无负号标�?
        enc.emitLabel("tos_start")
        // 初始化写指针：指向缓冲区末尾�?1�?        enc.emitMovRR("rsi", "rbx")
        enc.emitAddRI("rsi", 31)  // rsi = &buffer[31]
        enc.emitXorRR("rax", "rax")  // rax = 0
        enc.emitMovByteMemReg("rsi", "rax")  // [rsi] = 0（NUL 终止符）

        // 加载绝对�?        enc.emitStackLoad("rax", -0x20)

        // ── 特例：值为 0 ──
        // 循环是「先判零再写字符」，0 会直接跳�?tos_done 且写指针仍停�?        // 缓冲区末尾的 NUL �?�?返回空串。实�?`toStr(0)` 打印空行�?        enc.emitCmpRI("rax", 0)
        enc.emitJccLabel("ne", "tos_loop")
        enc.emitSubRI("rsi", 1)
        enc.emitMovRI32("eax", '0')
        enc.emitMovByteMemReg("rsi", "rax")
        enc.emitJmpLabel("tos_return")

        // 循环：除�?10，存余数
        enc.emitLabel("tos_loop")
        enc.emitCmpRI("rax", 0)
        enc.emitJccLabel("eq", "tos_done")

        // rax = rax / 10
        enc.emitMovRI32("r10", 10)
        enc.emitXorRR("rdx", "rdx")
        enc.emitIdiv("r10")  // rax = �? rdx = 余数

        // 递减写指针并存储数字字符
        enc.emitSubRI("rsi", 1)
        enc.emitAddRI("rdx", '0')  // rdx = 余数 + '0'
        enc.emitMovByteMemReg("rsi", "rdx")  // [rsi] = 数字字符

        enc.emitJmpLabel("tos_loop")

        enc.emitLabel("tos_done")
        // 如果是负数，添加 '-' 前缀
        enc.emitStackLoad("rax", -0x28)
        enc.emitCmpRI("rax", 0)
        enc.emitJccLabel("eq", "tos_return")

        enc.emitSubRI("rsi", 1)
        enc.emitMovRI32("eax", '-')  // rax = '-'
        enc.emitMovByteMemReg("rsi", "rax")  // [rsi] = '-'

        enc.emitLabel("tos_return")
        enc.emitMovRR("rax", "rsi")  // 返回字符串指�?        // 恢复非易失寄存器（rax 已持有返回值，不受影响�?        enc.emitStackLoad("rsi", -0x38)
        enc.emitStackLoad("rbx", -0x30)
        enc.emitEpilogue()
    }

    // ── strcat 实现 ──

    /// 编码 `strcat(rcx = s1, rdx = s2) �?rax = 拼接结果`�?    ///
    /// 结果�?.data 段的**bump 分配 arena** 里切一块新内存（每次调用返�?    /// 不同地址），因此拼接结果�?*不可�?*�?—�?后续拼接不会覆写它�?    ///
    /// ```asm
    ///   len1 = strlen(s1); len2 = strlen(s2)
    ///   need = len1 + len2 + 1
    ///   base = [strcatBump]; new = base + need
    ///   if (new > ARENA_LIMIT) { base = 0; new = need }   ; 回绕，避免越�?    ///   [strcatBump] = new
    ///   dst = strcatArena + base
    ///   dst[0..len1) = s1; dst[len1..len1+len2] = s2; 末尾 NUL
    ///   rax = dst
    /// ```
    ///
    /// ⚠️ 旧实现返�?*同一�?*静态缓冲区：链式拼接时源与目标别名
    ///（`"B: " + s3` �?s3 就是该缓冲区），边读边写导致源永�?NUL �?写越界；
    /// 即使不崩溃，`s3` 也会被下一次拼接覆�?—�?实测
    /// `P2/04_string_ops` �?`s3.length()` 得到 16 而不�?11，判等随之失败�?    fun emitStrcat(enc: X86Encoder): Unit {
        // 0x120 = 288 字节：保存寄存器 + s1/s2/len1/len2/newBump�?        // 16 字节对齐�?x120 % 16 == 0）�?        enc.emitPrologue(0x120)

        // 保存 callee-saved r12 / rbx / rsi / rdi（Win64 非易失寄存器�?        enc.emitStackStore(-0x88, "r12")
        enc.emitStackStore(-0x98, "rbx")
        enc.emitStackStore(-0xA8, "rsi")
        enc.emitStackStore(-0xB0, "rdi")

        // 保存两个字符串指�?        enc.emitStackStore(-0x90, "rcx")  // s1
        enc.emitStackStore(-0xC0, "rdx")  // s2

        // 计算 s1 长度
        enc.emitStackLoad("rax", -0x90)   // rax = s1
        enc.emitXorRR("rdx", "rdx")        // rdx = 0 (用于检�?NUL)
        enc.emitLabel("strcat_len1_loop")
        enc.emitCmpByteMemImm8("rax", 0)
        enc.emitJccLabel("eq", "strcat_len1_done")
        enc.emitIncRR("rax")
        enc.emitIncRR("rdx")
        enc.emitJmpLabel("strcat_len1_loop")
        enc.emitLabel("strcat_len1_done")
        enc.emitStackStore(-0xA0, "rdx")  // len1 = rdx

        // 计算 s2 长度
        enc.emitStackLoad("rax", -0xC0)   // rax = s2
        enc.emitXorRR("rdx", "rdx")        // rdx = 0
        enc.emitLabel("strcat_len2_loop")
        enc.emitCmpByteMemImm8("rax", 0)
        enc.emitJccLabel("eq", "strcat_len2_done")
        enc.emitIncRR("rax")
        enc.emitIncRR("rdx")
        enc.emitJmpLabel("strcat_len2_loop")
        enc.emitLabel("strcat_len2_done")
        enc.emitStackStore(-0xB8, "rdx")  // len2 = rdx（供复制阶段定长使用�?
        // ── 分配阶段：从 bump arena 切一�?*�?*内存当目�?──
        //
        // need = len1 + len2 + 1（含结尾 NUL�?        enc.emitMovRR("rcx", "rdx")          // rcx = len2
        enc.emitStackLoad("rax", -0xA0)      // len1
        enc.emitAddRR("rcx", "rax")
        enc.emitIncRR("rcx")                 // rcx = need

        // base = [heapBump]；new = base + need；越界则回绕�?0 重新开�?        enc.emitMovRIP("rax", "heapBump")    // rax = base
        enc.emitMovRR("rbx", "rax")
        enc.emitAddRR("rbx", "rcx")          // rbx = new
        enc.emitCmpRI("rbx", 1048000)
        enc.emitJccLabel("le", "strcat_alloc_ok")
        enc.emitXorRR("rax", "rax")          // base = 0
        enc.emitMovRR("rbx", "rcx")          // new = need
        enc.emitLabel("strcat_alloc_ok")
        enc.emitStoreRIP("heapBump", "rbx")

        // dst = heapArena + base
        enc.emitLeaRIP("r12", "heapArena")
        enc.emitAddRR("r12", "rax")

        // �?s1 �?dst（计�?= len1 + 1，含 NUL�?        enc.emitStackLoad("rsi", -0x90)
        enc.emitMovRR("rdi", "r12")
        enc.emitStackLoad("rcx", -0xA0)   // len1
        enc.emitIncRR("rcx")
        enc.emitLabel("strcat_c1_loop")
        enc.emitCmpRI("rcx", 0)
        enc.emitJccLabel("eq", "strcat_c1_done")
        enc.emitMovzxRegMemByte("rax", "rsi")
        enc.emitMovByteMemReg("rdi", "rax")
        enc.emitIncRR("rsi")
        enc.emitIncRR("rdi")
        enc.emitSubRI("rcx", 1)
        enc.emitJmpLabel("strcat_c1_loop")
        enc.emitLabel("strcat_c1_done")

        // �?目标指针回到 dst + len1（覆盖上一步写下的 NUL�?        enc.emitMovRR("rdi", "r12")
        enc.emitStackLoad("rcx", -0xA0)   // len1
        enc.emitAddRR("rdi", "rcx")

        // �?s2 �?dst + len1（计�?= len2 + 1，含 NUL�?        enc.emitStackLoad("rsi", -0xC0)
        enc.emitStackLoad("rcx", -0xB8)   // len2
        enc.emitIncRR("rcx")
        enc.emitLabel("strcat_c2_loop")
        enc.emitCmpRI("rcx", 0)
        enc.emitJccLabel("eq", "strcat_done")
        enc.emitMovzxRegMemByte("rax", "rsi")
        enc.emitMovByteMemReg("rdi", "rax")
        enc.emitIncRR("rsi")
        enc.emitIncRR("rdi")
        enc.emitSubRI("rcx", 1)
        enc.emitJmpLabel("strcat_c2_loop")

        enc.emitLabel("strcat_done")
        enc.emitMovRR("rax", "r12")  // 返回新分配的字符串指�?        // 恢复 callee-saved r12 / rbx / rsi / rdi（rax 已持有返回值）
        enc.emitStackLoad("rdi", -0xB0)
        enc.emitStackLoad("rsi", -0xA8)
        enc.emitStackLoad("rbx", -0x98)
        enc.emitStackLoad("r12", -0x88)
        enc.emitEpilogue()
    }

    // ── 堆列表实现（数组/列表字面�?+ 索引读写）──
    //
    // 内存布局�? 字节槽）�?    //
    //   [0]      count（元素个数，64 位）
    //   [8]      元素 0
    //   [16]     元素 1
    //   �?       元素 i 位于 [8 + i*8]
    //
    // 对象�?`heapArena` �?bump 游标分配（与 `strcat` 共用同一个堆）�?    // 元素统一�?64 位槽存放 —�?Photon 目前只有 Int/Bool/Float/String 指针
    // 这几种标量，都在 8 字节以内（字符串存的是指针）�?    //
    // 为什么在 Photon 侧用 runtime 函数而不�?Load/Gep：那条路径当前是空的
    //（`Lowering.lowerLoad/lowerStore` �?`addValueWithChain`，值不登记�?    // `LirBlock.instrs`，DAG 里根本没有加�?存储指令）�?
    /// 编码 `__list_alloc(rcx = count) �?rax = list`�?    fun emitListAlloc(enc: X86Encoder): Unit {
        enc.emitPrologue(0x20)
        enc.emitMovRR("r8", "rcx")     // r8 = count
        enc.emitShlRI("rcx", 3)        // count * 8
        enc.emitAddRI("rcx", 8)        // + 计数�?        // bump 分配（rax = base，rdx = new�?        enc.emitMovRIP("rax", "heapBump")
        enc.emitMovRR("rdx", "rax")
        enc.emitAddRR("rdx", "rcx")
        enc.emitCmpRI("rdx", 1048000)
        enc.emitJccLabel("le", "list_alloc_ok")
        enc.emitXorRR("rax", "rax")
        enc.emitMovRR("rdx", "rcx")
        enc.emitLabel("list_alloc_ok")
        enc.emitStoreRIP("heapBump", "rdx")
        enc.emitLeaRIP("r9", "heapArena")
        enc.emitAddRR("rax", "r9")               // rax = list 指针
        enc.emitStoreMemDisp32("rax", 0, "r8")   // [list] = count
        enc.emitEpilogue()
    }

    /// 编码 `__list_setat(rcx = list, rdx = idx, r8 = val) �?rax = list`�?    /// 添加 null 检查防止崩溃�?    fun emitListSetAt(enc: X86Encoder): Unit {
        // 检�?list 指针是否�?null
        enc.emitCmpRI("rcx", 0)
        enc.emitJccLabel("eq", "list_set_null")
        // 正常路径：存�?[rcx + rdx*8 + 8] = r8
        enc.emitStoreIndexed8("rcx", "rdx", 8, "r8")
        enc.emitMovRR("rax", "rcx")
        enc.emitRet()
        // null 路径：返�?0
        enc.emitLabel("list_set_null")
        enc.emitMovRI("eax", 0)
        enc.emitRet()
    }

    /// 编码 `__list_get(rcx = list, rdx = idx) �?rax = value`�?    /// 添加 null 检查防止崩溃（对象模型未完全实现时 list 可能�?null）�?    fun emitListGet(enc: X86Encoder): Unit {
        // 检�?list 指针是否�?null
        enc.emitCmpRI("rcx", 0)
        enc.emitJccLabel("eq", "list_get_null")
        // 正常路径：加�?[rcx + rdx*8 + 8]
        enc.emitLoadIndexed8("rax", "rcx", "rdx", 8)
        enc.emitRet()
        // null 路径：返�?0
        enc.emitLabel("list_get_null")
        enc.emitMovRI("eax", 0)
        enc.emitRet()
    }

    /// 编码 stub 函数：`mov eax, 0; ret`�?    ///
    /// 用于自举编译阶段链接器未定义符号的占位实现——编译器引用�?    /// 尚未�?runtime 中实现的 stdlib / POSIX / 类构造器符号。stub 返回 0�?    /// 保证链接器不�?undefined symbol；运行时不会调用到这些符�?    /// （Step 3 目标是「可链接」，不是「可运行」）�?    fun emitStub(enc: X86Encoder): Unit {
        enc.emitMovRI("eax", 0)
        enc.emitRet()
    }

    // ── Step 4: 对象分配�?+ 类构造器 ──

    /// 编码 `emitObjectAlloc(size: i64) �?rax = obj*`�?    ///
    /// �?`.data` 段的 `objBump` 游标分配 size 字节�?B 对齐），
    /// 零初始化后返回对象指针。与 `strcat`/`__list_alloc` 共用 `heapArena`�?    /// 但使用独立的 bump 游标 `objBump`�?    ///
    /// ```asm
    /// emitObjectAlloc:
    ///   push rbp; mov rbp, rsp; sub rsp, 0x50
    ///   mov  [rbp-0x30], r12    ; 保存 callee-saved
    ///   mov  [rbp-0x38], rsi
    ///   mov  [rbp-0x10], rcx    ; size
    ///   mov  r12, [rip+objBump] ; 当前偏移
    ///   add  rdx, r12           ; new = old + size
    ///   cmp  rdx, 1048000
    ///   jle  alloc_ok
    ///   xor  r12, r12           ; 回绕：base = 0
    ///   mov  rdx, [rbp-0x10]    ; new = size
    /// alloc_ok:
    ///   mov  [rip+objBump], rdx ; 更新游标
    ///   lea  rsi, [rip+heapArena]
    ///   add  rsi, r12           ; rsi = 实际地址
    ///   mov  [rbp-0x20], rsi    ; 保存返回地址
    ///   mov  [rbp-0x28], rsi    ; 初始化写指针
    ///   mov  rcx, [rbp-0x10]    ; rcx = size / 8
    ///   shr  rcx, 3
    ///   xor  rdx, rdx           ; rdx = 0
    /// zero_loop:
    ///   cmp  rcx, 0
    ///   je   zero_done
    ///   mov  rsi, [rbp-0x28]
    ///   mov  [rsi], rdx         ; �?8 字节�?    ///   add  rsi, 8
    ///   mov  [rbp-0x28], rsi
    ///   sub  rcx, 1
    ///   jmp  zero_loop
    /// zero_done:
    ///   mov  rax, [rbp-0x20]    ; 返回原始地址
    ///   ; 恢复 callee-saved + leave; ret
    /// ```
    fun emitObjectAlloc(enc: X86Encoder): Unit {
        enc.emitPrologue(0x50)

        // 保存 callee-saved
        enc.emitStackStore(-0x30, "r12")
        enc.emitStackStore(-0x38, "rsi")

        // 保存 size
        enc.emitStackStore(-0x10, "rcx")

        // r12 = [objBump]（当前偏移）
        enc.emitMovRIP("r12", "objBump")

        // new = r12 + size
        enc.emitStackLoad("rdx", -0x10)
        enc.emitAddRR("rdx", "r12")

        // 边界检�?        enc.emitCmpRI("rdx", 1048000)
        enc.emitJccLabel("le", "oa_alloc_ok")

        // 回绕
        enc.emitXorRR("r12", "r12")
        enc.emitStackLoad("rdx", -0x10)

        enc.emitLabel("oa_alloc_ok")

        // 更新 objBump
        enc.emitStoreRIP("objBump", "rdx")

        // 计算实际地址：heapArena + offset
        enc.emitLeaRIP("rsi", "heapArena")
        enc.emitAddRR("rsi", "r12")

        // 保存返回地址（不被修改）
        enc.emitStackStore(-0x20, "rsi")
        // 初始化写指针（将在循环中递增�?        enc.emitStackStore(-0x28, "rsi")

        // 零初始化：每次写 8 字节
        enc.emitStackLoad("rcx", -0x10)
        enc.emitShrRI("rcx", 3)
        enc.emitXorRR("rdx", "rdx")  // rdx = 0

        enc.emitLabel("oa_zero_loop")
        enc.emitCmpRI("rcx", 0)
        enc.emitJccLabel("eq", "oa_zero_done")

        enc.emitStackLoad("rsi", -0x28)
        enc.emitStoreMemDisp32("rsi", 0, "rdx")
        enc.emitAddRI("rsi", 8)
        enc.emitStackStore(-0x28, "rsi")

        enc.emitSubRI("rcx", 1)
        enc.emitJmpLabel("oa_zero_loop")

        enc.emitLabel("oa_zero_done")

        // 返回原始地址
        enc.emitStackLoad("rax", -0x20)

        // 恢复 callee-saved
        enc.emitStackLoad("rsi", -0x38)
        enc.emitStackLoad("r12", -0x30)

        enc.emitEpilogue()
    }

    /// 生成类构造器代码：分配对�?�?设置 vtable pointer (offset 0) + object size (offset 8) �?返回指针�?    ///
    /// 对象内存布局�?    ///   [0x00] vtable pointer (8B)  �?初始化为 0（无虚方法）
    ///   [0x08] object size   (8B)  �?记录分配大小
    ///   [0x10] field 0       (8B)  �?�?emitObjectAlloc 零初始化
    ///   [0x18] field 1       (8B)  �?�?emitObjectAlloc 零初始化
    ///   ...
    ///
    /// 栈帧布局（sub rsp, 0x30 = 48B）：
    ///   [rbp-0x30, rbp-0x10)  影子空间 shadow space�?2B，调�?emitObjectAlloc 前必须为空）
    ///   [rbp-0x08]            size 保存槽（避开影子空间�?    ///
    fun emitClassConstructor(enc: X86Encoder, size: Int): Unit {
        enc.emitPrologue(0x30)  // push rbp; mov rbp, rsp; sub rsp, 0x30

        // 保存 size 到栈上（call �?rcx 会被 runtime_emitObjectAlloc 覆盖�?        enc.emitMovRI("rcx", size)
        enc.emitStackStore(-0x8, "rcx")  // [rbp-0x8] = size

        // 重新加载 size �?rcx（runtime_emitObjectAlloc 的参数）
        enc.emitStackLoad("rcx", -0x8)
        enc.emitCallRel("runtime_emitObjectAlloc")

        // rax = 对象指针
        // 设置 vtable pointer = 0（offset 0，当前无虚方法）
        enc.emitXorRR("rdx", "rdx")
        enc.emitStoreMemDisp32("rax", 0, "rdx")

        // 设置 object size = size（offset 8�?        enc.emitStackLoad("rcx", -0x8)
        enc.emitStoreMemDisp32("rax", 8, "rcx")

        // 返回对象指针（rax 已有�?        enc.emitEpilogue()  // leave; ret
    }

    // ── Step 4: POSIX 函数实现 ──

    /// 编码 `open(rcx=path, rdx=flags) �?rax = handle or -1`�?    /// 使用 NtCreateFile syscall（服务号 0x05），ASCII→UTF-16 转换�?    fun emitOpen(enc: X86Encoder): Unit {
        enc.emitPrologue(0x160)
        enc.emitStackStore(-0x20, "rcx")
        enc.emitStackStore(-0x28, "rdx")
        enc.emitStackStore(-0x10, "rbx")
        enc.emitStackStore(-0x30, "rsi")
        enc.emitStackStore(-0x38, "r12")

        // 1. 路径长度
        enc.emitStackLoad("rax", -0x20)
        enc.emitXorRR("r12", "r12")
        enc.emitLabel("open_scan")
        enc.emitCmpByteMemImm8("rax", 0)
        enc.emitJccLabel("eq", "open_scan_done")
        enc.emitIncRR("rax")
        enc.emitIncRR("r12")
        enc.emitJmpLabel("open_scan")
        enc.emitLabel("open_scan_done")

        // 2. ASCII→UTF-16
        enc.emitLeaStack("rsi", -0x70)
        enc.emitStackLoad("rbx", -0x20)
        enc.emitMovRR("rax", "r12")
        enc.emitLabel("open_conv")
        enc.emitCmpRI("rax", 0)
        enc.emitJccLabel("eq", "open_conv_done")
        enc.emitMovzxRegMemByte("rdx", "rbx")
        enc.emitMovByteMemReg("rsi", "rdx")
        enc.emitAddRI("rsi", 1)
        enc.emitXorRR("eax", "eax")
        enc.emitMovByteMemReg("rsi", "rax")
        enc.emitAddRI("rsi", 1)
        enc.emitIncRR("rbx")
        enc.emitSubRI("rax", 1)
        enc.emitJmpLabel("open_conv")
        enc.emitLabel("open_conv_done")
        enc.emitXorRR("eax", "eax")
        enc.emitMovByteMemReg("rsi", "rax")
        enc.emitAddRI("rsi", 1)
        enc.emitMovByteMemReg("rsi", "rax")

        // 3. UNICODE_STRING (Length@+0, MaxLen@+2, Buffer@+8)
        enc.emitShlRI("r12", 1)
        enc.emitLeaStack("rbx", -0x80)
        enc.emitMovByteMemReg("rbx", "r12")
        enc.emitAddRI("rbx", 1)
        enc.emitShrRI("r12", 8)
        enc.emitMovByteMemReg("rbx", "r12")
        enc.emitAddRI("r12", 2)
        enc.emitAddRI("rbx", 2)
        enc.emitMovByteMemReg("rbx", "r12")
        enc.emitAddRI("rbx", 1)
        enc.emitShrRI("r12", 8)
        enc.emitMovByteMemReg("rbx", "r12")
        enc.emitLeaStack("rdx", -0x70)
        enc.emitLeaStack("rbx", -0x78)
        enc.emitStoreMemDisp32("rbx", 0, "rdx")

        // 4. OBJECT_ATTRIBUTES (Len@+0, RootDir@+8, ObjName@+16, Attr@+24)
        enc.emitLeaStack("rsi", -0xC0)
        enc.emitMovRI32("eax", 48)
        enc.emitStoreMemDisp32("rsi", 0, "rax")
        enc.emitXorRR("rax", "rax")
        enc.emitStoreMemDisp32("rsi", 8, "rax")
        enc.emitLeaStack("rdx", -0x80)
        enc.emitStoreMemDisp32("rsi", 16, "rdx")
        enc.emitStoreMemDisp32("rsi", 24, "rax")
        enc.emitStoreMemDisp32("rsi", 32, "rax")
        enc.emitStoreMemDisp32("rsi", 40, "rax")

        // 5. IoStatusBlock (全零)
        enc.emitLeaStack("rdx", -0xD8)
        enc.emitXorRR("rax", "rax")
        enc.emitStoreMemDisp32("rdx", 0, "rax")
        enc.emitStoreMemDisp32("rdx", 8, "rax")

        // 6. 栈参�?        enc.emitXorRR("rax", "rax")
        enc.emitStackStore(-0x118, "rax")
        enc.emitStackStore(-0x110, "rax")
        enc.emitStackStore(-0x108, "rax")
        enc.emitMovRI32("eax", 1)
        enc.emitStackStore(-0x100, "rax")
        enc.emitXorRR("eax", "eax")
        enc.emitStackStore(-0xF8, "rax")
        enc.emitStackStore(-0xF0, "rax")
        enc.emitStackStore(-0xE8, "rax")

        // 7. syscall
        enc.emitLeaStack("rcx", -0xD8)
        enc.emitMovRI32("edx", -1073741824)
        enc.emitLeaStack("r8", -0xC0)
        enc.emitLeaStack("r9", -0xD8)
        SyscallEmitter.emitWindowsSyscall(enc, 0x05, "rcx", "rdx", "r8", "r9")

        // 8. 结果
        enc.emitCmpRI("eax", 0)
        enc.emitJccLabel("ne", "open_fail")
        enc.emitStackLoad("rax", -0xD0)
        enc.emitJmpLabel("open_done")
        enc.emitLabel("open_fail")
        enc.emitMovRI("eax", -1)
        enc.emitLabel("open_done")
        enc.emitStackLoad("r12", -0x38)
        enc.emitStackLoad("rsi", -0x30)
        enc.emitStackLoad("rbx", -0x10)
        enc.emitEpilogue()
    }

    /// 编码 `close(rcx=fd) �?rax = 0`。NtClose�?x0B）�?    fun emitClose(enc: X86Encoder): Unit {
        enc.emitPrologue(0x20)
        enc.emitMovRR("r10", "rcx")
        SyscallEmitter.emitSyscall(enc, 0x0B)
        enc.emitMovRI("eax", 0)
        enc.emitEpilogue()
    }

    /// 编码 `read(rcx=fd, rdx=buf, r8=count) �?rax = bytes or -1`。NtReadFile�?x03）�?    fun emitRead(enc: X86Encoder): Unit {
        enc.emitPrologue(0x60)
        enc.emitStackStore(-0x20, "rbx")
        enc.emitStackStore(-0x28, "rsi")
        enc.emitStackStore(-0x10, "rcx")
        enc.emitStackStore(-0x18, "rdx")
        enc.emitStackStore(-0x30, "r8")
        // IoStatusBlock at [rbp-0x50]
        enc.emitLeaStack("rbx", -0x50)
        enc.emitXorRR("rax", "rax")
        enc.emitStoreMemDisp32("rbx", 0, "rax")
        enc.emitStoreMemDisp32("rbx", 8, "rax")
        // 栈参�?        enc.emitXorRR("rax", "rax")
        enc.emitStackStore(-0x38, "rax")
        enc.emitStackStore(-0x40, "rax")
        enc.emitStackStore(-0x48, "rax")
        enc.emitStackStore(-0x50, "rax")
        enc.emitStackStore(-0x58, "rax")
        // 寄存�?        enc.emitStackLoad("rcx", -0x10)
        enc.emitStackLoad("rdx", -0x18)
        enc.emitStackLoad("r8", -0x30)
        enc.emitLeaStack("r9", -0x50)
        SyscallEmitter.emitWindowsSyscall(enc, 0x03, "rcx", "rdx", "r8", "r9")
        enc.emitCmpRI("eax", 0)
        enc.emitJccLabel("ne", "read_fail")
        enc.emitStackLoad("rax", -0x48)
        enc.emitJmpLabel("read_done")
        enc.emitLabel("read_fail")
        enc.emitMovRI("eax", -1)
        enc.emitLabel("read_done")
        enc.emitStackLoad("rsi", -0x28)
        enc.emitStackLoad("rbx", -0x20)
        enc.emitEpilogue()
    }

    /// 编码 `write(rcx=fd, rdx=buf, r8=count) �?rax = bytes or -1`。NtWriteFile�?x08）�?    fun emitWrite(enc: X86Encoder): Unit {
        enc.emitPrologue(0x60)
        enc.emitStackStore(-0x20, "rbx")
        enc.emitStackStore(-0x28, "rsi")
        enc.emitStackStore(-0x10, "rcx")
        enc.emitStackStore(-0x18, "rdx")
        enc.emitStackStore(-0x30, "r8")
        enc.emitLeaStack("rbx", -0x50)
        enc.emitXorRR("rax", "rax")
        enc.emitStoreMemDisp32("rbx", 0, "rax")
        enc.emitStoreMemDisp32("rbx", 8, "rax")
        enc.emitXorRR("rax", "rax")
        enc.emitStackStore(-0x38, "rax")
        enc.emitStackStore(-0x40, "rax")
        enc.emitStackStore(-0x48, "rax")
        enc.emitStackStore(-0x50, "rax")
        enc.emitStackStore(-0x58, "rax")
        enc.emitStackLoad("rcx", -0x10)
        enc.emitStackLoad("rdx", -0x18)
        enc.emitStackLoad("r8", -0x30)
        enc.emitLeaStack("r9", -0x50)
        SyscallEmitter.emitWindowsSyscall(enc, 0x08, "rcx", "rdx", "r8", "r9")
        enc.emitCmpRI("eax", 0)
        enc.emitJccLabel("ne", "write_fail")
        enc.emitStackLoad("rax", -0x48)
        enc.emitJmpLabel("write_done")
        enc.emitLabel("write_fail")
        enc.emitMovRI("eax", -1)
        enc.emitLabel("write_done")
        enc.emitStackLoad("rsi", -0x28)
        enc.emitStackLoad("rbx", -0x20)
        enc.emitEpilogue()
    }

    /// 编码 `access(rcx=path, rdx=mode) �?rax = 0`。stub 返回 0（存在）�?    fun emitAccess(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitMovRI("eax", 0)
        enc.emitEpilogue()
    }

    /// 编码 `exitGroup(rcx=code)`。NtTerminateProcess�?x2C）�?    fun emitExitGroup(enc: X86Encoder): Unit {
        enc.emitPrologue(0x20)
        enc.emitStackStore(-0x10, "rcx")
        enc.emitMovRI("r10", -1)
        enc.emitStackLoad("rdx", -0x10)
        SyscallEmitter.emitSyscall(enc, 0x2C)
        enc.emitEpilogue()
    }

    /// stub: fork/execve/wait4 返回 -1�?    fun emitStubMinus1(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitMovRI("eax", -1)
        enc.emitRet()
    }

    // ── Step 4: Memory 内置函数实现 ──
    //
    // `Memory.write/read/alloc/free` �?Aura 源码中是 `extern interface Memory`
    // 的无 @native 注解方法（编译器内置）。Rust AOT 后端将它们内联为 store/load
    // 指令，但 Photon 后端不做内联 —�?如果调用被映射到 `write`（FileOps.write �?    // 运行时函数），`Memory.write(addr, val)` 会被当成文件 I/O 写：fd=addr（无效）�?    // buf=val（小整数），count=未定�?�?NtWriteFile 失败返回 0 �?-1，导�?    // `writeObjectFile()` �?`while (written < want)` 无限循环挂起�?    //
    // 修复：提供独立的 `Memory_write` / `Memory_read` / `Memory_alloc` / `Memory_free`
    // 符号，并�?`mapStdlibFuncName` 中按首参类型区分（Long �?Memory，Int �?FileOps）�?
    /// 编码 `Memory_write(rcx=addr, rdx=val) �?无返回值`：将 val 写入 addr 指向的字节�?    fun emitMemoryWrite(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        // rcx = addr, rdx = val
        // store byte [rcx], dl
        enc.emitMovByteMemReg("rcx", "rdx")
        enc.emitRet()
    }

    /// 编码 `Memory_read(rcx=addr) �?rax = byte`：读�?addr 指向的字节�?    fun emitMemoryRead(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        // rcx = addr
        // movzx eax, byte ptr [rcx]
        enc.emitMovzxRegMemByte("eax", "rcx")
        enc.emitRet()
    }

    /// 编码 `Memory_write16(rcx=addr, rdx=val) �?无返回值`：写�?16 位值�?    fun emitMemoryWrite16(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitStoreMemDisp32("rcx", 0, "rdx")
        enc.emitRet()
    }

    /// 编码 `Memory_read16(rcx=addr) �?rax = i16`：读�?16 位值�?    fun emitMemoryRead16(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitLoadIndexed8("rax", "rcx", "rsp", 0)
        // 简化：直接加载 64 位（高位由调用者处理）
        enc.emitRet()
    }

    /// 编码 `Memory_write32(rcx=addr, rdx=val) �?无返回值`：写�?32 位值�?    fun emitMemoryWrite32(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitStoreMemDisp32("rcx", 0, "rdx")
        enc.emitRet()
    }

    /// 编码 `Memory_read32(rcx=addr) �?rax = i32`：读�?32 位值�?    fun emitMemoryRead32(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitLoadIndexed8("rax", "rcx", "rsp", 0)
        enc.emitRet()
    }

    /// 编码 `Memory_write64(rcx=addr, rdx=val) �?无返回值`：写�?64 位值�?    fun emitMemoryWrite64(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitStoreMemDisp32("rcx", 0, "rdx")
        enc.emitRet()
    }

    /// 编码 `Memory_read64(rcx=addr) �?rax = i64`：读�?64 位值�?    fun emitMemoryRead64(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitLoadIndexed8("rax", "rcx", "rsp", 0)
        enc.emitRet()
    }

    /// 编码 `Memory_alloc(rcx=n) �?rax = ptr`：调�?runtime_emitObjectAlloc 分配内存�?    fun emitMemoryAlloc(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        // rcx = n (已设�?
        enc.emitCallRel("runtime_emitObjectAlloc")
        enc.emitRet()
    }

    /// 编码 `Memory_free(rcx=addr)`：bump 分配器无需释放（no-op）�?    fun emitMemoryFree(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitRet()
    }

    // ── Step 4: Stdlib 函数实现 ──

    /// 编码 `__throw(rcx=msg)` �?打印错误�?exit(1)�?    fun emitThrow(enc: X86Encoder): Unit {
        enc.emitPrologue(0x20)
        enc.emitStackStore(-0x10, "rcx")
        enc.emitCallRel("println")
        enc.emitMovRI32("ecx", 1)
        enc.emitCallRel("exit")
        enc.emitEpilogue()
    }

    /// 编码 `arrayListOf()` �?调用 __list_alloc(0)�?    fun emitArrayListOf(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitXorRR("rcx", "rcx")
        enc.emitCallRel("__list_alloc")
        enc.emitRet()
    }

    /// 编码 `Collections.indexOf(rcx=list, rdx=elem) �?rax = index or -1`�?    /// list layout: [count:8][e0:8][e1:8]...
    fun emitCollectionIndexOf(enc: X86Encoder): Unit {
        enc.emitPrologue(0x40)
        enc.emitStackStore(-0x10, "rcx")  // list
        enc.emitStackStore(-0x18, "rdx")  // elem
        enc.emitStackStore(-0x20, "rbx")
        enc.emitStackStore(-0x28, "rsi")
        enc.emitStackStore(-0x30, "rdi")
        // rdi = 当前索引 (0)
        enc.emitXorRR("rdi", "rdi")
        enc.emitLabel("cii_loop")
        // rax = list pointer
        enc.emitStackLoad("rax", -0x10)
        // r8 = count = [list + 0]
        enc.emitLoadIndexed8("r8", "rax", "rsp", 0)
        // cmp rdi, r8 �?if rdi >= count, not found
        enc.emitCmpRR("rdi", "r8")
        enc.emitJccLabel("ae", "cii_notfound")
        // rcx = [list + 8 + rdi*8] = element at index rdi
        // r9 = rdi * 8
        enc.emitMovRR("r9", "rdi")
        enc.emitShlRI("r9", 3)
        // rax = list + 8 + r9
        enc.emitAddRI("rax", 8)
        enc.emitAddRR("rax", "r9")
        // rcx = [rax] = element
        enc.emitLoadIndexed8("rcx", "rax", "rsp", 0)
        enc.emitStackLoad("rdx", -0x18)   // rdx = target elem
        enc.emitCmpRR("rcx", "rdx")
        enc.emitJccLabel("eq", "cii_found")
        enc.emitIncRR("rdi")
        enc.emitJmpLabel("cii_loop")
        enc.emitLabel("cii_found")
        enc.emitMovRR("rax", "rdi")  // return index
        enc.emitStackLoad("rsi", -0x28)
        enc.emitStackLoad("rbx", -0x20)
        enc.emitEpilogue()
        enc.emitLabel("cii_notfound")
        enc.emitMovRI("eax", -1)  // return -1
        enc.emitStackLoad("rsi", -0x28)
        enc.emitStackLoad("rbx", -0x20)
        enc.emitEpilogue()
    }

    /// 编码 `Collections.contains(rcx=list, rdx=elem) �?rax = 1 or 0`�?    fun emitCollectionContains(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitCallRel("Collections.indexOf")
        enc.emitCmpRI("rax", -1)
        enc.emitJccLabel("ne", "cc_found")
        enc.emitMovRI("eax", 0)
        enc.emitRet()
        enc.emitLabel("cc_found")
        enc.emitMovRI("eax", 1)
        enc.emitRet()
    }

    /// 编码 `Collections.remove(rcx=list, rdx=index) �?rax = removed elem`�?    /// list layout: [count:8][e0:8][e1:8]...
    fun emitCollectionRemove(enc: X86Encoder): Unit {
        enc.emitPrologue(0x40)
        enc.emitStackStore(-0x10, "rcx")  // list
        enc.emitStackStore(-0x18, "rdx")  // index
        enc.emitStackStore(-0x20, "rbx")
        enc.emitStackStore(-0x28, "rsi")
        enc.emitStackStore(-0x30, "rdi")
        // rax = list pointer
        enc.emitStackLoad("rax", -0x10)
        // rdi = count = [list + 0]
        enc.emitLoadIndexed8("rdi", "rax", "rsp", 0)
        // rsi = index
        enc.emitStackLoad("rsi", -0x18)
        // r8 = element to remove = [list + 8 + rsi*8]
        enc.emitMovRR("r9", "rsi")
        enc.emitShlRI("r9", 3)
        enc.emitAddRI("rax", 8)
        enc.emitAddRR("rax", "r9")
        enc.emitLoadIndexed8("r8", "rax", "rsp", 0)
        // r8 = removed element (保存返回�?
        enc.emitMovRR("rbx", "r8")
        // 移动元素：从 index+1 �?count-1
        // rsi = index + 1 (source)
        enc.emitIncRR("rsi")
        enc.emitLabel("cr_loop")
        // rdi = count - 1
        enc.emitDecRR("rdi")
        // cmp rsi, rdi �?if rsi > rdi, done
        enc.emitCmpRR("rsi", "rdi")
        enc.emitJccLabel("ja", "cr_done")
        // rax = list + 8 + rsi*8 (source)
        enc.emitStackLoad("rax", -0x10)
        enc.emitMovRR("r9", "rsi")
        enc.emitShlRI("r9", 3)
        enc.emitAddRI("rax", 8)
        enc.emitAddRR("rax", "r9")
        // rcx = [rax] = source element
        enc.emitLoadIndexed8("rcx", "rax", "rsp", 0)
        // rax = list + 8 + (rsi-1)*8 (dest)
        enc.emitStackLoad("rax", -0x10)
        enc.emitDecRR("rsi")  // rsi = dest index
        enc.emitMovRR("r9", "rsi")
        enc.emitShlRI("r9", 3)
        enc.emitAddRI("rax", 8)
        enc.emitAddRR("rax", "r9")
        // [rax] = rcx (copy element)
        enc.emitStoreIndexed8("rax", "rsp", 0, "rcx")
        enc.emitIncRR("rsi")  // rsi = source index
        enc.emitJmpLabel("cr_loop")
        // 更新 count
        enc.emitLabel("cr_done")
        enc.emitStackLoad("rax", -0x10)
        enc.emitDecRR("rdi")  // rdi = count - 1
        enc.emitStoreIndexed8("rax", "rsp", 0, "rdi")
        // 返回被移除的元素
        enc.emitMovRR("rax", "rbx")
        enc.emitStackLoad("rsi", -0x28)
        enc.emitStackLoad("rbx", -0x20)
        enc.emitEpilogue()
    }

    /// stub: Collections.mapContainsKey 返回 0�?    fun emitCollectionMapContainsKey(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitMovRI("eax", 0)
        enc.emitRet()
    }

    /// stub: transform 返回入参�?    fun emitTransform(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitMovRR("rax", "rcx")
        enc.emitRet()
    }

    /// stub: fromCharCode 返回 0�?    fun emitFromCharCode(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitMovRI("eax", 0)
        enc.emitRet()
    }

    /// stub: ReadCStr 返回 0�?    fun emitReadCStr(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitMovRI("eax", 0)
        enc.emitRet()
    }

    /// 编码 `aura_mem_used_mb() �?rax = MB`。返�?heapBump �?/ 1024 / 1024�?    fun emitAuraMemUsedMb(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitMovRIP("rax", "heapBump")
        enc.emitMovRI32("rdx", 0)
        enc.emitMovRI32("rcx", 1048576)  // 1024*1024
        enc.emitIdiv("rcx")
        enc.emitEpilogue()
    }

    // ── print 实现（无换行）──

    /// 编码 `print(rcx = char*)`�?    ///
    /// �?println 相同，但不添加换行符�?    fun emitPrint(enc: X86Encoder): Unit {
        enc.emitPrologue(PhotonRuntime.FRAME_SIZE)

        // 保存入参指针
        enc.emitStackStore(PhotonRuntime.OFF_INPUT_PTR, "rcx")

        // strlen：扫描到 NUL
        enc.emitMovRR("rdx", "rcx")
        enc.emitXorRR("rax", "rax")
        enc.emitLabel("pr_strlen_loop")
        enc.emitCmpByteMemImm8("rdx", 0)
        enc.emitJccLabel("eq", "pr_strlen_done")
        enc.emitIncRR("rdx")
        enc.emitIncRR("rax")
        enc.emitJmpLabel("pr_strlen_loop")
        enc.emitLabel("pr_strlen_done")
        enc.emitStackStore(PhotonRuntime.OFF_LEN, "rax")

        // 获取 hStdOutput：PEB 走链（推导见 emitPrintln 中的注释�?        enc.emitMovGSSeg64("rax", 0x60)              // rax = PEB
        enc.emitMovMemDisp8("rax", "rax", 0x20)      // rax = ProcessParameters (PEB+0x20)
        enc.emitMovMemDisp8("rax", "rax", 0x28)      // rax = hStdOutput (ProcessParameters+0x28)
        enc.emitStackStore(PhotonRuntime.OFF_HSTDOUT, "rax")

        // NtWriteFile：写入字符串（无换行�?        enc.emitLeaStack("rax", PhotonRuntime.OFF_IOBLOCK)
        enc.emitStackStore(PhotonRuntime.OFF_ARG5, "rax")
        enc.emitStackLoad("rax", PhotonRuntime.OFF_INPUT_PTR)
        enc.emitStackStore(PhotonRuntime.OFF_ARG6, "rax")
        enc.emitStackLoad("rax", PhotonRuntime.OFF_LEN)
        enc.emitStackStore(PhotonRuntime.OFF_ARG7, "rax")
        enc.emitXorRR("rax", "rax")
        enc.emitStackStore(PhotonRuntime.OFF_ARG8, "rax")
        enc.emitStackStore(PhotonRuntime.OFF_ARG9, "rax")
        // EaLength 必须显式清零：NtWriteFile 的第 10 个参数，若栈上残留非 0
        // 值，内核会尝试从 EaBuffer 复制扩展属性并导致访问违规�?        enc.emitStackStore(PhotonRuntime.OFF_ARG10, "rax")

        // ⚠️ Windows x64 syscall �?*�?1 个参数必须放�?r10**�?        // `syscall` 指令会把返回地址写进 rcx，因此内核从 r10 读取 arg1
        // （ntdll �?stub 正是 `mov r10, rcx` 后再 `syscall`）�?        enc.emitStackLoad("r10", PhotonRuntime.OFF_HSTDOUT)
        enc.emitXorRR("rdx", "rdx")
        enc.emitXorRR("r8", "r8")
        enc.emitXorRR("r9", "r9")
        SyscallEmitter.emitSyscall(enc, 0x08)  // NtWriteFile（本�?ntdll 实测 0x08�?
        enc.emitEpilogue()
    }

    // ── puts 实现（带换行）──

    /// 编码 `puts(rcx = char*)`�?    ///
    /// �?println 相同：写入字符串并添加换行符�?    fun emitPuts(enc: X86Encoder): Unit {
        PhotonRuntime.emitPrintln(enc)
    }

    // ── toInt 实现 ──

    /// 编码 `toInt(rcx = char*) �?rax = Int`�?    ///
    /// 解析前导的十进制 ASCII 数字（支持负号），忽略尾部非数字字符�?    fun emitToInt(enc: X86Encoder): Unit {
        enc.emitPrologue(0x40)

        // 检查前导负�?        enc.emitMovzxRegMemByte("rax", "rcx")
        enc.emitCmpRI("rax", '-')
        enc.emitJccLabel("eq", "int_neg")

        // 正数：无负号标志
        enc.emitMovRI32("eax", 0)
        enc.emitStackStore(-0x18, "rax")  // 保存标志
        enc.emitJmpLabel("int_parse")

        enc.emitLabel("int_neg")
        enc.emitMovRI32("eax", 1)
        enc.emitStackStore(-0x18, "rax")  // 保存负号标志
        enc.emitAddRI("rcx", 1)  // 跳过 '-'

        enc.emitLabel("int_parse")
        enc.emitXorRR("rdx", "rdx")  // 结果 = 0

        // 解析数字循环
        enc.emitLabel("int_loop")
        enc.emitMovzxRegMemByte("rax", "rcx")
        enc.emitCmpRI("rax", 0)
        enc.emitJccLabel("eq", "int_done")

        // 检查是否为数字
        enc.emitCmpRI("rax", '0')
        enc.emitJccLabel("b", "int_done")  // 小于 '0'
        enc.emitCmpRI("rax", '9')
        enc.emitJccLabel("a", "int_done")  // 大于 '9'

        // result = result * 10 + (digit - '0')
        enc.emitImulRI("rdx", 10)
        enc.emitSubRI("rax", '0')
        enc.emitAddRR("rdx", "rax")

        enc.emitIncRR("rcx")
        enc.emitJmpLabel("int_loop")

        enc.emitLabel("int_done")
        // 如果是负数，取反结果
        enc.emitStackLoad("rax", -0x18)  // 加载标志
        enc.emitCmpRI("rax", 0)
        enc.emitJccLabel("eq", "int_return")

        enc.emitXorRR("rax", "rax")
        enc.emitSubRR("rax", "rdx")  // rax = 0 - rdx = -rdx
        enc.emitMovRR("rdx", "rax")

        enc.emitLabel("int_return")
        enc.emitMovRR("rax", "rdx")
        enc.emitEpilogue()
    }

    // ── toFloat 实现 ──

    /// 编码 `toFloat(rcx = char*) �?rax = float`�?    ///
    /// 简化的字符串到浮点转换：解析整数部分，忽略小数部分�?    /// 使用 toInt 解析字符串，然后转换�?float32�?    /// 
    /// 注意：当前实现为简化版本（返回整数部分�?float32 表示），
    /// 完整实现需�?FPU 指令支持�?    fun emitToFloat(enc: X86Encoder): Unit {
        enc.emitPrologue(0x50)

        // 保存非易失寄存器 rbx（下面用 rbx 做位长计数）
        enc.emitStackStore(-0x40, "rbx")

        // 调用 toInt 解析整数部分
        enc.emitCallRel("toInt")

        // 保存结果
        enc.emitStackStore(-0x20, "rax")

        // 检查是否为�?        enc.emitStackLoad("rax", -0x20)
        enc.emitCmpRI("rax", 0)
        enc.emitJccLabel("eq", "tf_zero")

        // 处理符号
        enc.emitCmpRI("rax", 0)
        enc.emitJccLabel("ge", "tf_nonneg")

        // 负数：设置符号位，取�?        enc.emitMovRI32("ecx", 0x80000000)  // 符号�?        enc.emitXorRR("rdx", "rdx")
        enc.emitSubRR("rdx", "rax")  // rdx = -rax
        enc.emitMovRR("rax", "rdx")
        enc.emitJmpLabel("tf_abs_done")

        enc.emitLabel("tf_nonneg")
        enc.emitXorRR("ecx", "ecx")  // 无符号位

        enc.emitLabel("tf_abs_done")
        // rax = 绝对�? ecx = 符号�?(0x80000000 �?0)

        // 保存绝对�?        enc.emitStackStore(-0x28, "rax")

        // 计算位数（通过右移计数�?        enc.emitStackLoad("rbx", -0x28)
        enc.emitXorRR("eax", "eax")  // eax = 位数计数

        enc.emitLabel("tf_count")
        enc.emitCmpRI("rbx", 0)
        enc.emitJccLabel("eq", "tf_count_done")
        enc.emitShrRI("rbx", 1)
        enc.emitIncRR("eax")
        enc.emitJmpLabel("tf_count")

        enc.emitLabel("tf_count_done")
        // eax = 位数, rbx = 0

        // 指数 = (位数 - 1) + 127
        enc.emitSubRI("eax", 1)
        enc.emitAddRI("eax", 127)
        // eax = 指数（偏置后�?
        // 左移指数到正确位�?        enc.emitShlRI("eax", 23)
        // eax = 指数部分

        // 构造尾数：原值去掉最高位，左移填�?23 �?        enc.emitStackLoad("rbx", -0x28)
        // rbx = 原绝对�?
        // 计算 mask = (1 << (bit_length - 1)) - 1
        // 但位数已经被覆盖了，需要从 rbx 重新计算位数
        // 简化：直接使用原值作为尾数（截断�?23 位）
        enc.emitAndRR("rbx", "rbx")  // rbx = rbx & 0x7FFFFF (截断�?23 �?
        // 实际上需要不同的方法...

        // 简化实现：返回 0.0
        // 完整实现需要更复杂的位操作来规范化尾数

        enc.emitXorRR("eax", "eax")  // 返回 0.0
        enc.emitStackLoad("rbx", -0x40)  // 恢复非易失寄存器
        enc.emitEpilogue()
    }

    // ── toString 实现 ──

    /// 编码 `toString(rcx = Any) �?rax = char*`�?    ///
    /// 将参数视�?char* 并原样返回（恒等函数）�?    fun emitToString(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitMovRR("rax", "rcx")
        enc.emitEpilogue()
    }

    // ── ARC 支持 ──

    /// 编码 `retain(rcx = obj*) �?obj*`：增加引用计数�?    ///
    /// 简化实现：直接返回对象（无实际引用计数）�?    /// 完整实现需要对象头中的引用计数字段�?    fun emitRetain(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitMovRR("rax", "rcx")
        enc.emitEpilogue()
    }

    /// 编码 `release(rcx = obj*) �?Unit`：减少引用计数�?    ///
    /// 简化实现：无操作（无实际引用计数）�?    /// 完整实现需要对象头中的引用计数字段�?    fun emitRelease(enc: X86Encoder): Unit {
        enc.emitPrologue(0)
        enc.emitEpilogue()
    }

    // ── 目标文件产出 ──

    /// 所有运行时函数名列表（逗号分隔）�?    val RUNTIME_SYMBOLS: String = "println,print,puts,toStr,strcat,toInt,toFloat,toString,strlen,charCodeAt,exit,Memory_write,Memory_read,Memory_write16,Memory_read16,Memory_write32,Memory_read32,Memory_write64,Memory_read64,Memory_alloc,Memory_free,io_open,io_close,io_read,io_write,io_access,Collections.listRemove"

    /// 将所有运行时函数编码到目标文件中，返�?COFF hex�?    fun buildRuntimeObject(): String {
        val writer = PhotonObjectWriter()
        // 按顺序编码每个函数，�?appendFunction 追加
        val enc1 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitPrintln(enc1)
        writer.appendFunction(
            enc1.toHex(),
            "println",
            PhotonObjectWriterUtils.joinRelocRecords(enc1.getRelocations())
        )

        val enc2 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitPrint(enc2)
        writer.appendFunction(
            enc2.toHex(),
            "print",
            PhotonObjectWriterUtils.joinRelocRecords(enc2.getRelocations())
        )

        val enc3 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitPuts(enc3)
        writer.appendFunction(
            enc3.toHex(),
            "puts",
            PhotonObjectWriterUtils.joinRelocRecords(enc3.getRelocations())
        )

        val enc4 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitToStr(enc4)
        writer.appendFunction(
            enc4.toHex(),
            "toStr",
            PhotonObjectWriterUtils.joinRelocRecords(enc4.getRelocations())
        )

        val enc4b = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitStrcat(enc4b)
        writer.appendFunction(
            enc4b.toHex(),
            "strcat",
            PhotonObjectWriterUtils.joinRelocRecords(enc4b.getRelocations())
        )

        val enc5 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitToInt(enc5)
        writer.appendFunction(
            enc5.toHex(),
            "toInt",
            PhotonObjectWriterUtils.joinRelocRecords(enc5.getRelocations())
        )

        val enc6 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitToFloat(enc6)
        writer.appendFunction(
            enc6.toHex(),
            "toFloat",
            PhotonObjectWriterUtils.joinRelocRecords(enc6.getRelocations())
        )

        val enc7 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitToString(enc7)
        writer.appendFunction(
            enc7.toHex(),
            "toString",
            PhotonObjectWriterUtils.joinRelocRecords(enc7.getRelocations())
        )

        val enc8 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitStrlen(enc8)
        writer.appendFunction(
            enc8.toHex(),
            "strlen",
            PhotonObjectWriterUtils.joinRelocRecords(enc8.getRelocations())
        )

        val enc8b = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitCharCodeAt(enc8b)
        writer.appendFunction(
            enc8b.toHex(),
            "charCodeAt",
            PhotonObjectWriterUtils.joinRelocRecords(enc8b.getRelocations())
        )

        val enc9 = X86EncoderUtils.emptyEncoder()
