        val encMr16 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitMemoryRead16(encMr16)
        writer.appendFunction(encMr16.toHex(), "Memory_read16", PhotonObjectWriterUtils.joinRelocRecords(encMr16.getRelocations()))
        val encMw32 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitMemoryWrite32(encMw32)
        writer.appendFunction(encMw32.toHex(), "Memory_write32", PhotonObjectWriterUtils.joinRelocRecords(encMw32.getRelocations()))
        val encMr32 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitMemoryRead32(encMr32)
        writer.appendFunction(encMr32.toHex(), "Memory_read32", PhotonObjectWriterUtils.joinRelocRecords(encMr32.getRelocations()))
        val encMw64 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitMemoryWrite64(encMw64)
        writer.appendFunction(encMw64.toHex(), "Memory_write64", PhotonObjectWriterUtils.joinRelocRecords(encMw64.getRelocations()))
        val encMr64 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitMemoryRead64(encMr64)
        writer.appendFunction(encMr64.toHex(), "Memory_read64", PhotonObjectWriterUtils.joinRelocRecords(encMr64.getRelocations()))
        val encMa = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitMemoryAlloc(encMa)
        writer.appendFunction(encMa.toHex(), "Memory_alloc", PhotonObjectWriterUtils.joinRelocRecords(encMa.getRelocations()))
        val encMf = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitMemoryFree(encMf)
        writer.appendFunction(encMf.toHex(), "Memory_free", PhotonObjectWriterUtils.joinRelocRecords(encMf.getRelocations()))
        for (symName in listOf("fork", "execve", "wait4")) {
            println("[rt] encoding stub " + symName)
            val encS = X86EncoderUtils.emptyEncoder()
            PhotonRuntime.emitStubMinus1(encS)
            writer.appendFunction(encS.toHex(), symName, PhotonObjectWriterUtils.joinRelocRecords(encS.getRelocations()))
            println("[rt] stub " + symName + " appended")
        }

        // Stdlib 函数
        val encThrow = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitThrow(encThrow)
        writer.appendFunction(encThrow.toHex(), "__throw", PhotonObjectWriterUtils.joinRelocRecords(encThrow.getRelocations()))
        val encAl = X86EncoderUtils.emptyEncoder()
