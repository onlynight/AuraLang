        writer.appendFunction(encCC.toHex(), "DagNode", PhotonObjectWriterUtils.joinRelocRecords(encCC.getRelocations()))
        encCC = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitClassConstructor(encCC, 64)
        writer.appendFunction(encCC.toHex(), "DagInstruction", PhotonObjectWriterUtils.joinRelocRecords(encCC.getRelocations()))
        encCC = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitClassConstructor(encCC, 128)
        writer.appendFunction(encCC.toHex(), "PeepholeOptimizer", PhotonObjectWriterUtils.joinRelocRecords(encCC.getRelocations()))
        encCC = X86EncoderUtils.emptyEncoder()
