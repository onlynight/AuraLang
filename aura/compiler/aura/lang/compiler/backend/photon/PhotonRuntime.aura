        writer.appendFunction(
            enc9.toHex(),
            "exit",
            PhotonObjectWriterUtils.joinRelocRecords(enc9.getRelocations())
        )

        val enc10 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitStreq(enc10)
        writer.appendFunction(
            enc10.toHex(),
            "streq",
            PhotonObjectWriterUtils.joinRelocRecords(enc10.getRelocations())
        )

        val enc11 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitListAlloc(enc11)
        writer.appendFunction(
            enc11.toHex(),
            "__list_alloc",
            PhotonObjectWriterUtils.joinRelocRecords(enc11.getRelocations())
        )

        val enc12 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitListSetAt(enc12)
        writer.appendFunction(
            enc12.toHex(),
            "__list_setat",
            PhotonObjectWriterUtils.joinRelocRecords(enc12.getRelocations())
        )

        val enc13 = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitListGet(enc13)
        writer.appendFunction(
            enc13.toHex(),
            "__list_get",
            PhotonObjectWriterUtils.joinRelocRecords(enc13.getRelocations())
        )

        // ── Step 4: 对象分配�?+ 类构造器 ──
        val encOA = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitObjectAlloc(encOA)
        writer.appendFunction(encOA.toHex(), "runtime_emitObjectAlloc", PhotonObjectWriterUtils.joinRelocRecords(encOA.getRelocations()))

        // 类构造器：直接硬编码（避�?VM arrayListOf+add bug �?substring 类型问题�?        var encCC = X86EncoderUtils.emptyEncoder()
        PhotonRuntime.emitClassConstructor(encCC, 32)
        writer.appendFunction(encCC.toHex(), "ArenaAllocator", PhotonObjectWriterUtils.joinRelocRecords(encCC.getRelocations()))
