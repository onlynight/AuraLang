// Test PhotonObjectWriter directly
package aura.lang.compiler.backend.photon
import aura.lang.std.String
import "PhotonObjectWriter.aura"
import "x86_64/X86Encoder.aura"

fun main() {
    val writer = PhotonObjectWriter()
    
    val encoder = X86Encoder()
    encoder.emitPrologue(48)
    encoder.emitLeaRIP("rcx", "@str.0")
    encoder.emitCallRel("println")
    encoder.emitXorRR("eax", "eax")
    encoder.emitEpilogue()
    
    val mcHex = encoder.toHex()
    val relocs = encoder.getRelocations()
    
    var relocHex: String = ""
    var i: Int = 0
    while (i < relocs.size) {
        if (relocHex != "") { relocHex = relocHex + ";;" }
        relocHex = relocHex + relocs[i]
        i = i + 1
    }
    
    val coffHex = writer.emitFromMachineCode(mcHex, relocHex, "hello", "main")
    
    // Check the symbol table
    // File header: 20 bytes = 40 hex chars
    // Section table: 44 * 2 = 88 bytes = 176 hex chars
    // String table: 4 + 7 + 8 + 1 = 20 bytes = 40 hex chars
    // Reloc table: 10 * 2 = 20 bytes = 40 hex chars
    // Total before symbols: 20 + 88 + 20 + 20 = 148 bytes = 296 hex chars
    
    println("COFF length: " + coffHex.length)
    
    // Symbol table starts at hex offset 296
    val symStart: Int = 296
    
    // Sym 0 (18 bytes = 36 hex chars)
    println("Sym 0 hex: " + coffHex.substring(symStart, symStart + 36))
    
    // Sym 1 (18 bytes = 36 hex chars)
    println("Sym 1 hex: " + coffHex.substring(symStart + 36, symStart + 72))
    
    // Check if the symbol table is at the correct offset
    // PointerToSymbolTable is at bytes 8-11 (hex 16-24)
    val ptrSym: String = coffHex.substring(16, 24)
    println("PointerToSymbolTable: " + ptrSym)
    
    // NumberOfSymbols is at bytes 12-15 (hex 24-32)
    val numSym: String = coffHex.substring(24, 32)
    println("NumberOfSymbols: " + numSym)
}
