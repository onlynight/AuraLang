// aura:///aura/lang/compiler/backend/RegisterAllocator.aura
package aura.lang.compiler.backend.photon
// ─────────────────────────────────────────────────────────────
// 寄存器分配（RegisterAllocator）— Phase D (任务 D.1)
//
// 乐观图着色（Optimistic Graph Coloring）：
//   1. DFS 遍历 DAG 节点
//   2. 为每个节点构建干扰列表
//   3. 分配空闲颜色（物理寄存器）
//   4. 无空闲颜色时尝试乐观重着色
//   5. 失败则溢出（spill）
//
// 颜色存储使用扁平字符串："nodeId|color\n" 格式（同 SsaBuilder varMap 模式）
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String

/// 寄存器分配器：乐观图着色算法。
class RegisterAllocator {

    /// 可用颜色（物理寄存器名）。
    private var availColors: String = "rax,rbx,rcx,rdx,rsi,rdi,r12,r13,r14,r15"

    /// 节点颜色表（扁平字符串 "nodeId|color\n"）。
    private var colorMap: String = ""

    /// 溢出节点列表（逗号分隔的 nodeId）。
    private var spilled: String = ""

    /// 调用栈（DFS 用，逗号分隔的 nodeId）。
    private var callStack: String = ""

    /// 溢出槽数量。
    private var spillSlots: Int = 0

    /// DAG 引用。
    private var dag: MachineDag = null

    init() {
        this.colorMap = ""
        this.spilled = ""
        this.callStack = ""
        this.spillSlots = 0
        this.dag = null
    }

    /// 主入口：执行寄存器分配。
    fun allocate(d: MachineDag): Unit {
        this.dag = d
        this.colorMap = ""
        this.spilled = ""
        this.callStack = ""
        this.spillSlots = 0

        // S1: 迭代分配（避免 VM 递归深度限制）
        // 每个节点独立分配颜色，不考虑依赖关系。
        // S2 阶段将引入完整的 DFS 遍历和依赖图处理。
        var i: Int = 0
        while (i < d.nodeCount) {
            val node: DagNode = d.nodeOf(i)
            if (node.kind == "Value" || node.kind == "Reg") {
                val interference: String = this.buildInterference(i)
                this.assignColor(i, interference)
            }
            i = i + 1
        }

        // S1.4: 将颜色回写到 DagNode.reg
        this.applyColors()
    }

    /// S1.4: 将颜色表中的寄存器名回写到 DagNode.reg 字段。
    fun applyColors(): Unit {
        if (this.colorMap == "") { return }
        var lineStart: Int = 0
        var pos: Int = 0
        val len: Int = this.colorMap.length
        while (pos <= len) {
            if (pos == len || this.colorMap[pos] == "\n") {
                val line: String = this.colorMap.substring(lineStart, pos)
                if (line != "") {
                    // 找 | 分隔符
                    var sepPos: Int = -1
                    var i: Int = 0
                    while (i < line.length) {
                        if (line[i] == "|") { sepPos = i; break }
                        i = i + 1
                    }
                    if (sepPos > 0) {
                        val nodeId: Int = strToInt(line.substring(0, sepPos))
                        val color: String = line.substring(sepPos + 1, line.length)
                        if (nodeId >= 0 && nodeId < this.dag.nodeCount) {
                            val node: DagNode = this.dag.nodeOf(nodeId)
                            node.reg = color
                        }
                    }
                }
                lineStart = pos + 1
            }
            pos = pos + 1
        }
    }

    /// DFS 遍历。
    private fun dfs(rootNode: Int): Unit {
        if (this.callStackContains(rootNode)) {
            return
        }
        this.callStackPush(rootNode)

        val node: DagNode = this.dag.nodeOf(rootNode)
        val interference: String = this.buildInterference(rootNode)
        val color: String = this.assignColor(rootNode, interference)

        // 递归处理子节点
        if (node.kind == "Value" || node.kind == "Reg") {
            val args: List<String> = this.splitComma(node.args)
            var j: Int = 0
            while (j < args.size) {
                val arg: Int = strToInt(args[j])
                if (arg >= 0) {
                    this.dfs(arg)
                }
                j = j + 1
            }
        }

        this.callStackPop()
    }

    /// 分配颜色（寄存器）。
    private fun assignColor(nodeId: Int, interference: String): String {
        val used: String = this.getUsedColors(interference)
        val free: String = this.getFreeColor(used)
        if (free != "") {
            this.colorPut(nodeId, free)
            return free
        }
        if (this.tryOptimisticRecolor(nodeId, interference)) {
            return this.colorGet(nodeId)
        }
        this.spill(nodeId)
        return "spill_slot_" + toStr(this.spillSlots)
    }

    /// 构建干扰列表。
    private fun buildInterference(nodeId: Int): String {
        var result: String = ""
        val node: DagNode = this.dag.nodeOf(nodeId)
        val args: List<String> = this.splitComma(node.args)
        var i: Int = 0
        while (i < args.size) {
            val arg: Int = strToInt(args[i])
            if (arg >= 0) {
                val argColor: String = this.colorGet(arg)
                if (argColor != "") {
                    if (result != "") { result = result + "," }
                    result = result + argColor
                }
            }
            i = i + 1
        }
        return result
    }

    /// 获取已使用的颜色集合。
    private fun getUsedColors(interference: String): String {
        return interference
    }

    /// 查找空闲颜色。
    private fun getFreeColor(used: String): String {
        val avail: List<String> = this.splitComma(this.availColors)
        val usedList: List<String> = this.splitComma(used)
        var i: Int = 0
        while (i < avail.size) {
            var conflict: Boolean = false
            var j: Int = 0
            while (j < usedList.size) {
                if (avail[i] == usedList[j]) {
                    conflict = true
                    break
                }
                j = j + 1
            }
            if (!conflict) {
                return avail[i]
            }
            i = i + 1
        }
        return ""
    }

    /// 乐观重着色。
    private fun tryOptimisticRecolor(nodeId: Int, interference: String): Boolean {
        val avail: List<String> = this.splitComma(this.availColors)
        val usedList: List<String> = this.splitComma(interference)
        var i: Int = 0
        while (i < usedList.size) {
            val conflictColor: String = usedList[i]
            val conflictingNode: Int = this.findConflictingNode(nodeId, conflictColor)
            if (conflictingNode >= 0) {
                this.spill(conflictingNode)
                val used: String = this.getUsedColors(this.buildInterference(nodeId))
                val free: String = this.getFreeColor(used)
                if (free != "") {
                    this.colorPut(nodeId, free)
                    return true
                }
            }
            i = i + 1
        }
        return false
    }

    /// 查找使用指定颜色的冲突节点。
    private fun findConflictingNode(nodeId: Int, color: String): Int {
        val node: DagNode = this.dag.nodeOf(nodeId)
        val args: List<String> = this.splitComma(node.args)
        var i: Int = 0
        while (i < args.size) {
            val arg: Int = strToInt(args[i])
            if (arg >= 0) {
                val argColor: String = this.colorGet(arg)
                if (argColor == color) {
                    return arg
                }
            }
            i = i + 1
        }
        return -1
    }

    /// 溢出节点。
    private fun spill(nodeId: Int): Unit {
        if (this.spilled == "") {
            this.spilled = toStr(nodeId)
        } else {
            this.spilled = this.spilled + "," + toStr(nodeId)
        }
        this.spillSlots = this.spillSlots + 1
    }

    // ── 字符串工具（替代 String.split，VM 不支持）──

    /// 按逗号分割字符串。
    private fun splitComma(text: String): List<String> {
        val out: List<String> = arrayListOf<String>()
        if (text == "") { return out }
        var start: Int = 0
        var i: Int = 0
        val len: Int = text.length
        while (i < len) {
            if (text[i] == ",") {
                out.add(text.substring(start, i))
                start = i + 1
            }
            i = i + 1
        }
        out.add(text.substring(start, len))
        return out
    }

    /// 按换行符分割字符串。
    private fun splitNewline(text: String): List<String> {
        val out: List<String> = arrayListOf<String>()
        if (text == "") { return out }
        var start: Int = 0
        var i: Int = 0
        val len: Int = text.length
        while (i < len) {
            if (text[i] == "\n") {
                out.add(text.substring(start, i))
                start = i + 1
            }
            i = i + 1
        }
        out.add(text.substring(start, len))
        return out
    }

    // ── 颜色表操作（扁平字符串）──

    /// 存储颜色。
    private fun colorPut(nodeId: Int, color: String): Unit {
        this.colorRemove(nodeId)
        if (this.colorMap == "") {
            this.colorMap = toStr(nodeId) + "|" + color + "\n"
        } else if (this.colorMap.endsWith("\n")) {
            this.colorMap = this.colorMap + toStr(nodeId) + "|" + color + "\n"
        } else {
            this.colorMap = this.colorMap + "\n" + toStr(nodeId) + "|" + color + "\n"
        }
    }

    /// 读取颜色。
    private fun colorGet(nodeId: Int): String {
        val targetKey: String = toStr(nodeId) + "|"
        var lineStart: Int = 0
        var pos: Int = 0
        val len: Int = this.colorMap.length
        while (pos <= len) {
            if (pos == len || this.colorMap[pos] == "\n") {
                val line: String = this.colorMap.substring(lineStart, pos)
                if (line.length > targetKey.length && line.startsWith(targetKey)) {
                    return line.substring(targetKey.length, line.length)
                }
                lineStart = pos + 1
            }
            pos = pos + 1
        }
        return ""
    }

    /// 删除颜色。
    private fun colorRemove(nodeId: Int): Unit {
        if (this.colorMap == "") { return }
        val targetKey: String = toStr(nodeId) + "|"
        var lineStart: Int = 0
        var pos: Int = 0
        var result: String = ""
        val len: Int = this.colorMap.length
        while (pos <= len) {
            if (pos == len || this.colorMap[pos] == "\n") {
                val line: String = this.colorMap.substring(lineStart, pos)
                if (line != "" && line.length > targetKey.length && !line.startsWith(targetKey)) {
                    if (result != "") { result = result + "\n" }
                    result = result + line
                }
                lineStart = pos + 1
            }
            pos = pos + 1
        }
        this.colorMap = result
    }

    // ── 调用栈操作 ──

    private fun callStackContains(nodeId: Int): Boolean {
        if (this.callStack == "") { return false }
        val target: String = "," + toStr(nodeId)
        val withBoundaries: String = "," + this.callStack
        var i: Int = 0
        val tlen: Int = target.length
        val len: Int = withBoundaries.length
        while (i <= len - tlen) {
            if (withBoundaries.substring(i, i + tlen) == target) {
                return true
            }
            i = i + 1
        }
        return false
    }

    private fun callStackPush(nodeId: Int): Unit {
        if (this.callStack == "") {
            this.callStack = toStr(nodeId)
        } else {
            this.callStack = this.callStack + "," + toStr(nodeId)
        }
    }

    private fun callStackPop(): Unit {
        if (this.callStack == "") { return }
        var lastComma: Int = -1
        var i: Int = this.callStack.length - 1
        while (i >= 0) {
            if (this.callStack[i] == ",") { lastComma = i; break }
            i = i - 1
        }
        if (lastComma < 0) {
            this.callStack = ""
        } else {
            this.callStack = this.callStack.substring(0, lastComma)
        }
    }

    // ── 查询 ──

    fun isReservedReg(reg: String): Boolean {
        return reg == "rbp" || reg == "rsp"
    }

    fun getSpillSlots(): Int {
        return this.spillSlots
    }

    fun isSpilled(nodeId: Int): Boolean {
        val color: String = this.colorGet(nodeId)
        return color != "" && color.startsWith("spill_slot_")
    }

    fun getColor(nodeId: Int): String {
        return this.colorGet(nodeId)
    }

    fun getSpilledNodes(): String {
        return this.spilled
    }

    fun getAvailableRegisters(): String {
        return this.availColors
    }

    fun getCallStack(): String {
        return this.callStack
    }

    // ── 工具 ──

    private fun strToInt(text: String): Int {
        if (text == "") { return 0 }
        val len: Int = text.length
        var total: Int = 0
        var i: Int = 0
        var neg: Boolean = false
        if (len > 0 && text.charCodeAt(0) == 45) { neg = true; i = 1 }
        while (i < len) {
            val digit: Int = text.charCodeAt(i) - 48
            if (digit >= 0 && digit <= 9) { total = total * 10 + digit }
            i = i + 1
        }
        if (neg) { return -total }
        return total
    }

    private fun toStr(n: Int): String {
        if (n == 0) { return "0" }
        var neg: Boolean = false
        if (n < 0) { neg = true; n = -n }
        var result: String = ""
        while (n > 0) {
            val digit: Int = n % 10
            val digitStr: String = this.digitChar(digit)
            result = digitStr + result
            n = n / 10
        }
        if (neg) { result = "-" + result }
        return result
    }

    /// 将单个数字转为字符串。
    private fun digitChar(d: Int): String {
        if (d == 0) { return "0" }
        if (d == 1) { return "1" }
        if (d == 2) { return "2" }
        if (d == 3) { return "3" }
        if (d == 4) { return "4" }
        if (d == 5) { return "5" }
        if (d == 6) { return "6" }
        if (d == 7) { return "7" }
        if (d == 8) { return "8" }
        if (d == 9) { return "9" }
        return ""
    }
}

object RegisterAllocatorUtils {
    fun emptyAllocator(): RegisterAllocator {
        return RegisterAllocator()
    }
}
