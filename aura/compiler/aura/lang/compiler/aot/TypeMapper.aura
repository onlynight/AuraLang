// aura:///aura/lang/compiler/aot/TypeMapper.aura
package aura.lang.compiler.aot
// ─────────────────────────────────────────────────────────────
// 类型映射（Aura Type → LLVM IR 类型字符串）— Phase 6 (任务 6.1)
//
// 对应 Rust `compiler/src/codegen/aot/types.rs`。
//
// 因为采用文本 LLVM IR（而非 inkwell 绑定），映射结果是 `String`，
// 直接拼入 LLVM IR 文本，避免编译期对 LLVM C API 的依赖。
//
// 设计原则：
//   - 基本类型（Int/Float/Boolean/…）→ 对应 LLVM 标量类型
//   - String 可配置为 `{ i8*, i64 }`（长度感知）或裸 `i8*`
//   - 指针 → `ptr`（LLVM 13+ 不透明指针）
//   - 用户自定义类型 → `%struct.<Name>` 占位符
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String

/// 类型映射工具集（纯函数辅助）。
object TypeMapperUtils {

    /// 去掉泛型实参：`HashMap<Int, Int>` → `HashMap`（无 `<` 时原样返回）。
    ///
    /// AOT 不做单态化：泛型实例擦除到基类布局（与 Rust 侧一致）。保留实参会产生
    /// 没有任何 `= type {…}` 定义的合成类型（如 `HashMap_Int_Int_`），llc 报
    /// `use of undefined type named 'struct.HashMap_Int_Int_'`。
    fun stripGenericArgs(ty: String): String {
        var i: Int = 0
        while (i < ty.length) {
            if (aotSlice(ty, i, 1) == "<") {
                return trimSpaces(aotSlice(ty, 0, i))
            }
            i = i + 1
        }
        return ty
    }

    /// LLVM IR 标识符允许字符（其余替换为 `_`）。
    fun tmAllowedChars(): String {
        return "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
    }

    /// 将标识符中 LLVM IR 不允许的字符替换为下划线。
    ///
    /// 性能：绝大多数标识符本来已合法——先扫描确认，命中即**原串返回**（零分配）。
    /// 旧实现无条件逐字符 `out = out + c`：长度为 L 的名字产生 L 次分配 + O(L²)
    /// 复制，而 sanitizeLlvm 是发射期最热调用之一（函数名/变量名/类型名都要过一遍）。
    fun sanitizeLlvm(s: String): String {
        val allowed: String = tmAllowedChars()
        var len: Int = s.length
        var i: Int = 0
        var rebuilding: Boolean = false
        var out: String = ""
        while (i < len) {
            val c: String = aotSlice(s, i, 1)
            if (allowed.indexOf(c) >= 0) {
                if (rebuilding) {
                    out = out + c
                }
            } else {
                if (!rebuilding) {
                    out = s.substring(0, i)
                    rebuilding = true
                }
                out = out + "_"
            }
            i = i + 1
        }
        if (!rebuilding) {
            return s
        } else {
            return out
        }
    }

    /// 判断一个 LLVM 类型字符串是否为标量类型。
    fun llvmIsScalar(ty: String): Boolean {
        if (ty == "i1" || ty == "i8" || ty == "i16" || ty == "i32" || ty == "i64" || ty == "i128") {
            return true
        } else if (ty == "float" || ty == "double") {
            return true
        } else {
            return false
        }
    }

    /// 构造函数式入口（对应 Rust `TypeMapper::new(bool)`）。
    fun newTypeMapper(stringAsStruct: Boolean): TypeMapper {
        val tm = TypeMapper()
        tm.stringAsStruct = stringAsStruct
        return tm
    }
}

/// 类型映射器。
class TypeMapper {

    /// 是否将 `String` 表示为 `{ i8*, i64 }`（长度感知字符串）。
    var stringAsStruct: Boolean = true

    init() {
        this.stringAsStruct = true
    }

    /// 将类型名映射为 LLVM IR 类型字符串。
    fun map(ty: String): String {
        if (ty == "") { return "" }
        else if (ty == "Int") { return "i32" }
        else if (ty == "Long") { return "i64" }
        else if (ty == "Short") { return "i16" }
        else if (ty == "Byte" || ty == "U8") { return "i8" }
        else if (ty == "Float") { return "float" }
        else if (ty == "Double") { return "double" }
        else if (ty == "Boolean" || ty == "Bool") { return "i1" }
        else if (ty == "Char") { return "i16" }
        else if (ty == "Unit" || ty == "Void") { return "" }
        else if (ty == "String") {
            if (this.stringAsStruct) {
                return "{ i8*, i64 }"
            } else {
                return "i8*"
            }
        }
        else if (ty == "Any" || ty == "Nothing") { return "i8*" }
        else if (ty == "CString" || ty == "CStr" || ty == "Handle") { return "i8*" }
        // 注意：**不要**给具体类名做硬编码映射。此前这里把类型名 `Color` 一律
        // 映射为 `{ i8, i8, i8, i8 }`（RGBA 字节），而用户源码里
        // `value class Color(val r: Int, val g: Int, val b: Int)` 的真实布局是
        // `%struct.Color = { i32, i32, i32 }` → 方法签名按值 4 字节、方法体按
        // `%struct.Color*` 取字段，llc 报
        // `'%var.N' defined with type '{ i8, i8, i8, i8 }' but expected 'ptr'`。
        // 让类名走结构体/指针的通用映射即可。
        else if (ty == "List" || ty == "Map" || ty == "Set" || ty == "Value" ||
            ty == "Iterator" || ty == "Closure" || ty == "ArrayList"
            || ty == "HashSet" || ty == "LinkedList") {
            return "i8*"
        }
        else if (ty.startsWith("List<") || ty.startsWith("Map<") ||
            ty.startsWith("Set<") || ty.startsWith("Array<")
            || ty.startsWith("ArrayList<") || ty.startsWith("HashSet<")
            || ty.startsWith("LinkedList<")) {
            // 集合实现的类型名同样按**句柄 `i8*`** 表示：
            // 构造侧（`ArrayList()` / `mutableListOf()`）本来就发射成
            // `aura_lang_std_Collections_emptyList()`（句柄），若类型侧仍当成
            // `%struct.ArrayList*`，成员访问会拿句柄做结构体 `getelementptr`
            // → 读到垃圾指针并崩溃（实测 `HashMap` 建桶时 0xC0000005）。
            return "i8*"
        }
        else if (ty.startsWith("Pointer<")) { return "ptr" }
        else if (ty.startsWith("(")) {
            // 函数类型 = 闭包环境指针（env：字段 0 = 函数指针）。
            //
            // 必须与 `Emit.aura` 的闭包表示一致：`emitLambda` 分配 `malloc(8)`
            // 得到 `i8*`，返回它作为闭包值；调用点 `emitIndirectCall` 也从
            // `i8*` 里取出函数指针。此处若返回不透明 `ptr`，则：
            //   * `define ptr @makeAdder()` 里 `ret ptr <i8* 值>` 非法 IR
            //     （`inttoptr … to ptr` 不被词法器接受）；
            //   * 形参 `f: (Int) -> Int` 变 `ptr`，`store ptr %env` 与
            //     `inttoptr i64` 互斥，lambda 调用点生成非法 IR。
            // 统一为 `i8*` 后闭包的 env 指针在 alloca / store / call / ret
            // 各处类型一致，无需任何隐式转换。
            return "i8*"
        }
        else if (this.isGenericTypeParam(ty)) {
            // 泛型类形参（`class ArrayList<T>` 的 `T`）擦除为句柄 `i8*`。
            //
            // 所有集合实现已统一按句柄表示（见上方 `List<` / `ArrayList<` 分支），
            // 若把 `T` 映射成 `%struct.T*`，则 `fun filter(predicate: (T) -> Boolean)`
            // 的签名会声明 `%struct.T_*`——没有任何 `= type {…}` 定义的合成类型，
            // llc 报 `use of undefined type named 'struct.T_'`（整个模块编译失败）。
            // 擦除到 `i8*` 后与集合的实际表示一致，调用点实参（`String_charAt`
            // → `i8*`、标量装箱句柄 → `i8*`）无需转换即可对齐。
            return "i8*"
        }
        else {
            // 用户自定义结构体 / 类：实例统一以**指针**表示（Phase 6.5.1）。
            // 与 `emitNewStruct`（返回实例指针）、字段访问（gep on `%struct.X*`）、
            // 以及 `inferType`（构造结果为指针）保持一致；同时满足 Aura 的引用语义
            //（类实例按引用共享，而非按值拷贝 —— AOT 按值拷贝会丢失字段修改）。
            //
            // 泛型实参**擦除**到基类：`HashMap<Int, Int>` → `%struct.HashMap*`、
            // `ArrayList<K>` → `%struct.ArrayList*`。与 Rust 侧一致
            //（Rust 侧 `%struct.HashMap = type {%struct.ArrayList*, …}`，方法接收者
            // 直接是 `i8*`）。若保留实参（`HashMap_Int_Int_` / `ArrayList_K_`），
            // 这些类型没有任何 `= type {…}` 定义 → llc 报
            // `use of undefined type named 'struct.HashMap_Int_Int_'`。
            val base: String = TypeMapperUtils.stripGenericArgs(ty)
            return "%struct." + TypeMapperUtils.sanitizeLlvm(base) + "*"
        }
    }

    /// 是否为泛型类型形参名（单个大写字母：`T` / `K` / `V` / `U` …）。
    ///
    /// Aura 的泛型类形参约定用单个大写字母命名（`class ArrayList<T>`、
    /// `class HashMap<K, V>`）。所有集合实现都按句柄 `i8*` 表示，故类型形参
    /// 也必须擦除到 `i8*`——见 `map` 的调用点注释。
    fun isGenericTypeParam(ty: String): Boolean {
        if (ty.length != 1) {
            return false
        }
        val c: Int = ty.charCodeAt(0)
        return c >= 65 && c <= 90
    }

    /// 可空类型映射：标量包装为 `{ <inner>, i1 }`，其余保留内部类型。
    fun mapNullable(inner: String): String {
        val innerTy: String = this.map(inner)
        if (TypeMapperUtils.llvmIsScalar(innerTy)) {
            return "{ " + innerTy + ", i1 }"
        } else {
            return innerTy
        }
    }

    /// 函数类型描述字符串（供函数指针声明）。
    fun fnType(ret: String, paramsCsv: String, isVararg: Boolean): String {
        var retStr: String = this.map(ret)
        if (retStr == "") {
            retStr = "void"
        }
        var paramsStr: String = "void"
        if (paramsCsv != "") {
            paramsStr = ""
            var n: Int = aotCsvCount(paramsCsv)
            var i: Int = 0
            while (i < n) {
                if (i > 0) {
                    paramsStr = paramsStr + ", "
                }
                paramsStr = paramsStr + this.map(aotFieldAt(paramsCsv, i, ","))
                i = i + 1
            }
        }
        if (isVararg) {
            return retStr + "( " + paramsStr + ", ... )"
        } else {
            return retStr + "( " + paramsStr + " )"
        }
    }
}
