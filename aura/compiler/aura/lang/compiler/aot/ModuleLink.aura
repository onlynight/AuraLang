// aura:///aura/lang/compiler/aot/ModuleLink.aura
package aura.lang.compiler.aot
// ─────────────────────────────────────────────────────────────
// 模块链接（多文件 → 单一 HIR）— 纯 Aura 化迁移 · Phase 6.5.10 前置
//
// Aura 侧 AOT 发射器（Emit.aura）只接收**一个** HIR。要让「Aura 编写的编译器」
// 自身被 AOT（6.5.10），必须先把入口文件及其递归 `import` 的全部模块解析、
// 降级并合并为同一个 HIR。本模块即该「模块链接器」。
//
// 解析规则（与仓库布局一致）：
//   * 相对文件导入（含 `/` 或以 `.aura` 结尾）：相对当前文件目录解析；
//   * 点分包名 `aura.lang.compiler.aot.Emit`：依次尝试
//       aura/compiler/<包路径>.aura
//       aura/core/<包路径>.aura
//       <包路径>.aura
//   * `a.b.*`（通配）与 `a.b.{C,D}`（花括号）展开为具体模块。
//
// 去重：以规范化后的完整路径为准，同一模块只加载一次。
//
// 边界：本模块只做「文件图 → 合并 HIR」；名称冲突依赖仓库既有的
// 前缀约定（hir*/ast*/prs*/aot*/ce*/mir* …）避免。
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String
import aura.lang.std.FileSystem
import aura.lang.compiler.lexer.Span
import aura.lang.compiler.parser.Parser
import aura.lang.compiler.hir.Hir
import aura.lang.compiler.aot.AotUtil

/// 模块链接器：把入口文件及其递归 `import` 合并为单一 HIR。
class AotModuleLinker {

    /// 输出 HIR。
    var hir: Hir = Hir()

    /// 已加载的规范化路径（换行分隔；String contains 比 ArrayList.contains 更快）。
    var seen: String = ""

    /// 执行模块链接。
    var loader: HirLowerer = HirLowerer()

    /// 未找到的导入（换行分隔；供诊断）。
    var missing: String = ""

    /// 文件内容缓存（预加载后供 loadPath 复用，避免重复 I/O）。
    ///
    /// 编码：每条记录 = `规范化路径\n内容长度\n内容`，按读取顺序拼接。
    /// **刻意不用 `HashMap`**：Aura 自举编译器对自身做 AOT 时，泛型集合的
    /// 生成代码尚不可靠 —— `HashMap()` 构造即崩溃（EXIT 0xC0000005），
    /// 链接阶段直接从「读文件」变成段错误，自举编译无法推进。
    /// 扁平字符串编码只用到已充分验证的 String/Int 操作，规避该后端缺陷，
    /// 同时保留「一次性预读、后续复用」的优化意图。
    var cacheBlob: String = ""

    init() {
        this.hir = Hir()
        this.seen = ""
        this.loader = HirLowerer()
        this.missing = ""
        this.cacheBlob = ""
    }

    /// 入口文件 → 合并 HIR（含递归 import）。
    fun link(entryPath: String): Hir {
        this.hir = Hir()
        this.seen = ""
        this.missing = ""
        this.loader = HirLowerer()
        this.loader.useHir(this.hir)
        this.cacheBlob = ""

        // B1: 预加载 std 模块文件到缓存（消除重复 I/O）
        val stdMods: String = ModuleLinkUtils.essentialStdModules()
        this.preloadCache(stdMods)

        // 入口文件 + 递归 import + 自动包含 std 模块
        var kids: String = this.loadPath(entryPath)
        var si: Int = 0
        while (si < aotLineCount(stdMods)) {
            val sp: String = aotLineAt(stdMods, si)
            val dep: String = this.loadPath(sp)
            if (dep != "") {
                kids = ModuleLinkUtils.appendKids(kids, dep)
            }
            si = si + 1
        }
        this.hir.rootId = this.hir.add("HirProgram", "", "", Span(0, 0, 1, 1, 1, 1),
            this.loader.synthesizeMainInKids(kids, Span(0, 0, 1, 1, 1, 1)))
        return this.hir
    }

    /// B1: 预加载多个文件内容到 fileCache（顺序读取）。
    ///
    /// 将已知路径的文件内容预读入内存，避免 loadPath 中的重复 I/O。
    ///
    /// **为什么这里是顺序读取（而不是 Thread.spawn 并行）**：
    /// 并行版本把「待读路径 / 读取结果 / 线程 id」放在 `object ParallelState`
    /// 的单例字段里，由 worker 线程按唯一索引写入。但 **AOT 后端目前不支持
    /// `object` 单例字段访问**：
    ///   1. `ParallelState.paths` 会被发射成**每次调用都新建一个 `ArrayList` 对象**
    ///      （而非读取单例全局的字段），所以写入的根本不是同一份数据；
    ///   2. `ArrayList` 实例又会被当作**裸集合句柄**（`AuraDynList*`）传给
    ///      `Collections.listAppend`，而 `%struct.ArrayList`（16 字节：data + size）
    ///      与 `AuraDynList`（24 字节：len + cap + items）布局不同 —— 读 `items`
    ///      会读到分配块之外的野值（实测为 MSVC 堆的 `0xABAB…` 填充），
    ///      随即在 `realloc` 中段错误（0xC0000005）。
    /// 这正是「自举编译器编译成功、一运行就崩」的直接根因。
    ///
    /// 顺序读取只依赖 `AotModuleLinker` 自身的实例字段（Class 实例字段在 AOT 下
    /// 语义正确），因此对两个后端都成立。实测并行版与顺序版自举耗时相同
    /// （均约 13.2s：40+ 模块的读取并非瓶颈），故本改动无性能回退。
    fun preloadCache(paths: String): Unit {
        var i: Int = 0
        val pathCount: Int = aotLineCount(paths)
        while (i < pathCount) {
            val p: String = aotLineAt(paths, i)
            val norm: String = ModuleLinkUtils.normalizePath(p)
            if (norm != "" && FileSystem.exists(norm) && this.cacheGet(norm) == "") {
                val content: String = FileSystem.readText(norm)
                this.cacheBlob = this.cacheBlob + norm + "\n" + toStr(content.length) + "\n" + content
            }
            i = i + 1
        }
    }

    /// 从扁平缓存取文件内容（未命中返回 ""）。
    ///
    /// 记录布局：`路径\n内容长度\n内容`；按记录顺序线性扫描（缓存条目数为
    /// std 模块数量级，扫描开销可忽略）。
    fun cacheGet(path: String): String {
        var pos: Int = 0
        while (pos < this.cacheBlob.length) {
            val nl1: Int = this.cacheLineEnd(pos)
            if (nl1 < 0) {
                return ""
            }
            val key: String = aotSlice(this.cacheBlob, pos, nl1 - pos)
            val lenStart: Int = nl1 + 1
            val nl2: Int = this.cacheLineEnd(lenStart)
            if (nl2 < 0) {
                return ""
            }
            val len: Int = aotToInt(aotSlice(this.cacheBlob, lenStart, nl2 - lenStart))
            val bodyStart: Int = nl2 + 1
            if (key == path) {
                return aotSlice(this.cacheBlob, bodyStart, len)
            }
            pos = bodyStart + len
        }
        return ""
    }

    /// 自 `from` 起第一个换行的下标（无则返回 -1，供缓存解码用）。
    fun cacheLineEnd(from: Int): Int {
        if (from >= this.cacheBlob.length) {
            return -1
        }
        val rest: String = aotSlice(this.cacheBlob, from, this.cacheBlob.length - from)
        val rel: Int = aotIndexOfSub(rest, "\n")
        if (rel < 0) {
            return -1
        }
        return from + rel
    }

    /// 已加载的模块数。
    fun loadedCount(): Int {
        return aotLineCount(this.seen)
    }

    /// 加载单个文件（去重）→ 其递归依赖 + 本文件顶层声明的 HIR kids 串。
    fun loadPath(path: String): String {
        val norm: String = ModuleLinkUtils.normalizePath(path)
        if (norm == "") {
            return hirNoKids()
        }
        if (aotListContains(this.seen, norm)) {
            return hirNoKids()
        }
        if (!FileSystem.exists(norm)) {
            this.missing = this.missing + norm + "\n"
            return hirNoKids()
        }
        this.seen = this.seen + norm + "\n"

        // B1: 优先从缓存读取（预加载阶段已填充），避免重复 I/O
        val source: String
        val cached: String = this.cacheGet(norm)
        if (cached != "") {
            source = cached
        } else {
            source = FileSystem.readText(norm)
        }
        val p: Parser = Parser(source)
        p.parseProgram()
        // 注意：不能直接 `p.ast.kindOf(...)` —— VM 对「字段访问得到的对象再调方法」
        // 会错乱 this 绑定（既有缺陷）。必须先取局部变量。
        val ast: Ast = p.ast

        val dir: String = ModuleLinkUtils.dirOf(norm)
        // 分段收集、最后一次归并：`out = appendKids(out, …)` 在整棵导入树上是
        // O(n²) 复制，且 AOT 运行时没有 GC —— 链接阶段就能吃掉数 GB 内存。
        var parts: List<String> = arrayListOf<String>()
        // 1) 先展开 import（被依赖模块的声明在前）
        var i: Int = 0
        while (i < ast.count) {
            if (ast.kindOf(i) == "Import") {
                val targets: String = this.resolveImports(ast.textOf(i), dir)
                var j: Int = 0
                val tn: Int = aotLineCount(targets)
                while (j < tn) {
                    val dep: String = this.loadPath(aotLineAt(targets, j))
                    if (dep != "") {
                        parts.add(dep)
                    }
                    j = j + 1
                }
            }
            i = i + 1
        }
        // 2) 再降级本文件顶层声明
        val own: String = this.loader.lowerTopLevel(ast)
        if (own != "") {
            parts.add(own)
        }
        return joinPieces(parts, ",")
    }

    /// 把一条 import 文本解析为若干「完整文件路径」（换行分隔）。
    fun resolveImports(imp: String, baseDir: String): String {
        val raw: String = trimSpaces(imp)
        if (raw == "") {
            return ""
        }
        // 花括号形式：a.b.{C,D}
        val brace: Int = aotIndexOfSub(raw, ".{")
        if (brace > 0) {
            val prefix: String = aotSlice(raw, 0, brace)
            val close: Int = aotIndexOfSub(raw, "}")
            var body: String = raw
            if (close > brace) {
                body = aotSlice(raw, brace + 2, close - brace - 2)
            }
            var out: String = ""
            var i: Int = 0
            while (true) {
                val item: String = trimSpaces(aotFieldAt(body, i, ","))
                if (item != "") {
                    val full: String = this.resolveOne(prefix + "." + item, baseDir)
                    if (full != "") {
                        out = out + full + "\n"
                    }
                }
                i = i + 1
                if (i >= aotCsvCount(body)) {
                    break
                }
            }
            return out
        }
        // 通配形式：a.b.*
        var dotted: String = raw
        if (dotted.endsWith(".*")) {
            dotted = aotSlice(dotted, 0, dotted.length - 2)
        }
        val full2: String = this.resolveOne(dotted, baseDir)
        if (full2 == "") {
            return ""
        }
        return full2 + "\n"
    }

    /// 解析单条导入为完整路径（未命中返回 ""）。
    fun resolveOne(imp: String, baseDir: String): String {
        if (imp == "") {
            return ""
        }
        // 相对文件导入
        if (imp.endsWith(".aura") || imp.startsWith(".")) {
            return ModuleLinkUtils.normalizePath(ModuleLinkUtils.joinPath(baseDir, imp))
        }
        val rel: String = ModuleLinkUtils.replaceAllDots(imp)
        // 候选根目录（按优先级）：
        //   aura/compiler/    — Aura 编译器本体
        //   aura/core/        — 核心库与标准库
        //   aura/toolchain/*  — 纯 Aura 工具链（cli / lsp / debugger / loom）
        //   <rel>             — 相对仓库根的裸路径
        val candidates: String = "aura/compiler/" + rel + ".aura\n" +
            "aura/core/" + rel + ".aura\n" +
            "aura/toolchain/cli/" + rel + ".aura\n" +
            "aura/toolchain/lsp/" + rel + ".aura\n" +
            "aura/toolchain/debugger/" + rel + ".aura\n" +
            "aura/toolchain/loom/" + rel + ".aura\n" +
            rel + ".aura\n"
        var i: Int = 0
        val n: Int = aotLineCount(candidates)
        while (i < n) {
            val c: String = ModuleLinkUtils.normalizePath(aotLineAt(candidates, i))
            if (FileSystem.exists(c)) {
                return c
            }
            i = i + 1
        }
        return ""
    }
}

object ModuleLinkUtils {

    /// 顶层便捷入口：入口文件 → 合并 HIR。
    fun linkModules(entryPath: String): Hir {
        val l: AotModuleLinker = AotModuleLinker()
        return l.link(entryPath)
    }

    /// Phase B.3：自动包含的 std 模块路径列表（换行分隔）。
    ///
    /// 当用户代码引用 String/Math/FileSystem 等 std 类时，对应的 Aura 实现
    /// 必须参与编译。这些模块通过 `@native` 声明底层 syscall/asm，再由
    /// Phase A 的 emitNativeWrapper 直接生成 LLVM IR（无 C 运行库）。
    ///
    /// 仅包含「无外部依赖」或「依赖已在本列表」的模块：
    ///   * String.aura          — 字符串操作（纯 Aura 逻辑）
    ///   * MathOps.aura         — 数学函数（Taylor 级数/牛顿法）
    ///   * Memory.aura          — 内存分配（@native alloc/free → @malloc/@free）
    ///   * Cpu.aura             — CPU 指令（@native(asm) → LLVM inline asm/fence/atomicrmw）
    ///   * Runtime.aura         — 运行时入口（@native → syscall/asm）
    fun essentialStdModules(): String {
        // Phase B.3: 自动包含的 std 模块。
        //
        // String.aura / Math.aura / MathOps.aura / Memory.aura / Cpu.aura / Runtime.aura
        // 均已验证可正常自动包含（object 方法 receiver 问题已修复，package 声明已处理）。
        //
        // Phase 1: 消除双实现冗余 — 所有 AOT 依赖改为 Aura native 实现。
        // 新增模块提供 C FFI 符号的 Aura 替代实现，通过 @native 声明生成 LLVM IR。
        return "aura/core/aura/lang/String.aura\n" +
            // 内建基类 Any：所有类型隐式继承，`hashCode` / `equals` / `toString`
            // 的默认实现必须始终参与编译（调用点不能只有 declare 没有 define）。
            "aura/core/aura/lang/Any.aura\n" +
            "aura/core/aura/lang/std/Math.aura\n" +
            "aura/core/aura/lang/native/math/MathOps.aura\n" +
            "aura/core/aura/lang/native/Memory.aura\n" +
            "aura/core/aura/lang/native/Cpu.aura\n" +
            "aura/core/aura/lang/native/Runtime.aura\n" +
            // Phase 1: native 包底层原语（C FFI 替代）
            "aura/core/aura/lang/native/Syscalls.aura\n" +
            "aura/core/aura/lang/native/memory/Allocator.aura\n" +
            "aura/core/aura/lang/native/console/Console.aura\n" +
            "aura/core/aura/lang/native/io/Stdio.aura\n" +
            "aura/core/aura/lang/native/time/Clock.aura\n" +
            "aura/core/aura/lang/native/env/EnvOps.aura\n" +
            "aura/core/aura/lang/native/process/ProcessOps.aura\n" +
            "aura/core/aura/lang/native/thread/ThreadOps.aura\n" +
            "aura/core/aura/lang/native/network/NetworkOps.aura\n" +
            // Phase P1-P3: 纯 Aura 标准库模块（已验证可自动包含）
            "aura/core/aura/lang/std/string/StringBuilder.aura\n" +
            "aura/core/aura/lang/std/collection/Collections.aura\n" +
            "aura/core/aura/lang/std/FileSystem.aura\n" +
            "aura/core/aura/lang/native/file/FileOps.aura\n" +
            "aura/core/aura/lang/std/string/StringOps.aura\n" +
            "aura/core/aura/lang/native/process/ProcessNative.aura\n"
    }

    // ── 路径工具 ──

    /// 把点分包名转为路径（`aura.lang.std.String` → `aura/lang/std/String`）。
    fun replaceAllDots(s: String): String {
        var out: String = ""
        var i: Int = 0
        val len: Int = s.length
        while (i < len) {
            if (s.charCodeAt(i) == 46) {  // '.'
                out = out + "/"
            } else {
                out = out + s.substring(i, i + 1)
            }
            i = i + 1
        }
        return out
    }

    /// 取目录部分（无分隔符返回 "."）。
    fun dirOf(p: String): String {
        var i: Int = p.length - 1
        while (i >= 0) {
            if (p.charCodeAt(i) == 47 || p.charCodeAt(i) == 92) {  // '/' or '\\'
                return aotSlice(p, 0, i)
            }
            i = i - 1
        }
        return "."
    }

    /// 目录 + 相对路径拼接（绝对路径原样返回）。
    fun joinPath(dir: String, rel: String): String {
        if (rel.startsWith("/") || rel.contains(":")) {
            return rel
        } else if (dir == "" || dir == ".") {
            return rel
        } else {
            return dir + "/" + rel
        }
    }

    /// 追加两个 kids 串（逗号分隔），空串安全。
    fun appendKids(a: String, b: String): String {
        if (a == "") {
            return b
        } else if (b == "") {
            return a
        } else {
            return a + "," + b
        }
    }

    /// 反斜杠 → 正斜杠（手写，避免依赖 String.replace 的类调用链接）。
    fun slashify(p: String): String {
        var out: String = ""
        var i: Int = 0
        val len: Int = p.length
        while (i < len) {
            if (p.charCodeAt(i) == 92) {  // '\\'
                out = out + "/"
            } else {
                out = out + p.substring(i, i + 1)
            }
            i = i + 1
        }
        return out
    }

    /// 规范化路径：折叠 `.` / `..` / 重复分隔符（保持 POSIX 风格）。
    fun normalizePath(p: String): String {
        val parts: String = slashify(p)
        var out: String = ""
        var i: Int = 0
        var seg: String = ""
        val len: Int = parts.length
        while (i <= len) {
            var c: Int = 47  // '/'
            if (i < len) {
                c = parts.charCodeAt(i)
            }
            if (c == 47) {
                if (seg == "..") {
                    out = popSegment(out)
                } else if (seg != "" && seg != ".") {
                    if (out != "") {
                        out = out + "/"
                    }
                    out = out + seg
                }
                seg = ""
            } else {
                seg = seg + parts.substring(i, i + 1)
            }
            i = i + 1
        }
        return out
    }

    /// 弹出路径的最后一段（用于 `..`）。
    fun popSegment(path: String): String {
        var i: Int = path.length - 1
        while (i >= 0) {
            if (path.charCodeAt(i) == 47) {
                return aotSlice(path, 0, i)
            }
            i = i - 1
        }
        return ""
    }
}
