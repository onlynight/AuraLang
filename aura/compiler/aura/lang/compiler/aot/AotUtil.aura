// aura:///aura/lang/compiler/aot/AotUtil.aura
package aura.lang.compiler.aot
// ─────────────────────────────────────────────────────────────
// AOT 后端公共辅助 — 纯 Aura 化迁移 · Phase 6
//
// 提供所有 aot/*.aura 模块共用的字符串解析工具（行/字段/CSV/整数）。
// 命名统一以 `aot` 前缀，避免与 Ast/Hir/Mir 的同类辅助冲突
// （它们分别用 ast*/hir*/mir*/ce* 前缀）。
//
// 说明：当前 VM 对 `List` 支持不稳定，故一律采用「字符串 + 字符扫描」，
// 与 Phase 1–5 的实现风格保持一致。
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String

// ── 内存诊断（分阶段定位 AOT 运行时内存增长；见 C 运行库 aura_mem_used_mb）──

object AotUtil {

    /// 当前 AOT 运行时存活分配（MiB）。AOT 无 GC，所有分配只增不减，
    /// 该值即「进程累计未释放字节 / 1MiB」。
    ///
    /// ⚠ `aura_mem_used_mb` 是**AOT 运行库符号**（`aot/runtime/memdiag.ll` 的
    /// `declare` + C 运行库实现），VM（字节码）模式没有实现，且字节码发射器对
    /// 未解析调用是**硬报错**（`未解析的函数调用 'aura_mem_used_mb'`）而不是
    /// 静默降级。
    ///
    /// 因此这里用**编译期常量**把调用挡在字节码产物之外（`if (false)` 分支在
    /// 降级期即被消除，不会触发调用解析；实测死分支里的调用不会被解析）。
    /// 需要 `--mem-trace` 的 AOT 内存诊断时，把下面的 `false` 改成 `true`
    /// **并用 AOT/native 方式构建编译器**（此时符号由 memdiag.ll + C 运行库提供）。
    fun aotMemMB(): String {
        if (false) {
            return toStr(aura_mem_used_mb())
        }
        return "0"
    }

    /// 打印一条带标记的内存观测（形如 `[mem] <tag> = <n> MB`）。
    fun aotMemMark(tag: String) {
        println("[mem] " + tag + " = " + aotMemMB() + " MB")
    }

    /// 取第 index 个以 sep 分隔的字段（0-based，字符扫描）。
    ///
    /// **性能关键**：分隔符比较走 `charCodeAt`（整数比较、零分配）。
    /// 旧写法 `toStr(text[i]) == sep` 每个字符都要经 `String_charAt`
    /// 造一个临时字符串（每次 malloc）——该函数在发射期被签名表解析
    /// 反复调用，是内存/耗时的主要来源之一。
    fun aotFieldAt(text: String, index: Int, sep: String): String {
        var i: Int = 0
        var fieldStart: Int = 0
        var cur: Int = 0
        var fieldLen: Int = text.length
        val sepCode: Int = sep.charCodeAt(0)
        while (i < fieldLen) {
            if (text.charCodeAt(i) == sepCode) {
                if (cur == index) {
                    return aotSlice(text, fieldStart, i - fieldStart)
                }
                cur = cur + 1
                fieldStart = i + 1
            }
            i = i + 1
        }
        if (cur == index) {
            return aotSlice(text, fieldStart, fieldLen - fieldStart)
        }
        return ""
    }

    /// 字符串切片（越界自动截断）。
    ///
    /// 直接走 `String.substring`（AOT 下映射到运行时一次性分配的实现）：
    /// 旧实现的逐字符 `result + toStr(text[i])` 是平方级分配。
    fun aotSlice(text: String, start: Int, length: Int): String {
        var len: Int = text.length
        var s: Int = start
        if (s < 0) {
            s = 0
        }
        var end: Int = s + length
        if (end > len) {
            end = len
        }
        if (end <= s) {
            return ""
        }
        return text.substring(s, end)
    }

    /// 十进制字符串 → Int（支持前导负号；非法字符忽略）。
    ///
    /// 旧实现每个字符要构造临时字符串并与 0..9 逐个比较（每字符 ≥ 10 次
    /// 分配）——该函数在发射期按节点/字段高频调用。
    fun aotToInt(text: String): Int {
        var total: Int = 0
        var i: Int = 0
        var len: Int = text.length
        var neg: Boolean = false
        if (len > 0 && text.charCodeAt(0) == 45) {
            neg = true
            i = 1
        }
        while (i < len) {
            val digit: Int = text.charCodeAt(i) - 48
            if (digit >= 0 && digit <= 9) {
                total = total * 10 + digit
            }
            i = i + 1
        }
        if (neg) {
            return -total
        }
        return total
    }

    /// 文本行数（末尾无换行时补计一行；空串为 0）。
    ///
    /// 用原生 `countChar` 一次统计换行数：逐字符 `text[i]` 在 AOT 下每次都是
    /// O(n)（`strlen` + 1 字符分配），对 MB 级文本（如整份 LLVM IR）会退化成
    /// O(n²)——表现为"IR 已生成完毕，进程却卡住不动"。
    fun aotLineCount(text: String): Int {
        if (text == "") {
            return 0
        }
        var count: Int = text.countChar("\n")
        if (!text.endsWith("\n")) {
            count = count + 1
        }
        return count
    }

    /// 取第 index 行（0-based）。
    fun aotLineAt(text: String, index: Int): String {
        return aotFieldAt(text, index, "\n")
    }

    /// CSV 字段数（空串为 0）。
    fun aotCsvCount(csv: String): Int {
        if (csv == "") {
            return 0
        }
        var count: Int = 1
        var i: Int = 0
        val clen: Int = csv.length
        while (i < clen) {
            if (csv.charCodeAt(i) == 44) {
                count = count + 1
            }
            i = i + 1
        }
        return count
    }

    /// 将 CSV 转为「逗号 + 空格」分隔（LLVM 声明风格），如 `i32,i32` → `i32, i32`。
    fun aotCsvToSpaced(csv: String): String {
        if (csv == "") {
            return ""
        }
        var out: String = ""
        var n: Int = aotCsvCount(csv)
        var i: Int = 0
        while (i < n) {
            if (i > 0) {
                out = out + ", "
            }
            out = out + aotFieldAt(csv, i, ",")
            i = i + 1
        }
        return out
    }

    /// 判断 name 是否出现在以换行分隔的行清单中（如 `seen` 去重集合）。
    ///
    /// 性能：`split` 一次后线性扫描（避免 `aotLineAt` 的 O(len²)）。
    fun aotListContains(lines: String, name: String): Boolean {
        if (lines == "" || name == "") {
            return false
        } else if (lines.startsWith(name + "\n")) {
            // 全部条目以 `\n` 结尾：整行匹配等价于三段子串判定。旧实现逐行
            // `aotLineAt`（每行都要从头切片、且逐字符分配）——`isStructSym` 每次
            // 构造都会调用它，累计是千万级分配（自举内存暴涨的元凶之一）。
            return true
        } else {
            return lines.contains("\n" + name + "\n")
        }
    }

    /// 是否为已知 std 类名（用于把 `Math.sin(x)` 识别为类静态调用、
    /// 把 `Class.method` 解析为调用点符号 `aura_lang_std_<Class>_<method>`）。
    fun isStdClassName(name: String): Boolean {
        if (name == "Math") { return true }
        else if (name == "String") { return true }
        else if (name == "Collections") { return true }
        else if (name == "FileSystem") { return true }
        else if (name == "StringBuilder") { return true }
        else if (name == "Process") { return true }
        else if (name == "Random") { return true }
        else if (name == "Time") { return true }
        else if (name == "Date") { return true }
        else if (name == "Env") { return true }
        else if (name == "IO") { return true }
        else if (name == "Memory") { return true }
        else if (name == "Encoding") { return true }
        else if (name == "Json") { return true }
        else if (name == "Network") { return true }
        else if (name == "Path") { return true }
        else if (name == "Ascii") { return true }
        else if (name == "Iter") { return true }
        else if (name == "Console") { return true }
        else { return false }
    }

    /// 规范 std 类名（含旧式小写包别名）：`fs` → `FileSystem`、`io` → `Stdio` 等。
    ///
    /// 为什么需要：源码里存在 `aura.fs.writeText(...)` / `aura.io.fileExists(...)`
    /// 这类**旧包名**调用，HIR 把包前缀（`fs` / `io`）降级成接收者；
    /// 而 `isStdClassName` 只认规范类名且**大小写敏感** → 解析失败并落到
    /// 「裸名 + 对象扫描」兜底：符号名对不上、实参位置多一个 `null`，
    /// 运行期把 null 当路径字符串解引用（0xC0000005）。测试
    /// `13-stdlib.aura` 的 `aura.fs.exists(...)` 正是这样编译失败的。
    fun canonicalStdReceiver(name: String): String {
        if (name == "") {
            return ""
        }
        // 限定名只取**最后一段**：`aura.fs` → `fs`、`aura.lang.std.Math` → `Math`。
        // HIR 对 `aura.fs.exists(p)` 这类调用把包前缀整链降级为接收者，
        // 逐个前缀直接查表必然落空。
        var nm: String = name
        var lastDot: Int = -1
        var di: Int = 0
        while (di < nm.length) {
            if (nm.charCodeAt(di) == 46) {
                lastDot = di
            }
            di = di + 1
        }
        if (lastDot >= 0) {
            nm = aotSlice(nm, lastDot + 1, nm.length - lastDot - 1)
        }
        if (nm == "") {
            return ""
        }
        if (isStdClassName(nm)) {
            return nm
        }
        val lc: String = aotToLower(nm)
        if (lc == "fs") { return "FileSystem" }
        else if (lc == "io") { return "Stdio" }
        else if (lc == "console") { return "Console" }
        else if (lc == "process") { return "Process" }
        else if (lc == "math") { return "Math" }
        else if (lc == "string") { return "String" }
        else if (lc == "collections") { return "Collections" }
        else if (lc == "stringbuilder") { return "StringBuilder" }
        else if (lc == "random") { return "Random" }
        else if (lc == "time") { return "Time" }
        else if (lc == "date") { return "Date" }
        else if (lc == "env") { return "Env" }
        else if (lc == "memory") { return "Memory" }
        else if (lc == "encoding") { return "Encoding" }
        else if (lc == "json") { return "Json" }
        else if (lc == "network") { return "Network" }
        else if (lc == "path") { return "Path" }
        else if (lc == "ascii") { return "Ascii" }
        else if (lc == "iter") { return "Iter" }
        return ""
    }

    /// 把多个片段用 `sep` 连接成一个字符串（**树形归并**）。
    ///
    /// 为什么不用 `acc = acc + piece`：那是 O(n²) 次字符复制。AOT 运行时**没有 GC**，
    /// 这些中间串会全部泄漏——拼接整份编译器 IR / 整个模块的 kids 串时能吃掉十几 GB
    /// 内存（进程看起来"内存一直涨直到卡死"）。树形归并每层只把片段两两合并，
    /// 总复制量降到 O(n log n)，中间串也随层数快速被上层吸收。
    fun joinPieces(parts: List<String>, sep: String): String {
        var cur: List<String> = parts
        if (cur.size == 0) {
            return ""
        }
        while (cur.size > 1) {
            var next: List<String> = arrayListOf<String>()
            var i: Int = 0
            while (i + 1 < cur.size) {
                next.add(cur[i] + sep + cur[i + 1])
                i = i + 2
            }
            if (i < cur.size) {
                next.add(cur[i])
            }
            cur = next
        }
        return cur[0]
    }

    /// 去掉首尾空白（空格 / 制表 / 换行）。
    fun trimSpaces(s: String): String {
        var start: Int = 0
        var end: Int = s.length
        while (start < end) {
            val c: String = aotSlice(s, start, 1)
            if (c == " " || c == "\t" || c == "\n" || c == "\r") {
                start = start + 1
            } else {
                break
            }
        }
        while (end > start) {
            val c: String = aotSlice(s, end - 1, 1)
            if (c == " " || c == "\t" || c == "\n" || c == "\r") {
                end = end - 1
            } else {
                break
            }
        }
        return aotSlice(s, start, end - start)
    }

    /// 取限定名的最后一段：`Collections.emptyList` → `emptyList`；无 `.` 时原样返回。
    ///
    /// **性能关键**：`name.length` 是 `strlen`（O(n)），不能放在循环条件里；
    /// 分隔符比较走 `charCodeAt`（零分配）。本函数在发射期对每个符号名调用。
    fun aotLastSegment(name: String): String {
        val n: Int = name.length
        var start: Int = 0
        var i: Int = 0
        while (i < n) {
            if (name.charCodeAt(i) == 46) {
                start = i + 1
            }
            i = i + 1
        }
        if (start == 0) {
            return name
        }
        return aotSlice(name, start, n - start)
    }

    /// 子串包含判定（`String.contains` 的包内别名，统一 `aot*` 命名）。
    fun aotContains(text: String, sub: String): Boolean {
        if (sub == "") {
            return true
        }
        return text.contains(sub)
    }

    /// 把 `text` 中所有 `from`（单字符）替换为 `to`（可多字符）。
    ///
    /// 供 `@native(asm = "…")` 的内联汇编字符串转义使用（`"` → `\"`）。
    /// 不走 `String.replace`：Aura 侧字符串替换的类方法调用链在 AOT 下不稳定。
    fun aotReplaceAll(text: String, from: String, to: String): String {
        if (from == "") {
            return text
        }
        var out: String = ""
        var i: Int = 0
        val n: Int = text.length
        while (i < n) {
            val c: String = aotSlice(text, i, 1)
            if (c == from) {
                out = out + to
            } else {
                out = out + c
            }
            i = i + 1
        }
        return out
    }

    /// ASCII 大写 → 小写（其余字符原样保留）。
    fun aotToLower(s: String): String {
        val upper: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        val lower: String = "abcdefghijklmnopqrstuvwxyz"
        var out: String = ""
        var i: Int = 0
        val n: Int = s.length
        while (i < n) {
            val c: String = aotSlice(s, i, 1)
            val idx: Int = aotIndexOfSub(upper, c)
            if (idx >= 0) {
                out = out + aotSlice(lower, idx, 1)
            } else {
                out = out + c
            }
            i = i + 1
        }
        return out
    }

    /// `@native(...)` 注解文本 → syscall 号。
    ///
    /// 接受十进制字面量（`"0"`）或常量名（`SYS_READ`）；未知名返回 `-1`
    /// （C 分发入口 `aura_syscall_dispatch` 对未知号同样返回 `-1`）。
    /// 常量表与 Rust 侧 `parser.rs::lookup_syscall_const` 保持一致。
    fun aotSyscallNumber(name: String): Int {
        if (name == "") {
            return -1
        } else if (aotIsDecimal(name)) {
            // 十进制字面量（`@native(0)`）
            return aotToInt(name)
        } else {
            return aotSyscallConst(name)
        }
    }

    /// 是否为十进制字面量（可选负号 + 纯数字）。
    fun aotIsDecimal(s: String): Boolean {
        if (s == "") {
            return false
        }
        val digits: String = "0123456789"
        var i: Int = 0
        if (aotSlice(s, 0, 1) == "-") {
            i = 1
        }
        if (i >= s.length) {
            return false
        }
        while (i < s.length) {
            if (aotIndexOfSub(digits, aotSlice(s, i, 1)) < 0) {
                return false
            }
            i = i + 1
        }
        return true
    }

    /// syscall 常量名 → 号（x86_64 Linux 系统调用表）。
    ///
    /// 与 `SyscallsUtils`（`aura/lang/native/Syscalls.aura`）同源。
    /// Windows 平台通过 `winCrtWrapper` 映射到 CRT 调用，不直接使用此表。
    fun aotSyscallConst(name: String): Int {
        if (name == "SYS_READ") { return 0 }
        else if (name == "SYS_WRITE") { return 1 }
        else if (name == "SYS_OPEN") { return 2 }
        else if (name == "SYS_CLOSE") { return 3 }
        else if (name == "SYS_FSTAT") { return 5 }
        else if (name == "SYS_LSEEK") { return 8 }
        else if (name == "SYS_MMAP") { return 9 }
        else if (name == "SYS_MPROTECT") { return 10 }
        else if (name == "SYS_MUNMAP") { return 11 }
        else if (name == "SYS_ACCESS") { return 21 }
        else if (name == "SYS_PIPE") { return 22 }
        else if (name == "SYS_GETPID") { return 39 }
        else if (name == "SYS_MKDIR") { return 83 }
        else if (name == "SYS_RMDIR") { return 84 }
        else if (name == "SYS_UNLINK") { return 87 }
        else if (name == "SYS_RENAME") { return 82 }
        else if (name == "SYS_FORK") { return 57 }
        else if (name == "SYS_EXECVE") { return 59 }
        else if (name == "SYS_EXIT") { return 60 }
        else if (name == "SYS_EXIT_GROUP") { return 231 }
        else if (name == "SYS_WAIT4") { return 61 }
        else if (name == "SYS_KILL") { return 62 }
        else if (name == "SYS_READV") { return 19 }
        else if (name == "SYS_WRITEV") { return 20 }
        else if (name == "SYS_CLOCK_GETTIME") { return 228 }
        else if (name == "SYS_GETRANDOM") { return 272 }
        else { return -1 }
    }

}
