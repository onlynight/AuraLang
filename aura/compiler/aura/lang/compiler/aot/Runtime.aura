// aura:///aura/lang/compiler/aot/Runtime.aura
package aura.lang.compiler.aot
// ─────────────────────────────────────────────────────────────
// Runtime 库链接声明 — 纯 Aura 化迁移 · Phase 6 (任务 6.3)
//
// 对应 Rust `compiler/src/codegen/aot/runtime.rs`。
//
// Aura runtime 库（`aura-runtime`）通过 C ABI 导出 ARC、GC、协程、
// 堆分配与字符串操作等函数；AOT 生成代码时自动注入这些外部声明。
//
// 表格格式（每行一项）：
//   name|ret_llvm_type|param_llvm_types(逗号分隔)
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String
import aura.lang.std.FileSystem
import aura.lang.compiler.aot.AotUtil

object RuntimeUtils {

    /// 全部 runtime 函数声明表。
    fun runtimeTable(): String {
        return ""
            // Phase C: 全部 C 映射已移除（Emit.aura 改用系统 libc、内联 IR 或 Aura 函数）
            // "toStringFloat|i8*|double\n" +
            // "aura_mem_used_mb|i32|\n" +
            // "aura_arc_increment|void|i8*\n" +
            // "aura_arc_decrement|void|i8*\n" +
            // "aura_coroutine_yield|void|i8*\n" +
            // "aura_malloc|i8*|i64\n" +
            // "aura_free|void|i8*\n" +
            // "aura_string_new|i8*|i8*,i64\n" +
            // "aura_string_length|i64|i8*\n" +
            // "aura_string_data|i8*|i8*\n" +
            // "aura_string_concat|i8*|i8*,i64,i8*,i64\n" +
    }

    /// C FFI 实现（aura_std_cffi.c）的真实 ABI 签名表。
    /// Phase B: 全部条目已移除——各 std 函数均由 Aura 实现提供。
    /// 格式：`symbol|ret_llvm_type|param_llvm_types(逗号分隔)`
    fun cffiTable(): String {
        return ""
    }

    /// AOT 调用点符号表（Phase 6.5.3 / 6.5.4）。
    ///
    /// 发射器把 `println(s)`、`s.length`、`String.split` 等调用/成员落成真实
    /// C 运行库符号。本表与 `compiler/src/std/cffi/aura_std_cffi.c` 的导出
    /// **同源**：`sanitize(aura.lang.std.X.y)` → `aura_lang_std_X_y`。
    ///
    /// 格式：`symbol|ret_llvm_type|param_llvm_types(逗号分隔)`
    ///
    /// 字符串边界（Phase 6.5.5）：Aura 侧 AOT 发射器内部按 **`i8*`（C 字符串）**
    /// 表示 String，与 C ABI (`const char*`) 直接对齐，跨边界无需 coerce。
    fun preludeTable(): String {
        return ""
            // Phase C: 全部 C 映射已移除（Emit.aura 改用内联 IR）
            // "aura_println|void|i8*\n" +
            // "aura_print|void|i8*\n" +
            // "aura_to_str_float|i8*|double\n" +
            // "aura_to_str|i8*|i64\n" +
            // "aura_to_str_bool|i8*|i64\n" +
            // "aura_to_int_any|i64|i64\n" +
            // "aura_to_str_any|i8*|i64\n" +
            // "aura_strlen|i64|i8*\n" +
            // "aura_str_to_int|i64|i8*\n" +
            // "aura_str_to_float|double|i8*\n" +
            // "toString|i8*|i64\n" +
            // "toStr|i8*|i64\n" +
            // Phase B.1: String 相关 C 映射已移除（String.aura 自动包含，调用走 Aura 编译）
            // ── Phase B.1 前保留（已注释）──
            // "aura_lang_std_String_toInt|i64|i8*\n" +
            // "aura_lang_std_String_toFloat|double|i8*\n" +
            // "aura_lang_std_String_length|i64|i8*\n" +
            // "aura_lang_std_String_equals|i32|i8*,i8*\n" +
            // "aura_lang_std_String_contains|i32|i8*,i8*\n" +
            // "aura_lang_std_String_startsWith|i32|i8*,i8*\n" +
            // "aura_lang_std_String_endsWith|i32|i8*,i8*\n" +
            // "aura_lang_std_String_indexOf|i64|i8*,i8*\n" +
            // "aura_lang_std_String_countChar|i64|i8*,i8*\n" +
            // "aura_lang_std_String_substring|i8*|i8*,i64,i64\n" +
            // "aura_lang_std_String_charAt|i8*|i8*,i64\n" +
            // "aura_lang_std_String_charCodeAt|i64|i8*,i64\n" +
            // "aura_lang_std_String_toUpperCase|i8*|i8*\n" +
            // "aura_lang_std_String_toLowerCase|i8*|i8*\n" +
            // "aura_lang_std_String_trim|i8*|i8*\n" +
            // Phase B: Collections C 映射已移除（Collections.aura 自动包含，调用走 Aura 编译）
            // ── Phase B 前保留（已注释）──
            // "aura_lang_std_Collections_emptyList|i8*|\n" +
            // "aura_lang_std_Collections_listAppend|i8*|i8*,i8*\n" +
            // "aura_lang_std_Collections_count|i64|i8*\n" +
            // "aura_lang_std_Collections_getAt|i8*|i8*,i64\n" +
            // "aura_lang_std_Collections_set|i8*|i8*,i64,i8*\n" +
            // "aura_lang_std_Collections_listSet|void|i8*,i64,i8*\n" +
            // "aura_lang_std_Collections_filter|i8*|i8*,i8*\n" +
            // "aura_lang_std_Collections_map|i8*|i8*,i8*\n" +
            // "aura_lang_std_Collections_take|i8*|i8*,i64\n" +
            ""
    }

    /// 生成所有 runtime 函数 + 调用点符号的 LLVM 外部声明（去重）。
    ///
    /// 声明来源（后者过滤掉前者已声明者）：
    ///   1. `runtimeTable()`   Aura runtime 库（ARC/GC/字符串基础）
    ///   2. `preludeTable()`   既有调用点符号层（向后兼容）
    ///
    /// Phase A 改造：@native 包装器不再依赖 C 运行库符号（aura_syscalls.c），
    /// 改为直接生成 LLVM IR（内联 syscall/asm/fence/atomicrmw）+ declare 系统 libc。
    fun runtimeDeclarationsEx(defs: String): String {
        return runtimeDeclarationsExEx(defs, "")
    }

    fun runtimeDeclarationsExEx(defs: String, basePath: String): String {
        // Phase D: 所有 runtime IR 已拆分到独立 .ll 文件
        // 基础目录从源文件路径推导（例如 "aura/compiler/aura/lang/compiler/" → "aura/compiler/aura/lang/compiler/aot/runtime/"）
        val base: String
        if (basePath != "") {
            base = basePath + "aot/runtime/"
        } else {
            base = "aura/compiler/aura/lang/compiler/aot/runtime/"
        }
        val files: List<String> = list("libc.ll", "crt.ll", "args.ll", "types.ll", "exception.ll", "memdiag.ll")
        val out: EmitBuffer = EmitBuffer()
        out.sbAdd("; ---- Aura Runtime Declarations (from .ll files) ----\n")
        var i: Int = 0
        while (i < files.size) {
            val path: String = base + files[i]
            if (FileSystem.exists(path)) {
                val content: String = FileSystem.readText(path)
                out.sbAdd(content)
            } else {
                out.sbAdd("; WARNING: missing runtime file: " + path + "\n")
            }
            i = i + 1
        }
        // runtimeTable() / preludeTable() 已全部清空，保留调用以维持兼容性
        appendDeclarations(out, runtimeTable())
        val seenR: String = runtimeFunctionNames()
        appendDeclarationsFiltered(out, preludeTable(), seenR + defs)
        return out.sbBuild()
    }

    /// 创建字符串列表（避免依赖 List.of 等 stdlib）。
    fun list(a: String, b: String, c: String, d: String, e: String, f: String): List<String> {
        val r: List<String> = mutableListOf()
        r.add(a)
        r.add(b)
        r.add(c)
        r.add(d)
        r.add(e)
        r.add(f)
        return r
    }

    /// [`runtimeDeclarationsEx`] 的兼容入口（不做 define 过滤）。
    fun runtimeDeclarations(): String {
        return runtimeDeclarationsEx("")
    }

    /// 取一张符号表的全部名字（每行以换行结尾），用于声明去重。
    fun tableNameList(table: String): String {
        val out: EmitBuffer = EmitBuffer()
        appendNameList(out, table)
        return out.sbBuild()
    }

    /// [`tableNameList`] 的追加式实现（写入既有缓冲区）。
    fun appendNameList(out: EmitBuffer, table: String) {
        val lines: List<String> = table.split("\n")
        var i: Int = 0
        while (i < lines.size) {
            out.sbAdd(aotFieldAt(lines[i], 0, "|"))
            out.sbAdd("\n")
            i = i + 1
        }
    }

    /// 把一张符号表渲染为 `declare` 行，追加到 `out`。
    fun appendDeclarations(out: EmitBuffer, table: String) {
        val lines: List<String> = table.split("\n")
        var i: Int = 0
        while (i < lines.size) {
            val line: String = lines[i]
            if (aotFieldAt(line, 0, "|") != "") {
                out.sbAdd(declarationLine(line))
            }
            i = i + 1
        }
    }

    /// 渲染一张符号表并追加到 `out`，跳过 `seen`（换行分隔的名字清单）中已有的符号。
    fun appendDeclarationsFiltered(out: EmitBuffer, table: String, seen: String) {
        val lines: List<String> = table.split("\n")
        var i: Int = 0
        while (i < lines.size) {
            val line: String = lines[i]
            val name: String = aotFieldAt(line, 0, "|")
            if (name != "" && !aotListContains(seen, name)) {
                out.sbAdd(declarationLine(line))
            }
            i = i + 1
        }
    }

    /// 把一行符号表渲染为 `declare <ret> @<name>(<params>)`。
    fun declarationLine(line: String): String {
        val name: String = aotFieldAt(line, 0, "|")
        val ret: String = aotFieldAt(line, 1, "|")
        val params: String = aotCsvToSpaced(aotFieldAt(line, 2, "|"))
        return "declare " + ret + " @" + name + "(" + params + ")\n"
    }

    /// 调用点符号签名查询（runtime → C FFI → prelude，返回 `ret|paramsSpaced`）。
    ///
    /// 发射器统一用本函数决定调用的返回类型与参数形态。每个调用点都会查一次，
    /// 所以查询本身必须**零表构建、零切片**：先前实现每次都重建并 `split` 整张表，
    /// 普通调用点（用户函数/方法名）白跑三张表——无 GC 时累积泄漏到数 GB。
    fun callSignature(name: String): String {
        // runtime / C FFI / prelude 的调用点符号**一律**以 `aura_` 开头，
        // 例外只有 `toString` / `toStr` / `toStringFloat`。普通调用点（用户函数 /
        // 方法名）不满足该形态，直接返回，避免为每个调用点重建三张表
        // （每处约 60 次小分配，AOT 无 GC 时累计可达数百 MB）。
        if (!name.startsWith("aura_") && name != "toString" && name != "toStr"
            && name != "toStringFloat") {
            return ""
        }
        val sig: String = runtimeSignature(name)
        if (sig != "") {
            return sig
        }
        val c: String = cffiSignature(name)
        if (c != "") {
            return c
        }
        return tableSignature(preludeTable(), name)
    }

    /// 从任意符号表查询签名（`ret|paramsSpaced`），未命中返回 ""。
    ///
    /// 实现为**单次子串扫描**（`startsWith` / `contains` + `substringAfter`）：
    /// 不构建 `List`、不逐行切片，只有常数次字符串分配。
    fun tableSignature(table: String, name: String): String {
        if (name == "") {
            return ""
        }
        val needle: String = name + "|"
        val mid: String = "\n" + needle
        var rest: String = ""
        if (table.startsWith(needle)) {
            rest = table.substringAfter(needle)
        } else {
            if (!table.contains(mid)) {
                return ""
            }
            rest = table.substringAfter(mid)
        }
        val line: String = rest.substringBefore("\n")
        return aotFieldAt(line, 0, "|") + "|" + aotCsvToSpaced(aotFieldAt(line, 1, "|"))
    }

    /// 方法名 → 调用点符号（bare method call，接收者为第 0 个实参）。
    ///
    /// HIR 把 `s.split(":")` 降级为 `HirCall text="split"` 且接收者在 kids[0]；
    /// 本表把裸方法名解析为 C 运行库的调用点符号。未命中返回 ""。
    fun methodCallSymbol(name: String): String {
        // 迭代器链：`nums.filter { … }` / `.map { … }` / `.take(n)`。
        // Phase B: 已切换到 Aura Collections 实现（i64/Long 类型）。
        if (name == "filter") { return "Collections_filter" }
        else if (name == "map") { return "Collections_map" }
        else if (name == "take") { return "Collections_take" }
        else if (name == "length" || name == "size") { return "String_length" }
        else if (name == "contains") { return "String_contains" }
        else if (name == "startsWith") { return "String_startsWith" }
        else if (name == "endsWith") { return "String_endsWith" }
        else if (name == "indexOf") { return "String_indexOf" }
        else if (name == "lastIndexOf") { return "String_lastIndexOf" }
        else if (name == "countChar") { return "String_countCharStr" }
        else if (name == "substring") { return "String_substring" }
        else if (name == "substringBefore") { return "String_substringBefore" }
        else if (name == "substringAfter") { return "String_substringAfter" }
        else if (name == "charAt") { return "String_charAt" }
        else if (name == "charCodeAt") { return "String_charCodeAt" }
        else if (name == "toUpperCase") { return "String_toUpperCase" }
        else if (name == "toLowerCase") { return "String_toLowerCase" }
        else if (name == "trim") { return "String_trim" }
        else if (name == "replace") { return "String_replace" }
        else if (name == "replaceAll") { return "String_replaceAll" }
        else if (name == "padStart") { return "String_padStart" }
        else if (name == "split") { return "String_split" }
        else if (name == "equals") { return "String_equals" }
        else if (name == "toInt") { return "String_toInt" }
        else if (name == "toLong") { return "String_toLong" }
        else if (name == "toFloat") { return "String_toFloat" }
        else if (name == "toDouble") { return "String_toDouble" }
        else if (name == "toBoolean") { return "String_toBoolean" }
        else if (name == "toCharArray") { return "String_toCharArray" }
        else if (name == "isEmpty") { return "String_isEmpty" }
        else if (name == "isBlank") { return "String_isBlank" }
        else if (name == "padEnd") { return "String_padEnd" }
        else { return "" }
    }

    /// 所有 runtime 函数名（换行分隔）。
    fun runtimeFunctionNames(): String {
        return tableNameList(runtimeTable())
    }

    /// runtime 函数个数。
    fun runtimeFunctionCount(): Int {
        return aotLineCount(runtimeTable())
    }

    /// 检查一个符号名是否为 runtime 函数。
    ///
    /// 复用 `tableSignature` 的「零 split、零表重建」前缀定位：旧实现每次
    /// `split("\n")` 出整张 runtime 表（一行一个子串 + 一张 List）。
    fun isRuntimeFunction(name: String): Boolean {
        return tableSignature(runtimeTable(), name) != ""
    }

    /// runtime 函数签名（`ret|paramsSpaced`），非 runtime 函数返回 ""。
    fun runtimeSignature(name: String): String {
        return tableSignature(runtimeTable(), name)
    }

    /// C FFI 函数签名（`ret|paramsSpaced`），非 C FFI 函数返回 ""。
    fun cffiSignature(name: String): String {
        return tableSignature(cffiTable(), name)
    }
}
