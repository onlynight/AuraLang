// aura:///aura/lang/compiler/aot/EmitBuffer.aura
package aura.lang.compiler.aot

// ─────────────────────────────────────────────────────────────
// 发射缓冲：原生 StringBuilder 的薄封装。
//
// 每个 EmitBuffer 实例持有独立的 StringBuilder（class 实例），
// 不再依赖全局单例，避免并发编译时共享同一缓冲区导致数据互踩。
//
// String ↔ 缓冲区的转换走既有的 C 字符串 ABI：
//   * 写入：`CString(s)`（`prelu.aura` → `Builtin.cstr`）
//   * 读出：`ReadCStr(ptr)`（`CString` 的逆操作）
//
// 方法名统一加 `sb` 前缀，避免与 List 的 add/append 重名。
// ─────────────────────────────────────────────────────────────

import aura.lang.std.string.StringBuilder

/// 发射缓冲区（每个实例独立）。
class EmitBuffer {

    /// 原生缓冲区（StringBuilder 实例）。
    var sb: StringBuilder = StringBuilder()

    /// 追加一段文本（不追加换行）。
    fun sbAdd(s: String) {
        this.sb.append(s)
    }

    /// 获取当前内容快照（**不重置**缓冲区，之后可继续 append）。
    fun sbBuild(): String {
        return this.sb.build()
    }

    /// 清空并复用缓冲区。
    fun sbReset() {
        this.sb.reset()
    }

    /// 当前已累积的字节数。
    fun sbSize(): Int {
        return this.sb.length()
    }

    /// 检查缓冲区是否包含指定子串（避免 sbBuild() 分配）。
    fun sbContains(sub: String): Boolean {
        return this.sb.contains(sub)
    }
}
