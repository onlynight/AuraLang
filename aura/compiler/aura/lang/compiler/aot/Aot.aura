// aura:///aura/lang/compiler/aot/Aot.aura
package aura.lang.compiler.aot
// ─────────────────────────────────────────────────────────────
// AOT 后端编排器 — 纯 Aura 化迁移 · Phase 6 (任务 6.10)
//
// 对应 Rust `compiler/src/codegen/aot/mod.rs`（AotCodeGenerator + AotOptions）。
//
// 编排流程：
//   1. HIR → LLVM IR 文本           （Emit.aura）
//   2. 构造 llc / clang 命令         （Linker.aura）
//   3. 生成 C 后端备选源码           （CBackend.aura）
//   4. 组装为 AotResult 返回
//
// 设计说明：与 Rust 侧一致，IR 生成是纯函数（不触发 IO）；
// 实际的 llc/clang 子进程调用与产物写盘由引导层承担。
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String
import aura.lang.std.FileSystem
import aura.lang.std.Process
import aura.lang.compiler.lexer.Span
import aura.lang.compiler.hir.Hir
import aura.lang.compiler.aot.AotUtil
import aura.lang.compiler.aot.Target
import aura.lang.compiler.aot.Optimize
import aura.lang.compiler.aot.Emit
import aura.lang.compiler.aot.Linker
import aura.lang.compiler.aot.CBackend

/// AOT 编译选项。
class AotOptions {

    /// 目标平台三元组。
    var target: TargetTriple = targetDefault()

    /// 优化级别。
    var optLevel: OptimizationLevel = optLevelDefault()

    /// 模块名（同时用作产物文件名前缀）。
    var moduleName: String = "main"

    /// 是否注入 runtime 声明。
    var linkRuntime: Boolean = true

    /// 是否发射调试信息。
    var emitDebug: Boolean = false

    /// LLVM 根目录（可选，优先级最高）。
    var llvmHome: String = ""

    /// 是否链接标准库 C FFI。
    var linkStdCffi: Boolean = false

    init(target: TargetTriple, optLevel: OptimizationLevel, moduleName: String) {
        this.target = target
        this.optLevel = optLevel
        this.moduleName = moduleName
        this.linkRuntime = true
        this.emitDebug = false
        this.llvmHome = ""
        this.linkStdCffi = false
    }
}

/// 默认 AOT 选项。
fun defaultAotOptions(): AotOptions {
    return AotOptions(targetDefault(), optLevelDefault(), "main")
}

/// AOT 编译结果。
class AotResult {

    /// 生成的 LLVM IR 文本。
    var llvmIr: String = ""

    /// 目标三元组字符串。
    var targetTriple: String = ""

    /// 优化参数（`-O2` 等）。
    var optFlag: String = ""

    /// llc 目标文件生成命令。
    var objectCommand: String = ""

    /// clang 可执行文件链接命令。
    var executableCommand: String = ""

    /// C 后端备选源码。
    var cSource: String = ""

    /// 是否成功。
    var success: Boolean = false

    init(ir: String, triple: String, flag: String, objCmd: String, exeCmd: String, cSrc: String) {
        this.llvmIr = ir
        this.targetTriple = triple
        this.optFlag = flag
        this.objectCommand = objCmd
        this.executableCommand = exeCmd
        this.cSource = cSrc
        this.success = true
    }

    /// IR 文本行数。
    fun irLineCount(): Int {
        return aotLineCount(this.llvmIr)
    }

    /// IR 中是否定义了指定函数。
    fun hasFunction(name: String): Boolean {
        return this.llvmIr.contains("@" + sanitizeLlvm(name) + "(")
    }
}

/// AOT 代码生成器（编排器）。
class AotCodeGenerator {

    /// 最近一次编译结果。
    var lastResult: AotResult = emptyAotResult()

    init() {
        this.lastResult = emptyAotResult()
    }

    /// HIR → AOT 结果（IR + 命令 + C 源码）。
    fun compile(hir: Hir, options: AotOptions): AotResult {
        // 注意：经字段访问得到的对象再调方法会错乱 this 绑定，
        // 故先取到局部变量再调用。
        val tgt: TargetTriple = options.target
        val lvl: OptimizationLevel = options.optLevel
        val triple: String = tgt.toTriple()
        val flag: String = lvl.flag()

        val ir: String = emitLlvmIr(hir, options.moduleName, triple)

        val objPath: String = options.moduleName + "." + tgt.objectExt()
        var exePath: String = options.moduleName
        val exeExt: String = tgt.exeExt()
        if (exeExt != "") {
            exePath = exePath + "." + exeExt
        }
        val objCmd: String = llcCommand(options.moduleName + ".ll", objPath, triple, flag)
        val exeCmd: String = clangCommand(objPath, exePath, triple, flag, options.emitDebug)

        val cSrc: String = emitC(hir, options.moduleName)

        val r: AotResult = AotResult(ir, triple, flag, objCmd, exeCmd, cSrc)
        this.lastResult = r
        return r
    }

    /// 仅生成 LLVM IR（便捷方法）。
    fun emitIr(hir: Hir, options: AotOptions): String {
        val tgt: TargetTriple = options.target
        return emitLlvmIr(hir, options.moduleName, tgt.toTriple())
    }
}

/// 空结果占位。
fun emptyAotResult(): AotResult {
    return AotResult("", "", "", "", "", "")
}

/// 顶层入口：HIR → AOT 结果。
fun aotCompile(hir: Hir, options: AotOptions): AotResult {
    val gen: AotCodeGenerator = AotCodeGenerator()
    return gen.compile(hir, options)
}

/// AOT 后端版本。
fun aotBackendVersion(): String {
    return "0.1.0-phase6"
}

// ─────────────────────────────────────────────────────────────
// AOT 产物落盘与原生 exe 产出（Phase 9：接入 LLVM 工具链）
//
// 本模块只负责「HIR → LLVM IR →（llc）→ .obj →（clang）→ 原生 exe」这一段；
// 「源码 → HIR」由调用方（编译器入口 / 验证用例）自行串联，后端不反向依赖前端。
// ─────────────────────────────────────────────────────────────

/// AOT 链接产物（LLVM IR 文本 + llc/clang 命令 + C 后端源码）。
class AotLinkResult {

    /// LLVM IR 文本。
    var llvmIr: String = ""

    /// 目标三元组。
    var targetTriple: String = ""

    /// 优化参数（`-O2` …）。
    var optFlag: String = ""

    /// llc 目标文件命令。
    var objectCommand: String = ""

    /// clang 链接命令。
    var executableCommand: String = ""

    /// C 后端备选源码。
    var cSource: String = ""

    /// IR 行数。
    var irLines: Int = 0

    /// 是否定义了 main。
    var hasMain: Boolean = false
}

/// HIR → LLVM IR 文本 + llc/clang 命令 + C 后端源码（纯函数，不触发 IO）。
fun compileAot(hir: Hir): AotLinkResult {
    val r: AotLinkResult = AotLinkResult()
    val opts: AotOptions = defaultAotOptions()
    val aot: AotResult = aotCompile(hir, opts)

    r.llvmIr = aot.llvmIr
    r.targetTriple = aot.targetTriple
    r.optFlag = aot.optFlag
    r.objectCommand = aot.objectCommand
    r.executableCommand = aot.executableCommand
    r.cSource = aot.cSource
    r.hasMain = aot.hasFunction("main")
    r.irLines = aot.irLineCount()
    return r
}

/// AOT 原生编译结果。
class AotExeResult {

    /// 是否成功产出 exe。
    var ok: Boolean = false

    /// IR 文件路径。
    var llPath: String = ""

    /// 目标文件路径。
    var objPath: String = ""

    /// 可执行文件路径。
    var exePath: String = ""

    /// llc 退出码。
    var llcExit: Int = 0

    /// clang 退出码。
    var clangExit: Int = 0

    /// std C 运行库（aura_std_cffi.c）编译退出码。
    var cffiExit: Int = 0

    /// 目标三元组。
    var target: String = ""

    /// 执行 exe 的退出码（-999 表示未运行）。
    var runExit: Int = -999
}

/// HIR → IR →（llc）→ .obj →（clang）→ 原生 exe。
///
/// 通过 `FileSystem.writeText` 落盘 IR，经 `Process.run` 调用 LLVM 工具链。
/// `llvmHome` 为 LLVM 根目录（如 `D:/DevTools/LLVM/clang+llvm-23.1.0-...`）。
fun aotBuildExeFromHir(hir: Hir, moduleName: String, outDir: String, llvmHome: String): AotExeResult {
    val r: AotExeResult = AotExeResult()

    val a: AotLinkResult = compileAot(hir)
    val tgt: String = a.targetTriple
    r.target = tgt

    val llPath: String = outDir + "/" + moduleName + ".ll"
    val objPath: String = outDir + "/" + moduleName + ".obj"
    var exePath: String = outDir + "/" + moduleName
    if (tgt.contains("windows")) {
        exePath = exePath + ".exe"
    }
    r.llPath = llPath
    r.objPath = objPath
    r.exePath = exePath

    // 1. 落盘 LLVM IR
    FileSystem.mkdirP(outDir)
    FileSystem.writeText(llPath, a.llvmIr)

    // 2. llc：IR → 目标文件
    val llc: String = toolPreferredPath("llc", llvmHome)
    val clang: String = toolPreferredPath("clang", llvmHome)
    val optFlag: String = a.optFlag
    val llcCmd: String = llc + " -mtriple " + tgt + " " + llPath +
        " -o " + objPath + " " + optFlag + " -filetype=obj"
    r.llcExit = Process.run(llcCmd)

    // 3. clang：编译 std C 运行库（提供 aura_println / aura_math_* /
    //    aura_lang_std_String_* 等符号；不链接会出现 undefined symbol）
    val cffiSrc: String = "compiler/src/std/cffi/aura_std_cffi.c"
    var cffiObj: String = ""
    if (FileSystem.exists(cffiSrc)) {
        cffiObj = outDir + "/aura_std_cffi.obj"
        val cffiCmd: String = clang + " -c " + cffiSrc + " -o " + cffiObj + " -O1"
        r.cffiExit = Process.run(cffiCmd)
    }

    // 4. clang：目标文件 + std 运行库 → 可执行文件。
    //    与 Rust 侧 `link_to_executable` 一致：链接宿主目标**不加** `-target`
    //    （`-target` 会让 clang 走另一套库/ABI，链接 C 运行库时失败）；
    //    交叉编译目标三元组已由 llc 的 `-mtriple` 决定。
    var clangCmd: String = clang + " " + objPath
    if (cffiObj != "") {
        clangCmd = clangCmd + " " + cffiObj
    }
    clangCmd = clangCmd + " -o " + exePath + " " + optFlag
    r.clangExit = Process.run(clangCmd)

    r.ok = (r.llcExit == 0) && (r.cffiExit == 0) && (r.clangExit == 0)
    return r
}

/// 运行已产出的可执行文件，返回其退出码。
///
/// 注意：`Process.run` 经 `cmd /C` 执行，`cmd` 会把路径中的 `/` 当作开关分隔符，
/// 故先把分隔符规范化为反斜杠（`build/a/b.exe` → `build\a\b.exe`）。
fun runBuiltExe(exePath: String): Int {
    return Process.run(aotWinPath(exePath))
}

/// 把路径分隔符 `/` 规范化为 `\`（Windows `cmd` 友好）。
fun aotWinPath(p: String): String {
    var out: String = ""
    var i: Int = 0
    while (i < p.length) {
        val c: String = toStr(p[i])
        if (c == "/") {
            out = out + "\\"
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out
}

/// 默认 LLVM 工具链根目录（与根 `Cargo.toml` 的 `[workspace.metadata.aura].llvm-home` 一致）。
fun llvmHomeDefault(): String {
    return "D:/DevTools/LLVM/clang+llvm-23.1.0-x86_64-pc-windows-msvc"
}
