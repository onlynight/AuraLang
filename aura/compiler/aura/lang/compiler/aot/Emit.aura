// aura:///aura/lang/compiler/aot/Emit.aura
package aura.lang.compiler.aot
// ─────────────────────────────────────────────────────────────
// LLVM IR 文本生成器 — 纯 Aura 化迁移 · Phase 6 (任务 6.6)
//
// 对应 Rust `compiler/src/codegen/aot/emit.rs`（3380 行）。
//
// 将 HIR 程序生成为 LLVM IR 文本字符串。生成流程：
//   1. 模块头（target triple / data layout）
//   2. 全局结构体类型定义（%struct.<Name> = type ...）
//   3. 字符串常量全局（@str.N）
//   4. Runtime 库函数声明
//   5. 用户函数定义（define ...）
//   6. 可选 DWARF 调试元数据
//
// 生成策略（与 Rust 一致）：
//   - 使用 LLVM 13+ 不透明指针（ptr）
//   - 局部变量在 entry 基本块 alloca 分配
//   - 控制流使用条件分支（br）
//
// 本版聚焦核心降级（可逐步扩展）：
//   字面量 / 变量 / 二元 / 一元 / 调用 / val|var 声明 / return /
//   assign / if / while / block。
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String
import aura.lang.compiler.lexer.Span
import aura.lang.compiler.hir.Hir
import aura.lang.compiler.aot.AotUtil
import aura.lang.compiler.aot.EmitBuffer
import aura.lang.compiler.aot.TypeMapper
import aura.lang.compiler.aot.Runtime
import aura.lang.compiler.aot.Dwarf

/// LLVM IR 生成器（有状态，单次 `emitProgram` 内复用）。
class LlvmEmitter {

    /// 目标三元组。
    var targetTriple: String = "x86_64-pc-windows-msvc"

    /// 模块名。
    var moduleName: String = "main"

    /// 是否注入 runtime 声明。
    var linkRuntime: Boolean = true

    /// 是否发射调试元数据。
    var emitDebug: Boolean = false

    /// runtime/*.ll 基础目录（从源文件路径推导）。
    var basePath: String = ""

    /// 类型映射器。
    var tm: TypeMapper = TypeMapper()

    // ── 计数器 ──

    var varCount: Int = 0
    var bbCount: Int = 0
    var strCount: Int = 0

    /// Plan A 内联拆箱（`coerceValue` 的 i8* → 整数分支）所用基本块标签序号。
    ///
    /// 该分支会临时插入 `br` + 三个基本块（int / ptr / merge）来选择拆箱结果，
    /// 标签必须**逐次唯一**：此前字段未声明，`this.fVarSeq` 读到的是未初始化
    /// 槽位（实测恒为同一个垃圾值），同一函数内出现两处拆箱即**标签重复** →
    /// llc 报 `Terminator found in the middle of a basic block!`。
    var fVarSeq: Int = 0

    // ── 累积输出 ──

    /// 字符串常量全局（原生缓冲区累积，末尾零拷贝交出）。
    var stringParts: EmitBuffer = EmitBuffer()

    /// 结构体类型定义（原生缓冲区累积）。
    var structParts: EmitBuffer = EmitBuffer()

    /// 函数定义（原生缓冲区累积；整份编译器 IR 可达十几 MB，逐段 `+` 是平方级分配）。
    var funcParts: EmitBuffer = EmitBuffer()

    /// 已发射类型定义的符号名（换行分隔，用于重复登记判定）。
    var structDeclared: String = ""

    /// 已发射**具体布局**（`= type {`）的符号名（换行分隔）。
    var structConcrete: String = ""

    /// 类继承表（`Child|Parent` 每行一项）。
    ///
    /// `super.m()` 需要解析到父类实现；`Child.m` 未定义时也要沿父链回退
    /// （继承方法）。此前继承关系在解析阶段即被丢弃，`super.name()` 会解析回
    /// 自身 → 无限递归 → 栈溢出（0xC00000FD）。
    var fParents: String = ""

    /// 类名 → 类型声明 HIR 节点 id（`name|id` 每行一项）。
    /// 继承布局需要**先登记父类**（递归），此处用于反查父类节点。
    var fClassNodes: String = ""

    /// 方法名 → vtable 槽位（`name|slot` 每行一项，全局统一编号）。
    var fMethodSlots: String = ""

    /// 类 → 该类提供的方法（`Class|method` 每行一项，供生成 vtable 项）。
    var fClassMethods: String = ""

    /// 动态派发被**静默降级**的清单（`Class|method|祖先` 每行一项）。
    ///
    /// 链内同名方法签名不一致 → 不是 override，`planVtables` 不给它分配槽位、
    /// 调用点退回静态绑定。语义是安全的，但此前**没有任何提示**：排障时只看到
    /// 「动态派发没生效」，无从得知是签名不一致导致的。此处记录并在模块头部以
    /// IR 注释 + 一行 stderr 提示暴露（见 `vtableNotesHeader`）。
    var fVtableNotes: String = ""

    /// `fVtableNotes` 的条数（避免依赖 `split(...).size` 的可靠性）。
    var fVtableNoteCount: Int = 0

    /// 方法定义表（`OwnerSym|method|节点id` 每行一项，供继承方法特化）。
    var fMethodNodes: String = ""

    /// 非空时 `emitFunction` 用它替代方法所属类（继承方法特化用）。
    var fForceOwnerCls: String = ""

    /// 继承方法特化计划（`Child|nodeId` 每行一项）。
    ///
    /// **必须与函数体发射分离**：签名表要在任何函数体发射**之前**登记完毕，
    /// 否则调用点（发射函数体时解析）解析不到 `Child.m`，仍会静态绑到父类符号。
    var fInheritPlans: String = ""

    // ── 当前函数状态 ──

    /// entry 块 alloca 指令。
    var fAlloca: EmitBuffer = EmitBuffer()

    /// 函数体指令。
    var fBody: EmitBuffer = EmitBuffer()

    /// 函数局部变量表（每项 `name|addr|llvmTy`）。
    ///
    /// 用 `List` 而非换行串：查询若靠 `split("\n")`，每次查找都要分配整张表，
    /// 而变量查找是发射期最热路径——AOT 运行时没有 GC，这些临时表会泄漏成 GB。
    var fVarList: List<String> = arrayListOf<String>()

    /// `fVarList` 的并行「名字」键列（查询用 `==` 比较，零分配）。
    var fVarNames: List<String> = arrayListOf<String>()

    /// 同名**不同类型**遮蔽时的槽位序号（每函数重置）。
    ///
    /// 同一函数内不同作用域可以重名声明不同类型的局部变量
    /// （`Parser.parsePrimary` 里 StringLiteral 分支的 `val lit: Int` 与
    /// 兜底分支的 `val lit: String`）。LLVM 不允许同函数内 alloca 重名，
    /// 故遮蔽时为后一个声明另开 `%<name>.addr<N>`。
    var fVarSlotSeq: Int = 0

    /// 模块内用户函数签名表（每项 `name|retTy|paramTy1,paramTy2`）。
    var fSigList: List<String> = arrayListOf<String>()

    /// `fSigList` 的并行「函数名」键列（零分配查询）。
    var fSigNames: List<String> = arrayListOf<String>()

    /// 方法所属类的并行键列（`fnId` 的十进制串 → `ClassName`；供 `this`/接收者类型解析）。
    ///
    /// 键存 `String` 而非 `Int`：Rust AOT 后端不支持「List 元素与 Int 直接比较」
    /// （会生成 `icmp eq i8*, i32` 非法 IR），字符串键列则可走内容比较。
    var fOwnerIdStrs: List<String> = arrayListOf<String>()
    var fOwnerClasses: List<String> = arrayListOf<String>()

    /// object 类名集合（换行分隔）：object 内的方法是静态方法，无隐式 receiver。
    ///
    /// Phase B 修复：`object Math { fun sin(x: Float): Float }` 中的 `sin` 是静态方法，
    /// 不应有 `%struct.Math*` receiver 参数。此前 functionSignature 对所有 owner 方法
    /// 都加 receiver，导致 `Math.sin(1.0f)` 生成 `call void @sin(i32 %Math, ...)` 非法 IR。
    var fObjectClassNames: String = ""

    /// `inferType` 记忆化缓存（按 HIR 节点 id 索引）。
    ///
    /// 同一节点在一次发射中常被反复推断（`inferType(x)` 之后 `emitExpr(x)`/`coerceValue`
    /// 内部再次推断），每次推断都要构造若干临时串；AOT 无 GC，重复推断的中间串全部驻留。
    var fInferCache: List<String> = arrayListOf<String>()

    /// 用户函数的形参节点表（每行 `fname|id1,id2,…`）。
    ///
    /// 供调用点补齐**默认参数**：调用实参少于形参时，用形参节点 kids[0] 的
    /// 默认值表达式填充（否则生成的 `call` 实参数与 `define` 形参数不一致，
    /// llc 直接报错）。方法（有隐式 self）在表首插入 `-1` 占位，与签名表对齐。
    var fParamDefs: List<String> = arrayListOf<String>()

    /// `fInferCache` 的并行**代际**列（十进制串；仅同代命中有效）。
    ///
    /// 用「代际」而非布尔：`inferType` 依赖当前函数状态（局部变量表 / 所属类），
    /// 换函数即换代，避免跨函数复用错误结果。存 `String` 而非 `Int`：Rust AOT 后端
    /// 不支持「List 元素与 Int 直接比较」。
    var fInferGenStrs: List<String> = arrayListOf<String>()
    var fGen: Int = 0
    var fGenStr: String = "-1"

    // ── lambda / 闭包（Phase B.2）──

    /// 生成 lambda 静态函数的计数器（`__lambda_N`）。
    var lambdaCount: Int = 0

    /// lambda 静态函数 IR 片段（模块末尾统一输出）。
    ///
    /// 不能在 `emitFunction` 内直接追加到 `funcParts`：`emitLambda` 会把
    /// 「当前函数的状态」暂时换成 lambda 自身再恢复，两种 IR 不能混在同一缓冲里。
    var lambdaParts: EmitBuffer = EmitBuffer()

    /// 闭包变量表（每行 `name|retTy|p1,p2`）。
    ///
    /// 调用点据此把 `f(args)` 发射为间接调用 `call <ret> %fn(env, args)`。
    /// 每函数重置（`emitFunction` 里清空）。
    var fClosureSigs: String = ""

    /// `fSigList` 的并行「Aura 返回类型」列（`Int` / `String` / `(Int) -> Int`）。
    ///
    /// 调用点需要知道「被调用函数是否返回**函数类型**」，以便把返回值登记成
    /// 闭包变量（`val f = makeAdder(5)` → `f(10)` 走间接调用）。LLVM 侧两者
    /// 都是 `i8*`（String / Any / List / 闭包），只看 `retTy` 无法区分，故保留
    /// Aura 类型串。
    var fSigAuraRets: List<String> = arrayListOf<String>()

    /// 顶层 `val`/`var` 闭包变量表（每行 `name|retTy|p1,p2`）。
    ///
    /// AOT 不支持顶层可变字段的直接初始化，故每个这样的变量发射成
    /// `@<name> = global i8* null` + 惰性初始化函数 `@<name>__init()`
    /// （首次访问时构造闭包 env 并写入全局，之后直接返回）。
    /// 与 `fClosureSigs` 不同：本表跨函数有效（模块级）。
    var fGlobalClosures: String = ""

    /// 全局闭包惰性初始化 IR 片段（模块末尾统一输出）。
    var globalParts: EmitBuffer = EmitBuffer()

    /// 当前 lambda 捕获的外层变量表（每行 `name|llvmTy`）。
    ///
    /// 闭包环境布局：`[0] = 函数指针`，`[1..]` = 按捕获顺序存放的值副本。
    /// 进入 lambda 时登记，发射 body 内引用时按槽位从 env 读取。
    var fCapturedVars: String = ""

    /// `enterLambdaCtx` 的字段备份（lambda 嵌套超过一层时用于还原）。
    var svCapturedVars: String = ""

    // ── 签名表缓存 ──
    //
    // `runtimeTable()` / `cffiTable()` / `preludeTable()` 都是
    // 由数百段字符串字面量 `+` 拼接而成（Aura 侧字符串拼接**不**做常量折叠），每次
    // 调用都会重新分配整张表。
    // 表内容在单次 `emitProgram` 内恒定，故在此缓存一次，查询只读缓存串。
    var fRtTable: String = ""
    var fCffiTable: String = ""
    var fPreTable: String = ""

    /// 类型别名表（`Alias|Target`，每行一项；供 `typealias` 解析）。
    var fTypeAliases: String = ""

    /// `extern object` 内 **带函数体** 的方法 id 集合（每行 `\n<id>\n`）。
    ///
    /// `extern object` 的成员语义是「外部符号（C ABI）声明」，名字即符号名；
    /// 其 `fun` 体不应发射为 `define`——否则既与运行时已经 `declare` 的同名
    /// libc 符号（如 `malloc` / `free`）冲突（llc: invalid redefinition），
    /// 也与 Rust 侧后端行为不一致（Rust 侧只发射 declare、调用直接落 C 符号）。
    var fExternFnIds: String = ""

    /// `extern object` 对象名清单（换行分隔，已 sanitize）。
    ///
    /// 用途：`FileOps.open(path, flags)` 这类**外部对象成员调用**的符号是裸成员名
    /// （C ABI，无 self）。调用点必须据此**跳过 kids[0]**（对象名不是实参）；
    /// 否则对象名会被当作表达式求值成 `0` 占住第 1 个实参位，实参整体后移一格
    ///（`_open(path, flags)` 收到 `(0, path, flags)` → CRT 无效参数 fail-fast
    /// 0xC0000409）。
    var fExternObjNames: String = ""

    /// 本模块**已有 `define`** 的函数符号名（换行分隔）。
    ///
    /// 用途：`runtimeDeclarationsEx` 据此跳过同名 `declare` —— 同一符号既有
    /// `define` 又有 `declare` 时 llc 报
    /// `invalid redefinition of function 'toString'`（编译器自身源码里定义了
    /// `toString(x: Any)`，而 `preludeTable` 又声明了 C 符号 `toString`）。
    var fDefNames: String = ""

    /// 已发射的 @native 包装器符号（每行 `\n<sym>\n`）。
    ///
    /// HIR 里可能出现同名（内容不完整、也从不被调用）的 `HirNativeFunction`
    /// 节点（如 extern object 容器名 `Memory` / `Syscalls`），重复 `define`
    /// 会被 llc 拒绝（invalid redefinition of function）。首个定义胜出。
    var fNativeSyms: String = ""

    /// 用户结构体字段表（每项 `Sym|field|llvmTy|initLLVM|initExprId`）。
    var structLines: List<String> = arrayListOf<String>()

    /// 集合（List/Array/Set/Map）局部变量名（换行分隔）。
    ///
    /// 发射器内部把 String 与集合统一表示为 `i8*`，`.size` / `.add` / `for-in`
    /// 必须区分二者：String 用 `aura_strlen`，集合用 `aura_lang_std_Collections_*`。
    /// 声明处（`val lst = arrayListOf<...>()` 等）登记，使用处按名查询。
    var fListVars: String = ""

    /// 当前函数 LLVM 返回类型。
    var fRetTy: String = "void"

    /// 当前方法所属类名（非方法时为空；供裸字段名解析为 `this.field`）。
    var fCurClass: String = ""

    /// 当前循环的 break / continue 目标标签（Phase 6.5：break/continue 支持）。
    /// 进入循环时保存外层值、设置内层值，退出时还原（天然支持嵌套）。
    var loopEnd: String = ""
    var loopCond: String = ""

    /// 当前位置是否已终结（ret/br）。
    var fTerminated: Boolean = false

    init() {
        this.targetTriple = "x86_64-pc-windows-msvc"
        this.moduleName = "main"
        this.linkRuntime = true
        this.emitDebug = false
        this.tm = TypeMapper()
        this.reset()
    }

    // ── 生命周期 ──

    /// 重置全部累积状态。
    fun reset() {
        this.varCount = 0
        this.bbCount = 0
        this.strCount = 0
        this.stringParts.sbReset()
        this.structParts.sbReset()
        this.funcParts.sbReset()
        this.structDeclared = ""
        this.structConcrete = ""
        this.fAlloca.sbReset()
        this.fBody.sbReset()
        this.fVarList = arrayListOf<String>()
        this.fVarNames = arrayListOf<String>()
        this.fSigList = arrayListOf<String>()
        this.fSigNames = arrayListOf<String>()
        this.fSigAuraRets = arrayListOf<String>()
        this.fParamDefs = arrayListOf<String>()
        this.fOwnerIdStrs = arrayListOf<String>()
        this.fOwnerClasses = arrayListOf<String>()
        this.fInferCache = arrayListOf<String>()
        this.fInferGenStrs = arrayListOf<String>()
        this.fGen = 0
        this.fGenStr = "-1"
        this.fTypeAliases = ""
        this.fExternFnIds = ""
        this.fExternObjNames = ""
        this.fDefNames = ""
        this.fNativeSyms = ""
        this.structLines = arrayListOf<String>()
        this.fListVars = ""
        this.fRetTy = "void"
        this.fCurClass = ""
        this.loopEnd = ""
        this.loopCond = ""
        this.fTerminated = false
        this.lambdaCount = 0
        this.lambdaParts = EmitBuffer()
        this.fClosureSigs = ""
        this.fGlobalClosures = ""
        this.globalParts = EmitBuffer()
        this.fCapturedVars = ""
        this.svCapturedVars = ""
    }

    /// 生成新 SSA 临时变量名。
    fun freshVar(): String {
        val name: String = "%var." + toStr(this.varCount)
        this.varCount = this.varCount + 1
        return name
    }

    /// 生成新基本块标签。
    fun freshBb(prefix: String): String {
        val name: String = "bb_" + prefix + "_" + toStr(this.bbCount)
        this.bbCount = this.bbCount + 1
        return name
    }

    // ── 顶层入口 ──

    /// 将 HIR 程序生成为完整 LLVM IR 模块文本。
    fun emitProgram(hir: Hir, moduleName: String, target: String): String {
        return emitProgramEx(hir, moduleName, target, "")
    }

    fun emitProgramEx(hir: Hir, moduleName: String, target: String, basePath: String): String {
        this.reset()
        this.moduleName = moduleName
        this.targetTriple = target
        this.basePath = basePath
        // 签名表只构建一次（见字段注释：每次重建是发射期头号泄漏源）。
        this.fRtTable = runtimeTable()
        this.fCffiTable = cffiTable()
        this.fPreTable = preludeTable()

        // 0) inferType 记忆化表按节点数预置（查询零分配；必须**先备足**，
        //    否则越界写入会走 listSet 的“追加”路径，破坏与 id 的一一对应）。
        var ci: Int = 0
        while (ci < hir.count) {
            this.fInferCache.add("")
            this.fInferGenStrs.add("")
            ci = ci + 1
        }

        // 1) 结构体类型定义（含字段布局，Phase 6.5.1）
        // 1.0) 先建「类名 → 节点」表：继承布局需要**先登记父类**（见 registerStruct）
        var i: Int = 0
        while (i < hir.count) {
            val k: String = hir.kindOf(i)
            if (k == "HirStruct" || k == "HirClass" || k == "HirObject" || k == "HirEnum") {
                val nm: String = hir.textOf(i)
                if (nm != "" && !aotContains(this.fClassNodes, "\n" + nm + "|")) {
                    this.fClassNodes = this.fClassNodes + "\n" + nm + "|" + toStr(i)
                }
            }
            i = i + 1
        }
        i = 0
        while (i < hir.count) {
            val k: String = hir.kindOf(i)
            if (k == "HirStruct" || k == "HirClass" || k == "HirObject" || k == "HirEnum") {
                this.registerStruct(hir, i)
            }
            i = i + 1
        }

        // 1.5) 方法所属类表：类体 Block 中的 HirFunction → 该类名（供 this/接收者）
        i = 0
        while (i < hir.count) {
            val ck: String = hir.kindOf(i)
            if (ck == "HirStruct" || ck == "HirClass" || ck == "HirObject" || ck == "HirEnum") {
                val clsName: String = hir.textOf(i)
                // Phase B: 记录 object 类名（object 内方法是静态方法，无 receiver）
                if (ck == "HirObject") {
                    if (!aotListContains(this.fObjectClassNames, clsName)) {
                        this.fObjectClassNames = this.fObjectClassNames + clsName + "\n"
                    }
                }
                val cKids: String = hir.kidsOf(i)
                val cn: Int = hirKidsCount(cKids)
                var j: Int = 0
                while (j < cn) {
                    val bodyId: Int = hirKidsAt(cKids, j)
                    if (hir.kindOf(bodyId) == "HirBlock") {
                        val bk: String = hir.kidsOf(bodyId)
                        val bn: Int = hirKidsCount(bk)
                        var m: Int = 0
                        while (m < bn) {
                            val mid: Int = hirKidsAt(bk, m)
                            if (hir.kindOf(mid) == "HirFunction") {
                                this.fOwnerIdStrs.add(toStr(mid))
                                this.fOwnerClasses.add(clsName)
                            }
                            m = m + 1
                        }
                    }
                    j = j + 1
                }
            }
            i = i + 1
        }

        // 1.55) `extern object` 内带函数体的方法：登记后跳过发射（见字段注释）。
        //       `extern object` 成员按外部 C 符号处理，只保留运行时 `declare`。
        //       同时登记**对象名**：调用点 `FileOps.open(p, f)` 需要据此跳过接收者
        //       占位（对象名不是实参！），否则实参整体后移一格。
        i = 0
        while (i < hir.count) {
            if (hir.kindOf(i) == "HirExternObject") {
                val ek: String = hir.kidsOf(i)
                val en: Int = hirKidsCount(ek)
                val ename: String = sanitizeLlvm(hir.textOf(i))
                if (ename != "") {
                    this.fExternObjNames = this.fExternObjNames + "\n" + ename + "\n"
                }
                var j: Int = 0
                while (j < en) {
                    val mid: Int = hirKidsAt(ek, j)
                    if (hir.kindOf(mid) == "HirFunction") {
                        this.fExternFnIds = this.fExternFnIds + "\n" + toStr(mid) + "\n"
                    }
                    j = j + 1
                }
            }
            i = i + 1
        }

        // 1.6) 类型别名表（`HirTypealias` 文本为 `Name = Target`）
        i = 0
        while (i < hir.count) {
            if (hir.kindOf(i) == "HirTypealias") {
                val t: String = hir.textOf(i)
                val eq: Int = EmitUtils.aotIndexOfSub(t, " = ")
                if (eq > 0) {
                    val an: String = aotSlice(t, 0, eq)
                    val at: String = aotSlice(t, eq + 3, t.length - eq - 3)
                    if (an != "" && at != "") {
                        this.fTypeAliases = this.fTypeAliases + an + "|" + at + "\n"
                    }
                }
            }
            i = i + 1
        }

        // 2) 用户函数签名表（调用点返回类型/参数类型对齐，Phase 6.5.1）
        //
        // `fSigAuraRets` 存 **Aura** 返回类型（`Int` / `(Int) -> Int` …）：
        // 闭包与 String / List 在 LLVM 侧同形（都是 `i8*`），只有 Aura 类型能
        // 区分「这个调用返回的是不是函数」→ 见 `callFnSig`。
        i = 0
        while (i < hir.count) {
            val k: String = hir.kindOf(i)
            if (k == "HirFunction" || k == "HirAotDecl") {
                val sigTmp: String = this.functionSignature(hir, i)
                this.registerSig(aotFieldAt(sigTmp, 0, "|"), sigTmp, hir.tyOf(i))
                // 方法定义表（OwnerSym|method|nodeId）：继承方法特化需要
                if (k == "HirFunction") {
                    // 登记「已 define 的符号」：供 `runtimeDeclarationsEx` 过滤同名
                    // `declare`（同名 define+declare 会被 llc 判为重定义）。
                    this.fDefNames = this.fDefNames + aotFieldAt(sigTmp, 0, "|") + "\n"
                    val own2: String = this.methodOwnerClass(i)
                    if (own2 != "") {
                        this.fMethodNodes = this.fMethodNodes + sanitizeLlvm(own2) + "|"
                            + hir.textOf(i) + "|" + toStr(i) + "\n"
                    }
                }
                // 形参节点表（供调用点补齐默认参数）：`fname|id1,id2,…`
                this.registerParamDefs(hir, i)
            } else if (k == "HirNativeFunction") {
                // @native 函数：签名必须与实际发射的包装器一致（syscall 统一 i64）
                val sigTmp: String = this.nativeFunctionSignature(hir, i)
                this.registerSig(aotFieldAt(sigTmp, 0, "|"), sigTmp, "")
            }
            i = i + 1
        }

        // 2.5) 继承方法特化**规划**：先把 `Child.m` 签名登记进签名表，
        //      再发射任何函数体（否则调用点在解析时看不到 `Child.m`）
        this.planInheritedMethods()
        // 2.6) 动态派发规划：方法槽位表（按方法名全局编号）
        this.planVtables(hir)

        // 2.7) 顶层闭包变量（`val f: (Int) -> Int = x -> x * 2`）：
        //      发射 `@f = global i8* null` + 惰性初始化函数，必须在任何函数体发射
        //      之前登记（调用点 `f(21)` 需查 `fGlobalClosures`）。
        //      仅处理**根节点**（HirProgram）的直接子节点——函数体内的声明由
        //      `emitDecl` 走局部路径，不在此列。
        //      HIR 节点类型为 `HirValDecl` / `HirVarDecl`（非 `HirVal`/`HirVar`）。
        i = 0
        val rootKids: String = hir.kidsOf(hir.rootId)
        while (i < hirKidsCount(rootKids)) {
            val rid: Int = hirKidsAt(rootKids, i)
            val rk: String = hir.kindOf(rid)
            if (rk == "HirValDecl" || rk == "HirVarDecl") {
                val rKids: String = hir.kidsOf(rid)
                if (hirKidsCount(rKids) > 0) {
                    val initId: Int = hirKidsAt(rKids, 0)
                    val rkKind: String = hir.kindOf(initId)
                    if (rkKind == "HirLambda") {
                        this.emitGlobalClosure(hir, rid, initId)
                    } else if (rkKind == "HirCall") {
                        val cs: String = this.callFnSig(hir, initId)
                        if (cs != "") {
                            this.emitGlobalClosure(hir, rid, initId)
                        }
                    }
                }
            }
            i = i + 1
        }

        // 3) 函数定义
        i = 0
        while (i < hir.count) {
            if (hir.kindOf(i) == "HirFunction") {
                // `extern object` 成员按外部 C 符号处理（只 declare，不 define）
                if (!aotContains(this.fExternFnIds, "\n" + toStr(i) + "\n")) {
                    this.emitFunction(hir, i)
                }
            }
            i = i + 1
        }

        // 3.2) 继承方法特化：按计划发射祖先方法体的子类副本
        this.emitInheritedMethods(hir)

        // 3.5) FFI 发射：@native 包装器（syscall/asm/内置）与 @aot 声明
        val ffiDecls: EmitBuffer = EmitBuffer()
        i = 0
        while (i < hir.count) {
            val k: String = hir.kindOf(i)
            if (k == "HirNativeFunction") {
                this.emitNativeWrapper(hir, i)
            } else if (k == "HirAotDecl") {
                ffiDecls.sbAdd(this.aotDeclLine(hir, i))
            }
            i = i + 1
        }
        // 4) 组装模块（原生缓冲区：避免对已累积的整串反复 `+` 拷贝）
        val out: EmitBuffer = EmitBuffer()
        out.sbAdd("; ModuleID = '" + moduleName + "'\n")
        out.sbAdd("source_filename = \"" + moduleName + "\"\n")
        out.sbAdd("target triple = \"" + target + "\"\n")
        out.sbAdd("target datalayout = \"" + EmitUtils.dataLayout(target) + "\"\n\n")
        // 动态派发降级提示（无降级时为空串，不影响既有输出）
        val vtNotes: String = this.vtableNotesHeader()
        if (vtNotes != "") {
            out.sbAdd(vtNotes)
            // 同时给一行可见提示：静默降级会让「动态派发没生效」难以定位
            println("[aura] vtable: " + toStr(this.fVtableNoteCount)
                + " 处同名方法因链内签名不一致退回静态绑定（详见 IR 头部 vtable notes）")
        }
        val structIr: String = this.structParts.sbBuild()
        if (structIr != "") {
            out.sbAdd("; ---- Struct Types ----\n")
            out.sbAdd(structIr)
            out.sbAdd("\n")
        }
        // object 单例实例：object 方法有隐式 self 形参，调用点此前一律传 `null`，
        // 一旦方法体访问 object 字段（如 `totalAllocs = totalAllocs + 1`、
        // `this.kwTable = …`）就会**空指针解引用**（0xC0000005）。
        // 这里为每个 object 发射零初始化单例全局，调用点改传它的地址。
        if (this.fObjectClassNames != "") {
            out.sbAdd("; ---- Object Singletons ----\n")
            var oi: Int = 0
            val on: Int = aotLineCount(this.fObjectClassNames)
            while (oi < on) {
                val osym: String = sanitizeLlvm(aotLineAt(this.fObjectClassNames, oi))
                if (osym != "" && aotListContains(this.structConcrete, osym)) {
                    out.sbAdd("@aura_obj_" + osym + " = internal global %struct."
                        + osym + " " + this.singletonInit(osym) + "\n")
                }
                oi = oi + 1
            }
            out.sbAdd("\n")
        }
        // vtable 常量（动态派发；每个具体类一张，index 0 的 vptr 指向它）
        val vtIr: String = this.vtableSection()
        if (vtIr != "") {
            out.sbAdd("; ---- Vtables ----\n")
            out.sbAdd(vtIr)
            out.sbAdd("\n")
        }
        val stringIr: String = this.stringParts.sbBuild()
        if (stringIr != "") {
            out.sbAdd("; ---- String Constants ----\n")
            out.sbAdd(stringIr)
            out.sbAdd("\n")
        }
        if (this.linkRuntime) {
            out.sbAdd(runtimeDeclarationsEx(this.fDefNames, this.basePath))
            out.sbAdd("\n")
        }
        if (this.emitDebug) {
            val di: DebugInfo = DebugInfo(moduleName, ".", true)
            out.sbAdd(debugMetadata(di))
            out.sbAdd(debugSubroutineType())
            out.sbAdd("\n")
        }
        val ffiDeclIr: String = ffiDecls.sbBuild()
        if (ffiDeclIr != "") {
            out.sbAdd(ffiDeclIr)
            out.sbAdd("\n")
        }
        // 顶层闭包变量（`val f: (Int) -> Int = x -> x * 2`）：
        // 每个闭包变量发射 `@f = global i8* null` + 惰性初始化函数 `@f__init()`。
        // 必须在 funcParts 之前：函数体内引用 `@f__init()` 时需要该符号可见。
        if (this.fGlobalClosures != "") {
            out.sbAdd("; ---- Top-level Closures ----\n")
            val gcLines: List<String> = this.fGlobalClosures.split("\n")
            var gci: Int = 0
            while (gci < gcLines.size) {
                val gln: String = gcLines[gci]
                gci = gci + 1
                if (gln == "") {
                    continue
                }
                val gname: String = sanitizeLlvm(aotFieldAt(gln, 0, "|"))
                if (gname != "") {
                    out.sbAdd("@" + gname + " = global i8* null\n")
                }
            }
            val gIr: String = this.globalParts.sbBuild()
            if (gIr != "") {
                out.sbAdd(gIr)
            }
            out.sbAdd("\n")
        }
        out.sbAdd(this.funcParts.sbBuild())
        // lambda 静态函数（闭包体）：与用户函数同级，模块末尾统一输出
        val lambdaIr: String = this.lambdaParts.sbBuild()
        if (lambdaIr != "") {
            out.sbAdd("; ---- Lambda Functions ----\n")
            out.sbAdd(lambdaIr)
            out.sbAdd("\n")
        }
        return out.sbBuild()
    }

    // ── 结构体（Phase 6.5.1：以指针表示实例 + 真实字段布局）──

    /// 登记一个用户结构体：抽取字段布局（名/类型/默认值），并发射 LLVM 结构体类型。
    ///
    /// HIR 形状：`HirStruct(name, kids=[HirBlock(kids=[HirVarDecl/HirValDecl...])])`。
    fun registerStruct(hir: Hir, id: Int) {
        val name: String = hir.textOf(id)
        if (name == "") {
            return
        }
        val sym: String = sanitizeLlvm(name)
        if (aotListContains(this.structDeclared, sym)) {
            // 已登记（外层循环与父类递归可能重复到达）：直接返回，
            // 否则 structLines 会出现重复字段行 → 字段序号错乱
            return
        }
        val kids: String = hir.kidsOf(id)
        // 基类登记（`HirClass` 的 ty 列，见 Hir.lowerTypeDecl / Parser.parseTypeDecl）
        val parentTy: String = hir.tyOf(id)
        if (parentTy != "") {
            val psym0: String = sanitizeLlvm(parentTy)
            if (!aotContains(this.fParents, "\n" + sym + "|")) {
                // 每项形如 `\nChild|Parent\n`：查找可只用 substringAfter，零 List 分配
                this.fParents = this.fParents + "\n" + sym + "|" + psym0 + "\n"
            }
            // 父类必须**先**登记：子类布局 = 父类字段前缀 + 自有字段，
            // 且 vtable 槽位继承自父类
            if (!aotListContains(this.structDeclared, psym0)) {
                val pid: Int = this.classNodeOf(parentTy)
                if (pid >= 0 && pid != id) {
                    this.registerStruct(hir, pid)
                }
            }
        }
        var fieldTys: String = ""
        // 继承布局：把祖先字段前置登记到子类名下（`x.b` 才能读到父类字段）
        if (parentTy != "") {
            fieldTys = this.inheritFields(sym, sanitizeLlvm(parentTy))
        }
        if (hirKidsCount(kids) > 0) {
            val body: Int = hirKidsAt(kids, 0)
            val bodyKind: String = hir.kindOf(body)
            var fields: String = ""
            if (bodyKind == "HirBlock") {
                fields = hir.kidsOf(body)
            }
            val fn: Int = hirKidsCount(fields)
            var fi: Int = 0
            while (fi < fn) {
                val fid: Int = hirKidsAt(fields, fi)
                val fk: String = hir.kindOf(fid)
                if (fk == "HirVarDecl" || fk == "HirValDecl") {
                    val fname: String = hir.textOf(fid)
                    var lty: String = this.mapTy(hir.tyOf(fid))
                    if (lty == "" || lty == "void") {
                        lty = "i32"
                    }
                    val init: String = this.fieldDefault(hir, fid, lty)
                    val initExpr: Int = this.fieldInitExprId(hir, fid)
                    if (fieldTys != "") {
                        fieldTys = fieldTys + ", "
                    }
                    fieldTys = fieldTys + lty
                    this.structLines.add(sym + "|" + fname + "|" + lty
                        + "|" + init + "|" + toStr(initExpr) + "|" + hir.tyOf(fid))
                }
                fi = fi + 1
            }
        }
        if (aotListContains(this.structDeclared, sym)) {
            return
        }
        this.structDeclared = this.structDeclared + sym + "\n"
        if (fieldTys == "") {
            if (hirKidsCount(kids) == 0) {
                // 完全无体的前向声明：保持 opaque
                this.structParts.sbAdd("%struct.")
                this.structParts.sbAdd(sym)
                this.structParts.sbAdd(" = type opaque\n")
            } else {
                // 有体但无字段的类（只有方法 / init）：需可 alloca 的具体类型。
                // index 0 固定为 vptr（动态派发）。
                this.structParts.sbAdd("%struct.")
                this.structParts.sbAdd(sym)
                this.structParts.sbAdd(" = type { i8* }\n")
                this.structConcrete = this.structConcrete + sym + "\n"
            }
        } else {
            this.structParts.sbAdd("%struct.")
            this.structParts.sbAdd(sym)
            // **index 0 = vptr**（vtable 指针），数据字段从 index 1 开始。
            // 放头部保证父子类 vptr 偏移一致（真动态派发的前提）。
            this.structParts.sbAdd(" = type { i8*, ")
            this.structParts.sbAdd(fieldTys)
            this.structParts.sbAdd(" }\n")
            this.structConcrete = this.structConcrete + sym + "\n"
        }
    }

    /// 动态派发规划：按**方法名**全局编号 vtable 槽位。
    ///
    /// 同一名字在所有类的 vtable 中同槽，调用点于是可以只按「静态接收者类型 +
    /// 方法名」算出槽位，运行期从实例的 vptr 取到真实类的 vtable → 间接调用，
    /// 从而实现父类静态类型接收者的正确派发（`val a: Animal = Dog(); a.name()`）。
    fun planVtables(hir: Hir) {
        // 1) 收集 `Class|method` 全表
        var i: Int = 0
        while (i < hir.count) {
            if (hir.kindOf(i) == "HirFunction") {
                val owner: String = this.methodOwnerClass(i)
                val fname: String = hir.textOf(i)
                if (owner != "" && fname != "" && fname != "init") {
                    val osym: String = sanitizeLlvm(owner)
                    if (!aotContains(this.fClassMethods, "\n" + osym + "|" + fname + "\n")) {
                        this.fClassMethods = this.fClassMethods + "\n" + osym + "|" + fname + "\n"
                    }
                }
            }
            i = i + 1
        }
        // 2) **只有会被重写的名字才需要槽位**：某个祖先类与某子类都定义了同名方法。
        //    这样 vtable 尺寸 = 程序里真正的 override 数量（编译器自身几乎为 0），
        //    既省内存又省 IR 体积；其余方法仍走静态绑定（语义等价）。
        val clsLines: List<String> = this.fClassMethods.split("\n")
        var ci: Int = 0
        while (ci < clsLines.size) {
            val line: String = clsLines[ci]
            val c: String = aotFieldAt(line, 0, "|")
            val m: String = aotFieldAt(line, 1, "|")
            if (c != "" && m != "") {
                var anc: String = this.parentOfClass(c)
                var dep: Int = 0
                while (anc != "" && dep < 16) {
                    if (aotContains(this.fClassMethods, "\n" + anc + "|" + m + "\n")) {
                        // 链内签名必须一致（否则不是 override，退回静态绑定）
                        if (this.slotOf(m) < 0) {
                            if (this.chainSigConsistent(c, m)) {
                                this.fMethodSlots = this.fMethodSlots + m + "|"
                                    + toStr(this.slotTotal()) + "\n"
                            } else {
                                // **非 override 的同名遮蔽**：不分配槽位，调用点按静态
                                // 接收者类型直接绑定。语义安全，但会静默丢掉动态派发；
                                // 记录之，避免排障时无从下手。
                                if (!aotContains(this.fVtableNotes,
                                    c + "|" + m + "|" + anc + "\n")) {
                                    this.fVtableNotes = this.fVtableNotes + c + "|" + m
                                        + "|" + anc + "\n"
                                    this.fVtableNoteCount = this.fVtableNoteCount + 1
                                }
                            }
                        }
                    }
                    anc = this.parentOfClass(anc)
                    dep = dep + 1
                }
            }
            ci = ci + 1
        }
    }

    /// 继承链上同名方法的**签名是否一致**（忽略 self 形参）。
    ///
    /// vtable 间接调用按静态接收者的签名发射 call 指令，若链内同名方法参数表/
    /// 返回类型不一致（那不是 override，只是同名遮蔽），间接调用会签名错配。
    /// 此时该名字**不分配槽位**，退回静态绑定（语义安全）。
    fun chainSigConsistent(cls: String, m: String): Boolean {
        var firstRet: String = ""
        var firstRest: String = ""
        var have: Boolean = false
        var cur: String = cls
        var depth: Int = 0
        while (cur != "" && depth < 16) {
            val s: String = this.funcSignatureOf(cur + "_" + m)
            if (s != "") {
                val rt: String = aotFieldAt(s, 1, "|")
                val ps: String = aotFieldAt(s, 2, "|")
                var rest: String = ""
                val pn: Int = aotCsvCount(ps)
                var pi: Int = 1
                while (pi < pn) {
                    if (rest != "") {
                        rest = rest + ","
                    }
                    rest = rest + trimSpaces(aotFieldAt(ps, pi, ","))
                    pi = pi + 1
                }
                if (!have) {
                    firstRet = rt
                    firstRest = rest
                    have = true
                } else {
                    if (rt != firstRet || rest != firstRest) {
                        return false
                    }
                }
            }
            cur = this.parentOfClass(cur)
            depth = depth + 1
        }
        return true
    }

    /// 动态派发降级清单 → IR 注释块（空清单返回 ""）。
    ///
    /// 形如：
    /// ```llvm
    /// ; ---- vtable notes ----
    /// ; static-binding fallback: Child.m / ancestor Base (signature mismatch)
    /// ```
    fun vtableNotesHeader(): String {
        if (this.fVtableNotes == "") {
            return ""
        }
        var out: String = "; ---- vtable notes ----\n"
        // 用 `aotFieldAt(...)` 扫描行（不依赖 `split(...).size`）
        var i: Int = 0
        while (i < this.fVtableNoteCount) {
            val ln: String = aotFieldAt(this.fVtableNotes, i, "\n")
            val c: String = aotFieldAt(ln, 0, "|")
            if (c != "") {
                out = out + "; static-binding fallback: " + c + "."
                    + aotFieldAt(ln, 1, "|") + " / ancestor "
                    + aotFieldAt(ln, 2, "|")
                    + " (同链同名但签名不一致，非 override)\n"
            }
            i = i + 1
        }
        return out + "\n"
    }

    /// 方法名 → 槽位（未登记返回 -1）。
    fun slotOf(name: String): Int {
        if (name == "" || this.fMethodSlots == "") {
            return -1
        }
        val lines: List<String> = this.fMethodSlots.split("\n")
        var i: Int = 0
        while (i < lines.size) {
            if (aotFieldAt(lines[i], 0, "|") == name) {
                return aotToInt(aotFieldAt(lines[i], 1, "|"))
            }
            i = i + 1
        }
        return -1
    }

    /// 槽位 j 的方法名（越界返回 ""）。
    fun slotName(j: Int): String {
        if (this.fMethodSlots == "") {
            return ""
        }
        val lines: List<String> = this.fMethodSlots.split("\n")
        var i: Int = 0
        while (i < lines.size) {
            if (aotToInt(aotFieldAt(lines[i], 1, "|")) == j) {
                return aotFieldAt(lines[i], 0, "|")
            }
            i = i + 1
        }
        return ""
    }

    /// 槽位总数。
    fun slotTotal(): Int {
        if (this.fMethodSlots == "") {
            return 0
        }
        val lines: List<String> = this.fMethodSlots.split("\n")
        var c: Int = 0
        var i: Int = 0
        while (i < lines.size) {
            if (lines[i] != "") {
                c = c + 1
            }
            i = i + 1
        }
        return c
    }

    /// 按**方法名**沿继承链找最近的实现类（不比 arity；未命中返回 ""）。
    fun methodOwnerByName(sym: String, name: String): String {
        var cur: String = sym
        var depth: Int = 0
        while (cur != "" && depth < 16) {
            if (this.funcSignatureOf(cur + "_" + name) != "") {
                return cur
            }
            cur = this.parentOfClass(cur)
            depth = depth + 1
        }
        return ""
    }

    /// 函数指针类型（`i8* (%struct.Dog*)*`），用于 vtable 项 bitcast。
    fun fnPtrTy(sig: String): String {
        val ret: String = aotFieldAt(sig, 1, "|")
        val ps: String = aotFieldAt(sig, 2, "|")
        var out: String = ret + " ("
        val n: Int = aotCsvCount(ps)
        var i: Int = 0
        while (i < n) {
            if (i > 0) {
                out = out + ", "
            }
            out = out + trimSpaces(aotFieldAt(ps, i, ","))
            i = i + 1
        }
        return out + ")*"
    }

    /// 生成全部 vtable 全局常量（每个具体类一个 `[N x i8*]`）。
    ///
    /// 用 `EmitBuffer` 累积（AOT 无 GC，逐段 `+` 是平方级分配 —— 自编译时
    /// 曾因此触发内存上限中止）；槽位名先取成列表，避免每项都 `split` 整表。
    fun vtableSection(): String {
        val total: Int = this.slotTotal()
        if (total <= 0 || this.structDeclared == "") {
            return ""
        }
        val buf: EmitBuffer = EmitBuffer()
        val classes: List<String> = this.structDeclared.split("\n")
        var ci: Int = 0
        while (ci < classes.size) {
            val sym: String = classes[ci]
            if (sym != "" && aotListContains(this.structConcrete, sym)) {
                buf.sbAdd("@vtable.")
                buf.sbAdd(sym)
                buf.sbAdd(" = internal global [")
                buf.sbAdd(toStr(total))
                buf.sbAdd(" x i8*] [")
                var j: Int = 0
                while (j < total) {
                    if (j > 0) {
                        buf.sbAdd(", ")
                    }
                    val mname: String = this.slotName(j)
                    val owner: String = this.methodOwnerByName(sym, mname)
                    if (owner != "") {
                        val sig: String = this.funcSignatureOf(owner + "_" + mname)
                        buf.sbAdd("i8* bitcast (")
                        buf.sbAdd(this.fnPtrTy(sig))
                        buf.sbAdd(" @")
                        buf.sbAdd(sanitizeLlvm(owner + "_" + mname))
                        buf.sbAdd(" to i8*)")
                    } else {
                        buf.sbAdd("i8* null")
                    }
                    j = j + 1
                }
                buf.sbAdd("]\n")
            }
            ci = ci + 1
        }
        return buf.sbBuild()
    }

    /// 为每个子类发射祖先方法的**特化副本** `Child.m`（继承方法派发）。
    ///
    /// 背景：方法体按**静态**所属类编译，`Animal.describe()` 里的 `this.name()`
    /// 只会解析到 `Animal_name`；而调用点若接收者是具体子类对象，就会走这条静态
    /// 路径（Kotlin/Java 语义应派发到 `Dog_name`）。
    ///
    /// 做法：把祖先方法体按子类重新发射一份（符号 `Child.m`、`this` 为
    /// `%struct.Child*`、fCurClass = Child）。副本内部的 `this.other()` 于是按
    /// 子类链解析，先命中子类 override —— 得到「按具体类型派发」的效果，
    /// 且**无需改动结构体布局 / 引入 vptr**。
    ///
    /// 限制：仅当接收者静态类型是具体子类时生效；`val a: Animal = Dog()` 这类
    /// 父类静态类型的调用仍是静态解析（真动态派发需要 vptr + vtable）。
    fun planInheritedMethods() {
        if (this.fParents == "" || this.fMethodNodes == "") {
            return
        }
        val classes: List<String> = this.structDeclared.split("\n")
        var ci: Int = 0
        while (ci < classes.size) {
            val cls: String = classes[ci]
            if (cls != "") {
                this.planInheritedForClass(cls)
            }
            ci = ci + 1
        }
    }

    /// 单个类的祖先方法副本**规划**（沿父链逐层，近祖先优先；登记签名）。
    fun planInheritedForClass(cls: String) {
        var anc: String = this.parentOfClass(cls)
        var depth: Int = 0
        while (anc != "" && depth < 16) {
            val nodes: List<String> = this.fMethodNodes.split("\n")
            var i: Int = 0
            while (i < nodes.size) {
                val line: String = nodes[i]
                if (aotFieldAt(line, 0, "|") == anc) {
                    val mname: String = aotFieldAt(line, 1, "|")
                    val nid: Int = aotToInt(aotFieldAt(line, 2, "|"))
                    // 子类已定义同名 → 保留 override；`init` 不继承
                    if (nid >= 0 && mname != "init"
                        && this.funcSignatureOf(cls + "_" + mname) == "") {
                        val psig: String = this.funcSignatureOf(anc + "_" + mname)
                        if (psig != "") {
                            this.fSigList.add(cls + "_" + mname + "|"
                                + aotFieldAt(psig, 1, "|") + "|" + aotFieldAt(psig, 2, "|"))
                            this.fSigNames.add(cls + "_" + mname)
                            this.fInheritPlans = this.fInheritPlans + cls + "|"
                                + toStr(nid) + "\n"
                        }
                    }
                }
                i = i + 1
            }
            anc = this.parentOfClass(anc)
            depth = depth + 1
        }
    }

    /// 按计划发射继承方法副本（符号 `Child.m`，`this` 为 `%struct.Child*`）。
    fun emitInheritedMethods(hir: Hir) {
        if (this.fInheritPlans == "") {
            return
        }
        val plans: List<String> = this.fInheritPlans.split("\n")
        var i: Int = 0
        while (i < plans.size) {
            val cls: String = aotFieldAt(plans[i], 0, "|")
            val nid: Int = aotToInt(aotFieldAt(plans[i], 1, "|"))
            if (cls != "" && nid >= 0) {
                this.fForceOwnerCls = cls
                this.emitFunction(hir, nid)
                this.fForceOwnerCls = ""
            }
            i = i + 1
        }
    }

    /// 类名 → 类型声明节点 id（未命中返回 -1）。
    fun classNodeOf(name: String): Int {
        if (name == "" || this.fClassNodes == "") {
            return -1
        }
        val lines: List<String> = this.fClassNodes.split("\n")
        var i: Int = 0
        while (i < lines.size) {
            if (aotFieldAt(lines[i], 0, "|") == name) {
                return aotToInt(aotFieldAt(lines[i], 1, "|"))
            }
            i = i + 1
        }
        return -1
    }

    /// `sym` 名下是否已登记字段 `fname`。
    fun structFieldDeclared(sym: String, fname: String): Boolean {
        val needle: String = sym + "|" + fname + "|"
        var i: Int = 0
        while (i < this.structLines.size) {
            if (this.structLines[i].startsWith(needle)) {
                return true
            }
            i = i + 1
        }
        return false
    }

    /// 把祖先类 `fromSym` 的字段布局**前置**登记到子类 `sym`。
    ///
    /// 继承布局：`%struct.Dog = type { <Animal 字段…>, <Dog 自有字段…> }`。
    /// 旧实现每个类只含自有字段，父类字段在子类实例上读不到（`x.b` 恒 0）。
    /// 子类已声明同名字段时以子类为准（字段隐藏）。
    /// 返回可拼进 `%struct.X = type { … }` 的类型片段（逗号分隔，可为 ""）。
    fun inheritFields(sym: String, fromSym: String): String {
        if (fromSym == "" || sym == "") {
            return ""
        }
        var out: String = ""
        var i: Int = 0
        while (i < this.structLines.size) {
            val line: String = this.structLines[i]
            if (line.startsWith(fromSym + "|")) {
                val fname: String = aotFieldAt(line, 1, "|")
                if (!this.structFieldDeclared(sym, fname)) {
                    val fty: String = aotFieldAt(line, 2, "|")
                    val finit: String = aotFieldAt(line, 3, "|")
                    val fexpr: String = aotFieldAt(line, 4, "|")
                    val faty: String = aotFieldAt(line, 5, "|")
                    if (out != "") {
                        out = out + ", "
                    }
                    out = out + fty
                    this.structLines.add(sym + "|" + fname + "|" + fty + "|" + finit
                        + "|" + fexpr + "|" + faty)
                }
            }
            i = i + 1
        }
        return out
    }

    /// 结构体字段默认值（取 HIR 字面量初始化；否则用类型零值）。
    fun fieldDefault(hir: Hir, fieldId: Int, lty: String): String {
        val kids: String = hir.kidsOf(fieldId)
        if (hirKidsCount(kids) > 0) {
            val ik: Int = hirKidsAt(kids, 0)
            if (hir.kindOf(ik) == "HirLit") {
                val ity: String = hir.tyOf(ik)
                if (ity == "Double" || ity == "Float") {
                    // 浮点字段默认值：源码字面量可能带类型后缀（`0.0f` / `1.0d`）。
                    // LLVM 词法器不接受该后缀 —— `store float 0.0f, float* %p`
                    // 直接报 `expected ',' after store operand`，整个模块编译失败。
                    return EmitUtils.stripNumberSuffix(hir.textOf(ik))
                }
                if (ity == "Int" || ity == "Long" || ity == "Boolean") {
                    return hir.textOf(ik)
                }
            }
        }
        return EmitUtils.defaultValue(lty)
    }

    /// 字段默认值若为**非字面量表达式**（如 `Lexer("")` / `arrayListOf<String>()`），
    /// 返回其 HIR 节点 id（供构造时求值）；字面量或无初始化返回 -1。
    fun fieldInitExprId(hir: Hir, fieldId: Int): Int {
        val kids: String = hir.kidsOf(fieldId)
        if (hirKidsCount(kids) == 0) {
            return -1
        }
        val ik: Int = hirKidsAt(kids, 0)
        if (hir.kindOf(ik) == "HirLit") {
            // **字符串字面量默认值必须走本路径**（构造时求值）：
            // `fieldDefault` 在登记结构体时执行，拿不到发射器上下文，
            // 无法生成 `@str.N` 常量指针，于是 String 字段被填 `null`
            // → `var s: String = "x"` 读出空串（实测 `Dog.breed` / `p.s` 为空）。
            if (hir.tyOf(ik) == "String") {
                return ik
            }
            return -1
        }
        return ik
    }

    /// 结构体内字段序号（0-based，未命中返回 -1）。
    ///
    /// 前缀扫描取代 `split("\n")`：后者每次查询都分配整张字段表。
    fun structFieldIndex(sym: String, field: String): Int {
        val needle: String = sym + "|"
        var i: Int = 0
        var count: Int = 0
        while (i < this.structLines.size) {
            val line: String = this.structLines[i]
            if (line.startsWith(needle)) {
                if (aotFieldAt(line, 1, "|") == field) {
                    return count
                }
                count = count + 1
            }
            i = i + 1
        }
        return -1
    }

    /// 字段声明的 **Aura 类型**（结构体表第 6 列；未命中返回 ""）。
    ///
    /// LLVM 类型无法区分 `String` 与 `List<T>`（都是 `i8*`），而 `.size`
    /// 语义不同（字节长度 vs 元素个数），故必须保留声明类型。
    fun structFieldAuraTy(sym: String, field: String): String {
        val idx: Int = this.structFieldIndex(sym, field)
        if (idx < 0) {
            return ""
        }
        return aotFieldAt(this.structFieldLineAt(sym, idx), 5, "|")
    }

    /// 接收者是否为集合（`List/Map/Set/Array`）——决定 `.size` 取元素个数
    /// （`Collections_count`）还是字符串字节长度（`aura_strlen`），以及下标
    /// 访问走 `getAt` 还是 `charAt`。
    ///
    /// 旧实现只看「局部变量是否为集合」（`isListVar`），**字段接收者**
    /// （`this.kindList.size`）会落到字符串分支：`.size` 被算成 `strlen`
    /// （元素个数变垃圾值）、下标被算成 `charAt`。自举编译器里
    /// `Parser.n = this.lx.tokenCount()`（= `kindList.size`）因此得到错误
    /// 的 token 数，`prsAdvance` 把 `pos` 钉在 0，解析主循环永不结束并
    /// 每轮分配内存（表现为内存无限增长）。
    fun isCollectionReceiver(hir: Hir, recvId: Int): Boolean {
        if (hir.kindOf(recvId) == "HirVar") {
            val rn: String = hir.textOf(recvId)
            if (this.isListVar(rn)) {
                return true
            }
            // 类方法内的**裸字段名**接收者（`values[i]` / `keys.size`）：按字段
            // 声明类型判定。旧实现只看局部变量表，字段会落到字符串分支
            //（`.size`→strlen、下标→charAt），生成错误 IR。
            if (this.lookupVarTy(rn) == "") {
                val fty: String = this.curClassFieldTy(rn)
                if (fty != "" && EmitUtils.isCollectionTypeName(this.resolveAlias(fty))) {
                    return true
                }
            }
        }
        if (hir.kindOf(recvId) == "HirMember") {
            val mk: String = hir.kidsOf(recvId)
            if (hirKidsCount(mk) >= 1) {
                val recvTy: String = this.inferType(hir, hirKidsAt(mk, 0))
                val sym: String = this.structSymOfPtr(recvTy)
                if (sym != "") {
                    val fty: String = this.structFieldAuraTy(sym, hir.textOf(recvId))
                    if (EmitUtils.isCollectionTypeName(this.resolveAlias(fty))) {
                        return true
                    }
                }
            }
        }
        val ty: String = hir.tyOf(recvId)
        if (ty != "" && EmitUtils.isCollectionTypeName(this.resolveAlias(ty))) {
            return true
        }
        return false
    }

    /// 集合接收者的元素 LLVM 类型（局部变量查登记表、字段查声明类型；
    /// 未知一律按 `i8*` 句柄处理，避免错误的数值解箱）。
    fun receiverElemTy(hir: Hir, recvId: Int): String {
        if (hir.kindOf(recvId) == "HirVar") {
            if (this.isListVar(hir.textOf(recvId))) {
                return this.listElemTy(hir.textOf(recvId))
            }
        }
        if (hir.kindOf(recvId) == "HirMember") {
            val mk: String = hir.kidsOf(recvId)
            if (hirKidsCount(mk) >= 1) {
                val recvTy: String = this.inferType(hir, hirKidsAt(mk, 0))
                val sym: String = this.structSymOfPtr(recvTy)
                if (sym != "") {
                    val fty: String = this.structFieldAuraTy(sym, hir.textOf(recvId))
                    if (EmitUtils.isCollectionTypeName(this.resolveAlias(fty))) {
                        return this.typeArgElemTy(fty)
                    }
                }
            }
        }
        return "i8*"
    }

    /// 结构体第 index 个字段条目（按登记顺序；未命中返回 ""）。
    fun structFieldLineAt(sym: String, index: Int): String {
        val needle: String = sym + "|"
        var i: Int = 0
        var count: Int = 0
        while (i < this.structLines.size) {
            val line: String = this.structLines[i]
            if (line.startsWith(needle)) {
                if (count == index) {
                    return line
                }
                count = count + 1
            }
            i = i + 1
        }
        return ""
    }

    /// 结构体字段总数。
    fun structFieldCount(sym: String): Int {
        val needle: String = sym + "|"
        var i: Int = 0
        var count: Int = 0
        while (i < this.structLines.size) {
            if (this.structLines[i].startsWith(needle)) {
                count = count + 1
            }
            i = i + 1
        }
        return count
    }

    /// 是否已登记该结构体（仅有具体布局者才可构造；`opaque` 前向声明不算）。
    fun isStructSym(sym: String): Boolean {
        // 无字段的类/结构体不会出现在字段表中，但仍已发射具体类型定义
        if (aotListContains(this.structConcrete, sym)) {
            return true
        }
        val needle: String = sym + "|"
        var i: Int = 0
        while (i < this.structLines.size) {
            if (this.structLines[i].startsWith(needle)) {
                return true
            }
            i = i + 1
        }
        return false
    }

    /// 从 `%struct.X*` 反解结构体符号（非结构体指针返回 ""）。
    fun structSymOfPtr(ptrTy: String): String {
        if (!ptrTy.startsWith("%struct.")) {
            return ""
        }
        if (!ptrTy.endsWith("*")) {
            return ""
        }
        return aotSlice(ptrTy, 8, ptrTy.length - 9)
    }

    /// 查类 `sym` 的基类符号（无继承返回 ""）。
    ///
    /// 零 List 分配：`fParents` 形如 `\nChild|Parent\n…`，
    /// 直接 `substringAfter` + `substringBefore` 定位（该方法在自编译时被调用上万次）。
    fun parentOfClass(sym: String): String {
        if (sym == "" || this.fParents == "") {
            return ""
        }
        val key: String = "\n" + sym + "|"
        if (!aotContains(this.fParents, key)) {
            return ""
        }
        return this.fParents.substringAfter(key).substringBefore("\n")
    }

    /// 沿继承链查找**定义方法 `fname` 的类符号**（`Child.m` 未定义则回退父类）。
    ///
    /// `argc` 为**含隐式 self** 的形参数，用于在同名重载中挑对签名。
    /// 返回命中类符号（未命中返回 ""）；调用方据此拼 `Owner.m` 符号名与取签名。
    fun ownerClassInChain(cls: String, fname: String, argc: Int): String {
        var cur: String = cls
        var depth: Int = 0
        // **默认参数**候选：形参数 > 实参数 的方法（调用点少传的参数由
        // `emitCall` 末尾的「默认参数补齐」用形参默认值填上）。
        // 必须记住首个候选而非立即返回：同名重载里可能存在精确匹配的版本，
        // 精确匹配优先（否则会选错重载）。
        var fallback: String = ""
        while (cur != "" && depth < 16) {
            val ms: String = this.funcSignatureOf(cur + "_" + fname)
            if (ms != "") {
                val declared: Int = aotCsvCount(aotFieldAt(ms, 2, "|"))
                if (declared == argc) {
                    return cur
                }
                if (declared > argc && fallback == "") {
                    fallback = cur
                }
            }
            // 构造函数重载：`init` 函数名带数字后缀（如 `Runtime_init1`），
            // 直接查 `ClassName_init` 找不到。用 `funcSignatureArity` 尝试后缀匹配。
            // 注意：funcSignatureArity 的 argCount 不含 self，所以传 argc - 1。
            if (ms == "" && fname == "init") {
                val msInit: String = this.funcSignatureArity(cur + "_init", argc - 1)
                if (msInit != "") {
                    return cur
                }
            }
            cur = this.parentOfClass(cur)
            depth = depth + 1
        }
        return fallback
    }

    /// 发射结构体构造：`Point(1, 2)` → 堆分配 + 字段初始化 + 返回指针。
    fun emitNewStruct(hir: Hir, kids: String, n: Int, argStart: Int, sym: String): String {
        // **必须堆分配**：对象常被存进字段 / 返回 / 放进集合。旧实现用
        // `alloca`（栈临时），函数一返回该地址即失效 → 悬垂指针
        // （`Parser.lx = Lexer(source)` 正是因此解引用崩溃）。
        // 尺寸用 LLVM 惯用法 `getelementptr T, T* null, 1` + `ptrtoint` 求得，
        // 无需维护类型大小表。
        val szp: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(szp)
        this.fBody.sbAdd(" = getelementptr inbounds %struct.")
        this.fBody.sbAdd(sym)
        this.fBody.sbAdd(", %struct.")
        this.fBody.sbAdd(sym)
        this.fBody.sbAdd("* null, i32 1\n")
        val szv: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(szv)
        this.fBody.sbAdd(" = ptrtoint %struct.")
        this.fBody.sbAdd(sym)
        this.fBody.sbAdd("* ")
        this.fBody.sbAdd(szp)
        this.fBody.sbAdd(" to i64\n")
        val rawp: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(rawp)
        this.fBody.sbAdd(" = call i8* @malloc(i64 ")
        this.fBody.sbAdd(szv)
        this.fBody.sbAdd(")\n")
        val ptr: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(ptr)
        this.fBody.sbAdd(" = bitcast i8* ")
        this.fBody.sbAdd(rawp)
        this.fBody.sbAdd(" to %struct.")
        this.fBody.sbAdd(sym)
        this.fBody.sbAdd("*\n")
        // 类若有 `init(...)`（主构造函数方法体），构造实参应**转发给 init**，
        // 字段只走各自的默认初始化；否则按位置用实参初始化字段。
        // 构造函数重载：按实参数挑签名（否则 `Person("Alice", 25)` 会用
        // `constructor(a: Int)` 的形参表，把 String 强转成 i32 → 存成野指针 → 崩溃）。
        var initSig: String = this.funcSignatureArity(sym + "_init", n - argStart)
        if (initSig == "") {
            initSig = this.funcSignatureOf(sym + "_init")
        }
        val hasInit: Boolean = initSig != ""
        val fc: Int = this.structFieldCount(sym)
        var idx: Int = 0
        while (idx < fc) {
            val line: String = this.structFieldLineAt(sym, idx)
            val fty: String = aotFieldAt(line, 2, "|")
            var init: String = aotFieldAt(line, 3, "|")
            // 构造实参覆盖默认值（仅当无 `init` 方法体时按位置映射）
            if (!hasInit && argStart + idx < n) {
                val aId: Int = hirKidsAt(kids, argStart + idx)
                val aTy: String = this.inferType(hir, aId)
                val a: String = this.emitExpr(hir, aId)
                init = this.coerceValue(a, aTy, fty)
            } else {
                // 若字段默认值是**非字面量表达式**（如 `var lexer: Lexer = Lexer("")`），
                // 必须发射该表达式求值，否则会写成零值（类指针 → null → 后续解引用崩溃）。
                val col5: String = aotFieldAt(line, 4, "|")
                if (col5 != "") {
                    val ie: Int = aotToInt(col5)
                    if (ie >= 0) {
                        val eTy: String = this.inferType(hir, ie)
                        val ev: String = this.emitExpr(hir, ie)
                        init = this.coerceValue(ev, eTy, fty)
                    }
                }
            }
            val fp: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(fp)
            this.fBody.sbAdd(" = getelementptr inbounds %struct.")
            this.fBody.sbAdd(sym)
            this.fBody.sbAdd(", %struct.")
            this.fBody.sbAdd(sym)
            this.fBody.sbAdd("* ")
            this.fBody.sbAdd(ptr)
            this.fBody.sbAdd(", i32 0, i32 ")
            // 字段序号 +1：`%struct.X` 的 **index 0 是 vptr**（动态派发用），
            // 数据字段从 1 开始（见 registerStruct 的类型发射）
            this.fBody.sbAdd(toStr(idx + 1))
            this.fBody.sbAdd("\n")
            this.fBody.sbAdd("  store ")
            this.fBody.sbAdd(fty)
            this.fBody.sbAdd(" ")
            this.fBody.sbAdd(init)
            this.fBody.sbAdd(", ")
            this.fBody.sbAdd(fty)
            this.fBody.sbAdd("* ")
            this.fBody.sbAdd(fp)
            this.fBody.sbAdd("\n")
            idx = idx + 1
        }
        // vptr（index 0）：写入本类 vtable 地址，供运行期动态派发。
        // 仅当程序里确实存在可重写方法（槽位数 > 0）时才发射 vtable 常量——
        // 否则 `@vtable.X` 全局不存在 → llc 报 undefined value。
        if (this.slotTotal() > 0 && aotListContains(this.structConcrete, sym)) {
            val vtp: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(vtp)
            this.fBody.sbAdd(" = getelementptr inbounds %struct.")
            this.fBody.sbAdd(sym)
            this.fBody.sbAdd(", %struct.")
            this.fBody.sbAdd(sym)
            this.fBody.sbAdd("* ")
            this.fBody.sbAdd(ptr)
            this.fBody.sbAdd(", i32 0, i32 0\n")
            this.fBody.sbAdd("  store i8* @vtable.")
            this.fBody.sbAdd(sym)
            this.fBody.sbAdd(", i8** ")
            this.fBody.sbAdd(vtp)
            this.fBody.sbAdd("\n")
        }
        // 构造初始化块 / 主构造函数：`init(...)` → 调用 `<Class>.init(ptr, 实参...)`
        if (hasInit) {
            val paramsCsv: String = aotFieldAt(initSig, 2, "|")
            var args: String = "%struct." + sym + "* " + ptr
            var i: Int = argStart
            var ai: Int = 1
            while (i < n) {
                val aId: Int = hirKidsAt(kids, i)
                val aTy: String = this.inferType(hir, aId)
                val a: String = this.emitExpr(hir, aId)
                var wantTy: String = aTy
                if (paramsCsv != "") {
                    // 签名表里的参数是 `i8*, i64` 这类**带空格**形式，按 `,` 切出来会带前导
                    // 空格；不 trim 会让 `intWidth(" i64")` 判为非整数 → 跳过 sext/trunc，
                    // 生成 `i32` 值传给 `i64` 形参的非法 IR。
                    wantTy = trimSpaces(aotFieldAt(paramsCsv, ai, ","))
                }
                // 构造函数重载：签名表只登记了第一个 `init`，形参数可能少于本次实参
                // （`aotFieldAt` 越界返回 ""）→ `call void @C_init3(…,  25)` 少了类型，
                // llc 报 `expected type`。此时退回实参自身的推断类型。
                if (wantTy == "") {
                    wantTy = aTy
                }
                if (wantTy == "") {
                    wantTy = "i32"
                }
                args = args + ", " + wantTy + " " + this.coerceValue(a, aTy, wantTy)
                ai = ai + 1
                i = i + 1
            }
            this.fBody.sbAdd("  call void @")
            this.fBody.sbAdd(sanitizeLlvm(sym + ".init"))
            // 构造函数重载消歧后缀（含 self）：与定义侧一致
            this.fBody.sbAdd(toStr(1 + (n - argStart)))
            this.fBody.sbAdd("(")
            this.fBody.sbAdd(args)
            this.fBody.sbAdd(")\n")
            this.fTerminated = false
        }
        return ptr
    }

    // ── 函数 ──

    /// 查方法所属类名（非方法返回 ""）。
    ///
    /// 性能：并行键列 + `toStr(fnId)` 单次转换（旧实现每次构造 `toStr(fnId) + "|"` 针串）。
    fun methodOwnerClass(fnId: Int): String {
        val needle: String = toStr(fnId)
        var i: Int = 0
        while (i < this.fOwnerIdStrs.size) {
            if (this.fOwnerIdStrs[i] == needle) {
                return this.fOwnerClasses[i]
            }
            i = i + 1
        }
        return ""
    }

    /// 生成用户函数签名条目 `name|retTy|paramTy1,paramTy2`。
    ///
    /// 类方法自动带隐式 `self` 形参（`%struct.<Class>*`，接收者由调用点作为第 0 个实参传入）。
    /// 方法接收者（隐式 `self`）的 LLVM 类型。
    ///
    /// **value class 的接收者就是它的值表示**：`String` → `i8*`、`Char` → `i16`、
    /// `Int` → `i32`…；其余类/结构体/object 仍是指针 `%struct.<Cls>*`。
    ///
    /// 必须与「值表示」严格一致：String 的表达式值就是 `i8*`（C 字符串）。
    /// 若签名表声明 `%struct.String*` 而调用点传 `i8*`，callee 会把字符缓冲
    /// 当结构体读 —— 长度字段是垃圾 → 内部循环失控 + 无界分配（曾把宿主内存吃光）。
    /// 判定方式：`mapTy(owner)` 不是 `%struct.*` 即为 value class。
    fun selfTyOf(ownerCls: String): String {
        val m: String = this.mapTy(ownerCls)
        if (m != "" && !m.startsWith("%struct.")) {
            return m
        }
        return "%struct." + sanitizeLlvm(ownerCls) + "*"
    }

    /// 整型字面量文本 → 十进制文本（去掉 `L` 后缀、展开 `0x…` / `0b…`）。
    ///
    /// LLVM 的整型常量不接受十六进制前缀写法：`i32 0x20` 会被词法器当作
    /// **十六进制浮点字面量**，报 `floating point constant invalid for type`。
    fun intLiteralToDecimal(raw: String): String {
        var s: String = raw
        if (s == "") {
            return "0"
        }
        if (s.endsWith("L") || s.endsWith("l")) {
            s = aotSlice(s, 0, s.length - 1)
        }
        var radix: Int = 0
        var start: Int = 0
        if (s.startsWith("0x") || s.startsWith("0X")) {
            radix = 16
            start = 2
        } else if (s.startsWith("0b") || s.startsWith("0B")) {
            radix = 2
            start = 2
        }
        if (radix == 0) {
            return s
        }
        var v: Int = 0
        var i: Int = start
        while (i < s.length) {
            val c: Int = s.charCodeAt(i) as Int
            var d: Int = -1
            if (c >= 48 && c <= 57) {
                d = c - 48
            } else if (c >= 97 && c <= 102) {
                d = c - 87
            } else if (c >= 65 && c <= 70) {
                d = c - 55
            }
            if (d >= 0 && d < radix) {
                v = v * radix + d
            }
            i = i + 1
        }
        return toStr(v)
    }

    /// object 单例全局的初始化器文本（`{ i8* null, i64 4, … }`）。
    ///
    /// **必须带上字段默认值**：`object` 内的 `const val` / `var x = 4` 在 AOT 下
    /// 是结构体字段，`zeroinitializer` 会把 `LIST_MIN_CAP` 之类常量读成 0
    /// （`newList(0)` → 容量 0 → `push` 越界写 → 堆损坏 0xC0000374）。
    fun singletonInit(sym: String): String {
        var s: String = "{ i8* null"
        var i: Int = 0
        while (i < this.structLines.size) {
            val line: String = this.structLines[i]
            if (aotFieldAt(line, 0, "|") == sym) {
                val lty: String = aotFieldAt(line, 2, "|")
                var dv: String = aotFieldAt(line, 3, "|")
                if (dv == "") {
                    dv = EmitUtils.defaultValue(lty)
                }
                // 整型常量：LLVM 不接受后缀（`4L`），且 `0x20` 会被当作
                // **十六进制浮点字面量**解析（llc: floating point constant invalid
                // for type）→ 统一转成十进制文本。
                if (lty == "i64" || lty == "i32" || lty == "i16" || lty == "i8"
                    || lty == "i1") {
                    dv = intLiteralToDecimal(dv)
                } else if (lty == "float" || lty == "double") {
                    // 浮点字面量后缀（`3.14f` / `1.0d`）不是 LLVM 语法
                    if (dv.endsWith("f") || dv.endsWith("F")
                        || dv.endsWith("d") || dv.endsWith("D")) {
                        dv = aotSlice(dv, 0, dv.length - 1)
                    }
                    if (dv == "") {
                        dv = "0.0"
                    }
                }
                s = s + ", " + lty + " " + dv
            }
            i = i + 1
        }
        return s + " }"
    }

    /// 静态 self 实参：`%struct.<Cls>*` → 对应单例全局 `@aura_obj_<Cls>`。
    ///
    /// 非 `%struct.*`（value class 的 `i8*` 等）或没有具体布局的类型返回 `null`。
    fun singletonRefOf(selfTy: String): String {
        if (!selfTy.startsWith("%struct.") || !selfTy.endsWith("*")) {
            return "null"
        }
        val inner: String = aotSlice(selfTy, 8, selfTy.length - 9)
        if (inner != "" && aotListContains(this.structConcrete, inner)) {
            return "@aura_obj_" + inner
        }
        return "null"
    }

    fun functionSignature(hir: Hir, id: Int): String {
        var retTy: String = this.mapTy(hir.tyOf(id))
        if (retTy == "") {
            retTy = "void"
        }
        val kids: String = hir.kidsOf(id)
        val kCount: Int = hirKidsCount(kids)
        var params: String = ""
        val ownerCls: String = this.methodOwnerClass(id)
        // 所有类/结构体/object 方法都有隐式 `self` 形参（见 `selfTyOf`：
        // value class 为值表示，其余为 `%struct.<Owner>*`）。
        // HIR 对 object 单例方法调用会在第 0 位补 `null` 占位（见
        // `resolve_method_owner` 的 is_singleton 分支），因此 object 方法也必须
        // 声明 self，否则调用点实参数比定义多一个 → llc 类型/参数不匹配。
        if (ownerCls != "") {
            params = this.selfTyOf(ownerCls)
        }
        var i: Int = 0
        var pCount: Int = 0
        while (i < kCount) {
            val cid: Int = hirKidsAt(kids, i)
            if (hir.kindOf(cid) == "HirParam") {
                var pty: String = this.mapTy(hir.tyOf(cid))
                if (pty == "") {
                    pty = "i32"
                }
                if (params != "") {
                    params = params + ","
                }
                params = params + pty
                pCount = pCount + 1
            }
            i = i + 1
        }
        // 方法名以 `Class.method` 限定：避免不同类的同名方法互相覆盖，
        // 调用点按接收者类型解析（Phase 6.5.1b）。
        // 注意：`sanitizeLlvm` 会把 `.` 替换为 `_`，与 `emitFunction` 的
        // `sanitizeLlvm(defName)` 保持一致（否则签名表查不到函数）。
        // 构造函数重载：`init` 按「含 self 的形参数」加后缀消歧（与 emitFunction 一致）。
        var fname: String = hir.textOf(id)
        if (ownerCls != "") {
            fname = sanitizeLlvm(ownerCls) + "_" + fname
            if (fname.endsWith("_init")) {
                fname = fname + toStr(pCount + 1)
            }
        }
        return fname + "|" + retTy + "|" + params
    }

    /// 登记一个函数的形参节点列表（`fname|id1,id2,…`），供调用点补齐默认参数。
    /// 方法（`ownerCls != ""`）在表首插入 `-1` 占位，与签名表的 self 位对齐。
    fun registerParamDefs(hir: Hir, id: Int) {
        val kids: String = hir.kidsOf(id)
        val kCount: Int = hirKidsCount(kids)
        var fname: String = hir.textOf(id)
        val ownerCls: String = this.methodOwnerClass(id)
        var csv: String = ""
        // Phase B: object 内方法是静态方法，无 receiver 占位（-1）。
        if (ownerCls != "" && !aotListContains(this.fObjectClassNames, ownerCls)) {
            fname = sanitizeLlvm(ownerCls) + "." + fname
            csv = "-1"
        } else if (ownerCls != "") {
            fname = sanitizeLlvm(ownerCls) + "." + fname
        }
        var i: Int = 0
        while (i < kCount) {
            val cid: Int = hirKidsAt(kids, i)
            if (hir.kindOf(cid) == "HirParam") {
                if (csv != "") {
                    csv = csv + ","
                }
                csv = csv + toStr(cid)
            }
            i = i + 1
        }
        this.fParamDefs.add(fname + "|" + csv)
    }

    /// 查询函数的形参节点 CSV（未登记返回 ""）。
    ///
    /// 键有两种写法：**登记**用 `Owner.method`（`registerParamDefs`），
    /// **调用点**给的是发射器符号 `Owner_method`。此前只做精确匹配 →
    /// 方法的默认参数永远查不到、不补齐（`calc.compute(10, 3)` 的
    /// `op: String = "+"` 拿到空串，when 全不匹配 → 返回 0）。
    /// 这里在精确匹配失败后，把首个 `_` 换成 `.` 再查一次。
    fun paramDefsOf(fname: String): String {
        var i: Int = 0
        while (i < this.fParamDefs.size) {
            if (aotFieldAt(this.fParamDefs[i], 0, "|") == fname) {
                return aotFieldAt(this.fParamDefs[i], 1, "|")
            }
            i = i + 1
        }
        // 兼容 `Owner_method` → `Owner.method`（仅替换**首个**下划线：
        // 方法名本身可能含下划线，如 `JitUtil_patternCount`）。
        var up: Int = -1
        var k: Int = 0
        while (k < fname.length) {
            if (fname.charCodeAt(k) == 95) {
                up = k
                k = fname.length
            }
            k = k + 1
        }
        if (up > 0) {
            val alt: String = aotSlice(fname, 0, up) + "."
                + aotSlice(fname, up + 1, fname.length - up - 1)
            var j: Int = 0
            while (j < this.fParamDefs.size) {
                if (aotFieldAt(this.fParamDefs[j], 0, "|") == alt) {
                    return aotFieldAt(this.fParamDefs[j], 1, "|")
                }
                j = j + 1
            }
        }
        return ""
    }

    /// 发射单个函数定义，结果**直接追加到** `funcParts`。
    fun emitFunction(hir: Hir, id: Int) {
        this.fAlloca.sbReset()
        this.fBody.sbReset()
        this.fVarList = arrayListOf<String>()
        this.fVarNames = arrayListOf<String>()
        this.fVarSlotSeq = 0
        // 集合局部变量表是**每函数**状态：不重置会让前一个函数登记的集合变量
        // 泄漏到后续函数（`isListVar` 误判 → 下标按集合 getAt + 按元素类型解箱，
        // 生成 `i32` 传 `i8*` 形参的非法 IR）。
        this.fListVars = ""
        this.fTerminated = false
        this.fClosureSigs = ""
        // inferType 记忆化换代：类型推断依赖本函数的局部变量表 / 所属类
        this.fGen = this.fGen + 1
        this.fGenStr = toStr(this.fGen)

        val name: String = hir.textOf(id)
        var retTy: String = this.mapTy(hir.tyOf(id))
        if (retTy == "") {
            retTy = "void"
        }
        // C 入口 `main`：进程退出码取决于 `main` 的返回值。`fun main()`（Unit）
        // 若发射成 `define void @main`，宿主拿到的退出码是 EAX 里的残留值
        // （实测同一程序时 0 时 5）。统一改为 `i32 @main` 并在末尾 `ret i32 0`。
        //
        // Phase S4 修复：也检查 `name` 是否以 ".main" 结尾（包名前缀情况），
        // 确保 `main` 函数始终被正确识别为入口点。
        var isEntryMain: Boolean = false
        if (this.methodOwnerClass(id) == "") {
            isEntryMain = (name == "main" || aotContains(name, ".main"))
        }
        if (isEntryMain) {
            retTy = "i32"
            // 包名前缀的 `main` 需要去掉前缀，只保留 "main"
            if (name != "main") {
                var dotPos: Int = name.lastIndexOf(".")
                if (dotPos >= 0) {
                    name = name.substring(dotPos + 1)
                }
            }
        }
        this.fRetTy = retTy

        val kids: String = hir.kidsOf(id)
        val kCount: Int = hirKidsCount(kids)
        var paramsIr: String = ""
        var bodyId: Int = -1
        var i: Int = 0
        var pCount: Int = 0

        // 类方法：隐式 self 形参（接收者指针），并注册 `this`
        //
        // `fForceOwnerCls`：**继承方法特化**——把父类方法体按子类重新发射一份
        // （符号变成 `Child.m`、`this` 变成 `%struct.Child*`、fCurClass = Child）。
        // 这样 `Animal.describe()` 内的 `this.name()` 在 `Dog.describe` 副本里
        // 会解析到 `Dog_name`，实现「按具体类型派发」（无需改结构体布局）。
        var ownerCls: String = this.methodOwnerClass(id)
        if (this.fForceOwnerCls != "") {
            ownerCls = this.fForceOwnerCls
        }
        this.fCurClass = ownerCls
        // C 入口：模块级 `main` 使用 `(i32 %argc, i8** %argv)` 签名（与 Rust 后端
        // 约定一致），入口块最先把宿主 argv 注入运行时——`Process.arg/argCount`
        // 依赖它，否则 AOT 产物读不到命令行参数（只会打印用法）。
        if (isEntryMain) {
            paramsIr = "i32 %argc, i8** %argv"
        }
        if (ownerCls != "") {
            // 接收者类型：value class 为其值表示（String → `i8*`），否则为
            // `%struct.<Cls>*`（与 `functionSignature` 的 `selfTyOf` 一致）。
            val selfTy: String = this.selfTyOf(ownerCls)
            paramsIr = selfTy + " %arg.this"
            this.fAlloca.sbAdd("  %arg.this.addr = alloca ")
            this.fAlloca.sbAdd(selfTy)
            this.fAlloca.sbAdd("\n")
            this.fBody.sbAdd("  store ")
            this.fBody.sbAdd(selfTy)
            this.fBody.sbAdd(" %arg.this, ")
            // 指针类型（%struct.X*）不再追加 *
            if (!selfTy.endsWith("*")) {
                this.fBody.sbAdd(selfTy)
                this.fBody.sbAdd("* ")
            } else {
                this.fBody.sbAdd(selfTy)
                this.fBody.sbAdd(" ")
            }
            this.fBody.sbAdd("%arg.this.addr\n")
            this.fVarList.add("this|%arg.this.addr|" + selfTy)
            this.fVarNames.add("this")
        }

        while (i < kCount) {
            val cid: Int = hirKidsAt(kids, i)
            val ck: String = hir.kindOf(cid)
            if (ck == "HirParam") {
                if (!isEntryMain) {
                    var pty: String = this.mapTy(hir.tyOf(cid))
                    if (pty == "") {
                        pty = "i32"
                    }
                    val pname: String = hir.textOf(cid)
                    val psym: String = sanitizeLlvm(pname)
                    if (paramsIr != "") {
                        paramsIr = paramsIr + ", "
                    }
                    paramsIr = paramsIr + pty + " %arg." + psym
                    pCount = pCount + 1
                    val addr: String = "%arg." + psym + ".addr"
                    this.fAlloca.sbAdd("  ")
                    this.fAlloca.sbAdd(addr)
                    this.fAlloca.sbAdd(" = alloca ")
                    this.fAlloca.sbAdd(pty)
                    this.fAlloca.sbAdd("\n")
                    this.fBody.sbAdd("  store ")
                    this.fBody.sbAdd(pty)
                    this.fBody.sbAdd(" %arg.")
                    this.fBody.sbAdd(psym)
                    this.fBody.sbAdd(", ")
                    // 指针类型（ptr / %struct.X*）不再追加 *
                    if (pty != "ptr" && !pty.endsWith("*")) {
                        this.fBody.sbAdd(pty)
                        this.fBody.sbAdd("* ")
                    } else {
                        this.fBody.sbAdd(pty)
                        this.fBody.sbAdd(" ")
                    }
                    this.fBody.sbAdd(addr)
                    this.fBody.sbAdd("\n")
                    this.fVarList.add(pname + "|" + addr + "|" + pty)
                    this.fVarNames.add(pname)
                    // 参数也可能是集合（`fun f(items: List<String>)`）：必须按声明
                    // 类型登记元素类型，否则 `.size` 会被当成字符串长度
                    // （`aura_strlen`）、下标会被当成 `charAt`，集合读取全变成空值。
                    val pAuraTy: String = hir.tyOf(cid)
                    if (EmitUtils.isCollectionTypeName(this.resolveAlias(pAuraTy))) {
                        this.markListVarTyped(pname, this.typeArgElemTy(pAuraTy))
                    }
                    // 函数类型参数（`fun f(x: Int, f: (Int) -> Int)`）：
                    // 登记闭包签名，使 `f(args…)` 能走 `emitIndirectCall`。
                    if (this.isFnTy(this.resolveAlias(pAuraTy))) {
                        val csig: String = this.fnTypeSig(this.resolveAlias(pAuraTy))
                        if (csig != "") {
                            this.registerClosureVar(pname, csig)
                        }
                    }
                }
            } else {
                bodyId = cid
            }
            i = i + 1
        }

        // ── 并发原语直通（Phase 9b）──
        //
        // `aura.lang.concurrent.Thread` / `Channel` 的 Aura 包装函数体里调用
        // `ThreadOps.<m>` / `ChannelOps.<m>`（`extern interface` 方法）。
        // 当前 HIR 降级链对 `extern interface` 方法调用的解析不完整
        // （`HirCall` 的 calleeName 只取成员名，接收者 `ThreadOps` 在 AOT 侧
        // 无全局地址 → 调用被静默丢弃），导致包装函数体为空、恒返回 0/null。
        //
        // 与 Rust AOT 一致：在发射器直接拦截这些已知符号，调用运行库 C 封装
        // （aura_thread_* / aura_lang_concurrent_Channel_*），跳过 Aura 包装体。
        val fullFn: String = if (ownerCls != "") { ownerCls + "." + name } else { name }
        if (this.fTerminated == false && this.emitConcurrentBuiltin(fullFn, ownerCls, name, retTy)) {
            // 已发射完整函数体（含 ret）
        } else if (bodyId >= 0) {
            this.emitBody(hir, bodyId)
        }
        if (!this.fTerminated) {
            if (retTy == "void") {
                this.fBody.sbAdd("  ret void\n")
            } else {
                this.fBody.sbAdd("  ret ")
                this.fBody.sbAdd(retTy)
                this.fBody.sbAdd(" ")
                this.fBody.sbAdd(EmitUtils.defaultValue(retTy))
                this.fBody.sbAdd("\n")
            }
        }

        var defName: String = name
        // Phase S4 修复：`main` 入口函数不能被类名前缀修饰，必须始终是裸 "main"
        if (isEntryMain) {
            defName = "main"
        } else if (ownerCls != "") {
            defName = sanitizeLlvm(ownerCls) + "." + name
            // 构造函数重载：`constructor(a: Int)` / `constructor(n: String, a: Int)`
            // 都降级为 `init`，同名会生成**重复定义**（llc: invalid redefinition
            // of function 'Person_init'）。按「含 self 的形参数」加后缀消歧，
            // 调用点（`emitNewStruct`）用同一规则算符号。
            if (name == "init") {
                defName = defName + toStr(pCount + 1)
            }
        }
        // 直接追加进模块级 `funcParts`（**不再经临时 `out` 缓冲**）。
        //
        // 旧写法是 `out = 头部 + fAlloca.sbBuild() + fBody.sbBuild()` 再
        // `funcParts.sbAdd(out.sbBuild())`：同一份函数文本被拷贝 3 次
        // （fAlloca→out、fBody→out、out→funcParts）。AOT 无 GC，整份 IR 量级
        // 的中间串会永久驻留；改为直接追加后只剩 2 次。
        this.funcParts.sbAdd("define " + retTy + " @" + sanitizeLlvm(defName) + "(" + paramsIr + ") {\n")
        this.funcParts.sbAdd("entry:\n")
        if (isEntryMain) {
            // Phase C: 用 IR 全局变量存储 argc/argv，替代 @aura_args_set C 调用
            this.funcParts.sbAdd("  store i32 %argc, i32* @aura_argc_global\n")
            this.funcParts.sbAdd("  store i8** %argv, i8*** @aura_argv_global\n")
        }
        this.funcParts.sbAdd(this.fAlloca.sbBuild())
        this.funcParts.sbAdd(this.fBody.sbBuild())
        this.funcParts.sbAdd("}\n\n")
    }

    /// **并发原语直通发射**（Phase 9b）。
    ///
    /// 对 `Thread.id` / `Thread.parallelism` / `Thread.availableCores` /
    /// `Thread.sleep` / `Thread.spawn` / `Thread.join` / `Channel.newChannel` /
    /// `Channel.channelSend` / `Channel.channelRecv` 直接发射对运行库 C 封装的
    /// 调用，绕过 Aura 包装体（其体因 `extern interface` 方法调用未被 HIR
    /// 降级链解析而为空）。
    ///
    /// 返回 `true` 表示已发射完整函数体（含 `ret`），调用方应跳过 `emitBody`。
    ///
    /// 运行库符号与 Rust AOT `runtime.rs` 对齐：
    ///   * `aura_thread_id` / `aura_thread_available_parallelism` /
    ///     `aura_thread_sleep` / `aura_thread_create` / `aura_thread_join`
    ///   * `aura_lang_concurrent_Channel_newChannel` /
    ///     `aura_lang_concurrent_Channel_channelSend` /
    ///     `aura_lang_concurrent_Channel_channelRecv`
    fun emitConcurrentBuiltin(fullFn: String, ownerCls: String, name: String, retTy: String): Boolean {
        val sb: EmitBuffer = this.fBody
        if (fullFn == "Thread.id" || fullFn == "Thread.parallelism" || fullFn == "Thread.availableCores") {
            // 无参，返回 i64 → trunc i32
            val nativeSym: String = if (fullFn == "Thread.id") {
                "aura_thread_id"
            } else {
                "aura_thread_available_parallelism"
            }
            sb.sbAdd("  %result = call i64 @" + nativeSym + "()\n")
            sb.sbAdd("  %trunc = trunc i64 %result to i32\n")
            sb.sbAdd("  ret i32 %trunc\n")
            this.fTerminated = true
            return true
        }
        if (fullFn == "Thread.sleep") {
            sb.sbAdd("  %zext = zext i32 %arg.ms to i64\n")
            sb.sbAdd("  call void @aura_thread_sleep(i64 %zext)\n")
            sb.sbAdd("  ret void\n")
            this.fTerminated = true
            return true
        }
        if (fullFn == "Thread.spawn") {
            sb.sbAdd("  %zext.0 = zext i32 %arg.fn_id to i64\n")
            sb.sbAdd("  %zext.1 = zext i32 %arg.arg to i64\n")
            sb.sbAdd("  %result = call i64 @aura_thread_create(i64 %zext.0, i64 %zext.1)\n")
            sb.sbAdd("  %trunc = trunc i64 %result to i32\n")
            sb.sbAdd("  ret i32 %trunc\n")
            this.fTerminated = true
            return true
        }
        if (fullFn == "Thread.join") {
            sb.sbAdd("  %zext = zext i32 %arg.thread_id to i64\n")
            sb.sbAdd("  %result = call i64 @aura_thread_join(i64 %zext)\n")
            sb.sbAdd("  %trunc = trunc i64 %result to i32\n")
            sb.sbAdd("  ret i32 %trunc\n")
            this.fTerminated = true
            return true
        }
        if (fullFn == "Channel.newChannel") {
            sb.sbAdd("  %zext = zext i32 %arg.capacity to i64\n")
            sb.sbAdd("  %result = call i64 @aura_lang_concurrent_Channel_newChannel(i64 %zext)\n")
            sb.sbAdd("  %trunc = trunc i64 %result to i32\n")
            sb.sbAdd("  ret i32 %trunc\n")
            this.fTerminated = true
            return true
        }
        if (fullFn == "Channel.channelSend") {
            sb.sbAdd("  %zext = zext i32 %arg.ch to i64\n")
            sb.sbAdd("  call void @aura_lang_concurrent_Channel_channelSend(i64 %zext, i8* %arg.value)\n")
            sb.sbAdd("  ret void\n")
            this.fTerminated = true
            return true
        }
        if (fullFn == "Channel.channelRecv") {
            sb.sbAdd("  %zext = zext i32 %arg.ch to i64\n")
            sb.sbAdd("  %result = call i8* @aura_lang_concurrent_Channel_channelRecv(i64 %zext)\n")
            sb.sbAdd("  ret i8* %result\n")
            this.fTerminated = true
            return true
        }
        return false
    }

    // ── FFI / @native（Phase C.2：Aura 侧 AOT 发射器）──
    //
    // 与 Rust 侧 `emit_native_wrapper` 对齐（`compiler/src/codegen/aot/emit.rs`）：
    //   * `@native(SYS_READ)`     → `call i64 @aura_syscall_dispatch(N, args…, 0…)`
    //   * `@native(asm = "…")`    → 已知指令走 C 封装（aura_cpu_*），其余 LLVM inline asm
    //   * `native fun`（内置）     → aura_memory_alloc / free / inttoptr+load/store
    // 这些包装器把 Aura 的 `extern object` 声明落成真实 LLVM 定义，供
    // `aura_syscalls.c`（Layer 0-B）在链接期解析。

    /// 取原生函数的 metadata（`kids[0]` 的 `HirNativeInfo` 文本；非原生返回 ""）。
    fun nativeMetaOf(hir: Hir, id: Int): String {
        val kids: String = hir.kidsOf(id)
        if (hirKidsCount(kids) < 1) {
            return ""
        }
        val infoId: Int = hirKidsAt(kids, 0)
        if (hir.kindOf(infoId) != "HirNativeInfo") {
            return ""
        }
        return hir.textOf(infoId)
    }

    /// 生成原生函数签名条目 `name|retTy|paramTy1,paramTy2`。
    ///
    /// syscall 统一 `i64`（与 C 分发 `aura_syscall_dispatch(i64, i64×6)` 对齐）；
    /// 其余按声明类型映射，映射失败回退 `i64`（与 Rust 侧一致）。
    fun nativeFunctionSignature(hir: Hir, id: Int): String {
        val meta: String = this.nativeMetaOf(hir, id)
        val isSyscall: Boolean = meta.startsWith("native|")
        var retTy: String = this.mapTy(hir.tyOf(id))
        if (isSyscall) {
            retTy = "i64"
        } else if (retTy == "") {
            retTy = "void"
        }
        val kids: String = hir.kidsOf(id)
        val kCount: Int = hirKidsCount(kids)
        var params: String = ""
        var i: Int = 0
        while (i < kCount) {
            val cid: Int = hirKidsAt(kids, i)
            if (hir.kindOf(cid) == "HirParam") {
                var pty: String = this.mapTy(hir.tyOf(cid))
                if (isSyscall || pty == "") {
                    pty = "i64"
                }
                if (params != "") {
                    params = params + ","
                }
                params = params + pty
            }
            i = i + 1
        }
        return hir.textOf(id) + "|" + retTy + "|" + params
    }

    /// 由签名 CSV 生成形参文本：`i64 %arg.0, i64 %arg.1`。
    fun nativeParamsIr(paramsCsv: String): String {
        var out: String = ""
        val n: Int = aotCsvCount(paramsCsv)
        var i: Int = 0
        while (i < n) {
            if (out != "") {
                out = out + ", "
            }
            out = out + aotFieldAt(paramsCsv, i, ",") + " %arg." + toStr(i)
            i = i + 1
        }
        return out
    }

    /// 形参 `i` 的 LLVM 类型（越界/空 → `i64`）。
    fun npTy(paramsCsv: String, i: Int): String {
        if (i < 0 || i >= aotCsvCount(paramsCsv)) {
            return "i64"
        }
        val t: String = trimSpaces(aotFieldAt(paramsCsv, i, ","))
        if (t == "") {
            return "i64"
        }
        return t
    }

    /// 把形参 `i` 收敛到 `want` 类型，返回可用作实参的表达式。
    ///
    /// 需要的转换指令追加到 `pre` —— 包装器体是**纯文本拼接**（见
    /// `emitNativeWrapper`），不能用 `coerceValue`：后者把指令写进 `fBody`，
    /// 会落到「当前正在发射的调用方函数」里，而不是包装器体内。
    fun npAs(pre: EmitBuffer, paramsCsv: String, i: Int, want: String): String {
        val ft: String = this.npTy(paramsCsv, i)
        val v: String = "%arg." + toStr(i)
        if (ft == want) {
            return v
        }
        if (ft == "i64" && want == "i32") {
            val t: String = "%cv.t." + toStr(i)
            pre.sbAdd("  ")
            pre.sbAdd(t)
            pre.sbAdd(" = trunc i64 ")
            pre.sbAdd(v)
            pre.sbAdd(" to i32\n")
            return t
        }
        if (ft == "i32" && want == "i64") {
            val t: String = "%cv.s." + toStr(i)
            pre.sbAdd("  ")
            pre.sbAdd(t)
            pre.sbAdd(" = sext i32 ")
            pre.sbAdd(v)
            pre.sbAdd(" to i64\n")
            return t
        }
        if (want == "i8*") {
            val t: String = "%cv.p." + toStr(i)
            pre.sbAdd("  ")
            pre.sbAdd(t)
            pre.sbAdd(" = inttoptr ")
            pre.sbAdd(ft)
            pre.sbAdd(" ")
            pre.sbAdd(v)
            pre.sbAdd(" to i8*\n")
            return t
        }
        if (want == "i64" && (ft == "i8*" || ft == "ptr")) {
            val t: String = "%cv.q." + toStr(i)
            pre.sbAdd("  ")
            pre.sbAdd(t)
            pre.sbAdd(" = ptrtoint i8* ")
            pre.sbAdd(v)
            pre.sbAdd(" to i64\n")
            return t
        }
        // 其余情况原样使用（调用点已按 C ABI 收敛宽度）
        return v
    }

    /// 拼装一次 CRT 调用的包装器体，返回 `retTy|body`（body 以 `%result` 结尾）。
    fun winCrtFinish(pre: EmitBuffer, fn: String, retC: String, args: String): String {
        var out: String = pre.sbBuild()
        if (retC == "void") {
            // 仅 `exit`：包装器返回类型统一为 i64（syscall 约定），
            // 需要一条**真实指令**产生返回值 —— 不能用 `%result = i64 0`。
            out = out + "  call void @" + fn + "(" + args + ")\n"
            return "i64|" + out + "  %result = add i64 0, 0"
        }
        if (retC == "i64") {
            // 直接把调用结果命名为 `%result`：LLVM 没有寄存器间拷贝指令，
            // `%result = %call` 会报 `expected instruction opcode`。
            return "i64|" + out + "  %result = call i64 @" + fn + "(" + args + ")"
        }
        out = out + "  %call = call " + retC + " @" + fn + "(" + args + ")\n"
        return "i64|" + out + "  %result = sext " + retC + " %call to i64"
    }

    /// **Windows 平台实现**：把 `@native(SYS_*)` 成员映射为 CRT（UCRT）调用。
    ///
    /// 为什么必须平台感知：`aura/core/aura/lang/native/Syscalls.aura` 里的
    /// `SYS_*` 是 **Linux 编号**，Windows 既不能用这些编号、也不能用裸 `syscall`
    /// （需要 Nt ABI 与内核句柄语义）；而且 x86 目标默认按 AT&T 解析内联汇编，
    /// `mov rax, 1; syscall` 会直接报
    /// `unknown use of instruction mnemonic without a size suffix`（当前阻塞点）。
    ///
    /// CRT（clang 在 Windows 上默认链接 UCRT）提供了等价实现，即「平台对应的实现」：
    /// `_write` / `_read` / `_open` / `_close` / `_lseeki64` / `_fstat` / `_stat64` /
    /// `_access` / `_unlink` / `_mkdir` / `_rmdir` / `_getpid` / `exit`。
    /// 参数按 C ABI 收敛（句柄/计数 `i32`、路径/缓冲 `i8*`）。
    ///
    /// 返回 `retTy|body`；**无法映射**（Windows 无对应语义，如 `fork` / `execve` /
    /// `kill` / `clockGettime` / `getrandom`）返回 ""，由调用方退化为返回 0，
    /// 而不是发射语义错误的裸 syscall。
    fun winCrtWrapper(rawName: String, paramsCsv: String): String {
        val lc: String = aotToLower(rawName)
        val pre: EmitBuffer = EmitBuffer()
        // ── 写（控制台）──：`writeStdout(buf, count)` → `_write(1, buf, count)`
        if (lc == "writestdout") {
            val b: String = this.npAs(pre, paramsCsv, 0, "i8*")
            val c: String = this.npAs(pre, paramsCsv, 1, "i32")
            return this.winCrtFinish(pre, "_write", "i32", "i32 1, i8* " + b + ", i32 " + c)
        }
        // ── 写（文件）──：`write(fd, buf, count)` → `_write(fd, buf, count)`
        if (lc == "write" || lc == "writefile") {
            val fd: String = this.npAs(pre, paramsCsv, 0, "i32")
            val b: String = this.npAs(pre, paramsCsv, 1, "i8*")
            val c: String = this.npAs(pre, paramsCsv, 2, "i32")
            return this.winCrtFinish(pre, "_write", "i32",
                "i32 " + fd + ", i8* " + b + ", i32 " + c)
        }
        // ── 读 ──
        if (lc == "read" || lc == "readsyscall" || lc == "readfile") {
            val fd: String = this.npAs(pre, paramsCsv, 0, "i32")
            val b: String = this.npAs(pre, paramsCsv, 1, "i8*")
            val c: String = this.npAs(pre, paramsCsv, 2, "i32")
            return this.winCrtFinish(pre, "_read", "i32",
                "i32 " + fd + ", i8* " + b + ", i32 " + c)
        }
        // ── 打开（`openat(dirfd, path, flags)` 只取 path/flags）──
        if (lc == "open" || lc == "openfile" || lc == "openat") {
            var off: Int = 0
            if (lc == "openat") {
                off = 1
            }
            val p: String = this.npAs(pre, paramsCsv, off, "i8*")
            val fl: String = this.npAs(pre, paramsCsv, off + 1, "i32")
            // **标志位翻译（Linux → UCRT）**：Aura 侧用 Linux 的 `O_*` 数值
            //（O_CREAT=0x40），而 Windows `_open` 要求 `_O_CREAT=0x100`、
            // `_O_EXCL=0x400`、`_O_APPEND=0x8`。直接透传会让 `_open` 因为
            // 「非法标志位」直接失败（`FileSystem.writeText` 静默返回 false）。
            //   w = (f & 3) | ((f & 0x40) << 2) | (f & 0x200) | ((f & 0x80) << 3) | ((f & 0x400) >> 7)
            // 逐条指令（LLVM IR 不允许在指令操作数里嵌套 `(…)` 表达式）
            val wa: String = this.freshVar()
            pre.sbAdd("  " + wa + " = and i32 " + fl + ", 3\n")
            val wb0: String = this.freshVar()
            pre.sbAdd("  " + wb0 + " = and i32 " + fl + ", 64\n")
            val wb: String = this.freshVar()
            pre.sbAdd("  " + wb + " = shl i32 " + wb0 + ", 2\n")
            val wc0: String = this.freshVar()
            pre.sbAdd("  " + wc0 + " = and i32 " + fl + ", 128\n")
            val wc: String = this.freshVar()
            pre.sbAdd("  " + wc + " = shl i32 " + wc0 + ", 3\n")
            val wd: String = this.freshVar()
            pre.sbAdd("  " + wd + " = and i32 " + fl + ", 512\n")
            val we0: String = this.freshVar()
            pre.sbAdd("  " + we0 + " = and i32 " + fl + ", 1024\n")
            val we: String = this.freshVar()
            pre.sbAdd("  " + we + " = lshr i32 " + we0 + ", 7\n")
            val wf1: String = this.freshVar()
            pre.sbAdd("  " + wf1 + " = or i32 " + wa + ", " + wb + "\n")
            val wf2: String = this.freshVar()
            pre.sbAdd("  " + wf2 + " = or i32 " + wf1 + ", " + wc + "\n")
            val wf3: String = this.freshVar()
            pre.sbAdd("  " + wf3 + " = or i32 " + wf2 + ", " + wd + "\n")
            val wf4: String = this.freshVar()
            pre.sbAdd("  " + wf4 + " = or i32 " + wf3 + ", " + we + "\n")
            // 第 3 个实参是 **创建模式**（仅 `_O_CREAT` 时生效），UCRT 要求
            // `_S_IREAD(0x100) | _S_IWRITE(0x80)` = 384。
            // 旧实现硬编码 `i32 0`（无任何权限）→ Windows 建出的文件被标记为
            // **只读**，于是「第二次写入同一路径」一律失败（EACCES），而
            // `FileSystem.writeText` 丢弃返回值 → **静默不落盘**：
            // 编译器重写 `.ll` 失败后，`llc -verify` 校验的是**上一次的旧 IR**，
            // 报出早已修掉的错误（自举产物上表现为「改了代码但错误不变」）。
            return this.winCrtFinish(pre, "_open", "i32",
                "i8* " + p + ", i32 " + wf4 + ", i32 384")
        }
        // ── shell 执行：`run(command)` → UCRT `system`（内部走 `cmd /C`）──
        if (lc == "runshell" || lc == "system" || lc == "run") {
            val cmd: String = this.npAs(pre, paramsCsv, 0, "i8*")
            return this.winCrtFinish(pre, "system", "i32", "i8* " + cmd)
        }
        if (lc == "close" || lc == "closefile") {
            val fd: String = this.npAs(pre, paramsCsv, 0, "i32")
            return this.winCrtFinish(pre, "_close", "i32", "i32 " + fd)
        }
        if (lc == "lseek") {
            val fd: String = this.npAs(pre, paramsCsv, 0, "i32")
            val o: String = this.npAs(pre, paramsCsv, 1, "i64")
            val w: String = this.npAs(pre, paramsCsv, 2, "i32")
            return this.winCrtFinish(pre, "_lseeki64", "i64",
                "i32 " + fd + ", i64 " + o + ", i32 " + w)
        }
        if (lc == "fstat" || lc == "statfile") {
            val fd: String = this.npAs(pre, paramsCsv, 0, "i32")
            val b: String = this.npAs(pre, paramsCsv, 1, "i8*")
            return this.winCrtFinish(pre, "_fstat", "i32", "i32 " + fd + ", i8* " + b)
        }
        if (lc == "stat") {
            val p: String = this.npAs(pre, paramsCsv, 0, "i8*")
            val b: String = this.npAs(pre, paramsCsv, 1, "i8*")
            return this.winCrtFinish(pre, "_stat64", "i32", "i8* " + p + ", i8* " + b)
        }
        if (lc == "unlink") {
            val p: String = this.npAs(pre, paramsCsv, 0, "i8*")
            return this.winCrtFinish(pre, "_unlink", "i32", "i8* " + p)
        }
        if (lc == "unlinkat") {
            val p: String = this.npAs(pre, paramsCsv, 1, "i8*")
            return this.winCrtFinish(pre, "_unlink", "i32", "i8* " + p)
        }
        if (lc == "access") {
            val p: String = this.npAs(pre, paramsCsv, 0, "i8*")
            val m: String = this.npAs(pre, paramsCsv, 1, "i32")
            return this.winCrtFinish(pre, "_access", "i32", "i8* " + p + ", i32 " + m)
        }
        if (lc == "mkdir" || lc == "mkdirfile") {
            val p: String = this.npAs(pre, paramsCsv, 0, "i8*")
            return this.winCrtFinish(pre, "_mkdir", "i32", "i8* " + p)
        }
        if (lc == "rmdir" || lc == "rmdirfile") {
            val p: String = this.npAs(pre, paramsCsv, 0, "i8*")
            return this.winCrtFinish(pre, "_rmdir", "i32", "i8* " + p)
        }
        if (lc == "getpid") {
            return this.winCrtFinish(pre, "_getpid", "i32", "")
        }
        if (lc == "rename") {
            val old: String = this.npAs(pre, paramsCsv, 0, "i8*")
            val new: String = this.npAs(pre, paramsCsv, 1, "i8*")
            // 目标符号必须与包装器自身的 LLVM 符号（`rename`）区分，否则会自递归；
            // 同时 UCRT 不导出 `_rename`，故由 runtime/crt.ll 提供 `_rename` 定义
            //（转发到 kernel32 的 `MoveFileA`，成功率语义与 rename 对齐：0 成功）。
            return this.winCrtFinish(pre, "_rename", "i32", "i8* " + old + ", i8* " + new)
        }
        if (lc == "exit" || lc == "exitgroup" || lc == "exitprocess") {
            val c: String = this.npAs(pre, paramsCsv, 0, "i32")
            return this.winCrtFinish(pre, "exit", "void", "i32 " + c)
        }
        return ""
    }

    /// 发射一个 @native 函数包装器（`define`），追加到 `funcParts`。
    fun emitNativeWrapper(hir: Hir, id: Int) {
        val sym: String = sanitizeLlvm(hir.textOf(id))
        val rawName: String = hir.textOf(id)
        // 同名包装器去重（首个定义胜出；重复会触发 llc invalid redefinition）
        if (aotContains(this.fNativeSyms, "\n" + sym + "\n")) {
            return
        }
        this.fNativeSyms = this.fNativeSyms + "\n" + sym + "\n"
        val meta: String = this.nativeMetaOf(hir, id)
        val isSyscall: Boolean = meta.startsWith("native|")

        var retTy: String = this.mapTy(hir.tyOf(id))
        if (isSyscall) {
            retTy = "i64"
        }
        if (retTy == "") {
            retTy = "void"
        }
        val sig: String = this.nativeFunctionSignature(hir, id)
        val paramsCsv: String = aotFieldAt(sig, 2, "|")
        val paramsIr: String = this.nativeParamsIr(paramsCsv)

        var body: String = ""
        var rawValue: String = ""
        if (isSyscall) {
            // Windows：**平台感知** —— 不发射裸 `syscall`，改调平台实现（CRT）。
            //
            // 两个硬伤决定了必须分支：
            //   1. `native/Syscalls.aura` 的 `SYS_*` 是 Linux 编号，Windows 走
            //      Nt ABI + 内核句柄语义，编号/参数都不可移植；
            //   2. x86 目标默认按 AT&T 解析内联汇编，旧实现发射的
            //      `mov rax, 1; syscall` 直接报
            //      `unknown use of instruction mnemonic without a size suffix`
            //     （即当前阻塞点：llc 汇编阶段失败）。
            // 见 `winCrtWrapper`：`_write/_read/_open/.../_getpid/exit` 即
            // 「平台对应的实现」（clang 在 Windows 上默认链接 UCRT）。
            if (aotContains(this.targetTriple, "windows")) {
                val wr: String = this.winCrtWrapper(rawName, paramsCsv)
                if (wr != "" && aotContains(wr, "|")) {
                    retTy = aotFieldAt(wr, 0, "|")
                    body = aotFieldAt(wr, 1, "|")
                } else {
                    // 未映射（Windows 无对应语义：fork / execve / kill /
                    // clockGettime / getrandom …）：返回 0，避免发射非法 IR
                    //（`rawValue` 由尾部统一处理为 `ret i64 0`）。
                    retTy = "i64"
                    rawValue = "0"
                }
            } else {
            // Phase A.1：@native(SYS_READ) 直接生成内联 syscall 指令，
            // 不再调用 C 分发入口 @aura_syscall_dispatch。
            val nr: String = toStr(aotSyscallNumber(aotSlice(meta, 7, meta.length - 7)))
            val pc: Int = aotCsvCount(paramsCsv)
            // 构造 inline asm 实参列表（不足 6 个补 i64 0）
            var asmArgs: String = ""
            var ai: Int = 0
            while (ai < 6) {
                if (ai > 0) { asmArgs = asmArgs + ", " }
                if (ai < pc) {
                    asmArgs = asmArgs + "i64 %arg." + toStr(ai)
                } else {
                    asmArgs = asmArgs + "i64 0"
                }
                ai = ai + 1
            }
            // 按目标三元组生成平台特定的 syscall 内联汇编
            // x86_64: rdi/rsi/rdx/r10/r8/r9 = arg0-5, rax = syscall nr
            // aarch64: x0-x5 = arg0-5, x16 = syscall nr
            if (aotContains(this.targetTriple, "x86_64")
                || aotContains(this.targetTriple, "i686")) {
                // 必须显式切 **Intel 语法**：LLVM 在 x86 上默认按 AT&T 解析内联汇编，
                // `mov rax, 1` 会报
                // `unknown use of instruction mnemonic without a size suffix`
                //（与下方 `asm|` 通用路径保持一致）。
                val escaped: String = ".intel_syntax noprefix; mov rax, " + nr + "; syscall"
                body = "call i64 asm sideeffect \"" + escaped
                    + "\", \"=r,{rdi},{rsi},{rdx},{r10},{r8},{r9}\"(" + asmArgs + ")"
            } else {
                // aarch64: 通用回退路径
                val escaped: String = "mov x16, " + nr + "; svc #0"
                body = "call i64 asm sideeffect \"" + escaped
                    + "\", \"=r,{x0},{x1},{x2},{x3},{x4},{x5}\"(" + asmArgs + ")"
            }
            }
        } else if (meta.startsWith("asm|")) {
            val code: String = aotSlice(meta, 4, meta.length - 4)
            val lc: String = aotToLower(code)
            val nlc: String = aotToLower(sym)
            // Phase A.3：fence/barrier → LLVM `fence seq_cst` 指令
            // 不再调用 C 封装 @aura_cpu_mem_fence
            if (aotContains(lc, "fence") || aotContains(lc, "barrier")
                || aotContains(nlc, "fence") || aotContains(nlc, "barrier")) {
                body = "fence seq_cst"
                retTy = "void"
            } else if (aotContains(lc, "atomic") || aotContains(nlc, "atomic")) {
                // Phase A.4：atomic → LLVM `atomicrmw add` 指令
                // 不再调用 C 封装 @aura_cpu_atomic_add
                val pt: String = this.freshVar()
                var atomicBody: String = pt + " = inttoptr i64 %arg.0 to i64*"
                if (aotCsvCount(paramsCsv) >= 2) {
                    atomicBody = atomicBody + "\n%result = atomicrmw add i64* " + pt
                        + ", i64 %arg.1 seq_cst"
                } else {
                    atomicBody = atomicBody + "\n%result = atomicrmw add i64* " + pt
                        + ", i64 0 seq_cst"
                }
                body = atomicBody
                retTy = "i64"
            } else if (aotContains(nlc, "arcincrement") || aotContains(nlc, "arcdecrement")
                || aotContains(lc, "lock inc") || aotContains(lc, "lock dec")) {
                // ARC 引用计数：改发 **LLVM 原子指令**（平台无关），不再用
                // `lock inc/dec` 内联汇编。两个原因：
                //   1. `.intel_syntax noprefix; lock inc qword [rdi]` 缺 `ptr`
                //      关键字 → llc 报 `Expected 'PTR' or 'ptr' token!`
                //     （x86 下 Intel 语法必须写 `qword ptr [rdi]`）；
                //   2. 旧写法用 `=r` 输出约束，而 `lock inc` 不会写该寄存器，
                //      返回值本身就是未定义值（注释称「返回值在 rax」，但寄存器
                //      由分配器决定，不保证是 rax）。
                // `atomicrmw` 返回**旧值** → inc 取 `old+1`、dec 取 `old-1`；
                // `seq_cst` 与 Rust 侧 `@native(asm=atomic)` 路径语义一致。
                var isIncArc: Boolean = false
                if (aotContains(nlc, "arcincrement") || aotContains(lc, "lock inc")) {
                    isIncArc = true
                }
                val ptArc: String = this.freshVar()
                var arcBody: String = ptArc + " = inttoptr i64 %arg.0 to i64*"
                if (isIncArc) {
                    arcBody = arcBody + "\n%old = atomicrmw add i64* " + ptArc + ", i64 1 seq_cst"
                } else {
                    arcBody = arcBody + "\n%old = atomicrmw sub i64* " + ptArc + ", i64 1 seq_cst"
                }
                if (retTy == "void") {
                    body = arcBody
                } else {
                    if (isIncArc) {
                        arcBody = arcBody + "\n%result = add i64 %old, 1"
                    } else {
                        arcBody = arcBody + "\n%result = sub i64 %old, 1"
                    }
                    body = arcBody
                    retTy = "i64"
                }
            } else {
                // 通用内联汇编：LLVM asm-call 语法
                //   `call <ret> asm sideeffect "<code>", "<constraints>"(<args>)`
                // 要点（与 Rust 侧 `emit_native_wrapper` 保持一致）：
                //   * 即使无输入也必须带空参数表 `()`（缺 `()` llc 报
                //     `expected '(' in call`）；
                //   * 输出约束数须与返回值个数一致（统一用通用寄存器 `=r`）；
                //   * 形参按 `r` 约束作为输入操作数传入；
                //   * x86 目标按 **Intel 语法** 解析（仓库自带 FFI 片段即 Intel 写法，
                //     如 `call qword [rip + WriteFile]`）。
                var asmBody: String = code
                if (aotContains(this.targetTriple, "x86_64")
                    || aotContains(this.targetTriple, "i686")) {
                    asmBody = ".intel_syntax noprefix; " + code
                }
                val escaped: String = aotReplaceAll(asmBody, "\"", "\\\"")
                var constraints: String = ""
                if (retTy != "void") {
                    constraints = "=r"
                }
                var argList: String = ""
                val pn: Int = aotCsvCount(paramsCsv)
                var pi: Int = 0
                while (pi < pn) {
                    if (constraints != "") {
                        constraints = constraints + ","
                    }
                    constraints = constraints + "r"
                    if (argList != "") {
                        argList = argList + ", "
                    }
                    argList = argList + trimSpaces(aotFieldAt(paramsCsv, pi, ","))
                        + " %arg." + toStr(pi)
                    pi = pi + 1
                }
                if (constraints == "") {
                    constraints = "~{memory}"
                }
                val asmCall: String = "call " + retTy + " asm sideeffect \"" + escaped
                    + "\", \"" + constraints + "\"(" + argList + ")"
                if (retTy == "void") {
                    body = asmCall
                } else {
                    body = "%result = " + asmCall
                }
            }
        } else {
            // Phase A.5：编译器内置（Memory.alloc / free / read / write / copy / set）
            // 不再调用 C 封装 @aura_memory_alloc/free，改用系统 libc 的 malloc/free
            val lc: String = aotToLower(sym)
            if (aotContains(lc, "alloc") || aotContains(rawName, "alloc")) {
                // declare i64 @malloc(i64) ← 系统 libc 解析
                body = "call i64 @malloc(i64 %arg.0)"
                retTy = "i64"
            } else if (aotContains(lc, "free") || aotContains(rawName, "free")) {
                // declare void @free(i64) ← 系统 libc 解析
                body = "call void @free(i64 %arg.0)"
                retTy = "void"
            } else if ((aotContains(lc, "read") || aotContains(rawName, "read"))
                && aotContains(rawName, "Memory")) {
                // 地址是 i64，需 inttoptr 转为 i8* 再 load
                body = "%ptr.0 = inttoptr i64 %arg.0 to i8*\n%result = load i8, i8* %ptr.0"
                retTy = "i8"
            } else if ((aotContains(lc, "write") || aotContains(rawName, "write"))
                && aotContains(rawName, "Memory")) {
                body = "%ptr.0 = inttoptr i64 %arg.0 to i8*\nstore i8 %arg.1, i8* %ptr.0"
                retTy = "void"
            } else if (aotContains(rawName, "ThreadOps") || aotContains(rawName, "Thread")) {
                // ThreadOps 内置：调用运行库 C 封装
                if (aotContains(lc, "create")) {
                    body = "call i64 @aura_thread_create(i64 %arg.0, i64 %arg.1)"
                    retTy = "i64"
                } else if (aotContains(lc, "join")) {
                    body = "call i64 @aura_thread_join(i64 %arg.0)"
                    retTy = "i64"
                } else if (aotContains(lc, "sleep")) {
                    body = "call void @aura_thread_sleep(i64 %arg.0)"
                    retTy = "void"
                } else if (aotContains(lc, "currentid") || aotContains(lc, "id")) {
                    body = "call i64 @aura_thread_id()"
                    retTy = "i64"
                } else if (aotContains(lc, "cores") || aotContains(lc, "parallelism")) {
                    body = "call i64 @aura_thread_available_parallelism()"
                    retTy = "i64"
                } else {
                    rawValue = EmitUtils.defaultValue(retTy)
                }
            } else {
                // 未知内置：直接返回默认值（不生成非法 IR）
                rawValue = EmitUtils.defaultValue(retTy)
            }
        }

        val buf: EmitBuffer = EmitBuffer()
        buf.sbAdd("define ")
        buf.sbAdd(retTy)
        buf.sbAdd(" @")
        buf.sbAdd(sym)
        buf.sbAdd("(")
        buf.sbAdd(paramsIr)
        buf.sbAdd(") {\n")
        buf.sbAdd("entry:\n")
        if (rawValue != "" && retTy != "void") {
            buf.sbAdd("  ret ")
            buf.sbAdd(retTy)
            buf.sbAdd(" ")
            buf.sbAdd(rawValue)
            buf.sbAdd("\n")
        } else {
            // body 已含 `%result =`（多行体/内联汇编）时不再重复结果前缀
            val hasResultAssign: Boolean = aotContains(body, "%result = ")
            if (retTy == "void") {
                buf.sbAdd(body)
                buf.sbAdd("\n")
                buf.sbAdd("  ret void\n")
            } else {
                if (!hasResultAssign) {
                    buf.sbAdd("%result = ")
                }
                buf.sbAdd(body)
                buf.sbAdd("\n")
                buf.sbAdd("  ret ")
                buf.sbAdd(retTy)
                buf.sbAdd(" %result\n")
            }
        }
        buf.sbAdd("}\n\n")
        this.funcParts.sbAdd(buf.sbBuild())
    }

    /// `@aot fun` → **weak 桩定义**（真实实现在链接期由 AOT 库提供）。
    ///
    /// 旧实现发射裸 `declare`：`@aot` 库未参与链接时 `lld-link` 直接报
    /// `undefined symbol: add/multiply/…` 而整体失败。改为 `define weak`
    /// 提供返回零值的桩：库存在时强符号优先，库缺失时也能链接并运行。
    fun aotDeclLine(hir: Hir, id: Int): String {
        val sym: String = sanitizeLlvm(hir.textOf(id))
        var retTy: String = this.mapTy(hir.tyOf(id))
        if (retTy == "") {
            retTy = "void"
        }
        val sig: String = this.functionSignature(hir, id)
        val pCsv: String = aotFieldAt(sig, 2, "|")
        val pn: Int = aotCsvCount(pCsv)
        var paramsIr: String = ""
        var pi: Int = 0
        while (pi < pn) {
            val pt: String = trimSpaces(aotFieldAt(pCsv, pi, ","))
            if (pt != "") {
                if (paramsIr != "") {
                    paramsIr = paramsIr + ", "
                }
                paramsIr = paramsIr + pt + " %arg." + toStr(pi)
            }
            pi = pi + 1
        }
        var out: String = "; @aot: AOT library function (weak stub; strong def wins)\n"
        out = out + "define weak " + retTy + " @" + sym + "(" + paramsIr + ") {\n"
        out = out + "entry:\n"
        if (retTy == "void") {
            out = out + "  ret void\n"
        } else {
            out = out + "  ret " + retTy + " " + EmitUtils.defaultValue(retTy) + "\n"
        }
        out = out + "}\n"
        return out
    }

    // ── lambda / 闭包（Phase B.2）──
    //
    // 闭包 ABI（与 Rust AOT 后端 `compiler/src/codegen/aot/emit.rs` 对齐）：
    //   `define <ret> @__lambda_N(i8* %env, <用户形参…>)`
    //   env 为堆分配的 `{ i8* fn }`（字段 0 = 函数指针）；
    //   闭包**值**即 env 指针（本发射器统一用 `i8*` 表示）。
    //   调用点：`%fn = load i8*, i8** %clo` → `call <ret> %fn(i8* %clo, args…)`。
    //
    // 限制（当前实现）：
    //   * 不支持捕获外层变量（自由变量按未定义变量处理 → 求值为 0）；
    //   * 不支持嵌套 lambda（子上下文状态只保存一层）；
    //   * 块体 lambda 需用显式 `return` 提供返回值（裸表达式体自动作为返回值）。

    /// 外层发射状态备份（`enterLambdaCtx` / `leaveLambdaCtx`）。
    var svBody: EmitBuffer = EmitBuffer()
    var svAlloca: EmitBuffer = EmitBuffer()
    var svVarList: List<String> = arrayListOf<String>()
    var svVarNames: List<String> = arrayListOf<String>()
    var svRetTy: String = ""
    var svListVars: String = ""
    var svClosureSigs: String = ""
    var svTerminated: Boolean = false

    /// 是否为 Aura 函数类型（`(Int) -> Int` / `(Int, String) -> Int` …）。
    fun isFnTy(ty: String): Boolean {
        if (ty == "") {
            return false
        }
        return aotSlice(ty, 0, 1) == "(" && EmitUtils.aotIndexOfSub(ty, "->") >= 0
    }

    /// 去掉类型串两端的空白。
    fun TrimType(s: String): String {
        var st: Int = 0
        var en: Int = s.length
        while (st < en && aotSlice(s, st, 1) == " ") {
            st = st + 1
        }
        while (en > st && aotSlice(s, en - 1, 1) == " ") {
            en = en - 1
        }
        return aotSlice(s, st, en - st)
    }

    /// CSV 切分（括号深度感知）：`(Int, (Int)->Int)` 中的逗号不会切开嵌套类型。
    fun splitCsvDeep(s: String): List<String> {
        val out: List<String> = arrayListOf<String>()
        var depth: Int = 0
        var start: Int = 0
        var i: Int = 0
        while (i < s.length) {
            val ch: String = aotSlice(s, i, 1)
            if (ch == "(") {
                depth = depth + 1
            } else if (ch == ")") {
                depth = depth - 1
            } else if (ch == "," && depth == 0) {
                out.add(aotSlice(s, start, i - start))
                start = i + 1
            }
            i = i + 1
        }
        out.add(aotSlice(s, start, s.length - start))
        return out
    }

    /// 找**最后一个** `->`（自右向左扫描）。
    ///
    /// 参数里可能嵌套函数类型（`((T) -> Boolean) -> Boolean`），首次出现不是
    /// 分隔符 → 必须取末位。此前用首次匹配会把返回类型误读成 `"T)"`，进而
    /// 生成 `%struct.T_*` 未定义类型（llc: use of undefined type named
    /// 'struct.T_'）导致整个模块编译失败。
    fun fnTypeArrowLast(s: String): Int {
        var i: Int = s.length - 2
        while (i >= 0) {
            if (aotSlice(s, i, 1) == "-" && aotSlice(s, i + 1, 1) == ">") {
                return i
            }
            i = i - 1
        }
        return -1
    }

    /// Aura 函数类型 → 闭包签名 `retTy|p1,p2`（与 `closureSigOfVar` 返回格式一致）。
    ///
    /// `(Int, String) -> Int` → `i32|i32,i8*`。非函数类型返回 ""。
    fun fnTypeSig(ty: String): String {
        val resolved: String = this.resolveAlias(ty)
        if (!this.isFnTy(resolved)) {
            return ""
        }
        val arrow: Int = this.fnTypeArrowLast(resolved)
        if (arrow < 0) {
            return ""
        }
        var retAura: String = TrimType(this.aotSlice(resolved, arrow + 2, resolved.length - arrow - 2))
        var retTy: String = this.mapTy(retAura)
        if (retTy == "" || retTy == "void") {
            retTy = "i32"
        }
        var paramsAura: String = aotSlice(resolved, 0, arrow)
        // 去掉首尾的空白与外层括号：`(T) ` → `T`。
        // 之前直接用 `aotSlice(p, 1, p.length - 2)` 会因为右侧的**尾部空白**
        // （`resolved` 里 `-> ` 前有空格）保留下 `)` → `mapTy("T)")` 落到
        // `%struct.T_*` 未定义类型。先 Trim 再剥括号，最后再 Trim 一次。
        var inner: String = TrimType(paramsAura)
        if (aotSlice(inner, 0, 1) == "(") {
            inner = aotSlice(inner, 1, inner.length - 2)
            inner = TrimType(inner)
        }
        var pTys: String = ""
        val parts: List<String> = this.splitCsvDeep(inner)
        var i: Int = 0
        while (i < parts.size) {
            var pty: String = this.mapTy(TrimType(parts[i]))
            if (pty == "" || pty == "void") {
                pty = "i32"
            }
            if (pTys != "") {
                pTys = pTys + ","
            }
            pTys = pTys + pty
            i = i + 1
        }
        return retTy + "|" + pTys
    }

    /// `call` 节点若调用的是「返回函数类型」的函数，返回闭包签名。
    ///
    /// 命中后调用方可把结果登记成闭包变量：`val f = makeAdder(5)` → `f(10)`
    /// 走间接调用（否则 `f(10)` 按普通函数解析失败 → 恒得 0）。
    fun callFnSig(hir: Hir, id: Int): String {
        if (hir.kindOf(id) != "HirCall") {
            return ""
        }
        val kids: String = hir.kidsOf(id)
        var fname: String = ""
        if (hirKidsCount(kids) < 1) {
            // 无参调用（`makeTransformerSimple()`）：HIR 里 HirCall 无 kids，
            // 函数名只存在于 HirCall 自身。旧实现遇到空 kids 直接 `return ""`
            // → `val f = makeTransformerSimple()` 不会登记为闭包，调用点
            // `f(5)` 无法走间接调用路径。
            fname = hir.textOf(id)
        } else {
            val callee: Int = hirKidsAt(kids, 0)
            val ck: String = hir.kindOf(callee)
            if (ck == "HirVar" || ck == "HirIdent") {
                fname = hir.textOf(callee)
            }
            if (fname == "") {
                fname = hir.textOf(id)
            }
        }
        val sym: String = sanitizeLlvm(fname)
        var ret: String = this.auraRetTyOf(sym)
        if (ret == "") {
            var u: Int = 0
            while (u < sym.length && aotSlice(sym, u, 1) != "_") {
                u = u + 1
            }
            if (u > 0 && u < sym.length - 1) {
                ret = this.auraRetTyOf(sanitizeLlvm(aotSlice(sym, 0, u) + "." + aotSlice(sym, u + 1, sym.length - u - 1)))
            }
        }
        return this.fnTypeSig(ret)
    }

    /// 闭包变量签名查询（局部 + 顶层）。
    fun closureSigOfAny(name: String): String {
        val local: String = this.closureSigOfVar(name)
        if (local != "") {
            return local
        }
        return this.globalClosureSigOf(name)
    }

    /// 顶层闭包变量签名查询（未登记返回 ""）。
    fun globalClosureSigOf(name: String): String {
        if (name == "" || this.fGlobalClosures == "") {
            return ""
        }
        val lines: List<String> = this.fGlobalClosures.split("\n")
        var i: Int = 0
        while (i < lines.size) {
            val ln: String = lines[i]
            i = i + 1
            if (ln == "") {
                continue
            }
            if (aotFieldAt(ln, 0, "|") == name) {
                return aotFieldAt(ln, 1, "|") + "|" + aotFieldAt(ln, 2, "|")
            }
        }
        return ""
    }

    /// 顶层闭包变量初始化器：为 `@<name>__init()` 生成函数体。
    ///
    /// 惰性语义：若全局指针非空则直接返回；否则构造 env（`malloc(8)` + 函数指针），
    /// 写回全局，之后访问即命中缓存。闭包签名登记进 `fGlobalClosures` 供调用点查询。
    fun emitGlobalClosure(hir: Hir, declId: Int, initId: Int) {
        val name: String = hir.textOf(declId)
        if (name == "") {
            return
        }
        var sig: String = ""
        if (hir.kindOf(initId) == "HirLambda") {
            sig = this.closureSigOf(hir, initId)
        } else {
            sig = this.callFnSig(hir, initId)
        }
        if (sig == "") {
            return
        }
        this.fGlobalClosures = this.fGlobalClosures + name + "|" + sig + "\n"

        // 惰性初始化函数 `@<name>__init()`：
        //   entry:
        //     %p = load i8*, i8** @<name>
        //     %n = icmp ne i8* %p, null
        //     br %n, ret, init
        //   ret:
        //     ret i8* %p
        //   init:
        //     %env = call i8* @malloc(i64 8)
        //     %e = bitcast i8* %env to i8**
        //     <构造 env 内容>
        //     store i8* %env, i8** @<name>
        //     ret i8* %env
        this.globalParts.sbAdd("define i8* @" + sanitizeLlvm(name) + "__init() {\n")
        this.globalParts.sbAdd("entry:\n")
        this.globalParts.sbAdd("  %p = load i8*, i8** @" + sanitizeLlvm(name) + "\n")
        this.globalParts.sbAdd("  %n = icmp ne i8* %p, null\n")
        this.globalParts.sbAdd("  br i1 %n, label %ret, label %init\n")
        this.globalParts.sbAdd("ret:\n")
        this.globalParts.sbAdd("  ret i8* %p\n")
        this.globalParts.sbAdd("init:\n")
        this.globalParts.sbAdd("  %env = call i8* @malloc(i64 8)\n")
        this.globalParts.sbAdd("  %e = bitcast i8* %env to i8**\n")

        // 用临时上下文发射 env 内容（字段 0 = 函数指针，字段 1.. = 捕获值）。
        val savedBody: EmitBuffer = this.fBody
        this.fBody = EmitBuffer()
        if (hir.kindOf(initId) == "HirLambda") {
            this.emitLambdaEnvBody(hir, initId, "%env", "%e")
        } else {
            this.emitLambdaEnvBody(hir, initId, "%env", "%e")
        }
        this.globalParts.sbAdd(this.fBody.sbBuild())
        this.fBody = savedBody

        this.globalParts.sbAdd("  store i8* %env, i8** @" + sanitizeLlvm(name) + "\n")
        this.globalParts.sbAdd("  ret i8* %env\n")
        this.globalParts.sbAdd("}\n\n")
    }

    /// 发射闭包 env 构造（供顶层闭包惰性初始化器使用）。
    ///
    /// 简化实现：仅处理 `HirLambda` 直接返回 `@__lambda_N` 函数指针的场景；
    /// `HirCall` 通过 `callFnSig` 识别的返回-函数类型的调用暂按 0 处理。
    fun emitLambdaEnvBody(hir: Hir, initId: Int, envName: String, envPtrName: String) {
        // 简化路径：HirLambda 已经通过 `emitLambda` 生成 `@__lambda_N`；
        // 这里需要的是「构造 env 首字段 = 函数指针」的 IR。
        // 通过重新发射一次 lambda 得到 env（复用 emitLambda 的静态函数分配逻辑）。
        if (hir.kindOf(initId) == "HirLambda") {
            // emitLambda 会生成 `@__lambda_N` + env，返回值即 env 指针；
            // 但顶层闭包需要的是把 lambda 的函数指针写入 env[0]。
            // 通过重放：先保存当前 lambda 计数，让 emitLambda 生成新的 env。
            val lp: String = this.lambdaPiece(hir, initId)
            val paramIds: String = aotFieldAt(lp, 0, "|")
            val bodyId: Int = aotToInt(aotFieldAt(lp, 1, "|"))
            val pTys: String = this.lambdaParamTys(hir, paramIds, bodyId)
            val retTy: String = this.lambdaRetTy(hir, paramIds, pTys, bodyId)
            val fnName: String = "__lambda_" + toStr(this.lambdaCount)
            this.lambdaCount = this.lambdaCount + 1
            val pc: Int = aotCsvCount(paramIds)
            // 子上下文发射 lambda 函数体
            this.enterLambdaCtx(paramIds, retTy)
            var i: Int = 0
            while (i < pc) {
                val pid: Int = aotToInt(aotFieldAt(paramIds, i, ","))
                val pn: String = hir.textOf(pid)
                val pty: String = aotFieldAt(pTys, i, ",")
                val addr: String = this.declareVar(pn, pty)
                this.fBody.sbAdd("  store ")
                this.fBody.sbAdd(pty)
                this.fBody.sbAdd(" %arg.")
                this.fBody.sbAdd(toStr(i))
                this.fBody.sbAdd(", ")
                this.fBody.sbAdd(EmitUtils.toPtrTySp(pty))
                this.fBody.sbAdd(addr)
                this.fBody.sbAdd("\n")
                i = i + 1
            }
            if (bodyId >= 0) {
                if (hir.kindOf(bodyId) == "HirBlock") {
                    this.emitBody(hir, bodyId)
                } else {
                    val v: String = this.emitExpr(hir, bodyId)
                    val vTy: String = this.inferType(hir, bodyId)
                    val cv: String = this.coerceValue(v, vTy, retTy)
                    this.fBody.sbAdd("  ret ")
                    this.fBody.sbAdd(retTy)
                    this.fBody.sbAdd(" ")
                    this.fBody.sbAdd(cv)
                    this.fBody.sbAdd("\n")
                    this.fTerminated = true
                }
            }
            if (!this.fTerminated) {
                if (retTy == "void") {
                    this.fBody.sbAdd("  ret void\n")
                } else {
                    this.fBody.sbAdd("  ret ")
                    this.fBody.sbAdd(retTy)
                    this.fBody.sbAdd(" ")
                    this.fBody.sbAdd(EmitUtils.defaultValue(retTy))
                    this.fBody.sbAdd("\n")
                }
            }
            val buf: EmitBuffer = EmitBuffer()
            buf.sbAdd("define ")
            buf.sbAdd(retTy)
            buf.sbAdd(" @")
            buf.sbAdd(fnName)
            buf.sbAdd("(i8* %env")
            i = 0
            while (i < pc) {
                buf.sbAdd(", ")
                buf.sbAdd(aotFieldAt(pTys, i, ","))
                buf.sbAdd(" %arg.")
                buf.sbAdd(toStr(i))
                i = i + 1
            }
            buf.sbAdd(") {\nentry:\n")
            buf.sbAdd(this.fAlloca.sbBuild())
            buf.sbAdd(this.fBody.sbBuild())
            buf.sbAdd("}\n\n")
            this.lambdaParts.sbAdd(buf.sbBuild())
            this.leaveLambdaCtx()
            // 把 lambda 函数指针写入 env[0]
            this.fBody.sbAdd("  store i8* @")
            this.fBody.sbAdd(fnName)
            this.fBody.sbAdd(", i8** ")
            this.fBody.sbAdd(envPtrName)
            this.fBody.sbAdd("\n")
        }
    }

    /// lambda 的闭包签名：`retTy|p1,p2`（供变量登记与间接调用）。
    fun closureSigOf(hir: Hir, lambdaId: Int): String {
        val lp: String = this.lambdaPiece(hir, lambdaId)
        val paramIds: String = aotFieldAt(lp, 0, "|")
        val bodyId: Int = aotToInt(aotFieldAt(lp, 1, "|"))
        val pTys: String = this.lambdaParamTys(hir, paramIds, bodyId)
        val retTy: String = this.lambdaRetTy(hir, paramIds, pTys, bodyId)
        return retTy + "|" + pTys
    }

    /// 闭包变量签名查询：返回 `retTy|p1,p2`（未登记返回 ""）。
    fun closureSigOfVar(name: String): String {
        if (name == "" || this.fClosureSigs == "") {
            return ""
        }
        val lines: List<String> = this.fClosureSigs.split("\n")
        var i: Int = 0
        while (i < lines.size) {
            val ln: String = lines[i]
            i = i + 1
            if (ln == "") {
                continue
            }
            if (aotFieldAt(ln, 0, "|") == name) {
                return aotFieldAt(ln, 1, "|") + "|" + aotFieldAt(ln, 2, "|")
            }
        }
        return ""
    }

    /// 登记闭包变量（`val f = <lambda>`）。
    fun registerClosureVar(name: String, sig: String) {
        if (name == "" || sig == "") {
            return
        }
        this.fClosureSigs = this.fClosureSigs + name + "|" + sig + "\n"
    }

    /// 拆解 HirLambda：返回 `paramId1,paramId2|bodyId`。
    fun lambdaPiece(hir: Hir, id: Int): String {
        val kids: String = hir.kidsOf(id)
        val n: Int = hirKidsCount(kids)
        var ps: String = ""
        var body: Int = -1
        var i: Int = 0
        while (i < n) {
            val cid: Int = hirKidsAt(kids, i)
            if (hir.kindOf(cid) == "HirParam") {
                if (ps != "") {
                    ps = ps + ","
                }
                ps = ps + toStr(cid)
            } else {
                body = cid
            }
            i = i + 1
        }
        return ps + "|" + toStr(body)
    }

    /// lambda 形参 LLVM 类型（`i32,i8*` 形式）。
    ///
    /// 类型来源：① `HirParam` 的类型注解；② 无注解时按 **body 用法**猜
    ///（参与字符串拼接 / 调用字符串方法 → `i8*`；否则 `i32`）。
    /// ② 是必需的：`val greet = name -> "Hello, " + name` 这种无注解 lambda
    /// 若把 `name` 当 `i32`，调用点会把 `"World"` 强转成 i32 再传 → 非法 IR。
    fun lambdaParamTys(hir: Hir, paramIds: String, bodyId: Int): String {
        var out: String = ""
        val n: Int = aotCsvCount(paramIds)
        var i: Int = 0
        while (i < n) {
            val pid: Int = aotToInt(aotFieldAt(paramIds, i, ","))
            var pty: String = this.mapTy(hir.tyOf(pid))
            if ((pty == "" || pty == "void") && bodyId >= 0) {
                if (this.paramUsedAsString(hir, bodyId, hir.textOf(pid), 0)) {
                    pty = "i8*"
                }
            }
            if (pty == "" || pty == "void") {
                pty = "i32"
            }
            if (out != "") {
                out = out + ","
            }
            out = out + pty
            i = i + 1
        }
        return out
    }

    /// 是否为字符串字面量节点。
    fun isStrLit(hir: Hir, id: Int): Boolean {
        if (id < 0 || id >= hir.count) {
            return false
        }
        return hir.kindOf(id) == "HirLit" && hir.tyOf(id) == "String"
    }

    /// 子树中是否引用了变量 `name`（深度受限的递归扫描）。
    fun containsVar(hir: Hir, id: Int, name: String, depth: Int): Boolean {
        if (id < 0 || id >= hir.count || depth > 12) {
            return false
        }
        if (hir.kindOf(id) == "HirVar" && hir.textOf(id) == name) {
            return true
        }
        val kids: String = hir.kidsOf(id)
        val n: Int = hirKidsCount(kids)
        var i: Int = 0
        while (i < n) {
            if (this.containsVar(hir, hirKidsAt(kids, i), name, depth + 1)) {
                return true
            }
            i = i + 1
        }
        return false
    }

    /// 是否是「只对字符串成立」的成员方法（用于推断无注解形参为 String）。
    fun isStringMember(m: String): Boolean {
        return m == "length" || m == "substring" || m == "contains"
            || m == "startsWith" || m == "endsWith" || m == "indexOf"
            || m == "lastIndexOf" || m == "toUpperCase" || m == "toLowerCase"
            || m == "trim" || m == "charAt" || m == "split" || m == "replace"
            || m == "replaceAll" || m == "substringBefore" || m == "substringAfter"
            || m == "padStart" || m == "charCodeAt" || m == "countChar"
    }

    /// 形参 `pname` 在 lambda body 中是否用于字符串上下文。
    ///
    /// 判定（任一成立即算）：
    ///   * `pname`（或含它的子表达式）与**字符串字面量**做 `+` / `==` / `!=`；
    ///   * `pname` 上调用字符串成员方法（`.substring` / `.contains` …）。
    fun paramUsedAsString(hir: Hir, id: Int, pname: String, depth: Int): Boolean {
        if (id < 0 || id >= hir.count || depth > 12) {
            return false
        }
        val k: String = hir.kindOf(id)
        val kids: String = hir.kidsOf(id)
        val n: Int = hirKidsCount(kids)
        if (k == "HirBinary" && n == 2) {
            val op: String = hir.textOf(id)
            if (op == "+" || op == "==" || op == "!=" || op == "equals") {
                val a0: Int = hirKidsAt(kids, 0)
                val a1: Int = hirKidsAt(kids, 1)
                if (this.isStrLit(hir, a0) && this.containsVar(hir, a1, pname, 0)) {
                    return true
                }
                if (this.isStrLit(hir, a1) && this.containsVar(hir, a0, pname, 0)) {
                    return true
                }
            }
        }
        if (k == "HirMember" && this.isStringMember(hir.textOf(id))
            && this.containsVar(hir, id, pname, 0)) {
            return true
        }
        var i: Int = 0
        while (i < n) {
            if (this.paramUsedAsString(hir, hirKidsAt(kids, i), pname, depth + 1)) {
                return true
            }
            i = i + 1
        }
        return false
    }

    /// 进入 lambda 子上下文（保存外层状态、切换局部变量表）。
    fun enterLambdaCtx(paramIds: String, retTy: String) {
        this.svBody = this.fBody
        this.svAlloca = this.fAlloca
        this.svVarList = this.fVarList
        this.svVarNames = this.fVarNames
        this.svRetTy = this.fRetTy
        this.svListVars = this.fListVars
        this.svClosureSigs = this.fClosureSigs
        this.svTerminated = this.fTerminated
        this.fBody = EmitBuffer()
        this.fAlloca = EmitBuffer()
        this.fVarList = arrayListOf<String>()
        this.fVarNames = arrayListOf<String>()
        this.fListVars = ""
        this.fClosureSigs = ""
        this.fRetTy = retTy
        this.fTerminated = false
        // 换代 → 清空 inferType 记忆化（依赖局部变量表）
        this.fGen = this.fGen + 1
        this.fGenStr = toStr(this.fGen)
    }

    /// 退出 lambda 子上下文（恢复外层状态）。
    fun leaveLambdaCtx() {
        this.fBody = this.svBody
        this.fAlloca = this.svAlloca
        this.fVarList = this.svVarList
        this.fVarNames = this.svVarNames
        this.fRetTy = this.svRetTy
        this.fListVars = this.svListVars
        this.fClosureSigs = this.svClosureSigs
        this.fTerminated = this.svTerminated
    }

    /// 推断 lambda 返回类型：在临时子上下文里声明形参后扫描 body 的 `HirReturn`。
    fun lambdaRetTy(hir: Hir, paramIds: String, pTys: String, bodyId: Int): String {
        if (bodyId < 0) {
            return "i32"
        }
        this.enterLambdaCtx(paramIds, "i32")
        // 形参入作用域（只为类型推断；真正的 alloca 在发射阶段再做）
        val pc: Int = aotCsvCount(paramIds)
        var i: Int = 0
        while (i < pc) {
            val pid: Int = aotToInt(aotFieldAt(paramIds, i, ","))
            var pty: String = aotFieldAt(pTys, i, ",")
            if (pty == "" || pty == "void") {
                pty = "i32"
            }
            this.declareVar(hir.textOf(pid), pty)
            i = i + 1
        }
        var rt: String = ""
        if (hir.kindOf(bodyId) == "HirBlock") {
            rt = this.scanBlockReturnTy(hir, bodyId)
        } else {
            rt = this.inferType(hir, bodyId)
        }
        this.leaveLambdaCtx()
        if (rt == "" || rt == "void") {
            rt = "i32"
        }
        return rt
    }

    /// 在块（含嵌套块）中找第一条 `HirReturn`，返回其值类型（无则 ""）。
    fun scanBlockReturnTy(hir: Hir, blockId: Int): String {
        val kids: String = hir.kidsOf(blockId)
        val n: Int = hirKidsCount(kids)
        var i: Int = 0
        while (i < n) {
            val cid: Int = hirKidsAt(kids, i)
            val ck: String = hir.kindOf(cid)
            if (ck == "HirReturn") {
                val rk: String = hir.kidsOf(cid)
                if (hirKidsCount(rk) > 0) {
                    return this.inferType(hir, hirKidsAt(rk, 0))
                }
            } else if (ck == "HirBlock") {
                val sub: String = this.scanBlockReturnTy(hir, cid)
                if (sub != "") {
                    return sub
                }
            }
            i = i + 1
        }
        return ""
    }

    /// 发射 lambda 表达式：生成静态函数 `@__lambda_N` + 堆分配 env，返回 env 指针。
    ///
    /// env 布局：`[0] = 函数指针`，`[1..] = 捕获值`（按 fVarList 顺序，每 8 字节）。
    /// 捕获变量：扫描 body 对**外层** fVarList 的引用，在 env 里存值，
    /// 进 lambda 后从 env 加载到栈槽供 body 读取。
    fun emitLambda(hir: Hir, id: Int): String {
        val lp: String = this.lambdaPiece(hir, id)
        val paramIds: String = aotFieldAt(lp, 0, "|")
        val bodyId: Int = aotToInt(aotFieldAt(lp, 1, "|"))
        val pTys: String = this.lambdaParamTys(hir, paramIds, bodyId)
        val retTy: String = this.lambdaRetTy(hir, paramIds, pTys, bodyId)
        val fnName: String = "__lambda_" + toStr(this.lambdaCount)
        this.lambdaCount = this.lambdaCount + 1
        val pc: Int = aotCsvCount(paramIds)

        // ── 捕获变量扫描：body 引用的外层变量（排除 lambda 自身形参）──
        var captured: String = ""
        if (bodyId >= 0) {
            var vi: Int = 0
            while (vi < this.fVarList.size) {
                val entry: String = this.fVarList[vi]
                vi = vi + 1
                val vname: String = aotFieldAt(entry, 0, "|")
                val vty: String = aotFieldAt(entry, 2, "|")
                val vaddr: String = aotFieldAt(entry, 1, "|")
                // 跳过 lambda 自身形参
                var isParam: Boolean = false
                var pi: Int = 0
                while (pi < pc) {
                    if (hir.textOf(aotToInt(aotFieldAt(paramIds, pi, ","))) == vname) {
                        isParam = true
                        break
                    }
                    pi = pi + 1
                }
                if (isParam) {
                    continue
                }
                if (this.containsVar(hir, bodyId, vname, 0)) {
                    if (captured != "") {
                        captured = captured + "\n"
                    }
                    captured = captured + vname + "|" + vaddr + "|" + vty
                }
            }
        }
        val capCount: Int = aotLineCount(captured)

        // ── 函数体（子上下文）──
        this.enterLambdaCtx(paramIds, retTy)
        // 形参入栈
        var i: Int = 0
        while (i < pc) {
            val pid: Int = aotToInt(aotFieldAt(paramIds, i, ","))
            val pn: String = hir.textOf(pid)
            val pty: String = aotFieldAt(pTys, i, ",")
            val addr: String = this.declareVar(pn, pty)
            this.fBody.sbAdd("  store ")
            this.fBody.sbAdd(pty)
            this.fBody.sbAdd(" %arg.")
            this.fBody.sbAdd(toStr(i))
            this.fBody.sbAdd(", ")
            this.fBody.sbAdd(EmitUtils.toPtrTySp(pty))
            this.fBody.sbAdd(addr)
            this.fBody.sbAdd("\n")
            i = i + 1
        }
        // 捕获变量：从 env 加载到栈槽（env[0]=fn ptr, env[1..]=捕获值）
        if (captured != "") {
            var ci: Int = 0
            while (ci < capCount) {
                val line: String = aotLineAt(captured, ci)
                ci = ci + 1
                val cname: String = aotFieldAt(line, 0, "|")
                val cty: String = aotFieldAt(line, 2, "|")
                val caddr: String = "%" + sanitizeLlvm(cname) + ".cap." + toStr(this.lambdaCount)
                this.fAlloca.sbAdd("  ")
                this.fAlloca.sbAdd(caddr)
                this.fAlloca.sbAdd(" = alloca ")
                this.fAlloca.sbAdd(cty)
                this.fAlloca.sbAdd("\n")
                this.fVarList.add(cname + "|" + caddr + "|" + cty)
                this.fVarNames.add(cname)
                val slotOff: Int = (ci + 1) * 8
                val gep: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(gep)
                this.fBody.sbAdd(" = getelementptr inbounds i8, i8* %env, i64 ")
                this.fBody.sbAdd(toStr(slotOff))
                this.fBody.sbAdd("\n")
                val cast: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(cast)
                this.fBody.sbAdd(" = bitcast i8* ")
                this.fBody.sbAdd(gep)
                this.fBody.sbAdd(" to ")
                this.fBody.sbAdd(cty)
                this.fBody.sbAdd("*\n")
                val ld: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(ld)
                this.fBody.sbAdd(" = load ")
                this.fBody.sbAdd(cty)
                this.fBody.sbAdd(", ")
                this.fBody.sbAdd(EmitUtils.toPtrTySp(cty))
                this.fBody.sbAdd(cast)
                this.fBody.sbAdd("\n")
                this.fBody.sbAdd("  store ")
                this.fBody.sbAdd(cty)
                this.fBody.sbAdd(" ")
                this.fBody.sbAdd(ld)
                this.fBody.sbAdd(", ")
                this.fBody.sbAdd(EmitUtils.toPtrTySp(cty))
                this.fBody.sbAdd(caddr)
                this.fBody.sbAdd("\n")
            }
        }
        if (bodyId >= 0) {
            if (hir.kindOf(bodyId) == "HirBlock") {
                this.emitBody(hir, bodyId)
            } else {
                // 裸表达式体（`x -> x * 2`）：其值即返回值
                val v: String = this.emitExpr(hir, bodyId)
                val vTy: String = this.inferType(hir, bodyId)
                val cv: String = this.coerceValue(v, vTy, retTy)
                this.fBody.sbAdd("  ret ")
                this.fBody.sbAdd(retTy)
                this.fBody.sbAdd(" ")
                this.fBody.sbAdd(cv)
                this.fBody.sbAdd("\n")
                this.fTerminated = true
            }
        }
        if (!this.fTerminated) {
            if (retTy == "void") {
                this.fBody.sbAdd("  ret void\n")
            } else {
                this.fBody.sbAdd("  ret ")
                this.fBody.sbAdd(retTy)
                this.fBody.sbAdd(" ")
                this.fBody.sbAdd(EmitUtils.defaultValue(retTy))
                this.fBody.sbAdd("\n")
            }
            this.fTerminated = true
        }
        val buf: EmitBuffer = EmitBuffer()
        buf.sbAdd("define ")
        buf.sbAdd(retTy)
        buf.sbAdd(" @")
        buf.sbAdd(fnName)
        buf.sbAdd("(i8* %env")
        i = 0
        while (i < pc) {
            buf.sbAdd(", ")
            buf.sbAdd(aotFieldAt(pTys, i, ","))
            buf.sbAdd(" %arg.")
            buf.sbAdd(toStr(i))
            i = i + 1
        }
        buf.sbAdd(") {\nentry:\n")
        buf.sbAdd(this.fAlloca.sbBuild())
        buf.sbAdd(this.fBody.sbBuild())
        buf.sbAdd("}\n\n")
        this.lambdaParts.sbAdd(buf.sbBuild())
        this.leaveLambdaCtx()

        // ── 外层：堆分配 env（字段 0 = 函数指针，字段 1.. = 捕获值）──
        val raw: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(raw)
        this.fBody.sbAdd(" = call i8* @malloc(i64 ")
        this.fBody.sbAdd(toStr(8 * (capCount + 1)))
        this.fBody.sbAdd(")\n")
        // env[0] = lambda 函数指针
        this.fBody.sbAdd("  store i8* @")
        this.fBody.sbAdd(fnName)
        this.fBody.sbAdd(", i8** ")
        this.fBody.sbAdd(raw)
        this.fBody.sbAdd("\n")
        // env[1..] = 捕获值（从外层栈读取）
        if (captured != "") {
            var ci: Int = 0
            while (ci < capCount) {
                val line: String = aotLineAt(captured, ci)
                ci = ci + 1
                val cname: String = aotFieldAt(line, 0, "|")
                val couter: String = aotFieldAt(line, 1, "|")
                val cty: String = aotFieldAt(line, 2, "|")
                val slotOff: Int = (ci + 1) * 8
                val gep: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(gep)
                this.fBody.sbAdd(" = getelementptr inbounds i8, i8* ")
                this.fBody.sbAdd(raw)
                this.fBody.sbAdd(", i64 ")
                this.fBody.sbAdd(toStr(slotOff))
                this.fBody.sbAdd("\n")
                val cast: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(cast)
                this.fBody.sbAdd(" = bitcast i8* ")
                this.fBody.sbAdd(gep)
                this.fBody.sbAdd(" to ")
                this.fBody.sbAdd(cty)
                this.fBody.sbAdd("*\n")
                val ld: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(ld)
                this.fBody.sbAdd(" = load ")
                this.fBody.sbAdd(cty)
                this.fBody.sbAdd(", ")
                this.fBody.sbAdd(EmitUtils.toPtrTySp(cty))
                this.fBody.sbAdd(couter)
                this.fBody.sbAdd("\n")
                this.fBody.sbAdd("  store ")
                this.fBody.sbAdd(cty)
                this.fBody.sbAdd(" ")
                this.fBody.sbAdd(ld)
                this.fBody.sbAdd(", ")
                this.fBody.sbAdd(EmitUtils.toPtrTySp(cty))
                this.fBody.sbAdd(cast)
                this.fBody.sbAdd("\n")
            }
        }
        return raw
    }

    /// 发射闭包变量的间接调用：`f(args…)` → `%fn = load …; call <ret> %fn(env, args…)`。
    fun emitIndirectCall(hir: Hir, kids: String, n: Int, argStart: Int,
        fname: String, sig: String): String {
        val retTy: String = aotFieldAt(sig, 0, "|")
        val pTys: String = aotFieldAt(sig, 1, "|")
        // env 指针（闭包值）：`emitVarLoad` 已按 `i8*` 加载闭包变量
        // （与 `emitLambda` 的 `malloc` 返回值、`TypeMapper.map` 对函数类型
        // 的映射一致），无需 `inttoptr` 隐式转换。
        val cloPtr: String = this.emitVarLoad(fname)
        val fn: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(fn)
        this.fBody.sbAdd(" = load i8*, i8** ")
        this.fBody.sbAdd(cloPtr)
        this.fBody.sbAdd("\n")
        var args: String = "i8* " + cloPtr
        var ai: Int = 0
        var i: Int = argStart
        while (i < n) {
            val aId: Int = hirKidsAt(kids, i)
            val aTy: String = this.inferType(hir, aId)
            val a: String = this.emitExpr(hir, aId)
            var want: String = aotFieldAt(pTys, ai, ",")
            if (want == "") {
                want = aTy
            }
            if (want == "") {
                want = "i32"
            }
            args = args + ", " + want + " " + this.coerceValue(a, aTy, want)
            ai = ai + 1
            i = i + 1
        }
        if (retTy == "" || retTy == "void") {
            this.fBody.sbAdd("  call void ")
            this.fBody.sbAdd(fn)
            this.fBody.sbAdd("(")
            this.fBody.sbAdd(args)
            this.fBody.sbAdd(")\n")
            return "0"
        }
        val res: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(res)
        this.fBody.sbAdd(" = call ")
        this.fBody.sbAdd(retTy)
        this.fBody.sbAdd(" ")
        this.fBody.sbAdd(fn)
        this.fBody.sbAdd("(")
        this.fBody.sbAdd(args)
        this.fBody.sbAdd(")\n")
        return res
    }

    /// 发射函数体 / 语句块。
    fun emitBody(hir: Hir, id: Int) {
        if (hir.kindOf(id) == "HirBlock") {
            val kids: String = hir.kidsOf(id)
            val n: Int = hirKidsCount(kids)
            var i: Int = 0
            while (i < n) {
                this.emitStmt(hir, hirKidsAt(kids, i))
                i = i + 1
            }
        } else {
            this.emitStmt(hir, id)
        }
    }

    /// 发射单条语句。
    fun emitStmt(hir: Hir, id: Int) {
        if (id < 0 || id >= hir.count) {
            return
        }
        // 上一语句已终结（ret/br）后仍有后续语句时，开启一个新的（不可达）基本块，
        // 保证每条指令都隶属于带终结符的基本块（否则 llc 报 expected instruction opcode）。
        if (this.fTerminated) {
            val deadBb: String = this.freshBb("dead")
            this.fBody.sbAdd(deadBb)
            this.fBody.sbAdd(":\n")
            this.fTerminated = false
        }
        val k: String = hir.kindOf(id)
        if (k == "HirValDecl" || k == "HirVarDecl") {
            this.emitDecl(hir, id)
        } else if (k == "HirReturn") {
            this.emitReturn(hir, id)
        } else if (k == "HirAssign") {
            this.emitAssign(hir, id)
        } else if (k == "HirIf") {
            this.emitIf(hir, id)
        } else if (k == "HirWhile") {
            this.emitWhile(hir, id)
        } else if (k == "HirBlock") {
            this.emitBody(hir, id)
        } else if (k == "HirFor") {
            this.emitFor(hir, id)
        } else if (k == "HirTry") {
            this.emitTry(hir, id)
        } else if (k == "HirIfExpr") {
            // `else if` 链被 HIR 降级为**表达式**形态（`HirIfExpr`
            // kids=[cond, then(, else)]）却出现在语句位置：按条件语句发射。
            // 旧实现落到末尾「表达式语句」分支 → 只取 then 值、**完全忽略条件**，
            // 导致所有 `else if` 分支永不执行（自举编译器读参数就是因此失效）。
            this.emitIf(hir, id)
        } else if (k == "HirBreak") {
            // break → 跳到当前循环的 end 块（无循环上下文时忽略）
            if (this.loopEnd != "") {
                this.fBody.sbAdd("  br label %")
                this.fBody.sbAdd(this.loopEnd)
                this.fBody.sbAdd("\n")
                this.fTerminated = true
            }
        } else if (k == "HirContinue") {
            // continue → 跳到当前循环的条件/自增块
            if (this.loopCond != "") {
                this.fBody.sbAdd("  br label %")
                this.fBody.sbAdd(this.loopCond)
                this.fBody.sbAdd("\n")
                this.fTerminated = true
            }
        } else {
            // 表达式语句：求值即可（副作用如调用）
            this.emitExpr(hir, id)
        }
    }

    /// 迭代对象是否为整型区间（`a..b` / `a..<b` → `__range` 调用）。
    fun isRangeIterable(hir: Hir, id: Int): Boolean {
        if (hir.kindOf(id) != "HirCall") {
            return false
        }
        val fname: String = hir.textOf(id)
        if (fname == "__range") {
            return true
        }
        return aotLastSegment(fname) == "range"
    }

    /// 取命名实参列表中某个形参名对应的实参 id（未命中返回 ""）。
    fun namedArgId(named: String, pname: String): String {
        if (pname == "") {
            return ""
        }
        val parts: List<String> = named.split("\n")
        var i: Int = 0
        while (i < parts.size) {
            if (aotFieldAt(parts[i], 0, "|") == pname) {
                return aotFieldAt(parts[i], 1, "|")
            }
            i = i + 1
        }
        return ""
    }

    /// 构造本次调用的实参 id 列表（`id0,id1,…`）。
    ///
    /// 普通实参按原顺序；**命名实参**（`HirNamedArg`）按被调用函数的形参名
    /// 重排到正确位置 —— 否则 `f(active = false, name = "Bob")` 会按位置把
    /// `false` 当 String 传，运行期把装箱布尔句柄当字符串指针解引用而崩溃。
    /// `off` 为实参位置与形参表下标的偏移（隐式 self：`prependThis` / 静态类方法）。
    fun buildArgIds(hir: Hir, kids: String, effArgStart: Int, n: Int,
        sym: String, off: Int): String {
        var posQueue: String = ""
        var named: String = ""
        var hasNamed: Boolean = false
        var i: Int = effArgStart
        while (i < n) {
            val aId: Int = hirKidsAt(kids, i)
            if (hir.kindOf(aId) == "HirNamedArg") {
                hasNamed = true
                named = named + hir.textOf(aId) + "|" + toStr(aId) + "\n"
            } else {
                if (posQueue != "") {
                    posQueue = posQueue + ","
                }
                posQueue = posQueue + toStr(aId)
            }
            i = i + 1
        }
        if (!hasNamed) {
            return posQueue
        }
        val defs: String = this.paramDefsOf(sym)
        if (defs == "") {
            return posQueue
        }
        val total: Int = aotCsvCount(defs)
        // 1) 命名实参按其形参名占位
        var slots: String = ""
        var filled: String = ""
        var j: Int = off
        while (j < total) {
            val pid: Int = aotToInt(aotFieldAt(defs, j, ","))
            if (pid >= 0) {
                val fid: String = this.namedArgId(named, hir.textOf(pid))
                if (fid != "") {
                    slots = slots + toStr(j) + "|" + fid + "\n"
                    filled = filled + "," + toStr(j) + ","
                }
            }
            j = j + 1
        }
        // 2) 位置实参从左到右填入尚未被占用的形参位
        var pq: Int = 0
        val pc: Int = aotCsvCount(posQueue)
        var j2: Int = off
        while (j2 < total && pq < pc) {
            if (!aotContains(filled, "," + toStr(j2) + ",")) {
                slots = slots + toStr(j2) + "|" + aotFieldAt(posQueue, pq, ",") + "\n"
                pq = pq + 1
            }
            j2 = j2 + 1
        }
        // 3) 按形参位升序输出
        var out: String = ""
        var j3: Int = off
        while (j3 < total) {
            val fid3: String = this.slotId(slots, j3)
            if (fid3 != "") {
                if (out != "") {
                    out = out + ","
                }
                out = out + fid3
            }
            j3 = j3 + 1
        }
        if (out == "") {
            return posQueue
        }
        return out
    }

    /// 取 `slot|id` 行列表中槽位 `j` 对应的实参 id（未占位返回 ""）。
    fun slotId(slots: String, j: Int): String {
        val parts: List<String> = slots.split("\n")
        var i: Int = 0
        while (i < parts.size) {
            if (aotFieldAt(parts[i], 0, "|") == toStr(j)) {
                return aotFieldAt(parts[i], 1, "|")
            }
            i = i + 1
        }
        return ""
    }

    /// 发射 `for (x in list)` 语句。
    ///
    /// HIR kids = [HirValDecl(循环变量), 可迭代对象, HirBlock(循环体)]。
    /// 集合以 `i8*` 句柄表示，遍历走 `aura_lang_std_Collections_count` /
    /// `getAt`（与 Rust AOT 后端同一约定）。
    fun emitFor(hir: Hir, id: Int) {
        val kids: String = hir.kidsOf(id)
        if (hirKidsCount(kids) < 3) {
            // 形态不完整：至少把循环体发射出来，避免整段丢失
            if (hirKidsCount(kids) >= 1) {
                this.emitBody(hir, hirKidsAt(kids, hirKidsCount(kids) - 1))
            }
            return
        }
        val declId: Int = hirKidsAt(kids, 0)
        val iterId: Int = hirKidsAt(kids, 1)
        val bodyId: Int = hirKidsAt(kids, 2)
        val varName: String = hir.textOf(declId)
        val list: String = this.emitExpr(hir, iterId)

        if (this.fTerminated) {
            this.fBody.sbAdd(this.freshBb("for.pre"))
            this.fBody.sbAdd(":\n")
        }
        // 循环变量的元素类型：集合已登记元素类型时用它（Int 列表 → i32，需拆箱）
        var elemTy: String = "i8*"
        if (hir.kindOf(iterId) == "HirVar") {
            val iterName: String = hir.textOf(iterId)
            if (this.isListVar(iterName)) {
                elemTy = this.listElemTy(iterName)
            }
        } else if (this.isRangeIterable(hir, iterId)) {
            // `for (i in 1..5)`：区间列表元素是装箱整数，须按 i32 拆箱
            // （否则循环变量是原始装箱句柄，`println(i)` 会把奇地址当字符串
            // 交给 printf("%s") 而崩溃）。
            elemTy = "i32"
        }
        val idxAddr: String = this.declareVar("__foridx_" + toStr(id), "i32")
        this.fBody.sbAdd("  store i32 0, i32* ")
        this.fBody.sbAdd(idxAddr)
        this.fBody.sbAdd("\n")
        val varAddr: String = this.declareVar(varName, elemTy)
        this.fBody.sbAdd("  store ")
        this.fBody.sbAdd(elemTy)
        this.fBody.sbAdd(" ")
        this.fBody.sbAdd(EmitUtils.defaultValue(elemTy))
        this.fBody.sbAdd(", ")
        this.fBody.sbAdd(EmitUtils.toPtrTySp(elemTy))
        this.fBody.sbAdd(varAddr)
        this.fBody.sbAdd("\n")

        val condBb: String = this.freshBb("for.cond")
        val bodyBb: String = this.freshBb("for.body")
        val incrBb: String = this.freshBb("for.incr")
        val endBb: String = this.freshBb("for.end")
        this.fBody.sbAdd("  br label %")
        this.fBody.sbAdd(condBb)
        this.fBody.sbAdd("\n")

        // 条件块：idx < count(list)
        this.fBody.sbAdd(condBb)
        this.fBody.sbAdd(":\n")
        val idx: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(idx)
        this.fBody.sbAdd(" = load i32, i32* ")
        this.fBody.sbAdd(idxAddr)
        this.fBody.sbAdd("\n")
        val list64: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(list64)
        this.fBody.sbAdd(" = ptrtoint i8* ")
        this.fBody.sbAdd(list)
        this.fBody.sbAdd(" to i64\n")
        val cnt64: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(cnt64)
        this.fBody.sbAdd(" = call i64 @Collections_count(%struct.Collections* @aura_obj_Collections, i64 ")
        this.fBody.sbAdd(list64)
        this.fBody.sbAdd(")\n")
        val cnt32: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(cnt32)
        this.fBody.sbAdd(" = trunc i64 ")
        this.fBody.sbAdd(cnt64)
        this.fBody.sbAdd(" to i32\n")
        val cmp: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(cmp)
        this.fBody.sbAdd(" = icmp slt i32 ")
        this.fBody.sbAdd(idx)
        this.fBody.sbAdd(", ")
        this.fBody.sbAdd(cnt32)
        this.fBody.sbAdd("\n")
        this.fBody.sbAdd("  br i1 ")
        this.fBody.sbAdd(cmp)
        this.fBody.sbAdd(", label %")
        this.fBody.sbAdd(bodyBb)
        this.fBody.sbAdd(", label %")
        this.fBody.sbAdd(endBb)
        this.fBody.sbAdd("\n")

        // 循环体块：取出元素 → store 到循环变量 → 执行体
        this.fBody.sbAdd(bodyBb)
        this.fBody.sbAdd(":\n")
        val idx64: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(idx64)
        this.fBody.sbAdd(" = sext i32 ")
        this.fBody.sbAdd(idx)
        this.fBody.sbAdd(" to i64\n")
        val list64b: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(list64b)
        this.fBody.sbAdd(" = ptrtoint i8* ")
        this.fBody.sbAdd(list)
        this.fBody.sbAdd(" to i64\n")
        val elem: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(elem)
        this.fBody.sbAdd(" = call i64 @Collections_getAt(%struct.Collections* @aura_obj_Collections, i64 ")
        this.fBody.sbAdd(list64b)
        this.fBody.sbAdd(", i64 ")
        this.fBody.sbAdd(idx64)
        this.fBody.sbAdd(")\n")
        val elemPtr: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(elemPtr)
        this.fBody.sbAdd(" = inttoptr i64 ")
        this.fBody.sbAdd(elem)
        this.fBody.sbAdd(" to i8*\n")
        val elemCo: String = this.coerceValue(elemPtr, "i8*", elemTy)
        this.fBody.sbAdd("  store ")
        this.fBody.sbAdd(elemTy)
        this.fBody.sbAdd(" ")
        this.fBody.sbAdd(elemCo)
        this.fBody.sbAdd(", ")
        this.fBody.sbAdd(EmitUtils.toPtrTySp(elemTy))
        this.fBody.sbAdd(varAddr)
        this.fBody.sbAdd("\n")
        this.fTerminated = false
        // 循环上下文：break → end，continue → incr（自增块，避免跳过自增）
        val savedEnd: String = this.loopEnd
        val savedCond: String = this.loopCond
        this.loopEnd = endBb
        this.loopCond = incrBb
        this.emitBody(hir, bodyId)
        this.loopEnd = savedEnd
        this.loopCond = savedCond
        if (!this.fTerminated) {
            this.fBody.sbAdd("  br label %")
            this.fBody.sbAdd(incrBb)
            this.fBody.sbAdd("\n")
        }

        // 自增块：idx++ 后回到条件块（continue 也落到这里）
        this.fBody.sbAdd(incrBb)
        this.fBody.sbAdd(":\n")
        this.fTerminated = false
        val idx2: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(idx2)
        this.fBody.sbAdd(" = load i32, i32* ")
        this.fBody.sbAdd(idxAddr)
        this.fBody.sbAdd("\n")
        val idx3: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(idx3)
        this.fBody.sbAdd(" = add i32 ")
        this.fBody.sbAdd(idx2)
        this.fBody.sbAdd(", 1\n")
        this.fBody.sbAdd("  store i32 ")
        this.fBody.sbAdd(idx3)
        this.fBody.sbAdd(", i32* ")
        this.fBody.sbAdd(idxAddr)
        this.fBody.sbAdd("\n")
        this.fBody.sbAdd("  br label %")
        this.fBody.sbAdd(condBb)
        this.fBody.sbAdd("\n")

        // 结束块
        this.fBody.sbAdd(endBb)
        this.fBody.sbAdd(":\n")
        this.fTerminated = false
    }

    /// 发射 val/var 声明。
    fun emitDecl(hir: Hir, id: Int) {
        val name: String = hir.textOf(id)
        if (name == "") {
            return
        }
        val kids: String = hir.kidsOf(id)
        var initVal: String = "0"
        var initTy: String = "i32"
        var hasInit: Boolean = false
        if (hirKidsCount(kids) > 0) {
            hasInit = true
            val initId: Int = hirKidsAt(kids, 0)
            initTy = this.inferType(hir, initId)
            initVal = this.emitExpr(hir, initId)
            // `val f = <lambda>`：登记闭包签名（调用点 `f(...)` 据此发射间接调用）。
            // 注意必须在 emitExpr 之后：lambda 的发射会把子上下文状态换回外层。
            if (hir.kindOf(initId) == "HirLambda") {
                this.registerClosureVar(name, this.closureSigOf(hir, initId))
            } else if (hir.kindOf(initId) == "HirCall") {
                // `val add5 = makeAdder(5)`：初始化器是「返回函数类型」的调用，
                // 结果仍是闭包 env 指针，调用点 `add5(10)` 必须走间接调用。
                // 不看 `initTy`：Lambda 返回值在 LLVM 侧也是 `i8*`（与 String 同形），
                // 必须查 **Aura** 返回类型才知道是不是函数。
                val cs: String = this.callFnSig(hir, initId)
                if (cs != "") {
                    this.registerClosureVar(name, cs)
                }
            }
        }
        var llvmTy: String = this.mapTy(hir.tyOf(id))
        if (llvmTy == "") {
            llvmTy = initTy
        }
        if (llvmTy == "") {
            llvmTy = "i32"
        }
        // 定长数组：只 `alloca [N x T]`，不做整体初始化
        // （`store [N x T] 0` 不是合法 IR；元素由源码 `a[i] = v` 逐个写入）
        if (llvmTy.startsWith("[")) {
            this.declareVar(name, llvmTy)
            this.fTerminated = false
            return
        }
        // 初始化表达式类型与声明类型不一致时插入转换（如 i32 → i64）；
        // 无初始化器时用**声明类型**的零值（结构体 → zeroinitializer、指针 → null），
        // 否则会把 i32 的 `0` 直接 store 进结构体类型 → 非法 IR。
        var coerced: String = ""
        if (hasInit) {
            coerced = this.coerceValue(initVal, initTy, llvmTy)
            // 聚合类型（结构体/数组）不能用整数字面量初始化：
            // `store { i8, i8, i8, i8 } 0, …` 是非法 IR
            // （llc: integer/byte constant must have integer/byte type）。
            // 初始化表达式求值为整数（如枚举变体/成员访问）时退回零值。
            if (coerced == "0" && (llvmTy.startsWith("{ ")
                || llvmTy.startsWith("%struct.") || llvmTy.startsWith("["))) {
                coerced = EmitUtils.defaultValue(llvmTy)
            }
        } else {
            coerced = EmitUtils.defaultValue(llvmTy)
        }
        val addr: String = this.declareVar(name, llvmTy)
        this.fBody.sbAdd("  store ")
        this.fBody.sbAdd(llvmTy)
        this.fBody.sbAdd(" ")
        this.fBody.sbAdd(coerced)
        this.fBody.sbAdd(", ")
        this.fBody.sbAdd(EmitUtils.toPtrTySp(llvmTy))
        this.fBody.sbAdd(addr)
        this.fBody.sbAdd("\n")
        this.fTerminated = false
        // 登记集合类型局部变量：`.size` / `.add` / `for-in` / 下标需按集合语义处理，
        // 并记录元素类型（决定 `list[i]` 读回后是否拆箱）
        if (initTy == "i8*" && hirKidsCount(kids) > 0
            && this.isCollectionCtorCall(hir, hirKidsAt(kids, 0))) {
            this.markListVarTyped(name, this.collectionElemTy(hir, hirKidsAt(kids, 0)))
        } else if (EmitUtils.isCollectionTypeName(this.resolveAlias(hir.tyOf(id)))) {
            this.markListVarTyped(name, this.typeArgElemTy(hir.tyOf(id)))
        }
    }

    /// 集合构造调用的元素 LLVM 类型（取首个实参类型；无实参默认 `i32`）。
    fun collectionElemTy(hir: Hir, callId: Int): String {
        val kids: String = hir.kidsOf(callId)
        if (hirKidsCount(kids) > 0) {
            val e: String = this.inferType(hir, hirKidsAt(kids, 0))
            if (e != "") {
                return e
            }
        }
        return "i32"
    }

    /// 从声明类型 `List<T>` / `Map<K,V>` 中提取元素 T 的 LLVM 类型（默认 `i32`）。
    fun typeArgElemTy(ty: String): String {
        val lt: Int = EmitUtils.aotIndexOfSub(ty, "<")
        if (lt < 0) {
            return "i32"
        }
        val rest: String = aotSlice(ty, lt + 1, ty.length - lt - 1)
        val gt: Int = EmitUtils.aotIndexOfSub(rest, ">")
        if (gt < 0) {
            return "i32"
        }
        val inner: String = aotSlice(rest, 0, gt)
        // Map<K,V>：取 V（值类型）
        val comma: Int = EmitUtils.aotIndexOfSub(inner, ",")
        var elem: String = inner
        if (comma >= 0) {
            elem = aotSlice(inner, comma + 1, inner.length - comma - 1)
        }
        val m: String = this.mapTy(trimSpaces(elem))
        if (m == "" || m == "void") {
            return "i32"
        }
        return m
    }

    /// 发射赋值语句。
    fun emitAssign(hir: Hir, id: Int) {
        val kids: String = hir.kidsOf(id)
        if (hirKidsCount(kids) < 2) {
            return
        }
        val targetId: Int = hirKidsAt(kids, 0)
        val valueId: Int = hirKidsAt(kids, 1)
        // 定长数组元素写入：HIR 把 `a[i] = v` 降级为 `a = Collections.set(a, i, v)`
        // （接收者 kids[0]、下标 kids[1]、值 kids[2]）。展开为 gep + store；
        // 否则会把 `[N x T]` 当标量整体 store，生成非法 IR。
        if (hir.kindOf(valueId) == "HirCall" && hir.textOf(valueId) == "Collections.set") {
            val sk: String = hir.kidsOf(valueId)
            if (hirKidsCount(sk) >= 3) {
                val recvId: Int = hirKidsAt(sk, 0)
                if (hir.kindOf(recvId) == "HirVar") {
                    if (this.emitArrayElemStoreVar(hir, hir.textOf(recvId),
                            hirKidsAt(sk, 1), hirKidsAt(sk, 2))) {
                        return
                    }
                }
            }
        }
        // 结构体字段写入：`p.x = v`
        if (hir.kindOf(targetId) == "HirMember") {
            if (this.emitStructFieldStore(hir, targetId, valueId)) {
                return
            }
        }
        // 定长数组元素写入：`a[i] = v`
        if (hir.kindOf(targetId) == "HirIndex") {
            if (this.emitArrayElemStore(hir, targetId, valueId)) {
                return
            }
        }
        if (hir.kindOf(targetId) != "HirVar") {
            return
        }
        val name: String = hir.textOf(targetId)
        if (name == "") {
            return
        }
        // 类方法内：裸字段名 → `this.field = v`（Phase 6.5.1b）
        if (this.lookupVarTy(name) == "" && this.curClassFieldIndex(name) >= 0) {
            this.emitThisFieldStore(hir, name, valueId)
            return
        }
        val valueTy: String = this.inferType(hir, valueId)
        val value: String = this.emitExpr(hir, valueId)
        var ty: String = this.lookupVarTy(name)
        if (ty == "") {
            ty = valueTy
        }
        if (ty == "") {
            ty = "i32"
        }
        val coerced: String = this.coerceValue(value, valueTy, ty)
        val addr: String = this.declareVar(name, ty)
        this.fBody.sbAdd("  store ")
        this.fBody.sbAdd(ty)
        this.fBody.sbAdd(" ")
        this.fBody.sbAdd(coerced)
        this.fBody.sbAdd(", ")
        this.fBody.sbAdd(EmitUtils.toPtrTySp(ty))
        this.fBody.sbAdd(addr)
        this.fBody.sbAdd("\n")
        this.fTerminated = false
    }

    /// 定长数组元素写入：`a[i] = v` → gep + store（非定长数组返回 false）。
    fun emitArrayElemStore(hir: Hir, idxId: Int, valueId: Int): Boolean {
        val kids: String = hir.kidsOf(idxId)
        if (hirKidsCount(kids) < 2) {
            return false
        }
        val cId: Int = hirKidsAt(kids, 0)
        if (hir.kindOf(cId) != "HirVar") {
            return false
        }
        return this.emitArrayElemStoreVar(hir, hir.textOf(cId), hirKidsAt(kids, 1), valueId)
    }

    /// 定长数组元素写入（按变量名）：`a[i] = v` → gep + store；非数组返回 false。
    fun emitArrayElemStoreVar(hir: Hir, cn: String, iId: Int, valueId: Int): Boolean {
        val ct: String = this.lookupVarTy(cn)
        if (!ct.startsWith("[")) {
            return false
        }
        val elemTy: String = EmitUtils.llvmElemOfArrayTy(ct)
        val iTy: String = this.inferType(hir, iId)
        val iv0: String = this.emitExpr(hir, iId)
        val iv: String = this.coerceValue(iv0, iTy, "i64")
        val vTy: String = this.inferType(hir, valueId)
        val v0: String = this.emitExpr(hir, valueId)
        val v: String = this.coerceValue(v0, vTy, elemTy)
        val addr: String = this.fvField(cn, 1)
        val p: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(p)
        this.fBody.sbAdd(" = getelementptr inbounds ")
        this.fBody.sbAdd(ct)
        this.fBody.sbAdd(", ")
        this.fBody.sbAdd(EmitUtils.toPtrTySp(ct))
        this.fBody.sbAdd(addr)
        this.fBody.sbAdd(", i64 0, i64 ")
        this.fBody.sbAdd(iv)
        this.fBody.sbAdd("\n")
        this.fBody.sbAdd("  store ")
        this.fBody.sbAdd(elemTy)
        this.fBody.sbAdd(" ")
        this.fBody.sbAdd(v)
        this.fBody.sbAdd(", ")
        this.fBody.sbAdd(EmitUtils.toPtrTySp(elemTy))
        this.fBody.sbAdd(p)
        this.fBody.sbAdd("\n")
        this.fTerminated = false
        return true
    }

    /// 发射 return 语句（Phase 6.5.2：按函数返回类型转换后再 ret）。
    fun emitReturn(hir: Hir, id: Int) {
        val kids: String = hir.kidsOf(id)
        if (hirKidsCount(kids) > 0) {
            val vId: Int = hirKidsAt(kids, 0)
            val vTy: String = this.inferType(hir, vId)
            val v: String = this.emitExpr(hir, vId)
            if (this.fRetTy == "" || this.fRetTy == "void") {
                this.fBody.sbAdd("  ret void\n")
                this.fTerminated = true
                return
            }
            val coerced: String = this.coerceValue(v, vTy, this.fRetTy)
            this.fBody.sbAdd("  ret ")
            this.fBody.sbAdd(this.fRetTy)
            this.fBody.sbAdd(" ")
            this.fBody.sbAdd(coerced)
            this.fBody.sbAdd("\n")
        } else {
            if (this.fRetTy == "" || this.fRetTy == "void") {
                this.fBody.sbAdd("  ret void\n")
            } else {
                this.fBody.sbAdd("  ret ")
                this.fBody.sbAdd(this.fRetTy)
                this.fBody.sbAdd(" ")
                this.fBody.sbAdd(EmitUtils.defaultValue(this.fRetTy))
                this.fBody.sbAdd("\n")
            }
        }
        this.fTerminated = true
    }

    /// 发射 if 语句（HirIf kids = [cond, then, else?]）。
    fun emitIf(hir: Hir, id: Int) {
        val kids: String = hir.kidsOf(id)
        val n: Int = hirKidsCount(kids)
        if (n < 2) {
            return
        }
        val condId: Int = hirKidsAt(kids, 0)
        val condTy: String = this.inferType(hir, condId)
        val condRaw: String = this.emitExpr(hir, condId)
        val cond: String = this.toI1(condRaw, condTy)
        val thenBb: String = this.freshBb("then")
        val elseBb: String = this.freshBb("else")
        val mergeBb: String = this.freshBb("merge")
        this.fBody.sbAdd("  br i1 ")
        this.fBody.sbAdd(cond)
        this.fBody.sbAdd(", label %")
        this.fBody.sbAdd(thenBb)
        this.fBody.sbAdd(", label %")
        this.fBody.sbAdd(elseBb)
        this.fBody.sbAdd("\n")
        // then 分支
        this.fBody.sbAdd(thenBb)
        this.fBody.sbAdd(":\n")
        this.fTerminated = false
        this.emitBody(hir, hirKidsAt(kids, 1))
        val thenFalls: Boolean = !this.fTerminated
        if (thenFalls) {
            this.fBody.sbAdd("  br label %")
            this.fBody.sbAdd(mergeBb)
            this.fBody.sbAdd("\n")
        }
        // else 分支
        this.fBody.sbAdd(elseBb)
        this.fBody.sbAdd(":\n")
        this.fTerminated = false
        if (n > 2) {
            this.emitBody(hir, hirKidsAt(kids, 2))
        }
        val elseFalls: Boolean = !this.fTerminated
        if (elseFalls) {
            this.fBody.sbAdd("  br label %")
            this.fBody.sbAdd(mergeBb)
            this.fBody.sbAdd("\n")
        }
        // 汇合块：若两个分支都已终结则不可达，发射 unreachable 保持 IR 合法
        this.fBody.sbAdd(mergeBb)
        this.fBody.sbAdd(":\n")
        if (thenFalls || elseFalls) {
            this.fTerminated = false
        } else {
            this.fBody.sbAdd("  unreachable\n")
            this.fTerminated = true
        }
    }

    /// 发射 try/catch/finally（`HirTry` kids = `[body, catchBlock, finallyBlock]`）。
    ///
    /// 使用 setjmp/longjmp 桥实现异常传播：
    ///   1. 分配 jmp_buf
    ///   2. 调用 setjmp，返回 0 = 正常路径，非 0 = 异常路径
    ///   3. 正常路径执行 body，异常路径跳转 catch
    ///   4. throw 调用 longjmp 跳转到最近的 setjmp
    ///   5. finally 块在两条路径汇合后执行
    fun emitTry(hir: Hir, id: Int) {
        val kids: String = hir.kidsOf(id)
        val n: Int = hirKidsCount(kids)
        if (n < 1) {
            return
        }
        val catchVar: String = hir.textOf(id)

        // 分配 jmp_buf。**必须是 16 x i64（128 字节）**：
        // Linux x86_64 的 `jmp_buf` 是 14 个 i64，但 Windows/MSVC x64 的
        // `_JUMP_BUFFER` 是 16 个 i64 —— 旧实现按 14 分配，`setjmp` 会越界写入
        // 16 字节，直接踩坏栈帧（实测：try 块内输出全对，函数返回后访问违例）。
        val jmpBuf: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(jmpBuf)
        this.fBody.sbAdd(" = alloca [64 x i64], align 16\n")

        // Phase D: 调用系统 libc 的 setjmp，前置 jmp_buf 栈入栈操作
        // 1. 把 jmp_buf 指针压入栈（支持嵌套 try/catch）
        val dIdx: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(dIdx)
        this.fBody.sbAdd(" = load i32, i32* @aura_jmp_depth\n")
        val sSlot: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(sSlot)
        this.fBody.sbAdd(" = getelementptr [64 x i8*], [64 x i8*]* @aura_jmp_stack, i32 0, i32 ")
        this.fBody.sbAdd(dIdx)
        this.fBody.sbAdd("\n")
        this.fBody.sbAdd("  store i8* ")
        this.fBody.sbAdd(jmpBuf)
        this.fBody.sbAdd(", i8* ")
        this.fBody.sbAdd(sSlot)
        this.fBody.sbAdd("\n")
        val nDep: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(nDep)
        this.fBody.sbAdd(" = add i32 ")
        this.fBody.sbAdd(dIdx)
        this.fBody.sbAdd(", 1\n")
        this.fBody.sbAdd("  store i32 ")
        this.fBody.sbAdd(nDep)
        this.fBody.sbAdd(", i32* @aura_jmp_depth\n")
        // 2. 调用系统 setjmp（平台特定名称：Windows → @_setjmp）
        val sjSym: String = if (aotContains(this.targetTriple, "windows")) { "_setjmp" } else { "setjmp" }
        val sjResult: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(sjResult)
        this.fBody.sbAdd(" = call i32 @")
        this.fBody.sbAdd(sjSym)
        this.fBody.sbAdd("(i8* ")
        this.fBody.sbAdd(jmpBuf)
        this.fBody.sbAdd(")\n")

        // 判断是否为异常路径
        val sjBool: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(sjBool)
        this.fBody.sbAdd(" = icmp ne i32 ")
        this.fBody.sbAdd(sjResult)
        this.fBody.sbAdd(", 0\n")

        // 创建基本块
        val tryBb: String = this.freshBb("try_body")
        val catchBb: String = this.freshBb("catch_body")
        val mergeBb: String = this.freshBb("finally_merge")

        // 分支
        this.fBody.sbAdd("  br i1 ")
        this.fBody.sbAdd(sjBool)
        this.fBody.sbAdd(", label %")
        this.fBody.sbAdd(catchBb)
        this.fBody.sbAdd(", label %")
        this.fBody.sbAdd(tryBb)
        this.fBody.sbAdd("\n")

        // try 体（正常路径）
        this.fBody.sbAdd(tryBb)
        this.fBody.sbAdd(":\n")
        this.fTerminated = false
        this.emitBody(hir, hirKidsAt(kids, 0))
        if (!this.fTerminated) {
            this.fBody.sbAdd("  br label %")
            this.fBody.sbAdd(mergeBb)
            this.fBody.sbAdd("\n")
        }

        // catch 体（异常路径）
        this.fBody.sbAdd(catchBb)
        this.fBody.sbAdd(":\n")
        this.fTerminated = false

        // 加载异常值到 catch 变量
        if (n >= 2 && catchVar != "") {
            val excVal: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(excVal)
            this.fBody.sbAdd(" = load i8*, i8* @aura_exception_value\n")
            // 注意：declareVar 只接受 (name, llvmTy)；旧代码多传了一个参数，
            // 会被静默忽略并生成 `alloca <垃圾>` 的非法 IR。此处显式 alloca + store。
            val cAddr: String = this.declareVar(catchVar, "i8*")
            this.fBody.sbAdd("  store i8* ")
            this.fBody.sbAdd(excVal)
            this.fBody.sbAdd(", i8** ")
            this.fBody.sbAdd(cAddr)
            this.fBody.sbAdd("\n")
        }

        if (n >= 2) {
            this.emitBody(hir, hirKidsAt(kids, 1))
        }
        if (!this.fTerminated) {
            this.fBody.sbAdd("  br label %")
            this.fBody.sbAdd(mergeBb)
            this.fBody.sbAdd("\n")
        }

        // finally 合并块
        this.fBody.sbAdd(mergeBb)
        this.fBody.sbAdd(":\n")
        this.fTerminated = false
        if (n >= 3) {
            this.emitBody(hir, hirKidsAt(kids, 2))
        }
    }

    /// 发射 while 循环（HirWhile kids = [cond, body]）。
    fun emitWhile(hir: Hir, id: Int) {
        val kids: String = hir.kidsOf(id)
        val n: Int = hirKidsCount(kids)
        if (n < 2) {
            return
        }
        val condBb: String = this.freshBb("loop.cond")
        val bodyBb: String = this.freshBb("loop.body")
        val endBb: String = this.freshBb("loop.end")
        this.fBody.sbAdd("  br label %")
        this.fBody.sbAdd(condBb)
        this.fBody.sbAdd("\n")
        this.fBody.sbAdd(condBb)
        this.fBody.sbAdd(":\n")
        this.fTerminated = false
        val condId: Int = hirKidsAt(kids, 0)
        val condTy: String = this.inferType(hir, condId)
        val condRaw: String = this.emitExpr(hir, condId)
        val cond: String = this.toI1(condRaw, condTy)
        this.fBody.sbAdd("  br i1 ")
        this.fBody.sbAdd(cond)
        this.fBody.sbAdd(", label %")
        this.fBody.sbAdd(bodyBb)
        this.fBody.sbAdd(", label %")
        this.fBody.sbAdd(endBb)
        this.fBody.sbAdd("\n")
        this.fBody.sbAdd(bodyBb)
        this.fBody.sbAdd(":\n")
        this.fTerminated = false
        // 循环上下文：break → end，continue → cond
        val savedEnd: String = this.loopEnd
        val savedCond: String = this.loopCond
        this.loopEnd = endBb
        this.loopCond = condBb
        this.emitBody(hir, hirKidsAt(kids, 1))
        this.loopEnd = savedEnd
        this.loopCond = savedCond
        if (!this.fTerminated) {
            this.fBody.sbAdd("  br label %")
            this.fBody.sbAdd(condBb)
            this.fBody.sbAdd("\n")
        }
        this.fBody.sbAdd(endBb)
        this.fBody.sbAdd(":\n")
        this.fTerminated = false
    }

    // ── 表达式 ──

    /// 发射表达式，返回 LLVM 值操作数字符串。
    fun emitExpr(hir: Hir, id: Int): String {
        if (id < 0 || id >= hir.count) {
            return "0"
        }
        val k: String = hir.kindOf(id)
        if (k == "HirLit") {
            return this.emitLit(hir, id)
        }
        if (k == "HirVar") {
            return this.emitVarLoad(hir.textOf(id))
        }
        if (k == "HirBinary") {
            return this.emitBinary(hir, id)
        }
        if (k == "HirUnary") {
            return this.emitUnary(hir, id)
        }
        if (k == "HirNamedArg") {
            // 命名实参：求值其子表达式（按位置传参）
            val nk: String = hir.kidsOf(id)
            if (hirKidsCount(nk) > 0) {
                return this.emitExpr(hir, hirKidsAt(nk, 0))
            }
            return "0"
        }
        if (k == "HirCall") {
            return this.emitCall(hir, id)
        }
        if (k == "HirLambda") {
            return this.emitLambda(hir, id)
        }
        if (k == "HirMember") {
            return this.emitMember(hir, id)
        }
        if (k == "HirIfExpr") {
            return this.emitIfValue(hir, id)
        }
        if (k == "HirIndex") {
            return this.emitIndex(hir, id)
        }
        // 其余表达式暂降级为 0
        return "0"
    }

    /// 发射下标访问 `xs[i]`（Phase 6.5：集合 → getAt；字符串 → charAt）。
    ///
    /// HIR kids = [容器, 下标]。集合元素以 Plan A `i8*` 返回，调用方在使用处
    /// 按元素类型经 `coerceValue` 拆箱（见 `inferType`/`coerceValue`）。
    fun emitIndex(hir: Hir, id: Int): String {
        val kids: String = hir.kidsOf(id)
        if (hirKidsCount(kids) < 2) {
            return "0"
        }
        val cId: Int = hirKidsAt(kids, 0)
        val iId: Int = hirKidsAt(kids, 1)
        // 定长数组 `[N x T]`：对局部变量取地址做 gep + load。
        // 必须先判定，否则下面会按标量把整个数组 load 出来（生成非法 IR）。
        if (hir.kindOf(cId) == "HirVar") {
            val cn: String = hir.textOf(cId)
            val ct: String = this.lookupVarTy(cn)
            if (ct.startsWith("[")) {
                val iTyA: String = this.inferType(hir, iId)
                val ivA0: String = this.emitExpr(hir, iId)
                val ivA: String = this.coerceValue(ivA0, iTyA, "i64")
                val addr: String = this.fvField(cn, 1)
                val p: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(p)
                this.fBody.sbAdd(" = getelementptr inbounds ")
                this.fBody.sbAdd(ct)
                this.fBody.sbAdd(", ")
                this.fBody.sbAdd(EmitUtils.toPtrTySp(ct))
                this.fBody.sbAdd(addr)
                this.fBody.sbAdd(", i64 0, i64 ")
                this.fBody.sbAdd(ivA)
                this.fBody.sbAdd("\n")
                val elemTy: String = EmitUtils.llvmElemOfArrayTy(ct)
                val t: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(t)
                this.fBody.sbAdd(" = load ")
                this.fBody.sbAdd(elemTy)
                this.fBody.sbAdd(", ")
                this.fBody.sbAdd(EmitUtils.toPtrTySp(elemTy))
                this.fBody.sbAdd(p)
                this.fBody.sbAdd("\n")
                return t
            }
        }
        val c: String = this.emitExpr(hir, cId)
        val iTy: String = this.inferType(hir, iId)
        val iv0: String = this.emitExpr(hir, iId)
        val iv: String = this.coerceValue(iv0, iTy, "i64")
        // 集合：getAt（返回 i64 句柄）→ inttoptr 转 i8* → 按元素类型拆箱
        if (this.isCollectionReceiver(hir, cId)) {
            val elemTy: String = this.receiverElemTy(hir, cId)
            val c64: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(c64)
            this.fBody.sbAdd(" = ptrtoint i8* ")
            this.fBody.sbAdd(c)
            this.fBody.sbAdd(" to i64\n")
            val t64: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(t64)
            this.fBody.sbAdd(" = call i64 @Collections_getAt(%struct.Collections* @aura_obj_Collections, i64 ")
            this.fBody.sbAdd(c64)
            this.fBody.sbAdd(", i64 ")
            this.fBody.sbAdd(iv)
            this.fBody.sbAdd(")\n")
            val t: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(t)
            this.fBody.sbAdd(" = inttoptr i64 ")
            this.fBody.sbAdd(t64)
            this.fBody.sbAdd(" to i8*\n")
            return this.coerceValue(t, "i8*", elemTy)
        }
        // 字符串：charAt（返回单字符字符串 i8*）
        val s: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(s)
        this.fBody.sbAdd(" = call i8* @String_charAt(i8* ")
        this.fBody.sbAdd(this.ptrConst(c))
        this.fBody.sbAdd(", i64 ")
        this.fBody.sbAdd(iv)
        this.fBody.sbAdd(")\n")
        return s
    }

    /// 发射字面量（依 HIR 类型决定表示；字符串统一为 `i8*`）。
    fun emitLit(hir: Hir, id: Int): String {
        val raw: String = hir.textOf(id)
        val ty: String = hir.tyOf(id)
        if (ty == "Boolean") {
            if (raw == "true" || raw == "false") {
                return raw
            }
        }
        if (ty == "String") {
            return this.declareString(raw)
        }
        if (raw == "true" || raw == "false") {
            return raw
        }
        if (raw.startsWith("\"")) {
            return this.declareString(aotSlice(raw, 1, raw.length - 2))
        }
        if (ty == "Char") {
            return toStr(EmitUtils.charCodeOf(raw))
        }
        // 数字字面量规范化：LLVM 只接受十进制整数与带 `.`/指数的浮点字面量。
        // 源码中的 0xFF / 0b1100 / 1_000_000 / 100L / 3.14f 必须转换后写入 IR。
        if (EmitUtils.isNumericLiteral(raw)) {
            if (EmitUtils.isFloatLiteral(raw)) {
                return EmitUtils.normalizeFloatLiteral(raw)
            }
            return EmitUtils.normalizeNumberLiteral(raw)
        }
        return raw
    }

    /// 发射字符串常量全局并返回可用的 `i8*`（getelementptr 到首字节）。
    fun declareString(content: String): String {
        val idx: Int = this.strCount
        this.strCount = idx + 1
        val escaped: String = EmitUtils.llvmEscape(content)
        val n: Int = content.length + 1
        this.stringParts.sbAdd("@str.")
        this.stringParts.sbAdd(toStr(idx))
        this.stringParts.sbAdd(" = private unnamed_addr constant [")
        this.stringParts.sbAdd(toStr(n))
        this.stringParts.sbAdd(" x i8] c\"")
        this.stringParts.sbAdd(escaped)
        // `align 8`：i8 数组默认对齐为 1，短字符串常量可能落在**奇数地址**上；
        // 而 Plan A 用「低位标记」区分装箱整数与真实指针（见 `aura_to_str_any`），
        // 奇数地址的字符串会被误判为整数而打印成十进制数。
        this.stringParts.sbAdd("\\00\", align 8\n")
        val t: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(t)
        this.fBody.sbAdd(" = getelementptr inbounds [")
        this.fBody.sbAdd(toStr(n))
        this.fBody.sbAdd(" x i8], [")
        this.fBody.sbAdd(toStr(n))
        this.fBody.sbAdd(" x i8]* @str.")
        this.fBody.sbAdd(toStr(idx))
        this.fBody.sbAdd(", i64 0, i64 0\n")
        return t
    }

    /// 发射变量读取（load）。
    fun emitVarLoad(name: String): String {
        val ty: String = this.lookupVarTy(name)
        if (ty == "") {
            // 顶层闭包变量（`val f: (Int) -> Int = …`）：无局部声明，走惰性初始化函数
            if (this.globalClosureSigOf(name) != "") {
                val t: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(t)
                this.fBody.sbAdd(" = call i8* @")
                this.fBody.sbAdd(sanitizeLlvm(name))
                this.fBody.sbAdd("__init()\n")
                return t
            }
            // 类方法内：裸字段名 → `this.field`（Phase 6.5.1b）
            if (this.curClassFieldIndex(name) >= 0) {
                return this.emitThisFieldLoad(name)
            }
            return "0"
        }
        val addr: String = this.lookupVarAddr(name)
        val t: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(t)
        this.fBody.sbAdd(" = load ")
        this.fBody.sbAdd(ty)
        this.fBody.sbAdd(", ")
        this.fBody.sbAdd(EmitUtils.toPtrTySp(ty))
        this.fBody.sbAdd(addr)
        this.fBody.sbAdd("\n")
        return t
    }

    /// 发射二元运算（含字符串拼接/比较、整型提升，Phase 6.5.5/6.5.6）。
    fun emitBinary(hir: Hir, id: Int): String {
        val op: String = hir.textOf(id)
        val kids: String = hir.kidsOf(id)
        if (hirKidsCount(kids) < 2) {
            return "0"
        }
        val aid: Int = hirKidsAt(kids, 0)
        val bid: Int = hirKidsAt(kids, 1)
        // 类型转换 `x as T`：解析器把 `as` 当二元运算符，右侧是**类型名**而非值。
        // 运行期表示不变（String/List/Map/Any 均 i8*，Int/Float 标量），
        // 直接转发左操作数；右侧不能求值（否则会产生垃圾指令/非法常量）。
        if (op == "as" || op == "As") {
            return this.emitExpr(hir, aid)
        }
        // 类型检查 `x is T`（表达式位置）：右侧是**类型名**（HirLit），
        // 不能按值求值。发射 `aura_isOfType(x, "T") → i1`。
        if (op == "is" || op == "Is") {
            val xTy: String = this.inferType(hir, aid)
            val xv: String = this.coerceValue(this.emitExpr(hir, aid), xTy, "i8*")
            val tname: String = hir.textOf(bid)
            val tptr: String = this.declareString(tname)
            val iso: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(iso)
            this.fBody.sbAdd(" = call i1 @aura_isOfType(i8* ")
            this.fBody.sbAdd(xv)
            this.fBody.sbAdd(", i8* ")
            this.fBody.sbAdd(tptr)
            this.fBody.sbAdd(")\n")
            return iso
        }
        val aTy: String = this.inferType(hir, aid)
        val bTy: String = this.inferType(hir, bid)
        val a: String = this.emitExpr(hir, aid)
        val b: String = this.emitExpr(hir, bid)

        // Elvis `a ?: b`：可空结构体 `{ T, i1 }` 判空后取内部值或右操作数。
        if (op == "?:") {
            if (EmitUtils.isNullableStructTy(aTy)) {
                val innerTy: String = EmitUtils.nullableInnerTy(aTy)
                val iv: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(iv)
                this.fBody.sbAdd(" = extractvalue ")
                this.fBody.sbAdd(aTy)
                this.fBody.sbAdd(" ")
                this.fBody.sbAdd(a)
                this.fBody.sbAdd(", 0\n")
                val nv: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(nv)
                this.fBody.sbAdd(" = extractvalue ")
                this.fBody.sbAdd(aTy)
                this.fBody.sbAdd(" ")
                this.fBody.sbAdd(a)
                this.fBody.sbAdd(", 1\n")
                val bco: String = this.coerceValue(b, bTy, innerTy)
                val rv: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(rv)
                this.fBody.sbAdd(" = select i1 ")
                this.fBody.sbAdd(nv)
                this.fBody.sbAdd(", ")
                this.fBody.sbAdd(innerTy)
                this.fBody.sbAdd(" ")
                this.fBody.sbAdd(bco)
                this.fBody.sbAdd(", ")
                this.fBody.sbAdd(innerTy)
                this.fBody.sbAdd(" ")
                this.fBody.sbAdd(iv)
                this.fBody.sbAdd("\n")
                return rv
            }
            // 无可空跟踪（如 String? → i8*）：直接取左值
            return a
        }

        // 逻辑运算（i1）：操作数可能来自返回 i32 的谓词调用点，先收敛到 i1
        if (op == "&&" || op == "||") {
            var instr: String = "and"
            if (op == "||") {
                instr = "or"
            }
            val a1: String = this.toI1(a, aTy)
            val b1: String = this.toI1(b, bTy)
            val lt: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(lt)
            this.fBody.sbAdd(" = ")
            this.fBody.sbAdd(instr)
            this.fBody.sbAdd(" i1 ")
            this.fBody.sbAdd(a1)
            this.fBody.sbAdd(", ")
            this.fBody.sbAdd(b1)
            this.fBody.sbAdd("\n")
            return lt
        }

        // 字符串比较 → 内容相等（C 调用点符号）
        if (EmitUtils.isCmpOp(op) && aTy == "i8*" && bTy == "i8*") {
            // 操作数可能是 Plan A 装箱整数（泛型形参 `T`→i8*、集合元素等）：
            // 先经 `aura_to_str_any` 解码为 C 字符串再交给 strcmp，
            // 否则把奇数句柄当指针解引用 → 访问违例。
            val sa: String = this.toStringOperand(a, aTy)
            val sb: String = this.toStringOperand(b, bTy)
            val c: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(c)
            this.fBody.sbAdd(" = call i1 @String_equals(i8* ")
            this.fBody.sbAdd(sa)
            this.fBody.sbAdd(", i8* ")
            this.fBody.sbAdd(sb)
            this.fBody.sbAdd(")\n")
            // Aura String_equals 直接返回 i1（true=相等）
            if (op == "==") {
                return c
            }
            val t: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(t)
            this.fBody.sbAdd(" = xor i1 ")
            this.fBody.sbAdd(c)
            this.fBody.sbAdd(", true\n")
            return t
        }

        // 字符串拼接 → aura_string_concat(a, alen, b, blen)
        // 非字符串一侧（Int / Float / Bool 等）先经 `aura_to_str*` 转换，
        // 否则会把裸数值当指针传给 concat。
        if (op == "+" && (aTy == "i8*" || bTy == "i8*")) {
            // 两侧统一走 `valueToStr`：i8* 侧可能是 Plan A 装箱整数
            // （泛型形参 `T`→i8*、集合元素、`Any` 等），必须先经
            // `aura_to_str_any` 解码成 C 字符串，否则 `aura_strlen` 会对
            // 奇地址句柄解引用而崩溃。真实字符串指针解码后原样返回。
            val aStr: String = this.valueToStr(a, aTy)
            val bStr: String = this.valueToStr(b, bTy)
            val la: String = this.stringLen(aStr)
            val lb: String = this.stringLen(bStr)
            // 内联字符串拼接：malloc(len_a + len_b + 1) + memcpy + null terminator
            val total: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(total)
            this.fBody.sbAdd(" = add i64 ")
            this.fBody.sbAdd(la)
            this.fBody.sbAdd(", ")
            this.fBody.sbAdd(lb)
            this.fBody.sbAdd("\n")
            val alloc: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(alloc)
            this.fBody.sbAdd(" = add i64 ")
            this.fBody.sbAdd(total)
            this.fBody.sbAdd(", 1\n")
            val buf: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(buf)
            this.fBody.sbAdd(" = call i8* @malloc(i64 ")
            this.fBody.sbAdd(alloc)
            this.fBody.sbAdd(")\n")
            this.fBody.sbAdd("  call void @aura_block_copy(i8* align 1 ")
            this.fBody.sbAdd(buf)
            this.fBody.sbAdd(", i8* align 1 ")
            this.fBody.sbAdd(aStr)
            this.fBody.sbAdd(", i64 ")
            this.fBody.sbAdd(la)
            this.fBody.sbAdd(", i1 false)\n")
            val bufOff: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(bufOff)
            this.fBody.sbAdd(" = getelementptr i8, i8* ")
            this.fBody.sbAdd(buf)
            this.fBody.sbAdd(", i64 ")
            this.fBody.sbAdd(la)
            this.fBody.sbAdd("\n")
            this.fBody.sbAdd("  call void @aura_block_copy(i8* align 1 ")
            this.fBody.sbAdd(bufOff)
            this.fBody.sbAdd(", i8* align 1 ")
            this.fBody.sbAdd(bStr)
            this.fBody.sbAdd(", i64 ")
            this.fBody.sbAdd(lb)
            this.fBody.sbAdd(", i1 false)\n")
            val end: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(end)
            this.fBody.sbAdd(" = getelementptr i8, i8* ")
            this.fBody.sbAdd(buf)
            this.fBody.sbAdd(", i64 ")
            this.fBody.sbAdd(total)
            this.fBody.sbAdd("\n")
            this.fBody.sbAdd("  store i8 0, i8* ")
            this.fBody.sbAdd(end)
            this.fBody.sbAdd(", align 1\n")
            return buf
        }

        // 可空结构体 `{ T, i1 }` 的判空比较（`x == null` / `x != null`）。
        // 约定：字段 1（i1）为 true 表示 null。**不能**对整个结构体发 icmp
        // （llc: icmp requires integer operands），必须提取标签位比较。
        if ((op == "==" || op == "!=") && (EmitUtils.isNullableStructTy(aTy) || EmitUtils.isNullableStructTy(bTy))) {
            var structVal: String = a
            var structTy: String = aTy
            if (!EmitUtils.isNullableStructTy(aTy)) {
                structVal = b
                structTy = bTy
            }
            val tag: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(tag)
            this.fBody.sbAdd(" = extractvalue ")
            this.fBody.sbAdd(structTy)
            this.fBody.sbAdd(" ")
            this.fBody.sbAdd(structVal)
            this.fBody.sbAdd(", 1\n")
            var npred: String = "eq"
            if (op == "!=") {
                npred = "ne"
            }
            val nt: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(nt)
            this.fBody.sbAdd(" = icmp ")
            this.fBody.sbAdd(npred)
            this.fBody.sbAdd(" i1 ")
            this.fBody.sbAdd(tag)
            this.fBody.sbAdd(", true\n")
            return nt
        }

        // 比较运算（浮点走 fcmp，整型走 icmp）
        if (EmitUtils.isCmpOp(op)) {
            val common: String = this.commonNumTy(aTy, bTy)
            val a2: String = this.coerceValue(a, aTy, common)
            val b2: String = this.coerceValue(b, bTy, common)
            val t: String = this.freshVar()
            if (common == "float" || common == "double") {
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(t)
                this.fBody.sbAdd(" = fcmp ")
                this.fBody.sbAdd(EmitUtils.fcmpPred(op))
                this.fBody.sbAdd(" ")
                this.fBody.sbAdd(common)
                this.fBody.sbAdd(" ")
                this.fBody.sbAdd(a2)
                this.fBody.sbAdd(", ")
                this.fBody.sbAdd(b2)
                this.fBody.sbAdd("\n")
            } else {
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(t)
                this.fBody.sbAdd(" = icmp ")
                this.fBody.sbAdd(EmitUtils.cmpPred(op))
                this.fBody.sbAdd(" ")
                this.fBody.sbAdd(common)
                this.fBody.sbAdd(" ")
                this.fBody.sbAdd(a2)
                this.fBody.sbAdd(", ")
                this.fBody.sbAdd(b2)
                this.fBody.sbAdd("\n")
            }
            return t
        }

        // 位运算 `&` / `|` / `^`（整型；两侧各自收敛到公共整型宽度）。
        // 缺此分支时 `h & (cap - 1)` 会落到下方算术兜底 → `arithInstr("&", …)`
        // 返回默认 `add`，静默算出加法（HashMap 桶下标、PlanA 拆箱全错）。
        if (op == "&" || op == "|" || op == "^") {
            val bwCommon: String = this.commonNumTy(aTy, bTy)
            if (EmitUtils.intWidth(bwCommon) > 0) {
                val a4: String = this.coerceValue(a, aTy, bwCommon)
                val b4: String = this.coerceValue(b, bTy, bwCommon)
                var instrB: String = "and"
                if (op == "|") {
                    instrB = "or"
                }
                if (op == "^") {
                    instrB = "xor"
                }
                val bt: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(bt)
                this.fBody.sbAdd(" = ")
                this.fBody.sbAdd(instrB)
                this.fBody.sbAdd(" ")
                this.fBody.sbAdd(bwCommon)
                this.fBody.sbAdd(" ")
                this.fBody.sbAdd(a4)
                this.fBody.sbAdd(", ")
                this.fBody.sbAdd(b4)
                this.fBody.sbAdd("\n")
                return bt
            }
            return a
        }

        // 移位运算 `<<` / `>>`（算术右移）/ `>>>`（逻辑右移）
        if (op == "<<" || op == ">>" || op == ">>>") {
            val shCommon: String = this.commonNumTy(aTy, bTy)
            if (EmitUtils.intWidth(shCommon) > 0) {
                val a3: String = this.coerceValue(a, aTy, shCommon)
                val b3: String = this.coerceValue(b, bTy, shCommon)
                var instr: String = "shl"
                if (op == ">>") {
                    instr = "ashr"
                }
                if (op == ">>>") {
                    instr = "lshr"
                }
                val st: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(st)
                this.fBody.sbAdd(" = ")
                this.fBody.sbAdd(instr)
                this.fBody.sbAdd(" ")
                this.fBody.sbAdd(shCommon)
                this.fBody.sbAdd(" ")
                this.fBody.sbAdd(a3)
                this.fBody.sbAdd(", ")
                this.fBody.sbAdd(b3)
                this.fBody.sbAdd("\n")
                return st
            }
            return a
        }

        // 算术运算（整型统一提升，避免 add i32 …, i64 … 非法 IR）
        val common: String = this.commonNumTy(aTy, bTy)
        if (EmitUtils.intWidth(common) <= 0 && common != "float" && common != "double") {
            // 非数值操作数（指针/结构体）：不做算术，返回左操作数兜底
            return a
        }
        val a2: String = this.coerceValue(a, aTy, common)
        val b2: String = this.coerceValue(b, bTy, common)
        val t: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(t)
        this.fBody.sbAdd(" = ")
        this.fBody.sbAdd(EmitUtils.arithInstr(op, common))
        this.fBody.sbAdd(" ")
        this.fBody.sbAdd(common)
        this.fBody.sbAdd(" ")
        this.fBody.sbAdd(a2)
        this.fBody.sbAdd(", ")
        this.fBody.sbAdd(b2)
        this.fBody.sbAdd("\n")
        return t
    }

    /// 发射一元运算。
    fun emitUnary(hir: Hir, id: Int): String {
        val op: String = hir.textOf(id)
        val kids: String = hir.kidsOf(id)
        if (hirKidsCount(kids) < 1) {
            return "0"
        }
        val xId: Int = hirKidsAt(kids, 0)
        val ty: String = this.inferType(hir, xId)
        val x: String = this.emitExpr(hir, xId)
        val t: String = this.freshVar()
        if (op == "!") {
            val x1: String = this.toI1(x, ty)
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(t)
            this.fBody.sbAdd(" = xor i1 ")
            this.fBody.sbAdd(x1)
            this.fBody.sbAdd(", true\n")
            return t
        }
        if (ty == "float" || ty == "double") {
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(t)
            this.fBody.sbAdd(" = fneg ")
            this.fBody.sbAdd(ty)
            this.fBody.sbAdd(" ")
            this.fBody.sbAdd(x)
            this.fBody.sbAdd("\n")
            return t
        }
        if (EmitUtils.intWidth(ty) <= 0) {
            // 指针/结构体：无操作数级负号
            return x
        }
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(t)
        this.fBody.sbAdd(" = sub ")
        this.fBody.sbAdd(ty)
        this.fBody.sbAdd(" 0, ")
        this.fBody.sbAdd(x)
        this.fBody.sbAdd("\n")
        return t
    }

    /// 发射成员访问：结构体字段（`p.x`）或字符串 `.length` / `.size`。
    fun emitMember(hir: Hir, id: Int): String {
        val member: String = hir.textOf(id)
        val kids: String = hir.kidsOf(id)
        if (hirKidsCount(kids) < 1) {
            return "0"
        }
        val recvId: Int = hirKidsAt(kids, 0)
        val recvTy: String = this.inferType(hir, recvId)
        val sym: String = this.structSymOfPtr(recvTy)
        // 属性（Kotlin 风格 getter）**优先于同名字段**：
        // `val size: Int get() = _size` 会被 `registerStruct` 当作字段登记进
        // 字段表（它按 `HirValDecl`/`HirVarDecl` 收集），直接按字段读会读到
        // 未初始化/错位的槽位（实测 `HashMap.size` 恒得 0）。存在 `getX()`
        // 方法时说明它是属性，应调用 getter。
        var hasPropGetter: Boolean = false
        if (sym != "" && (member == "size" || member == "length")) {
            if (this.funcSignatureOf(sym + "_getSize") != "") {
                hasPropGetter = true
            }
        }
        if (!hasPropGetter && sym != "" && this.structFieldIndex(sym, member) >= 0) {
            return this.emitStructFieldLoad(hir, recvId, sym, member)
        }
        // 属性读取：`x.size` → `Class.getSize()`（Kotlin 风格 getter）。
        //
        // `HashMap.size` 是 `val size: Int get() = _size`（**没有同名字段**）。
        // 旧实现直接落到下面的「size → 集合元素个数 / 字符串长度」兜底：
        // 对类实例会读成垃圾字段（实测 `HashMap.size` 得 0、`m["k"]` 类调用被
        // 当成集合下标）。存在 `getX()` 方法时必须优先调用它。
        // 注意：先查签名（不求值），命中才 `emitExpr` —— 保证接收者只求值一次。
        if (sym != "") {
            var getter: String = ""
            if (member == "size" || member == "length") {
                getter = "getSize"
            }
            if (getter != "") {
                val gsig: String = this.funcSignatureOf(sym + "_" + getter)
                if (gsig != "") {
                    val rt: String = aotFieldAt(gsig, 1, "|")
                    val grecv: String = this.emitExpr(hir, recvId)
                    if (rt == "" || rt == "void") {
                        this.fBody.sbAdd("  call void @")
                        this.fBody.sbAdd(sanitizeLlvm(sym + "_" + getter))
                        this.fBody.sbAdd("(%struct.")
                        this.fBody.sbAdd(sym)
                        this.fBody.sbAdd("* ")
                        this.fBody.sbAdd(grecv)
                        this.fBody.sbAdd(")\n")
                        return "0"
                    }
                    val gt: String = this.freshVar()
                    this.fBody.sbAdd("  ")
                    this.fBody.sbAdd(gt)
                    this.fBody.sbAdd(" = call ")
                    this.fBody.sbAdd(rt)
                    this.fBody.sbAdd(" @")
                    this.fBody.sbAdd(sanitizeLlvm(sym + "_" + getter))
                    this.fBody.sbAdd("(%struct.")
                    this.fBody.sbAdd(sym)
                    this.fBody.sbAdd("* ")
                    this.fBody.sbAdd(grecv)
                    this.fBody.sbAdd(")\n")
                    return gt
                }
            }
        }
        val recv: String = this.emitExpr(hir, recvId)
        if (member == "length" || member == "size") {
            // 集合：元素个数（Aura Collections.count，i64 类型）；
            // 字符串：字节长度（`aura_strlen`）。二者内部表示都是 `i8*`，
            // 只能靠接收者的**声明类型**区分（含字段接收者，见
            // `isCollectionReceiver`）。
            if (this.isCollectionReceiver(hir, recvId)) {
                val recv64: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(recv64)
                this.fBody.sbAdd(" = ptrtoint i8* ")
                this.fBody.sbAdd(recv)
                this.fBody.sbAdd(" to i64\n")
                val c: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(c)
                this.fBody.sbAdd(" = call i64 @Collections_count(%struct.Collections* @aura_obj_Collections, i64 ")
                this.fBody.sbAdd(recv64)
                this.fBody.sbAdd(")\n")
                val ct: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(ct)
                this.fBody.sbAdd(" = trunc i64 ")
                this.fBody.sbAdd(c)
                this.fBody.sbAdd(" to i32\n")
                return ct
            }
            val n: String = this.stringLen(recv)
            val t: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(t)
            this.fBody.sbAdd(" = trunc i64 ")
            this.fBody.sbAdd(n)
            this.fBody.sbAdd(" to i32\n")
            return t
        }
        return "0"
    }

    /// 结构体字段读取：`p.x` → gep + load。
    fun emitStructFieldLoad(hir: Hir, recvId: Int, sym: String, field: String): String {
        val index: Int = this.structFieldIndex(sym, field)
        if (index < 0) {
            return "0"
        }
        val fty: String = aotFieldAt(this.structFieldLineAt(sym, index), 2, "|")
        val recv: String = this.emitExpr(hir, recvId)
        val fp: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(fp)
        this.fBody.sbAdd(" = getelementptr inbounds %struct.")
        this.fBody.sbAdd(sym)
        this.fBody.sbAdd(", %struct.")
        this.fBody.sbAdd(sym)
        this.fBody.sbAdd("* ")
        this.fBody.sbAdd(recv)
        this.fBody.sbAdd(", i32 0, i32 ")
        // 字段序号 +1（index 0 = vptr）
        this.fBody.sbAdd(toStr(index + 1))
        this.fBody.sbAdd("\n")
        val t: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(t)
        this.fBody.sbAdd(" = load ")
        this.fBody.sbAdd(fty)
        this.fBody.sbAdd(", ")
        this.fBody.sbAdd(EmitUtils.toPtrTySp(fty))
        this.fBody.sbAdd(fp)
        this.fBody.sbAdd("\n")
        return t
    }

    /// 结构体字段写入：`p.x = v` → gep + store。
    fun emitStructFieldStore(hir: Hir, targetId: Int, valueId: Int): Boolean {
        val member: String = hir.textOf(targetId)
        val mk: String = hir.kidsOf(targetId)
        if (hirKidsCount(mk) < 1) {
            return false
        }
        val recvId: Int = hirKidsAt(mk, 0)
        val recvTy: String = this.inferType(hir, recvId)
        val sym: String = this.structSymOfPtr(recvTy)
        if (sym == "") {
            return false
        }
        val index: Int = this.structFieldIndex(sym, member)
        if (index < 0) {
            return false
        }
        val fty: String = aotFieldAt(this.structFieldLineAt(sym, index), 2, "|")
        val vTy: String = this.inferType(hir, valueId)
        val v: String = this.emitExpr(hir, valueId)
        val coerced: String = this.coerceValue(v, vTy, fty)
        val recv: String = this.emitExpr(hir, recvId)
        val fp: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(fp)
        this.fBody.sbAdd(" = getelementptr inbounds %struct.")
        this.fBody.sbAdd(sym)
        this.fBody.sbAdd(", %struct.")
        this.fBody.sbAdd(sym)
        this.fBody.sbAdd("* ")
        this.fBody.sbAdd(recv)
        this.fBody.sbAdd(", i32 0, i32 ")
        // 字段序号 +1（index 0 = vptr）
        this.fBody.sbAdd(toStr(index + 1))
        this.fBody.sbAdd("\n")
        this.fBody.sbAdd("  store ")
        this.fBody.sbAdd(fty)
        this.fBody.sbAdd(" ")
        this.fBody.sbAdd(coerced)
        this.fBody.sbAdd(", ")
        this.fBody.sbAdd(EmitUtils.toPtrTySp(fty))
        this.fBody.sbAdd(fp)
        this.fBody.sbAdd("\n")
        this.fTerminated = false
        return true
    }

    // ── 类字段（Phase 6.5.1b：方法内裸字段名 → `this.field`）──

    /// 当前方法所属类（sanitize 后），非方法返回 ""。
    fun curClassSym(): String {
        if (this.fCurClass == "") {
            return ""
        }
        return sanitizeLlvm(this.fCurClass)
    }

    /// 当前类字段序号（非字段返回 -1）。
    fun curClassFieldIndex(field: String): Int {
        val cs: String = this.curClassSym()
        if (cs == "") {
            return -1
        }
        return this.structFieldIndex(cs, field)
    }

    /// 当前类字段 LLVM 类型（非字段返回 ""）。
    fun curClassFieldTy(field: String): String {
        val cs: String = this.curClassSym()
        val fi: Int = this.curClassFieldIndex(field)
        if (fi < 0) {
            return ""
        }
        return aotFieldAt(this.structFieldLineAt(cs, fi), 2, "|")
    }

    /// 类方法内读取裸字段名：`n` → `this.n`（gep + load）。
    fun emitThisFieldLoad(field: String): String {
        val cs: String = this.curClassSym()
        val fi: Int = this.curClassFieldIndex(field)
        if (fi < 0) {
            return "0"
        }
        val fty: String = aotFieldAt(this.structFieldLineAt(cs, fi), 2, "|")
        val th: String = this.emitVarLoad("this")
        val fp: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(fp)
        this.fBody.sbAdd(" = getelementptr inbounds %struct.")
        this.fBody.sbAdd(cs)
        this.fBody.sbAdd(", %struct.")
        this.fBody.sbAdd(cs)
        this.fBody.sbAdd("* ")
        this.fBody.sbAdd(th)
        this.fBody.sbAdd(", i32 0, i32 ")
        // 字段序号 +1（index 0 = vptr）
        this.fBody.sbAdd(toStr(fi + 1))
        this.fBody.sbAdd("\n")
        val t: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(t)
        this.fBody.sbAdd(" = load ")
        this.fBody.sbAdd(fty)
        this.fBody.sbAdd(", ")
        this.fBody.sbAdd(EmitUtils.toPtrTySp(fty))
        this.fBody.sbAdd(fp)
        this.fBody.sbAdd("\n")
        return t
    }

    /// 类方法内写入裸字段名：`n = v` → `this.n = v`（gep + store）。
    fun emitThisFieldStore(hir: Hir, field: String, valueId: Int): Boolean {
        val cs: String = this.curClassSym()
        val fi: Int = this.curClassFieldIndex(field)
        if (fi < 0) {
            return false
        }
        val fty: String = aotFieldAt(this.structFieldLineAt(cs, fi), 2, "|")
        val vTy: String = this.inferType(hir, valueId)
        val v: String = this.emitExpr(hir, valueId)
        val coerced: String = this.coerceValue(v, vTy, fty)
        val th: String = this.emitVarLoad("this")
        val fp: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(fp)
        this.fBody.sbAdd(" = getelementptr inbounds %struct.")
        this.fBody.sbAdd(cs)
        this.fBody.sbAdd(", %struct.")
        this.fBody.sbAdd(cs)
        this.fBody.sbAdd("* ")
        this.fBody.sbAdd(th)
        this.fBody.sbAdd(", i32 0, i32 ")
        // 字段序号 +1（index 0 = vptr）
        this.fBody.sbAdd(toStr(fi + 1))
        this.fBody.sbAdd("\n")
        this.fBody.sbAdd("  store ")
        this.fBody.sbAdd(fty)
        this.fBody.sbAdd(" ")
        this.fBody.sbAdd(coerced)
        this.fBody.sbAdd(", ")
        this.fBody.sbAdd(EmitUtils.toPtrTySp(fty))
        this.fBody.sbAdd(fp)
        this.fBody.sbAdd("\n")
        this.fTerminated = false
        return true
    }

    /// 发射字符串长度调用（返回 i64 操作数）。
    fun stringLen(s: String): String {
        val t: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(t)
        this.fBody.sbAdd(" = call i64 @strlen(i8* ")
        // 常量 `0` 在指针位置必须写 `null`（llc：integer/byte constant must
        // have integer/byte type）
        this.fBody.sbAdd(if (s == "0") { "null" } else { s })
        this.fBody.sbAdd(")\n")
        return t
    }

    /// 指针位置的常量归一：未解析/空值表达式求值为字面量 `0`，在指针操作数
    /// 位置必须写成 `null`，否则 llc 报
    /// `integer/byte constant must have integer/byte type`。
    fun ptrConst(v: String): String {
        if (v == "0") {
            return "null"
        }
        return v
    }

    /// 发射函数调用。
    /// `kids[0]` 是否是**值接收者**（局部变量 / 参数 / `this` / 字段），
    /// 而不是类名（单例静态调用的占位）。
    ///
    /// 用途：区分两类调用，二者的接收者处理**相反**：
    ///   * `all.split(sep)` / `s.length` —— 接收者是**值**；Aura 侧编译出的
    ///     `String_split(i8* self, i8* sep)` 形参表含 self，必须把接收者作为
    ///     第 1 个实参传入；
    ///   * `Math.sin(x)` / `String.fromCharCode(c)` —— 接收者是**类名**，无值，
    ///     接收者位传 `null` 占位。
    ///
    /// 旧实现一律按后者处理（`effArgStart = 1` + `staticSelfTy = "%struct.X*"`），
    /// 于是 `all.split("\n")` 被发射成
    /// `%r = call i8* @String_split(%struct.String* null, i8* %sep)`
    /// —— 接收者丢失、`String_split` 解引用 null → 段错误（0xC0000005）。
    fun recvKidIsValue(hir: Hir, kids: String, n: Int): Boolean {
        if (n < 1) {
            return false
        }
        val r0: Int = hirKidsAt(kids, 0)
        if (hir.kindOf(r0) != "HirVar") {
            // 接收者是复杂表达式（如 `a.b().c(...)`）→ 按值处理
            return true
        }
        val rn: String = hir.textOf(r0)
        if (rn == "this") {
            return true
        }
        if (this.lookupVarTy(rn) != "") {
            return true
        }
        if (this.fCurClass != "" && this.curClassFieldTy(rn) != "") {
            return true
        }
        // 兜底：名字不是类/object 符号 → 视为值接收者。
        // （局部变量类型表未登记时，`lookupVarTy`/`curClassFieldTy` 都会落空，
        //  若一律按「类名静态调用」处理就会重新引入接收者丢失的问题。）
        if (!this.isStructSym(sanitizeLlvm(rn))) {
            return true
        }
        return false
    }

    fun emitCall(hir: Hir, id: Int): String {
        val kids: String = hir.kidsOf(id)
        val n: Int = hirKidsCount(kids)
        var fname: String = hir.textOf(id)
        var argStart: Int = 0
        if (fname == "") {
            if (n == 0) {
                return "0"
            }
            // 尾随 lambda / async 块：callee 是 Lambda 节点（无名字），
            // 直接发射 lambda + 间接调用。不处理会退化为 "0"
            // （`async { … }` / `nums.filter { … }` 的返回值守恒为 0）。
            if (hir.kindOf(hirKidsAt(kids, 0)) == "HirLambda") {
                val lamId: Int = hirKidsAt(kids, 0)
                val env: String = this.emitLambda(hir, lamId)
                // 构造闭包签名（从 lambda 参数推导）
                val sig: String = this.closureSigOf(hir, lamId)
                if (sig == "") {
                    return env
                }
                // 将 env 存入临时变量并注册闭包签名，供 emitIndirectCall 加载
                val tmpVar: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(tmpVar)
                this.fBody.sbAdd(" = alloca i8*\n")
                this.fBody.sbAdd("  store i8* ")
                this.fBody.sbAdd(env)
                this.fBody.sbAdd(", i8* ")
                this.fBody.sbAdd(tmpVar)
                this.fBody.sbAdd("\n")
                val tmpName: String = "__iife_" + toStr(this.lambdaCount)
                this.registerClosureVar(tmpName, sig)
                this.fVarList.add(tmpName + "|" + tmpVar + "|i8*")
                this.fVarNames.add(tmpName)
                return this.emitIndirectCall(hir, kids, n, 1, tmpName, sig)
            }
            fname = hir.textOf(hirKidsAt(kids, 0))
            argStart = 1
        }
        if (fname == "") {
            return "0"
        }
        // 集合构造：`arrayListOf<T>()` / `listOf()` / `mutableListOf()` …
        // （泛型实参已在解析器消费，HIR 中不出现类型参数）→ 空列表句柄 + 逐个追加。
        // Phase B: 已切换到 Aura Collections 实现（i64/Long 类型）。
        if (this.isCollectionCtor(fname)) {
            val empty: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(empty)
            this.fBody.sbAdd(" = call i64 @Collections_emptyList(%struct.Collections* @aura_obj_Collections)\n")
            var cur: String = empty
            var ci: Int = argStart
            while (ci < n) {
                val cId: Int = hirKidsAt(kids, ci)
                val cTy: String = this.inferType(hir, cId)
                val cv: String = this.emitExpr(hir, cId)
                val boxed0: String = this.boxToPtr(cv, cTy)
                // boxToPtr 返回 i8*；Aura 函数签名收 i64(Long)，需 ptrtoint 转换
                val boxed64: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(boxed64)
                this.fBody.sbAdd(" = ptrtoint i8* ")
                this.fBody.sbAdd(boxed0)
                this.fBody.sbAdd(" to i64\n")
                val nxt: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(nxt)
                this.fBody.sbAdd(" = call i64 @Collections_listAppend(%struct.Collections* @aura_obj_Collections, i64 ")
                this.fBody.sbAdd(cur)
                this.fBody.sbAdd(", i64 ")
                this.fBody.sbAdd(boxed64)
                this.fBody.sbAdd(")\n")
                cur = nxt
                ci = ci + 1
            }
            // Aura 返回 i64；调用点期望 i8* 句柄，inttoptr 转换
            val curPtr: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(curPtr)
            this.fBody.sbAdd(" = inttoptr i64 ")
            this.fBody.sbAdd(cur)
            this.fBody.sbAdd(" to i8*\n")
            return curPtr
        }

        // 区间构造 `__range(a, b, inclusive)` → Aura Collections.range
        // （HIR 由 `a..b` / `a..<b` 降级而来；用于 `for (i in 1..5)`）。
        // Phase B: 已切换到 Aura Collections.range（i64 类型）。
        if (fname == "__range") {
            var rs: String = "0"
            var re: String = "0"
            var rinc: String = "0"
            if (argStart < n) {
                val sid: Int = hirKidsAt(kids, argStart)
                rs = this.coerceValue(this.emitExpr(hir, sid), this.inferType(hir, sid), "i64")
            }
            if (argStart + 1 < n) {
                val eid: Int = hirKidsAt(kids, argStart + 1)
                re = this.coerceValue(this.emitExpr(hir, eid), this.inferType(hir, eid), "i64")
            }
            if (argStart + 2 < n) {
                val iid: Int = hirKidsAt(kids, argStart + 2)
                rinc = this.coerceValue(this.emitExpr(hir, iid), this.inferType(hir, iid), "i64")
            }
            val rt64: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(rt64)
            this.fBody.sbAdd(" = call i64 @Collections_range(%struct.Collections* @aura_obj_Collections, i64 ")
            this.fBody.sbAdd(rs)
            this.fBody.sbAdd(", i64 ")
            this.fBody.sbAdd(re)
            this.fBody.sbAdd(", i64 ")
            this.fBody.sbAdd(rinc)
            this.fBody.sbAdd(")\n")
            val rt: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(rt)
            this.fBody.sbAdd(" = inttoptr i64 ")
            this.fBody.sbAdd(rt64)
            this.fBody.sbAdd(" to i8*\n")
            return rt
        }

        // 类型检查 `aura_isOfType(value, "T")` → C 运行库 (i8*, i8*) → i1
        // （由 `when` 的 `is T` 模式 / `x is T` 降级而来）
        if (fname == "aura_isOfType" && n - argStart >= 2) {
            val vId: Int = hirKidsAt(kids, argStart)
            val vTy: String = this.inferType(hir, vId)
            val v: String = this.coerceValue(this.emitExpr(hir, vId), vTy, "i8*")
            val tId: Int = hirKidsAt(kids, argStart + 1)
            val tname: String = hir.textOf(tId)
            val tptr: String = this.declareString(tname)
            val iso: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(iso)
            this.fBody.sbAdd(" = call i1 @aura_isOfType(i8* ")
            this.fBody.sbAdd(v)
            this.fBody.sbAdd(", i8* ")
            this.fBody.sbAdd(tptr)
            this.fBody.sbAdd(")\n")
            return iso
        }

        // 集合方法：`lst.add(x)` → Aura Collections.listAppend（接收者在 kids[0]，返回列表句柄）。
        // Phase B: 已切换到 Aura Collections.listAppend（i64 类型）。
        if (fname == "add" && n >= 2) {
            val rId: Int = hirKidsAt(kids, 0)
            if (this.inferType(hir, rId) == "i8*") {
                var cur0: String = this.emitExpr(hir, rId)
                // 调用点传入 i8*；Aura 函数收 i64，需 ptrtoint 转换
                var cur64: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(cur64)
                this.fBody.sbAdd(" = ptrtoint i8* ")
                this.fBody.sbAdd(cur0)
                this.fBody.sbAdd(" to i64\n")
                var cur: String = cur64
                var ai: Int = 1
                while (ai < n) {
                    val aId: Int = hirKidsAt(kids, ai)
                    val aTy: String = this.inferType(hir, aId)
                    val av: String = this.emitExpr(hir, aId)
                    val boxed0: String = this.boxToPtr(av, aTy)
                    val boxed64: String = this.freshVar()
                    this.fBody.sbAdd("  ")
                    this.fBody.sbAdd(boxed64)
                    this.fBody.sbAdd(" = ptrtoint i8* ")
                    this.fBody.sbAdd(boxed0)
                    this.fBody.sbAdd(" to i64\n")
                    val nxt: String = this.freshVar()
                    this.fBody.sbAdd("  ")
                    this.fBody.sbAdd(nxt)
                    this.fBody.sbAdd(" = call i64 @Collections_listAppend(%struct.Collections* @aura_obj_Collections, i64 ")
                    this.fBody.sbAdd(cur)
                    this.fBody.sbAdd(", i64 ")
                    this.fBody.sbAdd(boxed64)
                    this.fBody.sbAdd(")\n")
                    cur = nxt
                    ai = ai + 1
                }
                // Aura 返回 i64；调用点期望 i8* 句柄，inttoptr 转换
                val curPtr: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(curPtr)
                this.fBody.sbAdd(" = inttoptr i64 ")
                this.fBody.sbAdd(cur)
                this.fBody.sbAdd(" to i8*\n")
                return curPtr
            }
        }

        // 结构体构造：`Point(...)` → alloca + 字段初始化（实例以指针表示）
        val ctorSym: String = sanitizeLlvm(fname)
        if (this.isStructSym(ctorSym)) {
            return this.emitNewStruct(hir, kids, n, argStart, ctorSym)
        }

        // 内置输出：println / print（参数统一转 i8*）
        if (fname == "println" || fname == "print") {
            return this.emitPrint(hir, kids, n, argStart, fname == "println")
        }

        // Phase D: __throw 异常桥 — 存储异常值并 longjmp 到最近的 try 块
        // 已迁移到纯 IR：从 jmp_buf 栈中取出最近一次 setjmp 的跳转缓冲，
        // 调用系统 libc 的 longjmp（@longjmp / @_longjmp）。
        if (fname == "__throw" && n >= 1) {
            val excVal: String = this.emitExpr(hir, hirKidsAt(kids, argStart))
            // 存储异常值到全局变量（0 → null）
            val excStr: String = if (excVal == "0") { "null" } else { excVal }
            this.fBody.sbAdd("  store i8* ")
            this.fBody.sbAdd(excStr)
            this.fBody.sbAdd(", i8* @aura_exception_value\n")
            // 从 jmp_buf 栈中取出最近一次 setjmp 的跳转缓冲
            val d0: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(d0)
            this.fBody.sbAdd(" = load i32, i32* @aura_jmp_depth\n")
            val hTry: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(hTry)
            this.fBody.sbAdd(" = icmp sgt i32 ")
            this.fBody.sbAdd(d0)
            this.fBody.sbAdd(", 0\n")
            this.fBody.sbAdd("  br i1 ")
            this.fBody.sbAdd(hTry)
            this.fBody.sbAdd(", label %")
            val doLj: String = this.freshBb("do_longjmp")
            this.fBody.sbAdd(doLj)
            this.fBody.sbAdd(", label %")
            val noTry: String = this.freshBb("no_try")
            this.fBody.sbAdd(noTry)
            this.fBody.sbAdd("\n")
            // 有活跃 try 块：取出栈顶 jmp_buf 并 longjmp
            this.fBody.sbAdd(doLj)
            this.fBody.sbAdd(":\n")
            val dDec: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(dDec)
            this.fBody.sbAdd(" = sub i32 ")
            this.fBody.sbAdd(d0)
            this.fBody.sbAdd(", 1\n")
            val sl0: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(sl0)
            this.fBody.sbAdd(" = getelementptr [64 x i8*], [64 x i8*]* @aura_jmp_stack, i32 0, i32 ")
            this.fBody.sbAdd(dDec)
            this.fBody.sbAdd("\n")
            val tp0: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(tp0)
            this.fBody.sbAdd(" = load i8*, i8* ")
            this.fBody.sbAdd(sl0)
            this.fBody.sbAdd("\n")
            // Windows(UCRT)：`longjmp` 是导出符号，`_longjmp` **不存在**
            //（`_setjmp` + `longjmp` 才是 UCRT 的正确配对）。
            val ljSym: String = "longjmp"
            this.fBody.sbAdd("  call void @")
            this.fBody.sbAdd(ljSym)
            this.fBody.sbAdd("(i8* ")
            this.fBody.sbAdd(tp0)
            this.fBody.sbAdd(", i32 1)\n")
            this.fBody.sbAdd("  unreachable\n")
            // 无活跃 try 块：退出进程
            this.fBody.sbAdd(noTry)
            this.fBody.sbAdd(":\n")
            this.fBody.sbAdd("  call void @exit(i32 1)\n")
            this.fBody.sbAdd("  unreachable\n")
            this.fTerminated = true
            return "0"
        }

        // toString / toStr：C 侧 `toString` 收的是 **Plan A 装箱值**，裸整数必须走
        // `aura_to_str`（偶数整数若按装箱值解释会被当成指针 → 解引用崩溃）；
        // 浮点走 `aura_to_str_float`；布尔走 `aura_to_str_bool`；字符串原样返回。
        if ((fname == "toString" || fname == "toStr") && n == 1) {
            val fId: Int = hirKidsAt(kids, 0)
            val fTy: String = this.inferType(hir, fId)
            val fv: String = this.emitExpr(hir, fId)
            if (fTy == "i8*") {
                return fv
            }
            if (fTy == "float" || fTy == "double") {
                val dv: String = this.coerceValue(fv, fTy, "double")
                // 内联 _snprintf 替换 aura_to_str_float
                val buf: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(buf)
                this.fBody.sbAdd(" = call i8* @malloc(i64 64)\n")
                this.fBody.sbAdd("  call i32 @snprintf(i8* ")
                this.fBody.sbAdd(buf)
                this.fBody.sbAdd(", i64 64, i8* @fmt_float_g, double ")
                this.fBody.sbAdd(dv)
                this.fBody.sbAdd(")\n")
                return buf
            }
            if (fTy == "i1") {
                val bv: String = this.coerceValue(fv, fTy, "i64")
                val boxed: String = this.boxToPtr(bv, "i64")
                val bt: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(bt)
                this.fBody.sbAdd(" = call i8* @toStr(i8* ")
                this.fBody.sbAdd(boxed)
                this.fBody.sbAdd(")\n")
                return bt
            }
            val iv: String = this.coerceValue(fv, fTy, "i64")
            val boxedInt: String = this.boxToPtr(iv, "i64")
            val it: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(it)
            this.fBody.sbAdd(" = call i8* @toStr(i8* ")
            this.fBody.sbAdd(boxedInt)
            this.fBody.sbAdd(")\n")
            return it
        }

        // toInt / toFloat：数值转换内建。
        //
        // 此前无分支 → 落到「未解析符号」回退，**静默返回 0**
        //（`toInt(Math.sqrt(16.0))` 恒得 0，Phase B.5 的 testStdMathSqrt 因此失败）。
        if (fname == "toInt" && n == 1) {
            val fId: Int = hirKidsAt(kids, 0)
            val fTy: String = this.inferType(hir, fId)
            val fv: String = this.emitExpr(hir, fId)
            if (fTy == "float" || fTy == "double") {
                val t: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(t)
                this.fBody.sbAdd(" = fptosi ")
                this.fBody.sbAdd(fTy)
                this.fBody.sbAdd(" ")
                this.fBody.sbAdd(fv)
                this.fBody.sbAdd(" to i32\n")
                return t
            }
            if (fTy == "i8*") {
                // 字符串 → 整数（Aura String.toInt）
                val t: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(t)
                this.fBody.sbAdd(" = call i32 @String_toInt(i8* ")
                this.fBody.sbAdd(fv)
                this.fBody.sbAdd(")\n")
                return t
            }
            return this.coerceValue(fv, fTy, "i32")
        }
        if (fname == "toFloat" && n == 1) {
            val fId: Int = hirKidsAt(kids, 0)
            val fTy: String = this.inferType(hir, fId)
            val fv: String = this.emitExpr(hir, fId)
            if (fTy == "float" || fTy == "double") {
                return this.coerceValue(fv, fTy, "float")
            }
            if (fTy == "i8*") {
                val t: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(t)
                this.fBody.sbAdd(" = call float @String_toFloat(i8* ")
                this.fBody.sbAdd(fv)
                this.fBody.sbAdd(")\n")
                return t
            }
            val iv: String = this.coerceValue(fv, fTy, "i32")
            val t: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(t)
            this.fBody.sbAdd(" = sitofp i32 ")
            this.fBody.sbAdd(iv)
            this.fBody.sbAdd(" to float\n")
            return t
        }

        // 闭包变量的间接调用：`f(args…)` 中 f 为持有闭包的局部或顶层变量
        // （`val f = x -> …` / 顶层 `val f: (Int) -> Int = x -> …`）。
        // 必须在用户函数解析之前：闭包变量与同名全局函数可能重名，而变量优先。
        if (argStart == 0) {
            val closSig: String = this.closureSigOfAny(fname)
            if (closSig != "" && (this.lookupVarAddr(fname) != "" || this.globalClosureSigOf(fname) != "")) {
                return this.emitIndirectCall(hir, kids, n, argStart, fname, closSig)
            }
        }

        // __callClosure(closure, sig, arg1, arg2, …) — 通过闭包表达式间接调用
        // （Collections.filter/map 用）。sig 格式 "retTy|paramTys"（如 "i64|i64"）。
        if (fname == "__callClosure" && n - argStart >= 2) {
            val cloId: Int = hirKidsAt(kids, argStart)
            val clo: String = this.emitExpr(hir, cloId)
            val sigId: Int = hirKidsAt(kids, argStart + 1)
            val sigStr: String = hir.textOf(sigId)
            val retTy: String = aotFieldAt(sigStr, 0, "|")
            val pTys: String = aotFieldAt(sigStr, 1, "|")
            val cloPtr: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(cloPtr)
            this.fBody.sbAdd(" = inttoptr i64 ")
            this.fBody.sbAdd(clo)
            this.fBody.sbAdd(" to i8*\n")
            val fn: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(fn)
            this.fBody.sbAdd(" = load i8*, i8** ")
            this.fBody.sbAdd(cloPtr)
            this.fBody.sbAdd("\n")
            var args: String = "i8* " + cloPtr
            var ai: Int = 0
            var ci: Int = argStart + 2
            while (ci < n) {
                val aId: Int = hirKidsAt(kids, ci)
                val aTy: String = this.inferType(hir, aId)
                val a: String = this.emitExpr(hir, aId)
                var want: String = aotFieldAt(pTys, ai, ",")
                if (want == "") { want = aTy }
                if (want == "") { want = "i32" }
                args = args + ", " + want + " " + this.coerceValue(a, aTy, want)
                ai = ai + 1
                ci = ci + 1
            }
            if (retTy == "" || retTy == "void") {
                this.fBody.sbAdd("  call void ")
                this.fBody.sbAdd(fn)
                this.fBody.sbAdd("(")
                this.fBody.sbAdd(args)
                this.fBody.sbAdd(")\n")
                return "0"
            }
            val res: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(res)
            this.fBody.sbAdd(" = call ")
            this.fBody.sbAdd(retTy)
            this.fBody.sbAdd(" ")
            this.fBody.sbAdd(fn)
            this.fBody.sbAdd("(")
            this.fBody.sbAdd(args)
            this.fBody.sbAdd(")\n")
            return res
        }

        // 用户函数/方法解析（模块内签名表）
        var userSig: String = ""
        var sym: String = sanitizeLlvm(fname)
        var retTy: String = ""
        var paramsCsv: String = ""
        var effArgStart: Int = argStart
        var prependThis: Boolean = false
        // 动态派发（可重写方法）：接收者值 / 静态接收者类 / vtable 槽位
        var vtObj: String = ""
        var vtCls: String = ""
        var vtSlot: Int = -1

        // 0) `Collections.getAt` / `Collections.set` —— HIR 把
        //    `x.get(i)` / `x.getAt(i)` / `x[i]` / `x[i] = v`
        //    统一降级成这两个**点号名字**（见 `Hir.lowerCall`）。发射器的常规路径
        //    （类方法 `Class.method` 与裸名）都匹配不上这种带前缀的名字，于是
        //    落到「未解析符号」回退被**静默丢弃**：`HashMap.get("k")` 的调用整个
        //    消失（`get` 恒得 0），`Collections.set` 同样丢失（trace 实测）。
        //
        //    这里按**接收者类型**分流：
        //      * 类实例（`%struct.X*`）→ 还原为 `<Cls>_get` / `<Cls>_set` 方法调用
        //        （如 `HashMap_get` / `HashMap_set`）；
        //      * 集合句柄（`i8*`）→ C 运行库 `aura_lang_std_Collections_getAt/set`。
        if (n >= 2 && (fname == "Collections.getAt" || fname == "Collections.set")) {
            var mnameC: String = "get"
            if (fname == "Collections.set") {
                mnameC = "set"
            }
            val rIdC: Int = hirKidsAt(kids, 0)
            val rTyC: String = this.inferType(hir, rIdC)
            val clsC: String = this.structSymOfPtr(rTyC)
            if (clsC != "") {
                // ── 类实例：还回类方法 ──
                val ownerC: String = this.ownerClassInChain(clsC, mnameC, n)
                if (ownerC != "") {
                    val sgC: String = this.funcSignatureOf(ownerC + "_" + mnameC)
                    if (sgC != "") {
                        val rtC: String = aotFieldAt(sgC, 1, "|")
                        val pcC: String = aotFieldAt(sgC, 2, "|")
                        val recvV: String = this.emitExpr(hir, rIdC)
                        val recvT: String = "%struct." + ownerC + "*"
                        var argsC: String = recvT + " " + this.coerceValue(recvV, rTyC, recvT)
                        var aiC: Int = 1
                        while (aiC < n) {
                            val aIdC: Int = hirKidsAt(kids, aiC)
                            val aTyC: String = this.inferType(hir, aIdC)
                            val avC: String = this.emitExpr(hir, aIdC)
                            var wantC: String = aotFieldAt(pcC, aiC, ",")
                            if (wantC == "") {
                                wantC = aTyC
                            }
                            if (wantC == "") {
                                wantC = "i32"
                            }
                            argsC = argsC + ", " + wantC + " "
                                + this.coerceValue(avC, aTyC, wantC)
                            aiC = aiC + 1
                        }
                        val symC: String = sanitizeLlvm(ownerC + "_" + mnameC)
                        if (rtC == "" || rtC == "void") {
                            this.fBody.sbAdd("  call void @")
                            this.fBody.sbAdd(symC)
                            this.fBody.sbAdd("(")
                            this.fBody.sbAdd(argsC)
                            this.fBody.sbAdd(")\n")
                            return "0"
                        }
                        val tC: String = this.freshVar()
                        this.fBody.sbAdd("  ")
                        this.fBody.sbAdd(tC)
                        this.fBody.sbAdd(" = call ")
                        this.fBody.sbAdd(rtC)
                        this.fBody.sbAdd(" @")
                        this.fBody.sbAdd(symC)
                        this.fBody.sbAdd("(")
                        this.fBody.sbAdd(argsC)
                        this.fBody.sbAdd(")\n")
                        return tC
                    }
                }
            } else {
                // ── 集合句柄：Aura Collections.getAt / set（i64 类型）──
                val rvC: String = this.emitExpr(hir, rIdC)
                val rsC: String = this.coerceValue(rvC, rTyC, "i8*")
                val rs64C: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(rs64C)
                this.fBody.sbAdd(" = ptrtoint i8* ")
                this.fBody.sbAdd(rsC)
                this.fBody.sbAdd(" to i64\n")
                val iIdC: Int = hirKidsAt(kids, 1)
                val iTyC: String = this.inferType(hir, iIdC)
                val ivC: String = this.emitExpr(hir, iIdC)
                val isC: String = this.coerceValue(ivC, iTyC, "i64")
                if (mnameC == "get") {
                    val tg64C: String = this.freshVar()
                    this.fBody.sbAdd("  ")
                    this.fBody.sbAdd(tg64C)
                    this.fBody.sbAdd(" = call i64 @Collections_getAt(%struct.Collections* @aura_obj_Collections, i64 ")
                    this.fBody.sbAdd(rs64C)
                    this.fBody.sbAdd(", i64 ")
                    this.fBody.sbAdd(isC)
                    this.fBody.sbAdd(")\n")
                    val tgC: String = this.freshVar()
                    this.fBody.sbAdd("  ")
                    this.fBody.sbAdd(tgC)
                    this.fBody.sbAdd(" = inttoptr i64 ")
                    this.fBody.sbAdd(tg64C)
                    this.fBody.sbAdd(" to i8*\n")
                    // 按元素类型拆箱，与 `emitIndex`（HirIndex 路径）保持一致：
                    // `List<Int>` 的元素是装箱指针，直接返回会让调用点把指针当整数。
                    return this.coerceValue(tgC, "i8*", this.receiverElemTy(hir, rIdC))
                }
                if (n >= 3) {
                    val vIdC: Int = hirKidsAt(kids, 2)
                    val vTyC: String = this.inferType(hir, vIdC)
                    val vvC: String = this.emitExpr(hir, vIdC)
                    val vbC: String = this.boxToPtr(vvC, vTyC)
                    val vb64C: String = this.freshVar()
                    this.fBody.sbAdd("  ")
                    this.fBody.sbAdd(vb64C)
                    this.fBody.sbAdd(" = ptrtoint i8* ")
                    this.fBody.sbAdd(vbC)
                    this.fBody.sbAdd(" to i64\n")
                    val ts64C: String = this.freshVar()
                    this.fBody.sbAdd("  ")
                    this.fBody.sbAdd(ts64C)
                    this.fBody.sbAdd(" = call i64 @Collections_set(%struct.Collections* @aura_obj_Collections, i64 ")
                    this.fBody.sbAdd(rs64C)
                    this.fBody.sbAdd(", i64 ")
                    this.fBody.sbAdd(isC)
                    this.fBody.sbAdd(", i64 ")
                    this.fBody.sbAdd(vb64C)
                    this.fBody.sbAdd(")\n")
                    val tsC: String = this.freshVar()
                    this.fBody.sbAdd("  ")
                    this.fBody.sbAdd(tsC)
                    this.fBody.sbAdd(" = inttoptr i64 ")
                    this.fBody.sbAdd(ts64C)
                    this.fBody.sbAdd(" to i8*\n")
                    return tsC
                }
            }
        }

        // 0.4) `String.fromCharCode(code)` → 单字符 C 字符串（Plan A：字符串 = `i8*`）。
        //
        // Aura 侧实现是 `code.toChar().toString()`（`String.aura::fromCharCode`），
        // 而发射器没有 `toChar()` / `Char.toString()` 的处理 → 落到「未解析符号」
        // 回退返回 0 → 拼进字符串时被 `aura_to_str(0)` 变成 **"0"**。
        // 后果（native2 崩溃根因之一）：`Stdio.bufferToString` 逐字节
        // `result + String.fromCharCode(c)` 把**任意文件读成一串 "0"** ——
        // 长度对、内容全错（实测 `FileSystem.readText` 得到 21 个 `'0'`）。
        // 这里直接内联构造：malloc 2 字节 + 存字符 + NUL。
        if (aotLastSegment(fname) == "fromCharCode") {
            var cArgIdx: Int = 0
            if (n >= 2) {
                cArgIdx = 1
            }
            if (n >= 1) {
                val cIdF: Int = hirKidsAt(kids, cArgIdx)
                val cTyF: String = this.inferType(hir, cIdF)
                val cvF0: String = this.emitExpr(hir, cIdF)
                val cvF: String = this.coerceValue(cvF0, cTyF, "i32")
                val c8F: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(c8F)
                this.fBody.sbAdd(" = trunc i32 ")
                this.fBody.sbAdd(cvF)
                this.fBody.sbAdd(" to i8\n")
                val bF: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(bF)
                this.fBody.sbAdd(" = call i8* @malloc(i64 2)\n")
                val p0F: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(p0F)
                this.fBody.sbAdd(" = getelementptr inbounds i8, i8* ")
                this.fBody.sbAdd(bF)
                this.fBody.sbAdd(", i64 0\n")
                this.fBody.sbAdd("  store i8 ")
                this.fBody.sbAdd(c8F)
                this.fBody.sbAdd(", i8* ")
                this.fBody.sbAdd(p0F)
                this.fBody.sbAdd("\n")
                val p1F: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(p1F)
                this.fBody.sbAdd(" = getelementptr inbounds i8, i8* ")
                this.fBody.sbAdd(bF)
                this.fBody.sbAdd(", i64 1\n")
                this.fBody.sbAdd("  store i8 0, i8* ")
                this.fBody.sbAdd(p1F)
                this.fBody.sbAdd("\n")
                return bF
            }
        }

        // 0.45) `String.countChar(sub)` → Aura String.countCharStr(s, sub)。
        //
        // Aura 侧 `countChar(char: Char)` 接收单字符，而调用点普遍传**字符串**
        // （`text.countChar("\n")`）。Phase B: 新增 `countCharStr(sub: String)`
        // 包装函数，签名与调用点匹配。
        if (aotLastSegment(fname) == "countChar" && n >= 2) {
            val scId: Int = hirKidsAt(kids, 0)
            val scTy: String = this.inferType(hir, scId)
            val scV0: String = this.emitExpr(hir, scId)
            val scV: String = this.coerceValue(scV0, scTy, "i8*")
            val chId: Int = hirKidsAt(kids, 1)
            val chTy: String = this.inferType(hir, chId)
            val chV0: String = this.emitExpr(hir, chId)
            val chV: String = this.coerceValue(chV0, chTy, "i8*")
            val r64C: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(r64C)
            this.fBody.sbAdd(" = call i32 @String_countCharStr(i8* ")
            this.fBody.sbAdd(scV)
            this.fBody.sbAdd(", i8* ")
            this.fBody.sbAdd(chV)
            this.fBody.sbAdd(")\n")
            return r64C
        }

        // 0.5) `x.length()` / `x.size()` —— **方法调用形式**，与属性形式等价。
        //
        // Aura 允许把 `length`/`size` 写成调用（`source.length()`，见
        // `Lexer.init`：`this.n = source.length()`）。发射器此前只处理了
        // **成员（属性）形式** `x.length`（见 `emitMember`），调用形式落到
        // 「未解析符号」回退 → **静默返回 0**。后果极其隐蔽且致命：
        //   `this.n = 0` → 词法器 `pos >= n` 立刻成立 → 只产出 `EOF`
        //   → `parseProgram` 立刻结束 → AST 只有 1 个节点 → 后续整条链路错乱
        //（Stage-4 的 native2 崩溃的直接根因）。
        if ((fname == "length" || fname == "size") && n == 1) {
            val rIdL: Int = hirKidsAt(kids, 0)
            val rTyL: String = this.inferType(hir, rIdL)
            val rV0L: String = this.emitExpr(hir, rIdL)
            if (this.isCollectionReceiver(hir, rIdL)) {
                val rVcL: String = this.coerceValue(rV0L, rTyL, "i8*")
                val rV64L: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(rV64L)
                this.fBody.sbAdd(" = ptrtoint i8* ")
                this.fBody.sbAdd(rVcL)
                this.fBody.sbAdd(" to i64\n")
                val cL: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(cL)
                this.fBody.sbAdd(" = call i64 @Collections_count(%struct.Collections* @aura_obj_Collections, i64 ")
                this.fBody.sbAdd(rV64L)
                this.fBody.sbAdd(")\n")
                val ctL: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(ctL)
                this.fBody.sbAdd(" = trunc i64 ")
                this.fBody.sbAdd(cL)
                this.fBody.sbAdd(" to i32\n")
                return ctL
            }
            val rVsL: String = this.coerceValue(rV0L, rTyL, "i8*")
            val nL: String = this.stringLen(rVsL)
            val tL: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(tL)
            this.fBody.sbAdd(" = trunc i64 ")
            this.fBody.sbAdd(nL)
            this.fBody.sbAdd(" to i32\n")
            return tL
        }

        // 1) 类方法**优先**：接收者是类实例指针 → `Class.method`（Phase 6.5.1b）。
        //    必须先于裸名匹配：源码里 `this.isX(v)` 与顶层自由函数 `isX(v)` 同名
        //    很常见（如 `MirOptimizer.isFloatLiteral` 与 `isFloatLiteral`），
        //    若先命中自由函数就会少传一个形参——实参缺类型、生成非法 IR。
        //    形参数与实参数需一致，避免把「自由函数 + 结构体实参」误判成方法。
        if (n >= 1) {
            val recvTy: String = this.inferType(hir, hirKidsAt(kids, 0))
            val recvSym: String = this.structSymOfPtr(recvTy)
            if (recvSym != "") {
                // 沿继承链查找（`d.describe()` 中 describe 定义在父类 Animal）
                val owner1: String = this.ownerClassInChain(recvSym, fname, n)
                if (owner1 != "") {
                    if (fname == "init") {
                        val msInit1: String = this.funcSignatureArity(owner1 + "_init", n - 1)
                        if (msInit1 != "") {
                            userSig = msInit1
                            sym = sanitizeLlvm(owner1 + "_" + fname) + toStr(n)
                        } else {
                            userSig = this.funcSignatureOf(owner1 + "_" + fname)
                            sym = sanitizeLlvm(owner1 + "_" + fname)
                        }
                    } else {
                        userSig = this.funcSignatureOf(owner1 + "_" + fname)
                        sym = sanitizeLlvm(owner1 + "_" + fname)
                    }
                    // 可重写方法 → 记录动态派发信息（接收者此时求值一次）
                    val vts1: Int = this.slotOf(fname)
                    if (vts1 >= 0) {
                        vtSlot = vts1
                        vtCls = recvSym
                        vtObj = this.emitExpr(hir, hirKidsAt(kids, 0))
                    }
                }
            }
        }
        // 2) 类静态方法：`ClassName.method(...)`
        //    HIR 把类名降级为 kids[0] 的 `HirVar`（如 `CompilerInfo.name()` →
        //    `HirCall("name", [HirVar("CompilerInfo"), …])`）。类名不是局部变量，
        //    故用 `isStructSym` 判定；解析到 `Class.method` 后接收者位传 `null`
        //    （这类方法通常不用 `this`）。
        var staticSelfTy: String = ""
        if (userSig == "" && n >= 1) {
            val rId0: Int = hirKidsAt(kids, 0)
            if (hir.kindOf(rId0) == "HirVar") {
                val rn0: String = hir.textOf(rId0)
                val cs0: String = sanitizeLlvm(rn0)
                // Phase B: 移除 isStdClassName 检查——std 类（Math/String/…）
                // 作为 Aura 编译产物参与解析，不再走 C 运行库符号。
                if (this.lookupVarTy(rn0) == "" && this.isStructSym(cs0)) {
                    val ms0: String = this.funcSignatureOf(cs0 + "_" + fname)
                    if (ms0 != "") {
                        userSig = ms0
                        sym = sanitizeLlvm(cs0 + "." + fname)
                        // 方法（含 object 单例方法）都有隐式 self：接收者位传 null，
                        // 并跳过 kids[0] 的类名占位（effArgStart = 1）。
                        staticSelfTy = "%struct." + cs0 + "*"
                        effArgStart = 1
                    }
                }
            }
        }
        // 3) 类体内裸方法名（隐式 this）→ 补 this 为第 0 个实参；
        //    `super.m(...)` → 从**父类**起沿继承链解析，并跳过 `super` 占位实参。
        //    旧实现按 `fCurClass` 解析，`super.name()` 命中自身 → 无限递归 → 栈溢出。
        if (userSig == "" && this.fCurClass != "") {
            var csym: String = sanitizeLlvm(this.fCurClass)
            var argc3: Int = n + 1
            var superRecv: Boolean = false
            if (n >= 1) {
                val r0: Int = hirKidsAt(kids, 0)
                if (hir.kindOf(r0) == "HirVar" && hir.textOf(r0) == "super") {
                    superRecv = true
                    csym = this.parentOfClass(csym)
                    argc3 = n
                }
            }
            val owner3: String = this.ownerClassInChain(csym, fname, argc3)
            if (owner3 != "") {
                // 构造函数重载：`init` 带数字后缀（如 `Runtime_init2`），
                // 用 funcSignatureArity 按实参数消歧，并拼出正确的带后缀符号名。
                if (fname == "init") {
                    val msInit: String = this.funcSignatureArity(owner3 + "_init", argc3 - 1)
                    if (msInit != "") {
                        userSig = msInit
                        // 后缀 = 含 self 的形参数（与 emitNewStruct 一致）
                        sym = sanitizeLlvm(owner3 + "_" + fname) + toStr(argc3)
                        prependThis = true
                        if (superRecv) {
                            effArgStart = 1
                        }
                    } else {
                        userSig = this.funcSignatureOf(owner3 + "_" + fname)
                        sym = sanitizeLlvm(owner3 + "_" + fname)
                        prependThis = true
                        if (superRecv) {
                            effArgStart = 1
                        }
                    }
                } else {
                    userSig = this.funcSignatureOf(owner3 + "_" + fname)
                    sym = sanitizeLlvm(owner3 + "_" + fname)
                    prependThis = true
                    if (superRecv) {
                        effArgStart = 1
                    }
                }
                // `this.m()` 且 m 可重写 → 动态派发（`super.m()` 必须保持静态）
                if (!superRecv) {
                    val vts3: Int = this.slotOf(fname)
                    if (vts3 >= 0) {
                        vtSlot = vts3
                        vtCls = sanitizeLlvm(this.fCurClass)
                        vtObj = this.emitVarLoad("this")
                    }
                }
            }
        }
        // 2.7) `String.charCodeAt(i)` → **内联访存**：
        //      `gep i8, i8* <s>, i64 <i>` + `load i8` + `zext ... to i64`。
        //
        // 此前映射到 C 侧 `aura_lang_std_String_charAt`（C 签名返回 `const char*`，
        // 声明 `declare i8* @aura_lang_std_String_charAt(i8*, i64)`）—— 拿到的却是
        // **指针**，Aura 侧按「字符码」使用，于是写入缓冲区的全是指针低位字节：
        // `Stdio.stringToBuffer` 产出的路径/内容全错（`FileSystem.exists` 对存在的
        // 文件返回 false、`readText` 长度恒 0）。
        // Aura 侧 String 的值表示就是 `i8*`（C 字符串），内联访存最稳、无 ABI 歧义。
        if (fname == "charCodeAt" && n >= 2) {
            val rcId: Int = hirKidsAt(kids, 0)
            val rcTy: String = this.inferType(hir, rcId)
            val rcV: String = this.emitExpr(hir, rcId)
            val rsV: String = this.coerceValue(rcV, rcTy, "i8*")
            val icId: Int = hirKidsAt(kids, 1)
            val icTy: String = this.inferType(hir, icId)
            val icV: String = this.emitExpr(hir, icId)
            val iiV: String = this.coerceValue(icV, icTy, "i64")
            val rpV: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(rpV)
            this.fBody.sbAdd(" = getelementptr inbounds i8, i8* ")
            this.fBody.sbAdd(rsV)
            this.fBody.sbAdd(", i64 ")
            this.fBody.sbAdd(iiV)
            this.fBody.sbAdd("\n")
            val rlV: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(rlV)
            this.fBody.sbAdd(" = load i8, i8* ")
            this.fBody.sbAdd(rpV)
            this.fBody.sbAdd("\n")
            val rzV: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(rzV)
            this.fBody.sbAdd(" = zext i8 ")
            this.fBody.sbAdd(rlV)
            this.fBody.sbAdd(" to i64\n")
            return rzV
        }

        // 2.8) `Memory.*` 内置访存：`Memory.read64(addr)` → `load`；
        //      `Memory.write(addr, v)` → `store`。
        //      **必须置于「外部对象 / 裸名兜底」之前**：裸名 `write` 与
        //      `FileOps.write`（`@native(SYS_WRITE)` 包装器）**撞名**，会被解析成
        //      文件写系统调用 —— `Stdio.stringToBuffer` 里的 `Memory.write(buf, 0)`
        //      （写 NUL 终止符）因此变成 `@write(0, buf, 0)`，缓冲区内容全错
        //      （`FileSystem.exists` 从而对存在的文件返回 false）。
        if (fname == "read" || fname == "read16" || fname == "read32" || fname == "read64"
            || fname == "write" || fname == "write16" || fname == "write32"
            || fname == "write64") {
            if (n >= 2) {
                val rIdM: Int = hirKidsAt(kids, 0)
                val rnM: String = hir.textOf(rIdM)
                // 接收者必须是 `Memory` 对象名（而非同名局部变量）
                if (rnM == "Memory" && this.lookupVarTy("Memory") == "") {
                    var ety: String = "i8"
                    if (fname == "read16" || fname == "write16") {
                        ety = "i16"
                    }
                    if (fname == "read32" || fname == "write32") {
                        ety = "i32"
                    }
                    if (fname == "read64" || fname == "write64") {
                        ety = "i64"
                    }
                    val aId: Int = hirKidsAt(kids, 1)
                    val aTy: String = this.inferType(hir, aId)
                    val av: String = this.emitExpr(hir, aId)
                    val ai64: String = this.coerceValue(av, aTy, "i64")
                    val pM: String = this.freshVar()
                    this.fBody.sbAdd("  ")
                    this.fBody.sbAdd(pM)
                    this.fBody.sbAdd(" = inttoptr i64 ")
                    this.fBody.sbAdd(ai64)
                    this.fBody.sbAdd(" to ")
                    this.fBody.sbAdd(ety)
                    this.fBody.sbAdd("*\n")
                    if (aotContains(fname, "read")) {
                        val tM: String = this.freshVar()
                        this.fBody.sbAdd("  ")
                        this.fBody.sbAdd(tM)
                        this.fBody.sbAdd(" = load ")
                        this.fBody.sbAdd(ety)
                        this.fBody.sbAdd(", ")
                        this.fBody.sbAdd(ety)
                        this.fBody.sbAdd("* ")
                        this.fBody.sbAdd(pM)
                        this.fBody.sbAdd("\n")
                        // 返回**声明宽度**（i8/i16/i32/i64），与 `inferType` 的
                        // `Memory.*` 分支严格一致；两侧不一致会报
                        // `'%var.N' defined with type 'i8' but expected 'i64'`
                        //（或反之 i64 vs i32）。
                        return tM
                    }
                    if (n >= 3) {
                        val vIdM: Int = hirKidsAt(kids, 2)
                        val vTyM: String = this.inferType(hir, vIdM)
                        val vvM: String = this.emitExpr(hir, vIdM)
                        // 注意：`coerceValue` 会把转换指令**追加到当前函数体**，
                        // 必须先求值再拼接，否则转换指令文本会被插进 `store` 行
                        //（llc: `expected ',' after store operand`）。
                        val vvC: String = this.coerceValue(vvM, vTyM, ety)
                        this.fBody.sbAdd("  store ")
                        this.fBody.sbAdd(ety)
                        this.fBody.sbAdd(" ")
                        this.fBody.sbAdd(vvC)
                        this.fBody.sbAdd(", ")
                        this.fBody.sbAdd(ety)
                        this.fBody.sbAdd("* ")
                        this.fBody.sbAdd(pM)
                        this.fBody.sbAdd("\n")
                    }
                    return "0"
                }
            }
        }

        // 2.8) `Process.run(cmd)` / `ProcessNative.run(cmd)` → 平台命令执行。
        //
        // 必须内置：Aura 侧的 `run` 用 `fork`/`execve` 组合（POSIX），Windows 的
        // AOT 发射器对未映射的 syscall 一律「返回 0」，而 `spawn` 会把 0 当作
        // **子进程**分支并调用 `exitGroup(1)` —— 整个编译器进程静默退出
        //（自举链因此完全无法调用 llc/clang）。
        // Windows 直接调 UCRT `system`（内部 `cmd /C`），返回命令退出码。
        if (fname == "run" && n >= 2) {
            val rIdR: Int = hirKidsAt(kids, 0)
            val rnR: String = hir.textOf(rIdR)
            if ((rnR == "Process" || rnR == "ProcessNative")
                && this.lookupVarTy(rnR) == "") {
                val cIdR: Int = hirKidsAt(kids, 1)
                val cTyR: String = this.inferType(hir, cIdR)
                val cvR: String = this.coerceValue(this.emitExpr(hir, cIdR), cTyR, "i8*")
                val tR: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(tR)
                this.fBody.sbAdd(" = call i32 @system(i8* ")
                this.fBody.sbAdd(cvR)
                this.fBody.sbAdd(")\n")
                return tR
            }
        }

        // 2.85) `Memory.alloc(n)` / `Memory.free(addr)` / `Memory.copy(d,s,n)`
        //       编译器内置（`extern object Memory` 的 `native fun`）：
        //         alloc → libc `malloc`（i8* → ptrtoint 为 i64）
        //         free  → libc `free`
        //         copy  → `aura_block_copy`
        //
        //       缺此分支时：`alloc` 落到「未解析」回退**静默返回 0**（所有分配
        //       都是空指针 → `Stdio.stringToBuffer` 恒失败 → `FileSystem.exists`
        //       对存在的文件返回 false）；`free` 则会被误解析到**同名的外层类
        //       方法**（`Allocator.free`），生成 `call @Allocator_free` 自递归
        //       → 栈溢出（0xC00000FD）。
        if ((fname == "alloc" || fname == "free" || fname == "copy") && n >= 2) {
            val rIdA: Int = hirKidsAt(kids, 0)
            if (hir.textOf(rIdA) == "Memory" && this.lookupVarTy("Memory") == "") {
                if (fname == "alloc") {
                    val aIdA: Int = hirKidsAt(kids, 1)
                    val aTyA: String = this.inferType(hir, aIdA)
                    val avA: String = this.coerceValue(this.emitExpr(hir, aIdA), aTyA, "i64")
                    val pA: String = this.freshVar()
                    this.fBody.sbAdd("  ")
                    this.fBody.sbAdd(pA)
                    this.fBody.sbAdd(" = call i8* @malloc(i64 ")
                    this.fBody.sbAdd(avA)
                    this.fBody.sbAdd(")\n")
                    val rA: String = this.freshVar()
                    this.fBody.sbAdd("  ")
                    this.fBody.sbAdd(rA)
                    this.fBody.sbAdd(" = ptrtoint i8* ")
                    this.fBody.sbAdd(pA)
                    this.fBody.sbAdd(" to i64\n")
                    return rA
                }
                if (fname == "free") {
                    val aIdA: Int = hirKidsAt(kids, 1)
                    val aTyA: String = this.inferType(hir, aIdA)
                    val avA: String = this.coerceValue(this.emitExpr(hir, aIdA), aTyA, "i64")
                    this.fBody.sbAdd("  call void @free(i64 ")
                    this.fBody.sbAdd(avA)
                    this.fBody.sbAdd(")\n")
                    return "0"
                }
                // copy(dst, src, n)
                if (n >= 4) {
                    val dIdA: Int = hirKidsAt(kids, 1)
                    val dV: String = this.coerceValue(this.emitExpr(hir, dIdA),
                        this.inferType(hir, dIdA), "i64")
                    val sIdA: Int = hirKidsAt(kids, 2)
                    val sV: String = this.coerceValue(this.emitExpr(hir, sIdA),
                        this.inferType(hir, sIdA), "i64")
                    val nIdA: Int = hirKidsAt(kids, 3)
                    val nV: String = this.coerceValue(this.emitExpr(hir, nIdA),
                        this.inferType(hir, nIdA), "i64")
                    val dp: String = this.freshVar()
                    this.fBody.sbAdd("  ")
                    this.fBody.sbAdd(dp)
                    this.fBody.sbAdd(" = inttoptr i64 ")
                    this.fBody.sbAdd(dV)
                    this.fBody.sbAdd(" to i8*\n")
                    val sp: String = this.freshVar()
                    this.fBody.sbAdd("  ")
                    this.fBody.sbAdd(sp)
                    this.fBody.sbAdd(" = inttoptr i64 ")
                    this.fBody.sbAdd(sV)
                    this.fBody.sbAdd(" to i8*\n")
                    this.fBody.sbAdd("  call void @aura_block_copy(i8* align 1 ")
                    this.fBody.sbAdd(dp)
                    this.fBody.sbAdd(", i8* align 1 ")
                    this.fBody.sbAdd(sp)
                    this.fBody.sbAdd(", i64 ")
                    this.fBody.sbAdd(nV)
                    this.fBody.sbAdd(", i1 false)\n")
                    return "0"
                }
            }
        }

        // 2.9) **外部对象成员调用**：`FileOps.open(path, flags)` / `Console.writeStdout(…)`
        //      这类调用的符号是**裸成员名**（C ABI，形参表不含 self），
        //      因此必须**跳过 kids[0] 的对象名**（对象名不是实参！）。
        //      旧实现落到「裸名兜底」后把 kids[0] 也当实参：对象名被求值成 `0`
        //      占住第 1 个实参位，实参整体后移一格 —— CRT `_open(path, flags)`
        //      收到 `(0, path, flags)`，其无效参数处理直接 fail-fast
        //      （0xC0000409 / STATUS_STACK_BUFFER_OVERRUN）。
        if (userSig == "" && staticSelfTy == "" && n >= 1) {
            val rIdE: Int = hirKidsAt(kids, 0)
            val kE: String = hir.kindOf(rIdE)
            if (kE == "HirVar" || kE == "HirIdent") {
                if (aotListContains(this.fExternObjNames, sanitizeLlvm(hir.textOf(rIdE)))) {
                    effArgStart = 1
                }
            }
        }
        // 2.9) **std 类成员调用优先于裸名自由函数**：`aura.fs.exists(p)` / `Math.sin(x)`
        //      这类调用的接收者是包/类名前缀，必须按 `<Cls>_<fname>` 解析。
        //
        //      为什么必须放在这里：裸名自由函数查找会命中**同名但不同 owner** 的
        //      签名——例如外部对象 `FileOps.exists(path: Long)` 的签名在表里是
        //      `exists|i1|i64`（裸名），于是 `aura.fs.exists(p)` 被解析成裸符号
        //      `@exists(i64 …, i8* …)`：符号未定义（llc 报 `use of undefined value
        //      '@exists'`）、实参也多一个。测试 `13-stdlib.aura` 即此。
        if (userSig == "" && staticSelfTy == "") {
            val stdClsE: String = this.stdClassReceiver(hir, kids, n, 0)
            if (stdClsE != "") {
                // 方法名取**最后一段**：HIR 会把 `s.contains(x)` 这类调用降级成
                // 带前缀的 `Collections.contains`（列表语义），直接用 `fname`
                // 会拼出 `String_Collections_contains` 这种不存在的符号。
                val msegE: String = aotLastSegment(fname)
                val auraNameE: String = sanitizeLlvm(stdClsE) + "_" + sanitizeLlvm(msegE)
                val auraSigE: String = this.funcSignatureOf(auraNameE)
                if (auraSigE != "") {
                    sym = auraNameE
                    retTy = aotFieldAt(auraSigE, 1, "|")
                    paramsCsv = aotFieldAt(auraSigE, 2, "|")
                    // 接收者语义按**owner 类型**判定：
                    // 无论哪种情况，kids[0] 的**包前缀都不是实参**，一律跳过
                    // （effArgStart = 1）；差别只在 self 从哪来：
                    //   * object / 普通 class（`%struct.X*`）：self 由发射器补单例 →
                    //     例：`aura.fs.exists(p)` → `FileSystem_exists(obj, p)`；
                    //   * value class（String 等，self 表示为 `i8*`）：跳过后剩下的
                    //     第 1 个实参**就是**接收者 → 不能再补 self →
                    //     例：`aura.string.contains(s, x)` → `String_contains(s, x)`。
                    //     （旧实现把前缀当实参一起传：`String_contains(null, s, x)`，
                    //      callee 以 null 作 `this` → strlen(null) → 0xC0000005。）
                    val styE: String = this.selfTyOf(stdClsE)
                    effArgStart = 1
                    if (styE.startsWith("%struct.")) {
                        staticSelfTy = styE
                    } else {
                        staticSelfTy = ""
                    }
                    userSig = auraSigE
                }
            }
        }
        // 3) 模块内自由函数（裸名）
        if (userSig == "") {
            val fs: String = this.funcSignatureOf(fname)
            if (fs != "") {
                userSig = fs
            }
        }

        if (userSig != "") {
            retTy = aotFieldAt(userSig, 1, "|")
            paramsCsv = aotFieldAt(userSig, 2, "|")
        } else {
            // HIR 把 `s.indexOf(x)` / `s.contains(x)` 这类**字符串方法**统一改写成
            // `Collections.indexOf(s, x)`（列表语义）。接收者是字符串时必须改回
            // String 版调用点符号——否则字符串 `indexOf` 会走列表实现，恒返回 -1。
            var qHandled: Boolean = false
            if (EmitUtils.aotIndexOfSub(fname, ".") > 0 && n >= 1) {
                val recvId: Int = hirKidsAt(kids, 0)
                var isColl: Boolean = false
                if (hir.kindOf(recvId) == "HirVar") {
                    val rn: String = hir.textOf(recvId)
                    if (this.isListVar(rn) || EmitUtils.isCollectionTypeName(hir.tyOf(recvId))) {
                        isColl = true
                    }
                }
                if (!isColl) {
                    val m: String = methodCallSymbol(aotLastSegment(fname))
                    if (m != "") {
                        // Phase B Step 1b: 检查 HIR 中是否已有该函数（由 ModuleLink 自动包含编译）。
                        // 从 C 符号 "aura_lang_std_String_contains" 提取类名和方法名，
                        // 优先查 Aura 签名表；命中则走 Aura 路径，否则回退 C 符号。
                        val prefixLen: Int = 0 // methodCallSymbol 已返回裸 "Cls_method"
                        val restStart: Int = prefixLen
                        var underscorePos: Int = -1
                        var scanI: Int = restStart
                        while (scanI < m.length) {
                            if (aotSlice(m, scanI, 1) == "_") {
                                underscorePos = scanI
                                break
                            }
                            scanI = scanI + 1
                        }
                        var auraHit: Boolean = false
                        if (underscorePos > restStart) {
                            val clsName: String = aotSlice(m, restStart, underscorePos - restStart)
                            val methodName: String = aotSlice(m, underscorePos + 1, m.length)
                            val auraName: String = sanitizeLlvm(clsName + "." + methodName)
                            val auraSig: String = this.funcSignatureOf(auraName)
                            if (auraSig != "") {
                                sym = auraName
                                retTy = aotFieldAt(auraSig, 1, "|")
                                paramsCsv = aotFieldAt(auraSig, 2, "|")
                                // 与其它 Aura 编译路径一致：**值接收者**作第 1 个实参。
                                // 旧实现一律 `effArgStart = 1` + `%struct.<Cls>*` 占位，
                                // 于是 `s.indexOf(sub)` 发成
                                // `String_indexOf(%struct.String* null, i8* sub)`
                                // —— 而 `String_indexOf` 的定义接收者是 `i8*`，
                                // callee 拿到 null → 恒返回 -1（编译器自身扫描字符串
                                // 因此拿负下标切片，是崩溃源头之一）。
                                if (this.recvKidIsValue(hir, kids, n)) {
                                    effArgStart = 0
                                    staticSelfTy = ""
                                } else {
                                    effArgStart = 1
                                    staticSelfTy = this.selfTyOf(clsName)
                                }
                                auraHit = true
                            }
                        }
                        if (!auraHit) {
                            sym = m
                            qHandled = true
                            // 接收者在 kids[0]，而 C 运行库形参表不含 self：
                            // 按 arity 判定是否需要跳过接收者（`aura.string.contains(s,x)`）。
                            val msig2: String = this.callSig(m)
                            if (msig2 != "") {
                                val want2: Int = aotCsvCount(aotFieldAt(msig2, 1, "|"))
                                if (n - effArgStart - 1 == want2) {
                                    effArgStart = effArgStart + 1
                                }
                            }
                        }
                    }
                }
            }
            // std 类静态调用（Math.sin / String.fromCharCode…）→ 调用点符号
            //
            // **必须传 0**：成员调用（`aura.fs.exists(p)`）在函数开头被解析成
            // `fname = text(kids[0])` + `argStart = 1`，而接收者**正是 kids[0]**；
            // `stdClassReceiver` 的形态 A 就是「读 kids[0] 当接收者」。传 `argStart`
            // 会让它在成员调用上直接返回空串 → 符号名解析失败、只剩返回类型被
            // `inferRetTy` 猜对 → 发射出 `call i1 @exists(...)`（未定义符号，
            // llc 直接报错）。`13-stdlib.aura` 的 `aura.fs.exists(...)` 即此。
            val stdCls: String = this.stdClassReceiver(hir, kids, n, 0)
            if (stdCls != "") {
                // Phase B Step 1: 检查 HIR 中是否已有该函数（由 ModuleLink 自动包含编译）。
                // 若命中，走 Aura 编译路径（不生成 C 符号）；否则回退到 C 运行库符号。
                val auraName: String = sanitizeLlvm(stdCls) + "_" + sanitizeLlvm(fname)
                val auraSig: String = this.funcSignatureOf(auraName)
                if (auraSig != "") {
                    sym = auraName
                    retTy = aotFieldAt(auraSig, 1, "|")
                    paramsCsv = aotFieldAt(auraSig, 2, "|")
                    if (this.recvKidIsValue(hir, kids, n)) {
                        // 值接收者（`all.split(sep)`）：Aura 签名首参即接收者
                        //（value class 为值表示、class 为实例指针），把接收者作为
                        // 第 1 个实参传入即可，类型自然对齐（`selfTyOf`）。
                        effArgStart = 0
                        staticSelfTy = ""
                    } else {
                        // 类名单例静态调用（`String.fromCharCode(c)`）：无接收者值
                        effArgStart = 1
                        staticSelfTy = this.selfTyOf(stdCls)
                    }
                } else {
                    sym = "aura_lang_std_" + sanitizeLlvm(stdCls) + "_" + sanitizeLlvm(fname)
                    effArgStart = 1
                }
            } else {
                // 实例方法：裸方法名（接收者在 kids[0]）→ 运行库符号。
                // 接收者**必须跳过**（`effArgStart = 1`）：C 运行库的
                // `aura_lang_std_<Cls>_<m>` 形参表不含 self。旧实现把接收者
                // 当成第 0 个实参一起传，实参整体错位一格
                // （`aura.string.contains(s, "Aura")` → `contains(0, s, "Aura")`），
                // 数值类型下还会把非空句柄当字符串指针解引用而崩溃。
                val methodSym: String = methodCallSymbol(fname)
                if (methodSym != "") {
                    // Phase B Step 1c: 检查 HIR 中是否已有该函数（由 ModuleLink 自动包含编译）。
                    // 从 C 符号 "aura_lang_std_String_length" 提取类名和方法名，
                    // 优先查 Aura 签名表；命中则走 Aura 路径，否则回退 C 符号。
                    val prefixLen: Int = 0 // methodCallSymbol 已返回裸 "Cls_method"
                    val restStart: Int = prefixLen
                    var underscorePos: Int = -1
                    var scanI: Int = restStart
                    while (scanI < methodSym.length) {
                        if (aotSlice(methodSym, scanI, 1) == "_") {
                            underscorePos = scanI
                            break
                        }
                        scanI = scanI + 1
                    }
                    var auraHit: Boolean = false
                    if (underscorePos > restStart) {
                        val clsName: String = aotSlice(methodSym, restStart, underscorePos - restStart)
                        val methodName: String = aotSlice(methodSym, underscorePos + 1, methodSym.length)
                        val auraName: String = sanitizeLlvm(clsName) + "_" + sanitizeLlvm(methodName)
                        val auraSig: String = this.funcSignatureOf(auraName)
                        if (auraSig != "") {
                            sym = auraName
                            retTy = aotFieldAt(auraSig, 1, "|")
                            paramsCsv = aotFieldAt(auraSig, 2, "|")
                            // 实参构造按 **owner 类型**决定（不是二选一）：
                            //   * value class（String…，self 表示为 `i8*`）：源码里的
                            //     接收者**就是** self → 不补 self，接收者作第 1 个实参
                            //     （effArgStart = 0，staticSelfTy = ""）；
                            //   * object / class（Collections…，self 为 `%struct.X*`）：
                            //     Aura 签名形如 `take(self, list, n)`，源码接收者
                            //     （`nums`）只是**第 1 个形参** → 既要补 self 单例，又要
                            //     保留接收者实参（effArgStart = 0 + staticSelfTy）。
                            // 旧实现把两者做成二选一：`nums.take(2)` 于是缺了 `list`
                            // 实参 → 调用点 `Collections_take(obj, 2)` 与定义
                            // `(self, list, n)` 参数错位，callee 拿 n 当列表句柄
                            // 解引用 → 0xC0000005（15-advanced 的 take(2) 崩溃）。
                            effArgStart = 0
                            val styV: String = this.selfTyOf(clsName)
                            if (styV.startsWith("%struct.")) {
                                staticSelfTy = styV
                            } else {
                                staticSelfTy = ""
                            }
                            auraHit = true
                        }
                    }
                    if (!auraHit) {
                        sym = methodSym
                        // 仅当「跳过接收者」后实参数与 C 形参数**恰好相等**时跳过：
                        // C 运行库 `aura_lang_std_<Cls>_<m>` 的形参表不含 self，
                        // 而 Aura 侧的接收者在 kids[0]。按 arity 判定可避免误伤
                        // 「裸方法名但接收者本身就是唯一实参」的调用点。
                        val msig: String = this.callSig(methodSym)
                        if (msig != "") {
                            val want: Int = aotCsvCount(aotFieldAt(msig, 1, "|"))
                            if (n - effArgStart - 1 == want) {
                                effArgStart = effArgStart + 1
                            }
                        }
                    }
                }
            }
            val sig: String = this.callSig(sym)
            if (sig != "" && retTy == "") {
                retTy = aotFieldAt(sig, 0, "|")
                paramsCsv = aotFieldAt(sig, 1, "|")
            }
        }

        // 裸名调用 **object 静态方法**：`keywordSearchTable()` →
        // `TokenUtils_keywordSearchTable`。
        //
        // Aura 允许同包内裸名调用 object 成员（Rust 后端会跨 object 查找），但发射器
        // 此前没有这条解析路径 → 落到「未解析符号」回退**静默返回 0/空串**。
        // `Lexer.init` 的 `this.kwTable = keywordSearchTable()` 因此得到空表 →
        // `keywordLookup` 全部落空 → 词法器把 `fun`/`if` 等一律当标识符、kind 为空串
        // → 解析器产出垃圾 AST（Stage-4 崩溃的直接原因）。
        //
        // **必须在实参构建与 `var callee = "@" + sym` 之前**：
        //   * `callee` 一旦生成便不可再改；
        //   * object 方法有隐式 self 形参，接收者位必须在实参之前确定
        //     （否则实参数比形参少一个 → callee 把第一个实参当 self，参数整体错位，
        //      如 `jitSlice(text, start, len)` 变成 `self=text, text=start, start=len`）。
        if (retTy == "" && this.fObjectClassNames != "") {
            var obIdx: Int = 0
            val obN: Int = aotLineCount(this.fObjectClassNames)
            while (obIdx < obN && retTy == "") {
                val obCls: String = sanitizeLlvm(aotLineAt(this.fObjectClassNames, obIdx))
                val obCand: String = obCls + "_" + fname
                val obSig: String = this.funcSignatureOf(obCand)
                if (obSig != "") {
                    sym = obCand
                    retTy = aotFieldAt(obSig, 1, "|")
                    paramsCsv = aotFieldAt(obSig, 2, "|")
                    // 实参起点按**参数个数**判定：本路径同时服务两种调用形态——
                    //   1) 裸名调用 `keywordSearchTable()`：kids[0] 就是第 1 个实参 → 0；
                    //   2) 成员调用 `aura.io.fileExists(p)`：kids[0] 是**接收者**
                    //      （HIR 把包前缀降级为接收者）→ 必须跳过（否则实参多一个
                    //      `null`，callee 把 null 当路径解引用 → 0xC0000005）。
                    // 判定：形参表含隐式 self，去掉后「实参数 == 形参数 + 1」
                    // 即说明多出的那个是接收者。
                    val wantArgs: Int = aotCsvCount(paramsCsv) - 1
                    if (n == wantArgs + 1) {
                        effArgStart = 1
                    } else {
                        effArgStart = 0
                    }
                    staticSelfTy = this.selfTyOf(obCls)
                }
                obIdx = obIdx + 1
            }
        }

        // ── 动态派发前导：实例 vptr → vtable 槽位 → 函数指针 ──
        //
        // 仅对**可重写方法**（有槽位）发射；接收者静态类型已知（vtCls），
        // 运行期从实例该字段取到**真实类**的 vtable，从而正确派发。
        // 必须在实参求值**之前**发射：实参里可能嵌套别的调用，会覆盖瞬态状态。
        var vtFn: String = ""
        if (vtSlot >= 0 && vtObj != "" && vtCls != "") {
            val vtg: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(vtg)
            this.fBody.sbAdd(" = getelementptr inbounds %struct.")
            this.fBody.sbAdd(vtCls)
            this.fBody.sbAdd(", %struct.")
            this.fBody.sbAdd(vtCls)
            this.fBody.sbAdd("* ")
            this.fBody.sbAdd(vtObj)
            this.fBody.sbAdd(", i32 0, i32 0\n")
            val vtp: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(vtp)
            this.fBody.sbAdd(" = load i8*, i8** ")
            this.fBody.sbAdd(vtg)
            this.fBody.sbAdd("\n")
            val vts: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(vts)
            this.fBody.sbAdd(" = getelementptr i8*, i8** ")
            this.fBody.sbAdd(vtp)
            this.fBody.sbAdd(", i64 ")
            this.fBody.sbAdd(toStr(vtSlot))
            this.fBody.sbAdd("\n")
            vtFn = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(vtFn)
            this.fBody.sbAdd(" = load i8*, i8** ")
            this.fBody.sbAdd(vts)
            this.fBody.sbAdd("\n")
        }

        var args: String = ""
        var ai: Int = 0
        // 隐式 this：先压入接收者（`this`），实参从参数表第 1 项开始对应
        if (prependThis) {
            val thTy: String = this.lookupVarTy("this")
            val th: String = this.emitVarLoad("this")
            args = thTy + " " + th
            ai = 1
        }
        // 类静态方法：接收者位传 self（形参表第 0 项是 self）。
        // object 单例传 `@aura_obj_<Cls>`（真实实例）——传 `null` 会让方法体里
        // 任何 `this.<field>` 访问空指针解引用。
        if (staticSelfTy != "") {
            args = staticSelfTy + " " + this.singletonRefOf(staticSelfTy)
            ai = 1
        }
        // 实参 id 顺序：命名实参按形参名重排（见 `buildArgIds`）
        val argIds: String = this.buildArgIds(hir, kids, effArgStart, n, sym, ai)
        val argTotal: Int = aotCsvCount(argIds)
        var i: Int = 0
        while (i < argTotal) {
            var aId: Int = aotToInt(aotFieldAt(argIds, i, ","))
            // 命名实参 `f(name = v)`：取标记节点的子表达式求值
            if (hir.kindOf(aId) == "HirNamedArg") {
                val nk: String = hir.kidsOf(aId)
                if (hirKidsCount(nk) > 0) {
                    aId = hirKidsAt(nk, 0)
                }
            }
            val aTy: String = this.inferType(hir, aId)
            val a: String = this.emitExpr(hir, aId)
            var wantTy: String = aTy
            if (paramsCsv != "") {
                // 同 `emitCall`：参数表是带空格 CSV（`i8*, i64`），必须 trim。
                wantTy = trimSpaces(aotFieldAt(paramsCsv, ai, ","))
                // 如果参数表没有对应的类型（ai 超出范围），使用 HIR 推断的类型
                if (wantTy == "") {
                    wantTy = aTy
                }
            }
            var coerced: String = this.coerceArg(sym, a, aTy, wantTy)
            // 指针形参的空值：字面量 `null` 求值为常量 `0`，直接写 `%struct.X* 0`
            // 会被 llc 拒绝（integer/byte constant must have integer/byte type），
            // 必须写成 `null`。
            if (coerced == "0"
                && (wantTy == "i8*" || wantTy == "ptr" || wantTy.endsWith("*"))) {
                coerced = "null"
            }
            if (args != "") {
                args = args + ", "
            }
            // 确保类型不为空（空类型会导致多余的空格）
            if (wantTy != "") {
                args = args + wantTy + " " + coerced
            } else {
                args = args + coerced
            }
            ai = ai + 1
            i = i + 1
        }

        // 默认参数补齐：实参少于形参时，用形参节点的默认值表达式填充
        // （否则 `call` 实参数与 `define` 形参数不一致 → llc 报错）。
        val defCsv: String = this.paramDefsOf(sym)
        if (defCsv != "") {
            val declared: Int = aotCsvCount(defCsv)
            while (ai < declared) {
                val pid: Int = aotToInt(aotFieldAt(defCsv, ai, ","))
                var wantTy: String = trimSpaces(aotFieldAt(paramsCsv, ai, ","))
                if (wantTy == "") {
                    wantTy = "i32"
                }
                var dv: String = EmitUtils.defaultValue(wantTy)
                if (pid >= 0) {
                    val pk: String = hir.kidsOf(pid)
                    if (hirKidsCount(pk) > 0) {
                        val did: Int = hirKidsAt(pk, 0)
                        val dTy: String = this.inferType(hir, did)
                        dv = this.coerceArg(sym, this.emitExpr(hir, did), dTy, wantTy)
                    }
                }
                if (dv == "0"
                    && (wantTy == "i8*" || wantTy == "ptr" || wantTy.endsWith("*"))) {
                    dv = "null"
                }
                if (args != "") {
                    args = args + ", "
                }
                args = args + wantTy + " " + dv
                ai = ai + 1
            }
        }

        // 动态派发：callee 用运行期取出的函数指针，而不是静态符号
        var callee: String = "@" + sym
        if (vtFn != "") {
            callee = vtFn
        }

        if (retTy == "void") {
            this.fBody.sbAdd("  call void ")
            this.fBody.sbAdd(callee)
            this.fBody.sbAdd("(")
            this.fBody.sbAdd(args)
            this.fBody.sbAdd(")\n")
            return "0"
        }
        if (retTy == "") {
            // 未解析符号（如 `throw Runtime("…")` 里被当作调用的 `Runtime`，
            // 或缺失签名的外部类构造）：**不发调用**。否则会生成未定义符号
            // `@Runtime`，整个模块无法通过 llc（Aura 侧无异常机制，
            // 这类语句降级为无副作用的表达式即可）。
            return "0"
        }
        val t: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(t)
        this.fBody.sbAdd(" = call ")
        this.fBody.sbAdd(retTy)
        this.fBody.sbAdd(" ")
        this.fBody.sbAdd(callee)
        this.fBody.sbAdd("(")
        this.fBody.sbAdd(args)
        this.fBody.sbAdd(")\n")
        // 返回值归一：C 调用点符号的 ABI 返回类型可能宽于语言层类型
        //（如 `String.indexOf` C 侧为 `int64_t`、Aura 侧为 `Int`）。若不在调用点
        // 收窄，后续 `icmp`/算术会按推断类型（i32）使用 i64 值 → llc 报
        // `'%var' defined with type 'i64' but expected 'i32'`。
        val wantTy: String = this.inferType(hir, id)
        if (wantTy != "" && wantTy != retTy
            && EmitUtils.intWidth(wantTy) > 0 && EmitUtils.intWidth(retTy) > 0) {
            return this.coerceValue(t, retTy, wantTy)
        }
        return t
    }

    /// 发射 println/print 内置调用（内联 IR：@_write + @strlen）。
    fun emitPrint(hir: Hir, kids: String, n: Int, argStart: Int, newline: Boolean): String {
        if (argStart >= n) {
            return "0"
        }
        val aId: Int = hirKidsAt(kids, argStart)
        val aTy: String = this.inferType(hir, aId)
        val a: String = this.emitExpr(hir, aId)
        val s: String = this.toStringOperand(a, aTy)
        if (newline) {
            // println(s): 分配 buf，复制 s + '\n'，_write(buf)，free(buf)
            val len64: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(len64)
            this.fBody.sbAdd(" = call i64 @strlen(i8* ")
            this.fBody.sbAdd(s)
            this.fBody.sbAdd(")\n")
            val total64: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(total64)
            this.fBody.sbAdd(" = add i64 ")
            this.fBody.sbAdd(len64)
            this.fBody.sbAdd(", 1\n")
            val total32: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(total32)
            this.fBody.sbAdd(" = trunc i64 ")
            this.fBody.sbAdd(total64)
            this.fBody.sbAdd(" to i32\n")
            val buf: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(buf)
            this.fBody.sbAdd(" = call i8* @malloc(i64 ")
            this.fBody.sbAdd(total64)
            this.fBody.sbAdd(")\n")
            this.fBody.sbAdd("  call void @aura_block_copy(i8* align 1 ")
            this.fBody.sbAdd(buf)
            this.fBody.sbAdd(", i8* align 1 ")
            this.fBody.sbAdd(s)
            this.fBody.sbAdd(", i64 ")
            this.fBody.sbAdd(len64)
            this.fBody.sbAdd(", i1 false)\n")
            val end: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(end)
            this.fBody.sbAdd(" = getelementptr i8, i8* ")
            this.fBody.sbAdd(buf)
            this.fBody.sbAdd(", i64 ")
            this.fBody.sbAdd(len64)
            this.fBody.sbAdd("\n")
            this.fBody.sbAdd("  store i8 10, i8* ")
            this.fBody.sbAdd(end)
            this.fBody.sbAdd(", align 1\n")
            this.fBody.sbAdd("  call i32 @_write(i32 1, i8* ")
            this.fBody.sbAdd(buf)
            this.fBody.sbAdd(", i32 ")
            this.fBody.sbAdd(total32)
            this.fBody.sbAdd(")\n")
            val bufI64: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(bufI64)
            this.fBody.sbAdd(" = ptrtoint i8* ")
            this.fBody.sbAdd(buf)
            this.fBody.sbAdd(" to i64\n")
            this.fBody.sbAdd("  call void @free(i64 ")
            this.fBody.sbAdd(bufI64)
            this.fBody.sbAdd(")\n")
        } else {
            // print(s): strlen + _write
            val len64: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(len64)
            this.fBody.sbAdd(" = call i64 @strlen(i8* ")
            this.fBody.sbAdd(s)
            this.fBody.sbAdd(")\n")
            val len32: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(len32)
            this.fBody.sbAdd(" = trunc i64 ")
            this.fBody.sbAdd(len64)
            this.fBody.sbAdd(" to i32\n")
            this.fBody.sbAdd("  call i32 @_write(i32 1, i8* ")
            this.fBody.sbAdd(s)
            this.fBody.sbAdd(", i32 ")
            this.fBody.sbAdd(len32)
            this.fBody.sbAdd(")\n")
        }
        return "0"
    }

    /// 把任意标量/字符串操作数转成 i8*（供输出）。
    fun toStringOperand(v: String, ty: String): String {
        if (ty == "i8*" || ty == "ptr") {
            // i8* 既可能是真实字符串指针，也可能是 Plan A 装箱整数（低位标记）。
            // Aura toStr(Any) 统一解码：偶数指针原样返回，奇数 → 十进制串。
            val t: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(t)
            this.fBody.sbAdd(" = call i8* @toStr(i8* ")
            this.fBody.sbAdd(v)
            this.fBody.sbAdd(")\n")
            return t
        }
        if (ty == "float" || ty == "double") {
            // 内联 _snprintf 替换 aura_to_str_float
            val buf: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(buf)
            this.fBody.sbAdd(" = call i8* @malloc(i64 64)\n")
            this.fBody.sbAdd("  call i32 @snprintf(i8* ")
            this.fBody.sbAdd(buf)
            this.fBody.sbAdd(", i64 64, i8* @fmt_float_g, ")
            this.fBody.sbAdd(ty)
            this.fBody.sbAdd(" ")
            this.fBody.sbAdd(v)
            this.fBody.sbAdd(")\n")
            return buf
        }
        var i64v: String = v
        if (ty != "i64") {
            val t: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(t)
            this.fBody.sbAdd(" = sext ")
            this.fBody.sbAdd(ty)
            this.fBody.sbAdd(" ")
            this.fBody.sbAdd(v)
            this.fBody.sbAdd(" to i64\n")
            i64v = t
        }
        val boxed: String = this.boxToPtr(i64v, "i64")
        val t2: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(t2)
        this.fBody.sbAdd(" = call i8* @toStr(i8* ")
        this.fBody.sbAdd(boxed)
        this.fBody.sbAdd(")\n")
        return t2
    }

    /// 发射 `if` 表达式（值位置）：按条件分支 + `phi` 选择结果。
    ///
    /// 旧实现直接返回 then 分支的值、**完全忽略条件**：`val kind = if (c) "A" else "B"`
    /// 恒得 then 值；若分支体是块（`if (c) { "A" } else { "B" }`），拿到的是块节点，
    /// 结果是空/垃圾字符串。自举编译器的 `Parser.parseDecl` 正是
    /// `val nodeKind = if (k == "Val") { "ValDecl" } else { "VarDecl" }`，
    /// 于是声明节点的 kind 变成空 → HIR 降级按 kind 匹配不到 → **所有 `val`/`var`
    /// 声明被静默丢弃**（`self.exe` 编译出的程序里局部变量全变成 0）。
    fun emitIfValue(hir: Hir, id: Int): String {
        val kids: String = hir.kidsOf(id)
        val n: Int = hirKidsCount(kids)
        if (n < 2) {
            return "0"
        }
        val condId: Int = hirKidsAt(kids, 0)
        val condTy: String = this.inferType(hir, condId)
        val cond: String = this.toI1(this.emitExpr(hir, condId), condTy)
        val thenId: Int = hirKidsAt(kids, 1)
        var elseId: Int = -1
        if (n > 2) {
            elseId = hirKidsAt(kids, 2)
        }
        // 结果类型：取 then 分支（块则取块内末语句）的类型
        var valTy: String = this.inferBlockValueTy(hir, thenId)
        if (valTy == "" || valTy == "void") {
            valTy = "i32"
        }
        // 结果用**入口块栈槽**承载：分支内部可能再产生基本块（嵌套 if 表达式 /
        // 循环 / 终结语句触发的 dead 块），此时 phi 的前驱集合与 merge 实际前驱
        // 不一致，llc 会报 `PHI node entries do not match predecessors`。
        // 栈槽方案与块结构无关，天然合法。
        val slot: String = this.declareVar("ifval" + toStr(this.varCount) + "_" + toStr(id), valTy)
        val thenBb: String = this.freshBb("ifval.then")
        val elseBb: String = this.freshBb("ifval.else")
        val mergeBb: String = this.freshBb("ifval.merge")
        this.fBody.sbAdd("  br i1 ")
        this.fBody.sbAdd(cond)
        this.fBody.sbAdd(", label %")
        this.fBody.sbAdd(thenBb)
        this.fBody.sbAdd(", label %")
        this.fBody.sbAdd(elseBb)
        this.fBody.sbAdd("\n")

        this.fBody.sbAdd(thenBb)
        this.fBody.sbAdd(":\n")
        this.fTerminated = false
        val thenVal: String = this.emitBlockValue(hir, thenId, valTy)
        if (!this.fTerminated) {
            this.fBody.sbAdd("  store ")
            this.fBody.sbAdd(valTy)
            this.fBody.sbAdd(" ")
            this.fBody.sbAdd(thenVal)
            this.fBody.sbAdd(", ")
            this.fBody.sbAdd(EmitUtils.toPtrTySp(valTy))
            this.fBody.sbAdd(slot)
            this.fBody.sbAdd("\n")
            this.fBody.sbAdd("  br label %")
            this.fBody.sbAdd(mergeBb)
            this.fBody.sbAdd("\n")
        }

        this.fBody.sbAdd(elseBb)
        this.fBody.sbAdd(":\n")
        this.fTerminated = false
        if (elseId >= 0) {
            val elseVal: String = this.emitBlockValue(hir, elseId, valTy)
            if (!this.fTerminated) {
                this.fBody.sbAdd("  store ")
                this.fBody.sbAdd(valTy)
                this.fBody.sbAdd(" ")
                this.fBody.sbAdd(elseVal)
                this.fBody.sbAdd(", ")
                this.fBody.sbAdd(EmitUtils.toPtrTySp(valTy))
                this.fBody.sbAdd(slot)
                this.fBody.sbAdd("\n")
            }
        }
        if (!this.fTerminated) {
            this.fBody.sbAdd("  br label %")
            this.fBody.sbAdd(mergeBb)
            this.fBody.sbAdd("\n")
        }

        this.fBody.sbAdd(mergeBb)
        this.fBody.sbAdd(":\n")
        this.fTerminated = false
        val res: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(res)
        this.fBody.sbAdd(" = load ")
        this.fBody.sbAdd(valTy)
        this.fBody.sbAdd(", ")
        this.fBody.sbAdd(EmitUtils.toPtrTySp(valTy))
        this.fBody.sbAdd(slot)
        this.fBody.sbAdd("\n")
        return res
    }

    /// 块作为**值**时的类型（块内末语句类型；非块按普通节点推断）。
    fun inferBlockValueTy(hir: Hir, id: Int): String {
        if (hir.kindOf(id) == "HirBlock") {
            val kids: String = hir.kidsOf(id)
            val n: Int = hirKidsCount(kids)
            if (n == 0) {
                return "i32"
            }
            return this.inferType(hir, hirKidsAt(kids, n - 1))
        }
        return this.inferType(hir, id)
    }

    /// 发射块作为**值**：块内前缀语句按语句发射，末语句求值并按需要类型转换。
    fun emitBlockValue(hir: Hir, id: Int, wantTy: String): String {
        if (hir.kindOf(id) != "HirBlock") {
            val lt: String = this.inferType(hir, id)
            return this.coerceValue(this.emitExpr(hir, id), lt, wantTy)
        }
        val kids: String = hir.kidsOf(id)
        val n: Int = hirKidsCount(kids)
        if (n == 0) {
            return EmitUtils.defaultValue(wantTy)
        }
        var i: Int = 0
        while (i + 1 < n) {
            this.emitStmt(hir, hirKidsAt(kids, i))
            i = i + 1
        }
        val lastId: Int = hirKidsAt(kids, n - 1)
        val lt: String = this.inferType(hir, lastId)
        return this.coerceValue(this.emitExpr(hir, lastId), lt, wantTy)
    }

    // ── 类型推断 ──

    /// 推断节点的 LLVM 类型（**记忆化**：同一节点在同代内只计算一次）。
    ///
    /// 代际由 `emitFunction` 推进：`inferType` 依赖当前函数状态（局部变量表 / 所属类），
    /// 跨函数复用会得到错误类型。
    fun inferType(hir: Hir, id: Int): String {
        if (id < 0 || id >= hir.count) {
            return "i32"
        }
        if (this.fInferGenStrs[id] == this.fGenStr) {
            return this.fInferCache[id]
        }
        val r: String = this.inferTypeUncached(hir, id)
        this.fInferGenStrs[id] = this.fGenStr
        this.fInferCache[id] = r
        return r
    }

    /// [`inferType`] 的实际推断实现（无记忆化；递归调用仍走记忆化入口）。
    fun inferTypeUncached(hir: Hir, id: Int): String {
        if (id < 0 || id >= hir.count) {
            return "i32"
        }
        val k: String = hir.kindOf(id)
        // lambda / 闭包：值是 env 指针，统一按 `i8*` 表示
        if (k == "HirLambda") {
            return "i8*"
        }
        if (k == "HirLit") {
            val ty: String = hir.tyOf(id)
            if (ty == "String") {
                return "i8*"
            }
            if (ty == "Boolean") {
                return "i1"
            }
            if (ty != "") {
                val m: String = this.mapTy(ty)
                if (m != "") {
                    return m
                }
            }
            return EmitUtils.inferLitType(hir.textOf(id))
        }
        if (k == "HirVar") {
            val ty: String = this.lookupVarTy(hir.textOf(id))
            if (ty == "") {
                // 类方法内：裸字段名 → 字段类型（Phase 6.5.1b）
                val fty: String = this.curClassFieldTy(hir.textOf(id))
                if (fty != "") {
                    return fty
                }
                return "i32"
            }
            return ty
        }
        if (k == "HirBinary") {
            val op: String = hir.textOf(id)
            // 类型转换 `x as T`：类型 = 左操作数类型（运行期表示不变）
            if (op == "as" || op == "As") {
                val ak: String = hir.kidsOf(id)
                if (hirKidsCount(ak) > 0) {
                    return this.inferType(hir, hirKidsAt(ak, 0))
                }
                return "i32"
            }
            if (EmitUtils.isCmpOp(op) || op == "&&" || op == "||") {
                return "i1"
            }
            // `x is T` → i1
            if (op == "is" || op == "Is") {
                return "i1"
            }
            val kids: String = hir.kidsOf(id)
            if (hirKidsCount(kids) >= 2) {
                val aTy: String = this.inferType(hir, hirKidsAt(kids, 0))
                // Elvis 结果类型 = 可空内部类型
                if (op == "?:") {
                    if (EmitUtils.isNullableStructTy(aTy)) {
                        return EmitUtils.nullableInnerTy(aTy)
                    }
                    return aTy
                }
                val bTy: String = this.inferType(hir, hirKidsAt(kids, 1))
                if (op == "+" && (aTy == "i8*" || bTy == "i8*")) {
                    return "i8*"
                }
                return this.commonNumTy(aTy, bTy)
            }
            if (hirKidsCount(kids) > 0) {
                return this.inferType(hir, hirKidsAt(kids, 0))
            }
            return "i32"
        }
        if (k == "HirUnary") {
            // 逻辑非产出 `i1`（`xor i1 x, true`）：这里必须如实报告 i1，
            // 否则消费方（分支条件 / 赋值）会按操作数类型把它当 i32 包装，
            // 生成 `icmp ne i32 <i1 值>, 0` 这类非法 IR。
            if (hir.textOf(id) == "!") {
                return "i1"
            }
            val kids: String = hir.kidsOf(id)
            if (hirKidsCount(kids) > 0) {
                return this.inferType(hir, hirKidsAt(kids, 0))
            }
            return "i32"
        }
        if (k == "HirMember") {
            val member: String = hir.textOf(id)
            val mk: String = hir.kidsOf(id)
            if (hirKidsCount(mk) > 0) {
                val recvTy: String = this.inferType(hir, hirKidsAt(mk, 0))
                val sym: String = this.structSymOfPtr(recvTy)
                if (sym != "") {
                    val fi: Int = this.structFieldIndex(sym, member)
                    if (fi >= 0) {
                        return aotFieldAt(this.structFieldLineAt(sym, fi), 2, "|")
                    }
                }
            }
            return "i32"
        }
        if (k == "HirIfExpr") {
            // 值位置的条件表达式：结果类型 = then 分支（块则取末语句）类型。
            // 缺此分支会让 `val s: String = if (c) { "A" } else { "B" }`
            // 走默认 i32，插入错误的 inttoptr 转换。
            val ik: String = hir.kidsOf(id)
            if (hirKidsCount(ik) > 1) {
                val vt: String = this.inferBlockValueTy(hir, hirKidsAt(ik, 1))
                if (vt != "" && vt != "void") {
                    return vt
                }
            }
            return "i32"
        }
        if (k == "HirIndex") {
            val kids: String = hir.kidsOf(id)
            if (hirKidsCount(kids) > 0) {
                val cId: Int = hirKidsAt(kids, 0)
                // 集合（含字段接收者 `this.fields[i]`）→ 元素类型
                if (this.isCollectionReceiver(hir, cId)) {
                    return this.receiverElemTy(hir, cId)
                }
                if (hir.kindOf(cId) == "HirVar") {
                    val cn: String = hir.textOf(cId)
                    // 定长数组 `[N x T]` → 元素类型 T
                    val ct: String = this.lookupVarTy(cn)
                    if (ct.startsWith("[")) {
                        return EmitUtils.llvmElemOfArrayTy(ct)
                    }
                }
            }
            // 字符串下标 → 单字符字符串
            return "i8*"
        }
        if (k == "HirNamedArg") {
            val nk: String = hir.kidsOf(id)
            if (hirKidsCount(nk) > 0) {
                return this.inferType(hir, hirKidsAt(nk, 0))
            }
            return "i32"
        }
        if (k == "HirCall") {
            val kids: String = hir.kidsOf(id)
            var fname: String = hir.textOf(id)
            if (fname == "" && hirKidsCount(kids) > 0) {
                fname = hir.textOf(hirKidsAt(kids, 0))
            }

            // 类型检查内建返回 i1（否则消费方按 i32 包装 → `icmp ne i32 <i1>, 0` 非法 IR）
            if (fname == "aura_isOfType") {
                return "i1"
            }
            // `toString(x)` / `toStr(x)` → **i8\***（C 字符串）。
            //
            // `emitCall` 对这两个 prelude 名做的是「值 → 字符串」转换并直接返回
            // `i8*`，但类型推断此前没有对应分支，落到兜底 `i32`。于是字符串拼接
            // （`a + b`，见字符串 concat 分支的 `valueToStr(a, aTy)`）会把这个
            // **已经是字符串**的值再按 i32 转一次：
            //   `%s = call i8* @aura_to_str(...)`            ← 正确的一次转换
            //   `%t = sext i32 %s to i64` / `@aura_to_str`   ← 把 i8* 当 i32
            // llc 报 `'%var.N' defined with type 'ptr' but expected 'i32'`。
            // 字符串插值（`"$x"` → `toString(x)`，见 Parser.parseStringInterp）
            // 与手写 `toStr(...)` 都会命中该路径。
            if ((fname == "toString" || fname == "toStr") && hirKidsCount(kids) == 1) {
                return "i8*"
            }
            // `x.toFloat()` / `x.toInt()`（1 个实参 = 接收者）：数值转换内建。
            //
            // 必须与 `emitCall` 的 toInt/toFloat 分支返回类型一致，否则调用点会
            // 按兜底 `i32` 再转换一次：
            //   `%a = sitofp i32 %x to float`      ← emitCall 已产出 float
            //   `%b = sitofp i32 %a to float`      ← 调用点又按 i32 转 → 非法 IR
            //（llc: '%var.N' defined with type 'float' but expected 'i32'）。
            if (fname == "toFloat" && hirKidsCount(kids) == 1) {
                return "float"
            }
            if (fname == "toInt" && hirKidsCount(kids) == 1) {
                return "i32"
            }
            // `Memory.*` 访存内置：返回宽度由方法名决定，必须与 `emitCall`
            // 的 `Memory.*` 分支（inttoptr + load/store）一致。
            // 否则会落到 native 约定的 i64，与发射出的 i8/i16/i32 冲突：
            //   `'%var.N' defined with type 'i8' but expected 'i64'`
            //   `'%var.N' defined with type 'i64' but expected 'i32'`
            // `String.charCodeAt(i)` 内联访存，返回**整数**（与 `emitCall` 的
            // 内联实现一致）。此前落到 C 符号 `aura_lang_std_String_charAt`
            //（返回 `i8*`）→ 调用点把指针当字符码用，缓冲区内容全错。
            if (fname == "charCodeAt" && hirKidsCount(kids) >= 2) {
                return "i64"
            }
            // `Collections.getAt` / `Collections.set`：HIR 对 `x.get(i)` / `x[i]` /
            // `x[i] = v` 的统一降级名（见 `Hir.lowerCall`）。
            // 发射器按集合句柄语义发 `aura_lang_std_Collections_getAt/set`
            //（返回 `i8*`），类型推断必须一致；否则落到兜底 i32，消费侧
            // `sext i32 <ptr> to i64` → llc `defined with type 'ptr' but expected 'i32'`。
            // （类实例接收者由 `emitCall` 的 0) 分支还回 `<Cls>_get/set` 方法，
            //  其返回类型来自方法签名表，不受此处影响。）
            // 注意 `getAt` 要**与 `HirIndex` 一致地拆箱**：集合元素若是 Int 等标量，
            // 运行库返回的是装箱指针，必须按元素类型拆回标量 —— 否则调用点把指针
            // 当整数用（`spanStart[i]` 之类 → 垃圾下标 → 崩溃）。
            if (fname == "Collections.getAt") {
                if (hirKidsCount(kids) > 0) {
                    val rcG: Int = hirKidsAt(kids, 0)
                    if (this.isCollectionReceiver(hir, rcG)) {
                        return this.receiverElemTy(hir, rcG)
                    }
                }
                return "i8*"
            }
            if (fname == "Collections.set") {
                return "i8*"
            }
            // `x.contains(y)` / `x.indexOf(y)` / `x.lastIndexOf(y)` 同样被 HIR 降级为
            // `Collections.<m>(x, y)`（见 `Hir.lowerCall`）。发射器能按接收者类型解析到
            // `String_contains` / `ArrayList_contains`（**都返回 i1**）与
            // `String_indexOf` / `ArrayList_indexOf`（**都返回 i32**），但推断缺分支
            // → 落到兜底 i32。后果极其隐蔽：`"abc".contains("b")` 的值本身正确
            //（`if (...)` 分支行为正常），但 `toStr(...)` 会把这个 i1 当整数打印
            //（实测输出 `-1`/`0` 而非 `true`/`false`）—— 这正是
            // `Token.keywordLookup` 里 `!table.contains(mid)` 判定错乱、
            // 进而关键字表失效的根因之一。
            if (fname == "Collections.contains") {
                return "i1"
            }
            if (fname == "Collections.indexOf" || fname == "Collections.lastIndexOf") {
                return "i32"
            }
            // `a to b` → `Collections.pairOf(a, b)`（Pair 构造 → 堆列表句柄）
            if (fname == "Collections.pairOf") {
                return "i8*"
            }
            // `x.length()` / `x.size()`（**调用形式**）→ i32。
            // 与 `emitCall` 的 0.5) 分支（trunc i64 … to i32）一致；
            // 缺此分支会落到兜底 i32 —— 恰好相同，但显式列出以防兜底变化。
            if ((fname == "length" || fname == "size") && hirKidsCount(kids) == 1) {
                return "i32"
            }
            // `String.fromCharCode(c)` → 单字符 C 字符串（`emitCall` 0.4) 分支内联构造）。
            if (aotLastSegment(fname) == "fromCharCode") {
                return "i8*"
            }
            // `String.countChar(sub)` → i32（`emitCall` 0.45) 分支：C 运行库 i64 → trunc）。
            if (aotLastSegment(fname) == "countChar") {
                return "i32"
            }
            // `Process.run(cmd)` / `ProcessNative.run(cmd)` → 平台命令执行（i32）。
            // 与 `emitCall` 的 2.8) 分支一致。
            if (fname == "run" && hirKidsCount(kids) >= 2) {
                val rr: String = hir.textOf(hirKidsAt(kids, 0))
                if (rr == "Process" || rr == "ProcessNative") {
                    return "i32"
                }
            }
            // `Memory.alloc(n)` → libc malloc，返回 `Long`（i64）。
            // 必须与 `emitCall` 的 2.85) 分支一致：缺此分支会落到兜底 i32，
            // 把 i64 句柄截断成 i32。
            if (fname == "alloc" && hirKidsCount(kids) >= 2
                && hir.textOf(hirKidsAt(kids, 0)) == "Memory") {
                return "i64"
            }
            if (fname == "read" || fname == "read16" || fname == "read32" || fname == "read64"
                || fname == "write" || fname == "write16" || fname == "write32"
                || fname == "write64") {
                if (hirKidsCount(kids) >= 1
                    && hir.textOf(hirKidsAt(kids, 0)) == "Memory") {
                    if (fname == "read16") {
                        return "i16"
                    }
                    if (fname == "read32") {
                        return "i32"
                    }
                    if (fname == "read64") {
                        return "i64"
                    }
                    if (aotContains(fname, "read")) {
                        return "i8"
                    }
                    return "void"
                }
            }
            // `__callClosure(closure, "retTy|pTys", args…)` → 返回 sig 的 retTy。
            //
            // `emitCall` 按 sig 的 retTy 发射间接调用（`Collections.filter/map`
            // 用）。此处不返回同一类型时，调用结果会被当作 i32 再 `sext`：
            //   `%v = call i64 %fn(...)` / `%w = sext i32 %v to i64` ← 非法 IR
            //（llc: '%var.N' defined with type 'i64' but expected 'i32'）。
            if (fname == "__callClosure" && hirKidsCount(kids) >= 2) {
                val ccsig: String = hir.textOf(hirKidsAt(kids, 1))
                val ccret: String = aotFieldAt(ccsig, 0, "|")
                if (ccret != "") {
                    return ccret
                }
                return "i64"
            }
            // 闭包变量调用：返回类型取闭包签名（否则调用结果被当 i32，
            // `return greet("World")` 会产生 `sext i32 %i8ptr` 之类非法 IR）
            val csig: String = this.closureSigOfAny(fname)
            if (csig != "") {
                return aotFieldAt(csig, 0, "|")
            }
            // 集合构造 / 集合方法 → 列表句柄 `i8*`
            if (this.isCollectionCtor(fname)) {
                return "i8*"
            }
            if (fname == "add" && hirKidsCount(kids) >= 1
                && this.inferType(hir, hirKidsAt(kids, 0)) == "i8*") {
                return "i8*"
            }
            // 结构体构造 → 指针（Phase 6.5.1）
            val ctorSym: String = sanitizeLlvm(fname)
            if (this.isStructSym(ctorSym)) {
                return "%struct." + ctorSym + "*"
            }
            if (fname == "println" || fname == "print") {
                return "i32"
            }
            // 类静态方法 `ClassName.method()`：kids[0] 是类名 `HirVar`
            // （与 `emitCall` 的解析顺序一致）。
            if (hirKidsCount(kids) >= 1) {
                val sId: Int = hirKidsAt(kids, 0)
                if (hir.kindOf(sId) == "HirVar") {
                    val sn: String = hir.textOf(sId)
                    val ss: String = sanitizeLlvm(sn)
                    if (this.lookupVarTy(sn) == "" && this.isStructSym(ss)) {
                        val sm: String = this.funcSignatureOf(ss + "_" + fname)
                        if (sm != "") {
                            return aotFieldAt(sm, 1, "|")
                        }
                    }
                }
            }
            // 类方法**优先**（与 `emitCall` 的解析顺序一致）：`this.isX(v)` 与顶层
            // 同名自由函数共存时，必须按接收者类型选到方法版本，否则返回类型也会取错。
            if (hirKidsCount(kids) >= 1) {
                val recvTy: String = this.inferType(hir, hirKidsAt(kids, 0))
                val recvSym: String = this.structSymOfPtr(recvTy)
                if (recvSym != "") {
                    val ownerR: String = this.ownerClassInChain(recvSym, fname, hirKidsCount(kids))
                    if (ownerR != "") {
                        if (fname == "init") {
                            val msInitR: String = this.funcSignatureArity(ownerR + "_init", hirKidsCount(kids) - 1)
                            if (msInitR != "") {
                                return aotFieldAt(msInitR, 1, "|")
                            }
                        }
                        return aotFieldAt(this.funcSignatureOf(ownerR + "_" + fname), 1, "|")
                    }
                }
                // String 方法（接收者为 i8*）：`s.toFloat()` / `(c - '0').toFloat()`
                // String 是 value class，接收者类型为 i8*，不是 %struct.String*
                if (recvTy == "i8*") {
                    val sm2: String = this.funcSignatureOf("String_" + fname)
                    if (sm2 != "") {
                        return aotFieldAt(sm2, 1, "|")
                    }
                }
            }
            // 类体内裸方法名（隐式 this）/ `super.m()`：沿继承链解析
            if (this.fCurClass != "") {
                var ccls: String = sanitizeLlvm(this.fCurClass)
                var argcT: Int = hirKidsCount(kids) + 1
                if (hirKidsCount(kids) >= 1) {
                    val r0t: Int = hirKidsAt(kids, 0)
                    if (hir.kindOf(r0t) == "HirVar" && hir.textOf(r0t) == "super") {
                        ccls = this.parentOfClass(ccls)
                        argcT = hirKidsCount(kids)
                    }
                }
                val ownerT: String = this.ownerClassInChain(ccls, fname, argcT)
                if (ownerT != "") {
                    if (fname == "init") {
                        val msInitT: String = this.funcSignatureArity(ownerT + "_init", argcT - 1)
                        if (msInitT != "") {
                            return aotFieldAt(msInitT, 1, "|")
                        }
                    }
                    return aotFieldAt(this.funcSignatureOf(ownerT + "_" + fname), 1, "|")
                }
            }
            // 模块内自由函数（裸名）
            val userSig: String = this.funcSignatureOf(fname)
            if (userSig != "") {
                return aotFieldAt(userSig, 1, "|")
            }
            // 裸名调用 object 静态方法（与 `emitCall` 的同名路径一致）：
            // `keywordSearchTable()` → `TokenUtils_keywordSearchTable`。
            if (this.fObjectClassNames != "") {
                var obI: Int = 0
                val obN2: Int = aotLineCount(this.fObjectClassNames)
                while (obI < obN2) {
                    val obCls2: String = sanitizeLlvm(aotLineAt(this.fObjectClassNames, obI))
                    val obSig2: String = this.funcSignatureOf(obCls2 + "_" + fname)
                    if (obSig2 != "") {
                        return aotFieldAt(obSig2, 1, "|")
                    }
                    obI = obI + 1
                }
            }
            // std 类静态调用（Math.sin 等）
            val stdCls: String = this.stdClassReceiver(hir, kids, hirKidsCount(kids), 0)
            if (stdCls != "") {
                // Phase B Step 1: 优先查 HIR 签名表（函数已由 ModuleLink 编译为 Aura）
                val auraName: String = sanitizeLlvm(stdCls + "." + fname)
                val auraSig: String = this.funcSignatureOf(auraName)
                if (auraSig != "") {
                    return aotFieldAt(auraSig, 1, "|")
                }
                val ss: String = this.callSig("aura_lang_std_" + sanitizeLlvm(stdCls)
                    + "_" + sanitizeLlvm(fname))
                if (ss != "") {
                    return aotFieldAt(ss, 0, "|")
                }
            }
            var sym: String = sanitizeLlvm(fname)
            val methodSym: String = methodCallSymbol(fname)
            if (methodSym != "") {
                // Phase B Step 1d: 检查 HIR 中是否已有该函数（由 ModuleLink 自动包含编译）。
                val prefixLen: Int = 0 // methodCallSymbol 已返回裸 "Cls_method"
                val restStart: Int = prefixLen
                var underscorePos: Int = -1
                var scanI: Int = restStart
                while (scanI < methodSym.length) {
                    if (aotSlice(methodSym, scanI, 1) == "_") {
                        underscorePos = scanI
                        break
                    }
                    scanI = scanI + 1
                }
                if (underscorePos > restStart) {
                    val clsName: String = aotSlice(methodSym, restStart, underscorePos - restStart)
                    val methodName: String = aotSlice(methodSym, underscorePos + 1, methodSym.length)
                    val auraName: String = sanitizeLlvm(clsName + "." + methodName)
                    val auraSig: String = this.funcSignatureOf(auraName)
                    if (auraSig != "") {
                        return aotFieldAt(auraSig, 1, "|")
                    }
                }
                sym = methodSym
            }
            val sig: String = this.callSig(sym)
            if (sig != "") {
                return aotFieldAt(sig, 0, "|")
            }
            return "i32"
        }
        if (hir.tyOf(id) != "") {
            val m: String = this.mapTy(hir.tyOf(id))
            if (m != "" && m != "void") {
                return m
            }
        }
        return "i32"
    }

    // ── 类型映射与转换 ──

    /// 解析类型别名（`typealias Answer = Int` → `Answer` → `Int`），带环保护。
    fun resolveAlias(ty: String): String {
        var cur: String = ty
        var guard: Int = 0
        while (guard < 8) {
            val n: Int = aotLineCount(this.fTypeAliases)
            var found: String = ""
            var i: Int = 0
            while (i < n) {
                val line: String = aotLineAt(this.fTypeAliases, i)
                if (aotFieldAt(line, 0, "|") == cur) {
                    found = aotFieldAt(line, 1, "|")
                }
                i = i + 1
            }
            if (found == "") {
                return cur
            }
            cur = found
            guard = guard + 1
        }
        return cur
    }

    /// 发射器内部类型映射：String 统一为 `i8*`（对齐 C ABI），其余走 TypeMapper。
    fun mapTy(ty: String): String {
        if (ty == "") {
            return ""
        }
        // typealias：先解析别名再映射（否则 `Answer` 会落到 `%struct.Answer` 占位）
        val resolved: String = this.resolveAlias(ty)
        if (resolved != ty) {
            return this.mapTy(resolved)
        }
        // 定长数组 `T[N]` → `[N x T']`（可叠加多维；N 须为字面量）
        val lb: Int = EmitUtils.aotIndexOfSub(ty, "[")
        if (lb > 0 && ty.endsWith("]")) {
            val elemNamed: String = aotSlice(ty, 0, lb)
            val dimStr: String = aotSlice(ty, lb + 1, ty.length - lb - 2)
            val elemTy: String = this.mapTy(elemNamed)
            val n: Int = aotToInt(dimStr)
            if (elemTy != "" && n > 0) {
                return "[" + toStr(n) + " x " + elemTy + "]"
            }
        }
        if (ty == "String") {
            return "i8*"
        }
        // 可空类型 `T?`：标量包装为 `{ T, i1 }`（i1=true 表示 null），
        // 非标量（如 String? → i8*）沿用内部类型。
        if (ty.endsWith("?")) {
            val inner: String = aotSlice(ty, 0, ty.length - 1)
            val innerTy: String = this.mapTy(inner)
            if (llvmIsScalar(innerTy)) {
                return "{ " + innerTy + ", i1 }"
            }
            return innerTy
        }
        // 泛型类型参数（`fun <T> f(x: T)`）：AOT 不做单态化，统一按 Any（i8*）表示。
        // 否则会落到 `%struct.T*` 占位类型，生成 `call %struct.T* @f(%struct.T* 5)` 非法 IR。
        if (ty.length == 1 && ty != aotToLower(ty)) {
            return "i8*"
        }
        val m: String = this.tm.map(ty)
        if (m == "void") {
            return ""
        }
        return m
    }

    /// 判断是否为 std 类静态调用（`Math.sin(x)` 形态）。
    ///
    /// HIR 把 `Math.sin(x)` 降级为 `HirCall text="sin"`，kids[0] 是
    /// `HirMember("sin", [HirVar("Math")])`。若接收者是已知 std 类名，
    /// 视为「类静态调用」，符号为 `aura_lang_std_<Class>_<method>`。
    /// 返回类名；非静态调用返回 ""。
    fun stdClassReceiver(hir: Hir, kids: String, n: Int, argStart: Int): String {
        if (argStart != 0 || n < 1) {
            return ""
        }
        val calleeId: Int = hirKidsAt(kids, 0)
        val ck: String = hir.kindOf(calleeId)
        // 形态 A：kids[0] 直接是接收者（当前 HIR：成员调用把接收者降级为 kids[0]）
        // 支持 HirVar（变量）、HirIdent（标识符，如 String/Math）
        if (ck == "HirVar" || ck == "HirIdent") {
            val nm: String = hir.textOf(calleeId)
            val cn: String = canonicalStdReceiver(nm)
            if (cn != "") {
                return cn
            }
            return ""
        }
        // 形态 B（历史）：kids[0] 是 HirMember，其 kids[0] 才是接收者
        if (ck == "HirMember") {
            // 成员链的**最后一段**本身就是包/类名（`aura.fs` 的成员名是 `fs`）：
            // 源码里旧包名调用（`aura.fs.exists(p)`）走的就是这条，先按它查。
            val mself: String = hir.textOf(calleeId)
            val cnSelf: String = canonicalStdReceiver(mself)
            if (cnSelf != "") {
                return cnSelf
            }
            val mk: String = hir.kidsOf(calleeId)
            if (hirKidsCount(mk) < 1) {
                return ""
            }
            val recvId: Int = hirKidsAt(mk, 0)
            val rk: String = hir.kindOf(recvId)
            // 支持 HirVar 和 HirIdent
            if (rk == "HirVar" || rk == "HirIdent") {
                val nm2: String = hir.textOf(recvId)
                val cn2: String = canonicalStdReceiver(nm2)
                if (cn2 != "") {
                    return cn2
                }
            }
        }
        return ""
    }

    /// 从**已缓存**的三张表按 runtime → C FFI → prelude 顺序查询调用点签名
    /// （等价 `callSignature`，但不再重建任何表）。
    fun callSig(name: String): String {
        if (!name.startsWith("aura_")) {
            return ""
        }
        val rt: String = tableSignature(this.fRtTable, name)
        if (rt != "") {
            return rt
        }
        val cf: String = tableSignature(this.fCffiTable, name)
        if (cf != "") {
            return cf
        }
        return tableSignature(this.fPreTable, name)
    }

    /// 查询模块内用户函数签名（未命中返回 ""）。
    ///
    /// 性能：表存为 `List`，用 `startsWith(name + "|")` 前缀匹配。此前的
    /// `split("\n")` 每次查询都要分配整张签名表——调用点数量是数万级，
    /// 无 GC 时累计可泄漏到十几 GB（自举"内存一直涨"的主因）。
    /// 按「实参数」查询用户函数签名（用于**构造函数重载**消歧）。
    ///
    /// `argCount` 为不含 self 的实参数；签名表的形参表含 self，
    /// 因此匹配条件是 `形参数 == argCount + 1`。未命中返回 ""。
    fun funcSignatureArity(name: String, argCount: Int): String {
        if (name == "") {
            return ""
        }
        var i: Int = 0
        while (i < this.fSigNames.size) {
            if (this.fSigNames[i] == name) {
                val s: String = this.fSigList[i]
                if (aotCsvCount(aotFieldAt(s, 2, "|")) == argCount + 1) {
                    return s
                }
            }
            i = i + 1
        }
        // 构造函数重载：`init` 函数名带数字后缀（如 `Runtime_init1`），
        // 但调用点查的是 `Runtime_init`（无后缀）。按后缀 1-9 依次尝试匹配。
        if (name.endsWith("_init")) {
            var k: Int = 1
            while (k <= 9) {
                val suffixed: String = name + toStr(k)
                var j: Int = 0
                while (j < this.fSigNames.size) {
                    if (this.fSigNames[j] == suffixed) {
                        val s: String = this.fSigList[j]
                        if (aotCsvCount(aotFieldAt(s, 2, "|")) == argCount + 1) {
                            return s
                        }
                    }
                    j = j + 1
                }
                k = k + 1
            }
        }
        return ""
    }

    fun funcSignatureOf(name: String): String {
        if (name == "") {
            return ""
        }
        // 并行键列 `fSigNames` 用 `==` 精确比较：等价于旧的 `startsWith(name + "|")`，
        // 但不再为每次查询分配针串。
        var i: Int = 0
        while (i < this.fSigNames.size) {
            if (this.fSigNames[i] == name) {
                return this.fSigList[i]
            }
            i = i + 1
        }
        return ""
    }

    /// 登记一条函数签名：三张并行表（`fSigNames` / `fSigList` / `fSigAuraRets`）
    /// 必须同步追加，否则按下标取 Aura 返回类型会错位。
    fun registerSig(name: String, sig: String, auraRet: String) {
        if (name == "" || sig == "") {
            return
        }
        this.fSigList.add(sig)
        this.fSigNames.add(name)
        this.fSigAuraRets.add(auraRet)
    }

    /// 用户函数的 **Aura** 返回类型（未登记返回 ""）。
    fun auraRetTyOf(name: String): String {
        if (name == "") {
            return ""
        }
        var i: Int = 0
        while (i < this.fSigNames.size) {
            if (this.fSigNames[i] == name) {
                return this.fSigAuraRets[i]
            }
            i = i + 1
        }
        return ""
    }

    /// 把任意标量/指针值转换为分支可用的 `i1`（条件上下文）。
    ///
    /// 说明：C 运行库的谓词类调用点（`String.contains/startsWith/endsWith` 等）
    /// 返回 `i32`（与 C 的 `int` 一致），而 LLVM 的 `br` 需要 `i1`；直接使用会导致
    /// `'%var' defined with type 'i32' but expected 'i1'`，故统一在此收敛。
    fun toI1(v: String, ty: String): String {
        if (ty == "i1") {
            return v
        }
        if (ty == "i8*" || ty == "ptr" || ty.endsWith("*")) {
            val t: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(t)
            this.fBody.sbAdd(" = icmp ne ")
            this.fBody.sbAdd(ty)
            this.fBody.sbAdd(" ")
            this.fBody.sbAdd(v)
            this.fBody.sbAdd(", null\n")
            return t
        }
        if (EmitUtils.intWidth(ty) > 0) {
            val t: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(t)
            this.fBody.sbAdd(" = icmp ne ")
            this.fBody.sbAdd(ty)
            this.fBody.sbAdd(" ")
            this.fBody.sbAdd(v)
            this.fBody.sbAdd(", 0\n")
            return t
        }
        if (ty == "float" || ty == "double") {
            val t: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(t)
            this.fBody.sbAdd(" = fcmp one ")
            this.fBody.sbAdd(ty)
            this.fBody.sbAdd(" ")
            this.fBody.sbAdd(v)
            this.fBody.sbAdd(", 0.0\n")
            return t
        }
        return v
    }

    /// 把一个值从 fromTy 转换为 toTy（整型宽度/浮点宽度/整数↔浮点/可空结构体；其余原样返回）。
    fun coerceValue(v: String, fromTy: String, toTy: String): String {
        // 防御：调用方可能传入带空格的类型（签名表是 `i8*, i64` 形式），
        // 否则下面的 `intWidth`/`isFloatTy` 全部失配 → 静默不插入转换指令。
        val ft: String = trimSpaces(fromTy)
        val tt: String = trimSpaces(toTy)
        if (ft != fromTy || tt != toTy) {
            return this.coerceValue(v, ft, tt)
        }
        // 指针目标 + 常量 `0`（未解析/空值表达式）→ `null`：
        // LLVM 不接受 `<ptrty> 0` 作为常量操作数（llc 报
        // `integer/byte constant must have integer/byte type`）。
        if (v == "0" && (tt == "i8*" || tt == "ptr" || tt.endsWith("*"))) {
            return "null"
        }
        // 目标为可空结构体 `{ T, i1 }`：null → { zero, true }；非空 → 包装为 { v, false }
        if (EmitUtils.isNullableStructTy(toTy)) {
            val inner: String = EmitUtils.nullableInnerTy(toTy)
            if (v == "null" || fromTy == "null") {
                return "{ " + inner + " " + EmitUtils.defaultValue(inner) + ", i1 true }"
            }
            if (EmitUtils.isNullableStructTy(fromTy)) {
                return v
            }
            return this.wrapNullable(this.coerceValue(v, fromTy, inner), inner, toTy)
        }
        // 源为可空结构体、目标为非可空：提取内部值
        if (EmitUtils.isNullableStructTy(fromTy) && !EmitUtils.isNullableStructTy(toTy)) {
            if (v == "null") {
                return EmitUtils.defaultValue(toTy)
            }
            val inner: String = EmitUtils.nullableInnerTy(fromTy)
            val t: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(t)
            this.fBody.sbAdd(" = extractvalue ")
            this.fBody.sbAdd(fromTy)
            this.fBody.sbAdd(" ")
            this.fBody.sbAdd(v)
            this.fBody.sbAdd(", 0\n")
            return this.coerceValue(t, inner, toTy)
        }
        if (toTy == "" || fromTy == toTy) {
            return v
        }
        // 浮点宽度 / 整数↔浮点
        if (EmitUtils.isFloatTy(fromTy) || EmitUtils.isFloatTy(toTy)) {
            if (EmitUtils.isFloatTy(fromTy) && EmitUtils.isFloatTy(toTy)) {
                val t: String = this.freshVar()
                var op: String = "fptrunc"
                if (toTy == "double") {
                    op = "fpext"
                }
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(t)
                this.fBody.sbAdd(" = ")
                this.fBody.sbAdd(op)
                this.fBody.sbAdd(" ")
                this.fBody.sbAdd(fromTy)
                this.fBody.sbAdd(" ")
                this.fBody.sbAdd(v)
                this.fBody.sbAdd(" to ")
                this.fBody.sbAdd(toTy)
                this.fBody.sbAdd("\n")
                return t
            }
            if (EmitUtils.isFloatTy(fromTy) && EmitUtils.intWidth(toTy) > 0) {
                // 浮点 → 整数：fptosi 到 i64，再按目标宽度截断
                val i64v: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(i64v)
                this.fBody.sbAdd(" = fptosi ")
                this.fBody.sbAdd(fromTy)
                this.fBody.sbAdd(" ")
                this.fBody.sbAdd(v)
                this.fBody.sbAdd(" to i64\n")
                if (toTy == "i64") {
                    return i64v
                }
                val t: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(t)
                this.fBody.sbAdd(" = trunc i64 ")
                this.fBody.sbAdd(i64v)
                this.fBody.sbAdd(" to ")
                this.fBody.sbAdd(toTy)
                this.fBody.sbAdd("\n")
                return t
            }
            if (EmitUtils.intWidth(fromTy) > 0 && EmitUtils.isFloatTy(toTy)) {
                val t: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(t)
                this.fBody.sbAdd(" = sitofp ")
                this.fBody.sbAdd(fromTy)
                this.fBody.sbAdd(" ")
                this.fBody.sbAdd(v)
                this.fBody.sbAdd(" to ")
                this.fBody.sbAdd(toTy)
                this.fBody.sbAdd("\n")
                return t
            }
            if (EmitUtils.isFloatTy(fromTy) && (toTy == "i8*" || toTy == "ptr")) {
                // 浮点 → 指针（Any 槽）：按位转换（double 位模式 → inttoptr），保证 IR 合法
                var dv: String = v
                if (fromTy == "float") {
                    val ext: String = this.freshVar()
                    this.fBody.sbAdd("  ")
                    this.fBody.sbAdd(ext)
                    this.fBody.sbAdd(" = fpext float ")
                    this.fBody.sbAdd(v)
                    this.fBody.sbAdd(" to double\n")
                    dv = ext
                }
                val bits: String = this.freshVar()
                val pt: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(bits)
                this.fBody.sbAdd(" = bitcast double ")
                this.fBody.sbAdd(dv)
                this.fBody.sbAdd(" to i64\n")
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(pt)
                this.fBody.sbAdd(" = inttoptr i64 ")
                this.fBody.sbAdd(bits)
                this.fBody.sbAdd(" to i8*\n")
                return pt
            }
        }
        val fw: Int = EmitUtils.intWidth(fromTy)
        val tw: Int = EmitUtils.intWidth(toTy)
        // 整数 ↔ 指针（Any / i8* 槽）：直接 `store i8* 1` 不是合法 IR，需显式转换。
        // 必须是 **Plan A 低位标记装箱** `(v<<1)|1`（与 `boxToPtr` / 集合元素 /
        // Rust AOT 后端一致）：拆箱侧（`aura_to_int_any` / `aura_to_str_any`）按低位
        // 标记区分整数与真实指针；若此处发裸 `inttoptr`，偶数地址会被当字符串指针
        // 解引用（`println(identity(42))` 直接崩溃）。
        // 单字符字符串 → `Char`（i16）：**取首字节的字符码**，不能走 Plan A 拆箱。
        //
        // `Char` 在 AOT 下是 `i16` 整数，而 `s[i]` / `s.charAt(i)` 的值是**单字符
        // 字符串**（`i8*`）。此时若按 Plan A 拆箱（`(v>>1)`），字符串指针是偶数
        // 地址 → 解出 0，于是 `val c: Char = p.charAt(i)` 恒为 0、
        // `c == "/"` 恒假（`aotBaseDirFromInput` 因此拿不到目录，runtime/*.ll
        // 定位失败，整个 AOT 链路静默产出错误产物）。
        if ((fromTy == "i8*" || fromTy == "ptr") && toTy == "i16") {
            val lzb: String = "chc_" + toStr(this.fVarSeq)
            val lzv: String = "chc_" + toStr(this.fVarSeq) + "_v"
            val lze: String = "chc_" + toStr(this.fVarSeq) + "_e"
            this.fVarSeq = this.fVarSeq + 1
            val pn: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(pn)
            this.fBody.sbAdd(" = icmp eq i8* ")
            this.fBody.sbAdd(v)
            this.fBody.sbAdd(", null\n")
            this.fBody.sbAdd("  br i1 ")
            this.fBody.sbAdd(pn)
            this.fBody.sbAdd(", label %")
            this.fBody.sbAdd(lzb)
            this.fBody.sbAdd(", label %")
            this.fBody.sbAdd(lzv)
            this.fBody.sbAdd("\n")
            this.fBody.sbAdd(lzb)
            this.fBody.sbAdd(":\n  br label %")
            this.fBody.sbAdd(lze)
            this.fBody.sbAdd("\n")
            this.fBody.sbAdd(lzv)
            this.fBody.sbAdd(":\n")
            val bv: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(bv)
            this.fBody.sbAdd(" = load i8, i8* ")
            this.fBody.sbAdd(v)
            this.fBody.sbAdd("\n")
            val bc: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(bc)
            this.fBody.sbAdd(" = zext i8 ")
            this.fBody.sbAdd(bv)
            this.fBody.sbAdd(" to i16\n")
            this.fBody.sbAdd("  br label %")
            this.fBody.sbAdd(lze)
            this.fBody.sbAdd("\n")
            this.fBody.sbAdd(lze)
            this.fBody.sbAdd(":\n")
            val rv: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(rv)
            this.fBody.sbAdd(" = phi i16 [ 0, %")
            this.fBody.sbAdd(lzb)
            this.fBody.sbAdd(" ], [ ")
            this.fBody.sbAdd(bc)
            this.fBody.sbAdd(", %")
            this.fBody.sbAdd(lzv)
            this.fBody.sbAdd(" ]\n")
            return rv
        }

        if ((toTy == "i8*" || toTy == "ptr") && fw > 0) {
            // `i64` → `i8*`：值是**地址/句柄**（`Long` 承载指针，如
            // `StringBuilder.finish(h)` → 字符串、`Collections.getAt` 已是装箱指针），
            // 直接 `inttoptr`。
            //
            // 不能按 Plan A 装箱 `(v<<1)|1`：那会把指针变成奇数地址，后续
            // `strlen` / 拷贝读到垃圾 → 访问违例（`EmitBuffer.sbBuild()` 就死在这里）。
            // 只有窄整型（i32/i1/i16/i8，语言层的 Int/Boolean/…）才需要装箱。
            if (fw == 64) {
                val t64: String = this.freshVar()
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(t64)
                this.fBody.sbAdd(" = inttoptr i64 ")
                this.fBody.sbAdd(v)
                this.fBody.sbAdd(" to ")
                this.fBody.sbAdd(toTy)
                this.fBody.sbAdd("\n")
                return t64
            }
            return this.boxToPtr(v, fromTy)
        }
        if ((fromTy == "i8*" || fromTy == "ptr") && tw > 0) {
            val t: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(t)
            this.fBody.sbAdd(" = ptrtoint i8* ")
            this.fBody.sbAdd(v)
            this.fBody.sbAdd(" to i64\n")
            // `i8*` → **i64**：目标是「Long 承载地址/句柄」的槽位
            //（如 `StringBuilder.append(h, s)` 的 `text: Long`、`Memory.*` 的地址），
            // 直接 `ptrtoint` 即可。
            // 若按 Plan A 拆箱，偶数地址（真实指针）会解出 0 —— `out.sbAdd(funcParts.sbBuild())`
            // 因此把拼装内容整体丢弃（实测最终 IR 长度为 0）。
            if (tw == 64) {
                return t
            }
            // Plan A 内联拆箱：低位为 1 → 整数 (v>>1)；低位为 0 → 指针 → 0
            val low: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(low)
            this.fBody.sbAdd(" = and i64 ")
            this.fBody.sbAdd(t)
            this.fBody.sbAdd(", 1\n")
            val isInt: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(isInt)
            this.fBody.sbAdd(" = icmp ne i64 ")
            this.fBody.sbAdd(low)
            this.fBody.sbAdd(", 0\n")
            val lblInt: String = "pab_" + toStr(this.fVarSeq)
            val lblPtr: String = "pab_" + toStr(this.fVarSeq) + "_p"
            val lblEnd: String = "pab_" + toStr(this.fVarSeq) + "_e"
            this.fVarSeq = this.fVarSeq + 1
            this.fBody.sbAdd("  br i1 ")
            this.fBody.sbAdd(isInt)
            this.fBody.sbAdd(", label %")
            this.fBody.sbAdd(lblInt)
            this.fBody.sbAdd(", label %")
            this.fBody.sbAdd(lblPtr)
            this.fBody.sbAdd("\n")
            this.fBody.sbAdd(lblInt)
            this.fBody.sbAdd(":\n")
            val unboxedInt: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(unboxedInt)
            this.fBody.sbAdd(" = lshr i64 ")
            this.fBody.sbAdd(t)
            this.fBody.sbAdd(", 1\n")
            this.fBody.sbAdd("  br label %")
            this.fBody.sbAdd(lblEnd)
            this.fBody.sbAdd("\n")
            this.fBody.sbAdd(lblPtr)
            this.fBody.sbAdd(":\n")
            this.fBody.sbAdd("  br label %")
            this.fBody.sbAdd(lblEnd)
            this.fBody.sbAdd("\n")
            this.fBody.sbAdd(lblEnd)
            this.fBody.sbAdd(":\n")
            val u: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(u)
            this.fBody.sbAdd(" = phi i64 [ ")
            this.fBody.sbAdd(unboxedInt)
            this.fBody.sbAdd(", %")
            this.fBody.sbAdd(lblInt)
            this.fBody.sbAdd(" ], [ 0, %")
            this.fBody.sbAdd(lblPtr)
            this.fBody.sbAdd(" ]\n")
            return this.coerceValue(u, "i64", toTy)
        }
        // 具名指针类型（`%struct.X*` 等）：整数 ↔ 指针用裸 `inttoptr` / `ptrtoint`。
        // 缺此分支时（如未解析调用返回的 `0`/i32 值被当作类实例指针返回）会生成
        // `ret %struct.X* <i32 var>` 之类的非法 IR（llc: defined with type 'i32'
        // but expected 'ptr'）。
        if (toTy.endsWith("*") && fw > 0) {
            val iv: String = this.coerceValue(v, fromTy, "i64")
            val pt: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(pt)
            this.fBody.sbAdd(" = inttoptr i64 ")
            this.fBody.sbAdd(iv)
            this.fBody.sbAdd(" to ")
            this.fBody.sbAdd(toTy)
            this.fBody.sbAdd("\n")
            return pt
        }
        if (fromTy.endsWith("*") && tw > 0) {
            val t: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(t)
            this.fBody.sbAdd(" = ptrtoint ")
            this.fBody.sbAdd(fromTy)
            this.fBody.sbAdd(" ")
            this.fBody.sbAdd(v)
            this.fBody.sbAdd(" to i64\n")
            return this.coerceValue(t, "i64", toTy)
        }
        if (fw > 0 && tw > 0 && fw != tw) {
            val t: String = this.freshVar()
            if (tw > fw) {
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(t)
                this.fBody.sbAdd(" = sext ")
                this.fBody.sbAdd(fromTy)
                this.fBody.sbAdd(" ")
                this.fBody.sbAdd(v)
                this.fBody.sbAdd(" to ")
                this.fBody.sbAdd(toTy)
                this.fBody.sbAdd("\n")
            } else {
                this.fBody.sbAdd("  ")
                this.fBody.sbAdd(t)
                this.fBody.sbAdd(" = trunc ")
                this.fBody.sbAdd(fromTy)
                this.fBody.sbAdd(" ")
                this.fBody.sbAdd(v)
                this.fBody.sbAdd(" to ")
                this.fBody.sbAdd(toTy)
                this.fBody.sbAdd("\n")
            }
            return t
        }
        return v
    }

    /// 把内部值包装为可空结构体 `{ T, i1 }`（i1=false 表示非空）。
    fun wrapNullable(v: String, inner: String, structTy: String): String {
        val w0: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(w0)
        this.fBody.sbAdd(" = insertvalue ")
        this.fBody.sbAdd(structTy)
        this.fBody.sbAdd(" undef, ")
        this.fBody.sbAdd(inner)
        this.fBody.sbAdd(" ")
        this.fBody.sbAdd(v)
        this.fBody.sbAdd(", 0\n")
        val w1: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(w1)
        this.fBody.sbAdd(" = insertvalue ")
        this.fBody.sbAdd(structTy)
        this.fBody.sbAdd(" ")
        this.fBody.sbAdd(w0)
        this.fBody.sbAdd(", i1 false, 1\n")
        return w1
    }


    fun commonNumTy(a: String, b: String): String {
        if (a == "" || b == "") {
            return "i32"
        }
        if (a == b) {
            return a
        }
        if (a == "double" || b == "double") {
            return "double"
        }
        if (a == "float" || b == "float") {
            return "float"
        }
        val aw: Int = EmitUtils.intWidth(a)
        val bw: Int = EmitUtils.intWidth(b)
        if (aw > 0 && bw > 0) {
            if (aw >= bw) {
                return a
            }
            return b
        }
        return a
    }

    // ── 局部变量表 ──

    /// 声明局部变量（同名**同类型**已声明则复用 alloca）。
    ///
    /// **同名不同类型**必须另开槽位。旧实现只要名字存在就返回旧槽（连同旧类型），
    /// 于是 `if (…) { val lit: Int = … }` 之后的 `val lit: String = …`：
    ///   ① store 用**新**类型写**旧**槽（i8* 存进 i32* → 类型错配的 bitcast store）；
    ///   ② 后续 load 按**旧**类型读取 —— i8* 只取低 32 位，再被 Plan A 整数装箱
    ///      `(v<<1)|1` 变成野指针。
    /// 编译器自身 `Parser.parsePrimary` 正是这种写法，实测 Aura 发射器产物
    /// 在 `prsIsWordLiteral` 里 `strlen(-1)` 崩溃（ASan: access-violation @1）。
    /// 查找同时改为**取最后一次声明**（见 `fvField`），使后声明/内层遮蔽生效。
    fun declareVar(name: String, ty: String): String {
        val existing: String = this.lookupVarAddr(name)
        if (existing != "") {
            if (this.lookupVarTy(name) == ty) {
                return existing
            }
            // 遮蔽：另开唯一槽位（LLVM 不允许同函数内 alloca 重名）
            this.fVarSlotSeq = this.fVarSlotSeq + 1
            val addrSh: String = "%" + sanitizeLlvm(name) + ".addr"
                + toStr(this.fVarSlotSeq)
            this.fAlloca.sbAdd("  ")
            this.fAlloca.sbAdd(addrSh)
            this.fAlloca.sbAdd(" = alloca ")
            this.fAlloca.sbAdd(ty)
            this.fAlloca.sbAdd("\n")
            this.fVarList.add(name + "|" + addrSh + "|" + ty)
            this.fVarNames.add(name)
            return addrSh
        }
        val addr: String = "%" + sanitizeLlvm(name) + ".addr"
        this.fAlloca.sbAdd("  ")
        this.fAlloca.sbAdd(addr)
        this.fAlloca.sbAdd(" = alloca ")
        this.fAlloca.sbAdd(ty)
        this.fAlloca.sbAdd("\n")
        this.fVarList.add(name + "|" + addr + "|" + ty)
        this.fVarNames.add(name)
        return addr
    }

    /// 查询局部变量地址（未声明返回 ""）。
    fun lookupVarAddr(name: String): String {
        return this.fvField(name, 1)
    }

    /// 查询局部变量类型（未声明返回 ""）。
    fun lookupVarTy(name: String): String {
        return this.fvField(name, 2)
    }

    // ── 集合（List/Array/Set/Map）辅助 ──

    /// 登记一个集合类型的局部变量（默认元素类型 `i32`）。
    fun markListVar(name: String) {
        this.markListVarTyped(name, "i32")
    }

    /// 登记一个集合类型的局部变量，并记录元素 LLVM 类型（`name|elemTy`）。
    fun markListVarTyped(name: String, elemTy: String) {
        if (name == "" || this.isListVar(name)) {
            return
        }
        this.fListVars = this.fListVars + name + "|" + elemTy + "\n"
    }

    /// 该局部变量是否为集合（List/Array/Set/Map）。
    fun isListVar(name: String): Boolean {
        var n: Int = aotLineCount(this.fListVars)
        var i: Int = 0
        while (i < n) {
            if (aotFieldAt(aotLineAt(this.fListVars, i), 0, "|") == name) {
                return true
            }
            i = i + 1
        }
        return false
    }

    /// 集合局部变量的元素 LLVM 类型（未登记返回 `i32`）。
    fun listElemTy(name: String): String {
        var n: Int = aotLineCount(this.fListVars)
        var i: Int = 0
        while (i < n) {
            val line: String = aotLineAt(this.fListVars, i)
            if (aotFieldAt(line, 0, "|") == name) {
                val e: String = aotFieldAt(line, 1, "|")
                if (e != "") {
                    return e
                }
                return "i32"
            }
            i = i + 1
        }
        return "i32"
    }

    /// 集合构造器名（0 参形式返回空列表）。
    fun isCollectionCtor(name: String): Boolean {
        val bare: String = aotLastSegment(name)
        return bare == "arrayListOf" || bare == "mutableListOf" || bare == "listOf"
            || bare == "emptyList" || bare == "arrayOf" || bare == "mutableSetOf"
            || bare == "setOf" || bare == "mutableMapOf" || bare == "mapOf"
    }

    /// 该 HIR 节点是否为集合构造调用（用于类型推断与变量登记）。
    fun isCollectionCtorCall(hir: Hir, id: Int): Boolean {
        if (id < 0 || id >= hir.count || hir.kindOf(id) != "HirCall") {
            return false
        }
        val kids: String = hir.kidsOf(id)
        var fname: String = hir.textOf(id)
        if (fname == "" && hirKidsCount(kids) > 0) {
            fname = hir.textOf(hirKidsAt(kids, 0))
        }
        return this.isCollectionCtor(fname)
    }

    /// 把任意值转换为 C 字符串 `i8*`（数值走 `aura_to_str*`，字符串原样）。
    fun valueToStr(v: String, ty: String): String {
        if (ty == "i8*" || ty == "ptr") {
            // i8* 可能是装箱整数（Plan A 奇地址），Aura toStr(Any) 统一解码
            // 未解析调用回退产生的是整型常量 `0`，不能直接当指针实参
            //（`call i8* @toStr(i8* 0)` → llc: integer/byte constant ...）。
            var pv: String = v
            if (pv == "0") {
                pv = "null"
            }
            val t: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(t)
            this.fBody.sbAdd(" = call i8* @toStr(i8* ")
            this.fBody.sbAdd(pv)
            this.fBody.sbAdd(")\n")
            return t
        }
        if (ty == "float" || ty == "double") {
            val dv: String = this.coerceValue(v, ty, "double")
            // 内联 _snprintf 替换 aura_to_str_float
            val buf: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(buf)
            this.fBody.sbAdd(" = call i8* @malloc(i64 64)\n")
            this.fBody.sbAdd("  call i32 @snprintf(i8* ")
            this.fBody.sbAdd(buf)
            this.fBody.sbAdd(", i64 64, i8* @fmt_float_g, double ")
            this.fBody.sbAdd(dv)
            this.fBody.sbAdd(")\n")
            return buf
        }
        if (ty == "i1") {
            val bv: String = this.coerceValue(v, ty, "i64")
            val boxed: String = this.boxToPtr(bv, "i64")
            val bt: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(bt)
            this.fBody.sbAdd(" = call i8* @toStr(i8* ")
            this.fBody.sbAdd(boxed)
            this.fBody.sbAdd(")\n")
            return bt
        }
        val iv: String = this.coerceValue(v, ty, "i64")
        val boxedInt: String = this.boxToPtr(iv, "i64")
        val it: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(it)
        this.fBody.sbAdd(" = call i8* @toStr(i8* ")
        this.fBody.sbAdd(boxedInt)
        this.fBody.sbAdd(")\n")
        return it
    }

    /// 实参转换：集合调用点（`Collections.*`）的 `i8*` 元素参数需按 Plan A
    /// **装箱**（整数 → `(v<<1)|1`）。否则 `list.indexOf(30)` 会把裸整数
    /// 当指针解引用 → 访问违例（0xC0000005）。
    fun coerceArg(sym: String, v: String, fromTy: String, wantTy: String): String {
        if (wantTy == "i8*" && (sym.startsWith("aura_lang_std_Collections_") || sym.startsWith("Collections_"))
            && !fromTy.endsWith("*") && fromTy != "i8*" && fromTy != "ptr" && fromTy != "") {
            return this.boxToPtr(v, fromTy)
        }
        return this.coerceValue(v, fromTy, wantTy)
    }

    /// 把值装箱为 `i8*` 句柄存入集合（Plan A 低位标记：整数 → `(v<<1)|1`）。
    fun boxToPtr(v: String, ty: String): String {
        if (ty == "i8*" || ty == "ptr") {
            return v
        }
        // 具名指针类型（`%struct.ArrayList_V_*` 等）：本身已经是句柄，
        // 只需 bitcast 到 `i8*`。旧实现走整数装箱分支，生成
        // `shl i64 <ptr>` 非法 IR。
        if (ty.endsWith("*")) {
            val bt: String = this.freshVar()
            this.fBody.sbAdd("  ")
            this.fBody.sbAdd(bt)
            this.fBody.sbAdd(" = bitcast ")
            this.fBody.sbAdd(ty)
            this.fBody.sbAdd(" ")
            this.fBody.sbAdd(v)
            this.fBody.sbAdd(" to i8*\n")
            return bt
        }
        if (ty == "float" || ty == "double") {
            // 浮点先转字符串（集合元素统一为 i8* 句柄）
            return this.valueToStr(v, ty)
        }
        val iv: String = this.coerceValue(v, ty, "i64")
        val sh: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(sh)
        this.fBody.sbAdd(" = shl i64 ")
        this.fBody.sbAdd(iv)
        this.fBody.sbAdd(", 1\n")
        val tg: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(tg)
        this.fBody.sbAdd(" = or i64 ")
        this.fBody.sbAdd(sh)
        this.fBody.sbAdd(", 1\n")
        val t: String = this.freshVar()
        this.fBody.sbAdd("  ")
        this.fBody.sbAdd(t)
        this.fBody.sbAdd(" = inttoptr i64 ")
        this.fBody.sbAdd(tg)
        this.fBody.sbAdd(" to i8*\n")
        return t
    }

    /// 在函数局部变量表中查找某个变量的指定字段。
    ///
    /// 前缀匹配、零分配：变量查找是发射期最热路径，`split("\n")` 每次都要
    /// 分配整张表（无 GC 下泄漏严重，6.5.10 自举时的主要瓶颈之一）。
    fun fvField(name: String, col: Int): String {
        if (name == "") {
            return ""
        }
        // 并行键列 `fVarNames` 用 `==` 精确比较：等价于旧的 `startsWith(name + "|")`，
        // 但不再为每次变量查询分配针串（变量查询是发射期最热路径）。
        //
        // **从后往前**匹配：同名遮蔽时取最后一次声明（内层/后声明优先）。
        // 首匹配会让先声明的旧类型赢，与 `declareVar` 新开的槽位不匹配。
        var i: Int = this.fVarNames.size - 1
        while (i >= 0) {
            if (this.fVarNames[i] == name) {
                return aotFieldAt(this.fVarList[i], col, "|")
            }
            i = i - 1
        }
        return ""
    }
}

object EmitUtils {



    /// 顶层入口：HIR → LLVM IR 文本。
    fun emitLlvmIr(hir: Hir, moduleName: String, target: String): String {
        return emitLlvmIrEx(hir, moduleName, target, "")
    }

    fun emitLlvmIrEx(hir: Hir, moduleName: String, target: String, basePath: String): String {
        val e: LlvmEmitter = LlvmEmitter()
        // 必须调用 **emitProgramEx**（含 `basePath`）。旧实现写 `e.emitProgram(hir,
        // moduleName, target, basePath)` —— `emitProgram` 只有 3 个形参，多出的
        // `basePath` 被静默丢弃：Rust 后端忽略多余实参（basePath 恒为空，runtime/*.ll
        // 只能按 CWD 相对路径解析），而 Aura 自举产物会因**形参数不匹配**解析不到
        // 该函数 → 落到「未解析符号」回退返回 null → 后续对 IR 串的操作空指针崩溃。
        return e.emitProgramEx(hir, moduleName, target, basePath)
    }

    /// 依目标三元组选择 data layout（对齐 Rust `emit_module_header`）。
    fun dataLayout(target: String): String {
        if (target.startsWith("x86_64")) {
            return "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
        } else if (target.startsWith("aarch64")) {
            return "e-m:e-i8:8:32-i16:16:32-i32:32:64-i64:64:-n16:32:64-S128"
        } else if (target.startsWith("armv7")) {
            return "e-m:e-i8:8:32-i16:16:32-i32:32:32-i64:64:-i128:128-n32:64-S128"
        }
        return "e-m:e-i64:64-f80:128-n8:16:32:64-S128"
    }

    /// 是否为已知 std 类名（用于把 `Math.sin(x)` 识别为类静态调用）。
    /// 类型名是否为集合类型（List / Array / Set / Map 及其可变形式）。
    fun isCollectionTypeName(ty: String): Boolean {
        if (ty == "") {
            return false
        }
        if (ty.startsWith("List") || ty.startsWith("MutableList") || ty.startsWith("Array")
            || ty.startsWith("Set") || ty.startsWith("MutableSet") || ty.startsWith("Map")
            || ty.startsWith("MutableMap") || ty.startsWith("Collection")) {
            return true
        }
        return false
    }

    /// 字面量 → LLVM 类型。
    fun inferLitType(raw: String): String {
        if (raw == "true" || raw == "false") {
            return "i1"
        } else if (raw == "null") {
            return "i8*"
        } else if (raw.startsWith("\"")) {
            return "i8*"
        }
        // 进制字面量：0xFF / 0b1100（注意其末字符可能是 F，不能当浮点后缀）
        if (raw.startsWith("0x") || raw.startsWith("0X")
            || raw.startsWith("0b") || raw.startsWith("0B")) {
            val hx: String = aotSlice(raw, raw.length - 1, 1)
            if (hx == "L" || hx == "l") {
                return "i64"
            }
            return "i32"
        }
        val last: String = aotSlice(raw, raw.length - 1, 1)
        if (last == "L" || last == "l") {
            return "i64"
        } else if (last == "f" || last == "F") {
            return "float"
        } else if (last == "d" || last == "D") {
            return "double"
        } else if (raw.contains(".") || raw.contains("e") || raw.contains("E")) {
            return "double"
        }
        return "i32"
    }

    /// 是否为数字字面量（首字符为数字，或 `-` 后跟数字）。
    fun isNumericLiteral(raw: String): Boolean {
        if (raw == "") {
            return false
        }
        val c: Int = EmitUtils.charCodeOf(aotSlice(raw, 0, 1))
        if (c >= 48 && c <= 57) {
            return true
        } else if (c == 45 && raw.length > 1) {
            return true
        }
        return false
    }

    /// 是否为浮点字面量（含小数/指数/浮点后缀；进制字面量恒为整数）。
    fun isFloatLiteral(raw: String): Boolean {
        if (raw.startsWith("0x") || raw.startsWith("0X")
            || raw.startsWith("0b") || raw.startsWith("0B")) {
            return false
        }
        if (raw.contains(".") || raw.contains("e") || raw.contains("E")) {
            return true
        } else {
            val last: String = aotSlice(raw, raw.length - 1, 1)
            if (last == "f" || last == "F" || last == "d" || last == "D") {
                return true
            }
        }
        return false
    }

    /// 去掉下划线分隔符。
    fun stripUnderscores(s: String): String {
        val n: Int = s.length
        var out: String = ""
        var i: Int = 0
        while (i < n) {
            if (s.charCodeAt(i) != 95) {
                out = out + s.substring(i, i + 1)
            }
            i = i + 1
        }
        return out
    }

    /// 去掉整数/浮点字面量末尾的类型后缀（L/l/U/u/F/f/D/d）。
    fun stripNumberSuffix(s: String): String {
        var end: Int = s.length
        while (end > 0) {
            val c: String = aotSlice(s, end - 1, 1)
            if (c == "L" || c == "l" || c == "U" || c == "u"
                || c == "F" || c == "f" || c == "D" || c == "d") {
                end = end - 1
            } else {
                break
            }
        }
        return aotSlice(s, 0, end)
    }

    /// 按进制解析数字串（支持 0-9 / a-f / A-F）。
    fun parseRadixDigits(s: String, radix: Int): Int {
        val n: Int = s.length
        var v: Int = 0
        var i: Int = 0
        while (i < n) {
            val cc: Int = s.charCodeAt(i) as Int
            var d: Int = -1
            if (cc >= 48 && cc <= 57) {
                d = cc - 48
            } else if (cc >= 97 && cc <= 102) {
                d = cc - 87
            } else if (cc >= 65 && cc <= 70) {
                d = cc - 55
            }
            if (d >= 0 && d < radix) {
                v = v * radix + d
            }
            i = i + 1
        }
        return v
    }

    /// 整数/进制字面量 → 十进制文本（含符号）。
    fun normalizeNumberLiteral(raw: String): String {
        var neg: Boolean = false
        var body: String = raw
        if (body.startsWith("-")) {
            neg = true
            body = aotSlice(body, 1, body.length - 1)
        }
        val radix: Int = EmitUtils.numericRadix(body)
        if (radix != 10) {
            // 进制字面量：只允许 L/U 后缀。注意不能剥离尾部的 F/D —— 它们是十六进制数字，
            // 例如 `0xFF` 若剥掉 F 会变成 `0x`，解析成 0。
            val digits: String = EmitUtils.stripUnderscores(
                EmitUtils.stripLongSuffix(aotSlice(body, 2, body.length - 2))
            )
            val out: String = toStr(EmitUtils.parseRadixDigits(digits, radix))
            if (neg) {
                return "-" + out
            }
            return out
        }
        val out: String = EmitUtils.stripUnderscores(EmitUtils.stripNumberSuffix(body))
        if (neg) {
            return "-" + out
        }
        return out
    }

    /// 数字字面量的进制（0x→16，0b→2，否则 10）。
    fun numericRadix(s: String): Int {
        if (s.startsWith("0x") || s.startsWith("0X")) {
            return 16
        } else if (s.startsWith("0b") || s.startsWith("0B")) {
            return 2
        }
        return 10
    }

    /// 去掉进制字面量的 Long/Unsigned 后缀（L/l/U/u）。
    fun stripLongSuffix(s: String): String {
        var end: Int = s.length
        while (end > 0) {
            val c: String = aotSlice(s, end - 1, 1)
            if (c == "L" || c == "l" || c == "U" || c == "u") {
                end = end - 1
            } else {
                break
            }
        }
        return aotSlice(s, 0, end)
    }

    /// 浮点字面量 → 合法 LLVM 浮点文本（保证尾数含 `.`）。
    fun normalizeFloatLiteral(raw: String): String {
        val body: String = EmitUtils.stripUnderscores(EmitUtils.stripNumberSuffix(raw))
        // 拆分尾数与指数
        var epos: Int = -1
        val blen: Int = body.length
        var i: Int = 0
        while (i < blen) {
            val cc: Int = body.charCodeAt(i) as Int
            if (cc == 101 || cc == 69) {
                epos = i
                break
            }
            i = i + 1
        }
        var mantissa: String = body
        var expo: String = ""
        if (epos >= 0) {
            mantissa = aotSlice(body, 0, epos)
            expo = aotSlice(body, epos, body.length - epos)
        }
        if (!mantissa.contains(".")) {
            mantissa = mantissa + ".0"
        }
        return mantissa + expo
    }

    /// 是否比较运算符。
    fun isCmpOp(op: String): Boolean {
        if (op == "==" || op == "!=") {
            return true
        } else if (op == "<" || op == ">" || op == "<=" || op == ">=") {
            return true
        }
        return false
    }

    /// 比较运算符 → LLVM icmp 谓词。
    fun cmpPred(op: String): String {
        if (op == "==") { return "eq" } else if (op == "!=") { return "ne" } else if (op == "<") { return "slt" } else if (op == ">") { return "sgt" } else if (op == "<=") { return "sle" } else if (op == ">=") { return "sge" }
        return "eq"
    }

    /// 比较运算符 → LLVM fcmp 谓词（有序比较）。
    fun fcmpPred(op: String): String {
        if (op == "==") { return "oeq" } else if (op == "!=") { return "one" } else if (op == "<") { return "olt" } else if (op == ">") { return "ogt" } else if (op == "<=") { return "ole" } else if (op == ">=") { return "oge" }
        return "oeq"
    }

    /// 算术运算符 → LLVM 指令名（依操作数类型区分整/浮点）。
    fun arithInstr(op: String, ty: String): String {
        if (ty == "float" || ty == "double") {
            if (op == "+") { return "fadd" } else if (op == "-") { return "fsub" } else if (op == "*") { return "fmul" } else if (op == "/") { return "fdiv" } else if (op == "%") { return "frem" }
            return "fadd"
        }
        if (op == "+") { return "add" } else if (op == "-") { return "sub" } else if (op == "*") { return "mul" } else if (op == "/") { return "sdiv" } else if (op == "%") { return "srem" }
        return "add"
    }

    /// LLVM 类型的整型位宽（非整型返回 0）。
    fun intWidth(ty: String): Int {
        if (ty == "i1") { return 1 } else if (ty == "i8") { return 8 } else if (ty == "i16") { return 16 } else if (ty == "i32") { return 32 } else if (ty == "i64") { return 64 } else if (ty == "i128") { return 128 }
        return 0
    }

    /// 从 LLVM 定长数组类型 `[N x T]` 提取元素类型 `T`（非数组返回 ""）。
    fun llvmElemOfArrayTy(ty: String): String {
        if (!ty.startsWith("[")) {
            return ""
        }
        val x: Int = EmitUtils.aotIndexOfSub(ty, " x ")
        if (x < 0 || ty.length < x + 4) {
            return ""
        }
        // 去掉结尾的 `]`
        return aotSlice(ty, x + 3, ty.length - x - 4)
    }

    /// 在 `text` 中查找子串 `sub` 的首个下标（未找到返回 -1）。
    ///
    /// 说明：`aotFieldAt` 只支持单字符分隔符，多字符分隔需用本函数。
    fun aotIndexOfSub(text: String, sub: String): Int {
        val tl: Int = text.length
        val sl: Int = sub.length
        if (sl == 0 || sl > tl) {
            return -1
        }
        var i: Int = 0
        while (i + sl <= tl) {
            if (aotSlice(text, i, sl) == sub) {
                return i
            }
            i = i + 1
        }
        return -1
    }

    /// 是否为浮点 LLVM 类型。
    fun isFloatTy(ty: String): Boolean {
        if (ty == "float" || ty == "double") {
            return true
        }
        return false
    }

    /// 是否为可空结构体类型 `{ T, i1 }`（i1 字段表示是否 null）。
    fun isNullableStructTy(ty: String): Boolean {
        if (ty.startsWith("{ ") && ty.endsWith(" i1 }")) {
            return true
        }
        return false
    }

    /// 从可空结构体类型 `{ T, i1 }` 中提取内部类型 `T`。
    fun nullableInnerTy(ty: String): String {
        // 去掉前缀 "{ "（2 字符）与后缀 ", i1 }"（6 字符）
        return aotSlice(ty, 2, ty.length - 8)
    }

    /// 某 LLVM 类型的零值字面量（用于补齐无显式 return 的路径）。
    fun defaultValue(ty: String): String {
        // void 没有值：返回空串，调用方据此发射 `ret void` 而非 `ret void 0`
        if (ty == "void" || ty == "") { return "" } else if (ty == "float") { return "0.0" } else if (ty == "double") { return "0.0" } else if (ty == "i1") { return "false" }
        // 任意指针（含 `%struct.X*` 实例指针）零值为 null
        else if (ty == "i8*" || ty == "ptr" || ty.endsWith("*")) { return "null" } else if (ty.startsWith("{ ")) { return "zeroinitializer" }
        return "0"
    }

    /// LLVM IR 字符串常量转义。
    ///
    /// 除 `\` 与 `"` 外，**控制字符与非 ASCII 字节必须转义**：LLVM 的词法器不接受
    /// 字符串字面量里出现裸换行/制表符等字节，且转义后长度才与 `[N x i8]` 的
    /// 字节数一致（否则报
    /// `constant expression type mismatch: got type '[3 x i8]' but expected '[2 x i8]'`）。
    fun llvmEscape(s: String): String {
        // 快速路径：绝大多数字符串常量无需转义（控制字符 / `\` / `"` / 非 ASCII
        // 都不出现），此时直接返回原串，零分配。
        val n: Int = s.length
        var need: Boolean = false
        var k: Int = 0
        while (k < n && !need) {
            val c: Int = s.charCodeAt(k) as Int
            if (c < 32 || c >= 127 || c == 92 || c == 34) {
                need = true
            }
            k = k + 1
        }
        if (!need) {
            return s
        }
        // 慢路径：用缓冲区拼接。旧实现 `out = out + …` 每个字符都复制整串，
        // 对编译器源码里成百上千字符的字面量（IR 片段等）是平方级分配。
        val buf: EmitBuffer = EmitBuffer()
        var i: Int = 0
        while (i < n) {
            val code: Int = s.charCodeAt(i) as Int
            if (code == 92) {
                buf.sbAdd("\\5C")
            } else if (code == 34) {
                buf.sbAdd("\\22")
            } else if (code >= 32 && code < 127) {
                buf.sbAdd(s.substring(i, i + 1))
            } else {
                buf.sbAdd("\\")
                buf.sbAdd(EmitUtils.hexByte(code))
            }
            i = i + 1
        }
        return buf.sbBuild()
    }

    /// 字节 → 两位大写十六进制（LLVM 转义用）。
    fun hexByte(code: Int): String {
        val digits: String = "0123456789ABCDEF"
        var v: Int = code
        if (v < 0) { v = 0 }
        if (v > 255) { v = 255 }
        val hi: Int = v / 16
        val lo: Int = v % 16
        return aotSlice(digits, hi, 1) + aotSlice(digits, lo, 1)
    }

    /// 字符字面量（`'a'`）→ 字符码。非法输入返回 0。
    fun charCodeOf(raw: String): Int {
        var body: String = raw
        if (body.length >= 2 && body.charCodeAt(0) == 39) {
            body = aotSlice(body, 1, body.length - 2)
        }
        if (body == "") {
            return 0
        }
        return EmitUtils.charCodeSingle(aotSlice(body, 0, 1))
    }

    /// 单个字符 → ASCII 码（覆盖数字 / 大小写字母）。
    fun charCodeSingle(c: String): Int {
        val digits: String = "0123456789"
        var i: Int = 0
        while (i < 10) {
            if (aotSlice(digits, i, 1) == c) {
                return 48 + i
            }
            i = i + 1
        }
        val upper: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        i = 0
        while (i < 26) {
            if (aotSlice(upper, i, 1) == c) {
                return 65 + i
            }
            i = i + 1
        }
        val lower: String = "abcdefghijklmnopqrstuvwxyz"
        i = 0
        while (i < 26) {
            if (aotSlice(lower, i, 1) == c) {
                return 97 + i
            }
            i = i + 1
        }
        // 标点符号（原先只覆盖数字/字母，`'_'` 等会得到 0）
        if (c == " ") { return 32 } else if (c == "!") { return 33 } else if (c == "#") { return 35 } else if (c == "%") { return 37 } else if (c == "&") { return 38 } else if (c == "'") { return 39 } else if (c == "(") { return 40 } else if (c == ")") { return 41 } else if (c == "*") { return 42 } else if (c == "+") { return 43 } else if (c == ",") { return 44 } else if (c == "-") { return 45 } else if (c == ".") { return 46 } else if (c == "/") { return 47 } else if (c == ":") { return 58 } else if (c == ";") { return 59 } else if (c == "<") { return 60 } else if (c == "=") { return 61 } else if (c == ">") { return 62 } else if (c == "?") { return 63 } else if (c == "@") { return 64 } else if (c == "[") { return 91 } else if (c == "]") { return 93 } else if (c == "^") { return 94 } else if (c == "_") { return 95 } else if (c == "`") { return 96 } else if (c == "{") { return 123 } else if (c == "|") { return 124 } else if (c == "}") { return 125 } else if (c == "~") { return 126 }
        return 0
    }

    /// 判断 LLVM 类型是否已经是指针类型（不应再追加 *）。
    ///
    /// LLVM 13+ 使用不透明指针 `ptr` 替代 `T*`；
    /// 用户自定义类型映射为 `%struct.X*`（已含 *）。
    fun isPointerTy(ty: String): Boolean {
        if (ty == "ptr") { return true } else if (ty == "") { return false }
        val last: String = aotSlice(ty, ty.length - 1, 1)
        return last == "*"
    }

    /// 将类型转为指针类型（若已是指针则原样返回）。
    fun toPtrTy(ty: String): String {
        if (EmitUtils.isPointerTy(ty)) { return ty }
        return ty + "*"
    }

    /// 将类型转为指针类型（带空格，供 sbAdd 使用）。
    fun toPtrTySp(ty: String): String {
        if (EmitUtils.isPointerTy(ty)) { return ty + " " }
        return ty + "* "
    }


}
