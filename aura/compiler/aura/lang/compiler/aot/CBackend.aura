// aura:///aura/lang/compiler/aot/CBackend.aura
package aura.lang.compiler.aot
// ─────────────────────────────────────────────────────────────
// C 后端（备选降级路径）— 纯 Aura 化迁移 · Phase 6 (任务 6.9)
//
// 对应 Rust `compiler/src/codegen/aot/c_backend.rs`。
//
// 当 LLVM 工具链不可用时，可将 HIR 直接转译为 C 源码，
// 再交给系统 C 编译器（clang/gcc/msvc）编译。
// 本版聚焦核心语句/表达式降级（与 Emit 的支持子集对齐）。
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String
import aura.lang.compiler.lexer.Span
import aura.lang.compiler.hir.Hir
import aura.lang.compiler.aot.AotUtil

/// HIR → C 源码生成器。
class CEmitter {

    /// 累积的函数定义。
    var funcs: String = ""

    /// 当前函数体。
    var fBody: String = ""

    /// 当前函数局部变量表（`name|ctype`，每行一项）。
    var fVars: String = ""

    /// 当前函数返回类型（C）。
    var fRetTy: String = "void"

    init() {
        this.funcs = ""
        this.fBody = ""
        this.fVars = ""
        this.fRetTy = "void"
    }

    /// HIR → C 源码。
    fun emitProgram(hir: Hir, moduleName: String): String {
        // 分段累积 + 树形归并：逐段 `+` 在大程序上是平方级分配（无 GC 下泄漏成 GB）
        var parts: List<String> = arrayListOf<String>()
        var i: Int = 0
        while (i < hir.count) {
            if (hir.kindOf(i) == "HirFunction") {
                parts.add(this.emitFunction(hir, i))
            }
            i = i + 1
        }
        this.funcs = joinPieces(parts, "")
        return "/* Generated by Aura AOT C backend (module: " + moduleName + ") */\n\n" + this.funcs
    }

    /// 发射单个函数。
    fun emitFunction(hir: Hir, id: Int): String {
        this.fBody = ""
        this.fVars = ""
        var retTy: String = cType(hir.tyOf(id))
        if (retTy == "") {
            retTy = "void"
        }
        this.fRetTy = retTy

        val kids: String = hir.kidsOf(id)
        val kCount: Int = hirKidsCount(kids)
        var params: String = ""
        var bodyId: Int = -1
        var i: Int = 0
        while (i < kCount) {
            val cid: Int = hirKidsAt(kids, i)
            if (hir.kindOf(cid) == "HirParam") {
                var pty: String = cType(hir.tyOf(cid))
                if (pty == "") {
                    pty = "int"
                }
                if (params != "") {
                    params = params + ", "
                }
                params = params + pty + " " + hir.textOf(cid)
                this.fVars = this.fVars + hir.textOf(cid) + "|" + pty + "\n"
            } else {
                bodyId = cid
            }
            i = i + 1
        }

        if (bodyId >= 0) {
            this.emitBody(hir, bodyId, 1)
        }
        if (retTy != "void" && !this.fBody.contains("return ")) {
            this.fBody = this.fBody + "    return 0;\n"
        }

        var out: String = retTy + " " + sanitizeLlvm(hir.textOf(id)) + "(" + params + ") {\n"
        out = out + this.fBody
        out = out + "}\n\n"
        return out
    }

    /// 发射语句块（带缩进）。
    fun emitBody(hir: Hir, id: Int, depth: Int) {
        if (hir.kindOf(id) == "HirBlock") {
            val kids: String = hir.kidsOf(id)
            val n: Int = hirKidsCount(kids)
            var i: Int = 0
            while (i < n) {
                this.emitStmt(hir, hirKidsAt(kids, i), depth)
                i = i + 1
            }
        } else {
            this.emitStmt(hir, id, depth)
        }
    }

    /// 发射单条语句。
    fun emitStmt(hir: Hir, id: Int, depth: Int) {
        if (id < 0 || id >= hir.count) {
            return
        }
        val pad: String = cIndent(depth)
        val k: String = hir.kindOf(id)
        if (k == "HirValDecl" || k == "HirVarDecl") {
            val name: String = hir.textOf(id)
            var cty: String = cType(hir.tyOf(id))
            val kids: String = hir.kidsOf(id)
            var initExpr: String = "0"
            if (hirKidsCount(kids) > 0) {
                val initId: Int = hirKidsAt(kids, 0)
                initExpr = this.emitExpr(hir, initId)
                if (cty == "") {
                    cty = cInferType(hir, initId)
                }
            }
            if (cty == "") {
                cty = "int"
            }
            this.fVars = this.fVars + name + "|" + cty + "\n"
            this.fBody = this.fBody + pad + cty + " " + name + " = " + initExpr + ";\n"
        } else if (k == "HirReturn") {
            val kids: String = hir.kidsOf(id)
            if (hirKidsCount(kids) > 0) {
                this.fBody = this.fBody + pad + "return "
                    + this.emitExpr(hir, hirKidsAt(kids, 0)) + ";\n"
            } else {
                this.fBody = this.fBody + pad + "return;\n"
            }
        } else if (k == "HirAssign") {
            val kids: String = hir.kidsOf(id)
            if (hirKidsCount(kids) >= 2) {
                val target: String = this.emitExpr(hir, hirKidsAt(kids, 0))
                val value: String = this.emitExpr(hir, hirKidsAt(kids, 1))
                this.fBody = this.fBody + pad + target + " = " + value + ";\n"
            }
        } else if (k == "HirIf") {
            val kids: String = hir.kidsOf(id)
            val n: Int = hirKidsCount(kids)
            if (n >= 2) {
                this.fBody = this.fBody + pad + "if ("
                    + this.emitExpr(hir, hirKidsAt(kids, 0)) + ") {\n"
                this.emitBody(hir, hirKidsAt(kids, 1), depth + 1)
                this.fBody = this.fBody + pad + "}"
                if (n > 2) {
                    this.fBody = this.fBody + " else {\n"
                    this.emitBody(hir, hirKidsAt(kids, 2), depth + 1)
                    this.fBody = this.fBody + pad + "}"
                }
                this.fBody = this.fBody + "\n"
            }
        } else if (k == "HirWhile") {
            val kids: String = hir.kidsOf(id)
            if (hirKidsCount(kids) >= 2) {
                this.fBody = this.fBody + pad + "while ("
                    + this.emitExpr(hir, hirKidsAt(kids, 0)) + ") {\n"
                this.emitBody(hir, hirKidsAt(kids, 1), depth + 1)
                this.fBody = this.fBody + pad + "}\n"
            }
        } else if (k == "HirBlock") {
            this.fBody = this.fBody + pad + "{\n"
            this.emitBody(hir, id, depth + 1)
            this.fBody = this.fBody + pad + "}\n"
        } else {
            this.fBody = this.fBody + pad + this.emitExpr(hir, id) + ";\n"
        }
    }

    /// 发射表达式为 C 表达式字符串。
    fun emitExpr(hir: Hir, id: Int): String {
        if (id < 0 || id >= hir.count) {
            return "0"
        }
        val k: String = hir.kindOf(id)
        if (k == "HirLit") {
            return hir.textOf(id)
        }
        if (k == "HirVar") {
            return hir.textOf(id)
        }
        if (k == "HirBinary") {
            val kids: String = hir.kidsOf(id)
            if (hirKidsCount(kids) < 2) {
                return "0"
            }
            return "(" + this.emitExpr(hir, hirKidsAt(kids, 0)) + " " + hir.textOf(id)
                + " " + this.emitExpr(hir, hirKidsAt(kids, 1)) + ")"
        }
        if (k == "HirUnary") {
            val kids: String = hir.kidsOf(id)
            if (hirKidsCount(kids) < 1) {
                return "0"
            }
            return "(" + hir.textOf(id) + this.emitExpr(hir, hirKidsAt(kids, 0)) + ")"
        }
        if (k == "HirCall") {
            val kids: String = hir.kidsOf(id)
            val n: Int = hirKidsCount(kids)
            var fname: String = hir.textOf(id)
            var argStart: Int = 0
            if (fname == "") {
                if (n == 0) {
                    return "0"
                }
                fname = hir.textOf(hirKidsAt(kids, 0))
                argStart = 1
            }
            var args: String = ""
            var i: Int = argStart
            while (i < n) {
                if (args != "") {
                    args = args + ", "
                }
                args = args + this.emitExpr(hir, hirKidsAt(kids, i))
                i = i + 1
            }
            return sanitizeLlvm(fname) + "(" + args + ")"
        }
        return "0"
    }

    /// 推断表达式 C 类型。
    fun inferExprType(hir: Hir, id: Int): String {
        return cInferType(hir, id)
    }

    /// 查询局部变量 C 类型。
    fun lookupVarTy(name: String): String {
        var n: Int = aotLineCount(this.fVars)
        var i: Int = 0
        while (i < n) {
            val line: String = aotLineAt(this.fVars, i)
            if (aotFieldAt(line, 0, "|") == name) {
                return aotFieldAt(line, 1, "|")
            }
            i = i + 1
        }
        return ""
    }
}

// ─────────────────────────────────────────────────────────────
// 顶层辅助
// ─────────────────────────────────────────────────────────────

/// 顶层入口：HIR → C 源码。
fun emitC(hir: Hir, moduleName: String): String {
    val e: CEmitter = CEmitter()
    return e.emitProgram(hir, moduleName)
}

/// Aura 类型名 → C 类型。
fun cType(ty: String): String {
    if (ty == "Int") { return "int" }
    if (ty == "Long") { return "long long" }
    if (ty == "Short") { return "short" }
    if (ty == "Byte" || ty == "U8") { return "unsigned char" }
    if (ty == "Float") { return "float" }
    if (ty == "Double") { return "double" }
    if (ty == "Boolean" || ty == "Bool") { return "bool" }
    if (ty == "Char") { return "char" }
    if (ty == "Unit" || ty == "Void") { return "void" }
    if (ty == "String") { return "const char*" }
    if (ty == "Any" || ty == "Nothing") { return "void*" }
    if (ty == "List" || ty == "Map" || ty == "Set" || ty == "Value") { return "void*" }
    if (ty.startsWith("List<") || ty.startsWith("Map<") ||
        ty.startsWith("Set<") || ty.startsWith("Array<")) {
        return "void*"
    }
    if (ty.startsWith("Pointer<")) { return "void*" }
    if (ty == "" ) { return "" }
    return ty
}

/// 推断表达式的 C 类型。
fun cInferType(hir: Hir, id: Int): String {
    if (id < 0 || id >= hir.count) {
        return "int"
    }
    val k: String = hir.kindOf(id)
    if (k == "HirLit") {
        val raw: String = hir.textOf(id)
        if (raw == "true" || raw == "false") { return "bool" }
        if (raw.startsWith("\"")) { return "const char*" }
        if (raw.contains(".")) { return "double" }
        return "int"
    }
    if (k == "HirVar" && hir.tyOf(id) != "") {
        return cType(hir.tyOf(id))
    }
    if (hir.tyOf(id) != "") {
        return cType(hir.tyOf(id))
    }
    return "int"
}

/// C 缩进。
fun cIndent(depth: Int): String {
    var s: String = ""
    var i: Int = 0
    while (i < depth) {
        s = s + "    "
        i = i + 1
    }
    return s
}
