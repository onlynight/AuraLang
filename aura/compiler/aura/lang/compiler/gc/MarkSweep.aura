// aura:///aura/compiler/aura/lang/compiler/gc/MarkSweep.aura
package aura.lang.compiler.gc
// 标记-清除垃圾收集算法（委托 GcHeap 实现）
//
// 替代旧版空壳实现（markAll→只计数非 null 根，sweepAll→只计数未标记项）。

import aura.lang.collection.ArrayList
import aura.lang.collection.HashMap

/// 标记-清除 GC 包装器。
class MarkSweep {
    private var heap: GcHeap

    constructor() {
        this.heap = GcHeap()
    }

    constructor(heap: GcHeap) {
        this.heap = heap
    }

    /// 标记阶段：从根集合遍历对象图，标记可达对象。
    fun mark(roots: List<Int>): Int {
        var marked = 0
        var i = 0
        while (i < roots.size) {
            val idx = roots.get(i) as Int
            this.heap.mark(idx)
            marked = marked + 1
            i = i + 1
        }
        return marked
    }

    /// 清除阶段：回收未标记对象。
    fun sweep(): Int {
        return this.heap.collect()
    }

    /// 执行完整标记-清除周期。
    fun collect(roots: List<Int>): Int {
        return this.heap.collect()
    }

    /// 注册根引用。
    fun addRoot(idx: Int): Unit {
        this.heap.addRoot(idx)
    }

    /// 分配对象。
    fun alloc(): Int {
        return this.heap.alloc()
    }

    /// 获取活跃对象数。
    fun liveCount(): Int {
        return this.heap.liveCount()
    }

    fun strategyName(): String {
        return "mark-sweep"
    }

    fun version(): String {
        return "0.6.0-mark-sweep"
    }
}
