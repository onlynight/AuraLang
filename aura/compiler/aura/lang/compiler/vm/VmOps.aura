// aura:///aura/compiler/aura/lang/compiler/vm/VmOps.aura
package aura.lang.compiler.vm
// ─────────────────────────────────────────────────────────────
// VM 操作助手 — P0 完整指令集支持（性能优化版）
//
// 所有类型判定/转换/运算函数均使用 when / if-else-if 链
// 替代 if-return 早退，减少分支点和字节码跳转开销。
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String
import aura.lang.collection.ArrayList
import aura.lang.collection.HashMap
import aura.lang.native.Memory

/// VM 操作工具对象（集中管理无状态工具函数）。
object VmOps {

    /// [根修轮R14] 字符串长度 = charCodeAt NUL 扫描。
    /// 独立小方法 = 最小 roll 面的可靠原语（getField 的 length 路由至此）。
    fun strLenRaw(s: String): Int {
        var n: Int = 0
        while (s.charCodeAt(n) != 0) {
            n = n + 1
        }
        return n
    }

    /// [R4] vmSubstr 定性探针计数
    var vmSubDiag: Int = 0

    // ═══════════════════════════════════════════════════════════
    //  类型判定
    // ═══════════════════════════════════════════════════════════

    /// 返回值的运行时类型名称。
    fun typeName(v: Any): String {
        if (v == null) {
            return "Null"
        }
        val t: String = typeof(v)
        return t
    }

    /// 检查是否为数值类型（Int/Float/Long/Double）。
    fun isNumeric(v: Any): Boolean {
        if (v == null) {
            return false
        }
        // P409 快路径：Plan A 的 `aura_typeof` 只可能返回三个常量
        // （"Null" / "Int" / "String"，见 PhotonRuntime.emitTypeOfPlanA 的
        //穷举：null→"Null"、奇数→"Int"、其余→"String"）。三者都是数值，
        // 非 null 即真——**无需任何字符串比较**。原实现要 1 次 typeof call
        // + 4 次 streq 逐字节比较才能得到同一个答案。
        return true
    }

    /// 检查是否为整数类型。
    fun isInt(v: Any): Boolean {
        if (v == null) {
            return false
        }
        // P409 快路径：typeof ∈ {Null, Int, String}，只有 "Int" 是整数类型。
        return typeof(v) == "Int"
    }

    /// 检查是否为浮点类型。
    fun isFloat(v: Any): Boolean {
        if (v == null) {
            return false
        }
        // P409 快路径：**typeof 的三个返回值里没有 "Float" 也没有 "Double"**
        // （emitTypeOfPlanA 穷举：null→"Null"、奇数→"Int"、其余→"String"）。
        // 所以本函数恒为 false —— 与原实现的逻辑等价，但省掉 1 次 typeof
        // call + 2 次 streq 逐字节比较。
        //
        // ⚠ 语义等价性依据：Plan A 值模型把 Int 装箱为 `(v<<1)|1`（奇数）、
        // Long 裸传、Float/Double 在 AOT 下不存在独立 Any 形态（Double 走
        // 裸位传递，被判为 "String" 分支）。原实现在同样输入下也只会走到
        // 末尾 `return false`。若将来 emitTypeOfPlanA 扩充返回值集合，
        // **必须同步回滚本优化**。
        return false
    }

    /// 检查是否为布尔类型。
    fun isBool(v: Any): Boolean {
        if (v == null) {
            return false
        }
        // P409 快路径：同 isFloat——typeof 恒不返回 "Boolean"
        // （布尔在 Plan A 下用 "true"/"false" 字符串表示，见 vmBool）。
        return false
    }

    // ═══════════════════════════════════════════════════════════
    //  [R20] Float 文本形态（Plan A 值模型的务实浮点通道）
    // ═══════════════════════════════════════════════════════════
    //
    // Plan A 无 Float Any 形态（isFloat 恒 false，浮点位模式是偶数 =
    // "String"）⇒ 算术浮点分支全灭（实测 01-arithmetic 的 `x * 2.0`
    // 打 0）。本通道让浮点以**十进制文本**走 Any 槽：LOAD_CONST_F 直推
    // 常量文本，算术在此用纯 Int 定标数学（无任何 Float 位依赖），
    // 渲染与种子 Display 对齐（"5.0"/"2.5"/"-1.25"）。
    // 取舍：数值型字符串（"2.5" 作 String 值）参与算术会被升格浮点——
    // 仅算术路径受影响，务实接受。

    /// 浮点文本判定：[±]digits.digits。[R20] 全程已证原语（indexOf/vmSubstr/
    /// isAllDigits）——自建累加扫描循环在宿主产码下按位点重掷腐坏。
    fun isFloatText(v: Any): Boolean {
        if (v == null) {
            return false
        }
        val s: String = toStrAny(v)
        val n: Int = strLenRaw(s)
        if (n < 3) {
            return false
        }
        // [R21] 点位扫描内联（loadArgsFlat 逗号扫描同款形状，去 indexOf 依赖
        // ——其 text.length 守卫在宿主下为坏死字段读）
        var dot: Int = -1
        var p: Int = 0
        while (p < n) {
            if (s.charCodeAt(p) == 46) {
                dot = p
                p = n
            }
            p = p + 1
        }
        if (dot < 1) {
            return false
        }
        val fp: String = vmSubstr(s, dot + 1, n - dot - 1)
        var ipD: String = vmSubstr(s, 0, dot)
        if (strLenRaw(fp) < 1) {
            return false
        }
        if (strLenRaw(ipD) > 0) {
            if (vmSubstr(ipD, 0, 1) == "-") {
                ipD = vmSubstr(ipD, 1, strLenRaw(ipD) - 1)
            }
        }
        if (strLenRaw(ipD) < 1) {
            return false
        }
        return isAllDigits(ipD) && isAllDigits(fp)
    }

    /// 小数位数："2.5"→1，"-1.25"→2，"2"→0。（点位内联扫描，同 isFloatText）
    fun floatDecimalsOf(v: Any): Int {
        val s: String = toStrAny(v)
        val n: Int = strLenRaw(s)
        var dot: Int = -1
        var p: Int = 0
        while (p < n) {
            if (s.charCodeAt(p) == 46) {
                dot = p
                p = n
            }
            p = p + 1
        }
        if (dot < 0) {
            return 0
        }
        return n - dot - 1
    }

    /// 去点去符号的尾数："2.5"→25，"-1.25"→-125，"2"→2。
    /// [R20] 点两侧各走已证 vmSubstr + toI32，无累加循环。
    fun floatMantissaOf(v: Any): Int {
        val s: String = toStrAny(v)
        val n: Int = strLenRaw(s)
        var dot: Int = -1
        var p: Int = 0
        while (p < n) {
            if (s.charCodeAt(p) == 46) {
                dot = p
                p = n
            }
            p = p + 1
        }
        if (dot < 0) {
            return toI32(s)
        }
        val ip: String = vmSubstr(s, 0, dot)
        val fp: String = vmSubstr(s, dot + 1, n - dot - 1)
        val fd: Int = strLenRaw(fp)
        val ival: Int = toI32(ip)
        val fval: Int = toI32(fp)
        var m: Int = 0
        if (ival < 0) {
            m = ival * floatPow10(fd) - fval
        } else {
            m = ival * floatPow10(fd) + fval
        }
        return m
    }

    fun floatPow10(d: Int): Int {
        var p: Int = 1
        var k: Int = 0
        while (k < d) {
            p = p * 10
            k = k + 1
        }
        return p
    }

    /// 定标尾数 → 显示文本（种子 Display 风格）：(50,1)→"5.0"，
    /// (25,1)→"2.5"，(-125,2)→"-1.25"。去尾零但至少保留 1 位小数。
    /// [R20] 补零走单次 vmSubstr + 一次拼接（无自建累加循环）。
    fun floatTextOf(m: Int, d: Int): String {
        var mag: Int = m
        var dec: Int = d
        if (dec < 1) {
            dec = 1
        }
        var neg: Boolean = false
        if (mag < 0) {
            neg = true
            mag = -mag
        }
        while (dec > 1 && (mag % 10) == 0) {
            mag = mag / 10
            dec = dec - 1
        }
        val p: Int = floatPow10(dec)
        val ip: Int = mag / p
        val fp: Int = mag % p
        var fs: String = intToStr(fp)
        val fd: Int = strLenRaw(fs)
        if (fd < dec) {
            fs = vmSubstr("000000000", 0, dec - fd) + fs
        }
        var out: String = ""
        if (neg) {
            out = "-"
        }
        return out + intToStr(ip) + "." + fs
    }

    /// 检查是否为字符串类型。
    ///
    /// AOT 载体（Plan A）下 `typeof` 按静态类型折叠：Any 形参**恒报 "String"**，
    /// 装箱整数（`(v<<1)|1` 的奇数伪指针）会被误判成字符串 —— `100 + 23` 走
    /// 拼接得 "10023"、循环计数 `i = i + 1` 拼成 "11" 永不终止（实测 AOT 载体
    /// helloworld 算术全错 + Instruction limit exceeded）。
    /// 奇偶判别（`raw/2*2 != raw`，兼容负数的奇偶）排除装箱整数；种子 VM 下
    /// typeof 给出真实类型名，数值在第一个判断就被短路，行为不变。
    fun isString(v: Any): Boolean {
        if (v == null) {
            return false
        }
        // P409 快路径：Plan A 的 `aura_typeof` 恒返回 "String"（非 null 时），
        // 所以 `typeof(v) != "String"` 恒为假——原实现的第一个判断从不成立。
        // 整个函数退化为「非装箱整数」= `!isTaggedInt(v)`，而 `__is_tagged_int`
        // 已被发射器内联为 `mov rax,rcx; and rax,1`（2 条，见 X86Emitter.emitCall）。
        // 于是 isString 从「1 次 typeof call + 1 次 streq 逐字节 + 1 次内联判定」
        // 降为「2 条位运算」。
        //
        // ⚠ 语义等价性：原实现在 Plan A 下的实际行为就是 `!isTaggedInt(v)`——
        // `typeof` 对Any 形参恒报 "String"（注释已记录该事实），第一个判断是死代码。
        return !isTaggedInt(v)
    }

    /// Plan A 低位标记检测：值是否为「装箱整数」（64 位表示为奇数）。
    ///
    /// 经编译器内建 `__is_tagged_int`：AOT 侧发射**原始** ptrtoint + 奇偶检查
    ///（`as Long` 会插入 `aura_to_int_any` 拆箱，奇偶性随即丢失——不能用）；
    /// 种子 VM 侧降级为常量 false（typeof 已准确，该检测不被依赖）。
    /// 真实字符串/对象指针恒为偶数（分配器 ≥2 字节对齐），奇数必是
    /// `(v<<1)|1` 的装箱整数。
    fun isTaggedInt(v: Any): Boolean {
        return __is_tagged_int(v)
    }

    /// Any → Int：装箱整数走**无分配**快路径。
    ///
    /// `as Long` 在 AOT 下发射 `ptrtoint + aura_to_int_any`——对装箱整数
    /// 正是拆箱值；再截断为 Int。此前数值分支一律 `toI32(toStr(v))`：
    /// 每次运算分配两个十进制临时串且**永不释放**（运行时无字符串回收），
    /// 25M 迭代基准实测累积 6GB+ 触发内存守卫中止；本快路径同时消除
    /// 分配与串解析开销。种子 VM 下 isTaggedInt 恒 false，走慢路径不变。
    fun intOf(v: Any): Int {
        if (isTaggedInt(v)) {
            val raw: Long = v as Long
            // P378：(raw - 1) / 2 = 精确拆箱（raw 奇，raw-1 偶，整除无截断
            // 误差；负数同样成立）。photon 无 aura_to_int_any，`as Int` 是
            // 纯截断不拆箱。
            val real: Long = (raw - 1) / 2
            return real as Int
        }
        return toI32(toStr(v))
    }

    // ═══════════════════════════════════════════════════════════
    //  类型转换（when 优化）
    // ═══════════════════════════════════════════════════════════

    /// Any -> Int（32 位）。
    fun toI32(s: String): Int {
        return toI32Raw(s)
    }

    fun toI32Raw(s: String): Int {
        if (s == null || s == "") {
            return 0
        }
        if (s == "true") {
            return 1
        }
        if (s == "false" || s == "Unit") {
            return 0
        }
        var total: Int = 0
        var i: Int = 0
        var len: Int = s.length
        var neg: Boolean = false
        if (len > 0 && s.charCodeAt(0) == 45) {
            neg = true
            i = 1
        }
        while (i < len) {
            val c: Int = s.charCodeAt(i)
            if (c >= 48 && c <= 57) {
                total = total * 10 + (c - 48)
            }
            i = i + 1
        }
        if (neg) {
            return -total
        }
        return total
    }

    /// 字符串转整数（不依赖 charCodeAt，避免 AOT 转换问题）。
    fun vrToInt(text: String): Int {
        if (text == null || text == "") return 0
        var total: Int = 0
        var i: Int = 0
        var len: Int = text.length
        var neg: Boolean = false
        if (len > 0 && text.charCodeAt(0) == 45) {
            neg = true
            i = 1
        }
        while (i < len) {
            val c: Int = text.charCodeAt(i)
            if (c < 48 || c > 57) {
                break
            }
            total = total * 10 + (c - 48)
            i = i + 1
        }
        if (neg) {
            return -total
        }
        return total
    }

    /// Any -> Long（64 位）。
    ///
    /// 直接解析为 Long，不经过 toI32（后者仅 32 位，会丢失高 32 位）。
    /// 64 位对象指针（如 `Memory.alloc` 返回的地址）必须保留完整精度。
    fun toI64(s: String): Long {
        if (s == null || s == "") {
            return 0
        }
        if (s == "true") {
            return 1
        }
        if (s == "false" || s == "Unit") {
            return 0
        }
        var total: Long = 0
        var i: Int = 0
        var len: Int = s.length
        var neg: Boolean = false
        if (len > 0 && s.charCodeAt(0) == 45) {
            neg = true
            i = 1
        }
        while (i < len) {
            val c: Int = s.charCodeAt(i)
            if (c >= 48 && c <= 57) {
                total = total * 10 + (c - 48)
            }
            i = i + 1
        }
        if (neg) {
            return -total
        }
        return total
    }

    /// Any -> Float（when 优化）。
    fun parseFloat(s: String): Float {
        if (s == null || s == "") {
            return 0.0f
        }
        if (s == "true") {
            return 1.0f
        }
        if (s == "false") {
            return 0.0f
        }
        return toFloat(s)
    }

    /// Any -> Boolean。
    ///
    /// AOT 下布尔值经 Plan A 装箱为整数（true → -1，false → 0），`typeof` 只能
    /// 报出 "Int"，因此**不能**用 `typeof(v) == "Boolean"` 判定，也不能只认
    /// "true"/"1"（-1 会被误判成 false —— while 条件为真时被当作假，循环体整段
    /// 不执行，`sum` 恒为 0）。这里按「零/空 → false，其余 → true」处理。
    fun toBool(v: Any): Boolean {
        if (v == null) {
            return false
        }
        if (typeof(v) == "Boolean") {
            return v as Boolean
        }
        // P387：必须走 toStrAny——AOT 下 toStr 是纯整数实现，字符串（vmBool
        // 的 "true"/"false"）会被打成指针值十进制 ⇒ "false" 落到兜底
        // `return true` ⇒ 一切字符串条件恒真（实测 `10 < 5` 走 then 分支）。
        val s: String = toStrAny(v)
        if (s == "true") {
            return true
        }
        if (s == "false") {
            return false
        }
        if (s == "0" || s == "") {
            return false
        }
        return true
    }

    /// Int -> Any。
    fun toAny(v: Int): Any {
        // P378：Plan A 装箱——Int 的 Any 形态 = (v<<1)|1（恒奇）。裸值入
        // Any 槽会让 isTaggedInt/typeof 的奇偶判定翻车（偶数误判 String、
        // 奇指针误判 Int）。Long→Any = 裸字传递（photon 无额外装箱）。
        val l: Long = v as Long
        val tagged: Long = l * 2 + 1
        return tagged as Any
    }

    /// Any -> Long（**地址/整值统一入口**，2026-10-08 P1-3）。
    ///
    /// Memory.* / JitExec.* 等原生臂的实参在 Any 槽里有两种形态：
    ///   * .auc 侧 Int 实参 → Plan A 装箱（(v<<1)|1，恒奇）→ `intOf` 拆箱；
    ///   * .auc 侧 Long 实参 → 裸字传递（偶）→ `toI64(toStr(v))` 十进制还原
    ///    （运行时 toStr 是纯整数实现，对裸 Long 恰好打全值十进制）。
    /// 旧臂一律 `toI64(toStr(v))`——种子 VM 值未装箱故恰好可用；原生 VM
    /// 下 Int 实参带着 tag 进 native（实测 mmap 收到 n=1 / ln=8193），
    /// 地址整体翻倍 +1。JIT 原生验证（P1-3）首次踩中。
    fun addrOf(v: Any): Long {
        if (isTaggedInt(v)) {
            return intOf(v) as Long
        }
        return toI64(toStr(v))
    }

    // ═══════════════════════════════════════════════════════════
    //  算术运算（if-else-if 优化）
    // ═══════════════════════════════════════════════════════════

    /// 加法。
    fun add(a: Any, b: Any): Any {
        // [R21] Float 文本分支已上移 dispatch（op20）——本函数保持
        // String/Any 单类型返回，避免 P364 双类型合并装箱病。
        if (isString(a) || isString(b)) {
            // P347：字符串分支必须走 toStrAny（运行时 toStr 是纯整数实现，
            // 字符串指针会打成指针值十进制）
            return toStrAny(a) + toStrAny(b)
        } else {
            return toAny(intOf(a) + intOf(b))
        }
    }

    /// 减法。
    fun sub(a: Any, b: Any): Any {
        return toAny(intOf(a) - intOf(b))
    }

    /// 乘法。
    fun mul(a: Any, b: Any): Any {
        return toAny(intOf(a) * intOf(b))
    }

    /// 除法（零除保护）。
    fun div(a: Any, b: Any): Any {
        val bb: Int = intOf(b)
        if (bb == 0) {
            return 0
        }
        return toAny(intOf(a) / bb)
    }

    /// 取模（零除保护）。
    fun mod(a: Any, b: Any): Any {
        val bb: Int = intOf(b)
        if (bb == 0) {
            return 0
        }
        return toAny(intOf(a) % bb)
    }

    /// 一元取负。
    fun neg(a: Any): Any {
        return toAny(-intOf(a))
    }

    // ═══════════════════════════════════════════════════════════
    //  比较运算（if-else-if 优化）
    // ═══════════════════════════════════════════════════════════

    /// 布尔结果 → VM 统一表示（`"true"` / `"false"` 字符串）。
    ///
    /// **为什么用字符串而不是 Aura `Boolean`**：本 AOT 下 `Boolean` 与 `Int`
    /// 共用 Plan A 装箱（`true → -1`、`false → 0`，打包后与 `Int` 的 -1/0
    /// **无法区分**），`toStr` 因此把布尔结果打印成 `0`/`-1`；而 Rust VM 有独立
    /// 的值类型，打印 `true`/`false` —— `.auc` 回放输出对不上
    ///（实测 `7==3: 0`（Aura） vs `7==3: false`（Rust））。
    /// 统一返回这两个字符串后输出与 Rust VM 一致；真值判定一律走 `toBool`
    ///（已支持 `"true"`/`"false"`），故 `JUMP_IF_FALSE` / `and` / `or` / `not`
    /// 语义不变。方法名加前缀以免与其它对象的同名成员错绑。
    fun vmBool(b: Boolean): Any {
        if (b) {
            return "true"
        }
        return "false"
    }

    /// 相等比较（返回 `"true"`/`"false"`，见 `vmBool`）。
    fun eq(a: Any, b: Any): Any {
        if (a == null && b == null) {
            return "true"
        } else if (a == null || b == null) {
            return "false"
        } else if (isFloat(a) || isFloat(b)) {
            return vmBool(parseFloat(toStr(a)) == parseFloat(toStr(b)))
        } else {
            return vmBool(a == b)
        }
    }

    /// 不相等比较。
    ///
    /// **不要**写成 `return !eq(a, b)`，也**不要**写成 `if (eq(a, b))`：
    /// 自举 AOT 下 `if (<返回 `Any` 的方法调用>)` 会被发射成
    /// `icmp ne i8* <值>, null`（判空而不是判真假），而打包布尔 `false` 是
    /// 整数 1（**非 null**）→ 条件恒真 → `neq` 恒返回 false（实测 `7 != 3`
    /// 打印 `0`）。这里改成先转成字符串再按整数比较，绕开该真值判定。
    fun neq(a: Any, b: Any): Any {
        if (toBool(eq(a, b))) {
            return "false"
        }
        return "true"
    }

    /// 小于比较（返回 `"true"`/`"false"`，见 `vmBool`）。
    fun lt(a: Any, b: Any): Any {
        if (isFloat(a) || isFloat(b)) {
            return vmBool(parseFloat(toStr(a)) < parseFloat(toStr(b)))
        } else {
            return vmBool(intOf(a) < intOf(b))
        }
    }

    /// 大于比较。
    fun gt(a: Any, b: Any): Any {
        if (isFloat(a) || isFloat(b)) {
            return vmBool(parseFloat(toStr(a)) > parseFloat(toStr(b)))
        } else {
            return vmBool(intOf(a) > intOf(b))
        }
    }

    /// 小于等于比较。
    fun le(a: Any, b: Any): Any {
        if (isFloat(a) || isFloat(b)) {
            return vmBool(parseFloat(toStr(a)) <= parseFloat(toStr(b)))
        } else {
            return vmBool(intOf(a) <= intOf(b))
        }
    }

    /// 大于等于比较。
    fun ge(a: Any, b: Any): Any {
        if (isFloat(a) || isFloat(b)) {
            return vmBool(parseFloat(toStr(a)) >= parseFloat(toStr(b)))
        } else {
            return vmBool(intOf(a) >= intOf(b))
        }
    }

    // ═══════════════════════════════════════════════════════════
    //  逻辑/位运算
    // ═══════════════════════════════════════════════════════════

    /// 逻辑与（返回 `"true"`/`"false"`，见 `vmBool`）。
    fun and(a: Any, b: Any): Any {
        return vmBool(toBool(a) && toBool(b))
    }

    /// 逻辑或。
    fun or(a: Any, b: Any): Any {
        return vmBool(toBool(a) || toBool(b))
    }

    /// 逻辑非。
    fun not(a: Any): Any {
        return vmBool(!toBool(a))
    }

    /// 按位与。
    ///
    /// **必须用符号形式 `&` / `|` / `^` / `<<` / `>>`**：Aura 的 `binPrec` 不接受
    /// 单词形式（`and`/`or`/`xor`/`shl`/`shr`），自举 AOT 下它们会被静默降级
    /// （实测 `x shl 8` 直接退化成 `x`，移位量被丢弃）——`.auc` 读取小端整数
    /// 因此高字节恒为 0（`natives_count` 594 被读成 82）。
    fun bitAnd(a: Any, b: Any): Any {
        return toAny(intOf(a) & intOf(b))
    }

    /// 按位或。
    fun bitOr(a: Any, b: Any): Any {
        return toAny(intOf(a) | intOf(b))
    }

    /// 按位异或。
    fun bitXor(a: Any, b: Any): Any {
        return toAny(intOf(a) ^ intOf(b))
    }

    /// 左移。
    fun shl(a: Any, b: Any): Any {
        return toAny(intOf(a) << intOf(b))
    }

    /// 右移。
    fun shr(a: Any, b: Any): Any {
        return toAny(intOf(a) >> intOf(b))
    }

    // ═══════════════════════════════════════════════════════════
    //  字符串工具
    // ═══════════════════════════════════════════════════════════

    /// 判断字符码是否为空白（空格 / 制表 / 换行 / 回车）。
    fun isSpace(c: Int): Boolean {
        if (c == 32 || c == 9 || c == 10 || c == 13) {
            return true
        }
        return false
    }

    /// 解析指令行从 `start` 起的空格分隔参数列表。
    ///
    /// `start` 通常为 opcode 之后的第一个字符下标；返回按出现顺序排列的参数。
    fun parseArgs(line: String, start: Int): List<String> {
        val result: List<String> = arrayListOf<String>()
        if (line == null) {
            return result
        }
        var i: Int = start
        var len: Int = line.length
        while (i < len) {
            // 跳过空白
            while (i < len && isSpace(line.charCodeAt(i))) {
                i = i + 1
            }
            if (i >= len) {
                break
            }
            val argStart: Int = i
            while (i < len && !isSpace(line.charCodeAt(i))) {
                i = i + 1
            }
            result.add(vmSubstr(line, argStart, i - argStart))
        }
        return result
    }

    /// 字符串切片（注意：**不能**命名为 `substring`，否则会与 `String.substring`
    /// 在按名解析时冲突，导致 `text.substring(...)` 被解析回本函数而形成无限递归）。
    fun vmSubstr(text: String, start: Int, length: Int): String {
        if (text == null) {
            return ""
        }
        if (start < 0) {
            return ""
        }
        if (length < 0) {
            return ""
        }
        if (start >= text.length) {
            // [R4→R32] 定性探针摘除（生产路径噪声：边界 substring
            // start==len 为合法空串语义，实证 07-exception-simple 被污染）
            return ""
        }
        // P386：早返回风格——`end` 不再重赋值（旧实现两次重赋值 = 两处
        // merge phi，photon ISel 下 end 家槽跨调用残留前次值 ⇒ 同函数相邻
        // 调用点一成一败，§10.100 定罪）。全函数零 merge phi。
        // [根修轮R4] 切片改走 charCodeAt + fromCharCode 逐字符拼接：本布局下
        // PhotonPipeline_substring 对合法输入返回空串（探针实证：守卫全过、
        // substring 结果为空），而 charCodeAt 已被 loadArgsFlat 逗号扫描实证
        // 可靠。args 装载路径冷，O(n) 拼接可接受。
        var n2: Int = text.length
        if (start + length < n2) { n2 = start + length }
        var out: String = ""
        var k2: Int = start
        while (k2 < n2) {
            out = out + String.fromCharCode(text.charCodeAt(k2))
            k2 = k2 + 1
        }
        return out
    }

    /// `Any` → 原始 64 位表示。
    ///
    /// **不要**用 `toI64(toStr(x))` 取句柄/指针：Aura 的 `String`、集合句柄在 AOT
    /// 下都是 `i8*`，`toStr` 会把裸指针**原样**返回，`toI64` 再去解析指针指向的
    /// 内容 → 得到一个不相干的垃圾数（实测 `VmCollections` 里长度读出
    /// `-1812475513`；`.auc` 执行 `listOf` 时因把垃圾当地址写入而访问违规崩溃）。
    fun rawOf(x: Any): Long {
        if (x == null) {
            return 0
        }
        return x as Long
    }

    /// [R36] Float → 十进制文本（6 位小数，去尾零保 1 位；种子 Display
    /// 同约定）。标量 Float 比较/乘减 + Float→Int 截断（编译器内联
    /// cvttss2si，单指令低骰）。供 Math 原生臂的文本通道输出。
    fun floatToTextF(f: Float): String {
        var neg: Boolean = false
        var af: Float = f
        if (af < 0) {
            neg = true
            af = 0 - af
        }
        var ip: Int = af as Int
        if (ip < 0) { ip = 0 - ip }
        var frac: Float = af - (ip as Float)
        if (frac < 0) { frac = 0 - frac }
        var out: String = ""
        if (neg) { out = "-" }
        out = out + intToStr(ip) + "."
        var digits: Int = 0
        var done: Boolean = false
        while (!done) {
            frac = frac * 10
            var d: Int = frac as Int
            if (d < 0) { d = 0 }
            out = out + intToStr(d)
            frac = frac - (d as Float)
            digits = digits + 1
            if (frac <= 0.000001 || digits >= 6) { done = true }
        }
        return out
    }

    /// [R34] 堆指针键（登记/查询共用）：指针十进制。**不要**用 toStrAny
    /// 做堆对象键——偶指针走 String 分支 = 把堆内存当字符串读（实测列表
    /// 键 = len 字段字节 → strlen=1，m[i].size 全灭）。
    fun ptrKeyOf(v: Any): String {
        return intToStr(rawOf(v) as Int)
    }

    /// [R31] 任意值哈希（djb2，字符域 charCodeAt 扫描 = strLenRaw 同款
    /// 已证形状）。供 .auc 的 HashMap 闭包键分桶——宿主接管 Any.hashCode
    /// 后，put/get 两侧一致即语义成立（桶序与种子不必一致）。
    fun hashCodeOf(v: Any): Int {
        val s: String = toStrAny(v)
        val n: Int = strLenRaw(s)
        var h: Int = 5381
        var i: Int = 0
        while (i < n) {
            h = h * 33 + s.charCodeAt(i)
            i = i + 1
        }
        return h
    }

    /// [R19] ASCII 大写化——**零拼接实现**。累加器循环 `result = result +
    /// fromCharCode(c)` 在宿主管线下多轮迭代必腐坏（实测 toUpper 出
    /// "0t^ HELLO"、toLower 出 "aa"——每轮 concat 的指针漂移复合，R13
    /// ptr+1 家族），改为：Memory.alloc 一次 + 逐字节写入 + NUL 终止，
    /// 结果裸指针原样作 String（Long→Any 裸传 + Any→String 重释，同
    /// toStrAny/newListCap 先例）。charCodeAt 多轮扫描由 loadArgsFlat
    /// 逗号扫描实证可靠。
    fun toUpper(text: String): String {
        val n: Int = strLenRaw(text)
        val buf: Long = Memory.alloc(n + 1)
        var i: Int = 0
        while (i < n) {
            val c: Int = text.charCodeAt(i)
            var oc: Int = c
            if (c >= 97 && c <= 122) {
                oc = c - 32
            }
            Memory.write(buf + i, oc as Byte)
            i = i + 1
        }
        Memory.write(buf + n, 0 as Byte)
        val ab: Any = buf as Any
        return ab as String
    }

    /// [R19] ASCII 小写化（同 toUpper 的零拼接模式）。
    fun toLower(text: String): String {
        val n: Int = strLenRaw(text)
        val buf: Long = Memory.alloc(n + 1)
        var i: Int = 0
        while (i < n) {
            val c: Int = text.charCodeAt(i)
            var oc: Int = c
            if (c >= 65 && c <= 90) {
                oc = c + 32
            }
            Memory.write(buf + i, oc as Byte)
            i = i + 1
        }
        Memory.write(buf + n, 0 as Byte)
        val ab: Any = buf as Any
        return ab as String
    }

    /// Any → String（统一入口）。
    ///
    /// 供 VM 的**值输出/内建分派**使用：`toStr(v)` 直接写在 `Vm` 的方法里时，
    /// 自举 AOT 下对「刚从容器取回的值」会出现转换异常（实测 `collectArgs`
    /// 里同一次 `toStr(v)` 得到 "5"、返回的却是 "0"）。经由本函数的调用点
    /// 与 `VmOps.toI32(toStr(x))` 等既有可靠路径一致。
    fun toStrAny(v: Any): String {
        // P347：photon 运行时 toStr 是**纯整数**实现（入参直接按 Int 打十进制，
        // 不查 Plan A 装箱标签）——字符串指针会被打成指针值十进制（实测
        // println 打出 140699966958608 = 0x7FF6.. 指针值）。此处按 Plan A
        // 标签分派：装箱整数（奇数）→ 拆箱 toStr；真实指针（字符串等）→
        // 原样；null → "null"。种子 VM 下 isTaggedInt 恒 false，typeof 准确，
        // 走指针分支 = 字符串原样，行为不变。
        // R65：种子 VM 下 Boolean/Int 也不是 tagged（isTaggedInt 恒 false），
        // 但 `v as String` 对 int64 载荷会抛 "as cast failed"。走 typeof
        // 分支：Int/Boolean → 打十进制；String → 原样；其它 → "null"。
        if (v == null) {
            return "null"
        }
        if (isTaggedInt(v)) {
            return toStr(intOf(v))
        }
        // 种子 VM：typeof 区分 Int/Boolean/String。
        // ⚠️ 必须用裸 `typeof`（内建），不能用 `VmOps.typeof`：
        // Photon AOT 只把裸 `typeof` 映射到 runtime 符号 `aura_typeof`
        // （见 InstructionSelection.isRuntimeSymbol），`VmOps.typeof` 会
        // 解析成外部符号 `VmOps_typeof`（未定义）导致链接失败。
        val kind: String = typeof(v)
        if (kind == "Int" || kind == "Long" || kind == "Boolean") {
            return toStr(v as Long)
        }
        if (kind == "String") {
            return v as String
        }
        return toStr(v)
    }

    /// Int → String（不依赖 toStr，避免 AOT 转换问题）。
    fun intToStr(n: Int): String {
        if (n == 0) return "0"
        var neg: Boolean = false
        if (n < 0) {
            neg = true
            n = -n
        }
        var result: String = ""
        while (n > 0) {
            val digit: Int = n % 10
            var ch: String = ""
            if (digit == 0) ch = "0"
            else if (digit == 1) ch = "1"
            else if (digit == 2) ch = "2"
            else if (digit == 3) ch = "3"
            else if (digit == 4) ch = "4"
            else if (digit == 5) ch = "5"
            else if (digit == 6) ch = "6"
            else if (digit == 7) ch = "7"
            else if (digit == 8) ch = "8"
            else ch = "9"
            result = ch + result
            n = n / 10
        }
        if (neg) result = "-" + result
        return result
    }

    /// 字符串是否全为十进制数字（用于「函数序号」形式的调用目标）。
    fun isAllDigits(s: String): Boolean {
        if (s == null || s == "") {
            return false
        }
        var i: Int = 0
        val sLen2: Int = s.length
        while (i < sLen2) {
            val c: Int = s.charCodeAt(i)
            if (c < 48 || c > 57) {
                return false
            }
            i = i + 1
        }
        return true
    }

    // ═══════════════════════════════════════════════════════════
    //  字符串工具（FFI 原生函数支持）
    // ═══════════════════════════════════════════════════════════

    /// 判断字符串是否包含子串。
    fun contains(text: String, sub: String): Boolean {
        if (sub == "" || sub == null) {
            return true
        }
        if (text == null || text.length < sub.length) {
            return false
        }
        val tLen: Int = text.length
        val sLen: Int = sub.length
        var i: Int = 0
        while (i <= tLen - sLen) {
            var j: Int = 0
            var match: Boolean = true
            while (j < sLen) {
                if (text.charCodeAt(i + j) != sub.charCodeAt(j)) {
                    match = false
                    break
                }
                j = j + 1
            }
            if (match) {
                return true
            }
            i = i + 1
        }
        return false
    }

    /// 去除首尾空白字符。
    fun trim(text: String): String {
        if (text == null || text == "") {
            return ""
        }
        var start: Int = 0
        var end: Int = text.length
        while (start < end && isSpace(text.charCodeAt(start))) {
            start = start + 1
        }
        while (end > start && isSpace(text.charCodeAt(end - 1))) {
            end = end - 1
        }
        if (start >= end) {
            return ""
        }
        return text.substring(start, end)
    }

    /// 判断字符串是否以指定前缀开头。
    fun startsWith(text: String, prefix: String): Boolean {
        if (prefix == "" || prefix == null) {
            return true
        }
        if (text == null || text.length < prefix.length) {
            return false
        }
        var i: Int = 0
        val prefixLen: Int = prefix.length
        while (i < prefixLen) {
            if (text.charCodeAt(i) != prefix.charCodeAt(i)) {
                return false
            }
            i = i + 1
        }
        return true
    }

    /// 判断字符串是否以指定后缀结尾。
    fun endsWith(text: String, suffix: String): Boolean {
        if (suffix == "" || suffix == null) {
            return true
        }
        if (text == null || text.length < suffix.length) {
            return false
        }
        val diff: Int = text.length - suffix.length
        var i: Int = 0
        val suffixLen: Int = suffix.length
        while (i < suffixLen) {
            if (text.charCodeAt(diff + i) != suffix.charCodeAt(i)) {
                return false
            }
            i = i + 1
        }
        return true
    }

    /// 查找子串在文本中的首次出现位置（从 start 开始搜索），未找到返回 -1。
    fun indexOf(text: String, sub: String, start: Int): Int {
        if (sub == "" || sub == null) {
            return start
        }
        if (text == null || text.length < sub.length) {
            return -1
        }
        val tLen: Int = text.length
        val sLen: Int = sub.length
        var i: Int = start
        if (i < 0) { i = 0 }
        while (i <= tLen - sLen) {
            var j: Int = 0
            var match: Boolean = true
            while (j < sLen) {
                if (text.charCodeAt(i + j) != sub.charCodeAt(j)) {
                    match = false
                    break
                }
                j = j + 1
            }
            if (match) {
                return i
            }
            i = i + 1
        }
        return -1
    }

    /// 替换字符串中的所有子串出现。
    fun replace(text: String, old: String, newStr: String): String {
        if (old == "" || old == null) {
            return text
        }
        var result: String = ""
        var i: Int = 0
        var len: Int = text.length
        var oLen: Int = old.length
        while (i < len) {
            if (i + oLen <= len) {
                var j: Int = 0
                var match: Boolean = true
                while (j < oLen) {
                    if (text.charCodeAt(i + j) != old.charCodeAt(j)) {
                        match = false
                        break
                    }
                    j = j + 1
                }
                if (match) {
                    result = result + newStr
                    i = i + oLen
                    continue
                }
            }
            result = result + String.fromCharCode(text.charCodeAt(i))
            i = i + 1
        }
        return result
    }

    /// 计算浮点数平方根（牛顿迭代法）。
    fun sqrt(v: Float): Float {
        if (v < 0.0f) {
            return 0.0f
        }
        if (v == 0.0f) {
            return 0.0f
        }
        var guess: Float = v / 2.0f
        if (guess == 0.0f) {
            guess = 0.0001f
        }
        var i: Int = 0
        while (i < 100) {
            val next: Float = (guess + v / guess) / 2.0f
            if (absf(next - guess) < 0.00001f) {
                break
            }
            guess = next
            i = i + 1
        }
        return guess
    }

    /// 计算浮点幂次（base^exp）。
    fun pow(base: Float, exp: Float): Float {
        if (base == 0.0f) {
            return 0.0f
        }
        if (exp == 0.0f) {
            return 1.0f
        }
        if (exp == 1.0f) {
            return base
        }
        if (exp == 2.0f) {
            return base * base
        }
        if (exp == 0.5f) {
            return sqrt(base)
        }
        // 通用实现：exp^ln(base) 近似
        var result: Float = 1.0f
        var e: Float = exp
        var neg: Boolean = false
        if (e < 0.0f) {
            neg = true
            e = -e
        }
        var i: Int = 0
        while (e > 0.0f) {
            result = result * base
            e = e - 1.0f
            i = i + 1
            if (i > 1000000) {
                break
            }
        }
        if (neg) {
            return 1.0f / result
        }
        return result
    }

    /// 浮点绝对值。
    fun absf(v: Float): Float {
        if (v < 0.0f) {
            return -v
        }
        return v
    }

    /// 在函数表中查找函数偏移（`name|起始行|参数个数`）。
    ///
    /// `funcName` 支持两种形式：
    ///   * 函数名（Aura 前端生成的文本字节码）；
    ///   * **十进制序号**（`.auc` 二进制里 `CALL` 的操作数是函数下标），
    ///     按函数表**行序**（0 起）解析。
    /// 在函数表中查找函数入口偏移（未找到返回 0）。
    ///
    /// 表格式：每行 `name|offset|paramCount`，`\n` 分隔。
    ///
    /// ⚠️ P388：**纯字符扫描，不经 split/ArrayList/vmSubstr**——AOT 下
    /// `ArrayList<String>` 的 add/size/get 相互不一致（实测 split("main|0|0")
    /// 返回 size=3 而 get(1)="0|0"，即第二管道未切分的产物），致使
    /// fibonacci 的偏移被解析成 toI32("868|1")=8681（toI32Raw 跳过非数字
    /// 继续累加）→ ip 跑飞越界 → VM 静默停机（rc=0 无输出，2026-10-06）。
    /// 三个字段全部用下标扫描切分，`indexOf` 家族的既有可靠路径。
    fun findFuncOffset(funcTable: String, funcName: String): Int {
        if (funcTable == null || funcTable == "" || funcName == "") {
            return 0
        }
        var row: Int = 0
        var result: Int = 0
        var len: Int = funcTable.length
        var start: Int = 0
        while (start < len) {
            var end: Int = start
            while (end < len && funcTable.charCodeAt(end) != 10) {
                end = end + 1
            }
            if (end > start) {
                // 行内三段：name = [start, p1)，off = [p1+1, p2)，pc = [p2+1, end)
                var p1: Int = start
                while (p1 < end && funcTable.charCodeAt(p1) != 124) {
                    p1 = p1 + 1
                }
                if (p1 < end) {
                    var p2: Int = p1 + 1
                    while (p2 < end && funcTable.charCodeAt(p2) != 124) {
                        p2 = p2 + 1
                    }
                    // name 精确匹配：长度相等且逐字符一致
                    if (p1 - start == funcName.length) {
                        var match: Boolean = true
                        var ci: Int = 0
                        val funcNameLen: Int = funcName.length
                        while (ci < funcNameLen) {
                            if (funcTable.charCodeAt(start + ci) != funcName.charCodeAt(ci)) {
                                match = false
                                ci = funcNameLen
                            }
                            ci = ci + 1
                        }
                        if (match) {
                            if (p2 < end) {
                                result = toI32Range(funcTable, p1 + 1, p2)
                            } else {
                                result = toI32Range(funcTable, p1 + 1, end)
                            }
                            return result
                        }
                    }
                }
                row = row + 1
            }
            start = end + 1
        }
        return result
    }

    /// 在函数表中查找函数参数个数（语义同 [`findFuncOffset`]）。
    /// P388：与 findFuncOffset 同款纯字符扫描（split/ArrayList 不可靠家族回避）。
    fun findFuncParamCount(funcTable: String, funcName: String): Int {
        if (funcTable == null || funcTable == "" || funcName == "") {
            return -1
        }
        var result: Int = -1
        var len: Int = funcTable.length
        var start: Int = 0
        while (start < len) {
            var end: Int = start
            while (end < len && funcTable.charCodeAt(end) != 10) {
                end = end + 1
            }
            if (end > start) {
                var p1: Int = start
                while (p1 < end && funcTable.charCodeAt(p1) != 124) {
                    p1 = p1 + 1
                }
                if (p1 < end) {
                    var p2: Int = p1 + 1
                    while (p2 < end && funcTable.charCodeAt(p2) != 124) {
                        p2 = p2 + 1
                    }
                    if (p1 - start == funcName.length) {
                        var match: Boolean = true
                        var ci: Int = 0
                        val funcNameLen2: Int = funcName.length
                        while (ci < funcNameLen2) {
                            if (funcTable.charCodeAt(start + ci) != funcName.charCodeAt(ci)) {
                                match = false
                                ci = funcNameLen2
                            }
                            ci = ci + 1
                        }
                        if (match) {
                            if (p2 < end) {
                                result = toI32Range(funcTable, p2 + 1, end)
                            } else {
                                result = -1
                            }
                            return result
                        }
                    }
                }
            }
            start = end + 1
        }
        return result
    }

    /// P388：区间整数解析——`[from, to)` 内的十进制数字（非数字即停）。
    /// 不产子串：回避 substring/vmSubstr/split 的 AOT 不可靠家族。
    /// （对比 [`toI32Raw`]：后者跳过非数字继续累加，`"868|1"` 会被解析成 8681。）
    fun toI32Range(text: String, from: Int, to: Int): Int {
        var total: Int = 0
        var i: Int = from
        var neg: Boolean = false
        if (i < to && text.charCodeAt(i) == 45) {
            neg = true
            i = i + 1
        }
        while (i < to) {
            val c: Int = text.charCodeAt(i)
            if (c < 48 || c > 57) {
                break
            }
            total = total * 10 + (c - 48)
            i = i + 1
        }
        if (neg) {
            return -total
        }
        return total
    }

    /// 按分隔符分割字符串。
    fun split(text: String, sep: String): List<String> {
        val result: List<String> = arrayListOf<String>()
        if (text == null || text == "") {
            return result
        }
        var start: Int = 0
        var i: Int = 0
        var len: Int = text.length
        while (i < len) {
            if (sep.length == 1 && text.charCodeAt(i) == sep.charCodeAt(0)) {
                result.add(vmSubstr(text, start, i - start))
                start = i + 1
            }
            i = i + 1
        }
        if (start < len) {
            result.add(vmSubstr(text, start, len - start))
        }
        return result
    }

    /// 获取字符串中第 idx 行（按换行符分隔）。
    fun getFieldAt(text: String, idx: Int, sep: String): Any {
        if (text == null || text == "") {
            return ""
        }
        if (idx < 0) {
            return ""
        }
        var start: Int = 0
        var i: Int = 0
        var len: Int = text.length
        var count: Int = 0
        while (i < len) {
            if (sep.length == 1 && text.charCodeAt(i) == sep.charCodeAt(0)) {
                if (count == idx) {
                    return vmSubstr(text, start, i - start)
                }
                count = count + 1
                start = i + 1
            }
            i = i + 1
        }
        if (count == idx) {
            return vmSubstr(text, start, len - start)
        }
        return ""
    }

    /// 按字段分隔符提取指定列。
    fun fieldAt(text: String, col: Int, sep: String): String {
        if (text == null || text == "") {
            return ""
        }
        if (col < 0) {
            return ""
        }
        var start: Int = 0
        var i: Int = 0
        var len: Int = text.length
        var count: Int = 0
        while (i < len) {
            if (sep.length == 1 && text.charCodeAt(i) == sep.charCodeAt(0)) {
                if (count == col) {
                    return vmSubstr(text, start, i - start)
                }
                count = count + 1
                start = i + 1
            }
            i = i + 1
        }
        if (count == col) {
            return vmSubstr(text, start, len - start)
        }
        return ""
    }

    /// 字符串转整数（别名）。
    fun toIntOf(s: String): Int {
        return toI32(s)
    }
}
