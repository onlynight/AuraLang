// aura:///aura/lang/compiler/vm/FrameManager.aura
package aura.lang.compiler.vm
// ─────────────────────────────────────────────────────────────
// 栈帧管理器 — 纯 Aura 化迁移 · Phase 5 (任务 5.3)
//
// 对应 Rust `compiler/src/vm/frames.rs` 的增强版本。
//
// ── 设计方式 ──
//
// 使用 Frame 类 + ArrayList<Frame> 存储帧链（替代旧版字符串编码）。
// 帧数据 O(1) 访问，无字符串重建开销。
//
// ── 增强特性（Phase 5）──
//
//   1. 可配置栈大小和局部变量槽数
//   2. 栈溢出保护（MAX_STACK_DEPTH）
//   3. 帧链管理（支持闭包的上值链）
//   4. 帧分配/释放（分配局部变量槽）
//   5. 尾调用帧复用（不创建新帧）
//
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String
import aura.lang.compiler.lexer.Span
import aura.lang.collection.ArrayList
import aura.lang.collection.HashMap

/// 栈帧（结构化对象，替代旧版字符串编码）。
class Frame {
    private var id: Int = 0
    private var funcName: String = ""
    private var ip: Int = 0
    private var arity: Int = 0
    private var localsCount: Int = 0
    private var upvalues: String = ""

    init() {
        this.id = 0
        this.funcName = ""
        this.ip = 0
        this.arity = 0
        this.localsCount = 0
        this.upvalues = ""
    }
}

/// 增强栈帧管理器。
class FrameManager {

    private var stackSize: Int = 64

    /// 默认局部变量槽数量。
    private var localsSize: Int = 32

    /// 最大栈深度。
    private var maxStackDepth: Int = 256

    /// 最大调用深度。
    private var maxCallDepth: Int = 64

    /// 帧链表（原生堆列表，O(1) 访问）。
    ///
    /// **不能用 `ArrayList<Frame>` 类**：其构造器内部用 `mutableListOf`，
    /// 而 `mutableListOf` 的实现又是 `ArrayList<Any>(items)`；
    /// 自举 AOT 下这条环会变成无限递归（构造即栈溢出）。原生堆列表没有该问题。
    private var frames: List<Frame> = arrayListOf<Frame>()

    /// 栈内存（HashMap 实现，O(1) get/set）。
    private var stackMemory: HashMap<Int, String> = HashMap<Int, String>()

    /// 帧总数。
    private var frameCount: Int = 0

    /// 当前帧计数（调用深度）。
    private var callDepth: Int = 0

    /// 下一个帧 id。
    private var nextFrameId: Int = 0

    /// 栈溢出标志。
    private var stackOverflow: Boolean = false

    /// 栈分配总量（字节）。
    private var totalAllocated: Int = 0

    init() {
        this.stackSize = 64
        this.localsSize = 32
        this.maxStackDepth = 256
        this.maxCallDepth = 64
        this.frames = arrayListOf<Frame>()
        this.stackMemory = HashMap<Int, String>()
        this.frameCount = 0
        this.callDepth = 0
        this.nextFrameId = 0
        this.stackOverflow = false
        this.totalAllocated = 0
    }

    // ── 帧分配 ──

    /// 分配新栈帧，返回帧 id。
    fun allocateFrame(funcName: String, arity: Int): Int {
        // 检查调用深度
        if (this.callDepth >= this.maxCallDepth) {
            this.stackOverflow = true
            return -1
        }

        val id: Int = this.nextFrameId
        this.nextFrameId = this.nextFrameId + 1

        // 计算局部变量槽数
        val locals: Int = arity + this.localsSize

        // 分配栈内存
        val slotBase: Int = this.totalAllocated
        this.totalAllocated = this.totalAllocated + locals

        // 检查栈溢出
        if (this.totalAllocated > this.stackSize * 4) {
            this.stackOverflow = true
            return -1
        }

        // 创建帧对象
        val frame: Frame = Frame()
        frame.id = id
        frame.funcName = funcName
        frame.ip = 0
        frame.arity = arity
        frame.localsCount = locals
        frame.upvalues = ""

        this.frames.add(frame)
        this.frameCount = this.frameCount + 1
        this.callDepth = this.callDepth + 1

        return id
    }

    /// 释放栈帧（LIFO 释放）。
    fun deallocateFrame(frameId: Int): Unit {
        if (this.callDepth > 0) {
            // 从尾部移除（LIFO）
            if (this.frames.size > 0) {
                this.frames.remove(this.frames.size - 1)
            }
            this.callDepth = this.callDepth - 1
        }
    }

    // ── 帧查询 ──

    /// 查询帧的函数名。
    fun frameFuncName(frameId: Int): String {
        if (frameId < 0 || frameId >= this.frames.size) return ""
        return this.frames.get(frameId).funcName
    }

    /// 查询帧的指令指针。
    fun frameIp(frameId: Int): Int {
        if (frameId < 0 || frameId >= this.frames.size) return 0
        return this.frames.get(frameId).ip
    }

    /// 查询帧的参数数量。
    fun frameArity(frameId: Int): Int {
        if (frameId < 0 || frameId >= this.frames.size) return 0
        return this.frames.get(frameId).arity
    }

    /// 查询帧的局部变量槽数。
    fun frameLocals(frameId: Int): Int {
        if (frameId < 0 || frameId >= this.frames.size) return 0
        return this.frames.get(frameId).localsCount
    }

    /// 查询帧的上值列表。
    fun frameUpvalues(frameId: Int): String {
        if (frameId < 0 || frameId >= this.frames.size) return ""
        return this.frames.get(frameId).upvalues
    }

    // ── 栈操作 ──

    /// 设置指令指针。
    fun setIp(frameId: Int, ip: Int): Unit {
        if (frameId < 0 || frameId >= this.frames.size) return
        this.frames.get(frameId).ip = ip
    }

    /// 获取栈内存值。
    fun getStackValue(slotIdx: Int): String {
        val v = this.stackMemory.get(slotIdx)
        if (toStr(v) == "null") return "0"
        return v
    }

    /// 设置栈内存值。
    fun setStackValue(slotIdx: Int, value: String): Unit {
        this.stackMemory.put(slotIdx, value)
    }

    // ── 帧链管理（闭包支持）──

    /// 附加上值到帧（闭包捕获）。
    fun attachUpvalues(frameId: Int, upvalueIds: String): Unit {
        if (frameId < 0 || frameId >= this.frames.size) return
        this.frames.get(frameId).upvalues = upvalueIds
    }

    /// 查找父帧（通过 upvalues 链）。
    fun findParentFrame(frameId: Int): Int {
        // 简化：返回 -1 表示无父帧
        return -1
    }

    // ── 尾调用帧复用 ──

    /// 复用当前帧（尾调用优化）。
    fun reuseFrame(frameId: Int, newArity: Int): Boolean {
        if (frameId < 0 || frameId >= this.frames.size) return false
        val frame = this.frames.get(frameId)
        // 更新参数数量
        frame.arity = newArity
        // 重置指令指针
        frame.ip = 0
        return true
    }

    // ── 状态查询 ──

    /// 获取当前调用深度。
    fun getCallDepth(): Int {
        return this.callDepth
    }

    /// 获取帧总数。
    fun getFrameCount(): Int {
        return this.frameCount
    }

    /// 检查栈是否溢出。
    fun isStackOverflow(): Boolean {
        return this.stackOverflow
    }

    /// 获取总分配量。
    fun getTotalAllocated(): Int {
        return this.totalAllocated
    }

    /// 获取当前栈深度。
    fun getStackDepth(): Int {
        return this.totalAllocated
    }
}
