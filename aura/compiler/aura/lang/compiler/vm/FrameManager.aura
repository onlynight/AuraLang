// aura:///aura/lang/compiler/vm/FrameManager.aura
package aura.lang.compiler.vm
// ─────────────────────────────────────────────────────────────
// 栈帧管理器 — 纯 Aura 化迁移 · Phase 5 (任务 5.3)
//
// 对应 Rust `compiler/src/vm/frames.rs` 的增强版本。
//
// ── 设计方式 ──
//
// 使用 HashMap 存储帧数据（替代 List<Frame>，后者在 AOT 下有类型推断问题）。
// 每帧 6 个字段分别存储在独立 HashMap 中，O(1) 访问。
//
// ── 增强特性（Phase 5）──
//
//   1. 可配置栈大小和局部变量槽数
//   2. 栈溢出保护（MAX_STACK_DEPTH）
//   3. 帧链管理（支持闭包的上值链）
//   4. 帧分配/释放（分配局部变量槽）
//   5. 尾调用帧复用（不创建新帧）
//
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String
import aura.lang.compiler.lexer.Span
import aura.lang.collection.HashMap

/// 增强栈帧管理器。
class FrameManager {

    private var stackSize: Int = 64

    /// 默认局部变量槽数量。
    private var localsSize: Int = 32

    /// 最大栈深度。
    private var maxStackDepth: Int = 256

    /// 最大调用深度。
    private var maxCallDepth: Int = 64

    /// 帧数据（独立 HashMap 存储各字段）。
    private var frameFuncNames: HashMap<Int, String> = HashMap<Int, String>()
    private var frameArity: HashMap<Int, Int> = HashMap<Int, Int>()
    private var frameIp: HashMap<Int, Int> = HashMap<Int, Int>()
    private var frameLocals: HashMap<Int, Int> = HashMap<Int, Int>()
    private var frameUpvalues: HashMap<Int, String> = HashMap<Int, String>()

    /// 栈内存（HashMap 实现，O(1) get/set）。
    private var stackMemory: HashMap<Int, String> = HashMap<Int, String>()

    /// 帧总数。
    private var frameCount: Int = 0

    /// 当前帧计数（调用深度）。
    private var callDepth: Int = 0

    /// 下一个帧 id。
    private var nextFrameId: Int = 0

    /// 栈溢出标志。
    private var stackOverflow: Boolean = false

    /// 栈分配总量（字节）。
    private var totalAllocated: Int = 0

    init() {
        this.stackSize = 64
        this.localsSize = 32
        this.maxStackDepth = 256
        this.maxCallDepth = 64
        this.frameFuncNames = HashMap<Int, String>()
        this.frameArity = HashMap<Int, Int>()
        this.frameIp = HashMap<Int, Int>()
        this.frameLocals = HashMap<Int, Int>()
        this.frameUpvalues = HashMap<Int, String>()
        this.stackMemory = HashMap<Int, String>()
        this.frameCount = 0
        this.callDepth = 0
        this.nextFrameId = 0
        this.stackOverflow = false
        this.totalAllocated = 0
    }

    // ── 帧分配 ──

    /// 分配新栈帧，返回帧 id。
    fun allocateFrame(funcName: String, arity: Int): Int {
        // 检查调用深度
        if (this.callDepth >= this.maxCallDepth) {
            this.stackOverflow = true
            return -1
        }

        val id: Int = this.nextFrameId
        this.nextFrameId = this.nextFrameId + 1

        // 计算局部变量槽数
        val locals: Int = arity + this.localsSize

        // 分配栈内存
        val slotBase: Int = this.totalAllocated
        this.totalAllocated = this.totalAllocated + locals

        // 检查栈溢出
        if (this.totalAllocated > this.stackSize * 4) {
            this.stackOverflow = true
            return -1
        }

        // 存储帧数据
        this.frameFuncNames.put(id, funcName)
        this.frameIp.put(id, 0)
        this.frameArity.put(id, arity)
        this.frameLocals.put(id, locals)
        this.frameUpvalues.put(id, "")

        this.frameCount = this.frameCount + 1
        this.callDepth = this.callDepth + 1

        return id
    }

    /// 释放栈帧（LIFO 释放）。
    fun deallocateFrame(frameId: Int): Unit {
        if (this.callDepth > 0) {
            this.frameFuncNames.remove(frameId)
            this.frameIp.remove(frameId)
            this.frameArity.remove(frameId)
            this.frameLocals.remove(frameId)
            this.frameUpvalues.remove(frameId)
            this.callDepth = this.callDepth - 1
            this.frameCount = this.frameCount - 1
        }
    }

    // ── 帧查询 ──

    /// 查询帧的函数名。
    fun frameFuncName(frameId: Int): String {
        val v = this.frameFuncNames.get(frameId)
        if (v == null) return ""
        return v
    }

    /// 查询帧的指令指针。
    fun frameIp(frameId: Int): Int {
        val v = this.frameIp.get(frameId)
        if (v == null) return 0
        return v as Int
    }

    /// 查询帧的参数数量。
    fun frameArity(frameId: Int): Int {
        val v = this.frameArity.get(frameId)
        if (v == null) return 0
        return v as Int
    }

    /// 查询帧的局部变量槽数。
    fun frameLocals(frameId: Int): Int {
        val v = this.frameLocals.get(frameId)
        if (v == null) return 0
        return v as Int
    }

    /// 查询帧的上值列表。
    fun frameUpvalues(frameId: Int): String {
        val v = this.frameUpvalues.get(frameId)
        if (v == null) return ""
        return v
    }

    // ── 栈操作 ──

    /// 设置指令指针。
    fun setIp(frameId: Int, ip: Int): Unit {
        this.frameIp.put(frameId, ip)
    }

    /// 获取栈内存值。
    fun getStackValue(slotIdx: Int): String {
        val v = this.stackMemory.get(slotIdx)
        if (v == null) return "0"
        return v
    }

    /// 设置栈内存值。
    fun setStackValue(slotIdx: Int, value: String): Unit {
        this.stackMemory.put(slotIdx, value)
    }

    // ── 帧链管理（闭包支持）──

    /// 附加上值到帧（闭包捕获）。
    fun attachUpvalues(frameId: Int, upvalueIds: String): Unit {
        this.frameUpvalues.put(frameId, upvalueIds)
    }

    /// 查找父帧（通过 upvalues 链）。
    fun findParentFrame(frameId: Int): Int {
        // 简化：返回 -1 表示无父帧
        return -1
    }

    // ── 尾调用帧复用 ──

    /// 复用当前帧（尾调用优化）。
    fun reuseFrame(frameId: Int, newArity: Int): Boolean {
        val current = this.frameArity.get(frameId)
        if (current == null) return false
        // 更新参数数量
        this.frameArity.put(frameId, newArity)
        // 重置指令指针
        this.frameIp.put(frameId, 0)
        return true
    }

    // ── 状态查询 ──

    /// 获取当前调用深度。
    fun getCallDepth(): Int {
        return this.callDepth
    }

    /// 获取帧总数。
    fun getFrameCount(): Int {
        return this.frameCount
    }

    /// 检查栈是否溢出。
    fun isStackOverflow(): Boolean {
        return this.stackOverflow
    }

    /// 获取总分配量。
    fun getTotalAllocated(): Int {
        return this.totalAllocated
    }

    /// 获取当前栈深度。
    fun getStackDepth(): Int {
        return this.totalAllocated
    }
}
