// aura:///aura/compiler/aura/lang/compiler/vm/VmStack.aura
package aura.lang.compiler.vm
// ─────────────────────────────────────────────────────────────
// VM 栈容器 — 自举编译器 AOT 兼容实现
//
// 为什么不用 `ArrayList<T>`：
//   自举编译器的 AOT 后端把「集合类型」按**前缀**判定（Emit.isCollectionTypeName），
//   而 `ArrayList` 以 `Array` 开头 → 被误判为裸集合句柄（`AuraDynList*`），
//   于是 `.add` / `.get` / `.size` 全部走原生集合路径，读到的 `_size` 恒为 0。
//   所以自举编译器自己的运行时容器必须用**原生堆列表**（`arrayListOf<T>()`）+ 显式
//   栈指针来承载，`d[i] = v` / `d.add(v)` / `d[i]` 均按 `List<T>` 语义正确发射。
//
// ── 用法 ──
//   push/pop/peek/size/clear，全部 O(1)。
// ─────────────────────────────────────────────────────────────

import aura.lang.collection.HashMap
import aura.lang.native.Memory

/// VM 值栈（元素为 `Any`）。
class VmStack {

    // P392: Memory raw buffer (same rationale as VmLocals) -- data-stack
    // push/pop is the fixed pairing cost of every arithmetic instruction.
    // Any values stored/loaded as raw 64-bit representations.
    private var mc: Long = 0
    private var sp: Int = 0
    private var cap: Int = 0
    // P1-RETAIN 诊断：倍增次数（旧缓冲被丢弃的累计次数）。
    private var capGrow: Int = 0

    fun push(v: Any): Unit {
        // P366: read sp/cap into locals once (photon CSE hazard).
        val sp0: Int = this.sp
        val cap0: Int = this.cap
        if (sp0 < cap0) {
            Memory.write64(this.mc + sp0 * 8, v as Long)
        } else {
            val newCap: Int = cap0 * 2 + 64
            val nb: Long = Memory.alloc(newCap * 8)
            var j: Int = 0
            while (j < sp0) {
                Memory.write64(nb + j * 8, Memory.read64(this.mc + j * 8))
                j = j + 1
            }
            this.mc = nb
            this.cap = newCap
            Memory.write64(this.mc + sp0 * 8, v as Long)
            // P1-RETAIN 诊断（2026-10-08）：记录每次倍增的旧容量，
            // 供 [MEMPROBE] 汇总报告——「倍增次数」是栈顶单调上升的直接信号。
            // 旧实现每次倍增后丢弃旧缓冲指针、仅更新 this.cap，外部只能
            // 看到最终容量，看不出增长过程。此处把旧 cap 写入递增计数器。
            val grow: Int = this.capGrow
            this.capGrow = grow + 1
        }
        this.sp = sp0 + 1
    }

    fun pop(): Any {
        val sp0: Int = this.sp
        if (sp0 <= 0) {
            return null
        }
        this.sp = sp0 - 1
        return Memory.read64(this.mc + (sp0 - 1) * 8) as Any
    }

    fun peek(): Any {
        val sp0: Int = this.sp
        if (sp0 <= 0) {
            return null
        }
        return Memory.read64(this.mc + (sp0 - 1) * 8) as Any
    }

    fun size(): Int {
        // [R19] P366 可靠模式：字段读先入局部——旧体 `return this.sp` 的
        // photon 产码在 VmStack 上实测恒返回 0（[X] 探针 sp 列全程 0），
        // collectArgs 的 `base = size() - argc` 因此变负下标。四个栈类同款
        // body 一并改写。
        val s0: Int = this.sp
        return s0
    }

    /// 当前容量（已倍增到的槽数）。P1-RETAIN 诊断用：容量应受活跃深度约束，
    /// 若无限倍增即栈顶单调上升（RETAIN 未配对 RELEASE）。
    fun cap(): Int {
        return this.cap
    }

    /// 倍增次数（旧缓冲被丢弃的累计次数）。P1-RETAIN 诊断用。
    fun capGrow(): Int {
        return this.capGrow
    }

    /// [R19] 唯一名通道：`size` 与四个栈类 + 集合族撞名，photon 产码把
    /// `stack.size()` 调用解析到错误目标（实测恒 0）；唯一名无撞名面，
    /// [X] 探针对照实验证实本方法返回正确 sp（push→1 / pop→0）。
    /// **生产路径一律走本名**（Vm.aura 已全部替换）。
    fun stackDepth(): Int {
        val s0: Int = this.sp
        return s0
    }

    fun vmSlotAt(i: Int): Any {
        // [R19] P366 可靠模式：sp 先入局部再判定（同 size() 的错译规避）
        val sp0: Int = this.sp
        if (i < 0 || i >= sp0) {
            return null
        }
        return Memory.read64(this.mc + i * 8) as Any
    }

    fun clear(): Unit {
        this.sp = 0
    }
}
class VmStrStack {

    private var d: List<String> = arrayListOf<String>()
    private var sp: Int = 0
    private var cap: Int = 0

    fun push(v: String): Unit {
        if (this.sp < this.cap) {
            this.d[this.sp] = v
        } else {
            this.d.add(v)
            this.cap = this.cap + 1
        }
        this.sp = this.sp + 1
    }

    fun pop(): String {
        if (this.sp <= 0) {
            return ""
        }
        this.sp = this.sp - 1
        return this.d[this.sp]
    }

    fun peek(): String {
        if (this.sp <= 0) {
            return ""
        }
        return this.d[this.sp - 1]
    }

    fun size(): Int {
        // [R19] P366 可靠模式：字段读先入局部——旧体 `return this.sp` 的
        // photon 产码在 VmStack 上实测恒返回 0（[X] 探针 sp 列全程 0），
        // collectArgs 的 `base = size() - argc` 因此变负下标。四个栈类同款
        // body 一并改写。
        val s0: Int = this.sp
        return s0
    }

    fun clear(): Unit {
        this.d = arrayListOf<String>()
        this.sp = 0
        this.cap = 0
    }
}

/// 保存的局部变量帧栈（函数调用时保存调用者的槽位表）。
class VmFrameStack {

    private var d: List<VmLocals> = arrayListOf<VmLocals>()
    private var sp: Int = 0
    private var cap: Int = 0

    fun push(v: VmLocals): Unit {
        if (this.sp < this.cap) {
            this.d[this.sp] = v
        } else {
            this.d.add(v)
            this.cap = this.cap + 1
        }
        this.sp = this.sp + 1
    }

    fun pop(): VmLocals {
        if (this.sp <= 0) {
            return VmLocals()
        }
        this.sp = this.sp - 1
        return this.d[this.sp]
    }

    fun size(): Int {
        // [R19] P366 可靠模式：字段读先入局部——旧体 `return this.sp` 的
        // photon 产码在 VmStack 上实测恒返回 0（[X] 探针 sp 列全程 0），
        // collectArgs 的 `base = size() - argc` 因此变负下标。四个栈类同款
        // body 一并改写。
        val s0: Int = this.sp
        return s0
    }

    fun clear(): Unit {
        this.d = arrayListOf<HashMap<Int, Any>>()
        this.sp = 0
        this.cap = 0
    }
}


/// VM 局部变量槽表（方案 D-2，2026-10-03）：平铺数组 + 代际标记。
///
/// 取代 `HashMap<Int, Any>`：槽号是小整数（0..N 连续），哈希表每次
/// get/put 的哈希+桶链开销在热路径上占每条访存指令 ~100ns。代际标记
/// 解决「帧切换后旧槽值残留」：reset() 只把 gen+1（零分配），put 写入
/// 当前代标记，get 仅当槽位标记 == 当前代才返回值（否则视为未初始化
/// → null，与空表语义一致）。
class VmLocals {

    // P392: Memory raw buffers (read64/write64 = single runtime mov) --
    // LOAD_LOCAL/STORE_LOCAL are the hottest instruction pair; the old
    // List<Any>/List<Int> accesses were Collections runtime calls.
    // Any slots stored/loaded as raw 64-bit representations (pointers and
    // tagged ints lossless); unwritten slots read 0 = null;
    // marks zero-init = 0 != gen.
    private var mcSlots: Long = 0
    private var mcMarks: Long = 0
    private var filled: Int = 0
    private var cap: Int = 0
    private var gen: Int = 1

    fun getSlot(k: Int): Any {
        if (k >= 0 && k < this.filled) {
            if ((Memory.read64(this.mcMarks + k * 8) as Int) == this.gen) {
                return Memory.read64(this.mcSlots + k * 8) as Any
            }
        }
        return null
    }

    fun putSlot(k: Int, v: Any): Unit {
        if (k >= this.filled) {
            if (k >= this.cap) {
                val newCap: Int = k * 2 + 64
                val ns: Long = Memory.alloc(newCap * 8)
                val nm: Long = Memory.alloc(newCap * 8)
                var j: Int = 0
                while (j < this.filled) {
                    Memory.write64(ns + j * 8, Memory.read64(this.mcSlots + j * 8))
                    Memory.write64(nm + j * 8, Memory.read64(this.mcMarks + j * 8))
                    j = j + 1
                }
                this.mcSlots = ns
                this.mcMarks = nm
                this.cap = newCap
            }
            this.filled = k + 1
        }
        Memory.write64(this.mcSlots + k * 8, v as Long)
        Memory.write64(this.mcMarks + k * 8, this.gen)
    }

    fun getSize(): Int {
        return this.filled
    }

    fun reset(): Unit {
        this.gen = this.gen + 1
    }
}

class VmCallStack {

    // P392: the three Int parallel columns Memory-ized (CALL/RET fixed
    // 4 List calls became 4 movs); funcs kept as String List (low
    // frequency -- currentFunc restore diagnostics).
    private var mcIps: Long = 0
    private var mcFrames: Long = 0
    private var mcClosures: Long = 0
    private var funcs: List<String> = arrayListOf<String>()
    private var sp: Int = 0
    private var cap: Int = 0

    fun push(ip: Int, frame: Int, func: String, closure: Int): Unit {
        if (this.sp < this.cap) {
            Memory.write64(this.mcIps + this.sp * 8, ip)
            Memory.write64(this.mcFrames + this.sp * 8, frame)
            this.funcs[this.sp] = func
            Memory.write64(this.mcClosures + this.sp * 8, closure)
        } else {
            val newCap: Int = this.cap * 2 + 64
            val ni: Long = Memory.alloc(newCap * 8)
            val nf: Long = Memory.alloc(newCap * 8)
            val nc: Long = Memory.alloc(newCap * 8)
            var j: Int = 0
            while (j < this.sp) {
                Memory.write64(ni + j * 8, Memory.read64(this.mcIps + j * 8))
                Memory.write64(nf + j * 8, Memory.read64(this.mcFrames + j * 8))
                Memory.write64(nc + j * 8, Memory.read64(this.mcClosures + j * 8))
                j = j + 1
            }
            this.mcIps = ni
            this.mcFrames = nf
            this.mcClosures = nc
            this.funcs.add(func)
            this.cap = newCap
            Memory.write64(this.mcIps + this.sp * 8, ip)
            Memory.write64(this.mcFrames + this.sp * 8, frame)
            Memory.write64(this.mcClosures + this.sp * 8, closure)
        }
        this.sp = this.sp + 1
    }

    fun pop(): Unit {
        if (this.sp > 0) {
            this.sp = this.sp - 1
        }
    }

    fun peekIp(): Int {
        if (this.sp <= 0) {
            return 0
        }
        return Memory.read64(this.mcIps + (this.sp - 1) * 8) as Int
    }

    fun peekClosure(): Int {
        if (this.sp <= 0) {
            return -1
        }
        return Memory.read64(this.mcClosures + (this.sp - 1) * 8) as Int
    }

    fun size(): Int {
        // [R19] P366 可靠模式：字段读先入局部——旧体 `return this.sp` 的
        // photon 产码在 VmStack 上实测恒返回 0（[X] 探针 sp 列全程 0），
        // collectArgs 的 `base = size() - argc` 因此变负下标。四个栈类同款
        // body 一并改写。
        val s0: Int = this.sp
        return s0
    }

    /// [R19] 唯一名通道（同 VmStack.stackDepth 的撞名规避）。
    fun callDepth(): Int {
        val s0: Int = this.sp
        return s0
    }

    fun reset(): Unit {
        this.sp = 0
    }
}
