// aura:///aura/lang/compiler/vm/VmRunner.aura
package aura.lang.compiler.vm
// ─────────────────────────────────────────────────────────────
// VM 运行器（P0 升级版）— 委托到完整 Vm 实现
//
// 保留 VmRunner 类名和公共接口以兼容 Main.aura / VmInstance.aura，
// 内部委托到 Vm（P0 完整指令集实现）。
//
// ── 公共接口（保持向后兼容）──
//   loadBytecode(code, consts, funcs)  → 加载字节码
//   run()                              → 执行，返回 Any
//   getError()                         → 获取错误信息
//   getInstructionCount()              → 获取指令计数
//   isRunning()                        → 检查运行状态
//   getStackDepth()                    → 获取栈深度
//   getExitCode()                      → 获取退出码
//   getClosures()                      → 获取闭包管理器（兼容）
//   getTailCall()                      → 获取尾调用优化器（兼容）
//   getFrames()                        → 获取栈帧管理器（兼容）
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String
import aura.lang.collection.ArrayList
import aura.lang.collection.HashMap
import aura.lang.compiler.vm.Closures
import aura.lang.compiler.vm.TailCall
import aura.lang.compiler.vm.FrameManager
import aura.lang.compiler.vm.Opcodes
import aura.lang.compiler.vm.Vm
import aura.lang.compiler.vm.VmOps

/// VM 运行器工具对象（保留兼容的 vrToInt 辅助函数）。
object VmRunnerUtils {

    /// 字符串转整数。
    fun vrToInt(text: String): Int {
        var total: Int = 0
        var i: Int = 0
        var len: Int = text.length
        var neg: Boolean = false
        if (len > 0 && text.charCodeAt(0) == 45) {
            neg = true
            i = 1
        }
        while (i < len) {
            val c: Int = text.charCodeAt(i)
            if (c < 48 || c > 57) {
                break
            }
            total = total * 10 + (c - 48)
            i = i + 1
        }
        if (neg) {
            return -total
        }
        return total
    }
}

/// VM 运行器（P0 升级版：委托到完整 Vm）。
class VmRunner {

    /// 底层 VM 实例。
    private var vm: Vm = Vm()

    /// 闭包管理器（兼容接口）。
    private var closures: ClosureManager = ClosureManager()

    /// 尾调用优化器（兼容接口）。
    private var tailCall: TailCallOptimizer = TailCallOptimizer()

    /// 栈帧管理器（兼容接口）。
    private var frames: FrameManager = FrameManager()

    /// 字节码文本（保留兼容字段）。
    private var bytecode: String = ""

    /// 常量池文本（保留兼容字段）。
    private var constPool: String = ""

    /// 函数表文本（保留兼容字段）。
    private var funcTable: String = ""

    /// 错误信息（保留兼容字段）。
    private var error: String = ""

    /// 运行状态（保留兼容字段）。
    private var running: Boolean = false

    /// 返回值（保留兼容字段）。
    private var returnValue: Any = null

    /// 指令计数（保留兼容字段）。
    private var instructionCount: Int = 0

    /// 协程调度器（兼容字段）。
    private var coroutineScheduler: Any = null

    /// 挂起状态（兼容字段）。
    private var suspended: Boolean = false

    init() {
        this.vm = Vm()
        this.closures = ClosureManager()
        this.tailCall = TailCallOptimizer()
        this.frames = FrameManager()
        this.bytecode = ""
        this.constPool = ""
        this.funcTable = ""
        this.error = ""
        this.running = false
        this.returnValue = null
        this.instructionCount = 0
        this.coroutineScheduler = null
        this.suspended = false
    }

    // ═══════════════════════════════════════════════════════════
    //  公共接口（向后兼容）
    // ═══════════════════════════════════════════════════════════

    /// 加载字节码。
    fun loadBytecode(code: String, consts: String, funcs: String): Unit {
        this.bytecode = code
        this.constPool = consts
        this.funcTable = funcs
        this.error = ""
        this.running = false
        this.returnValue = null
        this.instructionCount = 0
        this.vm.loadBytecode(code, consts, funcs)
    }

    /// 执行字节码，返回结果。
    fun run(): Any {
        this.running = true
        this.returnValue = this.vm.run()
        this.error = this.vm.getError()
        this.instructionCount = this.vm.getInstructionCount()
        if (this.vm.getError() != "") {
            this.running = false
        }
        return this.returnValue
    }

    /// 从二进制 .auc 文件加载并执行。
    fun loadAucAndRun(path: String): Any {
        this.returnValue = this.vm.loadAucAndRun(path)
        this.error = this.vm.getError()
        this.instructionCount = this.vm.getInstructionCount()
        return this.returnValue
    }

    /// 获取错误信息。
    fun getError(): String {
        return this.vm.getError()
    }

    /// 获取指令计数。
    fun getInstructionCount(): Int {
        return this.vm.getInstructionCount()
    }

    /// 检查是否运行中。
    fun isRunning(): Boolean {
        return this.vm.isRunning()
    }

    /// 获取栈深度。
    fun getStackDepth(): Int {
        return this.vm.getStackDepth()
    }

    /// 获取退出码。
    fun getExitCode(): Int {
        return this.vm.getExitCode()
    }

    /// 获取返回值。
    fun getReturnValue(): Any {
        return this.returnValue
    }

    /// 获取闭包管理器。
    fun getClosures(): ClosureManager {
        return this.closures
    }

    /// 获取尾调用优化器。
    fun getTailCall(): TailCallOptimizer {
        return this.tailCall
    }

    /// 获取栈帧管理器。
    fun getFrames(): FrameManager {
        return this.frames
    }

    // ═══════════════════════════════════════════════════════════
    //  扩展接口（P0 新增能力）
    // ═══════════════════════════════════════════════════════════

    /// 获取全局变量。
    fun getGlobal(name: String): Any {
        return this.vm.getGlobal(name)
    }

    /// 设置全局变量。
    fun setGlobal(name: String, value: Any): Unit {
        this.vm.setGlobal(name, value)
    }

    /// 获取闭包总数。
    fun getClosureCount(): Int {
        return this.vm.getClosureCount()
    }

    /// 获取上值总数。
    fun getUpvalueCount(): Int {
        return this.vm.getUpvalueCount()
    }

    /// VM 版本。
    fun version(): String {
        return this.vm.version()
    }

    /// 检查 VM 是否就绪。
    fun isReady(): Boolean {
        return this.vm.isReady()
    }

    /// 协程让出。
    fun suspend(): Unit {
        this.vm.suspend()
        this.suspended = true
    }

    /// 恢复执行。
    fun resume(): Unit {
        this.vm.resume()
        this.suspended = false
    }

    /// 保存 VM 状态。
    fun saveState(): HashMap<String, Any> {
        return this.vm.saveState()
    }

    /// 恢复 VM 状态。
    fun restoreState(state: HashMap<String, Any>): Unit {
        this.vm.restoreState(state)
    }
}
