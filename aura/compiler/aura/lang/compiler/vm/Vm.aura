// aura:///aura/compiler/aura/lang/compiler/vm/Vm.aura
package aura.lang.compiler.vm
// ─────────────────────────────────────────────────────────────
// 完整虚拟机核心 — P0: Rust VM 替代实现
//
// 替换原始占位桩，实现完整指令集、Any 值模型、对象/类/集合/
// 闭包/异常/FFI/ARC/协程/并发 全部运行时能力。
//
// 字节码格式（文本模式，与 Codegen.aura 一致）：
//   每行一条指令：OPCODE arg1 arg2 ...
//
// 值模型：Any（Int/Float/String/Boolean/Null/Long/对象引用）
// 对象模型：Long 堆指针（Memory.alloc + Memory.read/write）
// ARC：引用计数由 VM 自动管理（Retain/Release/DropRef）
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String
import aura.lang.std.fs.FileUtils
import aura.lang.std.IO
import aura.lang.std.Process
import aura.lang.std.Env
import aura.lang.std.Time
import aura.lang.native.Memory
import aura.lang.native.Cpu
import aura.lang.native.Heap
import aura.lang.native.JitExec
import aura.lang.native.time.Clock
import aura.lang.native.ThreadOps
import aura.lang.collection.HashMap
import aura.lang.compiler.lexer.Span
import aura.lang.compiler.vm.Opcodes
import aura.lang.compiler.vm.VmOps
import aura.lang.compiler.vm.VmCollections
import aura.lang.compiler.vm.VmStack
import aura.lang.compiler.serialize.AucLoader

/// 完整虚拟机实现（P0 替代占位桩）。
        class Vm {

    // ── 常量 ──

    private var MAX_INSTRUCTIONS: Int = 2000000000

    // ── 加载期索引与诊断（方案 A2/D/E）──
    private var traceMode: Boolean = false
    /// 函数表索引（P334：HashMap 在 photon 编译下 get/put 读空崩溃
    ///（§10.85 Memory_read64(0)），改平行 List 线性扫描——函数表 ~300 项、
    /// CALL 低频，性能无碍。
    private var funcNamesL: List<String> = arrayListOf<String>()
    private var funcOffL: List<Int> = arrayListOf<Int>()
    private var funcPcL: List<Int> = arrayListOf<Int>()
    private var constLines: List<String> = arrayListOf<String>()
    private var arg0Ints: List<Int> = arrayListOf<Int>()
    private var arg1Ints: List<Int> = arrayListOf<Int>()
    private var argNoneMark: Int = 2147483647
    /// P379：collectArgs 弹出值诊断专用计数（不与 [LC]/[P7v] 共享，防饿死）。
    // locals 帧池：调用帧局部表复用（retire 重置 / pop 取用），热身后零分配。
    private var localsPool: List<VmLocals> = arrayListOf<VmLocals>()

    // ── VM 状态 ──

    private var bytecode: String = ""
    private var constPool: String = ""
    private var funcTable: String = ""

    /// 导出表（每行 `name|funcIdx`，来自 .auc 的 exports 区段）。
    private var exportsTable: String = ""
    /// 导入表（每行 `name|module|symbol|funcIdx`，来自 .auc 的 imports 区段）。
    private var importsTable: String = ""

    /// 加载期缓存的「指令行 / opcode 助记符 / 数值编号 / 参数表」
    ///（四者的下标与 `ip` 对齐）。
    ///
    /// 执行期不再做 `substring` / 参数字符串切分：AOT 运行时没有 GC，
    /// 逐条解析会把临时字符串累积到 GB 级。
    ///
    /// P0.4（ADR-002）：`opCodes` 在加载期经 `Opcodes.fromName` 一次性把助记符
    /// 转为数值编号，分派只做整数比较；`ops` 保留助记符仅供未知指令诊断。
    /// 注释行 / 空行编号为 `Opcodes.OP_NOP`。
    private var lines: List<String> = arrayListOf<String>()
    private var ops: List<String> = arrayListOf<String>()
    private var opCodes: List<Int> = arrayListOf<Int>()
    // ── 参数扁平存储（2026-10-06）：取代 argCache List<List<String>>——
    // 2MB 编译器 .auc ≈ 20 万指令 × 每指令一个 List（8KB 追加余量）
    // = 1.6GB 堆耗尽（实测 buildLoadCaches alloc 返 NULL）。
    // argStrs 步长 3（槽 0/1/2 字符串，覆盖全部既有 get(0..2) 用法）；
    // arg2/3/4Ints 为**数值快路径**（融合臂/跳转/槽号，sentinel=非数值）；
    // argCounts 供 `args.size()` 语义。
    private var argStrs: List<String> = arrayListOf<String>()
    private var arg2Ints: List<Int> = arrayListOf<Int>()
    private var arg3Ints: List<Int> = arrayListOf<Int>()
    private var arg4Ints: List<Int> = arrayListOf<Int>()
    private var argCounts: List<Int> = arrayListOf<Int>()

    private var ip: Int = 0
    private var running: Boolean = true
    private var returnValue: Any = null
    private var error: String = ""
    private var exitCode: Int = 0

    /// 时钟读取缓冲区（16 字节，惰性分配后复用；`Time.now` 原语用）。
    private var clockBuf: Long = 0L

    // 栈：VmStack（原生列表 + 显式栈指针，O(1) push/pop，AOT 自举安全）
    private var stack: VmStack = VmStack()

    // 局部变量：slot -> value
    private var locals: VmLocals = VmLocals()

    // 全局变量：name -> value
    private var globals: HashMap<String, Any> = HashMap<String, Any>()

    // 调用栈：每帧为 "returnIp|frameId|funcName"
    private var callStack: VmCallStack = VmCallStack()

    /// P391：CALL 目标单槽缓存（按函数名记忆 offset/参数个数，见 callOrBuiltin）。
    /// P393：cfIsUser=1 表示该名是用户函数（快速路径跳过内建 if-else 链）。
    private var cfName: String = ""

    private var cfTarget: Int = 0
    private var cfPc: Int = 0
    private var cfIsUser: Int = 0

    /// P392：执行期热数组 Memory 裸缓冲（read64/write64 = runtime 单条 mov，
    /// 替代 List 下标的 Collections_getAt 函数调用——每条指令 3 次 List 调用
    /// 是解释器 26× 差距的主项）。buildLoadCaches 末尾从最终态一次性拷入。
    private var mcOpCodes: Long = 0
    private var mcA0: Long = 0
    private var mcA1: Long = 0
    private var mcN: Int = 0
    private var mcValid: Int = 0


    // 保存的局部变量帧（帧切换用）
    // [R20·根修] 旧 VmFrameStack 类的 size()/pop() 在宿主产码中读零
    //（返回点拿到全新 VmLocals，调用者帧全灭 = 递归返回值家族根因）。
    // 改用与 localsPool 完全同构的 List 直操（add/[]/removeAt/size 四原语
    // 已被池路径实证可靠）。
    private var savedLocals: List<VmLocals> = arrayListOf<VmLocals>()

    // 当前帧 ID 和函数名
    private var currentFrame: Int = 0
    private var currentFunc: String = ""

    // 用户函数形参的起始槽位。
    //
    // 两套调用约定不同：
    //   * Aura 文本字节码（Codegen.aura）：参数在槽 `0..n-1`
    //   * Rust 生成的 `.auc`：参数在槽 `1..n`（槽 0 是函数指针占位，
    //     见 `Rust vm/mod.rs::Frame::new`「参数从 locals[1] 开始」）
    // 槽位错位会让 `fact(3)` 恒返回 1（读到的永远是未赋值的槽 0）。
    private var aucArgBase: Int = 0

    // 是否处于 `.auc`（Rust MIR）执行模式。
    //
    // 两套字节码对「栈式指令」的约定不同，例如 `LIST_LEN`：
    //   * Aura 文本字节码：**peek**（列表留在栈上）
    //   * Rust `.auc`：**pop**（弹出列表、压入长度，见 Rust `Instr::ListLen`）
    private var aucMode: Boolean = false

    // 指令计数
    private var instructionCount: Int = 0

    /// [R10] LOAD_LOCAL 槽位轨迹配额
    private var ldTraceCap: Int = 0

    /// [R10] STORE 轨迹配额
    private var stTraceCap: Int = 0

    /// [R20] 递归返回值解剖：全 op 轨迹配额（r20rec 最小复现用）
    private var xTraceCap: Int = 0

    /// [R20] 调用/返回点轨迹配额
    private var rtTraceCap: Int = 0

    /// [根修轮R4] op62 诊断计数（独立计数器，独立于 instructionCount）
    private var p62DiagCount: Int = 0

    /// [R175 诊断] listOf 臂命中计数（有界打印）。
    private var lofDiagN: Int = 0

    // [R24] 堆对象 kind 线性登记（HashMap.getOrDefault 调用窗在宿主下
    // 无界挂起——实测 Collections.set 卡死；List 直操全已证）
    private var cbDiag: Int = 0

    // [R24] 布局扰动桩（真尺寸变化掷骰用；无调用者）
        private fun layoutDiceStub(): Int {
        val d: Int = 7
        return d * 3
    }
    private var heapKindKeys: List<String> = arrayListOf<String>()
    private var heapKindVals: List<String> = arrayListOf<String>()

    // [R33] 全局变量线性登记
    private var gKeys: List<String> = arrayListOf<String>()
    private var gVals: List<Any> = arrayListOf<Any>()
    // [R33] 对象字段扁平登记：键 = "<objKey>|<fieldName>"
    private var ofKeys: List<String> = arrayListOf<String>()
    private var ofVals: List<Any> = arrayListOf<Any>()
    // [R33] 对象类名登记：键 = objKey
    private var ocKeys: List<String> = arrayListOf<String>()
    private var ocVals: List<String> = arrayListOf<String>()
    // [R33] 类继承登记：键 = 类名
    private var cpKeys: List<String> = arrayListOf<String>()
    private var cpVals: List<String> = arrayListOf<String>()

    // ── 运行期 arena 水位 / 值栈容量探针（P1-RETAIN 诊断，2026-10-08）──
    //
    // 外部 memprof.py 只能读进程 RSS——它是**不可回收的**：bump arena 是 64 MiB
    // 静态 .data，倍增后的旧值栈缓冲留在 arena 上、物理页不触碰就不计入 wset，
    // 于是 10⁹ 次迭代的泄漏在 wset 上完全不可见（loop1100m 恒 4.3 MB 却 exit 非 0）。
    // 回收与否必须从 VM 内部量：
    //   arenaHi   = Memory.alloc 的水位（单调不减——bump 分配器无回收）；
    //   stackCap  = 值栈容量（应受活跃深度约束，只增不降）。
    // 两者在「回收正常」时都应收敛到常数；线性增长即泄漏。
    //
    // ⚠ 成本纪律：探针挂在 run() 已有的 2^20 周期窗口里（P401 的 icAcc 刷回点），
    // **每 2^20 条指令才碰一次 Memory 与 VmStack**，热路径零额外开销——这与
    // P239 时代的「每次调用都 println」探针不同，后者会污染测量（曾把 loop1m
    // 推进 OOM）甚至触发 §10.111 的布局敏感误值。探针用累加器求均值后一次性
    // 打印，不在循环内分配字符串。
    // ⚠ 探针会调用 Memory.alloc（推进 bump 指针）——这是诊断固有副作用，
    //   每个采样点消耗 arena 的常数空间（含 256 槽计数表 ≈184 KB），不影响
    //   「是否单调增长」的判定，但会使绝对水位略高于纯净运行。
    // 探针缓冲惰性初始化（arenaProbe 非 0 即就绪），避免在字段初始化时
    // 调 Memory.alloc——此时 Heap_init 尚未执行。
    private var arenaProbe: Long = 0
    private var arenaHi: Long = 0
    private var stackPeak: Int = 0
    private var probeCount: Int = 0
    private var arenaSum: Long = 0
    private var capSum: Int = 0

    // 异常处理器栈
    private var handlerStack: VmStrStack = VmStrStack()

    // 闭包表：closureId -> funcName
    private var closureTable: HashMap<Int, String> = HashMap<Int, String>()

    // 闭包捕获表（P1.3）：closureId -> 捕获值列表（按压入顺序，下标即 upvalue 序号）。
    // STORE_UPVALUE 可原位改写捕获值（闭包对象共享可变状态）。
    private var closureCaptures: HashMap<Int, List<Any>> = HashMap<Int, List<Any>>()
    private var nextClosureId: Int = 0
    // 捕获值总数（getUpvalueCount 用；避免宿主对泛型 List 迭代/求和的推导问题）
    private var upvalueTotal: Int = 0
    // 当前帧所属闭包（LOAD/STORE_UPVALUE 的寻址上下文；-1 = 无闭包上下文）。
    // 调用帧以 callStack 第 4 字段保存/恢复（见 callOrBuiltin / returnFromFunc）。
    private var currentClosure: Int = -1

    // ── 对象模型（P0.5 / P1.2 / P1.5，ADR-003）──
    // 实例字段表：键 "<objPtr>" -> (字段名 -> 值)。按实例隔离；嵌套结构使
    // 对象释放时可 O(1) 摘除其全部字段（P1.5）。
    private var objectFields: HashMap<String, HashMap<String, Any>> = HashMap<String, HashMap<String, Any>>()
    // 对象类名表：键 "<objPtr>" -> 类名（方法分派 / 类型过滤用）。
    private var objectClass: HashMap<String, String> = HashMap<String, String>()
    // 类继承注册表（P1.2）：类名 -> 父类名（"" 或 "-" = 无父类）。
    // DEF_CLASS 指令 / registerClass API 写入；方法解析与 instanceOf 沿父类链行走。
    private var classParents: HashMap<String, String> = HashMap<String, String>()

    // ── 堆分配注册表（P1.5）：ptrKey -> kind ──
    // kind ∈ object|box|list|map|array|mutex|atomic|channel|rwlock|condvar。
    // 这是「该值是否为 VM 堆对象」的唯一真值来源：DEC_REF 只对注册过的指针
    // 生效（指针与整数的装箱类型名无法区分，未注册值一律透传，避免误释放）。
    private var heapKinds: HashMap<String, String> = HashMap<String, String>()
    // 装箱值侧表（P1.1 boxAlloc 类型感知）：非数值装箱值无法写裸内存，
    // 以 "<objPtr>" 键存放于托管侧表（box 释放时同步摘除）。
    private var boxValues: HashMap<String, Any> = HashMap<String, Any>()
    // 模块注册表（P2.3）：已登记模块名 -> 导出表文本（`name|funcIdx` 每行）。
    // 完整跨模块执行需多代码段 VM（P4 自举时单模块合并即覆盖主场景）。
    private var loadedModuleExports: HashMap<String, String> = HashMap<String, String>()

    // ── 加速派发钩子（P0.8，接口预留不实现加速逻辑）──
    // 热函数直呼表：funcName -> 入口行号；callOrBuiltin 用户函数路径优先查询。
    // JIT/Photon 任务对接点（VM-PA-00 §2.3 契约）：接口签名保持稳定。
    private var accelEnabled: Boolean = false
    private var accelTable: HashMap<String, Int> = HashMap<String, Int>()

    // 挂起状态（suspend()/resume() 使用；协程调度器已按 D5 废弃移除）
    private var suspended: Boolean = false

    init() {
        this.bytecode = ""
        this.constPool = ""
        this.funcTable = ""
        this.exportsTable = ""
        this.importsTable = ""
        this.lines = arrayListOf<String>()
        this.ops = arrayListOf<String>()
        this.opCodes = arrayListOf<Int>()
        this.argStrs = arrayListOf<String>()
        this.arg2Ints = arrayListOf<Int>()
        this.arg3Ints = arrayListOf<Int>()
        this.arg4Ints = arrayListOf<Int>()
        this.argCounts = arrayListOf<Int>()
        this.ip = 0
        this.running = true
        this.returnValue = null
        this.error = ""
        this.exitCode = 0
        this.stack = VmStack()
        this.locals.reset()
        this.globals = HashMap<String, Any>()
        this.callStack.reset()
        this.savedLocals = arrayListOf<VmLocals>()
        this.currentFrame = 0
        this.currentFunc = ""
        this.instructionCount = 0
        this.handlerStack = VmStrStack()
        this.closureTable = HashMap<Int, String>()
        this.closureCaptures = HashMap<Int, List<Any>>()
        this.nextClosureId = 0
        this.upvalueTotal = 0
        this.currentClosure = -1
        this.objectFields = HashMap<String, HashMap<String, Any>>()
        this.objectClass = HashMap<String, String>()
        this.classParents = HashMap<String, String>()
        this.heapKinds = HashMap<String, String>()
        this.boxValues = HashMap<String, Any>()
        this.accelEnabled = false
        this.accelTable = HashMap<String, Int>()
        this.suspended = false
    }

    // ═══════════════════════════════════════════════════════════
    //  加载与初始化
    // ═══════════════════════════════════════════════════════════

    /// 加载字节码（文本模式：每行一条指令）。
        fun loadBytecode(code: String, consts: String, funcs: String): Unit {
        this.bytecode = code

        this.ip = 0
        this.running = true
        this.error = ""
        this.returnValue = null
        this.exitCode = 0
        this.stack = VmStack()
        this.locals.reset()
        this.globals = HashMap<String, Any>()
        this.callStack.reset()
        this.savedLocals = arrayListOf<VmLocals>()
        this.handlerStack = VmStrStack()
        this.instructionCount = 0
        this.currentFrame = 0
        this.currentFunc = ""
        this.suspended = false
        this.aucArgBase = 0
        this.aucMode = false
        this.objectFields = HashMap<String, HashMap<String, Any>>()
        this.objectClass = HashMap<String, String>()
        this.classParents = HashMap<String, String>()
        this.heapKinds = HashMap<String, String>()
        this.boxValues = HashMap<String, Any>()
        this.closureCaptures = HashMap<Int, List<Any>>()
        this.currentClosure = -1
        this.buildLineCache()
        this.buildLoadCaches()
    }

    /// 从二进制 .auc 文件加载并执行。
    ///
    /// P2.2：加载器产出**数值化指令数组**（无文本中间层）时走 `loadPredecoded`
    /// 直读路径；类定义表自动注册进类继承注册表（继承/虚方法分派生效）。
        fun loadAucAndRun(path: String): Any {
        AucLoaderUtils.loadModule(path)
        // ⚠️ P266：从全局槽读取（绕开返回值传递链的句柄漂移）
        val mod: AucModule = AucLoaderUtils.lastLoaded
        val loadOnly: String = Env.get("AURA_VM_LOADONLY", "")
        if (loadOnly == "1") {
            this.error = "loadonly valid=" + toStr(mod.isValid()) + " numeric=" + toStr(mod.numericMode)
                + " err=[" + mod.error + "] funcs=" + toStr(mod.funcsCount)
                + " consts=" + toStr(mod.constsCount) + " name=" + mod.name
            this.running = false
            return null
        }
        if (!mod.isValid()) {
            this.error = "loadAucAndRun: " + mod.error
            this.running = false
            return null
        }
        if (mod.numericMode) {
            // P241 窗口二分：registerAucClasses 之前
                // P2.2c：类表 → 类继承注册表（parent_id 0 = Any；防自环）
                this.registerAucClasses(mod.classNames, mod.classParentIds)
                        this.loadPredecoded(mod.numOpNames, mod.numOpCodes, mod.numArgsFlat, mod.constPool,
                mod.constLines, mod.funcTable, mod.exports, mod.imports)
            println("[VMLOADOK]")
            val r: Any = this.run()
            println("[VMDONE]")
            return r
        }
        // 遗留文本路径（数值模式失败时的回退）
        this.bytecode = mod.bytecode
        this.constPool = mod.constPool
        // 加载器已从 .auc 的函数区还原出 `name|起始行|参数个数` 文本函数表
        this.funcTable = mod.funcTable
        // 加载导出/导入表（跨模块调用需要）
        this.exportsTable = mod.exports
        this.importsTable = mod.imports
        this.ip = 0
        this.running = true
        this.error = ""
        this.returnValue = null
        this.stack = VmStack()
        this.locals.reset()
        this.globals = HashMap<String, Any>()
        this.callStack.reset()
        this.savedLocals = arrayListOf<VmLocals>()
        this.handlerStack = VmStrStack()
        this.instructionCount = 0
        this.currentFrame = 0
        this.currentFunc = ""
        this.suspended = false
        // `.auc` 的形参槽从 1 开始（见 aucArgBase）
        this.aucArgBase = 1
        this.aucMode = true
        this.objectFields = HashMap<String, HashMap<String, Any>>()
        this.objectClass = HashMap<String, String>()
        this.classParents = HashMap<String, String>()
        this.heapKinds = HashMap<String, String>()
        this.boxValues = HashMap<String, Any>()
        this.closureCaptures = HashMap<Int, List<Any>>()
        this.currentClosure = -1
        this.buildLineCache()
        this.buildLoadCaches()
        return this.run()
    }

    /// 加载预解码指令数组（P2.2b：.auc 数值直读路径）。
    ///
    /// 助记符经 `Opcodes.fromName` 数值化（加载期一次），参数为加载器已解析的
    /// 最终形态（函数名/常量下标/全局行号）；执行期零解析。
    /// `.auc` 调用约定：形参槽从 1 开始（`aucArgBase = 1`）。
    fun loadPredecoded(opNames: List<String>, opCodesNum: List<Int>, args: List<String>, consts: String,
        constLinesIn: List<String>, funcs: String, exports: String, imports: String): Unit {
        this.bytecode = ""

        this.exportsTable = exports
        this.importsTable = imports
        // ⚠️ P293 关键修复：consts/funcs 参数此前从未赋给字段——末尾的
        // buildLoadCaches() 从 this.funcTable/this.constPool 构建
        // funcOffsetMap/funcParamMap/constLines，恒空 → LOAD_CONST 全垃圾、
        // CALL funcName 截断（Unknown function: p）。
        this.constPool = consts
        this.funcTable = funcs
        this.loadArgsFlat(args)
        this.opCodes = arrayListOf<Int>()
        if (opCodesNum.size() == opNames.size() && opNames.size() > 0) {
            // P350：直接消费解码期数值 opcode（fromName 的字符串比较在 photon
            // 下布局敏感误配——PRINT 误配成 STORE_LOCAL 之类）
            var i2: Int = 0
            while (i2 < opCodesNum.size()) {
                this.opCodes.add(opCodesNum[i2])
                i2 = i2 + 1
            }
        } else {
            var i: Int = 0
            while (i < opNames.size()) {
                this.opCodes.add(Opcodes.fromName(opNames[i]))
                i = i + 1
            }
        }
        // P373（2026-10-08 删除）：此处曾有 opcode 头部诊断（长度 + 前两条 +
        // 解码计数），用于定位「LOAD_CONST 全垃圾 / CALL 截断」家族。P350 起
        // 直接消费解码期数值 opcode（fromName 字符串比较在 photon 下布局敏感
        // 误配），该症状已消除，诊断窗一并清除。
        this.lines = arrayListOf<String>()
        this.ip = 0
        this.running = true
        this.error = ""
        this.returnValue = null
        this.exitCode = 0
        this.stack = VmStack()
        this.locals.reset()
        this.globals = HashMap<String, Any>()
        this.callStack.reset()
        this.savedLocals = arrayListOf<VmLocals>()
        this.handlerStack = VmStrStack()
        this.instructionCount = 0
        this.currentFrame = 0
        this.currentFunc = ""
        this.suspended = false
        this.aucArgBase = 1
        this.aucMode = true
        this.objectFields = HashMap<String, HashMap<String, Any>>()
        this.objectClass = HashMap<String, String>()
        this.heapKinds = HashMap<String, String>()
        this.boxValues = HashMap<String, Any>()
        this.closureCaptures = HashMap<Int, List<Any>>()
        this.currentClosure = -1
        this.accelEnabled = false
        this.accelTable = HashMap<String, Int>()
        // P333：buildLoadCaches 恢复启用——§10.85 的 Memory_read64(0) 崩点之后
        // 已落地五项修复（mmap 文件缓冲 / 帧预算 ID 区间上界 / buildIf varMap
        // 回滚 / phi (b) 兜底删除 / realDecoded）。constLines 走本函数的
        // charCodeAt 扫描构建（getFieldAt 兜底扫描在 photon 下漏换行），
        // funcOffsetMap 换平行 List（HashMap 在 photon 下读空，§10.85 同族）。
        // P359/P370：constLines 直接引用解码端列表（转义态，getConstByIdx/
        // getConst 统一反转义）。拷贝循环的 listAppend/get 调用窗按布局
        // 崩/漂移——引用赋值零调用，VM 侧只读。
        this.constLines = constLinesIn
        // P369/P397/P405：fuseHotPairs 两遍扫描 + 遍 1 单点递增形态 + 205
        // pair 漏参修复（执行臂 4 参 vs 旧构造 3 参）已就绪，但调用保持
        // 禁用：P277 槽影子读**与循环写法无关**——本轮实证仅启用 204 的
        // 模式检查（banner 流零匹配、纯布局扰动）即令 banner 陷入无限
        // 循环（26K 次头重印后段错误），与 §10.111「任何装载路径代码扰动
        // 随机触发」一致。重启条件不变：P398 发射器槽影子读根治。
        // this.fuseHotPairs()
        this.buildLoadCaches()
    }

    /// 注册 .auc 类定义表（P2.2c）：类名 + 父类下标 → 类继承注册表。
        fun registerAucClasses(names: List<String>, parentIds: List<Int>): Unit {
        var i: Int = 0
        while (i < names.size()) {
            var parent: String = ""
            val pid: Int = parentIds[i]
            if (pid >= 0 && pid < names.size() && pid != i) {
                parent = names[pid]
            }
            // [R33] 线性登记（覆盖式）
            var pi1: Int = 0
            val pn1: Int = this.cpKeys.size()
            var had1: Int = 0
            while (pi1 < pn1) {
                if (this.cpKeys[pi1] == names[i]) {
                    this.cpVals[pi1] = parent
                    had1 = 1
                    pi1 = pn1
                }
                pi1 = pi1 + 1
            }
            if (had1 == 0) {
                this.cpKeys.add(names[i])
                this.cpVals.add(parent)
            }
            i = i + 1
        }
    }

    /// 从二进制数据加载（P1 预留接口）。
        fun loadAucBinary(data: Array<Byte>): Unit {
        this.error = "loadAucBinary: use loadAucAndRun(path) instead"
        this.running = false
    }

    // ═══════════════════════════════════════════════════════════
    //  主执行循环
    // ═══════════════════════════════════════════════════════════

    /// 执行字节码，返回最终结果。
    ///
    /// 性能/内存要点：指令行、opcode、参数都在**加载期**一次性解析并缓存
    /// （`lines` / `ops` / 参数扁平槽）。AOT 运行时**没有 GC**，若在执行循环里
    /// 逐条 `substring`/`parseArgs`，长循环会把临时字符串累积成 GB 级内存。
        fun run(): Any {
        // 从 main 函数入口开始
        this.ip = this.funcOffset("main")
        this.currentFunc = "main"

        // P401：指令计数改周期检查——逐条 field 加一（~7 条 x86/指令）改为
        // 局部 icAcc 累加、每 2^20 条批量刷回 + 一次上限检查；循环所有出口
        // （正常/错误/上限 break）都刷回余量，getInstructionCount() 在
        // run() 返回后仍精确（上限触发最迟 2^20 条后生效，护栏语义不变）。
        var icAcc: Int = 0
        while (this.running && (this.mcValid == 0 || this.ip < this.mcN)) {
            icAcc = icAcc + 1
            if (icAcc >= 1048576) {
                this.instructionCount = this.instructionCount + icAcc
                icAcc = 0
                if (this.instructionCount > this.MAX_INSTRUCTIONS) {
                    this.error = "Instruction limit exceeded (" + toStr(this.MAX_INSTRUCTIONS) + ")"
                    this.running = false
                    break
                }
                this.probeArena()
            }

            // P392：热路径读 Memory 裸缓冲（值域 < 2^31，read64 as Int 无损）。
            // [R30] ip 越界守卫：闭包内跳转目标骰坏（JMP 写入垃圾 ip）时，
            // 旧径继续 fetch 越界缓冲 = 垃圾执行自旋（TIMEOUT）或段错误。
            // 守卫 = 干净报错退出（TIMEOUT → 可计数的 OUTPUT-DIFF）。
            if (this.ip < 0 || this.ip >= this.mcN) {
                this.error = "jump target out of range: ip=" + toStr(this.ip) + " at fn=[" + this.currentFunc + "]"
                this.running = false
                break
            }
            val opCode: Int = Memory.read64(this.mcOpCodes + this.ip * 8) as Int
            this.ip = this.ip + 1
            // [R19] 全 op 轨迹：ip / opcode / arg0 / 栈顶 / sp——每条 op 的
            // 净栈效应直接可见（相邻两行 top 差 = 本 op 的推弹账）。
            if (this.xTraceCap > 0) {
                this.xTraceCap = this.xTraceCap - 1
                val topX: Any = this.stack.peek()
                println("[X] ip=" + toStr(this.ip - 1) + " op=" + toStr(opCode)
                    + " a0=[" + this.argStrOf(0) + "] top=[" + VmOps.toStrAny(topX)
                    + "] sp=" + toStr(this.stack.stackDepth())
                    + " lc=" + toStr(this.locals.getSize()))
            }
            // [R10] 槽位轨迹（判决实验）
            if (this.ldTraceCap > 0) {
                this.ldTraceCap = this.ldTraceCap - 1
            }
            // [P5-EXECDEBUG] 探针已移除（根修轮R3）：`instructionCount` 在本循环
            // 内不递增，500 条的界形同虚设 → 每指令一次字符串拼装 + println ⇒
            // arena 分配风暴，256MB 堆在 ~1M 条指令内打满（[OOM] HEAP FULL，
            // exit=70）。崩溃取证已由 runtime VEH 双守卫转储（R1）+ /FIXED 定址
            //（R3）接管，无需进程内探针。


            // 注释行 / 空行（加载期已编号为 OP_NOP——buildLineCache 与
            // loadPredecoded 对空名/注释行统一编号，装载后不再有「空 ops 行」，
            // 旧兜底 `ops[ip-1] == ""` 每指令一次 List<String> get + streq 纯冗余，
            // P392 移除）。
            if (opCode == Opcodes.OP_NOP) {
                continue
            }

            this.dispatch(opCode)
        }
        this.instructionCount = this.instructionCount + icAcc

        this.probeReport()

        return this.returnValue
    }

    /// 周期性 arena 水位 / 值栈容量采样（P1-RETAIN 诊断，见字段注释）。
    ///
    /// 调用点在 run() 的 icAcc 2^20 刷回窗口内——每 2^20 条指令一次，
    /// 热路径零额外开销。用累加器求均值、不在此打印（P239 时代的探针就是
    /// 在循环内 println 把 loop1m 推进 OOM 的）。
    ///
    /// 水位采样原理：bump 指针单调不减，故「本次 alloc 返回的绝对地址 +
    /// 其大小」是当时高水位的**下界**——不会高估，用于斜率判定足够。
    ///
    /// 表大小 2^20 槽 × 8 B = 8 MB（落在 bump arena 上）。MAX_INSTRUCTIONS =
    /// 2×10⁹ ⇒ 最多 ~1908 个采样点，表充裕。⚠ 8 MB 是探针固有开销，会使
    /// 绝对水位比纯净运行高 8 MB+；但「是否收敛」的斜率判定不受影响。
        private fun probeArena(): Unit {
        if (this.arenaProbe == 0) {
            this.arenaProbe = Memory.alloc(2097152 + 16)
        }
        val n: Int = this.instructionCount / 1048576 + 1
        val slot: Long = this.arenaProbe + 8 + n * 8
        val mark: Long = Memory.alloc(8)
        val level: Long = mark + 8
        Memory.write64(slot, level)
        val hi: Long = this.arenaHi
        if (level > hi) {
            this.arenaHi = level
        }
        val cap: Int = this.stack.cap()
        if (cap > this.stackPeak) {
            this.stackPeak = cap
        }
        this.probeCount = this.probeCount + 1
        this.arenaSum = this.arenaSum + level
        this.capSum = this.capSum + cap
    }

    /// run() 结束后一次性打印采样汇总（唯一一条 println，不在循环内）。
    ///
    /// 水位以「采样表起始点为基线 0」的相对偏移表示——绝对地址受 ASLR
    /// 影响每次不同、减法结果巨大且不可比；相对偏移（≈2×2²⁰ 量级）之间的
    /// 减法安全且可直接判读。
    ///
    /// 判读（详见 docs/photon/vm-memory-comparison.md §十.4）：
    ///   slope ≈ 8            ⇒  正常——arena 只按探针自身 alloc(8)/采样点增长；
    ///   slope >> 8           ⇒  线性泄漏（bump 单调，无回收）；
    ///   capGrow 恒定 / capLast=64  ⇒  值栈无倍增（栈账目平衡）；
    ///   capGrow 持续上涨 / capLast 巨大  ⇒  栈顶单调上升。
        private fun probeReport(): Unit {
        if (this.probeCount <= 0) {
            return
        }
        val p: Int = this.probeCount
        val base: Long = this.arenaProbe
        // ⚠ 首个采样写的是槽 2（probeArena 的 n = ic/2²⁰+1，ic 刷回后已 ≥2²⁰），
        // 槽 1 从未写入（bump 内存为零页）——读槽 1 当 first 会得到 -base 的
        // 垃圾差值（本轮实测 delta 报 140 万亿量级即此）。
        val first: Long = Memory.read64(base + 8 + 2 * 8)
        val last: Long = Memory.read64(base + 8 + p * 8)
        val hiRel: Long = this.arenaHi - base
        val firstRel: Long = first - base
        val lastRel: Long = last - base
        val avgRel: Long = this.arenaSum / p - base
        val delta: Long = lastRel - firstRel
        var slope: Long = 0
        if (p > 1) {
            slope = delta / (p - 1)
        }
        println("[MEMPROBE] samples=" + toStr(p)
            + " hiRel=" + toStr(hiRel)
            + " lastRel=" + toStr(lastRel)
            + " avgRel=" + toStr(avgRel)
            + " delta=" + toStr(delta)
            + " slope=" + toStr(slope)
            + " capPeak=" + toStr(this.stackPeak)
            + " capAvg=" + toStr(this.capSum / p)
            + " capLast=" + toStr(this.stack.cap())
            + " capGrow=" + toStr(this.stack.capGrow())
            + " depth=" + toStr(this.stack.stackDepth())
            + " calls=" + toStr(this.callStack.callDepth()))
    }

    /// 加载期预处理：把字节码切成行并缓存 `opcode` 助记符 / **数值编号** / 参数表
    ///（只分配一次；助记符→编号转换在此一次完成，ADR-002）。
        private fun buildLineCache() {
        this.lines = this.bytecode.split("\n")
        this.ops = arrayListOf<String>()
        this.opCodes = arrayListOf<Int>()
        this.argStrs = arrayListOf<String>()
        this.arg2Ints = arrayListOf<Int>()
        this.arg3Ints = arrayListOf<Int>()
        this.arg4Ints = arrayListOf<Int>()
        this.argCounts = arrayListOf<Int>()
        this.arg0Ints = arrayListOf<Int>()
        this.arg1Ints = arrayListOf<Int>()
        var i: Int = 0
        while (i < this.lines.size()) {
            val ln: String = this.lines[i]
            var pos: Int = 0
            var lineLen: Int = ln.length
            while (pos < lineLen) {
                if (VmOps.isSpace(ln.charCodeAt(pos))) {
                    break
                }
                pos = pos + 1
            }
            val name: String = VmOps.vmSubstr(ln, 0, pos)
            this.ops.add(name)
            // 注释行（# 开头）/ 空行 → OP_NOP；其余经唯一编号源转数值
            if (name == "" || this.startsWith(ln, "#")) {
                this.opCodes.add(Opcodes.OP_NOP)
            } else {
                this.opCodes.add(Opcodes.fromName(name))
            }
            this.writeArgsRow(VmOps.parseArgs(ln, pos))
            i = i + 1
        }
    }

    // ═══════════════════════════════════════════════════════════
    //  指令分派
    // ═══════════════════════════════════════════════════════════

    /// 按加载期缓存的数值编号执行一条指令。
    ///
    /// P0.4（ADR-002）：分派只做**整数**比较（`Opcodes` 常量），无指令名
    /// 字符串比较；`opName` 仅用于未知指令的诊断信息。
        private fun dispatch(op: Int): Unit {
        // ── 常量指令 ──
        // ── 热指令快速分派（方案 D）：按动态频次把高频臂前置，
        // 未命中落入下方原链（臂语义与原链逐字一致）。 ──
        //
        // ⚠ P412（2026-10-07）：本块的**顺序依据改为实测动态频次**，
        // 不再是静态猜测。仪器：Vm 内置 per-opcode 计数器
        // （AURA_OP_PROF=1，见 dumpOpProfile），实测 fib28（3137 万条
        // guest 指令）与 loop1M（5300 万条）的分布，两基准一致：
        //
        //   LOAD_LOCAL 41.0% / STORE_LOCAL 26.2% / LOAD_CONST_I 6.6%
        //   RETAIN 6.6% / RETURN+CALL+JUMP_IF_FALSE+LE 共 13.2%
        //
        // **反汇编实测**：每条 `if (op == N)` 编译成 11 条 x86
        // （常量落栈 → 读回 → cmp → setcc → movzbq → 落栈 → 读回 →
        //  cmp 0 → jcc），命中第 d 个臂须付 11×d 条。原链里
        // **RETAIN 在第 95 位、LE 在第 45 位**，而两者分别执行 206 万 /
        // 103 万次 ⇒ 仅比较链就 2.15B + 0.51B 条 x86——分别占 fib28
        // 全程序 x86 的 ~28% 与 ~6.6%，是当前最大的单项开销。
        //
        // 本步（Step A）只把这两条提到 depth 4/5，其余臂顺移 2 位。
        // 净收益 ≈ 2.3B 条 x86（约全程序 30%）。
        if (op == 10) {
            val slot: Int = this.arg0IntOf()
            val v: Any = this.locals.getSlot(slot)
            // [R10] 槽位轨迹（判决实验：args 解码漂移 vs VmLocals 存取漂移）
            if (this.ldTraceCap > 0) {
                this.ldTraceCap = this.ldTraceCap - 1
                println("[LD] ip=" + toStr(this.ip - 1) + " slot=" + toStr(slot) + " val=[" + VmOps.toStrAny(v) + "]")
            }
            if (v == null) {
                this.stack.push(toAny(0))
            } else {
                this.stack.push(v)
            }
        } else if (op == 11) {
            val slot: Int = this.arg0IntOf()
            val sv: Any = this.stack.pop()
            // [R10] STORE 轨迹（抓 slot12="2" 的写入者）
            if (this.stTraceCap > 0) {
                this.stTraceCap = this.stTraceCap - 1
                println("[ST] ip=" + toStr(this.ip - 1) + " slot=" + toStr(slot) + " val=[" + VmOps.toStrAny(sv) + "]")
            }
            this.locals.putSlot(slot, sv)
        } else if (op == 5) {
            // P404：[LC] 装载链诊断探针摘除（2026-10-06 追踪用，git 历史
            // 可考）——逐指令 field 读 + 分支的热路径税。
            this.stack.push(toAny(VmOps.toI32(VmOps.toStrAny(this.getConstByIdx(this.arg0IntOf())))))
        } else if (op == 112) {
            // P412：RETAIN 原在第 95 位（206 万次 × 1045 条 = 2.15B 条 x86）。
            // 臂体与原链逐字一致（原链 arm 仍是兜底，永不命中）。
            this.retain()
        } else if (op == 34) {
            // P412：LE 原在第 45 位（103 万次 × 495 条 = 0.51B 条 x86）。
            // 局部名加 34 后缀——§10.116 T1「if/else 分支重复声明同名 val
            // ⇒ 函数级作用域提升 + 静默坏码」，本块已有 b/a（op 20/21/32），
            // 新臂必须避让。
            val b34: Any = this.stack.pop()
            val a34: Any = this.stack.pop()
            this.stack.push(VmOps.le(a34, b34))
        } else if (op == 51) {
            val cond: Any = this.stack.pop()
            if (!VmOps.toBool(cond)) {
                this.ip = this.arg0IntOf()
            }
        } else if (op == 200) {
            this.stack.push(toAny(VmOps.toI32(VmOps.toStrAny(this.getConstByIdx(this.arg0IntOf())))))
            this.locals.putSlot(this.arg1IntOf(), this.stack.pop())
        } else if (op == 201) {
            val v: Any = this.locals.getSlot(this.arg0IntOf())
            if (v == null) {
                this.stack.push(toAny(0))
            } else {
                this.stack.push(v)
            }
            val cond: Any = this.stack.pop()
            if (!VmOps.toBool(cond)) {
                this.ip = this.arg1IntOf()
            }
        } else if (op == 202) {
            // local[a] OP const[c] → local[s]
            val b: Any = this.locals.getSlot(this.arg0IntOf())
            val c: Any = toAny(VmOps.toI32(VmOps.toStrAny(this.getConstByIdx(this.arg1IntOf()))))
            val binop: Int = this.arg2IntOf()
            var r: Any = 0
            if (binop == 20) {
                r = VmOps.add(b, c)
            } else if (binop == 21) {
                r = VmOps.sub(b, c)
            } else if (binop == 22) {
                r = VmOps.mul(b, c)
            }
            this.locals.putSlot(this.arg3IntOf(), r)
        } else if (op == 203) {
            // local[a] OP local[b] → local[s]
            val b: Any = this.locals.getSlot(this.arg0IntOf())
            val c: Any = this.locals.getSlot(this.arg1IntOf())
            val binop: Int = this.arg2IntOf()
            var r2: Any = 0
            if (binop == 20) {
                r2 = VmOps.add(b, c)
            } else if (binop == 21) {
                r2 = VmOps.sub(b, c)
            } else if (binop == 22) {
                r2 = VmOps.mul(b, c)
            }
            this.locals.putSlot(this.arg3IntOf(), r2)
        } else if (op == 204) {
            // local[a] < const[c] → tmp；false 跳 t（循环守卫 6 连合一）
            val b: Any = this.locals.getSlot(this.arg0IntOf())
            val c: Any = toAny(VmOps.toI32(VmOps.toStrAny(this.getConstByIdx(this.arg1IntOf()))))
            val cond: Any = VmOps.lt(b, c)
            this.locals.putSlot(this.arg3IntOf(), cond)
            if (!VmOps.toBool(cond)) {
                this.ip = this.arg4IntOf()
            }
        } else if (op == 205) {
            // local[a] < local[b] → tmp；false 跳 j（双局部守卫 5 连合一）
            val x: Any = this.locals.getSlot(this.arg0IntOf())
            val y: Any = this.locals.getSlot(this.arg1IntOf())
            val cond: Any = VmOps.lt(x, y)
            this.locals.putSlot(this.arg2IntOf(), cond)
            if (!VmOps.toBool(cond)) {
                this.ip = this.arg3IntOf()
            }
        } else if (op == 206) {
            // local[a] → local[b]（拷贝合一）
            val v: Any = this.locals.getSlot(this.arg0IntOf())
            if (v == null) {
                this.locals.putSlot(this.arg1IntOf(), toAny(0))
            } else {
                this.locals.putSlot(this.arg1IntOf(), v)
            }
        } else if (op == 20) {
            val b: Any = this.stack.pop()
            val a: Any = this.stack.pop()
            // [R21] Float 文本分支在 dispatch 层内联（push(String) = toUpper
            // 已证形状）——VmOps.add 的双类型返回合并会被 Int 装箱（P364
            // getConstByIdx 同款病）。
            if (VmOps.isFloatText(a) || VmOps.isFloatText(b)) {
                val dA20: Int = VmOps.floatDecimalsOf(a)
                val dB20: Int = VmOps.floatDecimalsOf(b)
                var d20: Int = dA20
                if (dB20 > d20) { d20 = dB20 }
                val mA20: Int = VmOps.floatMantissaOf(a) * VmOps.floatPow10(d20 - dA20)
                val mB20: Int = VmOps.floatMantissaOf(b) * VmOps.floatPow10(d20 - dB20)
                this.stack.push(VmOps.floatTextOf(mA20 + mB20, d20))
            } else {
                this.stack.push(VmOps.add(a, b))
            }
        } else if (op == 21) {
            val b: Any = this.stack.pop()
            val a: Any = this.stack.pop()
            if (VmOps.isFloatText(a) || VmOps.isFloatText(b)) {
                val dA21: Int = VmOps.floatDecimalsOf(a)
                val dB21: Int = VmOps.floatDecimalsOf(b)
                var d21: Int = dA21
                if (dB21 > d21) { d21 = dB21 }
                val mA21: Int = VmOps.floatMantissaOf(a) * VmOps.floatPow10(d21 - dA21)
                val mB21: Int = VmOps.floatMantissaOf(b) * VmOps.floatPow10(d21 - dB21)
                this.stack.push(VmOps.floatTextOf(mA21 - mB21, d21))
            } else {
                this.stack.push(VmOps.sub(a, b))
            }
        } else if (op == 32) {
            val b: Any = this.stack.pop()
            val a: Any = this.stack.pop()
            this.stack.push(VmOps.lt(a, b))
        } else if (op == 60) {
            val funcName: String = this.argStrOf(0)
            var argc: Int = 0
            if (this.argCountOf() >= 2) {
                argc = this.arg1IntOf()
            } else {
                argc = this.funcParamCount(funcName)
                if (argc < 0) { argc = 0 }
            }
            this.callOrBuiltin(funcName, argc)
        } else if (op == 65) {
            this.returnFromFunc()
        } else if (op == 50) {
            this.ip = this.arg0IntOf()
        } else {
                if (op == 0) {
            val idx: Int = VmOps.toI32(VmOps.toStrAny(this.getConstByIdx(this.arg0IntOf())))
            this.stack.push(toAny(idx))
        } else if (op == 1) {
            val val: Any = this.getConstByIdx(this.arg0IntOf())
            this.stack.push(VmOps.parseFloat(toStr(val)))
        } else if (op == 2) {
            val val: Any = this.getConstByIdx(this.arg0IntOf())
            this.stack.push(val)
        } else if (op == 3) {
            this.stack.push(this.argStrOf(0) == "true")
        } else if (op == 4) {
            this.stack.push(null)
        }

        // ── 类型化常量加载（`.auc` 路径：LoadConst 单操作码 + 常量标签）──
        else if (op == 5) {
            this.stack.push(toAny(VmOps.toI32(VmOps.toStrAny(this.getConstByIdx(this.arg0IntOf())))))
        } else if (op == 6) {
            // [R21] Float 常量直推常量 Any（与 op7 逐字同形）——R20 版在此
            // 多包了一层 toStrAny：冗余 String→Any 转换位点被发射器按 Int
            // 装箱（栈上出现 (ptr<<1)|1 巨数，实测 2.5 → 295414120844813376）。
            // getConstByIdx 已有 P364 单返回路径修复，op7 的字符串常量全程
            // 正确 = 该形态已被多轮实证。
            this.stack.push(this.getConstByIdx(this.arg0IntOf()))
        } else if (op == 7) {
            this.stack.push(this.getConstByIdx(this.arg0IntOf()))
        } else if (op == 8) {
            this.stack.push(VmOps.toStrAny(this.getConstByIdx(this.arg0IntOf())) == "1")
        } else if (op == 9) {
            this.stack.push(null)
        }

        // ── 栈操作 ──
        else if (op == 10) {
            val slot: Int = VmOps.toI32(this.argStrOf(0))
            val v: Any = this.locals.getSlot(slot)
            // **不要**写成 `push(if (v == null) 0 else v)`：混合类型 if 表达式会被
            // 推导成 `Int`，非空分支里的 `String` 指针会被截断成整数
            //（自检样例槽位里存的是整数所以看不出来；`.auc` 路径存字符串时，
            // `println(toStr(x))` 就会打印出 0）。
            if (v == null) {
                this.stack.push(toAny(0))
            } else {
                this.stack.push(v)
            }
        } else if (op == 11) {
            val slot: Int = VmOps.toI32(this.argStrOf(0))
            this.locals.putSlot(slot, this.stack.pop())
        } else if (op == 12) {
            val slot: Int = VmOps.toI32(this.argStrOf(0))
            this.locals.putSlot(slot, toAny(0))
        } else if (op == 13) {
            this.stack.pop()
        } else if (op == 14) {
            this.stack.push(this.stack.peek())
        } else if (op == 15) {
            val top: Any = this.stack.pop()
            val second: Any = this.stack.pop()
            this.stack.push(top)
            this.stack.push(second)
        }

        // ── 算术运算 ──
        else if (op == 20) {
            val b: Any = this.stack.pop()
            val a: Any = this.stack.pop()
            this.stack.push(VmOps.add(a, b))
        } else if (op == 21) {
            val b: Any = this.stack.pop()
            val a: Any = this.stack.pop()
            this.stack.push(VmOps.sub(a, b))
        } else if (op == 22) {
            val b: Any = this.stack.pop()
            val a: Any = this.stack.pop()
            // [R21] Float 文本分支 dispatch 层内联（同 op20/21 注释）
            if (VmOps.isFloatText(a) || VmOps.isFloatText(b)) {
                val d22: Int = VmOps.floatDecimalsOf(a) + VmOps.floatDecimalsOf(b)
                this.stack.push(VmOps.floatTextOf(VmOps.floatMantissaOf(a) * VmOps.floatMantissaOf(b), d22))
            } else {
                this.stack.push(VmOps.mul(a, b))
            }
        } else if (op == 23) {
            val b: Any = this.stack.pop()
            val a: Any = this.stack.pop()
            if (VmOps.isFloatText(a) || VmOps.isFloatText(b)) {
                // 定标 6 位小数的整数除法
                val mB23: Int = VmOps.floatMantissaOf(b)
                if (mB23 == 0) {
                    this.stack.push("0.0")
                } else {
                    val scale23: Int = 6 + VmOps.floatDecimalsOf(b) - VmOps.floatDecimalsOf(a)
                    var m23: Int = VmOps.floatMantissaOf(a)
                    var k23: Int = 0
                    if (scale23 > 0) {
                        while (k23 < scale23) {
                            m23 = m23 * 10
                            k23 = k23 + 1
                        }
                    } else {
                        while (k23 < -scale23) {
                            m23 = m23 / 10
                            k23 = k23 + 1
                        }
                    }
                    this.stack.push(VmOps.floatTextOf(m23 / mB23, 6))
                }
            } else {
                this.stack.push(VmOps.div(a, b))
            }
        } else if (op == 24) {
            val b: Any = this.stack.pop()
            val a: Any = this.stack.pop()
            if (VmOps.isFloatText(a) || VmOps.isFloatText(b)) {
                val dA24: Int = VmOps.floatDecimalsOf(a)
                val dB24: Int = VmOps.floatDecimalsOf(b)
                var d24: Int = dA24
                if (dB24 > d24) { d24 = dB24 }
                val p24: Int = VmOps.floatPow10(d24)
                val mA24: Int = VmOps.floatMantissaOf(a) * VmOps.floatPow10(d24 - dA24)
                val mB24: Int = VmOps.floatMantissaOf(b) * VmOps.floatPow10(d24 - dB24)
                if (mB24 == 0) {
                    this.stack.push("0.0")
                } else {
                    this.stack.push(VmOps.floatTextOf(mA24 - mA24 / mB24 * mB24, d24))
                }
            } else {
                this.stack.push(VmOps.mod(a, b))
            }
        } else if (op == 25) {
            val a: Any = this.stack.pop()
            if (VmOps.isFloatText(a)) {
                this.stack.push(VmOps.floatTextOf(-VmOps.floatMantissaOf(a), VmOps.floatDecimalsOf(a)))
            } else {
                this.stack.push(VmOps.neg(a))
            }
        } else if (op == 26) {
            val a: Any = this.stack.pop()
            this.stack.push(a)
        }

        // ── 比较运算 ──
        else if (op == 30) {
            val b: Any = this.stack.pop()
            val a: Any = this.stack.pop()
            this.stack.push(VmOps.eq(a, b))
        } else if (op == 31) {
            val b: Any = this.stack.pop()
            val a: Any = this.stack.pop()
            this.stack.push(VmOps.neq(a, b))
        } else if (op == 32) {
            val b: Any = this.stack.pop()
            val a: Any = this.stack.pop()
            this.stack.push(VmOps.lt(a, b))
        } else if (op == 33) {
            val b: Any = this.stack.pop()
            val a: Any = this.stack.pop()
            this.stack.push(VmOps.gt(a, b))
        } else if (op == 34) {
            val b: Any = this.stack.pop()
            val a: Any = this.stack.pop()
            this.stack.push(VmOps.le(a, b))
        } else if (op == 35) {
            val b: Any = this.stack.pop()
            val a: Any = this.stack.pop()
            this.stack.push(VmOps.ge(a, b))
        }

        // ── 逻辑/位运算 ──
        else if (op == 40) {
            val b: Any = this.stack.pop()
            val a: Any = this.stack.pop()
            this.stack.push(VmOps.and(a, b))
        } else if (op == 41) {
            val b: Any = this.stack.pop()
            val a: Any = this.stack.pop()
            this.stack.push(VmOps.or(a, b))
        } else if (op == 42) {
            val a: Any = this.stack.pop()
            this.stack.push(VmOps.not(a))
        } else if (op == 43) {
            val b: Any = this.stack.pop()
            val a: Any = this.stack.pop()
            this.stack.push(VmOps.bitAnd(a, b))
        } else if (op == 44) {
            val b: Any = this.stack.pop()
            val a: Any = this.stack.pop()
            this.stack.push(VmOps.bitOr(a, b))
        } else if (op == 45) {
            val b: Any = this.stack.pop()
            val a: Any = this.stack.pop()
            this.stack.push(VmOps.bitXor(a, b))
        } else if (op == 46) {
            val b: Any = this.stack.pop()
            val a: Any = this.stack.pop()
            this.stack.push(VmOps.shl(a, b))
        } else if (op == 47) {
            val b: Any = this.stack.pop()
            val a: Any = this.stack.pop()
            this.stack.push(VmOps.shr(a, b))
        }

        // ── 控制流 ──
        else if (op == 50) {
            this.ip = VmOps.toI32(this.argStrOf(0))
        } else if (op == 51) {
            val cond: Any = this.stack.pop()
            if (!VmOps.toBool(cond)) {
                this.ip = VmOps.toI32(this.argStrOf(0))
            }
        } else if (op == 52) {
            val cond: Any = this.stack.pop()
            if (VmOps.toBool(cond)) {
                this.ip = VmOps.toI32(this.argStrOf(0))
            }
        } else if (op == 53) {
            this.running = false
        } else if (op == 54) {
            // SSA phi 节点：在文本模式下为 no-op
        }

        // ── 函数调用 ──
        else if (op == 60) {
            val funcName: String = this.argStrOf(0)
            // 文本字节码：`CALL name argc`；.auc 二进制：`CALL <函数下标>`（无 argc，
            // 由函数表的参数个数补全）。
            var argc: Int = 0
            if (this.argCountOf() >= 2) {
                argc = VmOps.toI32(this.argStrOf(1))
            } else {
                argc = this.funcParamCount(funcName)
                if (argc < 0) { argc = 0 }
            }
            this.callOrBuiltin(funcName, argc)
        } else if (op == 61) {
            val methodName: String = this.argStrOf(0)
            this.callMethod(methodName)
        } else if (op == 62) {
            // `.auc` 路径：加载器已把原生函数**下标**解析成名字，
            // 直接复用内建分派（println / toStr / …）。
            val fname: String = this.argStrOf(0)
            var argc2: Int = 0
            if (this.argCountOf() >= 2) {
                argc2 = VmOps.toI32(this.argStrOf(1))
            }
            // [根修轮R4] 有界诊断（专用计数器，独立于 instructionCount）：
            // 前 20 次 CALL_NATIVE_ARGS 实名 fname/argc——死循环 = fname 漂移
            // 撞上 .auc 自身函数名的假设验证点。
            if (this.p62DiagCount < 20) {
                this.p62DiagCount = this.p62DiagCount + 1
                println("[62] fname=[" + fname + "] argc=" + toStr(argc2)
                    + " fn=[" + this.currentFunc + "]")
            }
            this.callOrBuiltin(fname, argc2)
        } else if (op == 63) {
            val idx: Int = VmOps.toI32(this.argStrOf(0))
            this.callNative(idx)
        } else if (op == 64) {
            val idx: Int = VmOps.toI32(this.argStrOf(0))
            this.callC(idx)
        } else if (op == 65) {
            this.returnFromFunc()
        } else if (op == 66) {
            this.returnValue = "Unit"
            this.returnFromFunc()
        } else if (op == 211) {
            // P1.6：尾调用（帧复用）。文本：`CALL_TAIL name argc`；argc 省略时按函数表推导。
            val tFunc: String = this.argStrOf(0)
            var tArgc: Int = 0
            if (this.argCountOf() >= 2) {
                tArgc = VmOps.toI32(this.argStrOf(1))
            } else {
                tArgc = this.funcParamCount(tFunc)
                if (tArgc < 0) { tArgc = 0 }
            }
            this.callTail(tFunc, tArgc)
        }

        // ── 对象/类 ──
        else if (op == 70) {
            val className: String = this.argStrOf(0)
            this.newObject(className)
        } else if (op == 71) {
            val fieldName: String = this.argStrOf(0)
            this.getField(fieldName)
        } else if (op == 72) {
            val fieldName: String = this.argStrOf(0)
            this.setField(fieldName)
        } else if (op == 73) {
            val size: Any = this.stack.pop()
            this.newArray(size)
        } else if (op == 74) {
            this.getIndex()
        } else if (op == 75) {
            this.setIndex()
        } else if (op == 76) {
            val ctorName: String = this.argStrOf(0)
            this.callCtor(ctorName)
        } else if (op == 210) {
            // P1.2：声明类继承（parent "-" 或空 = 无父类）
            var parent: String = ""
            if (this.argCountOf() >= 2) { parent = this.argStrOf(1) }
            this.defClass(this.argStrOf(0), parent)
        }

        // ── 集合 ──
        else if (op == 80) {
            // [R24] NEW_LIST 内联（Memory 直操，R23 判决：原臂调用链宿主产
            // 码崩，凡含列表字面量 100% 死于本臂）。布局 len@0/cap@8/items@16
            //（Collections 兼容）；kind 线性登记供 Collections.set 双分派。
            val l80: Long = Memory.alloc(24)
            Memory.write64(l80, 0)
            Memory.write64(l80 + 8, 4)
            val items80: Long = Memory.alloc(32)
            Memory.write64(l80 + 16, items80)
            this.stack.push(l80 as Any)
            this.heapKindKeys.add(VmOps.ptrKeyOf(this.stack.peek()))
            this.heapKindVals.add("list")
        } else if (op == 81) {
            // [R24] NEW_MAP 同款内联：len@0/cap@8/keys@16/vals@24。
            val m81: Long = Memory.alloc(32)
            Memory.write64(m81, 0)
            Memory.write64(m81 + 8, 4)
            val keys81: Long = Memory.alloc(32)
            val vals81: Long = Memory.alloc(32)
            Memory.write64(m81 + 16, keys81)
            Memory.write64(m81 + 24, vals81)
            this.stack.push(m81 as Any)
            this.heapKindKeys.add(VmOps.ptrKeyOf(this.stack.peek()))
            this.heapKindVals.add("map")
        } else if (op == 82) {
            val list: Any = this.stack.pop()
            val elem: Any = this.stack.pop()
            VmCollections.push(list, elem)
        } else if (op == 83) {
            val list: Any = this.stack.peek()
            this.stack.push(VmCollections.pop(list))
        } else if (op == 84) {
            // `.auc`（Rust MIR）语义是 **pop**（`Instr::ListLen`）；Aura 文本字节码用 peek
            if (this.aucMode) {
                val list: Any = this.stack.pop()
                this.stack.push(VmCollections.length(list))
            } else {
                val list: Any = this.stack.peek()
                this.stack.push(VmCollections.length(list))
            }
        } else if (op == 85) {
            val map: Any = this.stack.pop()
            val key: Any = this.stack.pop()
            val val: Any = this.stack.pop()
            VmCollections.mapSet(map, key, val)
        } else if (op == 86) {
            val map: Any = this.stack.pop()
            val key: Any = this.stack.pop()
            this.stack.push(VmCollections.mapGet(map, key))
        } else if (op == 87) {
            val map: Any = this.stack.peek()
            this.stack.push(VmCollections.mapLen(map))
        }

        // ── 闭包 ──
        else if (op == 90) {
            this.loadClosure(this.argStrOf(0))
        } else if (op == 91) {
            this.makeClosure(this.argStrOf(0))
        } else if (op == 92) {
            this.callClosureAt()
        } else if (op == 93) {
            this.loadUpvalue(VmOps.toI32(this.argStrOf(0)))
        } else if (op == 94) {
            this.storeUpvalue(VmOps.toI32(this.argStrOf(0)))
        }

        // ── 类型检查 ──
        else if (op == 100) {
            val typeName: String = this.argStrOf(0)
            this.instanceOf(typeName)
        } else if (op == 101) {
            val typeName: String = this.argStrOf(0)
            this.checkCast(typeName)
        } else if (op == 102) {
            val typeName: String = this.argStrOf(0)
            this.cast(typeName)
        } else if (op == 103) {
            val typeName: String = this.argStrOf(0)
            this.checkType(typeName)
        }

        // ── ARC 生命周期 ──
        else if (op == 110) {
            this.incRef()
        } else if (op == 111) {
            this.decRef()
        } else if (op == 112) {
            this.retain()
        } else if (op == 113) {
            this.release()
        } else if (op == 114) {
            this.dropRef()
        } else if (op == 115) {
            this.weakRef()
        } else if (op == 116) {
            this.weakGet()
        } else if (op == 117) {
            this.boxAlloc()
        }

        // ── defer ──
        else if (op == 120) {
            // defer 区域开始（由 VM 管理清理栈）
        } else if (op == 121) {
            // defer 区域结束
        }

        // ── 协程（D5：已废弃，指令不进入 ADR-001 指令集，走到 else 报未知指令）──

        // ── FFI ──
        else if (op == 130) {
            this.cstring()
        } else if (op == 131) {
            this.readCstr()
        } else if (op == 132) {
            this.ptrIsNull()
        } else if (op == 133) {
            this.ptrToInt()
        } else if (op == 134) {
            this.intToPtr()
        }

        // ── 异常处理 ──
        else if (op == 122) {
            this.pushHandlerAt()
        } else if (op == 123) {
            this.popHandler()
        } else if (op == 124) {
            this.throwException()
        }

        // ── 并发 ──
        else if (op == 140) {
            this.threadSpawn()
        } else if (op == 141) {
            this.threadJoin()
        } else if (op == 142) {
            this.threadSleep()
        } else if (op == 143) {
            this.threadId()
        } else if (op == 144) {
            this.threadParallelism()
        } else if (op == 150) {
            this.mutexNew()
        } else if (op == 151) {
            this.mutexLock()
        } else if (op == 152) {
            this.mutexUnlock()
        } else if (op == 153) {
            this.mutexTryLock()
        } else if (op == 160) {
            this.channelNew()
        } else if (op == 161) {
            this.channelSend()
        } else if (op == 162) {
            this.channelRecv()
        } else if (op == 170) {
            this.atomicNew()
        } else if (op == 171) {
            this.atomicLoad()
        } else if (op == 172) {
            this.atomicStore()
        } else if (op == 173) {
            this.atomicAdd()
        } else if (op == 174) {
            this.atomicCas()
        } else if (op == 180) {
            this.rwLockNew()
        } else if (op == 181) {
            this.rwLockReadLock()
        } else if (op == 182) {
            this.rwLockWriteLock()
        } else if (op == 183) {
            this.rwLockReadUnlock()
        } else if (op == 184) {
            this.rwLockWriteUnlock()
        } else if (op == 190) {
            this.condvarNew()
        } else if (op == 191) {
            this.condvarWait()
        } else if (op == 192) {
            this.condvarSignal()
        } else if (op == 193) {
            this.condvarBroadcast()
        }

        // ── 枚举 ──
        else if (op == 200) {
