        // 调用窗（value-class 方法族，R19 toUpperCase 同款）在长堆串上
        // 掷骰死：实测 29 字符 "aura.lang.std.Collections.set" 挂起于本点。
        var qual24: Boolean = true
        if (argc < -1000) { qual24 = false }
        // [R167] 字面量接收者先落局部：`"aura.lang.".charCodeAt(qc)` 的
        // 接收者是指向 .rdata 的字符串字面量，Photon 后端在这条调用点上
        // （大函数 + 深调用栈）会把它译成野指针 ⇒ 首轮比较即 0xC0000005。
        // 同一表达式在小函数里是好的（build/vmhost-src/litprobe.aura 实测
        // 逐字符正确）⇒ 是后端布局敏感的已知缺陷（P5-①），不是本段语义问题。
        // 落成局部后接收者走栈槽，实测稳定。
        val qref: String = "aura.lang."
        var qc: Int = 0
        while (qc < 10) {
            if (funcName0.charCodeAt(qc) != qref.charCodeAt(qc)) {
                qual24 = false
                qc = 10
            }
            qc = qc + 1
        }
        val funcName: String = if (qual24) {
            var fnLen: Int = 0
            while (funcName0.charCodeAt(fnLen) != 0) {
                fnLen = fnLen + 1
            }
            var lastDot: Int = -1
            var q: Int = 0
            while (q < fnLen) {
                if (funcName0.charCodeAt(q) == 46) { lastDot = q }
                q = q + 1
            }
            if (lastDot >= 0 && lastDot + 1 < fnLen) {
                val stripped: String = VmOps.vmSubstr(funcName0, lastDot + 1, fnLen - lastDot - 1)
                stripped
            } else {
                funcName0
            }
        } else {
            funcName0
        }
        // [R24] Collections 原生族路由（限定名剥离后的短名在此接住；全名
        // 由链首臂处理）。set 语义改判：种子 nat_set = **原位写 + 返回集合**
        //（HIR 把 `xs[i]=v` 降级为 `xs = Collections.set(xs,i,v)` 表达式——
        // 旧 void 语义不压栈 ⇒ STORE_LOCAL 弹空 = 栈失衡家族）。写路径内联
        // Memory 直操（vmListSet 调用窗与 op80 newList 同族掷骰死，R23 判决）。
        if (funcName == "set" || funcName == "__list_set"
            || funcName == "Collections.set" || funcName == "aura.lang.std.Collections.set"
            || funcName == "Collections.listSet" || funcName == "aura.lang.std.Collections.listSet") {
            val vS: Any = this.stack.pop()
            val idxS: Any = this.stack.pop()
            val listS: Any = this.stack.pop()
            val ptrS: Long = VmOps.rawOf(listS)
            val keyS: String = VmOps.ptrKeyOf(listS)
            val knS: Int = this.heapKindKeys.size()
            var kindS: String = ""
            var kiS: Int = 0
            while (kiS < knS) {
                if (VmOps.toI32(this.heapKindKeys[kiS]) == VmOps.toI32(keyS)) {
                    kindS = this.heapKindVals[kiS]
                    kiS = knS
                }
                kiS = kiS + 1
            }
            if (ptrS != 0) {
                if (kindS == "map") {
                    VmCollections.mapSet(listS, idxS, vS)
                } else {
                    val lenS: Long = Memory.read64(ptrS)
                    val indexS: Long = VmOps.intOf(idxS) as Long
                    if (indexS >= 0 && indexS < lenS) {
                        val itemsS: Long = Memory.read64(ptrS + 16)
                        if (itemsS != 0) {
                            Memory.write64(itemsS + indexS * 8, VmOps.rawOf(vS))
                        }
                    } else {
                        VmCollections.push(listS, vS)
                    }
                }
            }
            this.stack.push(listS)
            return
        }
        if (funcName == "listSize" || funcName == "aura.lang.std.Collections.listSize") {
            val lN: Any = this.stack.pop()
            val ptrN: Long = VmOps.rawOf(lN)
            if (ptrN == 0) {
                this.stack.push(VmOps.toAny(0))
            } else {
                this.stack.push(VmOps.toAny(Memory.read64(ptrN) as Int))
            }
            return
        }
        if (funcName == "get" || funcName == "__get"
            || funcName == "listGet" || funcName == "aura.lang.std.Collections.listGet"
            || funcName == "getAt" || funcName == "aura.lang.std.Collections.getAt") {
            val idx: Any = this.stack.pop()
            val list: Any = this.stack.pop()
            this.stack.push(VmCollections.vmListAt(list, idx))
            return
        }
        if (funcName == "__list_is_empty") {
            val list: Any = this.stack.pop()
            this.stack.push(if (VmCollections.length(list) == 0) { 1 } else { 0 })
            return
        }
        // [根修轮R5] 异常族路由（P5 缺口③）：throwException 语义完备
        //（handler 走栈/帧截断/类型匹配），只差分派。
        if (funcName == "__throw") {
            this.throwException()
            return
        }
        if (funcName == "__new_exception") {
            val msg: String = this.collectArgs(argc)
            this.stack.push(msg)
            return
        }
        // [根修轮R5] native 小内建（R5a 实证：aura_isOfType/ThreadOps.cores
        // 各自的测试在路由后通过）
        if (funcName == "rdtsc") {
            this.stack.push(VmOps.rawOf(Cpu.rdtsc()))
            return
        }
        if (funcName == "MemoryAlloc") {
            val n3: Int = VmOps.intOf(this.stack.pop())
            this.stack.push(Memory.alloc(n3))
            return
        }
        if (funcName == "ThreadOps.cores" || funcName == "cores") {
            this.stack.push(ThreadOps.cores())
            return
        }
        if (funcName == "aura_isOfType") {
            val tn: String = toStr(this.stack.pop())
            val v: Any = this.stack.pop()
            if (tn == VmOps.typeName(v)) { this.stack.push(1) } else { this.stack.push(0) }
            return
        }
        if (funcName == "arrayOf2D") {
            val cols: Int = VmOps.intOf(this.stack.pop())
            val rows: Int = VmOps.intOf(this.stack.pop())
            var grid: String = "["
            var r3: Int = 0
            while (r3 < rows) {
                if (r3 > 0) { grid = grid + "," }
                grid = grid + "["
                var c3: Int = 0
                while (c3 < cols) {
                    if (c3 > 0) { grid = grid + "," }
                    grid = grid + "0"
                    c3 = c3 + 1
                }
                grid = grid + "]"
                r3 = r3 + 1
            }
            this.stack.push(grid + "]")
            return
        }
        // ── P393：用户函数快速路径（缓存命中时跳过内建名 if-else 链）──
        //
        // 内建分派是一条数十臂的 `funcName == "…"` 链（每臂一次 streq
        // runtime 调用），用户函数名（fibonacci/add/…）排在链尾——递归
        // 负载（fib28 = 63 万次 CALL）每次都要全链扫到底，估算占解释时间
        // 一半以上。cfName 单槽（P391）命中且为用户函数时，直接执行调用
        // 序列；首次/内建/未知名走下方原链（内建臂执行后早退不经过回填，
        // cfName 只会是用户函数名或未知名，语义自洽）。
        if (this.cfName == funcName && this.cfIsUser == 1) {
            val target: Int = this.cfTarget
            val pc: Int = this.cfPc
            this.callStack.push(this.ip, this.currentFrame, this.currentFunc, this.currentClosure)
            this.savedFramesAdd(this.locals)
            this.locals = this.popLocalsPool()
            var k: Int = pc - 1
            while (k >= 0 && k < argc) {
                this.locals.putSlot(k + this.aucArgBase, this.stack.pop())
                k = k - 1
            }
            this.currentFunc = funcName
            this.currentFrame = this.currentFrame + 1
            this.ip = target
            return
        }
        // 内置函数        // 内置函数
        // ── [R24] Collections 原生族（置链首：短名臂在链深处够不到全名，
        // 且链评估本身在特定串长掷骰挂起）——.auc 的 `xs[i] = v` 编译为
        // aura.lang.std.Collections.set 原生调用。map/list 双分派按登记。──
        if (funcName == "Collections.set" || funcName == "aura.lang.std.Collections.set"
            || funcName == "Collections.listSet" || funcName == "aura.lang.std.Collections.listSet") {
            val valS: Any = this.stack.pop()
            val idxS: Any = this.stack.pop()
            val listS: Any = this.stack.pop()
            println("[S1] entered set")
            val keyS: String = VmOps.ptrKeyOf(listS)
            println("[S2] key ok len=" + toStr(this.heapKindKeys.size()))
            val kn: Int = this.heapKindKeys.size()
            var kindS: String = ""
            var ki: Int = 0
            while (ki < kn) {
                if (this.heapKindKeys[ki] == keyS) {
                    kindS = this.heapKindVals[ki]
                    ki = kn
                }
                ki = ki + 1
            }
            // ⚠️ [S3]/[S4] 两条 println 是**承重墙**：P5-① 布局敏感家族——
            // 删掉它们会移动 callOrBuiltin（37KB 帧）的产码布局，把 18/26
            // 的通过集整体洗牌（r175e 实测 JIT 18→3，几乎全 AV）。语义上
            // 它们只是 set 臂的旧调试打印，但布局上不可动。留置并注明。
            println("[S3] kind=[" + kindS + "]")
            if (kindS == "map") {
                VmCollections.mapSet(listS, idxS, valS)
            } else {
                VmCollections.vmListSet(listS, idxS, valS)
            }
            println("[S4] set done")
            this.stack.push(listS)
            return
        } else if (funcName == "Collections.listOf" || funcName == "aura.lang.std.Collections.listOf"
            || funcName == "Collections.mutableListOf" || funcName == "aura.lang.std.Collections.mutableListOf"
            || funcName == "Collections.emptyList" || funcName == "aura.lang.std.Collections.emptyList") {
            val baseL: Int = this.stack.stackDepth() - argc
            val nl: Any = VmCollections.newList()
            var jL: Int = 0
            while (jL < argc) {
                if (baseL >= 0) {
                    VmCollections.push(nl, this.stack.vmSlotAt(baseL + jL))
                }
                jL = jL + 1
            }
            var kL: Int = 0
            while (kL < argc) {
                this.stack.pop()
                kL = kL + 1
            }
            this.heapKindKeys.add(VmOps.ptrKeyOf(nl))
            this.heapKindVals.add("list")
            this.stack.push(nl)
            return
        } else if (funcName == "Collections.listAppend" || funcName == "aura.lang.std.Collections.listAppend") {
            val vA: Any = this.stack.pop()
            val lA: Any = this.stack.pop()
            VmCollections.push(lA, vA)
            this.stack.push(lA)
            return
        } else if (funcName == "Collections.listSize" || funcName == "aura.lang.std.Collections.listSize") {
            val lI: Any = this.stack.pop()
            this.stack.push(VmCollections.length(lI))
            return
        } else if (funcName == "Collections.isEmpty" || funcName == "aura.lang.std.Collections.isEmpty") {
            val lE: Any = this.stack.pop()
            val nE: Any = VmCollections.length(lE)
            this.stack.push(VmOps.toI32(VmOps.toStrAny(nE)) == 0)
            return
        } else if (funcName == "Collections.listGet" || funcName == "aura.lang.std.Collections.listGet") {
            val idxG: Any = this.stack.pop()
            val listG: Any = this.stack.pop()
            this.stack.push(VmCollections.vmListAt(listG, idxG))
            return
        } else if (funcName == "println" || funcName == "print") {
            val text: String = this.collectArgs(argc)
            if (funcName == "println") {
                println(text)
            } else {
                print(text)
            }
            this.stack.push("Unit")
            return
        } else if (funcName == "toStr" || funcName == "toString") {
            val v: Any = this.stack.pop()
            val r: String = VmOps.toStrAny(v)
            this.stack.push(r)
            return
        } else if (funcName == "toInt") {
            val v: Any = this.stack.pop()
            this.stack.push(VmOps.toI32(VmOps.toStrAny(v)))
            return
        } else if (funcName == "toFloat") {
            val v: Any = this.stack.pop()
            // [R20] Float 文本通道：归一化为浮点文本（"3"→"3.0"），不再推
            // parseFloat 位模式（偶数 = 假 "String" 指针）。
            this.stack.push(VmOps.floatTextOf(VmOps.floatMantissaOf(v), VmOps.floatDecimalsOf(v)))
            return
        } else if (funcName == "toBool") {
            val v: Any = this.stack.pop()
            this.stack.push(VmOps.toBool(v))
            return
        } else if (funcName == "aura_cast" || funcName == "aura_cast_safety") {
            // `x as T` 的运行时转换（与 AOT emit 的 aura_cast 分支同语义）。
            //
            // P0-2c（2026-10-08）：旧实现 `toStr(弹出的类型名)` 有双重缺陷——
            //   1) photon 运行时 toStr 是**纯整数**打印器（P347），对 "Long"
            //      字符串指针会打出一串**指针值十进制**（≈66B 临时串且永不
            //      回收——longstep 1M 次 `as Long` 实测 arena +66.0MB/1M 次，
            //      严丝合缝）；
            //   2) 打出来的 targetTy 是垃圾数字，`== "Long"` 等比较**全部
            //      失败**，恒走 else 透传——`as Long` 实际从未按 Long 转换过。
            // 改为 VmOps.toStrAny（真实字符串原样返回，零分配），并让
            // `as Long` 走显式恒等：Plan A 下 Int/Long 同为 64 位 tagged
            // 值（无窄化/加宽），恒等透传即正确语义、零分配。行为与修复
            // 前实际生效的「透传」一致，唯一差别是不再泄漏临时串。
            val tyRaw: Any = this.stack.pop()
            val cv: Any = this.stack.pop()
            val targetTy: String = VmOps.toStrAny(tyRaw)
            if (targetTy == "Long") {
                this.stack.push(cv)
            } else if (targetTy == "Int") {
                this.stack.push(VmOps.intOf(cv))
            } else if (targetTy == "Float" || targetTy == "Double") {
                this.stack.push(VmOps.parseFloat(VmOps.toStrAny(cv)))
            } else if (targetTy == "String") {
                this.stack.push(VmOps.toStrAny(cv))
            } else {
                this.stack.push(cv)
            }
            return
        } else if (funcName == "typeof" || funcName == "typeOf") {
            val v: Any = this.stack.pop()
            this.stack.push(VmOps.typeName(v))
            return
        } else if (funcName == "isOfType") {
            val typeName: String = toStr(this.stack.pop())
            val v: Any = this.stack.pop()
            this.stack.push(VmOps.typeName(v) == typeName)
            return
        } else if (funcName == "exit") {
            val code: Any = this.stack.pop()
            this.exitCode = VmOps.intOf(code)
            this.running = false
            return
        } else if (funcName == "throw") {
            val msg: Any = this.stack.pop()
            this.throwException()
            return
        } else if (funcName == "__callClosure" && argc >= 3) {
            // __callClosure(closure, sig, arg) — 闭包间接调用（Collections.filter/map）。
            // 栈顺序：arg, sig, closure（closure 在栈顶）。
            val closureId: Any = this.stack.pop()
            val sig: Any = this.stack.pop()  // 忽略
            val arg: Any = this.stack.pop()
            val cid: Int = VmOps.intOf(closureId)
            val funcName2: String = this.closureTable.getOrDefault(cid, "")
            if (funcName2 == "") {
                this.error = "Invalid closure id: " + toStr(cid)
                this.running = false
                return
            }
            // 将参数压回栈，递归调用目标函数
            this.stack.push(arg)
            this.callOrBuiltin(funcName2, 1)
            return
        } else if (funcName == "abs") {
            val v: Any = this.stack.pop()
            val iv: Int = VmOps.toI32(VmOps.toStrAny(v))
            this.stack.push(if (iv < 0) -iv else iv)
            return
        } else if (funcName == "min") {
            val b: Any = this.stack.pop()
            val a: Any = this.stack.pop()
            val av: Int = VmOps.intOf(a)
            val bv: Int = VmOps.intOf(b)
            this.stack.push(if (av < bv) av else bv)
            return
        } else if (funcName == "max") {
            val b: Any = this.stack.pop()
            val a: Any = this.stack.pop()
            val av: Int = VmOps.intOf(a)
            val bv: Int = VmOps.intOf(b)
            this.stack.push(if (av > bv) av else bv)
            return
        } else if (funcName == "round") {
            val v: Any = this.stack.pop()
            val fv: Float = VmOps.parseFloat(VmOps.toStrAny(v))
            this.stack.push(VmOps.toI32(toStr(fv + 0.5)))
            return
        } else if (funcName == "floor") {
            val v: Any = this.stack.pop()
            val fv: Float = VmOps.parseFloat(VmOps.toStrAny(v))
            this.stack.push(VmOps.intOf(fv))
            return
        } else if (funcName == "ceil") {
            val v: Any = this.stack.pop()
            val fv: Float = VmOps.parseFloat(VmOps.toStrAny(v))
            this.stack.push(VmOps.toI32(toStr(fv + 1)))
            return
        } else if (funcName == "listOf") {
            // 按**原顺序**取实参（见 `VmStack.vmSlotAt`：逐个 pop 会反转元素顺序）
            val list: Any = VmCollections.newList()
            val base: Int = this.stack.stackDepth() - argc
            var j: Int = 0
            while (j < argc) {
                VmCollections.push(list, this.stack.vmSlotAt(base + j))
                j = j + 1
            }
            var k: Int = 0
            while (k < argc) {
                this.stack.pop()
                k = k + 1
            }
            this.stack.push(list)
            return
        } else if (funcName == "mapOf") {
            val map: Any = VmCollections.newMap()
            var i: Int = argc - 1
            while (i >= 0) {
                val val: Any = this.stack.pop()
                val key: Any = this.stack.pop()
                VmCollections.mapSet(map, key, val)
                i = i - 1
            }
            this.stack.push(map)
            return
        } else if (funcName == "stringConcat") {
            val b: Any = this.stack.pop()
            val a: Any = this.stack.pop()
            this.stack.push(toStr(a) + toStr(b))
            return
        } else if (funcName == "error") {
            val msg: Any = this.stack.pop()
            this.error = toStr(msg)
            this.running = false
            return
        } else if (funcName == "Collections.getAt" || funcName == "aura.lang.std.Collections.getAt"
            || funcName == "__get") {
            // `.auc` 里 `xs[0]` / `xs[0)` → `Collections.getAt(list, idx)`
            val idx: Any = this.stack.pop()
            val list: Any = this.stack.pop()
            this.stack.push(VmCollections.vmListAt(list, idx))
            return
        } else if (funcName == "Collections.count" || funcName == "aura.lang.std.Collections.count"
            || funcName == "__size") {
            val list: Any = this.stack.pop()
            this.stack.push(VmCollections.length(list))
            return
        } else if (funcName == "length" || funcName == "String.length" || funcName == "strlen") {
            // `.auc` 里 `s.length` 被编译成原生调用（原生表下标 563 = `String.length`）。
            // 缺此分支会落到下面的「未知函数」兜底 → 结果恒为 0（实测 `len=0`）。
            val v: Any = this.stack.pop()
            this.stack.push(VmOps.toStrAny(v).length)
            return
        }

        // ── Math（带命名空间） ──
        else if (funcName == "aura.lang.std.Math.abs" || funcName == "Math.abs") {
            val v: Any = this.stack.pop()
            val iv: Int = VmOps.toI32(VmOps.toStrAny(v))
            this.stack.push(if (iv < 0) -iv else iv)
            return
        } else if (funcName == "aura.lang.std.Math.min" || funcName == "Math.min") {
            val b: Any = this.stack.pop()
            val a: Any = this.stack.pop()
            val av: Int = VmOps.intOf(a)
            val bv: Int = VmOps.intOf(b)
            this.stack.push(if (av < bv) av else bv)
            return
        } else if (funcName == "aura.lang.std.Math.max" || funcName == "Math.max") {
            val b: Any = this.stack.pop()
            val a: Any = this.stack.pop()
            val av: Int = VmOps.intOf(a)
            val bv: Int = VmOps.intOf(b)
            this.stack.push(if (av > bv) av else bv)
            return
        } else if (funcName == "aura.lang.std.Math.round" || funcName == "Math.round") {
            val v: Any = this.stack.pop()
            val fv: Float = VmOps.parseFloat(VmOps.toStrAny(v))
            this.stack.push(VmOps.toI32(toStr(fv + 0.5)))
            return
        } else if (funcName == "aura.lang.std.Math.floor" || funcName == "Math.floor") {
            val v: Any = this.stack.pop()
            val fv: Float = VmOps.parseFloat(VmOps.toStrAny(v))
            this.stack.push(VmOps.intOf(fv))
            return
        } else if (funcName == "aura.lang.std.Math.ceil" || funcName == "Math.ceil") {
            val v: Any = this.stack.pop()
            val fv: Float = VmOps.parseFloat(VmOps.toStrAny(v))
            this.stack.push(VmOps.toI32(toStr(fv + 1)))
            return
        } else if (funcName == "aura.lang.std.Math.sqrt" || funcName == "Math.sqrt") {
            val v: Any = this.stack.pop()
            val fv: Float = VmOps.parseFloat(VmOps.toStrAny(v))
            this.stack.push(VmOps.sqrt(fv))
            return
        } else if (funcName == "aura.lang.std.Math.pow" || funcName == "Math.pow") {
            val b: Any = this.stack.pop()
            val a: Any = this.stack.pop()
            this.stack.push(VmOps.pow(VmOps.parseFloat(toStr(a)), VmOps.parseFloat(toStr(b))))
            return
        }

        // ── String 方法（带命名空间） ──
        else if (funcName == "String.isEmpty" || funcName == "isEmpty") {
            val v: Any = this.stack.pop()
            this.stack.push(VmOps.toStrAny(v).length == 0)
            return
        } else if (funcName == "String.toUpper" || funcName == "toUpper") {
            val v: Any = this.stack.pop()
            val svtoUpperCase: String = toStr(v)
            this.stack.push(svtoUpperCase.toUpperCase())
            return
        } else if (funcName == "String.toLower" || funcName == "toLower") {
            val v: Any = this.stack.pop()
            val svtoLowerCase: String = toStr(v)
            this.stack.push(svtoLowerCase.toLowerCase())
            return
        } else if (funcName == "String.contains" || funcName == "contains") {
            val sub: Any = this.stack.pop()
            val v: Any = this.stack.pop()
            this.stack.push(VmOps.contains(toStr(v), toStr(sub)))
            return
        } else if (funcName == "String.trim" || funcName == "trim") {
            val v: Any = this.stack.pop()
            this.stack.push(VmOps.trim(toStr(v)))
            return
        } else if (funcName == "String.startsWith" || funcName == "startsWith") {
            val prefix: Any = this.stack.pop()
            val v: Any = this.stack.pop()
            this.stack.push(VmOps.startsWith(toStr(v), toStr(prefix)))
            return
        } else if (funcName == "String.endsWith" || funcName == "endsWith") {
            val suffix: Any = this.stack.pop()
            val v: Any = this.stack.pop()
            this.stack.push(VmOps.endsWith(toStr(v), toStr(suffix)))
            return
        } else if (funcName == "String.split" || funcName == "split") {
            val sep: Any = this.stack.pop()
            val v: Any = this.stack.pop()
            val sepStr: String = toStr(sep)
            val text: String = toStr(v)
            val result: Any = VmCollections.newList()
            if (sepStr == "") {
                // 空分隔符：每字符一个元素
                var ci: Int = 0
                val textLen: Int = text.length
                while (ci < textLen) {
                    VmCollections.push(result, String.fromCharCode(text.charCodeAt(ci)))
                    ci = ci + 1
                }
                this.stack.push(result)
                return
            }
            var pos: Int = 0
            val textLen2: Int = text.length
            while (pos < textLen2) {
                val idx: Int = VmOps.indexOf(text, sepStr, pos)
                if (idx < 0) {
                    VmCollections.push(result, VmOps.vmSubstr(text, pos, textLen2 - pos))
                    break
                }
                VmCollections.push(result, VmOps.vmSubstr(text, pos, idx - pos))
                pos = idx + sepStr.length
            }
            this.stack.push(result)
            return
        } else if (funcName == "String.replace" || funcName == "replace") {
            val newStr: Any = this.stack.pop()
            val oldStr: Any = this.stack.pop()
            val v: Any = this.stack.pop()
            this.stack.push(VmOps.replace(toStr(v), toStr(oldStr), toStr(newStr)))
            return
        }

        // ── `.auc` 原生名别名（P2.2：.auc 的原生表使用 std 全名，
        //    与上方短名不同；差分框架实测补齐）──
        // [R19] 两层修复：
        //   1) 转换统一走 VmOps.toStrAny——bare toStr 在本宿主布局的多个
        //      调用窗返回陈旧值（历史案例：collectArgs 同一次 toStr(v) 得
        //      "5"；本轮 02-strings 实测 charAt 经 toStr 得 "5"）。
        //   2) 大小写变换**不再调用核心 String.toUpperCase/toLowerCase 方法**
        //      ——该 value-class 方法调用窗在宿主管线下脆断（R19 实测：一次
        //      构建返回 ""、重掷后 SEGFAULT），改用已证原语内联实现
        //      （charCodeAt 扫描 + fromCharCode + strcat 拼接，与
        //      VmOps.vmSubstr 同一可靠模式）。
        else if (funcName == "String.toUpperCase" || funcName == "toUpperCase") {
            val v: Any = this.stack.pop()
            val sUpper: String = VmOps.toStrAny(v)
            val outUpper: String = VmOps.toUpper(sUpper)
            this.stack.push(outUpper)
            return
        } else if (funcName == "String.toLowerCase" || funcName == "toLowerCase") {
            val v: Any = this.stack.pop()
            val sLower: String = VmOps.toStrAny(v)
            val outLower: String = VmOps.toLower(sLower)
            this.stack.push(outLower)
            return
        } else if (funcName == "String.charAt" || funcName == "charAt") {
            val idx: Any = this.stack.pop()
            val v: Any = this.stack.pop()
            val s: String = VmOps.toStrAny(v)
            val i: Int = VmOps.intOf(idx)
            var outC: String = ""
            if (i < 0 || i >= VmOps.strLenRaw(s)) {
                outC = ""
            } else {
                outC = VmOps.vmSubstr(s, i, 1)
            }
            this.stack.push(outC)
            return
        } else if (funcName == "String.indexOf" || funcName == "indexOf") {
            val sub: Any = this.stack.pop()
            val v: Any = this.stack.pop()
            this.stack.push(VmOps.indexOf(toStr(v), toStr(sub), 0))
            return
        } else if (funcName == "String.substring" || funcName == "substring") {
            val endI: Any = this.stack.pop()
            val startI: Any = this.stack.pop()
            val v: Any = this.stack.pop()
            val s: String = toStr(v)
            val st: Int = VmOps.intOf(startI)
            var en: Int = VmOps.intOf(endI)
            if (st < 0) { this.stack.push(""); return }
            if (st >= s.length) { this.stack.push(""); return }
            if (en > s.length) { en = s.length }
            if (en <= st) { this.stack.push(""); return }
            this.stack.push(VmOps.vmSubstr(s, st, en - st))
            return
        } else if (funcName == "Collections.set" || funcName == "aura.lang.std.Collections.set") {
            // xs[idx] = value：栈顶 value、其下 idx、其下列表
            val value: Any = this.stack.pop()
            val idx: Any = this.stack.pop()
            val list: Any = this.stack.pop()
            this.stack.push(VmCollections.vmListSet(list, idx, value))
            return
        }

        // ── 文件 I/O ──
        else if (funcName == "fileRead" || funcName == "IO.fileRead"
            || funcName == "aura.lang.std.IO.fileRead") {
            val path: Any = this.stack.pop()
            this.stack.push(IO.readFile(toStr(path)))
            return
        } else if (funcName == "fileWrite" || funcName == "IO.fileWrite"
            || funcName == "aura.lang.std.IO.fileWrite") {
            val content: Any = this.stack.pop()
            val path: Any = this.stack.pop()
            IO.writeFile(toStr(path), toStr(content))
            this.stack.push("Unit")
            return
        } else if (funcName == "readLine" || funcName == "IO.readLine"
            || funcName == "aura.lang.std.IO.readLine") {
            this.stack.push(IO.readLine())
            return
        }

        // ── Process ──
        else if (funcName == "argCount" || funcName == "Process.argCount"
            || funcName == "aura.lang.std.Process.argCount") {
            this.stack.push(Process.argCount())
            return
        } else if (funcName == "arg" || funcName == "Process.arg"
            || funcName == "aura.lang.std.Process.arg") {
            val idx: Any = this.stack.pop()
            this.stack.push(Process.arg(VmOps.intOf(idx)))
            return
        } else if (funcName == "ProcessOps.aura_process_argCount") {
            // ⚠️ 种子编译器把 `Process.argCount()` 直接降级为 extern 原生调用
            //（.auc 原生名 = 全限定接口名），不经 Aura 包装器。自举 Stage-2 的
            // 编译器 .acu 一进 main 就撞在这里（实测 VM-ERROR=Unknown function:
            // ProcessOps.aura_process_argCount，2026-10-05）。AOT 载体
            //（auc_vm_runner.exe）里 Process.argCount() 走同一 C 访问器，
            // 拿到的就是宿主 argv ✓。
            this.stack.push(Process.argCount())
            return
        } else if (funcName == "ProcessOps.aura_process_args") {
            // 全量 argv 以 '\n' 连接（与 C 侧 aura_process_args 语义一致；
            // ProcessNative.arg(i) 即按 '\n' 切分）。
            val cnt: Int = Process.argCount()
            var all: String = ""
            var ai: Int = 0
            while (ai < cnt) {
                if (ai > 0) { all = all + "\n" }
                all = all + Process.arg(ai)
                ai = ai + 1
            }
            this.stack.push(all)
            return
        } else if (funcName == "Memory.alloc") {
            val n: Any = this.stack.pop()
            this.stack.push(Memory.alloc(VmOps.addrOf(n)))
            return
        } else if (funcName == "Memory.free") {
            val n: Any = this.stack.pop()
            Memory.free(VmOps.addrOf(n))
            this.stack.push("Unit")
            return
        } else if (funcName == "Memory.read") {
            val n: Any = this.stack.pop()
            this.stack.push(Memory.read(VmOps.addrOf(n)) as Int)
            return
        } else if (funcName == "Memory.read16") {
            val n: Any = this.stack.pop()
            this.stack.push(Memory.read16(VmOps.addrOf(n)) as Int)
            return
        } else if (funcName == "Memory.read32") {
            val n: Any = this.stack.pop()
            this.stack.push(Memory.read32(VmOps.addrOf(n)))
            return
        } else if (funcName == "Memory.read64") {
            val n: Any = this.stack.pop()
            this.stack.push(Memory.read64(VmOps.addrOf(n)))
            return
        } else if (funcName == "Memory.write") {
            val v: Any = this.stack.pop()
            val n: Any = this.stack.pop()
            Memory.write(VmOps.addrOf(n), VmOps.toI32(VmOps.toStrAny(v)) as Byte)
            this.stack.push("Unit")
            return
        } else if (funcName == "Memory.write16") {
            val v: Any = this.stack.pop()
            val n: Any = this.stack.pop()
            Memory.write16(VmOps.addrOf(n), VmOps.toI32(VmOps.toStrAny(v)) as Short)
            this.stack.push("Unit")
            return
        } else if (funcName == "Memory.write32") {
            val v: Any = this.stack.pop()
            val n: Any = this.stack.pop()
            Memory.write32(VmOps.addrOf(n), VmOps.toI32(VmOps.toStrAny(v)))
            this.stack.push("Unit")
            return
        } else if (funcName == "Memory.write64") {
            val v: Any = this.stack.pop()
            val n: Any = this.stack.pop()
            Memory.write64(VmOps.addrOf(n), VmOps.addrOf(v))
            this.stack.push("Unit")
            return
        } else if (funcName == "Memory.copy") {
            val ln: Any = this.stack.pop()
            val src: Any = this.stack.pop()
            val dst: Any = this.stack.pop()
            Memory.copy(VmOps.addrOf(dst), VmOps.addrOf(src),
                        VmOps.addrOf(ln))
            this.stack.push("Unit")
            return
        } else if (funcName == "Memory.set") {
            val ln: Any = this.stack.pop()
            val v: Any = this.stack.pop()
            val n: Any = this.stack.pop()
            Memory.set(VmOps.addrOf(n), VmOps.toI32(VmOps.toStrAny(v)) as Byte,
                       VmOps.addrOf(ln))
            this.stack.push("Unit")
            return
        } else if (funcName == "Memory.arcIncrement") {
            val n: Any = this.stack.pop()
            Memory.arcIncrement(VmOps.addrOf(n))
            this.stack.push("Unit")
            return
        } else if (funcName == "Memory.arcDecrement") {
            val n: Any = this.stack.pop()
            Memory.arcDecrement(VmOps.addrOf(n))
            this.stack.push("Unit")
            return
        } else if (funcName == "Memory.atomicAdd") {
            val delta: Any = this.stack.pop()
            val n: Any = this.stack.pop()
            this.stack.push(Memory.atomicAdd(VmOps.addrOf(n),
                                             VmOps.addrOf(delta)))
            return
        } else if (funcName == "Memory.mprotect") {
            val prot: Any = this.stack.pop()
            val ln: Any = this.stack.pop()
            val n: Any = this.stack.pop()
            this.stack.push(Memory.mprotect(VmOps.addrOf(n),
                                            VmOps.addrOf(ln),
                                            VmOps.intOf(prot)))
            return
        } else if (funcName == "Memory.mmap") {
            // 2026-10-08 P1-3：JIT 原生验证链所需（JitBackend 分配 W^X 区）。
            // mmap(addr, length, prot, flags, fd, offset)。Photon 编译的
            // 原生 VM 下落到 runtime 的 Memory_mmap（NtAllocateVirtualMemory，
            // prot/flags 被硬编码为 PAGE_READWRITE|COMMIT|RESERVE，base 提示
            // 由 rcx 透传——JIT 区低地址提示因此仍然生效）。
            val off: Any = this.stack.pop()
            val fd: Any = this.stack.pop()
            val flg: Any = this.stack.pop()
            val prot: Any = this.stack.pop()
            val ln: Any = this.stack.pop()
            val n: Any = this.stack.pop()
            val r: Long = Memory.mmap(VmOps.addrOf(n), VmOps.addrOf(ln),
                                        VmOps.intOf(prot), VmOps.intOf(flg),
                                        VmOps.intOf(fd), VmOps.addrOf(off))
            this.stack.push(r)
            return
        } else if (funcName == "Memory.munmap") {
            val ln: Any = this.stack.pop()
            val n: Any = this.stack.pop()
            this.stack.push(Memory.munmap(VmOps.addrOf(n), VmOps.addrOf(ln)))
            return
        } else if (funcName == "Heap.init") {
            // P0-2b 堆初始化（runtime Heap_init）：原生 VM 宿主已在 main 里
            // 调过；字节码侧重复调用幂等。种子下不可达（JIT 路径仅在
            // AURA_JIT=1 的原生 VM 里激活）。
            Heap.init()
            this.stack.push("Unit")
            return
        } else if (funcName == "JitExec.callI64") {
            // JIT 间接调用原语（07 设计文档 §2）：entry(arg0) → rax。
            // 原生 VM 下落 runtime 的 JitExec_callI64 桩（call rax）。
            // ⚠️ 仅原生模式可达——种子 VM 下 JitBackend.vmMode 守卫先行。
            val arg0: Any = this.stack.pop()
            val entry: Any = this.stack.pop()
            // 桩内按 JIT 地址区间自识别参数序（见 JitBackend.executeNative 注）。
            this.stack.push(JitExec.callI64(VmOps.addrOf(entry),
                                            VmOps.addrOf(arg0)))
            return
        } else if (funcName == "JitExec.call0") {
            val entry: Any = this.stack.pop()
            this.stack.push(JitExec.call0(VmOps.addrOf(entry)))
            return
        } else if (funcName == "JitExec.allocRW") {
            // JIT W^X 区分配（单参原语；hint 重试在 runtime 桩内）。
            val size: Any = this.stack.pop()
            this.stack.push(JitExec.allocRW(VmOps.addrOf(size)))
            return
        } else if (funcName == "JitExec.protect") {
            // JIT 区页保护切换（VirtualProtect 直通）。
            val prot: Any = this.stack.pop()
            val size: Any = this.stack.pop()
            val addr: Any = this.stack.pop()
            this.stack.push(JitExec.protect(VmOps.addrOf(addr), VmOps.addrOf(size),
                                            VmOps.intOf(prot)))
            return
        } else if (funcName == "charCodeAt") {
            // 字符串原语族：种子 .auc 的裸名原生（自举 Stage-2 的编译器
            // 代码大量使用，2026-10-05 补齐）。⚠️ 越界返回 -1（与
            // VmOps/AucLoader 的防御语义一致）：编译器对残缺行存在
            // idx==len 的探测读，直接透传会在 AOT 载体下段错误
            //（实测 CEA-1 后崩，2026-10-05）。
            val idx: Any = this.stack.pop()
            val s: Any = this.stack.pop()
            val sv: String = toStr(s)
            val ii: Int = VmOps.intOf(idx)
            if (ii < 0 || ii >= sv.length) {
                this.stack.push(-1)
            } else {
                this.stack.push(sv.charCodeAt(ii))
            }
            return
        } else if (funcName == "strcat") {
            val b: Any = this.stack.pop()
            val a: Any = this.stack.pop()
            this.stack.push(toStr(a) + toStr(b))
            return
        } else if (funcName == "puts") {
            val s: Any = this.stack.pop()
            println(toStr(s))
            this.stack.push("Unit")
            return
        } else if (funcName == "String.fromCharCode" || funcName == "String_fromCharCode") {
            val c: Any = this.stack.pop()
            this.stack.push(String.fromCharCode(VmOps.intOf(c)))
            return
        } else if (funcName == "substring" || funcName == "String_substring"
            || funcName == "String.substring") {
            val end: Any = this.stack.pop()
            val start: Any = this.stack.pop()
            val s: Any = this.stack.pop()
            val sv: String = toStr(s)
            var st: Int = VmOps.intOf(start)
            var en: Int = VmOps.intOf(end)
            if (st < 0) { st = 0 }
            if (en > sv.length) { en = sv.length }
            if (st >= en) {
                this.stack.push("")
            } else {
                this.stack.push(sv.substring(st, en))
            }
            return
        } else if (funcName == "Process.exit" || funcName == "aura.lang.std.Process.exit") {
            val code: Any = this.stack.pop()
            this.exitCode = VmOps.intOf(code)
            this.running = false
            return
        } else if (funcName == "Process.env" || funcName == "aura.lang.std.Process.env") {
            val name: Any = this.stack.pop()
            this.stack.push(Env.get(toStr(name), ""))
            return
        }

        // ── Collections（补充） ──
        else if (funcName == "Collections.push" || funcName == "aura.lang.std.Collections.push") {
            val elem: Any = this.stack.pop()
            val list: Any = this.stack.pop()
            VmCollections.push(list, elem)
            this.stack.push("Unit")
            return
        } else if (funcName == "Collections.listOf" || funcName == "aura.lang.std.Collections.listOf") {
            // 与顶层 listOf 相同
            val list: Any = VmCollections.newList()
            val base: Int = this.stack.stackDepth() - argc
            var j: Int = 0
            while (j < argc) {
                VmCollections.push(list, this.stack.vmSlotAt(base + j))
                j = j + 1
            }
            var k: Int = 0
            while (k < argc) {
                this.stack.pop()
                k = k + 1
            }
            this.stack.push(list)
            return
        } else if (funcName == "Collections.mapOf" || funcName == "aura.lang.std.Collections.mapOf") {
            val map: Any = VmCollections.newMap()
            var i: Int = argc - 1
            while (i >= 0) {
                val val: Any = this.stack.pop()
                val key: Any = this.stack.pop()
                VmCollections.mapSet(map, key, val)
                i = i - 1
            }
            this.stack.push(map)
            return
        }

        // ── Time ──
        else if (funcName == "Time.now" || funcName == "aura.lang.std.Time.now"
            || funcName == "Time.sinceEpoch" || funcName == "aura.lang.std.Time.sinceEpoch") {
            // 不能写 `Time.getNowMs()`：std 的纯 Aura 函数不在本模块编译单元的
            // fn_index 里 → `未解析的函数调用 'Time.getNowMs'`。
            // 直接走原生时钟接口（与 std `ClockImpl.timeMs()` 同一条实现路径）。
            this.stack.push(this.clockNowMs())
            return
        }

        // ── Json ──
        else if (funcName == "Json.parse" || funcName == "aura.lang.std.Json.parse") {
            val text: Any = this.stack.pop()
            // 简化实现：返回原始字符串（完整 JSON 解析需要专用解析器）
            this.stack.push(toStr(text))
            return
        } else if (funcName == "Json.stringify" || funcName == "aura.lang.std.Json.stringify") {
            val v: Any = this.stack.pop()
            this.stack.push(VmOps.toStrAny(v))
            return
        }

        // ── Assert ──
        else if (funcName == "Assert.equal" || funcName == "aura.lang.std.Assert.equal") {
            val b: Any = this.stack.pop()
            val a: Any = this.stack.pop()
            if (VmOps.eq(a, b)) {
                this.stack.push("Unit")
            } else {
                this.error = "Assertion failed: " + VmOps.toStrAny(a) + " != " + VmOps.toStrAny(b)
                this.running = false
            }
            return
        }

        // [R175-撤] 裸名→导入表重定向曾加于此（importQualifiedOf），实测
        // 把所有 op60 用户函数调用全灭（JIT 18→3，幸存者恰为纯 native
        // 调用三例）——根因待查（疑似大函数内 indexOf/scan 错译族）。
        // 已撤：裸名 listOf/emptyList 族由 [R27] 前置臂扩展覆盖（语义等价）。

        // 用户函数：压栈返回地址，跳转到函数入口
        //
        // P391：**单槽目标缓存**——funcOffset/funcParamCount 各自对 funcTable
        // 做 O(表长) 纯字符扫描（P388），递归/循环调用（fib28 = 63 万次 CALL）
        // 每次重复扫两遍。按名记忆 (target, pc)，命中即零扫描；名字失配回退
        // 全解析并回填。递归/热点调用场景命中率 ~100%。
        var target: Int = 0
        var pc: Int = 0
        if (this.cfName == funcName) {
            target = this.cfTarget
            pc = this.cfPc
        } else {
            target = this.funcOffset(funcName)
            pc = this.funcParamCount(funcName)
            this.cfName = funcName
            this.cfTarget = target
            this.cfPc = pc
            this.cfIsUser = 1
        }
        // P0.8 加速派发钩子（可插拔，默认关闭）：直呼表命中时以表内入口
        // 覆盖函数表查找结果。本阶段不做任何加速，仅为 JIT/Photon 预留
        // 稳定对接点（VM-PA-00 §2.3 契约；接口见 enableAccelDispatch 等）。
        if (this.accelEnabled) {
            val accel: Int = this.accelTable.getOrDefault(funcName, -1)
            if (accel >= 0) {
                target = accel
            }
        }
        if (target == 0 && pc < 0) {
            this.error = "Unknown function: " + funcName
            this.running = false
            return
        }

        // 保存返回地址和当前帧（第 4 字段为调用者的闭包上下文，P1.3）
        this.callStack.push(this.ip, this.currentFrame, this.currentFunc, this.currentClosure)
        this.savedFramesAdd(this.locals)
        this.locals = this.popLocalsPool()
        // [R20] 调用点轨迹
        if (this.rtTraceCap > 0) {
            println("[CF] call=[" + funcName + "] argc=" + toStr(argc)
                + " target=" + toStr(target) + " pc=" + toStr(pc))
        }

        // 绑定参数到槽位（槽基址随调用约定不同，见 `aucArgBase`）
        var k: Int = pc - 1
        while (k >= 0 && k < argc) {
            this.locals.putSlot(k + this.aucArgBase, this.stack.pop())
            k = k - 1
        }

        this.currentFunc = funcName
        this.currentFrame = this.currentFrame + 1
        this.ip = target
    }

    /// 从函数返回。
        private fun returnFromFunc(): Unit {
        // [R20] 返回点轨迹：谁在返回、栈上有什么、返回什么
        if (this.rtTraceCap > 0) {
            this.rtTraceCap = this.rtTraceCap - 1
            println("[RT] fn=[" + this.currentFunc + "] sp=" + toStr(this.stack.stackDepth())
                + " ip=" + toStr(this.ip - 1)
                + " top=[" + VmOps.toStrAny(this.stack.peek()) + "]")
        }
        var retVal: Any = "Unit"
        if (this.stack.stackDepth() > 0) {
            retVal = this.stack.pop()
        }
        if (this.rtTraceCap > 0) {
            println("[RTV] retVal=[" + VmOps.toStrAny(retVal) + "]")
        }
        this.returnValue = retVal
        this.currentFunc = ""

        if (this.callStack.callDepth() == 0) {
            this.running = false
            return
        }

        val returnIp: Int = this.callStack.peekIp()
        val savedClosure: Int = this.callStack.peekClosure()
        if (this.rtTraceCap > 0) {
            println("[RT2] returnIp=" + toStr(returnIp) + " depth-after=" + toStr(this.callStack.callDepth() - 1))
        }
        this.callStack.pop()

        // 恢复局部变量与闭包上下文
        this.retireLocals(this.locals)
        this.locals = this.savedFramesPop()
        this.currentClosure = savedClosure
        this.currentFrame = this.currentFrame - 1

        // 把返回值压回调用者的栈
        this.stack.push(retVal)
        this.ip = returnIp
    }

    /// 尾调用（P1.6）：复用当前调用帧，不压 callStack / savedLocals。
    ///
    /// 语义：弹出实参绑定到新帧 → ip 跳转目标入口。当前帧的 callStack 条目
    /// （返回地址、保存的局部变量）原样保留，因此被调函数 RETURN 时直接
    /// 返回到**原调用者**——深层递归的调用深度恒为 O(1)。
    /// 实参绑定与 `callOrBuiltin` 的用户函数路径一致（含 aucArgBase 基址）。
        private fun callTail(funcName: String, argc: Int): Unit {
        var target: Int = this.funcOffset(funcName)
        if (this.accelEnabled) {
            val accel: Int = this.accelTable.getOrDefault(funcName, -1)
            if (accel >= 0) { target = accel }
        }
        if (target == 0 && this.funcParamCount(funcName) < 0) {
            this.error = "Unknown function: " + funcName
            this.running = false
            return
        }
        this.retireLocals(this.locals)
        this.locals = this.popLocalsPool()
        val pc: Int = this.funcParamCount(funcName)
        var k: Int = pc - 1
        while (k >= 0 && k < argc) {
            this.locals.putSlot(k + this.aucArgBase, this.stack.pop())
            k = k - 1
        }
        this.currentFunc = funcName
        this.ip = target
    }

    /// [R20] 压入调用者帧（List 直操，见 savedLocals 字段注释）。
        private fun savedFramesAdd(v: VmLocals): Unit {
        this.savedLocals.add(v)
    }

    /// [R20] 弹出最后一个保存的局部变量块（size 驱动 + 尾下标，同池模式）。
        private fun savedFramesPop(): VmLocals {
        val n: Int = this.savedLocals.size()
        if (n <= 0) {
            return VmLocals()
        }
        val v: VmLocals = this.savedLocals[n - 1]
        this.savedLocals.removeAt(n - 1)
        return v
    }

    /// 从池中取一个（已重置的）locals；池空则新建。
        private fun popLocalsPool(): VmLocals {
        val n: Int = this.localsPool.size()
        if (n > 0) {
            val v: VmLocals = this.localsPool[n - 1]
            this.localsPool.removeAt(n - 1)
            return v
        }
        return VmLocals()
    }

    /// 退役帧 locals：代际重置后归还池（容量保留，热身后零分配）。
        private fun retireLocals(m: VmLocals): Unit {
        m.reset()
        this.localsPool.add(m)
    }

    /// 弹出 argc 个实参并按源顺序拼接为字符串。
    ///
    /// 转换统一走 `VmOps.toStrAny`（见其注释：直接在本类方法里对「刚从容器
    /// 取回的值」调用 `toStr` 在自举 AOT 下会得到错误结果）。
        private fun collectArgs(argc: Int): String {
        if (argc <= 0) {
            return ""
        }
        var result: String = ""
        var i: Int = argc - 1
        while (i >= 0) {
            val v: Any = this.stack.pop()
            val s: String = VmOps.toStrAny(v)
            // P404：[CA] 值类型诊断探针摘除（P379 追踪用）。
            if (result == "") {
                result = s
            } else {
                result = s + " " + result
            }
            i = i - 1
        }
        return result
    }

    // ═══════════════════════════════════════════════════════════
    //  对象与类
    // ═══════════════════════════════════════════════════════════

    /// 分配对象（在堆上分配内存，返回 Long 指针）。
    ///
    /// P0.5（ADR-003）：对象头 16 字节——`offset 0` 类标识（预留 vtable/类表
    /// 扩展位，0 = 通用对象）、`offset 8` 引用计数 = 1（与 ARC 指令布局一致）。
    /// 类名登记进 `objectClass`，供 `CALL_METHOD` 虚方法解析与类型查询使用；
    /// 字段值存 `objectFields`（按实例隔离），不写裸内存（装箱 Any 无法安全
    /// round-trip，见 ADR-003 偏差记录）。
        private fun newObject(className: String): Unit {
        val objSize: Long = 16
        val ptr: Long = Memory.alloc(objSize)
        Memory.write64(ptr, 0)          // 类型标签（0 = 通用对象；类表接入 P1.2 后写类 id）
        Memory.write32(ptr + 8, 1)      // 引用计数 = 1
        this.stack.push(ptr)
        // 类名键取栈值的 toStrAny 形态——与 get/set/方法解析同一转换路径；
        // 不得对 Long 局部变量做 toStr（装箱路径不一致会导致键不匹配）。
        val objKey: String = VmOps.ptrKeyOf(this.stack.peek())
        // [R33] 线性登记
        this.ocKeys.add(objKey)
        this.ocVals.add(className)
        this.heapKindKeys.add(objKey)
        this.heapKindVals.add("object")
        // [R33] 旧 heapKinds(HashMap).put 调用窗骰跳过——线性登记已完成
    }

    /// 读取对象字段（含字符串/集合的**内建成员**）。
    ///
    /// 内建成员对应 Rust VM 的 `builtin_member`：`s.length` / `xs.size` /
    /// `xs.isEmpty` / `xs.first` / `xs.last`。加载器已把 `GET_FIELD` 的哈希操作数
    /// 翻译成这些名字（见 `AucLoaderUtils.fieldNameOf`）。
        private fun getField(fieldName: String): Unit {
        val obj: Any = this.stack.pop()
        if (fieldName == "length" || fieldName == "size" || fieldName == "count") {
            // [R19] 路由至 strLenRaw(toStrAny(obj))——两个已证可靠原语的组合。
            // 旧径 strlen(obj)（prelu 全局 → text.length）的调用窗在宿主布局
            // 下实参腐坏：[X] 轨迹实锤栈顶为 "Hello" 而 strlen 返回 2（R10
            // 调用窗实参漂移同族）。[GF] 对照实验（raw=5 strlen=5 同轮复核）
            // 后定案，探针已拆。
            // [R34] 容器分派：list/map 接收者走 Collections.length（strLenRaw
            // 对列表头 = 读 len 字段字节，实测 m[i].size 全灭为 1）
            val keyF: String = VmOps.ptrKeyOf(obj)
            val knF: Int = this.heapKindKeys.size()
            var kindF: String = ""
            var kiF: Int = 0
            while (kiF < knF) {
                if (VmOps.toI32(this.heapKindKeys[kiF]) == VmOps.toI32(keyF)) {
                    kindF = this.heapKindVals[kiF]
                    kiF = knF
                }
                kiF = kiF + 1
            }
            if (kindF == "list" || kindF == "map") {
                this.stack.push(VmCollections.length(obj))
            } else {
                this.stack.push(toAny(VmOps.strLenRaw(VmOps.toStrAny(obj))))
            }
            return
        }
        if (fieldName == "isEmpty") {
            val keyE: String = VmOps.ptrKeyOf(obj)
            val knE: Int = this.heapKindKeys.size()
            var kindE: String = ""
            var kiE: Int = 0
            while (kiE < knE) {
                if (VmOps.toI32(this.heapKindKeys[kiE]) == VmOps.toI32(keyE)) {
                    kindE = this.heapKindVals[kiE]
                    kiE = knE
                }
                kiE = kiE + 1
            }
            if (kindE == "list" || kindE == "map") {
                val nE2: Any = VmCollections.length(obj)
                this.stack.push(VmOps.toI32(VmOps.toStrAny(nE2)) == 0)
                return
            }
            if (VmOps.strLenRaw(VmOps.toStrAny(obj)) == 0) {
                this.stack.push(true)
            } else {
                this.stack.push(false)
            }
            return
        }
        if (fieldName == "first" || fieldName == "last") {
            val n: Int = VmCollections.length(obj)
            if (n <= 0) {
                this.stack.push(null)
                return
            }
            var idx: Int = 0
            if (fieldName == "last") {
                idx = n - 1
            }
            this.stack.push(VmCollections.vmListAt(obj, idx))
            return
        }
        // P0.5（ADR-003）：字段按**实例**存储（键 "<objPtr>|<name>"），
        // 不再写入全局表——两个实例的同名字段互不可见。
        // 键统一取自栈值（Any）的 toStrAny 形态（转换路径与 newObject 一致）。
        // 注意：堆指针的装箱类型名随宿主不同可能是 "Int" 或 "Long"（实测
        // seed 宿主为 "Int"），故此处接受全部整型，非整型值非对象。
        if (!VmOps.isNumeric(obj)) {
            this.stack.push(toAny(0))
            return
        }
        val objKey: String = VmOps.toStrAny(obj)
        if (VmOps.toI64(objKey) == 0L) {
            // 空指针 / 非对象值：保持旧的容错语义（读缺失字段得 0）
            this.stack.push(toAny(0))
            return
        }
        // [R33] 扁平线性读（键 objKey|fieldName）
        val fkey: String = objKey + "|" + fieldName
        val fn: Int = this.ofKeys.size()
        var found: Any = null
        var fi: Int = 0
        while (fi < fn) {
            if (this.ofKeys[fi] == fkey) {
                found = this.ofVals[fi]
                fi = fn
            }
            fi = fi + 1
        }
        this.stack.push(if (found == null) 0 else found)
    }

    /// 设置对象字段。
    ///
    /// P0.5（ADR-003）：字段按**实例**存储（键 "<objPtr>|<name>"）。
    /// 栈序：value 在顶、objPtr 在其下。
        private fun setField(fieldName: String): Unit {
        val val: Any = this.stack.pop()
        val obj: Any = this.stack.pop()
        // 指针装箱类型名随宿主可能是 "Int"/"Long"（见 getField 注释），接受整型
        if (!VmOps.isNumeric(obj)) {
            // 无接收者可写（遗留容错）：丢弃，行为与旧桩一致
            return
        }
        val objKey: String = VmOps.toStrAny(obj)
        if (VmOps.toI64(objKey) == 0L) {
            return
        }
        // [R33] 扁平线性写（存在则覆写，否则追加）
        val fkey2: String = objKey + "|" + fieldName
        val fn2: Int = this.ofKeys.size()
        var fi2: Int = 0
        var wrote2: Int = 0
        while (fi2 < fn2) {
            if (this.ofKeys[fi2] == fkey2) {
                this.ofVals[fi2] = val
                wrote2 = 1
                fi2 = fn2
            }
            fi2 = fi2 + 1
        }
        if (wrote2 == 0) {
            this.ofKeys.add(fkey2)
            this.ofVals.add(val)
        }
    }

    /// 分配数组（在堆上）。
    ///
    /// 采用与 `Collections` 列表**相同的布局**（`len@0` / `cap@8` / `items@16`，
    /// 元素在独立数组里），这样 `GET_INDEX`/`SET_INDEX` 对数组与列表语义一致 ——
    /// `.auc` 的 `xs[0]`（`List<Int>`）走的就是 `GET_INDEX`（实测 Rust VM 输出
    /// `x0=1`），若数组另用「元素内联」布局，同一个操作码无法兼顾，且列表会被
    /// 当成数组读 → 读到 items 指针当元素（实测访问违规崩溃）。
    /// 当前 Unix 时间戳（毫秒），基于 `Clock.clockGettime(CLOCK_REALTIME)`。
    ///
    /// 缓冲区惰性分配后复用（每次取时间都 malloc 会在长循环里持续泄漏）；
    /// 读取失败（返回值非 0）时返回 0，与 VM 其余原语的容错风格一致。
        private fun clockNowMs(): Long {
        if (this.clockBuf == 0L) {
            this.clockBuf = Memory.alloc(16L)
        }
        if (this.clockBuf == 0L) { return 0L }
        val rc: Long = Clock.clockGettime(0, this.clockBuf)
        if (rc != 0L) { return 0L }
        val sec: Long = Memory.read64(this.clockBuf)
        val nsec: Long = Memory.read64(this.clockBuf + 8L)
        return sec * 1000L + nsec / 1000000L
    }

    private fun newArray(size: Any): Unit {
        val count: Int = VmOps.intOf(size)
        val ptr: Long = Memory.alloc(24)
        // Int → Long 用 `as Long`（`.toLong()` 重名无法解析）
        val itemsBytes: Long = (count * 8) as Long
        val countL: Long = count as Long
        val items: Long = Memory.alloc(itemsBytes)
        Memory.write64(ptr, countL)
        Memory.write64(ptr + 8, countL)
        Memory.write64(ptr + 16, items)
        // 初始化为 0
        Memory.set(items, 0, itemsBytes)
        this.stack.push(ptr)
        // [R34] kind 登记（.size/.length 的 GET_FIELD 容器分派依赖）
        this.heapKindKeys.add(VmOps.ptrKeyOf(this.stack.peek()))
        this.heapKindVals.add("list")
    }

    /// 数组/列表元素读取（`Collections` 布局：元素在 `read64(ptr+16)` 指向的数组中）。
        private fun getIndex(): Unit {
        val idx: Any = this.stack.pop()
        val objAny: Any = this.stack.pop()
        this.stack.push(VmCollections.vmListAt(objAny, idx))
    }

    /// 数组元素写入。
        private fun setIndex(): Unit {
        // 栈序（见 Rust `OpCode::SetIndex` 注释）：栈顶为索引、其下为引用、再下为值
        val idx: Any = this.stack.pop()
        val objAny: Any = this.stack.pop()
        val v: Any = this.stack.pop()
        VmCollections.vmListSet(objAny, idx, v)
    }

    /// 声明类继承关系（P1.2，ADR-003 扩展）。
    ///
    /// `DEF_CLASS cls parent` 指令与 `registerClass` API 共用；
    /// parent 为 "" 或 "-" 表示无父类。
        private fun defClass(cls: String, parent: String): Unit {
        var p: String = parent
        if (p == "-") { p = "" }
        // [R33] 线性登记（覆盖式）
        var pi2: Int = 0
        val pn2: Int = this.cpKeys.size()
        var had2: Int = 0
        while (pi2 < pn2) {
            if (this.cpKeys[pi2] == cls) {
                this.cpVals[pi2] = p
                had2 = 1
                pi2 = pn2
            }
            pi2 = pi2 + 1
        }
        if (had2 == 0) {
            this.cpKeys.add(cls)
            this.cpVals.add(p)
        }
    }

    /// 沿父类链解析方法（P1.2）：返回 "类名.方法名"，链上无命中返回 ""。
        private fun resolveMethodInChain(cls: String, methodName: String): String {
        var cur: String = cls
        var depth: Int = 0
        while (cur != "" && depth < 64) {
            val candidate: String = cur + "." + methodName
            if (this.funcParamCount(candidate) >= 0 || this.funcOffset(candidate) != 0) {
                return candidate
            }
            // [R33] 线性读
            var cn6: Int = this.cpKeys.size()
            var ci6: Int = 0
            while (ci6 < cn6) {
                if (this.cpKeys[ci6] == cur) {
                    cur = this.cpVals[ci6]
                    ci6 = cn6
                }
                ci6 = ci6 + 1
            }
            depth = depth + 1
        }
        return ""
    }

    /// 类名 cls 是否为 target 自身或其祖先链上的类型（P1.2，instanceOf/checkCast 用）。
        private fun classIsA(cls: String, target: String): Boolean {
        if (cls == "") { return false }
        var cur: String = cls
        var depth: Int = 0
        while (cur != "" && depth < 64) {
            if (cur == target) { return true }
            cur = this.classParents.getOrDefault(cur, "")
            depth = depth + 1
        }
        return false
    }

    /// 对象值是否为注册的堆对象（P1.2/P1.5 共用），是则返回其类名。
        private fun heapObjectClass(v: Any): String {
        if (v == null) { return "" }
        val key: String = VmOps.toStrAny(v)
        if (this.heapKinds.getOrDefault(key, "") != "object") { return "" }
        // [R33] 线性读
        val cn2: Int = this.ocKeys.size()
        var ci2: Int = 0
        while (ci2 < cn2) {
            if (this.ocKeys[ci2] == key) {
                return this.ocVals[ci2]
            }
            ci2 = ci2 + 1
        }
        return ""
    }
    ///
    /// depth = 接收者之下压着的实参个数（0 = 接收者在栈顶）。
        private fun receiverClassAt(depth: Int): String {
        if (depth < 0) { return "" }
        val idx: Int = this.stack.stackDepth() - 1 - depth
        if (idx < 0) { return "" }
        val v: Any = this.stack.vmSlotAt(idx)
        if (v == null) { return "" }
        // 仅整型堆指针可能是 VM 对象（装箱类型名随宿主为 "Int"/"Long"，
        // 见 getField 注释）；字符串/布尔等直接排除
        if (!VmOps.isNumeric(v)) { return "" }
        // [R33] 线性读
        val key3: String = VmOps.toStrAny(v)
        val cn3: Int = this.ocKeys.size()
        var ci3: Int = 0
        while (ci3 < cn3) {
            if (this.ocKeys[ci3] == key3) {
                return this.ocVals[ci3]
            }
            ci3 = ci3 + 1
        }
        return ""
    }

    /// 虚方法调用（P0.5，ADR-003）。
    ///
    /// 方法函数以 `"类名.方法名"` 注册、**首参为接收者 self**。
    /// `CALL_METHOD name [argc]`：argc 可选（除 self 外的实参个数；
    /// 省略时按无参方法处理，接收者 = 栈顶）。解析失败退让旧路径
    /// `callOrBuiltin(name, 0)`，兼容遗留字节码。
        private fun callMethod(methodName: String): Unit {
        if (this.aucMode) {
            // `.auc` 布局（Rust emit.rs CallMethod）：[self, args..., receiverCopy]，
            // 栈顶是接收者**副本**，仅用于虚分派（Rust VM 同样丢弃该副本）。
            // 绑定：丢弃副本后按目标函数形参个数（含 self）整体绑定。
            val cls0: String = this.receiverClassAt(0)
            var resolved: String = methodName
            if (cls0 != "") {
                val chainHit: String = this.resolveMethodInChain(cls0, methodName)
                if (chainHit != "") { resolved = chainHit }
            }
            if (this.stack.stackDepth() > 0) {
                this.stack.pop()  // 丢弃接收者副本
            }
            val pc: Int = this.funcParamCount(resolved)
            if (pc < 0) {
                this.error = "Unknown method: " + resolved
                this.running = false
                return
            }
            this.callOrBuiltin(resolved, pc)
            return
        }
        var argc: Int = -1
        if (this.argCountOf() >= 2) {
            argc = VmOps.toI32(this.argStrOf(1))
        }
        val receiverDepth: Int = if (argc >= 0) argc else 0
        val cls: String = this.receiverClassAt(receiverDepth)
        if (cls != "") {
            // P1.2：沿父类链解析方法（子类覆写优先，未覆写则命中父类实现）
            val resolved: String = this.resolveMethodInChain(cls, methodName)
            if (resolved != "") {
                var callArgc: Int = 1
                if (argc >= 0) {
                    callArgc = argc + 1
                } else {
                    val pc: Int = this.funcParamCount(resolved)
                    if (pc >= 0) { callArgc = pc }
                }
                this.callOrBuiltin(resolved, callArgc)
                return
            }
        }
        // 退让：遗留行为（忽略接收者，按全局函数名调用）
        this.callOrBuiltin(methodName, 0)
    }

    /// 构造器调用（P0.5，ADR-003）。
    ///
    /// `CALL_CTOR name [argc]`：对象已由 `NEW_OBJECT` 分配（接收者在栈上、
    /// 实参之下），构造器函数以 `"类名.ctor"`（或 `"类名." + name`）注册，
    /// self 为首参。解析失败退让旧路径。
        private fun callCtor(ctorName: String): Unit {
        var argc: Int = 0
        if (this.argCountOf() >= 2) {
            argc = VmOps.toI32(this.argStrOf(1))
        }
        val cls: String = this.receiverClassAt(argc)
        if (cls != "") {
            var resolved: String = cls + "." + ctorName
            if (this.funcParamCount(resolved) < 0 && this.funcOffset(resolved) == 0 && ctorName == cls) {
                resolved = cls + ".new"
            }
            if (this.funcParamCount(resolved) >= 0 || this.funcOffset(resolved) != 0) {
                this.callOrBuiltin(resolved, argc + 1)
                return
            }
        }
        // 退让：遗留行为
        this.callOrBuiltin(ctorName, 0)
    }

    // ═══════════════════════════════════════════════════════════
    //  闭包
    // ═══════════════════════════════════════════════════════════

    /// 加载闭包（遗留文本格式：`LOAD_CLOSURE "funcName|varNames"`）。
    ///
    /// varNames 在文本模式下无 name→slot 映射可解析，按 0 捕获处理；
    /// 捕获语义由 `MAKE_CLOSURE name nCaptures`（弹栈捕获）承担。
        private fun loadClosure(closureData: String): Unit {
        val parts: List<String> = VmOps.split(closureData, "|")
        if (parts.size >= 1) {
            this.makeClosure(parts[0], parts)
        }
    }

    /// 创建闭包（P1.3）。
    ///
    /// `MAKE_CLOSURE funcName [nCaptures]`：带 nCaptures 时从栈顶弹出
    /// nCaptures 个值作为捕获（按压入顺序存为 upvalue 0..n-1）；
    /// 无第二个操作数时为 0 捕获（遗留 .auc 路径兼容）。
    /// 压入 closureId（Int），`CALL_CLOSURE` 按其调用。
        private fun makeClosure(funcName: String): Unit {
        var n: Int = 0
        if (this.argCountOf() >= 2) {
            n = VmOps.toI32(this.argStrOf(1))
        }
        val caps: List<Any> = arrayListOf<Any>()
        if (n > 0) {
            // 栈顶在下，弹出顺序与压入相反：先收进临时表再反转
            val tmp: List<Any> = arrayListOf<Any>()
            var i: Int = 0
            while (i < n) {
                tmp.add(this.stack.pop())
                i = i + 1
            }
            var j: Int = n - 1
            while (j >= 0) {
                caps.add(tmp[j])
                j = j - 1
            }
        }
        val closureId: Int = this.nextClosureId
        this.nextClosureId = this.nextClosureId + 1
        this.closureTable.put(closureId, funcName)
        this.closureCaptures.put(closureId, caps)
        this.upvalueTotal = this.upvalueTotal + n
        this.stack.push(closureId)
    }

    /// 调用闭包（P1.3）。
    ///
    /// `CALL_CLOSURE [argc]`：栈序 closureId 在下、argc 个实参在其上
    /// （与 CALL 一致）。argc 省略时按目标函数参数个数推导（兼容旧路径
    /// 的无参调用）。调用期间 currentClosure 指向该闭包，函数体内的
    /// LOAD_UPVALUE/STORE_UPVALUE 按此寻址。
        private fun callClosureAt(): Unit {
        var argc: Int = 0
        if (this.argCountOf() >= 1) {
            argc = VmOps.toI32(this.argStrOf(0))
        }
        if (this.stack.stackDepth() < argc + 1) {
            this.error = "CALL_CLOSURE: stack underflow"
            this.running = false
            return
        }
        // 先摘出实参再取 closureId，然后按原顺序压回实参
        val argVals: List<Any> = arrayListOf<Any>()
        var i: Int = 0
        while (i < argc) {
            argVals.add(this.stack.pop())
            i = i + 1
        }
        val closureIdAny: Any = this.stack.pop()
        val cid: Int = VmOps.intOf(closureIdAny)
        val funcName: String = this.closureTable.getOrDefault(cid, "")
        if (funcName == "") {
            this.error = "Invalid closure id: " + toStr(cid)
            this.running = false
            return
        }
        if (argc > 0) {
            var j: Int = argc - 1
            while (j >= 0) {
                this.stack.push(argVals[j])
                j = j - 1
            }
        }
        this.currentClosure = cid
        this.callOrBuiltin(funcName, argc)
    }

    /// 读取当前闭包的第 idx 个 upvalue（P1.3）。
        private fun loadUpvalue(idx: Int): Unit {
        if (this.currentClosure < 0) {
            this.error = "LOAD_UPVALUE: no closure context"
            this.running = false
            return
        }
        val caps: List<Any> = this.closureCaptures.getOrDefault(this.currentClosure, arrayListOf<Any>())
        if (idx < 0 || idx >= caps.size()) {
            this.error = "LOAD_UPVALUE: index " + toStr(idx) + " out of range"
            this.running = false
            return
        }
        this.stack.push(caps[idx])
    }

    /// 原位改写当前闭包的第 idx 个 upvalue（P1.3，闭包间共享可变状态）。
        private fun storeUpvalue(idx: Int): Unit {
        if (this.currentClosure < 0) {
            this.error = "STORE_UPVALUE: no closure context"
            this.running = false
            return
        }
        val caps: List<Any> = this.closureCaptures.getOrDefault(this.currentClosure, arrayListOf<Any>())
        if (idx < 0 || idx >= caps.size()) {
            this.error = "STORE_UPVALUE: index " + toStr(idx) + " out of range"
            this.running = false
            return
        }
        val v: Any = this.stack.pop()
        caps[idx] = v
    }

    // ═══════════════════════════════════════════════════════════
    //  类型检查
    // ═══════════════════════════════════════════════════════════

    // ═══════════════════════════════════════════════════════════
    //  类型检查（P1.2：对象值沿类继承链判定）
    // ═══════════════════════════════════════════════════════════
        private fun instanceOf(typeName: String): Unit {
        val v: Any = this.stack.pop()
        // 对象值：沿类继承链匹配（is-a 语义）
        val objCls: String = this.heapObjectClass(v)
        if (objCls != "") {
            this.stack.push(this.classIsA(objCls, typeName))
            return
        }
        this.stack.push(VmOps.typeName(v) == typeName)
    }

    private fun checkCast(typeName: String): Unit {
        val v: Any = this.stack.pop()
        if (v == null) {
            this.stack.push(v)
            return
        }
        val objCls: String = this.heapObjectClass(v)
        var ok: Boolean = false
        if (objCls != "") {
            ok = this.classIsA(objCls, typeName)
        } else {
            ok = VmOps.typeName(v) == typeName
        }
        if (ok) {
            this.stack.push(v)
        } else {
            this.error = "CheckCast failed: " + VmOps.typeName(v) + " is not " + typeName
            this.running = false
        }
    }

    private fun cast(typeName: String): Unit {
        // 运行时类型转换（简化：直接压回原值）
        val v: Any = this.stack.pop()
        this.stack.push(v)
    }

    private fun checkType(typeName: String): Unit {
        val v: Any = this.stack.pop()
        this.stack.push(VmOps.typeName(v) == typeName)
    }

    // ═══════════════════════════════════════════════════════════
    //  ARC 生命周期
    // ═══════════════════════════════════════════════════════════

    // ARC 生命周期：基于堆对象头引用计数（offset 8 = u32 refcount）。
    //
    // 安全前提：编译器**仅**对引用类型（对象/集合/闭包）发射 ARC 指令。
    // 但 VM 仍做**防御性类型检查**——若栈顶不是 Long 指针，直接透传
    // （`typeName` 区分 Int/String/Float/Boolean 等装箱值）。
    //
    // 对象布局（与 `newObject` / `boxAlloc` 一致）：
    //   offset 0..7   : 类型标签 / 值载荷 (u64)
    //   offset 8..11  : 引用计数 (u32)
    //   offset 12..15 : 保留

    // ═══════════════════════════════════════════════════════════
    //  堆分配注册表（P1.5）
    // ═══════════════════════════════════════════════════════════

    /// 登记一个堆分配（栈顶值即句柄；键取 toStrAny 形态）。
        private fun registerHeapTop(kind: String): Unit {
        this.heapKinds.put(VmOps.toStrAny(this.stack.peek()), kind)
    }

    /// 释放注册过的堆块（按 kind 释放其内层数组并摘除登记/侧表）。
    ///
    /// 容器（list/map/array）布局与 `aura.lang.collection.Collections` 兼容、
    /// 头部无引用计数字段，采用「丢弃即释放」语义；别名容器重复 DEC_REF
    /// 会双重释放 —— 已知限制，等价 Rust VM 的即时回收行为（heap.rs）。
        private fun freeRegistered(ptrKey: String, kind: String): Unit {
        val ptr: Long = VmOps.toI64(ptrKey)
        if (ptr == 0L) { return }
        if (kind == "list") {
            val items: Long = Memory.read64(ptr + 16)
            if (items != 0L) { Memory.free(items) }
            Memory.free(ptr)
        } else if (kind == "map") {
            val keys: Long = Memory.read64(ptr + 16)
            val vals: Long = Memory.read64(ptr + 24)
            if (keys != 0L) { Memory.free(keys) }
            if (vals != 0L) { Memory.free(vals) }
            Memory.free(ptr)
        } else if (kind == "array") {
            val items: Long = Memory.read64(ptr + 16)
            if (items != 0L) { Memory.free(items) }
            Memory.free(ptr)
        } else {
            // object / box / mutex / atomic / channel / rwlock / condvar：单块内存
            Memory.free(ptr)
        }
        this.heapKinds.remove(ptrKey)
        if (kind == "object") {
            this.objectFields.remove(ptrKey)
            this.objectClass.remove(ptrKey)
        } else if (kind == "box") {
            this.boxValues.remove(ptrKey)
        }
    }

    /// 活跃堆对象计数（P1.5 泄漏检测：长循环创建/销毁后应归零）。
        fun getActiveHeapObjects(): Int {
        return this.heapKinds.getSize()
    }

    /// 当前调用深度（主帧为 1）。
        fun getCallDepth(): Int {
        return this.callStack.callDepth() + 1
    }

    /// 递增引用计数。
    ///
    /// 仅对带引用计数头的堆块生效（object/box，rc 位于 offset 8）；
    /// 其余注册类型（容器/资源）无 rc 字段，为 no-op。
        private fun incRef(): Unit {
        val v: Any = this.stack.pop()
        if (v == null || !VmOps.isNumeric(v)) {
            this.stack.push(v)
            return
        }
        // Plan A 装箱整数绝不可能是注册堆对象，直接透传（免 toStrAny 键分配）。
        if (VmOps.isTaggedInt(v)) {
            this.stack.push(v)
            return
        }
        val key: String = VmOps.toStrAny(v)
        val kind: String = this.heapKinds.getOrDefault(key, "")
        if (kind == "object" || kind == "box") {
            val ptr: Long = VmOps.toI64(key)
            if (ptr > 0) {
                val rc: Int = Memory.read32(ptr + 8)
                if (rc > 0) {
                    Memory.write32(ptr + 8, rc + 1)
                }
            }
        }
        this.stack.push(v)
    }

    /// 递减引用计数，归零时按类型释放堆内存（P1.5）。
        private fun decRef(): Unit {
        val v: Any = this.stack.pop()
        if (v == null || !VmOps.isNumeric(v)) {
            this.stack.push(null)
            return
        }
        // 同 incRef：装箱整数透传，零分配。
        if (VmOps.isTaggedInt(v)) {
            this.stack.push(v)
            return
        }
        val key: String = VmOps.toStrAny(v)
        val kind: String = this.heapKinds.getOrDefault(key, "")
        if (kind == "") {
            // 未注册值（整数/字符串/裸指针外值）：透传
            this.stack.push(v)
            return
        }
        if (kind == "object" || kind == "box") {
            val ptr: Long = VmOps.toI64(key)
            val rc: Int = Memory.read32(ptr + 8)
            val newRc: Int = rc - 1
            if (newRc <= 0) {
                this.freeRegistered(key, kind)
                this.stack.push(null)
            } else {
                Memory.write32(ptr + 8, newRc)
                this.stack.push(v)
            }
        } else {
            // 容器/资源：丢弃即释放
            this.freeRegistered(key, kind)
            this.stack.push(null)
        }
    }

    /// 保留（RETAIN，op 112）——**消费**栈顶，不回推。
    ///
    /// [R19·语义判决] 种子 interp.rs（.auc 的唯一生产者 + 语义基准）：
    /// `Instr::Retain => stack.pop()` —— 2026-10-02 修复确认消费约定
    /// （发射端模式 `LoadVar(src); RETAIN`，push 后由本指令消费，两两抵消）。
    /// 旧实现「弹出不回推」与「回推」都错——**回推一次**（R17）在堆指针
    /// 值上净增 1 槽（旧版 7GB 泄漏的回魂），**回推两次**（R17 编辑残留，
    /// 2869+2887 双 push）每次 RETAIN 泄 2 槽。唯一正确语义 = 消费。
    /// [X] 轨迹实证：GET_FIELD 的操作数来自其**前一条** LOAD_LOCAL（ip29→30），
    /// 与 RETAIN 无关——「RETAIN 喂 GET_FIELD」的前提不成立。
        private fun retain(): Unit {
        val v: Any = this.stack.pop()
        if (v == null || !VmOps.isNumeric(v)) {
            return
        }
        if (VmOps.isTaggedInt(v)) {
            return
        }
        val key: String = VmOps.toStrAny(v)
        val kind: String = this.heapKinds.getOrDefault(key, "")
        if (kind == "object" || kind == "box") {
            val ptr: Long = VmOps.toI64(key)
            if (ptr > 0) {
                val rc: Int = Memory.read32(ptr + 8)
                if (rc > 0) {
                    Memory.write32(ptr + 8, rc + 1)
                }
            }
        }
    }

    /// 释放（RELEASE，op 113）——**消费**栈顶，不回压（同 retain 的栈约定）。
        private fun release(): Unit {
        val v: Any = this.stack.pop()
        if (v == null || !VmOps.isNumeric(v)) {
            return
        }
        if (VmOps.isTaggedInt(v)) {
            return
        }
        val key: String = VmOps.toStrAny(v)
        val kind: String = this.heapKinds.getOrDefault(key, "")
        if (kind == "object" || kind == "box") {
            val ptr: Long = VmOps.toI64(key)
            val rc: Int = Memory.read32(ptr + 8)
            val newRc: Int = rc - 1
            if (newRc <= 0) {
                this.freeRegistered(key, kind)
            } else {
                Memory.write32(ptr + 8, newRc)
            }
        } else if (kind != "") {
            // 容器/资源：丢弃即释放（与 decRef 的同款约定）
            this.freeRegistered(key, kind)
        }
    }

    /// 丢弃引用：弹出并按注册类型回收（P1.5）。
        private fun dropRef(): Unit {
        val v: Any = this.stack.pop()
        if (v == null || !VmOps.isNumeric(v)) {
            return
        }
        // 同 incRef：装箱整数透传，零分配。
        if (VmOps.isTaggedInt(v)) {
            return
        }
        val key: String = VmOps.toStrAny(v)
        val kind: String = this.heapKinds.getOrDefault(key, "")
        if (kind == "") {
            return
        }
        if (kind == "object" || kind == "box") {
            val ptr: Long = VmOps.toI64(key)
            val rc: Int = Memory.read32(ptr + 8)
            if (rc > 0) {
                val newRc: Int = rc - 1
                if (newRc <= 0) {
                    this.freeRegistered(key, kind)
                } else {
                    Memory.write32(ptr + 8, newRc)
                }
            }
        } else {
            this.freeRegistered(key, kind)
        }
    }

    /// 创建弱引用（不增加引用计数，返回原指针值）。
        private fun weakRef(): Unit {
        val v: Any = this.stack.pop()
        this.stack.push(v)
    }

    /// 弱引用升级（P1.5 真弱引用）：仅当对象仍在堆注册表中存活时升级成功
    /// （object/box 引用计数 +1 并返回原值）；已释放的块已被摘除登记，
    /// 一律返回 null——不再有「读已释放内存的 rc」的未定义行为。
        private fun weakGet(): Unit {
        val v: Any = this.stack.pop()
        if (v == null || !VmOps.isNumeric(v)) {
            this.stack.push(v)
            return
        }
        val key: String = VmOps.toStrAny(v)
        val kind: String = this.heapKinds.getOrDefault(key, "")
        if (kind == "object" || kind == "box") {
            val ptr: Long = VmOps.toI64(key)
            val rc: Int = Memory.read32(ptr + 8)
            if (rc > 0) {
                Memory.write32(ptr + 8, rc + 1)
                this.stack.push(v)
                return
            }
        }
        this.stack.push(null)
    }

    /// 装箱分配（P1.1 类型感知；24 字节头：tag@0 / rc@8 / value@16）。
    ///
    /// 数值装箱值直接写 value 槽；非数值（字符串等句柄值）写裸内存会截断，
    /// 存入 `boxValues` 侧表（键 = objPtr 的 toStrAny 形态）。
        private fun boxAlloc(): Unit {
        val v: Any = this.stack.pop()
        val ptr: Long = Memory.alloc(24)
        Memory.write32(ptr + 8, 1)  // 初始引用计数 = 1
        if (v == null) {
            Memory.write64(ptr, 0)          // tag 0 = Null
            Memory.write64(ptr + 16, 0)
        } else if (VmOps.typeName(v) == "Int" || VmOps.typeName(v) == "Long") {
            Memory.write64(ptr, 1)          // tag 1 = 整数
            Memory.write64(ptr + 16, VmOps.toI64(VmOps.toStrAny(v)))
        } else {
            Memory.write64(ptr, 3)          // tag 3 = 托管侧表值（字符串/对象句柄等）
            this.boxValues.put(VmOps.toStrAny(ptr), v)
        }
        this.stack.push(ptr)
        this.heapKinds.put(VmOps.toStrAny(this.stack.peek()), "box")
    }

    // ═══════════════════════════════════════════════════════════
    //  协程（D5：已废弃，2026-10-01）
    //
    //  原 Yield/NewCoroutine/ResumeCoroutine 桩实现已随 P0.4 分派器重构
    //  移除（ADR-001：协程指令不进入指令集；并发模型仅保留 Actor，P3.3）。
    //  suspend()/resume() 仅保留为挂起/恢复执行的公共接口。
    // ═══════════════════════════════════════════════════════════

    // ═══════════════════════════════════════════════════════════
    //  FFI
    // ═══════════════════════════════════════════════════════════
        private fun callC(idx: Int): Unit {
        // C ABI 函数调用。
        //
        // `.auc` 路径中，AucLoader 已将 CALL_C 转为 CALL_NATIVE_ARGS（按名分派），
        // 此方法仅用于文本字节码直接生成的 CALL_C 指令。
        // 完整的 C FFI 需要 VM 持有原生函数指针表，当前以清晰错误退让。
        this.error = "CallC: index=" + toStr(idx)
            + " (native function table not loaded; use .auc path via AucLoader)"
        this.running = false
    }

    private fun callNative(idx: Int): Unit {
        // 原生函数调用（按索引）。
        //
        // `.auc` 路径中，AucLoader 已将 CALL_NATIVE(27) 转为 CALL_NATIVE_ARGS
        // 并将原生表下标解析为函数名，由 callOrBuiltin 按名分派。
        // 此方法仅用于文本字节码直接生成的 CALL_NATIVE 指令。
        this.error = "CallNative: index=" + toStr(idx)
            + " (native function table not loaded; .auc files are handled by AucLoader)"
        this.running = false
    }

    private fun cstring(): Unit {
        val v: Any = this.stack.pop()
        // 转换为 C 字符串（简化：直接返回字符串指针表示）
        this.stack.push(v)
    }

    private fun readCstr(): Unit {
        val ptr: Any = this.stack.pop()
        // 从 C 字符串指针读取（简化：返回原值）
        this.stack.push(ptr)
    }

    private fun ptrIsNull(): Unit {
        val ptr: Any = this.stack.pop()
        val val = VmOps.addrOf(ptr)
        this.stack.push(val == 0)
    }

    private fun ptrToInt(): Unit {
        val ptr: Any = this.stack.pop()
        this.stack.push(VmOps.toI32(toStr(VmOps.addrOf(ptr))))
    }

    private fun intToPtr(): Unit {
        val v: Any = this.stack.pop()
        this.stack.push(VmOps.addrOf(v))
    }

    // ═══════════════════════════════════════════════════════════
    //  异常处理
    // ═══════════════════════════════════════════════════════════

    // ═══════════════════════════════════════════════════════════
    //  异常处理（P1.4：类型过滤 / 多级过滤 / 帧截断 / 字符串自动包装）
    // ═══════════════════════════════════════════════════════════

    /// 压入异常处理器。
    ///
    /// `PUSH_HANDLER target slot catchType`；记录条目
    /// `target|ip|slot|catchType|frame`（slot = catch 后异常值的落槽，-1 = 不落槽）。
        private fun pushHandlerAt(): Unit {
        val target: String = this.argStrOf(0)
        var slot: String = "-1"
        if (this.argCountOf() >= 2) { slot = this.argStrOf(1) }
        var catchType: String = ""
        if (this.argCountOf() >= 3) { catchType = this.argStrOf(2) }
        if (Env.get("AURA_VM_EXCDIAG", "") == "1" && this.excDiagN < 24) {
            this.excDiagN = this.excDiagN + 1
            println("[DBG-HANDLER] push target=" + target + " slot=" + slot + " catch=" + catchType
                    + " depth=" + this.handlerStack.size()
                    + " peekAfter=[" + this.handlerStack.peek() + "]")
        }
        this.handlerStack.push(target + "|" + toStr(this.ip) + "|" + slot + "|" + catchType
            + "|" + toStr(this.currentFrame))
    }

    /// [R173 诊断] 异常路径有界诊断计数。
    private var excDiagN: Int = 0

    private fun popHandler(): Unit {
        // [R173] 经 hasHandler()（peek 通道）判定 —— 同 throwException，
        // 绕开 Int 调用返回值错译家族。
        if (this.handlerStack.hasHandler()) {
            this.handlerStack.pop()
        }
    }

    /// 异常值是否命中 catch 类型过滤器（P1.4）。
    ///
    /// 匹配规则：
    ///   * catchType 为 "" / "Any"：匹配一切；
    ///   * 异常值为注册对象：沿其类继承链匹配（子类实例可被父类 catch）；
    ///   * 异常值为字符串：视为自动包装的 Exception（匹配 "Exception"/"String"）；
    ///   * 其他内置类型：按 `typeName` 精确匹配。
        private fun exceptionMatches(ex: Any, catchType: String): Boolean {
        if (catchType == "" || catchType == "Any") { return true }
        if (ex == null) { return catchType == "Null" }
        val objCls: String = this.heapObjectClass(ex)
        if (objCls != "") {
            return this.classIsA(objCls, catchType)
        }
        val tn: String = VmOps.typeName(ex)
        if (tn == "String") {
            // 字符串消息自动包装为 Exception（Rust VM interp.rs 的 auto-wrap 语义）
            return catchType == "Exception" || catchType == "String"
        }
        return tn == catchType
    }

    private fun throwException(): Unit {
        val ex: Any = if (this.stack.stackDepth() > 0) this.stack.pop() else "Exception"
        if (Env.get("AURA_VM_EXCDIAG", "") == "1" && this.excDiagN < 24) {
            this.excDiagN = this.excDiagN + 1
            println("[DBG-THROW] ex=[" + VmOps.toStrAny(ex) + "] tn=" + VmOps.typeName(ex)
                    + " szDbg=[" + this.handlerStack.sizeDbg() + "] peek=[" + this.handlerStack.peek() + "]")
        }

        // 自内向外逐层过滤（P1.4 多级过滤：内层不匹配则继续外层）
        // [R173] 循环驱动改走 hasHandler()（peek 通道）：size() 的 Int 调用
        // 返回值在大函数（throwException）里是错译家族成员，读回坏值 ⇒
        // 循环整段跳过 ⇒ handler 明明在栈里却报 "Uncaught exception"
        //（07-exception-* 三例根因）。
        while (this.handlerStack.hasHandler()) {
            val handler: String = this.handlerStack.peek()
            this.handlerStack.pop()
            val parts: List<String> = VmOps.split(handler, "|")
            if (parts.size < 5) {
                continue
            }
            val target: Int = VmOps.toI32(parts[0])
            val slot: Int = VmOps.toI32(parts[2])
            val catchType: String = parts[3]
            val frame: Int = VmOps.toI32(parts[4])
            val matched: Boolean = this.exceptionMatches(ex, catchType)
            if (Env.get("AURA_VM_EXCDIAG", "") == "1" && this.excDiagN < 24) {
                this.excDiagN = this.excDiagN + 1
                println("[DBG-THROW] try catch=[" + catchType + "] matched=" + toStr(matched))
            }
            if (!matched) {
                continue
            }
            // 帧截断：丢弃 handler 之上（含当前）的调用帧，恢复到 handler 帧
            while (this.currentFrame > frame && this.callStack.callDepth() > 0) {
                this.currentClosure = this.callStack.peekClosure()
                this.callStack.pop()
                this.locals = this.savedFramesPop()
                this.currentFrame = this.currentFrame - 1
            }
            // 异常值落槽（若 handler 指定）并压栈
            if (slot >= 0) {
                this.locals.putSlot(slot, ex)
            }
            this.stack.push(ex)
            this.ip = target
            return
        }

        // 没有处理器，终止 VM
        this.error = "Uncaught exception: " + VmOps.toStrAny(ex)
        this.running = false
    }

    // ═══════════════════════════════════════════════════════════
    //  并发（完整实现：线程 / 互斥锁 / 原子 / 通道 / 读写锁 / 条件变量）
    // ═══════════════════════════════════════════════════════════
    //
    // 实现分层：
    //   * 线程操作委托到 `ThreadOps`（native 桥）
    //   * 自旋锁/原子操作使用 `Cpu.atomicAdd`（lock xaddq）
    //   * 数据结构与状态管理在 Aura 中完成
    //
    // 与 `aura.lang.concurrent.*` 模块对应：
    //   ThreadOps ←→ Thread; Mutex.*; Atomic.*; RwLock.*; Condvar.*
    // ═══════════════════════════════════════════════════════════

    /// 自旋获取：`fetch_add(1)` 返回 0 则获得锁。
        private fun vmSpinAcquire(word: Long): Unit {
        while (true) {
            if (Cpu.atomicAdd(word, 1L) == 0L) { return }
            Cpu.atomicAdd(word, 0L - 1L)
        }
    }

    /// 自旋释放：`fetch_add(-1)`。
        private fun vmSpinRelease(word: Long): Unit {
        Cpu.atomicAdd(word, 0L - 1L)
    }

    // ── 线程 ──
        private fun threadSpawn(): Unit {
        val arg: Any = this.stack.pop()
        val fnId: Any = this.stack.pop()
        val handle: Int = ThreadOps.create(
            VmOps.intOf(fnId), VmOps.intOf(arg))
        this.stack.push(handle)
    }

    private fun threadJoin(): Unit {
        val tid: Any = this.stack.pop()
        val result: Int = ThreadOps.join(VmOps.intOf(tid))
        this.stack.push(result)
    }

    private fun threadSleep(): Unit {
        val ms: Any = this.stack.pop()
        ThreadOps.sleepMs(VmOps.intOf(ms))
    }

    private fun threadId(): Unit {
        this.stack.push(ThreadOps.currentId())
    }

    private fun threadParallelism(): Unit {
        this.stack.push(ThreadOps.cores())
    }

    // ── 互斥锁（自旋锁，8 字节锁字） ──
        private fun mutexNew(): Unit {
        val addr: Long = Memory.alloc(8L)
        Memory.write64(addr, 0L)
        this.stack.push(addr)
    }

    private fun mutexLock(): Unit {
        val addr: Long = VmOps.toI64(toStr(this.stack.pop()))
        while (true) {
            if (Cpu.atomicAdd(addr, 1L) == 0L) { return }
            Cpu.atomicAdd(addr, 0L - 1L)
        }
    }

    private fun mutexTryLock(): Unit {
        val addr: Long = VmOps.toI64(toStr(this.stack.pop()))
        if (Cpu.atomicAdd(addr, 1L) == 0L) {
            this.stack.push(true)
        } else {
            Cpu.atomicAdd(addr, 0L - 1L)
            this.stack.push(false)
        }
    }

    private fun mutexUnlock(): Unit {
        val addr: Long = VmOps.toI64(toStr(this.stack.pop()))
        Cpu.atomicAdd(addr, 0L - 1L)
    }

    // ── 原子整数（16 字节：值 + CAS 守卫） ──
        private fun atomicNew(): Unit {
        val initial: Any = this.stack.pop()
        val addr: Long = Memory.alloc(16L)
        Memory.write64(addr, VmOps.addrOf(initial))
        Memory.write64(addr + 8L, 0L)
        this.stack.push(addr)
    }

    private fun atomicLoad(): Unit {
        val addr: Long = VmOps.toI64(toStr(this.stack.pop()))
        this.stack.push(Memory.read64(addr))
    }

    private fun atomicStore(): Unit {
        val value: Any = this.stack.pop()
        val addr: Long = VmOps.toI64(toStr(this.stack.pop()))
        Memory.write64(addr, VmOps.addrOf(value))
    }

    private fun atomicAdd(): Unit {
        val delta: Any = this.stack.pop()
        val addr: Long = VmOps.toI64(toStr(this.stack.pop()))
        this.stack.push(Cpu.atomicAdd(addr, VmOps.addrOf(delta)))
    }

    private fun atomicCas(): Unit {
        val desired: Any = this.stack.pop()
        val expected: Any = this.stack.pop()
        val base: Long = VmOps.toI64(toStr(this.stack.pop()))
        val guard: Long = base + 8L
        val expVal: Long = VmOps.addrOf(expected)
        val desVal: Long = VmOps.addrOf(desired)
        vmSpinAcquire(guard)
        val ok: Boolean = Memory.read64(base) == expVal
        if (ok) { Memory.write64(base, desVal) }
        vmSpinRelease(guard)
        this.stack.push(ok)
    }

    // ── 通道（32B 头 + cap×8B 环形缓冲区） ──
        private fun channelNew(): Unit {
        val cap: Any = this.stack.pop()
        var capacity: Long = VmOps.intOf(cap) as Long
        if (capacity <= 0L) { capacity = 64L }
        val addr: Long = Memory.alloc(32L + capacity * 8L)
        Memory.write64(addr, 0L)
        Memory.write64(addr + 8L, 0L)
        Memory.write64(addr + 16L, capacity)
        Memory.write64(addr + 24L, 0L)
        this.stack.push(addr)
    }

    private fun channelSend(): Unit {
        val value: Any = this.stack.pop()
        val addr: Long = VmOps.toI64(toStr(this.stack.pop()))
        val valueRaw: Long = VmOps.addrOf(value)
        val capacity: Long = Memory.read64(addr + 16L)
        while (true) {
            vmSpinAcquire(addr + 24L)
            val head: Long = Memory.read64(addr)
            val tail: Long = Memory.read64(addr + 8L)
            if (head - tail < capacity) {
                Memory.write64(addr + 32L + (head % capacity) * 8L, valueRaw)
                Memory.write64(addr, head + 1L)
                vmSpinRelease(addr + 24L)
                return
            }
            vmSpinRelease(addr + 24L)
            ThreadOps.sleepMs(1)
        }
    }

    private fun channelRecv(): Unit {
        val addr: Long = VmOps.toI64(toStr(this.stack.pop()))
        val capacity: Long = Memory.read64(addr + 16L)
        while (true) {
            vmSpinAcquire(addr + 24L)
            val head: Long = Memory.read64(addr)
            val tail: Long = Memory.read64(addr + 8L)
            if (head > tail) {
                val val: Long = Memory.read64(addr + 32L + (tail % capacity) * 8L)
                Memory.write64(addr + 8L, tail + 1L)
                vmSpinRelease(addr + 24L)
                this.stack.push(val)
                return
            }
            vmSpinRelease(addr + 24L)
            ThreadOps.sleepMs(1)
        }
    }

    // ── 读写锁（24 字节：守卫 + 读者计数 + 写者标志） ──
        private fun rwLockNew(): Unit {
        val addr: Long = Memory.alloc(24L)
        Memory.write64(addr, 0L)
        Memory.write64(addr + 8L, 0L)
        Memory.write64(addr + 16L, 0L)
        this.stack.push(addr)
    }

    private fun rwLockReadLock(): Unit {
        val guard: Long = VmOps.toI64(toStr(this.stack.pop()))
        val readers: Long = guard + 8L
        val writer: Long = guard + 16L
        while (true) {
            vmSpinAcquire(guard)
            if (Memory.read64(writer) == 0L) {
                Memory.write64(readers, Memory.read64(readers) + 1L)
                vmSpinRelease(guard)
                return
            }
            vmSpinRelease(guard)
        }
    }

    private fun rwLockWriteLock(): Unit {
        val guard: Long = VmOps.toI64(toStr(this.stack.pop()))
        val readers: Long = guard + 8L
        val writer: Long = guard + 16L
        while (true) {
            vmSpinAcquire(guard)
            if (Memory.read64(readers) == 0L && Memory.read64(writer) == 0L) {
                Memory.write64(writer, 1L)
                vmSpinRelease(guard)
                return
            }
            vmSpinRelease(guard)
        }
    }

    private fun rwLockReadUnlock(): Unit {
        val guard: Long = VmOps.toI64(toStr(this.stack.pop()))
        val readers: Long = guard + 8L
        vmSpinAcquire(guard)
        Memory.write64(readers, Memory.read64(readers) - 1L)
        vmSpinRelease(guard)
    }

    private fun rwLockWriteUnlock(): Unit {
        val guard: Long = VmOps.toI64(toStr(this.stack.pop()))
        val writer: Long = guard + 16L
        vmSpinAcquire(guard)
        Memory.write64(writer, 0L)
        vmSpinRelease(guard)
    }

    // ── 条件变量（16 字节：守卫 + 代数计数器） ──
        private fun condvarNew(): Unit {
        val addr: Long = Memory.alloc(16L)
        Memory.write64(addr, 0L)
        Memory.write64(addr + 8L, 0L)
        this.stack.push(addr)
    }

    private fun condvarWait(): Unit {
        val mutexId: Any = this.stack.pop()
        val cvId: Any = this.stack.pop()
        val guard: Long = VmOps.addrOf(cvId)
        val gen: Long = guard + 8L
        vmSpinAcquire(guard)
        val observed: Long = Memory.read64(gen)
        vmSpinRelease(guard)
        val mutexAddr: Long = VmOps.addrOf(mutexId)
        Cpu.atomicAdd(mutexAddr, 0L - 1L)
        while (Memory.read64(gen) == observed) {
            // 自旋等待 signal / broadcast
        }
        Cpu.atomicAdd(mutexAddr, 1L)
    }

    private fun condvarSignal(): Unit {
        val guard: Long = VmOps.toI64(toStr(this.stack.pop()))
        val gen: Long = guard + 8L
        vmSpinAcquire(guard)
        Memory.write64(gen, Memory.read64(gen) + 1L)
        vmSpinRelease(guard)
    }

    private fun condvarBroadcast(): Unit {
        this.condvarSignal()
    }

    // ═══════════════════════════════════════════════════════════
    //  枚举
    // ═══════════════════════════════════════════════════════════
        private fun enumConstruct(tagName: String): Unit {
        val tag: Any = this.stack.pop()
        // 枚举构造：压入标签值
        this.stack.push(tag)
    }

    private fun enumTag(): Unit {
        // 获取枚举变体索引（简化：直接返回栈顶值）
        // 不弹出，直接返回
    }

    private fun makeFnRef(funcName: String): Unit {
        // 创建函数引用：压入**函数表下标（Int）**，与 Rust VM 一致。
        //
        // `MAKE_FN_REF` 的唯一消费者是 `Thread.spawn(fn, arg)` / `Future.spawn`，
        // 原生 `ThreadOps.create(fnId, arg)` 以整数取函数下标（见 `threadSpawn`）。
        // 原实现压入**函数名字符串**，`toI32` 解析失败得 0 → 新线程恒执行函数 #0。
        this.stack.push(VmOps.toI32(funcName))
    }

    // ═══════════════════════════════════════════════════════════
    //  跨模块
    // ═══════════════════════════════════════════════════════════
        private fun callExport(symName: String): Unit {
        this.callOrBuiltin(symName, 0)
    }

    // [R175-撤] importQualifiedOf 已随裸名重定向一并撤销（见 callOrBuiltin
    // 用户函数路径前的说明）。保留占位注释防止同位再插。

    private fun callExternal(modIdx: String, symIdx: String): Unit {
        // CALL_EXTERNAL(modIdx, symIdx)：
        // modIdx 是导入表下标，symIdx 未使用（导入表已含目标符号名）。
        // 导入表格式：每行 `name|module|symbol|funcIdx`
        //
        // 语义（对应 Rust `interp.rs` 的 CallExternal）：
        //   1. 从导入表查找 modIdx 对应的导入条目
        //   2. 从导入条目获取 module 和 symbol 名称
        //   3. 在当前模块的导出表中查找该符号（同模块自引用场景）
        //   4. 若找到，按 funcIdx 调用；否则退让为错误
        val importIdx: Int = VmOps.toI32(modIdx)
        val importEntry: String = lookupImport(importIdx)
        if (importEntry == "") {
            this.error = "CallExternal: import index " + modIdx + " out of range"
            this.running = false
            return
        }
        // 解析导入表条目：name|module|symbol|funcIdx
        val parts: List<String> = splitPipe(importEntry)
        if (parts.size < 4) {
            this.error = "CallExternal: malformed import entry: " + importEntry
            this.running = false
            return
        }
        val targetSymbol: String = parts[2]
        val localFuncIdxStr: String = parts[3]
        val localFuncIdx: Int = VmOps.toI32(localFuncIdxStr)

        // 尝试从导出表查找目标符号（同模块场景）
        val exportEntry: String = lookupExportByName(targetSymbol)
        if (exportEntry != "") {
            val expParts: List<String> = splitPipe(exportEntry)
            if (expParts.size >= 2) {
                val expFuncIdx: Int = VmOps.toI32(expParts[1])
                // 通过函数表按索引调用
                val funcName: String = findFuncNameByIndex(expFuncIdx)
                if (funcName != "") {
                    this.callOrBuiltin(funcName, 0)
                    return
                }
            }
        }

        // 退让：尝试直接用导入条目的 funcIdx 作为全局函数索引
        if (localFuncIdx >= 0) {
            val fallbackName: String = findFuncNameByIndex(localFuncIdx)
            if (fallbackName != "") {
                this.callOrBuiltin(fallbackName, 0)
                return
            }
        }

        // P2.3：符号名直呼 —— 种子编译器把 import 内联进同一 `.auc`
        //（`resolve_aura_imports`），导入符号在本模块函数表中即为目标实现。
        if (this.funcParamCount(targetSymbol) >= 0 || this.funcOffset(targetSymbol) != 0) {
            val directArgc: Int = this.funcParamCount(targetSymbol)
            this.callOrBuiltin(targetSymbol, if (directArgc < 0) 0 else directArgc)
            return
        }

        // P2.3：模块注册表查询（已登记模块的导出符号诊断）
        val regExports: String = this.loadedModuleExports.getOrDefault(parts[1], "")
        if (regExports != "") {
            val regEntry: String = this.lookupExportIn(regExports, targetSymbol)
            if (regEntry != "") {
                this.error = "CallExternal: module=" + parts[1]
                    + " symbol=" + targetSymbol
                    + " (registered but its code is not loaded into this VM instance)"
            } else {
                this.error = "CallExternal: module=" + parts[1]
                    + " symbol=" + targetSymbol + " (registered module lacks this symbol)"
            }
        } else {
            this.error = "CallExternal: module=" + parts[1]
                + " symbol=" + targetSymbol
                + " (cross-module linking requires loaded module registry)"
        }
        this.running = false
    }

    /// 在导出表文本（每行 `name|funcIdx`）中查找符号（P2.3 注册表辅助）。
        private fun lookupExportIn(exportsText: String, symName: String): String {
        if (exportsText == "" || symName == "") { return "" }
        var pos: Int = 0
        var len: Int = exportsText.length
        while (pos < len) {
            val nl: Int = indexOfChar(exportsText, pos, 10)
            val end: Int = if (nl >= 0) nl else len
            val line: String = exportsText.substring(pos, end)
            pos = end + 1
            val pipe: Int = indexOfChar(line, 0, 124)
            if (pipe > 0 && line.substring(0, pipe) == symName) {
                return line
            }
        }
        return ""
    }

    /// 登记已加载模块的导出表（P2.3 ModuleRegistry；供跨模块诊断/解析）。
        fun registerLoadedModule(moduleName: String, exportsText: String): Unit {
        this.loadedModuleExports.put(moduleName, exportsText)
    }

    /// 在导入表中按索引查找条目（格式 `name|module|symbol|funcIdx`）。
        private fun lookupImport(idx: Int): String {
        if (this.importsTable == "" || idx < 0) { return "" }
        var lineIdx: Int = 0
        var pos: Int = 0
        var len: Int = this.importsTable.length
        while (pos < len) {
            val nl: Int = indexOfChar(this.importsTable, pos, 10)
            val end: Int = if (nl >= 0) nl else len
            val line: String = this.importsTable.substring(pos, end)
            pos = end + 1
            if (lineIdx == idx) {
                return line
            }
            lineIdx = lineIdx + 1
        }
        return ""
    }

    /// 在导出表中按符号名查找条目（格式 `name|funcIdx`）。
        private fun lookupExportByName(symName: String): String {
        if (this.exportsTable == "" || symName == "") { return "" }
        var pos: Int = 0
        var len: Int = this.exportsTable.length
        while (pos < len) {
            val nl: Int = indexOfChar(this.exportsTable, pos, 10)
            val end: Int = if (nl >= 0) nl else len
            val line: String = this.exportsTable.substring(pos, end)
            pos = end + 1
            val pipe: Int = indexOfChar(line, 0, 124)
            if (pipe > 0 && line.substring(0, pipe) == symName) {
                return line
            }
        }
        return ""
    }

    /// 按全局函数索引查找函数名（函数表行序 = 全局索引）。
        private fun findFuncNameByIndex(idx: Int): String {
        if (this.funcTable == "" || idx < 0) { return "" }
        var lineIdx: Int = 0
        var pos: Int = 0
        var len: Int = this.funcTable.length
        while (pos < len) {
            val nl: Int = indexOfChar(this.funcTable, pos, 10)
            val end: Int = if (nl >= 0) nl else len
            val line: String = this.funcTable.substring(pos, end)
            pos = end + 1
            if (lineIdx == idx) {
                val pipe: Int = indexOfChar(line, 0, 124)
                if (pipe > 0) {
                    return line.substring(0, pipe)
                }
                return line
            }
            lineIdx = lineIdx + 1
        }
        return ""
    }

    /// 在字符串中查找指定字符的下标（从 start 开始搜索），未找到返回 -1。
        private fun indexOfChar(s: String, start: Int, ch: Int): Int {
        var i: Int = start
        val len: Int = s.length
        while (i < len) {
            if (s.charCodeAt(i) == ch) { return i }
            i = i + 1
        }
        return -1
    }

    /// 按管道符分割字符串。
        private fun splitPipe(s: String): List<String> {
        val result: List<String> = arrayListOf<String>()
        var pos: Int = 0
        var len: Int = s.length
        while (pos < len) {
            val pipe: Int = indexOfChar(s, pos, 124)
            val end: Int = if (pipe >= 0) pipe else len
            result.add(s.substring(pos, end))
            pos = end + 1
        }
        return result
    }

    private fun callAot(funcName: String): Unit {
        // AOT 调度：尝试按函数名分派（复用 callOrBuiltin），
        // 若为未知函数则退让。
        this.callOrBuiltin(funcName, 0)
    }

    // ═══════════════════════════════════════════════════════════
    //  字节码解析辅助
    // ═══════════════════════════════════════════════════════════

    /// 获取字节码行数。
        private fun bytecodeLineCount(): Int {
        var count: Int = 0
        var i: Int = 0
        var len: Int = this.bytecode.length
        while (i < len) {
            if (this.bytecode.charCodeAt(i) == 10) {
                count = count + 1
            }
            i = i + 1
        }
        if (this.bytecode.length > 0 && this.bytecode.charCodeAt(this.bytecode.length - 1) != 10) {
            count = count + 1
        }
        return count
    }

    /// 获取指定行的字节码。
        private fun getBytecodeLine(lineIdx: Int): String {
        var pos: Int = 0
        var len: Int = this.bytecode.length
        var lineStart: Int = 0
        var cur: Int = 0

        while (pos < len) {
            val c: Int = this.bytecode.charCodeAt(pos)
            if (c == 10) {
                if (cur == lineIdx) {
                    return VmOps.vmSubstr(this.bytecode, lineStart, pos - lineStart)
                }
                cur = cur + 1
                lineStart = pos + 1
            }
            pos = pos + 1
        }
        if (cur == lineIdx) {
            return VmOps.vmSubstr(this.bytecode, lineStart, len - lineStart)
        }
        return ""
    }

    /// 查找函数入口偏移（未找到返回 0）。
        private fun funcOffset(funcName: String): Int {
        var i: Int = 0
        val n: Int = this.funcNamesL.size()
        while (i < n) {
            if (this.funcNamesL[i] == funcName) {
                return this.funcOffL[i]
            }
            i = i + 1
        }
        return VmOps.findFuncOffset(this.funcTable, funcName)
    }

    /// 查找函数参数个数（未找到返回 -1）。
        private fun funcParamCount(funcName: String): Int {
        var i: Int = 0
        val n: Int = this.funcNamesL.size()
        while (i < n) {
            if (this.funcNamesL[i] == funcName) {
                return this.funcPcL[i]
            }
            i = i + 1
        }
        return VmOps.findFuncParamCount(this.funcTable, funcName)
    }

    /// 获取常量池中的值。
    /// 算术融合白名单：与快速分派块的臂一一对应。
        private fun isArithOp(op: Int): Boolean {
        return op == 20 || op == 21 || op == 22
    }

    /// 装载期索引构建（方案 A2+E）：函数表 → 两张 HashMap；常量池 → 行缓存；
    /// 指令参数 → 预解析 Int。装载完成后调用一次；执行路径零解析零分配。
        private fun buildLoadCaches(): Unit {
        this.funcNamesL = arrayListOf<String>()
        this.funcOffL = arrayListOf<Int>()
        this.funcPcL = arrayListOf<Int>()
        // P338：funcTable 手工扫描循环在 photon 下崩溃（[BLC-ft] 前崩），
        // 暂跳过——funcOffset/funcParamCount 走 VmOps.findFuncOffset/findFuncParamCount
        // 现场解析（独立实现）。CALL 低频，性能可接受。
        if (false) {
        val ft: String = this.funcTable
        var start: Int = 0
        var i: Int = 0
        val n: Int = ft.length
        while (i < n) {
            if (ft.charCodeAt(i) == 10) {
                if (i > start) {
                    val line: String = VmOps.vmSubstr(ft, start, i - start)
                    val p1: Int = VmOps.indexOf(line, "|", 0)
                    if (p1 >= 0) {
                        val p2: Int = VmOps.indexOf(line, "|", p1 + 1)
                        if (p2 > p1) {
                            val name: String = VmOps.vmSubstr(line, 0, p1)
                            if (name != "") {
                                val off: Int = VmOps.toI32(VmOps.vmSubstr(line, p1 + 1, p2 - p1 - 1))
                                val pc: Int = VmOps.toI32(VmOps.vmSubstr(line, p2 + 1, line.length - p2 - 1))
                                this.funcNamesL.add(name)
                                this.funcOffL.add(off)
                                this.funcPcL.add(pc)
                            }
                        }
                    }
                }
                start = i + 1
            }
            i = i + 1
        }
        }
        // P359：constLines 构建移至 loadPredecoded（消费解码端就地切分的
        // mod.constLines；本函数作用域无 constLinesIn，曾误置于此）。
        // P391：arg0Ints/arg1Ints **不再在此清空**——P271 跳过已解除：
        // 预解析现由 loadArgsFlat/writeArgsRow 装载期就地构建（纯数字落值、
        // 否则哨兵），fuseHotPairs 的 setArgsRow 同步更新改写行。当年的
        // 「句柄与 argStrs 混叠」观察属 Vm 对象字段布局家族，P368-375 已
        // 根治；本优化经 banner/fib28/loop1M 三程序输出精确校验。
        // ⚠️ 顺序契约：loadArgsFlat → fuseHotPairs → buildLoadCaches，
        // 本函数不得触碰 arg0/1Ints。
        // P392：最终态拷入 Memory 裸缓冲（执行期零 List 调用）。
        this.mcN = this.opCodes.size()
        this.mcOpCodes = Memory.alloc(this.mcN * 8)
        this.mcA0 = Memory.alloc(this.mcN * 8)
        this.mcA1 = Memory.alloc(this.mcN * 8)
        var mi: Int = 0
        while (mi < this.mcN) {
            Memory.write64(this.mcOpCodes + mi * 8, this.opCodes[mi])
            val a0: Int = if (this.arg0Ints.size() > mi) { this.arg0Ints[mi] } else { this.argNoneMark }
            val a1: Int = if (this.arg1Ints.size() > mi) { this.arg1Ints[mi] } else { this.argNoneMark }
            Memory.write64(this.mcA0 + mi * 8, a0)
            Memory.write64(this.mcA1 + mi * 8, a1)
            mi = mi + 1
        }
        this.mcValid = 1

    }

    /// 装载期超级指令融合（方案 D）：对预解码流做一次线性窥孔改写。
    /// ⚠ 就地改写（不压缩流）：跳转目标是原始行号，压缩会错位（实测死循环）。
    /// 融合对写首行，次行 OP_NOP 占位——行号全稳定，每对省一次完整分派。
    ///
    /// P397：**两遍扫描**——遍 1 纯读识别融合计划（行号+融合 opcode），遍 2
    /// 纯写执行改写。旧实现单循环边读边写增量改写，在 photon 下触发槽
    /// 影子读家族（P277：r 不推进 14 万次；P366 同族）需要护栏截断，融合
    /// 长期失效。读写分离后计划行间无重叠，遍 2 的写入不影响遍 1 结论。
        private fun fuseHotPairs(): Unit {
        val n: Int = this.opCodes.size()
        if (n < 2) { return }
        // 跳转目标位图：融合窗口 [r+1, r+span) 内不得含任何跳转目标行，
        // 否则跳到中间行会命中 OP_NOP → 整条融合指令被跳过（语义错误）。
        val isTarget: List<Int> = arrayListOf<Int>()
        var ti: Int = 0
        while (ti < n) {
            isTarget.add(0)
            ti = ti + 1
        }
        var sj: Int = 0
        while (sj < n) {
            val jop: Int = this.opCodes[sj]
            if (jop == 50 || jop == 51 || jop == 52) {
                if (this.argCounts[sj] > 0) {
                    val t: Int = VmOps.toI32(this.argStrs[sj * 3])
                    if (t >= 0 && t < n) {
                        isTarget[t] = 1
                    }
                }
            }
            sj = sj + 1
        }
        // ── Pass 1：识别（纯读）── P405：单点递增形态——步长经局部 step
        // 在循环底一次性结算，消除「i = i + span; continue」双写游标
        //（P277 影子读的触发布局）；blocked 内层循环同样单点递增。
        val planR: List<Int> = arrayListOf<Int>()
        val planF: List<Int> = arrayListOf<Int>()
        val n1: Int = n - 1
        var i: Int = 0
        while (i < n1) {
            val f: Int = this.matchFuseAt(i, n)
            var step: Int = 1
            if (f != 0) {
                val span: Int = this.fuseSpanOf(f)
                var blocked: Int = 0
                var k2: Int = i + 1
                val kEnd: Int = i + span
                while (k2 < kEnd) {
                    if (k2 < n && isTarget[k2] == 1) {
                        blocked = 1
                        k2 = kEnd
                    }
                    k2 = k2 + 1
                }
                if (blocked == 0) {
                    planR.add(i)
                    planF.add(f)
                    step = span
                }
            }
            i = i + step
        }
        // ── Pass 2：改写（纯写）──
        var pi: Int = 0
        val pn: Int = planR.size()
        while (pi < pn) {
            val r: Int = planR[pi]
            val f: Int = planF[pi]
            val span: Int = this.fuseSpanOf(f)
            val pair: List<String> = this.buildFusePair(r, f)
            this.opCodes[r] = f
            this.setArgsRow(r, pair)
            this.ops[r] = this.fuseNameOf(f)
            var kk: Int = 1
            while (kk < span) {
                this.opCodes[r + kk] = Opcodes.OP_NOP
                this.setArgsRow(r + kk, arrayListOf<String>())
                this.ops[r + kk] = ""
                kk = kk + 1
            }
            pi = pi + 1
        }
    }

    /// 融合对识别：返回融合 opcode（0 = 无）。语义与原增量版一致，唯
    /// 6 连守卫（204）保留 store/load 同槽检查（tmpW==tmpR）——不同槽
    /// 时原第二分支会错误假设同槽，此处不融合（放弃该对，语义安全）。
        private fun matchFuseAt(r: Int, n: Int): Int {
        val op: Int = this.opCodes[r]
        if (r < n - 5
            && op == 10
            && this.opCodes[r + 1] == 5
            && this.opCodes[r + 2] == 32
            && this.opCodes[r + 3] == 11
            && this.opCodes[r + 4] == 10
            && this.opCodes[r + 5] == 51) {
            val a3s: String = this.argStrs[(r + 3) * 3]
            val a4s: String = this.argStrs[(r + 4) * 3]
            if (a3s == a4s) {
                return 204
            }
            return 0
        }
        if (r < n - 3
            && op == 10
            && this.opCodes[r + 1] == 5
            && this.isArithOp(this.opCodes[r + 2])
            && this.opCodes[r + 3] == 11) {
            return 202
        }
        if (r < n - 3
            && op == 10
            && this.opCodes[r + 1] == 10
            && this.isArithOp(this.opCodes[r + 2])
            && this.opCodes[r + 3] == 11) {
            return 203
        }
if (false && (r < n - 5
            && op == 10
            && this.opCodes[r + 1] == 10
            && this.opCodes[r + 2] == 32
            && this.opCodes[r + 3] == 11
            && this.opCodes[r + 4] == 10
            && this.opCodes[r + 5] == 51)) {
            return 205
        }
        if (op == 10 && this.opCodes[r + 1] == 11) {
            return 206
        }
        if (op == 5 && this.opCodes[r + 1] == 11) {
            return 200
        }
        if (op == 10 && this.opCodes[r + 1] == 51) {
            return 201
        }
        return 0
    }

    /// 融合对的窗口跨度。
        private fun fuseSpanOf(f: Int): Int {
        if (f == 204 || f == 205) { return 6 }
        if (f == 202 || f == 203) { return 4 }
        return 2
    }

    /// 融合对的参数构造（从 argStrs 读取原行参数）。
        private fun buildFusePair(r: Int, f: Int): List<String> {
        val pair: List<String> = arrayListOf<String>()
        val a0s: String = this.argStrs[r * 3]
        val a1s: String = this.argStrs[(r + 1) * 3]
        if (f == 202 || f == 203 || f == 205) {
            val a3s: String = this.argStrs[(r + 3) * 3]
            if (a0s != "") { pair.add(a0s) } else { pair.add("0") }
            if (a1s != "") { pair.add(a1s) } else { pair.add("0") }
            if (f == 205) {
                // P405 修复：205 的执行臂读 4 参（a,b,tmpSlot=arg2,
                // jumpTarget=arg3）——原构造漏掉 r+5 行的跳转目标，
                // arg3 落 argNoneMark → 0 → 跳回第 0 行（banner 重启 /
                // loop1M 吞输出的实相）。
                if (a3s != "") { pair.add(a3s) } else { pair.add("-1") }
                val a5s: String = this.argStrs[(r + 5) * 3]
                if (a5s != "") { pair.add(a5s) } else { pair.add("0") }
            } else {
                pair.add(toStr(this.opCodes[r + 2]))
                if (a3s != "") { pair.add(a3s) } else { pair.add("0") }
            }
        } else if (f == 204) {
            val a3s: String = this.argStrs[(r + 3) * 3]
            val a5s: String = this.argStrs[(r + 5) * 3]
            if (a0s != "") { pair.add(a0s) } else { pair.add("0") }
            if (a1s != "") { pair.add(a1s) } else { pair.add("0") }
            pair.add(toStr(32))
            if (a3s != "") { pair.add(a3s) } else { pair.add("-1") }
            if (a5s != "") { pair.add(a5s) } else { pair.add("0") }
        } else if (f == 206 || f == 201) {
            // 两参融合对：arg1 在 r+1 行（STORE 槽 / JIF 跳转目标）。
            val a1b: String = this.argStrs[(r + 1) * 3]
            if (a0s != "") { pair.add(a0s) } else { pair.add("0") }
            if (a1b != "") { pair.add(a1b) } else { pair.add("0") }
        } else if (f == 200) {
            if (a0s != "") { pair.add(a0s) } else { pair.add("0") }
            pair.add(a1s)
        }
        return pair
    }

    /// 融合指令的助记符名。
        private fun fuseNameOf(f: Int): String {
        if (f == 204) { return "LDLC_LTL_JIFS" }
        if (f == 202) { return "LDLC_OP_STL" }
        if (f == 203) { return "LDLB_OP_STL" }
        if (f == 205) { return "LDLB_LTL_JIFS" }
        if (f == 206) { return "LDL_STL" }
        if (f == 200) { return "LDIC_STL" }
        return "LDL_JIF"
    }

    /// 第 i 条指令的 arg0 整数值（预解析未命中时回退现场解析）。

    /// 取第 k 个参数的字符串值（扁平槽：0/1/2 直取；≥3 当前指令集无此形态）。
        private fun argStrOf(k: Int): String {
        if (k <= 2) {
            // P341：下标形式（.get 调用窗口实参槽覆写，布局敏感）
            return this.argStrs[(this.ip - 1) * 3 + k]
        }
        return ""
    }

    /// 取第 k 个参数的字符串值（k ≥ 3 恒空：当前指令集参数最多 5 个且
    /// 槽 3/4 仅融合指令使用、必为数值——走 arg3/4IntOf）。
        private fun argCountOf(): Int {
        return this.argCounts[this.ip - 1]
    }

    /// 数值快路径：槽 2/3/4 的预解析值（sentinel 时回退按字符串解析）。
        private fun arg2IntOf(): Int {
        val v: Int = this.arg2Ints[this.ip - 1]
        if (v != this.argNoneMark) {
            return v
        }
        return VmOps.toI32(this.argStrOf(2))
    }

    private fun arg3IntOf(): Int {
        val v: Int = this.arg3Ints[this.ip - 1]
        if (v != this.argNoneMark) {
            return v
        }
        return VmOps.toI32(this.argStrOf(3))
    }

    private fun arg4IntOf(): Int {
        val v: Int = this.arg4Ints[this.ip - 1]
        if (v != this.argNoneMark) {
            return v
        }
        return VmOps.toI32(this.argStrOf(4))
    }

    /// 常量池按下标直取（arg0/1IntOf 预解析下标的免解析快路径）。
        private fun getConstByIdx(idx: Int): Any {
        // P364：**单返回路径**——旧双返回（String 路径 + Any fallback 路径）
        // 的合并值在 photon 下按调用点布局被 Int 装箱（字符串指针
        // (v<<1)|1），println 打印指针十进制（[CA] tagged=true 实证）。
        // constLines 已完备（54 条解码期直建），fallback 仅作越界兜底。
        val n: Int = this.constLines.size()
        var k: Int = idx
        if (k < 0) { k = 0 }
        if (k > n - 1) { k = n - 1 }
        if (n <= 0) {
            return ""
        }
        return this.unescapeConst(this.constLines[k])
    }

    /// 装载扁平参数串（loadPredecoded）：每条 "a0,a1[,a2]"，空段保序。
    /// ⚠️ 槽 3/4 装载期不存在（融合指令由 fuseHotPairs 生成并回填）。
        private fun loadArgsFlat(flat: List<String>): Unit {
        this.argStrs = arrayListOf<String>()
        this.arg2Ints = arrayListOf<Int>()
        this.arg3Ints = arrayListOf<Int>()
        this.arg4Ints = arrayListOf<Int>()
        this.argCounts = arrayListOf<Int>()
        this.arg0Ints = arrayListOf<Int>()
        this.arg1Ints = arrayListOf<Int>()
        var i: Int = 0
        val n: Int = flat.size()
        while (i < n) {
            // [P5] List.get 在部分宿主布局下静默 null（符号解析随闭包布局漂移）
            // ——下标索引是唯一可靠形态（与 X86Emitter v5 同教训）
            val ln: String = flat[i]
            var c0: Int = -1
            var c1: Int = -1
            var p: Int = 0
            val lnN: Int = ln.length
            while (p < lnN) {
                if (ln.charCodeAt(p) == 44) {
                    if (c0 < 0) {
                        c0 = p
                    } else if (c1 < 0) {
                        c1 = p
                    }
                }
                p = p + 1
            }
            var s0: String = ln
            var s1: String = ""
            var s2: String = ""
            if (c0 >= 0) {
                s0 = VmOps.vmSubstr(ln, 0, c0)
                if (c1 >= 0) {
                    s1 = VmOps.vmSubstr(ln, c0 + 1, c1 - c0 - 1)
                    s2 = VmOps.vmSubstr(ln, c1 + 1, lnN - c1 - 1)
                } else {
                    s1 = VmOps.vmSubstr(ln, c0 + 1, lnN - c0 - 1)
                }
            }
            // [R4] 有界诊断：flat 行切分现场（前 40 行）
            if (i < 40) {
                println("[LAF] i=" + toStr(i) + " ln=[" + ln + "] s0=[" + s0 + "] s1=[" + s1 + "]")
            }
            this.argStrs.add(s0)
            this.argStrs.add(s1)
            this.argStrs.add(s2)
            var seg: Int = 0
            if (ln != "") {
                seg = 1
                if (c0 >= 0) {
                    seg = 2
                    if (c1 >= 0) {
                        seg = 3
                    }
                }
            }
            this.argCounts.add(seg)
            this.arg2Ints.add(this.argNoneMark)
            this.arg3Ints.add(this.argNoneMark)
            this.arg4Ints.add(this.argNoneMark)
            // P391：arg0/arg1 整数预解析（P271 重新启用）——执行期每条指令
            // 的 arg0IntOf/arg1IntOf 免一次字符串 toI32。纯数字才落值，
            // 否则哨兵（执行期回退现场解析，语义与 P352 表长守卫一致）。
            if (VmOps.isAllDigits(s0)) {
                this.arg0Ints.add(VmOps.toI32(s0))
            } else {
                this.arg0Ints.add(this.argNoneMark)
            }
            if (VmOps.isAllDigits(s1)) {
                this.arg1Ints.add(VmOps.toI32(s1))
            } else {
                this.arg1Ints.add(this.argNoneMark)
            }
            i = i + 1
        }
    }

    /// 文本路径（buildLineCache）写一行参数槽（与 loadArgsFlat 同构）。
    /// ⚠️ 不写 arg0/1Ints——buildLoadCaches 在融合**之后**统一重建。
        private fun writeArgsRow(temp: List<String>): Unit {
        var k: Int = 0
        while (k < 3) {
            val v: String = if (k < temp.size()) { temp[k] } else { "" }
            this.argStrs.add(v)
            if (k == 0) {
                // P391：arg0/arg1 整数预解析（文本路径与预解码路径同构）。
                if (VmOps.isAllDigits(v)) {
                    this.arg0Ints.add(VmOps.toI32(v))
                } else {
                    this.arg0Ints.add(this.argNoneMark)
                }
            } else if (k == 1) {
                if (VmOps.isAllDigits(v)) {
                    this.arg1Ints.add(VmOps.toI32(v))
                } else {
                    this.arg1Ints.add(this.argNoneMark)
                }
            }
            if (VmOps.isAllDigits(v)) {
                val n: Int = VmOps.toI32(v)
                if (k == 2) {
                    this.arg2Ints.add(n)
                } else {
                    this.arg2Ints.add(this.argNoneMark)
                }
            } else {
                this.arg2Ints.add(this.argNoneMark)
            }
            k = k + 1
        }
        this.arg3Ints.add(this.argNoneMark)
        this.arg4Ints.add(this.argNoneMark)
        this.argCounts.add(temp.size())
    }

    /// 融合写回：把 pair 的槽写回第 r 行（字符串槽 0-2 + 数值槽 2-4 + 计数）。
    /// ⚠️ 不写 arg0/1Ints——fuseHotPairs 在 buildLoadCaches **之前**运行，
    /// 后者会从 argStrs 统一重建。
        private fun setArgsRow(r: Int, pair: List<String>): Unit {
        var k: Int = 0
        while (k < 3) {
            val v: String = if (k < pair.size()) { pair[k] } else { "" }
            this.argStrs[r * 3 + k] = v
            if (k == 0) {
                // P391：融合改写行同步更新 arg0/1Ints（P271 重新启用后
                // arg0/1Ints 不再由 buildLoadCaches 事后重建）。
                if (VmOps.isAllDigits(v)) {
                    this.arg0Ints[r] = VmOps.toI32(v)
                } else {
                    this.arg0Ints[r] = this.argNoneMark
                }
            } else if (k == 1) {
                if (VmOps.isAllDigits(v)) {
                    this.arg1Ints[r] = VmOps.toI32(v)
                } else {
                    this.arg1Ints[r] = this.argNoneMark
                }
            } else if (k == 2) {
                if (VmOps.isAllDigits(v)) {
                    this.arg2Ints[r] = VmOps.toI32(v)
                } else {
                    this.arg2Ints[r] = this.argNoneMark
                }
            }
            k = k + 1
        }
        if (pair.size() > 3) {
            this.arg3Ints[r] = VmOps.toI32(pair[3])
        } else {
            this.arg3Ints[r] = this.argNoneMark
        }
        if (pair.size() > 4) {
            this.arg4Ints[r] = VmOps.toI32(pair[4])
        } else {
            this.arg4Ints[r] = this.argNoneMark
        }
        this.argCounts[r] = pair.size()
    }

    private fun arg0IntOf(): Int {
        // P392：Memory 缓冲快路径（mcValid 后哨兵语义由装载期落值保证——
        // 非纯数字行装载期落 argNoneMark，此处哨兵值按调用方语义兜底 0）。
        if (this.mcValid == 1) {
            val v: Int = Memory.read64(this.mcA0 + (this.ip - 1) * 8) as Int
            if (v != this.argNoneMark) {
                return v
            }
            return 0
        }
        // P352：快路径必须先查表长——arg0Ints 未填充（P271 跳过）时，
        // 空表 OOB 读经 __list_get 的 null 守卫返回 0，哨兵比较误通过
        // ⇒ 所有指令参数恒 0（STORE_LOCAL 槽号、JUMP 目标全错）。
        if (this.arg0Ints.size() > this.ip - 1) {
            val v: Int = this.arg0Ints[this.ip - 1]
            if (v != this.argNoneMark) {
                return v
            }
        }
        return VmOps.toI32(this.argStrOf(0))
    }

    /// 第 i 条指令的 arg1 整数值（同上）。
        private fun arg1IntOf(): Int {
        if (this.mcValid == 1) {
            val v: Int = Memory.read64(this.mcA1 + (this.ip - 1) * 8) as Int
            if (v != this.argNoneMark) {
                return v
            }
            return 0
        }
        if (this.arg1Ints.size() > this.ip - 1) {
            val v: Int = this.arg1Ints[this.ip - 1]
            if (v != this.argNoneMark) {
                return v
            }
        }
        return VmOps.toI32(this.argStrOf(1))
    }

    private fun getConst(idxStr: String): Any {
        val idx: Int = VmOps.toI32(idxStr)
        val n: Int = this.constLines.size()
        if (idx >= 0 && idx < n) {
            // P359：转义态统一反转义
            return unescapeConst(this.constLines[idx])
        }
        return unescapeConst(VmOps.getFieldAt(this.constPool, idx, "\n"))
    }

    /// 反转义 AucLoader 的常量值转义（\\ → \、\n → 换行）。
        private fun unescapeConst(s: String): String {
        var hasEscape: Boolean = false
        var i0: Int = 0
        val n0: Int = s.length
        while (i0 < n0) {
            if (s.charCodeAt(i0) == 92) {
                hasEscape = true
                i0 = n0
            }
            i0 = i0 + 1
        }
        if (!hasEscape) {
            return s
        }
        var out: String = ""
        var i: Int = 0
        val n: Int = s.length
        while (i < n) {
            val c: Int = s.charCodeAt(i)
            if (c == 92 && i + 1 < n) {
                val c2: Int = s.charCodeAt(i + 1)
                if (c2 == 110) {
                    out = out + String.fromCharCode(10)
                    i = i + 2
                } else if (c2 == 92) {
                    out = out + String.fromCharCode(92)
                    i = i + 2
                } else {
                    out = out + String.fromCharCode(c)
                    i = i + 1
                }
            } else {
                out = out + String.fromCharCode(c)
                i = i + 1
            }
        }
        return out
    }

    /// 检查字符串是否以指定前缀开头。
        private fun startsWith(s: String, prefix: String): Boolean {
        if (s.length < prefix.length) {
            return false
        }
        var i: Int = 0
        val prefixLen: Int = prefix.length
        while (i < prefixLen) {
            if (s.charCodeAt(i) != prefix.charCodeAt(i)) {
                return false
            }
            i = i + 1
        }
        return true
    }

    // ═══════════════════════════════════════════════════════════
    //  状态查询
    // ═══════════════════════════════════════════════════════════

    /// 获取错误信息。
        fun getError(): String {
        return this.error
    }

    /// 获取指令计数。
        fun getInstructionCount(): Int {
        return this.instructionCount
    }

    /// 检查是否运行中。
        fun isRunning(): Boolean {
        return this.running
    }

    /// 获取栈深度。
        fun getStackDepth(): Int {
        return this.stack.stackDepth()
    }

    /// 获取退出码。
        fun getExitCode(): Int {
        return this.exitCode
    }

    /// 获取返回值。
        fun getReturnValue(): Any {
        return this.returnValue
    }

    /// 获取全局变量。
        fun getGlobal(name: String): Any {
        // [R33] 线性读
        val gn: Int = this.gKeys.size()
        var gi: Int = 0
        while (gi < gn) {
            if (this.gKeys[gi] == name) {
                return this.gVals[gi]
            }
            gi = gi + 1
        }
        return null
    }

    /// 设置全局变量。
        fun setGlobal(name: String, value: Any): Unit {
        // [R33] 线性写
        val gn2: Int = this.gKeys.size()
        var gi2: Int = 0
        var gw2: Int = 0
        while (gi2 < gn2) {
            if (this.gKeys[gi2] == name) {
                this.gVals[gi2] = value
                gw2 = 1
                gi2 = gn2
            }
            gi2 = gi2 + 1
        }
        if (gw2 == 0) {
            this.gKeys.add(name)
            this.gVals.add(value)
        }
    }

    /// 获取闭包总数。
        fun getClosureCount(): Int {
        return this.closureTable.getSize()
    }

    /// 获取捕获值（upvalue）总数（P1.3）。
        fun getUpvalueCount(): Int {
        return this.upvalueTotal
    }

    /// 注册类继承关系（P1.2；与 DEF_CLASS 指令等效，parent 空/"-" = 无父类）。
        fun registerClass(cls: String, parent: String): Unit {
        this.defClass(cls, parent)
    }

    // ═══════════════════════════════════════════════════════════
    //  加速派发钩子（P0.8，仅接口；VM-PA-00 §2.3 契约）
    // ═══════════════════════════════════════════════════════════

    /// 启用/禁用加速派发钩子（默认关闭，行为与未接入时完全一致）。
        fun enableAccelDispatch(enabled: Boolean): Unit {
        this.accelEnabled = enabled
    }

    /// 注册热函数直呼入口（funcName -> 入口行号）。
        fun setAccelEntry(funcName: String, entryIp: Int): Unit {
        this.accelTable.put(funcName, entryIp)
    }

    /// 清空直呼表。
        fun clearAccelEntries(): Unit {
        this.accelTable = HashMap<String, Int>()
    }

    /// 查询钩子是否启用。
        fun isAccelDispatchEnabled(): Boolean {
        return this.accelEnabled
    }

    /// VM 版本。
        fun version(): String {
        return "1.1.0-p0-numeric-dispatch"
    }

    /// 检查 VM 是否就绪。
        fun isReady(): Boolean {
        return true
    }

    /// 挂起执行（P0：仅置挂起标志；原协程语义已按 D5 废弃）。
        fun suspend(): Unit {
        this.suspended = true
        this.running = false
    }

    /// 恢复执行。
        fun resume(): Unit {
        this.suspended = false
        this.running = true
    }

    /// 保存 VM 状态（用于协程切换）。
        fun saveState(): HashMap<String, Any> {
        val state: HashMap<String, Any> = HashMap<String, Any>()
        state.put("ip", this.ip)
        state.put("running", this.running)
        state.put("suspended", this.suspended)
        state.put("returnValue", this.returnValue)
        state.put("error", this.error)
        state.put("exitCode", this.exitCode)
        state.put("instructionCount", this.instructionCount)
        state.put("currentFrame", this.currentFrame)
        state.put("currentFunc", this.currentFunc)
        return state
    }

    /// 恢复 VM 状态。
        fun restoreState(state: HashMap<String, Any>): Unit {
        val ipVal = state.get("ip")
        if (ipVal != null) this.ip = ipVal as Int
        val runningVal = state.get("running")
        if (runningVal != null) this.running = runningVal as Boolean
        val suspendedVal = state.get("suspended")
        if (suspendedVal != null) this.suspended = suspendedVal as Boolean
        val retVal = state.get("returnValue")
        if (retVal != null) this.returnValue = retVal
        val errVal = state.get("error")
        if (errVal != null) this.error = errVal as String
        val exitVal = state.get("exitCode")
        if (exitVal != null) this.exitCode = exitVal as Int
        val icVal = state.get("instructionCount")
        if (icVal != null) this.instructionCount = icVal as Int
        val cfVal = state.get("currentFrame")
        if (cfVal != null) this.currentFrame = cfVal as Int
        val cfName = state.get("currentFunc")
        if (cfName != null) this.currentFunc = cfName as String
        this.suspended = false
        this.running = true
    }

    // ═══════════════════════════════════════════════════════════
    //  测试/工具方法（供 VmRunner 委托）
    // ═══════════════════════════════════════════════════════════

    /// 压栈（测试用）。
        fun push(value: String): Unit {
        this.stack.push(value)
    }

    /// 栈顶（测试用）。
        fun peek(): String {
        val v = this.stack.peek()
        if (v == null) return ""
        return toStr(v)
    }

    /// 弹栈（测试用）。
        fun pop(): String {
        val v = this.stack.pop()
        if (v == null) return ""
        return toStr(v)
    }

    /// 设置局部变量（测试用）。
        fun setLocal(idx: Int, value: String): Unit {
        this.locals.putSlot(idx, value)
    }

    /// 诊断：读融合后指令流的操作码名（dump 用，不进热路径）。
        fun debugOpName(i: Int): String {
        return this.ops[i]
    }

    /// 诊断：读融合后指令流的参数个数。
        fun debugArgCount(i: Int): Int {
        return this.argCounts[i]
    }

    /// 诊断：读融合后指令流的第 j 个参数。
        fun debugArg(i: Int, j: Int): String {
        if (j <= 2) {
            return this.argStrs[i * 3 + j]
        }
        if (j == 3) {
            val v: Int = this.arg3Ints[i]
            if (v != this.argNoneMark) { return toStr(v) }
        }
        if (j == 4) {
            val v: Int = this.arg4Ints[i]
            if (v != this.argNoneMark) { return toStr(v) }
        }
        return ""
    }

    /// 获取局部变量（测试用）。
        fun getLocal(idx: Int): String {
        val v = this.locals.getSlot(idx)
        if (v == null) return ""
        return toStr(v)
    }

    /// 加法（测试用）。
        fun arithAdd(a: String, b: String): String {
        return VmOps.intToStr(VmOps.vrToInt(a) + VmOps.vrToInt(b))
    }

    /// 减法（测试用）。
        fun arithSub(a: String, b: String): String {
        return VmOps.intToStr(VmOps.vrToInt(a) - VmOps.vrToInt(b))
    }

    /// 乘法（测试用）。
        fun arithMul(a: String, b: String): String {
        return VmOps.intToStr(VmOps.vrToInt(a) * VmOps.vrToInt(b))
    }

    /// 除法（测试用）。
        fun arithDiv(a: String, b: String): String {
        val div: Int = VmOps.vrToInt(b)
        if (div == 0) return "0"
        return VmOps.intToStr(VmOps.vrToInt(a) / div)
    }
}
