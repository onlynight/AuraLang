// aura:///aura/compiler/aura/lang/compiler/vm/Vm.aura
// 虚拟机核心实现（Phase 4: 完整 VM Aura 编写）
// 概念：使用 Aura 语言本身编写完整的虚拟机，实现 bootstrapping
/// 完整虚拟机实现。
///
/// @since 0.5
internal object Vm {

    // ── 常量 ──

    /// VM 最大指令执行次数（防止无限循环）
    const MAX_INSTRUCTIONS: Int = 1000000

    /// VM 最大栈深度
    const MAX_STACK_DEPTH: Int = 256

    /// VM 最大调用深度
    const MAX_CALL_DEPTH: Int = 64

    // ── VM 状态 ──

    /// 创建新的 VM 状态。
    fun create(): Map<String, Any> {
        val state: Map<String, Any> = Collections.mutableMapOf()
        state["bytecode"] = arrayOf()
        state["frames"] = Collections.emptyList()
        state["globals"] = Collections.mutableMapOf()
        state["gcEnabled"] = true
        state["instructionCount"] = 0
        state["running"] = true
        return state
    }

    // ── 字节码读取辅助函数 ──

    /// 从字节码中读取 1 字节。
    fun readByte(bytecode: Array<Byte>, offset: Int): Int {
        return bytecode[offset]
    }

    /// 从字节码中读取 2 字节（大端）。
    fun readShort(bytecode: Array<Byte>, offset: Int): Int {
        val hi = bytecode[offset]
        val lo = bytecode[offset + 1]
        return (hi * 256) + lo
    }

    /// 从字节码中读取 4 字节（大端整数）。
    fun readInt(bytecode: Array<Byte>, offset: Int): Int {
        val b0 = bytecode[offset]
        val b1 = bytecode[offset + 1]
        val b2 = bytecode[offset + 2]
        val b3 = bytecode[offset + 3]
        return (b0 * 16777216) + (b1 * 65536) + (b2 * 256) + b3
    }

    // ── 栈操作辅助 ──

    /// 从栈中弹出值。
    private fun stackPop(stack: List<Any>): Any {
        val size = stack.size
        if (size == 0) {
            throw Runtime("VM: stack underflow")
        }
        return stack[size - 1]
    }

    // ── 算术运算辅助 ──

    /// 加法。
    fun arithmeticAdd(a: Any, b: Any): Any {
        if (typeof(a) == "Int" and typeof(b) == "Int") {
            return (a as Int) + (b as Int)
        }
        if (typeof(a) == "Float" or typeof(b) == "Float") {
            return toFloat(a) + toFloat(b)
        }
        if (typeof(a) == "String") {
            return toStr(a) + toStr(b)
        }
        throw Runtime("ADD: unsupported types " + typeof(a) + " + " + typeof(b))
    }

    /// 减法。
    fun arithmeticSub(a: Any, b: Any): Any {
        if (typeof(a) == "Float" or typeof(b) == "Float") {
            return toFloat(a) - toFloat(b)
        }
        if (typeof(a) == "Int" and typeof(b) == "Int") {
            return (a as Int) - (b as Int)
        }
        throw Runtime("SUB: unsupported types " + typeof(a) + " - " + typeof(b))
    }

    // ── 入口点 ──

    /// VM 主入口点。
    fun main(bytecode: Array<Byte>): Any {
        return interpret(bytecode)
    }

    /// VM 版本信息。
    fun version(): String {
        return "0.5.0-phase4-phantom"
    }

    /// 检查 VM 是否就绪（所有依赖可用）。
    fun isReady(): Boolean {
        return true
    }

    /// 主字节码解释器（简化占位实现）。
    fun interpret(bytecode: Array<Byte>): Any {
        // Phase 4 占位实现
        return null
    }
}
