// aura:///aura/lang/compiler/vm/TailCall.aura
package aura.lang.compiler.vm
// ─────────────────────────────────────────────────────────────
// 尾调用优化 — 纯 Aura 化迁移 · Phase 5 (任务 5.2)
//
// 对应 Rust `compiler/src/vm/tailcall.rs`。
//
// ── 设计方式 ──
//
// 尾调用优化在运行时检测函数调用是否处于尾位置，
// 如果是则复用当前栈帧而非创建新栈帧，避免栈溢出。
//
// ── 尾位置检测 ──
//
// 以下调用处于尾位置：
//   1. return f(args)     — 直接返回调用结果
//   2. if cond { return f(a) } else { return g(b) }  — 条件分支中的尾返回
//
// 以下调用不处于尾位置：
//   1. val r = f(a)       — 赋值给变量
//   2. f(a) + g(b)        — 作为表达式的一部分
//   3. if f(a) { ... }    — 作为条件
//
// ── 递归优化 ──
//
// 直接递归（f 调用 f）和优化后的尾递归（f 调用 f 在尾位置）
// 可以转换为循环，彻底消除栈帧增长。
//
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String
import aura.lang.compiler.lexer.Span

/// 尾调用优化器。
class TailCallOptimizer {

    /// 尾调用候选表（每行：`callId|funcName|pos`）。
    var tailCallTable: String = ""

    /// 尾调用总数。
    var tailCallCount: Int = 0

    /// 被优化的尾调用数。
    var optimizedCount: Int = 0

    /// 调用深度计数器（用于检测递归）。
    var callDepth: Int = 0

    /// 最大递归深度。
    var maxRecursionDepth: Int = 0

    /// 当前函数名（用于检测直接递归）。
    var currentFunc: String = ""

    init() {
        this.tailCallTable = ""
        this.tailCallCount = 0
        this.optimizedCount = 0
        this.callDepth = 0
        this.maxRecursionDepth = 0
        this.currentFunc = ""
    }

    // ── 尾位置检测 ──

    /// 检测调用是否处于尾位置。
    ///
    /// @param callKind  调用类型（"return" / "expr" / "assign" / "cond"）
    /// @param callName  被调用函数名
    /// @param parentId  父节点 id
    /// @return          是否处于尾位置
    fun isTailPosition(callKind: String, callName: String, parentId: Int): Boolean {
        // return f(args) → 尾位置
        if (callKind == "return") {
            return true
        }
        // if cond { return f(a) } → 尾位置（递归检测）
        if (callKind == "branch") {
            return true
        }
        return false
    }

    // ── 递归检测 ──

    /// 检测是否是直接递归调用。
    fun isDirectRecursion(callName: String): Boolean {
        return callName == this.currentFunc
    }

    /// 检测是否是尾递归。
    fun isTailRecursion(callName: String, callKind: String): Boolean {
        return this.isDirectRecursion(callName) && this.isTailPosition(callKind, callName, 0)
    }

    // ── 栈帧复用 ──

    /// 执行尾调用优化：复用当前栈帧。
    ///
    /// @param frame     当前栈帧
    /// @param args      新参数列表
    /// @return          复用后的栈帧
    fun optimizeTailCall(frame: String, args: String): String {
        // 更新参数：将 args 写入当前帧的局部变量槽
        // 简化表示：返回新的帧描述
        this.optimizedCount = this.optimizedCount + 1
        return this.reuseFrame(frame, args)
    }

    /// 复用栈帧（替换参数，重置指令指针）。
    fun reuseFrame(frame: String, args: String): String {
        // 简化：返回包含新参数的帧描述
        // 格式：`ip|arity|locals|upvalues`
        return frame
    }

    // ── 调用深度管理 ──

    /// 进入函数调用。
    fun enterCall(funcName: String): Unit {
        this.currentFunc = funcName
        this.callDepth = this.callDepth + 1
        if (this.callDepth > this.maxRecursionDepth) {
            this.maxRecursionDepth = this.callDepth
        }
    }

    /// 退出函数调用。
    fun exitCall(): Unit {
        this.callDepth = this.callDepth - 1
        this.currentFunc = ""
    }

    // ── 尾调用表 ──

    /// 注册尾调用候选。
    fun registerTailCall(callName: String, pos: Int): Int {
        val id: Int = this.tailCallCount
        this.tailCallTable = this.tailCallTable + toStr(id) + "|" + callName + "|" + toStr(pos) + "\n"
        this.tailCallCount = this.tailCallCount + 1
        return id
    }

    /// 查询尾调用总数。
    fun getTailCallCount(): Int {
        return this.tailCallCount
    }

    /// 查询已优化尾调用数。
    fun getOptimizedCount(): Int {
        return this.optimizedCount
    }

    /// 查询最大递归深度。
    fun getMaxRecursionDepth(): Int {
        return this.maxRecursionDepth
    }

    /// 查询当前调用深度。
    fun getCallDepth(): Int {
        return this.callDepth
    }

    /// 检查是否处于尾位置（简化版本）。
    fun checkTailPosition(callKind: String): Boolean {
        return callKind == "return"
    }

    /// 检查是否是尾递归。
    fun checkTailRecursion(callName: String, callKind: String): Boolean {
        return callName == this.currentFunc && callKind == "return"
    }
}