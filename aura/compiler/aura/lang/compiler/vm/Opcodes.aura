// aura:///aura/compiler/aura/lang/compiler/vm/Opcodes.aura
// VM 指令集定义（Phase 4: 完整 VM Aura 编写）
/// 虚拟机指令集常量定义。
///
/// @since 0.5
internal object Opcodes {

    // ── 常量指令 (0x00 - 0x0F) ──
    const val CONST_INT: Int = 0
    const val CONST_FLOAT: Int = 1
    const val CONST_STRING: Int = 2
    const val CONST_NULL: Int = 3

    // ── 栈操作 (0x10 - 0x1F) ──
    const val LOAD_LOCAL: Int = 10
    const val STORE_LOCAL: Int = 11
    const val POP: Int = 12
    const val DUP: Int = 13

    // ── 算术运算 (0x20 - 0x2F) ──
    const val ADD: Int = 20
    const val SUB: Int = 21
    const val MUL: Int = 22
    const val DIV: Int = 23
    const val MOD: Int = 24

    // ── 比较运算 (0x30 - 0x3F) ──
    const val EQ: Int = 30
    const val NEQ: Int = 31
    const val LT: Int = 32
    const val GT: Int = 33
    const val LE: Int = 34
    const val GE: Int = 35

    // ── 控制流 (0x40 - 0x4F) ──
    const val JUMP: Int = 40
    const val JUMP_IF_FALSE: Int = 41
    const val JUMP_IF_TRUE: Int = 42

    // ── 函数调用 (0x50 - 0x5F) ──
    const val CALL: Int = 50
    const val CALL_METHOD: Int = 51
    const val RETURN: Int = 52

    // ── 对象操作 (0x60 - 0x6F) ──
    const val NEW_OBJECT: Int = 60
    const val GET_FIELD: Int = 61
    const val SET_FIELD: Int = 62

    // ── FFI 调用 (0x70 - 0x7F) ──
    const val CALL_C: Int = 70
    const val CALL_RUST: Int = 71
    const val CALL_AURA: Int = 72

    // ── GC 指令 (0x80 - 0x8F) ──
    const val GC_MARK: Int = 80
    const val GC_SWEEP: Int = 81

    // ── 辅助函数 ──

    /// 获取指令助记符（调试用）。
    fun opcodeName(opcode: Int): String {
        return when (opcode) {
            CONST_INT       -> "CONST_INT"
            CONST_FLOAT     -> "CONST_FLOAT"
            CONST_STRING    -> "CONST_STRING"
            CONST_NULL      -> "CONST_NULL"
            LOAD_LOCAL      -> "LOAD_LOCAL"
            STORE_LOCAL     -> "STORE_LOCAL"
            POP             -> "POP"
            DUP             -> "DUP"
            ADD             -> "ADD"
            SUB             -> "SUB"
            MUL             -> "MUL"
            DIV             -> "DIV"
            MOD             -> "MOD"
            EQ              -> "EQ"
            NEQ             -> "NEQ"
            LT              -> "LT"
            GT              -> "GT"
            LE              -> "LE"
            GE              -> "GE"
            JUMP            -> "JUMP"
            JUMP_IF_FALSE   -> "JUMP_IF_FALSE"
            JUMP_IF_TRUE    -> "JUMP_IF_TRUE"
            CALL            -> "CALL"
            CALL_METHOD     -> "CALL_METHOD"
            RETURN          -> "RETURN"
            NEW_OBJECT      -> "NEW_OBJECT"
            GET_FIELD       -> "GET_FIELD"
            SET_FIELD       -> "SET_FIELD"
            CALL_C          -> "CALL_C"
            CALL_RUST       -> "CALL_RUST"
            CALL_AURA       -> "CALL_AURA"
            GC_MARK         -> "GC_MARK"
            GC_SWEEP        -> "GC_SWEEP"
            else            -> "UNKNOWN"
        }
    }

    /// 检查指令是否为常量指令。
    fun isConst(opcode: Int): Boolean {
        return opcode >= CONST_INT and opcode <= CONST_NULL
    }

    /// 获取所有指令名称列表（用于调试和文档）。
    fun allOpcodes(): List<String> {
        val result: List<String> = Collections.emptyList()
        var i: Int = 0
        while (i <= GC_SWEEP) {
            val name = opcodeName(i)
            if (name != "UNKNOWN") {
                result.add(name)
            }
            i = i + 1
        }
        return result
    }
}
