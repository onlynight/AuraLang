// aura:///aura/compiler/aura/lang/compiler/vm/VmCollections.aura
package aura.lang.compiler.vm
// ─────────────────────────────────────────────────────────────
// VM 集合操作 — P0 完整指令集支持
//
// **布局必须与 `aura.lang.collection.Collections` 完全一致**，因为 VM 执行的
// `.auc` 是由 Rust 编译器产出的、其内建集合调用（`listOf`/`Collections.getAt`
// 等）都按该布局访问内存：
//
//   AuraDynList (24 字节):           AuraDynMap (32 字节):
//     offset 0  : len (i64)            offset 0  : len (i64)
//     offset 8  : cap (i64)            offset 8  : cap (i64)
//     offset 16 : items ptr (i64)      offset 16 : keys ptr (i64)
//                                      offset 24 : vals ptr (i64)
//
// 旧实现把元素**内联**在头部之后（`ptr + 16 + i*8`）——恰好是 `items` 指针字段
// 的位置：`push` 覆盖了它、`getAt` 又把它当成元素读。表现为 `list.size` 正确、
// 但 `list[0]`/`list[4]` 打印同一串垃圾（实测 `Collections.getAt` 读
// `read64(list+16)` 当作元素数组指针 → 读到野地址）。
//
// Plan A 装箱：整数 `(v<<1)|1`（奇数），真实指针偶数 —— VM 栈上的值就是这种
// 「原始位模式」，故元素**按位模式**（`rawOf`/`read64`）存取；而下标/长度是
// **数值**，必须用 `toI32(toStr(...))` 解析。
// ─────────────────────────────────────────────────────────────

import aura.lang.native.Memory
import aura.lang.collection.ArrayList
import aura.lang.collection.HashMap

/// VM 集合操作工具对象。
object VmCollections {

    /// 列表头部大小（`len` + `cap` + `items` 三个 i64）。
    private val LIST_HDR_SIZE: Long = 24
    /// 映射表头部大小（`len` + `cap` + `keys` + `vals` 四个 i64）。
    private val MAP_HDR_SIZE: Long = 32
    /// 最小容量（与 `Collections` 的 `LIST_MIN_CAP` 一致）。
    private val MIN_CAP: Long = 4

    // ═══════════════════════════════════════════════════════════
    //  List 操作
    // ═══════════════════════════════════════════════════════════

    /// 创建空列表，返回堆指针（`Any` 位模式）。
    fun newList(): Any {
        return this.newListCap(MIN_CAP)
    }

    /// 按容量创建空列表。
    private fun newListCap(capIn: Long): Any {
        var cap: Long = capIn
        if (cap < MIN_CAP) {
            cap = MIN_CAP
        }
        val l: Long = Memory.alloc(LIST_HDR_SIZE)
        if (l == 0) {
            return 0
        }
        Memory.write64(l, 0)          // len
        Memory.write64(l + 8, cap)    // cap
        val items: Long = Memory.alloc(cap * 8)
        Memory.write64(l + 16, items)
        return l
    }

    /// 获取列表长度。
    ///
    /// 返回值必须**显式装箱**：`Long → Any` 的隐式转换在本 AOT 下**不做装箱**
    /// （实测：长度 5 原样返回 5，调用方按「已装箱 Any」再解箱 → 得到 2，
    /// 于是 `list.size` 打印 2）。经 `Int` 走装箱路径（`Int → Any` 会装箱）。
    fun length(list: Any): Any {
        if (list == null) {
            return 0
        }
        val ptr: Long = VmOps.rawOf(list)
        if (ptr == 0) {
            return 0
        }
        val n: Long = Memory.read64(ptr)
        return VmOps.toAny(n as Int)
    }

    /// 列表是否为空。
    fun isEmpty(list: Any): Boolean {
        if (list == null) {
            return true
        }
        val ptr: Long = VmOps.rawOf(list)
        if (ptr == 0) {
            return true
        }
        return Memory.read64(ptr) == 0
    }

    /// 向列表尾部追加元素（几何增长，原地修改）。
    fun push(list: Any, elem: Any): Unit {
        if (list == null) {
            return
        }
        val ptr: Long = VmOps.rawOf(list)
        if (ptr == 0) {
            return
        }
        val len: Long = Memory.read64(ptr)
        val cap: Long = Memory.read64(ptr + 8)
        if (len >= cap) {
            var newcap: Long = cap * 2
            if (newcap < MIN_CAP) {
                newcap = MIN_CAP
            }
            val oldItems: Long = Memory.read64(ptr + 16)
            val newItems: Long = Memory.alloc(newcap * 8)
            if (newItems == 0) {
                return
            }
            if (len > 0 && oldItems != 0) {
                Memory.copy(newItems, oldItems, len * 8)
            }
            Memory.free(oldItems)
            Memory.write64(ptr + 16, newItems)
            Memory.write64(ptr + 8, newcap)
        }
        val items: Long = Memory.read64(ptr + 16)
        if (items == 0) {
            return
        }
        Memory.write64(items + len * 8, VmOps.rawOf(elem))
        Memory.write64(ptr, len + 1)
    }

    /// 弹出列表尾部元素（返回**原始位模式**；空表返回 null）。
    fun pop(list: Any): Any {
        if (list == null) {
            return null
        }
        val ptr: Long = VmOps.rawOf(list)
        if (ptr == 0) {
            return null
        }
        val len: Long = Memory.read64(ptr)
        if (len <= 0) {
            return null
        }
        val items: Long = Memory.read64(ptr + 16)
        if (items == 0) {
            return null
        }
        val v: Long = Memory.read64(items + (len - 1) * 8)
        Memory.write64(ptr, len - 1)
        return v
    }

    /// 按下标获取元素（返回**原始位模式**；越界返回 null）。
    ///
    /// 下标必须按**数值**解析（`toI32(toStr(idx))`），**不能**用 `rawOf`：
    /// 栈上传来的下标是**装箱**值（Plan A：`0 → 1`、`4 → 9`），用 `rawOf`
    /// 会把它当 1/9 使用 —— 实测 `list[0]`/`list[4]` 打印同一串垃圾。
    fun vmListAt(list: Any, idx: Any): Any {
        if (list == null) {
            return null
        }
        val ptr: Long = VmOps.rawOf(list)
        if (ptr == 0) {
            return null
        }
        val len: Long = Memory.read64(ptr)
        val index: Long = VmOps.toI32(toStr(idx)) as Long
        if (index < 0 || index >= len) {
            return null
        }
        val items: Long = Memory.read64(ptr + 16)
        if (items == 0) {
            return null
        }
        return Memory.read64(items + index * 8)
    }

    /// 按下标写入（返回原列表句柄；越界则追加）。
    fun vmListSet(list: Any, idx: Any, value: Any): Any {
        if (list == null) {
            return null
        }
        val ptr: Long = VmOps.rawOf(list)
        if (ptr == 0) {
            return null
        }
        val len: Long = Memory.read64(ptr)
        val index: Long = VmOps.toI32(toStr(idx)) as Long
        if (index < 0 || index >= len) {
            this.push(list, value)
            return list
        }
        val items: Long = Memory.read64(ptr + 16)
        if (items == 0) {
            return list
        }
        Memory.write64(items + index * 8, VmOps.rawOf(value))
        return list
    }

    // ═══════════════════════════════════════════════════════════
    //  Map 操作
    // ═══════════════════════════════════════════════════════════

    /// 创建空 Map，返回堆指针。
    fun newMap(): Any {
        return this.newMapCap(MIN_CAP)
    }

    /// 按容量创建空 Map。
    private fun newMapCap(capIn: Long): Any {
        var cap: Long = capIn
        if (cap < MIN_CAP) {
            cap = MIN_CAP
        }
        val m: Long = Memory.alloc(MAP_HDR_SIZE)
        if (m == 0) {
            return 0
        }
        Memory.write64(m, 0)
        Memory.write64(m + 8, cap)
        val keys: Long = Memory.alloc(cap * 8)
        val vals: Long = Memory.alloc(cap * 8)
        Memory.write64(m + 16, keys)
        Memory.write64(m + 24, vals)
        return m
    }

    /// 获取 Map 长度（装箱约定同 `length`，见其说明）。
    fun mapLen(map: Any): Any {
        if (map == null) {
            return 0
        }
        val ptr: Long = VmOps.rawOf(map)
        if (ptr == 0) {
            return 0
        }
        val n: Long = Memory.read64(ptr)
        return VmOps.toAny(n as Int)
    }

    /// 向 Map 插入键值对（覆盖已有键）。
    fun mapSet(map: Any, key: Any, val: Any): Unit {
        if (map == null) {
            return
        }
        val ptr: Long = VmOps.rawOf(map)
        if (ptr == 0) {
            return
        }
        val rawKey: Long = VmOps.rawOf(key)
        val len: Long = Memory.read64(ptr)
        val keys: Long = Memory.read64(ptr + 16)
        val vals: Long = Memory.read64(ptr + 24)
        var i: Long = 0
        while (i < len) {
            if (Memory.read64(keys + i * 8) == rawKey) {
                Memory.write64(vals + i * 8, VmOps.rawOf(val))
                return
            }
            i = i + 1
        }
        // 容量不足：几何增长（键值数组同步扩容）
        var cap: Long = Memory.read64(ptr + 8)
        var kp: Long = keys
        var vp: Long = vals
        if (len >= cap) {
            var newcap: Long = cap * 2
            if (newcap < MIN_CAP) {
                newcap = MIN_CAP
            }
            val nk: Long = Memory.alloc(newcap * 8)
            val nv: Long = Memory.alloc(newcap * 8)
            if (nk == 0 || nv == 0) {
                return
            }
            if (len > 0) {
                Memory.copy(nk, keys, len * 8)
                Memory.copy(nv, vals, len * 8)
            }
            Memory.free(keys)
            Memory.free(vals)
            Memory.write64(ptr + 16, nk)
            Memory.write64(ptr + 24, nv)
            Memory.write64(ptr + 8, newcap)
            kp = nk
            vp = nv
            cap = newcap
        }
        Memory.write64(kp + len * 8, rawKey)
        Memory.write64(vp + len * 8, VmOps.rawOf(val))
        Memory.write64(ptr, len + 1)
    }

    /// 从 Map 查找键并返回值（未找到返回 null）。
    fun mapGet(map: Any, key: Any): Any {
        if (map == null) {
            return null
        }
        val ptr: Long = VmOps.rawOf(map)
        if (ptr == 0) {
            return null
        }
        val rawKey: Long = VmOps.rawOf(key)
        val len: Long = Memory.read64(ptr)
        val keys: Long = Memory.read64(ptr + 16)
        val vals: Long = Memory.read64(ptr + 24)
        var i: Long = 0
        while (i < len) {
            if (Memory.read64(keys + i * 8) == rawKey) {
                return Memory.read64(vals + i * 8)
            }
            i = i + 1
        }
        return null
    }

    /// 键是否存在于 Map。
    fun mapHas(map: Any, key: Any): Boolean {
        if (map == null) {
            return false
        }
        val ptr: Long = VmOps.rawOf(map)
        if (ptr == 0) {
            return false
        }
        val rawKey: Long = VmOps.rawOf(key)
        val len: Long = Memory.read64(ptr)
        val keys: Long = Memory.read64(ptr + 16)
        var i: Long = 0
        while (i < len) {
            if (Memory.read64(keys + i * 8) == rawKey) {
                return true
            }
            i = i + 1
        }
        return false
    }
}
