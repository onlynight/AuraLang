// aura:///aura/lang/compiler/parser/Parser.aura
package aura.lang.compiler.parser
// ─────────────────────────────────────────────────────────────
// 解析器 — 纯 Aura 化迁移 · Phase 1
//
// 对应 Rust `compiler/src/parser.rs`（递归下降 + Pratt 优先级）。
//
// ── 设计方式（与 Ast.aura 一致）──────────────────────────────
//   * AST 用扁平 arena（`Ast`）：每个节点一个 id，子节点以逗号分隔的 id 列表表示。
//   * token 流在构造时一次性缓存到 `kinds` / `lits` / `spans` 三条「每行一项」的 String，
//     避免 `Lexer.tokenAt` 的 O(n) 重复解析。
//   * 诊断累积到 `CompileErrors`（每行一条），解析结束后由调用方检查 `errors.isOk()`。
//
// ── 命名约定（重要）──────────────────────────────────────────
//   当前 Aura 编译器使用**扁平（全局）函数命名空间**，所有类的方法名必须全局唯一
//   （参考 `Lexer.aura` 的 `lx` 前缀约定）。因此本文件所有方法均以 `prs` 前缀，
//   避免与 `Ast` / `Lexer` / `CompileErrors` 等内联进同一编译单元的同类方法重名。
//
// ── 当前覆盖范围（Phase 1 起步，可逐步扩展）────────────────────
//   声明：import / fun / val / var / struct / class / object / enum / typealias / interface
//   语句：Block / ValDecl / VarDecl / Return / If / While / For / Try / Break / Continue / Assign / ExprStmt
//   表达式（Pratt）：字面量、标识符、一元 - !、二元（含 is / as）、调用 ()、成员 .、下标 []、
//           if 表达式、when、括号
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String

/// 递归下降 + Pratt 解析器。
class Parser {

    private var lx: Lexer = Lexer("")

    /// token 总数（含结尾 `EOF`）。
    var n: Int = 0

    /// 当前读取位置。
    private var pos: Int = 0

    /// 构造的 AST（扁平 arena）。
    var ast: Ast = Ast()

    /// 诊断信息。
    var errors: CompileErrors = CompileErrors()

    /// token 种类索引（由词法器的种类序列一次性 `split` 得到，O(1) 访问）。
    ///
    /// 原先以「每行一项的 String」存储，每次 `prsKind/prsLit/prsCurSpan`
    /// 都要用 `fieldAt` 从字符串头部线性扫描，解析整体因此退化为超线性。
    /// 现改为按下标 O(1) 访问。
    ///
    /// 字面量与 span 不再另存，统一走词法器的 `litAt` / `spanFieldAt`
    /// （词法器内部为堆列表，O(1) 访问）。
    private var kinds: List<String> = listOf()

    /// 「禁止 lambda 解析」开关：when 分支模式位置置 true。
    ///
    /// 否则 `CONST_INT -> "CONST_INT"` 会被当作单参 lambda，箭头与分支体被
    /// 一起吃掉，后续分支全部错位（见 `isLambdaStart`）。
    private var prsNoLambda: Boolean = false

    /// 「禁止 `is` 二元运算符」开关：when 分支体位置置 true。
    ///
    /// 否则分支体 `1` 后面的**下一个分支模式** `is Int` 会被 binPrec("Is") 当作
    /// 二元运算吃掉（`1 is Int`），随后 `->` 悬空 → 解析错位、整段 when 反同步
    /// （多个 `is` 分支的 when 在自举产物上直接段错误）。
    /// 模式位置由 `parseWhen` 的专用分支处理，不需要 `is` 二元运算符。
    private var prsNoBinaryIs: Boolean = false

    /// 构造：词法分析并缓存全部 token。
    init(source: String) {
        this.lx = Lexer(source)
        this.lx.scanAll()
        this.n = this.lx.tokenCount()
        this.pos = 0
        this.ast = Ast()
        this.errors = CompileErrors()
        // 直接复用词法器的种类列表（堆列表，O(1) 下标），不再切分整串。
        this.kinds = this.lx.kindList
    }

    // ── token 访问 ──

    /// 第 i 个 token 的种类（越界视为 `EOF`）。
    fun prsKind(i: Int): String {
        if (i >= this.n) {
            return "EOF"
        }
        if (i < 0 || i >= this.kinds.size) {
            return ""
        }
        return this.kinds[i]
    }

    /// 前瞻第 k 个 token 的种类（k=0 为当前 token）。
    fun prsPeek(k: Int): String {
        return this.prsKind(this.pos + k)
    }

    /// 第 i 个 token 的字面量（换行已还原）。
    fun prsLit(i: Int): String {
        return this.lx.litAt(i)
    }

    /// 当前 token 种类。
    fun prsCurKind(): String {
        return this.prsKind(this.pos)
    }

    /// 当前 token 字面量。
    fun prsCurLit(): String {
        return this.prsLit(this.pos)
    }

    /// 当前 token 的源位置。
    fun prsCurSpan(): Span {
        val p = this.pos
        if (p >= this.n) {
            return Span(0, 0, 1, 1, 1, 1)
        }
        return Span(
            this.lx.spanFieldAt(p, 0), this.lx.spanFieldAt(p, 1),
            this.lx.spanFieldAt(p, 2), this.lx.spanFieldAt(p, 3),
            this.lx.spanFieldAt(p, 4), this.lx.spanFieldAt(p, 5)
        )
    }

    // ── 游标推进 ──

    /// 是否到达结尾（EOF）。
    fun prsAtEnd(): Boolean {
        return this.prsCurKind() == "EOF"
    }

    /// 当前是否匹配给定种类。
    fun prsCheck(k: String): Boolean {
        return this.prsCurKind() == k
    }

    /// 若匹配则消费并返回 true。
    fun prsMatch(k: String): Boolean {
        if (this.prsCheck(k)) {
            this.prsAdvance()
            return true
        }
        return false
    }

    /// 消费当前 token（越界时停在 EOF）。
    fun prsAdvance(): Int {
        val p: Int = this.pos
        if (this.pos < this.n - 1) {
            this.pos = this.pos + 1
        } else {
            this.pos = this.n - 1
        }
        return p
    }

    /// 当前 token 是否可作为「名字」使用。
    ///
    /// 词法器把 `value` / `data` / `it` 等**软关键字**也映射为独立 TokenKind
    /// （与 Rust `KEYWORDS` 一致，不可改词法），但它们完全可以当标识符使用
    /// （如 `val value: String`）。此处统一放行，避免 `期望 Ident，但遇到 Value`
    /// 这类误报与随后的反同步。
    fun prsIsNameToken(): Boolean {
        val k = this.prsCurKind()
        if (k == "Ident") {
            return true
        }
        // 注意：`val` / `var` **不在此列**。它们作为标识符使用
        // （`val val: Int = 5` 之后的 `toStr(-val)`）走的是
        // `parsePrimary` 末尾的「关键字字面量」兜底路径（与 Rust 侧
        // `advance().literal` 一致），无需在此额外放行。
        //
        // 历史上该兜底路径曾在自举产物中崩溃（`prsIsWordLiteral` 里
        // `strlen(-1)`），根因**不在词法/取值**，而是发射器的局部变量表
        // 不处理同名遮蔽：`parsePrimary` 里 StringLiteral 分支的
        // `val lit: Int` 与兜底分支的 `val lit: String` 共用了一个 i32 槽，
        // 使 i8* 被按 i32 读出并装箱成野指针。
        // 已在 `LlvmEmitter.declareVar` / `fvField` 修复（同名不同类型另开
        // 槽位 + 查找取最后一次声明）。
        return k == "Value" || k == "Data" || k == "Lazy" || k == "Lateinit"
            || k == "It" || k == "By" || k == "To" || k == "Box" || k == "Weak"
            || k == "Select" || k == "Async" || k == "Await" || k == "Comptime"
            || k == "Defer" || k == "Inline" || k == "Const" || k == "Extern"
    }

    /// 期望一个名字（标识符或软关键字）；不匹配则记录诊断（不消费）。
    fun prsExpectName(): Boolean {
        if (this.prsIsNameToken()) {
            this.prsAdvance()
            return true
        }
        this.errors.pushAt(
            severityError(),
            "期望 Ident，但遇到 " + this.prsCurKind(),
            this.prsCurSpan().start,
            this.prsCurSpan().end
        )
        return false
    }

    /// 期望参数名：标识符 / 软关键字，**或硬关键字**。
    ///
    /// 源码里存在 `fun mapConstKind(val: String)`（`val` 作参数名）这类写法，
    /// `prsExpectName` 会判定失败**且不消费令牌**，进而让整个签名反同步——
    /// 参数类型、返回类型、函数体全部错位（自举时 `mapConstKind` 被发成
    /// `void(..., i32)` 就是这么来的）。参数位置上只可能是名字，故除分隔符
    /// 与 EOF 外一律接受。
    fun prsExpectParamName(): Boolean {
        val k: String = this.prsCurKind()
        if (k == "Comma" || k == "RParen" || k == "Colon" || k == "EOF") {
            this.errors.pushAt(
                severityError(),
                "期望参数名，但遇到 " + k,
                this.prsCurSpan().start,
                this.prsCurSpan().end
            )
            return false
        }
        this.prsAdvance()
        return true
    }

    /// 期望声明名（`val`/`var` 声明、字段名等）：**接受硬关键字**。
    ///
    /// 与 [`prsExpectParamName`] 同理：声明名位置上只可能是名字，而源码里确有
    /// `val val: Int = …` 这类「关键字当变量名」的写法（Rust 侧解析器用
    /// `advance().literal` 直接取字面量，同样不排斥关键字）。
    /// 仅对分隔符 / 赋值等**确定不是名字**的 token 报错。
    fun prsExpectDeclName(): Boolean {
        val k: String = this.prsCurKind()
        if (k == "Comma" || k == "RParen" || k == "LBrace" || k == "Assign"
            || k == "EOF" || k == "Colon" || k == "Semicolon") {
            this.errors.pushAt(
                severityError(),
                "期望声明名，但遇到 " + k,
                this.prsCurSpan().start,
                this.prsCurSpan().end
            )
            return false
        }
        this.prsAdvance()
        return true
    }

    /// 消费一个类型名 token（标识符 / 软关键字 / 硬关键字）。
    ///
    /// 与 [`prsExpectName`] 的区别：后者只接受标识符与软关键字，遇到
    /// `Unit` 这类硬关键字会失败且**不消费**，使解析器反同步。
    /// 分隔符（`,` `)` `<` `{` …）与 EOF 视为失败且不消费。
    fun prsExpectTypeName(): Boolean {
        val k: String = this.prsCurKind()
        if (k == "Comma" || k == "RParen" || k == "Gt" || k == "LBrace" || k == "EOF"
            || k == "Colon" || k == "QuestionMark" || k == "RBracket" || k == "Semicolon") {
            return false
        }
        this.prsAdvance()
        return true
    }

    /// 期望当前为 k；不匹配则记录诊断（不消费，交由上层恢复）。
    fun prsExpect(k: String): Boolean {
        if (this.prsCheck(k)) {
            this.prsAdvance()
            return true
        }
        this.errors.pushAt(
            severityError(),
            "期望 " + k + "，但遇到 " + this.prsCurKind(),
            this.prsCurSpan().start,
            this.prsCurSpan().end
        )
        return false
    }

    // ── 顶层 ──

    /// 解析整个程序，返回 Program 节点 id（id 0）。
    fun parseProgram(): Int {
        var kids = noKids()
        while (!this.prsAtEnd()) {
            this.prsSkipDocs()
            // 语句分隔符 `;`：Rust 侧允许顶层出现，统一跳过
            while (this.prsCheck("Semicolon")) {
                this.prsAdvance()
            }
            if (!this.prsAtEnd()) {
                val d = this.parseTopLevel()
                kids = kidsAdd(kids, d)
            }
        }
        return this.ast.add("Program", "", "", this.prsCurSpan(), kids)
    }

    /// 跳过文档注释 token（`///` / `/**...*/`）。
    ///
    /// 词法器会为文档注释产出 `DocComment` token（不参与语法结构），
    /// 若不在语句入口统一跳过，会退化为大量 `意外的 token: DocComment`。
    fun prsSkipDocs() {
        while (this.prsCheck("DocComment")) {
            this.prsAdvance()
        }
    }

    /// 解析一个顶层声明或语句。
    fun parseTopLevel(): Int {
        val k = this.prsCurKind()
        if (k == "Package") {
            // package aura.lang.std
            this.prsAdvance()
            val text = this.prsCurLit()
            this.prsAdvance()
            return this.ast.add("Package", text, "", this.prsCurSpan(), noKids())
        }
        if (k == "Import") {
            return this.parseImport()
        }
        if (k == "Fun") {
            return this.parseFunction()
        }
        if (k == "At" || k == "Native" || k == "Export") {
            // @native(...) fun / native fun / export fun
            return this.parseNativeOrExportFunction()
        }
        if (k == "Val" || k == "Var") {
            return this.parseDecl(true)
        }
        if (k == "Const" && this.prsPeek(1) == "Val") {
            return this.parseDecl(true)
        }
        if (k == "Struct") {
            return this.parseTypeDecl("Struct")
        }
        if (k == "Class") {
            return this.parseTypeDecl("Class")
        }
        if (k == "Object") {
            return this.parseTypeDecl("Object")
        }
        if (k == "Extern") {
            // extern object Name { ... }（新语法）
            // extern interface Name { ... }（已废弃，自动转换）
            if (this.prsPeek(1) == "Object" || this.prsPeek(1) == "Interface") {
                return this.parseExternObject()
            }
            this.errors.pushAt(severityError(), "unexpected token: Extern", this.prsCurSpan().start, this.prsCurSpan().end)
            this.prsAdvance()
            return -1
        }
        if (k == "Enum") {
            return this.parseTypeDecl("Enum")
        }
        if (k == "Interface") {
            return this.parseTypeDecl("Interface")
        }
        // `actor Name { … }`：并发实体声明，词法器产出 `Actor` 关键字，
        // 语义上等价于类（并发由运行时 API 承担）。
        if (k == "Actor") {
            return this.parseTypeDecl("Class")
        }
        if (k == "Typealias") {
            return this.parseTypealias()
        }
        // 顶层语句（表达式 / 控制流等）
        return this.parseStatement()
    }

    // ── 声明 ──

    /// 解析 import 语句。
    /// `import a.b.C` / `import a.b.*` / `import a.b.{x, y}` / `import a.b.C as D`
    fun parseImport(): Int {
        this.prsAdvance() // Import
        var name: String = ""
        while (true) {
            name = name + this.prsCurLit()
            this.prsAdvance()
            if (this.prsCheck("Dot")) {
                name = name + "."
                this.prsAdvance()
                if (this.prsCheck("*")) {
                    name = name + "*"
                    this.prsAdvance()
                    break
                }
                if (this.prsCheck("LBrace")) {
                    name = name + "{"
                    this.prsAdvance()
                    while (!this.prsCheck("RBrace") && !this.prsAtEnd()) {
                        name = name + this.prsCurLit()
                        this.prsAdvance()
                        if (this.prsCheck("Comma")) {
                            name = name + ","
                            this.prsAdvance()
                        }
                    }
                    this.prsExpect("RBrace")
                    name = name + "}"
                    break
                }
                continue
            }
            break
        }
        // 别名导入 `import a.b.C as D`。词法器把 `as` 归类为 **`As`**（非字面量
        // `"as"`），旧实现用 `prsCheck("as")` 恒为假 → `as D` 不被消费，
        // 顶层随后把 `as` 当语句解析并反同步（编译期崩溃）。
        if (this.prsCheck("As")) {
            this.prsAdvance()
            name = name + " as " + this.prsCurLit()
            this.prsAdvance()
        }
        return this.ast.leaf("Import", name, this.prsCurSpan())
    }

    /// 解析函数声明。
    /// `fun name(params): RetType { body }` 或 `fun name(params): RetType = expr`
    fun parseFunction(): Int {
        this.prsAdvance() // Fun
        // 泛型类型参数 `<T>` / `<T: Comparable<T>>`：整体跳过。
        // 不跳过时 `prsCurLit()` 会取到 `<`（非法名字），`prsExpectName` 又**不消费**
        // 令牌 → 函数名退化为 `_`（sanitizeLlvm("<")），且整段参数/体全部错位。
        if (this.prsCheck("Lt")) {
            var depth: Int = 0
            while (!this.prsAtEnd()) {
                val gk: String = this.prsCurKind()
                if (gk == "Lt") {
                    depth = depth + 1
                } else if (gk == "Gt") {
                    depth = depth - 1
                } else if (gk == "GtGt") {
                    // `>>` 被词法器合并成**单个** token（`<T: Comparable<T>>`）：
                    // 按 2 层扣减，否则会一直找不到 `>` 而吞掉整段源码。
                    depth = depth - 2
                } else if (gk == "GtGtGt") {
                    depth = depth - 3
                }
                if (depth <= 0 && (gk == "Gt" || gk == "GtGt" || gk == "GtGtGt")) {
                    this.prsAdvance()
                    break
                }
                this.prsAdvance()
            }
        }
        val name: String = this.prsCurLit()
        this.prsExpectName()

        this.prsExpect("LParen")
        var params = noKids()
        if (!this.prsCheck("RParen")) {
            while (true) {
                var pname: String = this.prsCurLit()
                // `vararg` 是软关键字（词法器产出的仍是 Ident）：`vararg nums: Int`。
                // 不跳过会把 `vararg` 当作参数名，真正的参数名 `nums` 无处安放，
                // 整个参数列表反同步（`fun f(vararg xs: Int)` 声明被吞掉 → 崩）。
                if (pname == "vararg" && this.prsKind(this.pos + 1) == "Ident") {
                    this.prsAdvance()
                    pname = this.prsCurLit()
                }
                this.prsExpectParamName()
                var pty: String = ""
                if (this.prsMatch("Colon")) {
                    pty = this.parseTypeName()
                }
                // 默认参数值 `name: Type = expr`：作为 Param 的子节点保存，
                // 调用点实参不足时由发射器补齐。不解析会让 `=` 处的参数列表
                // 反同步（`fun greet(a: String = "x")` 整段声明被吞掉）。
                var pdef = noKids()
                if (this.prsMatch("Assign")) {
                    pdef = kidsAdd(noKids(), this.parseExpr())
                }
                params = kidsAdd(params, this.ast.add("Param", pname, pty, this.prsCurSpan(), pdef))
                if (!this.prsMatch("Comma")) {
                    break
                }
            }
        }
        this.prsExpect("RParen")

        var retTy: String = ""
        if (this.prsMatch("Colon")) {
            retTy = this.parseTypeName()
        }

        var bodyKids = noKids()
        if (this.prsCheck("LBrace")) {
            bodyKids = kidsAdd(bodyKids, this.parseBlock())
        } else if (this.prsMatch("Assign")) {
            bodyKids = kidsAdd(bodyKids, this.parseExpr())
        }

        val paramsNode = this.ast.add("Params", "", "", this.prsCurSpan(), params)
        var bodyNode: Int = -1
        if (kidsCount(bodyKids) > 0) {
            bodyNode = kidsAt(bodyKids, 0)
        }
        var kids = kidsAdd(noKids(), paramsNode)
        if (bodyNode >= 0) {
            kids = kidsAdd(kids, bodyNode)
        }
        return this.ast.add("Function", name, retTy, this.prsCurSpan(), kids)
    }

    /// 解析 val / var / const val 声明（顶层或语句内）。
    fun parseDecl(topLevel: Boolean): Int {
        val k = this.prsCurKind() // Val / Var / Const
        // const 修饰符：const val NAME = ...
        if (k == "Const") {
            this.prsAdvance() // Const
            if (this.prsCheck("Val")) {
                this.prsAdvance() // Val
            } else {
                this.errors.pushAt(severityError(), "const 修饰符必须后跟 val", this.prsCurSpan().start, this.prsCurSpan().end)
            }
        } else {
            this.prsAdvance()
        }
        val nodeKindD: String = if (k == "Val") { "ValDecl" } else { "VarDecl" }
        // 解构声明 `val (a, b) = expr`：名字位置是括号列表。
        // 不识别会让 `prsExpectDeclName` 取到 `(`，整条声明反同步（编译期崩溃）。
        // 降级为块：先把右值绑定到临时名，再按位 `getAt(tmp, i)` 取出各分量
        // （`to` / `Pair` 在 AOT 下是 2 元素 `AuraDynList`，与 C 侧 `pairOf` 一致）。
        // 名字用 CSV 串累积（不用 `List`：AOT 下 List 索引会生成野指针）。
        if (this.prsCheck("LParen")) {
            val dSp: Span = this.prsCurSpan()
            this.prsAdvance() // (
            var namesCsv: String = ""
            while (!this.prsCheck("RParen") && !this.prsAtEnd()) {
                if (ParserUtils.prsIsWordLiteral(this.prsCurLit())) {
                    if (namesCsv != "") {
                        namesCsv = namesCsv + ","
                    }
                    namesCsv = namesCsv + this.prsCurLit()
                }
                this.prsAdvance()
            }
            this.prsExpect("RParen")
            var dInit: Int = -1
            if (this.prsMatch("Assign")) {
                dInit = this.parseExpr()
            }
            val nNames: Int = aotCsvCount(namesCsv)
            val n0: String = aotFieldAt(namesCsv, 0, ",")
            // 单个名字：直接绑定整个右值
            if (nNames <= 1) {
                if (dInit < 0) {
                    return this.ast.add(nodeKindD, n0, "", dSp, noKids())
                }
                return this.ast.add(nodeKindD, n0, "", dSp, kidsAdd(noKids(), dInit))
            }
            // 多个名字：`val __destr = expr` + `val a = __destr.getAt(0)` …
            val tmpName: String = "__destr"
            var dkids: String = noKids()
            if (dInit >= 0) {
                dkids = kidsAdd(dkids,
                    this.ast.add(nodeKindD, tmpName, "", dSp, kidsAdd(noKids(), dInit)))
            }
            var di: Int = 0
            while (di < nNames) {
                val recv = this.ast.leaf("Ident", tmpName, dSp)
                // 用限定名作 callee（`Collections.getAt`）：HIR 对 `obj.getAt(i)`
                // 形态会把 Member 本身当成 kids[0] 降级（求值得 0），故直接用
                // 限定名调用形式，实参只有 [接收者, 下标]。
                val callee = this.ast.leaf("Ident", "Collections.getAt", dSp)
                val idxLit = this.ast.leaf("IntLiteral", toStr(di), dSp)
                val callNode = this.ast.add("Call", "", "", dSp,
                    kidsAdd(kidsAdd(kidsAdd(noKids(), callee), recv), idxLit))
                dkids = kidsAdd(dkids,
                    this.ast.add(nodeKindD, aotFieldAt(namesCsv, di, ","), "", dSp,
                        kidsAdd(noKids(), callNode)))
                di = di + 1
            }
            return this.ast.add("Block", "", "", dSp, dkids)
        }
        val name: String = this.prsCurLit()
        // 声明名位置只可能是名字：源码里存在 `val val: Int = …`（`val` 作变量名），
        // 用 prsExpectName 会失败且**不消费令牌**，导致 `:` / `=` 全部错位、
        // 整段反同步（Fold.aura / MirOpt.aura / vm/* 实测如此）。
        this.prsExpectDeclName()
        var ty: String = ""
        if (this.prsMatch("Colon")) {
            ty = this.parseTypeName()
        }
        var kids = noKids()
        if (this.prsMatch("Assign")) {
            kids = kidsAdd(kids, this.parseExpr())
        }
        val nodeKind = if (k == "Val") { "ValDecl" } else { "VarDecl" }
        return this.ast.add(nodeKind, name, ty, this.prsCurSpan(), kids)
    }

    /// 解析类型声明（struct / class / object / enum / interface）。
    ///
    /// 成员以 Block 形式暂存（Phase 2 再细化字段/方法）；
    /// 主构造函数参数（`class Point(val x: Int, val y: Int)`）被降级为
    /// 类体开头的 ValDecl/VarDecl 字段，使「按位置构造」与字段布局一致。
    fun parseTypeDecl(kindName: String): Int {
        this.prsAdvance()
        val name: String = this.prsCurLit()
        this.prsExpectName()
        // 泛型参数 <T> 可选
        if (this.prsCheck("Lt")) {
            while (!this.prsCheck("Gt") && !this.prsAtEnd()) {
                this.prsAdvance()
            }
            this.prsExpect("Gt")
        }
        // 主构造函数参数（可选）
        var ctorFields = noKids()
        if (this.prsCheck("LParen")) {
            ctorFields = this.parseCtorParams()
        }
        // 可选父类 / 接口（`: Base, Iface`）
        //
        // 首个名字（`class Dog : Animal()` → `Animal`）记入节点 ty 列：
        // `super.m()` 需要它解析到父类实现，继承来的方法也要沿父链回退查找。
        // 此前整段被丢弃，`super.name()` 只好解析到自身 → 无限递归 → 栈溢出。
        var parentName: String = ""
        if (this.prsMatch("Colon")) {
            if (ParserUtils.prsIsWordLiteral(this.prsCurLit())) {
                parentName = this.prsCurLit()
            }
            while (!this.prsCheck("LBrace") && !this.prsCheck("Semicolon") && !this.prsAtEnd()) {
                this.prsAdvance()
            }
        }
        var kids = noKids()
        // 枚举体：`RED, GREEN, BLUE` / 带数据变体 `Circle(Double)`。
        // 不能走通用 parseBlock —— 逗号分隔的变体列表会让语句解析在 `,` 处反同步
        // （超过一个变体即触发编译器崩溃）。此处按「变体列表」单独解析，
        // 每个变体降级为 `ExprStmt(Ident(name))`（与单变体时的通用路径一致）。
        if (kindName == "Enum" && this.prsCheck("LBrace")) {
            this.prsAdvance() // {
            var vkids = noKids()
            while (!this.prsCheck("RBrace") && !this.prsAtEnd()) {
                val vLit: String = this.prsCurLit()
                if (ParserUtils.prsIsWordLiteral(vLit)) {
                    val vSp: Span = this.prsCurSpan()
                    this.prsAdvance()
                    // 带数据变体：消费 `( … )` 载荷（AOT 下枚举按整型常量处理）
                    if (this.prsCheck("LParen")) {
                        var depth: Int = 0
                        while (!this.prsAtEnd()) {
                            val kk: String = this.prsCurKind()
                            if (kk == "LParen") {
                                depth = depth + 1
                            }
                            if (kk == "RParen") {
                                depth = depth - 1
                                this.prsAdvance()
                                if (depth <= 0) {
                                    break
                                }
                                continue
                            }
                            this.prsAdvance()
                        }
                    }
                    val vIdent = this.ast.leaf("Ident", vLit, vSp)
                    val vStmt = this.ast.add("ExprStmt", "", "", vSp,
                        kidsAdd(noKids(), vIdent))
                    vkids = kidsAdd(vkids, vStmt)
                } else {
                    // 注解 / 文档等：跳过，避免死循环
                    this.prsAdvance()
                }
                if (!this.prsMatch("Comma")) {
                    // 变体间可省略逗号（换行分隔）
                }
            }
            this.prsExpect("RBrace")
            if (vkids != "") {
                val mergedEnum = this.ast.add("Block", "", "", this.prsCurSpan(), vkids)
                kids = kidsAdd(kids, mergedEnum)
            }
            return this.ast.add(kindName, name, parentName, this.prsCurSpan(), kids)
        }
        if (this.prsCheck("LBrace")) {
            val bodyId = this.parseBlock()
            val bodyKids: String = this.ast.kidsOf(bodyId)
            var combined: String = ctorFields
            if (bodyKids != "") {
                if (combined == "") {
                    combined = bodyKids
                } else {
                    combined = combined + "," + bodyKids
                }
            }
            if (combined != "") {
                val merged = this.ast.add("Block", "", "", this.ast.spanOf(bodyId), combined)
                kids = kidsAdd(kids, merged)
            }
        } else if (ctorFields != "") {
            val merged = this.ast.add("Block", "", "", this.prsCurSpan(), ctorFields)
            kids = kidsAdd(kids, merged)
        }
        return this.ast.add(kindName, name, parentName, this.prsCurSpan(), kids)
    }

    /// 解析 extern object 声明：`extern object Name { ... }`
    /// 兼容旧语法：`extern interface Name { ... }`（已废弃）
    ///
    /// 名字还允许是**字符串库名**：`extern interface "runtime" { fun f() }`
    /// （常量/运行时符号分组，与 Rust 解析器 `self.advance().literal` 对齐）。
    /// 字符串形式此前被 `prsExpectName` 拒绝且**不消费令牌**，导致整条声明
    /// 反同步：成员被当顶层无体函数解析，发射器为它们发成「返回默认值的
    /// `define`」stub，与运行库预置的 `@aura_process_argCount` 定义重复 →
    /// llc 报 `invalid redefinition of function 'aura_process_argCount'`，
    /// 自举产物整个模块编译失败。
    fun parseExternObject(): Int {
        this.prsAdvance() // Extern
        // 接受 "Object"（新语法）或 "Interface"（已废弃）
        if (this.prsCheck("Object") || this.prsCheck("Interface")) {
            this.prsAdvance()
        } else {
            this.prsExpect("Object")
        }
        val name: String = this.prsCurLit()
        if (this.prsCheck("StringLiteral")) {
            this.prsAdvance() // 字符串库名（字面量已由 prsCurLit 取得）
        } else {
            this.prsExpectName()
        }
        
        var kids = noKids()
        if (this.prsCheck("LBrace")) {
            val bodyId = this.parseBlock()
            val bodyKids: String = this.ast.kidsOf(bodyId)
            if (bodyKids != "") {
                val merged = this.ast.add("Block", "", "", this.ast.spanOf(bodyId), bodyKids)
                kids = kidsAdd(kids, merged)
            }
        }
        return this.ast.add("ExternObject", name, "", this.prsCurSpan(), kids)
    }

    /// 解析带关键字的函数：`@native(...) fun` / `native fun` / `export fun`
    fun parseNativeOrExportFunction(): Int {
        val keyword = this.prsCurKind()
        
        if (keyword == "At") {
            // @native(...) fun - 系统调用或内联汇编
            // @aot fun - AOT 库函数
            //
            // 注意：`aot` **不是**关键字（词法器无 `Aot` 种类，与 Rust 侧一致），
            // 它是普通标识符，故必须比对字面量而非 token 种类——旧实现只比对
            // `prsPeek(1) == "Aot"`（恒为 `false`），`@aot` 会被误送进
            // `parseAnnotatedNativeFunction` → `prsExpect("Native")` 失败并反同步。
            if (this.prsPeek(1) == "Aot" || this.prsLit(this.pos + 1) == "aot") {
                return this.parseAotFunction()
            }
            return this.parseAnnotatedNativeFunction()
        } else if (keyword == "Native") {
            // native fun - 编译器内置（无参数）
            return this.parseBuiltinNativeFunction()
        } else if (keyword == "Export") {
            // export fun - 导出符号
            this.prsAdvance() // export
            val funcId = this.parseFunction()
            var kids = noKids()
            if (funcId >= 0) {
                kids = kidsAdd(kids, funcId)
            }
            return this.ast.add("ExportMethod", "", "", this.prsCurSpan(), kids)
        }
        
        // 未知关键字
        this.errors.pushAt(severityError(), "Unknown native/export/aot function", this.prsCurSpan().start, this.prsCurSpan().end)
        this.prsAdvance()
        return -1
    }

    /// 解析 @aot fun - AOT 库函数（JitValue ABI 直调）
    fun parseAotFunction(): Int {
        this.prsAdvance() // @
        this.prsAdvance() // aot
        
        // 解析函数
        val funcId = this.parseFunction()
        
        // 创建 AotMethod 节点
        var kids = noKids()
        kids = kidsAdd(kids, this.ast.leaf("AotInfo", "aot", this.prsCurSpan()))
        if (funcId >= 0) {
            kids = kidsAdd(kids, funcId)
        }
        return this.ast.add("AotMethod", "", "", this.prsCurSpan(), kids)
    }

    /// 解析 @native(...) fun - 系统调用或内联汇编
    fun parseAnnotatedNativeFunction(): Int {
        this.prsAdvance() // @
        this.prsExpect("Native") // native
        
        var metadata: String = "native"
        
        // 解析括号内的参数
        if (this.prsCheck("LParen")) {
            this.prsAdvance() // (
            
            // 检查是 asm 还是 syscall 号
            if (this.prsCheck("Ident") && this.prsCurLit() == "asm") {
                // 内联汇编：@native(asm = "rdtsc")
                this.prsAdvance() // asm
                this.prsExpect("Assign") // =
                val code: String = this.prsCurLit()
                this.prsAdvance() // string literal
                metadata = "asm|" + code
            } else {
                // 系统调用号：@native(SYS_READ)
                val sysName: String = this.prsCurLit()
                this.prsAdvance()
                metadata = "native|" + sysName
            }
            
            this.prsExpect("RParen") // )
        }
        
        // 解析函数
        val funcId = this.parseFunction()
        
        // 创建 NativeMethod 节点
        var kids = noKids()
        kids = kidsAdd(kids, this.ast.leaf("NativeInfo", metadata, this.prsCurSpan()))
        if (funcId >= 0) {
            kids = kidsAdd(kids, funcId)
        }
        return this.ast.add("NativeMethod", "", "", this.prsCurSpan(), kids)
    }

    /// 解析 native fun - 编译器内置（无参数）
    fun parseBuiltinNativeFunction(): Int {
        this.prsAdvance() // native
        
        // 解析函数
        val funcId = this.parseFunction()
        
        // 创建 NativeMethod 节点（metadata 为 "native"）
        var kids = noKids()
        kids = kidsAdd(kids, this.ast.leaf("NativeInfo", "native", this.prsCurSpan()))
        if (funcId >= 0) {
            kids = kidsAdd(kids, funcId)
        }
        return this.ast.add("NativeMethod", "", "", this.prsCurSpan(), kids)
    }

    /// 根据 annotation metadata 分类 AST 节点类型
    fun classifyAnnotation(annotation: String): String {
        if (annotation.startsWith("native|")) {
            return "NativeMethod"
        } else if (annotation.startsWith("asm|")) {
            return "NativeMethod"
        } else if (annotation == "export") {
            return "ExportMethod"
        }
        return "Function"
    }

    /// 解析主构造函数参数：`(val a: T, var b: T = init, c: T)`。
    ///
    /// 每个参数降级为一个字段声明节点（`val`/`var` 关键字缺省按 `val` 处理），
    /// 返回这些节点组成的 kids 串。
    fun parseCtorParams(): String {
        this.prsExpect("LParen")
        var fields = noKids()
        if (!this.prsCheck("RParen")) {
            while (true) {
                var isVal: Boolean = true
                if (this.prsCheck("Val")) {
                    this.prsAdvance()
                    isVal = true
                } else if (this.prsCheck("Var")) {
                    this.prsAdvance()
                    isVal = false
                }
                val pname: String = this.prsCurLit()
                this.prsExpectName()
                var pty: String = ""
                if (this.prsMatch("Colon")) {
                    pty = this.parseTypeName()
                }
                var fkids = noKids()
                if (this.prsMatch("Assign")) {
                    fkids = kidsAdd(fkids, this.parseExpr())
                }
                var fkind: String = "ValDecl"
                if (!isVal) {
                    fkind = "VarDecl"
                }
                fields = kidsAdd(fields,
                    this.ast.add(fkind, pname, pty, this.prsCurSpan(), fkids))
                if (!this.prsMatch("Comma")) {
                    break
                }
            }
        }
        this.prsExpect("RParen")
        return fields
    }

    /// 解析 `typealias Name = Type`。
    fun parseTypealias(): Int {
        this.prsAdvance() // Typealias
        val name: String = this.prsCurLit()
        this.prsExpectName()
        var aliased: String = ""
        if (this.prsMatch("Assign")) {
            aliased = this.parseTypeName()
        }
        return this.ast.leaf("Typealias", name + " = " + aliased, this.prsCurSpan())
    }

    /// 解析类型名（含可选泛型参数 `<...>` 与函数类型 `(A, B) -> C`）。
    fun parseTypeName(): String {
        // 函数类型 `(Int) -> Int` / `(Int, String) -> Boolean`：此前完全不支持，
        // `(` 被当作类型名起点、`Int` 留在原地 → 整条声明反同步（`val f: (Int) -> Int`
        // 直接让自举编译器段错误）。
        if (this.prsCheck("LParen")) {
            this.prsAdvance()
            var inner: String = "("
            var firstP: Boolean = true
            while (!this.prsCheck("RParen") && !this.prsAtEnd()) {
                if (!firstP) {
                    inner = inner + ", "
                }
                inner = inner + this.parseTypeName()
                firstP = false
                if (!this.prsMatch("Comma")) {
                    break
                }
            }
            this.prsExpect("RParen")
            var fnTy: String = inner + ")"
            if (this.prsCheck("Arrow")) {
                this.prsAdvance()
                fnTy = fnTy + " -> " + this.parseTypeName()
            }
            fnTy = this.parseTypeSuffix(fnTy)
            return fnTy
        }
        var name: String = this.prsCurLit()
        // 类型名位置按「标识符 / 软关键字 / 硬关键字」一律接受：
        // `Unit` 在关键字表里是**硬关键字**（`unit|Unit`），而 `Int`/`String`
        // 是 `Ident`。用 `prsExpectName` 会判定失败**且不消费 token**，
        // 导致 `fun f(): Unit { ... }` 的整个函数体被跳过（HIR 里 HirFunction
        // 无 kids，生成 `define void @f() { ret void }`）。
        this.prsExpectTypeName()
        if (this.prsCheck("Lt")) {
            name = name + "<"
            this.prsAdvance()
            // 泛型实参需**按深度配平**扫描：词法器把 `>>` / `>>>` 合并成单个
            // token（`GtGt` / `GtGtGt`），旧实现只认单独的 `Gt`，于是
            // `ArrayList<ArrayList<K>>` 永远等不到闭合 `>` —— 循环一路吞掉
            // 后续所有 token 当作类型文本，产出形如
            // `ArrayList_ArrayList_K___bucketKeys_…` 的巨型垃圾类型名，
            // 最终 llc 报 `use of undefined type named 'struct.HashMap_…'`。
            var dep: Int = 1
            while (dep > 0 && !this.prsAtEnd()) {
                val tk: String = this.prsCurKind()
                if (tk == "Lt") {
                    dep = dep + 1
                    name = name + "<"
                } else if (tk == "Gt") {
                    dep = dep - 1
                    if (dep > 0) {
                        name = name + ">"
                    }
                } else if (tk == "GtGt") {
                    dep = dep - 2
                    if (dep > 0) {
                        name = name + ">>"
                    }
                } else if (tk == "GtGtGt") {
                    dep = dep - 3
                    if (dep > 0) {
                        name = name + ">>>"
                    }
                } else {
                    name = name + this.prsCurLit()
                }
                this.prsAdvance()
            }
            name = name + ">"
        }
        return this.parseTypeSuffix(name)
    }

    /// 类型名后缀：`?`（可空）与 `[N]`（定长数组）。
    fun parseTypeSuffix(base: String): String {
        var name: String = base
        // 后缀 `?`（可空类型）
        if (this.prsCheck("QuestionMark")) {
            name = name + "?"
            this.prsAdvance()
        }
        // 后缀 `[N]`（定长数组，可叠加多维：`Int[6]`、`Int[2][3]`）
        while (this.prsCheck("LBracket")) {
            this.prsAdvance()
            var dim: String = ""
            while (!this.prsCheck("RBracket") && !this.prsAtEnd()) {
                dim = dim + this.prsCurLit()
                this.prsAdvance()
            }
            this.prsExpect("RBracket")
            name = name + "[" + dim + "]"
        }
        return name
    }

    // ── 语句 ──

    /// 解析语句。
    fun parseStatement(): Int {
        val k = this.prsCurKind()
        if (k == "Val" || k == "Var") {
            return this.parseDecl(false)
        }
        if (k == "Const" && this.prsPeek(1) == "Val") {
            return this.parseDecl(false)
        }
        // 可见性修饰符（`private fun visit(...)` / `public val` …）：
        // Aura 侧不建模可见性，直接跳过修饰符再解析后续声明
        if (k == "Private" || k == "Protected" || k == "Public") {
            this.prsAdvance()
            return this.parseStatement()
        }
        // 软关键字修饰符：**仅当后一个 token 是声明起始**时才跳过。
        // 否则 `value` / `data` 等作普通标识符使用会被误吞
        // （实测 `value = v`（类内裸字段赋值）整条语句反同步并让编译器崩溃）。
        if (k == "Suspend" || k == "Override" || k == "Inline" || k == "Lateinit"
            || k == "Data" || k == "Sealed" || k == "Value"
            || k == "Abstract" || k == "Open" || k == "Comptime" || k == "Extern") {
            val nkMod: String = this.prsKind(this.pos + 1)
            if (nkMod == "Fun" || nkMod == "Val" || nkMod == "Var"
                || nkMod == "Class" || nkMod == "Struct" || nkMod == "Object"
                || nkMod == "Enum" || nkMod == "Interface"
                // 修饰符链：`value data class Money` / `sealed value class P`
                || nkMod == "Data" || nkMod == "Sealed" || nkMod == "Value"
                || nkMod == "Suspend" || nkMod == "Override" || nkMod == "Inline"
                || nkMod == "Lateinit" || nkMod == "Const") {
                this.prsAdvance()
                return this.parseStatement()
            }
        }
        // 软关键字修饰符：`tailrec fun` / `operator fun` / `infix fun` /
        // `abstract fun` / `open fun` / `lateinit var` …（词法器产出 Ident）。
        // 不跳过会把修饰符当作函数名，整条声明反同步。
        if (k == "Ident") {
            val modw: String = this.prsCurLit()
            // `companion object { … }`（伴生对象）：`companion` 是普通标识符。
            // 不跳过会被当作表达式语句，整个类体反同步并崩溃。
            if (modw == "companion" && this.prsKind(this.pos + 1) == "Object") {
                this.prsAdvance()
                return this.parseStatement()
            }
            if (modw == "tailrec" || modw == "operator" || modw == "infix"
                || modw == "abstract" || modw == "open") {
                val nk: String = this.prsKind(this.pos + 1)
                if (nk == "Fun" || nk == "Val" || nk == "Var") {
                    this.prsAdvance()
                    return this.parseStatement()
                }
            }
        }
        // 声明类语句（类体成员 / 嵌套声明）：此前这些 token 落到表达式分支，
        // 产生「意外的 token: Fun」并使整个类体反同步。
        if (k == "At" || k == "Native" || k == "Export") {
            // @native(...) fun / native fun / export fun / @aot fun
            return this.parseNativeOrExportFunction()
        }
        if (k == "Fun") {
            return this.parseFunction()
        }
        // 嵌套 `actor Name { … }`（词法器产出 `Actor` 关键字）
        if (k == "Actor") {
            return this.parseTypeDecl("Class")
        }
        // 构造函数：`init { ... }` / `init(source: String) { ... }`
        // （`init` 是普通标识符，需看下一个 token 是 `{` 还是 `(`）。
        // 降级为名为 `init` 的 `Function` 节点（HIR 侧合成 `<Class>.init`）。
        if (k == "Ident"
            && (this.prsCurLit() == "init" || this.prsCurLit() == "constructor")
            && (this.prsKind(this.pos + 1) == "LBrace"
                || this.prsKind(this.pos + 1) == "LParen")) {
            this.prsAdvance() // init
            var params = noKids()
            if (this.prsCheck("LParen")) {
                this.prsAdvance()
                if (!this.prsCheck("RParen")) {
                    while (true) {
                        val pname: String = this.prsCurLit()
                        this.prsExpectParamName()
                        var pty: String = ""
                        if (this.prsMatch("Colon")) {
                            pty = this.parseTypeName()
                        }
                        params = kidsAdd(params,
                            this.ast.add("Param", pname, pty, this.prsCurSpan(), noKids()))
                        if (!this.prsMatch("Comma")) {
                            break
                        }
                    }
                }
                this.prsExpect("RParen")
            }
            var bodyKids = noKids()
            if (this.prsCheck("LBrace")) {
                bodyKids = kidsAdd(bodyKids, this.parseBlock())
            }
            val paramsNode = this.ast.add("Params", "", "", this.prsCurSpan(), params)
            var ctorKids = kidsAdd(noKids(), paramsNode)
            if (kidsCount(bodyKids) > 0) {
                ctorKids = kidsAdd(ctorKids, kidsAt(bodyKids, 0))
            }
            return this.ast.add("Function", "init", "", this.prsCurSpan(), ctorKids)
        }
        if (k == "Class" || k == "Struct" || k == "Object" || k == "Enum"
            || k == "Interface") {
            return this.parseTypeDecl(k)
        }
        if (k == "Typealias") {
            return this.parseTypealias()
        }
        if (k == "Import") {
            return this.parseImport()
        }
        // 保险：文档注释（正常由 parseBlock / parseProgram 跳过）
        if (k == "DocComment") {
            this.prsAdvance()
            return this.ast.leaf("Empty", "", this.prsCurSpan())
        }
        if (k == "Return") {
            return this.parseReturn()
        }
        if (k == "If") {
            return this.parseIf()
        }
        if (k == "While") {
            return this.parseWhile()
        }
        if (k == "Do") {
            return this.parseDoWhile()
        }
        if (k == "For") {
            return this.parseFor()
        }
        if (k == "Try") {
            return this.parseTry()
        }
        if (k == "Break") {
            this.prsAdvance()
            return this.ast.leaf("Break", "", this.prsCurSpan())
        }
        if (k == "Continue") {
            this.prsAdvance()
            return this.ast.leaf("Continue", "", this.prsCurSpan())
        }
        if (k == "LBrace") {
            return this.parseBlock()
        }
        // 前缀自增/自减 `++x` / `--x` → `x = x + 1` / `x = x - 1`
        if (k == "DoublePlus" || k == "DoubleMinus") {
            this.prsAdvance()
            val operand: Int = this.parseUnary()
            val one: Int = this.ast.leaf("IntLiteral", "1", this.ast.spanOf(operand))
            var bop: String = "Plus"
            if (k == "DoubleMinus") {
                bop = "Minus"
            }
            val incBin: Int = this.ast.add(
                "Binary",
                bop,
                "",
                this.ast.spanOf(operand),
                kidsAdd(kidsAdd(noKids(), operand), one)
            )
            return this.ast.add(
                "Assign",
                "",
                "",
                this.ast.spanOf(operand),
                kidsAdd(kidsAdd(noKids(), operand), incBin)
            )
        }
        // 表达式语句（可能带赋值 / 复合赋值）
        val e = this.parseExpr()
        val opK: String = this.prsCurKind()
        if (opK == "Assign") {
            this.prsAdvance()
            val v = this.parseExpr()
            return this.parseAssignChain(e, v, this.ast.spanOf(e))
        }
        if (opK == "PlusEq" || opK == "MinusEq" || opK == "StarEq"
            || opK == "SlashEq" || opK == "PercentEq") {
            this.prsAdvance()
            val v2: Int = this.parseExpr()
            val cmpBin: Int = this.ast.add(
                "Binary",
                ParserUtils.compoundAssignOp(opK),
                "",
                this.ast.spanOf(e),
                kidsAdd(kidsAdd(noKids(), e), v2)
            )
            return this.ast.add(
                "Assign",
                "",
                "",
                this.ast.spanOf(e),
                kidsAdd(kidsAdd(noKids(), e), cmpBin)
            )
        }
        return this.ast.add("ExprStmt", "", "", this.prsCurSpan(), kidsAdd(noKids(), e))
    }

    /// 解析（右结合）赋值，`t0 = v0 [= v1 [= ...]]`。
    ///
    /// 链式赋值 `a = b = c` 脱糖为语句块 `{ b = c; a = b }`（自右向左执行）；
    /// 单次赋值直接返回 `Assign` 节点。
    fun parseAssignChain(t0: Int, v0: Int, sp0: Span): Int {
        var targets: String = kidsAdd(kidsAdd(noKids(), t0), v0)
        var sp: Span = sp0
        while (this.prsCurKind() == "Assign") {
            this.prsAdvance()
            val t: Int = this.parseExpr()
            targets = kidsAdd(targets, t)
            sp = ParserUtils.mergeSpan(sp, this.ast.spanOf(t))
        }
        val n: Int = kidsCount(targets)
        var stmts: String = noKids()
        var i: Int = n - 1
        while (i >= 1) {
            val tgt: Int = kidsAt(targets, i - 1)
            val valId: Int = kidsAt(targets, i)
            stmts = kidsAdd(
                stmts,
                this.ast.add(
                    "Assign",
                    "",
                    "",
                    this.ast.spanOf(tgt),
                    kidsAdd(kidsAdd(noKids(), tgt), valId)
                )
            )
            i = i - 1
        }
        if (kidsCount(stmts) == 1) {
            return kidsAt(stmts, 0)
        }
        return this.ast.add("Block", "", "", sp, stmts)
    }

    /// 解析语句块 `{ ... }`。
    fun parseBlock(): Int {
        this.prsExpect("LBrace")
        var kids = noKids()
        while (!this.prsCheck("RBrace") && !this.prsAtEnd()) {
            // 跳过文档注释后再判断是否已到块尾，避免把 `}` 当作语句吃掉
            this.prsSkipDocs()
            // 语句分隔符 `;`（可选）：Rust 侧允许 `a; b; c` 单行多语句，
            // 此前未跳过 → 每个 `;` 都产生「意外的 token: Semicolon」诊断，
            // 并使后续语句反同步。
            while (this.prsCheck("Semicolon")) {
                this.prsAdvance()
            }
            if (!this.prsCheck("RBrace") && !this.prsAtEnd()) {
                kids = kidsAdd(kids, this.parseStatement())
            }
        }
        this.prsExpect("RBrace")
        return this.ast.add("Block", "", "", this.prsCurSpan(), kids)
    }

    /// 解析 return 语句。
    fun parseReturn(): Int {
        this.prsAdvance()
        if (this.prsCheck("LBrace") || this.prsCheck("Semicolon") || this.prsCheck("RBrace") || this.prsAtEnd()) {
            return this.ast.leaf("Return", "", this.prsCurSpan())
        }
        val e = this.parseExpr()
        return this.ast.add("Return", "", "", this.prsCurSpan(), kidsAdd(noKids(), e))
    }

    /// 解析 if / else（语句或表达式形式）。
    fun parseIf(): Int {
        this.prsAdvance() // If
        var cond: Int
        if (this.prsCheck("LParen")) {
            this.prsAdvance()
            cond = this.parseExpr()
            this.prsExpect("RParen")
        } else {
            cond = this.parseExpr()
        }
        val thenB = this.parseBranch()
        var kids = kidsAdd(kidsAdd(noKids(), cond), thenB)
        if (this.prsCheck("Else")) {
            this.prsAdvance()
            var elseB: Int
            if (this.prsCheck("If")) {
                elseB = this.parseIf() // else if
            } else {
                elseB = this.parseBranch()
            }
            kids = kidsAdd(kids, elseB)
        }
        return this.ast.add("If", "", "", this.prsCurSpan(), kids)
    }

    /// then / else 分支：块或**单条语句**。
    ///
    /// 必须走 `parseStatement`（而非 `parseExpr`）：无花括号的分支可能是赋值
    /// （`if (c) x = y` / `else if (c) x = y`），而 `parseExpr` 不消费 `=` ——
    /// 会报「意外的 token: Assign」，并使整条 if/else if 链反同步
    /// （实测 Fold.aura 因此产生 55 条诊断、类体断链）。
    fun parseBranch(): Int {
        if (this.prsCheck("LBrace")) {
            return this.parseBlock()
        }
        return this.parseStatement()
    }

    /// 解析 do-while 循环：`do { body } while (cond)`。
    ///
    /// 语义等价于「先执行一次 body，再 `while (cond) { body }`」，故降级为
    /// `Block([body, While(cond, body)])`（body 节点被复用/复制两次）。
    fun parseDoWhile(): Int {
        val sp: Span = this.prsCurSpan()
        this.prsAdvance() // Do
        val body: Int = this.parseBlock()
        this.prsExpect("While")
        var cond: Int
        if (this.prsCheck("LParen")) {
            this.prsAdvance()
            cond = this.parseExpr()
            this.prsExpect("RParen")
        } else {
            cond = this.parseExpr()
        }
        val whileNode: Int = this.ast.add("While", "", "", sp, kidsAdd(kidsAdd(noKids(), cond), body))
        var blockKids: String = kidsAdd(noKids(), body)
        blockKids = kidsAdd(blockKids, whileNode)
        return this.ast.add("Block", "", "", sp, blockKids)
    }

    /// 解析 while 循环。
    fun parseWhile(): Int {
        this.prsAdvance() // While
        var cond: Int
        if (this.prsCheck("LParen")) {
            this.prsAdvance()
            cond = this.parseExpr()
            this.prsExpect("RParen")
        } else {
            cond = this.parseExpr()
        }
        val body = this.parseBlock()
        return this.ast.add("While", "", "", this.prsCurSpan(), kidsAdd(kidsAdd(noKids(), cond), body))
    }

    /// 解析 for 循环。
    ///
    /// 支持两种形态（与 Rust 侧 `Expr::For` / `Expr::CFor` 一致）：
    ///   * Kotlin 风格：`for (val i in 0..n) { ... }` / `for (x in list) { ... }`
    ///   * C 风格：`for (var i: Int = 0; i < n; i = i + 1) { ... }`
    fun parseFor(): Int {
        this.prsAdvance() // For
        this.prsExpect("LParen")
        var decl: Int
        if (this.prsCheck("Val") || this.prsCheck("Var")
            || (this.prsCheck("Const") && this.prsPeek(1) == "Val")) {
            decl = this.parseDecl(false)
        } else {
            // 无 `val`/`var` 关键字的形态：直接是循环变量名。
            // 不可复用 parseDecl：它会先把第一个 token 当作 val/var 消费掉，
            // 于是变量名错位成后面的 `in`（表现为循环体内变量读不到值）。
            val varName: String = this.prsCurLit()
            val varSpan: Span = this.prsCurSpan()
            this.prsExpectName()
            decl = this.ast.add("ValDecl", varName, "", varSpan, noKids())
        }
        // C 风格：`for (init; cond; incr) body`。旧实现在此处直接
        // `prsExpect("In")`，遇到 `;` 便报错并反同步 —— 类体因此在源代码中
        // 断链（连带后续方法全部退化为顶层自由函数，丢失隐式 self）。
        if (this.prsCheck("Semicolon")) {
            this.prsAdvance() // ;
            var cond: Int
            if (this.prsCheck("Semicolon")) {
                // 省略条件 → 恒真
                cond = this.ast.add("BoolLiteral", "true", "", this.prsCurSpan(), noKids())
            } else {
                cond = this.parseExpr()
            }
            this.prsExpect("Semicolon")
            var incr: Int
            if (this.prsCheck("RParen")) {
                // 省略步进 → 空块
                incr = this.ast.add("Block", "", "", this.prsCurSpan(), noKids())
            } else {
                // 步进通常是赋值（`j = j + 1`）——赋值的解析在 parseStatement 里
                // （parseExpr 不消费 `=`，会停在 Assign 上报「期望 RParen」）。
                incr = this.parseStatement()
            }
            this.prsExpect("RParen")
            val cfBody: Int = this.parseBlock()
            // kids 固定为 [init, cond, incr, body]，缺失部分用上述占位节点补齐
            var cfKids = kidsAdd(kidsAdd(kidsAdd(kidsAdd(noKids(), decl), cond), incr), cfBody)
            return this.ast.add("CFor", "", "", this.prsCurSpan(), cfKids)
        }
        this.prsExpect("In")
        val iterable = this.parseExpr()
        this.prsExpect("RParen")
        val body = this.parseBlock()
        var kids = kidsAdd(kidsAdd(kidsAdd(noKids(), decl), iterable), body)
        return this.ast.add("For", "", "", this.prsCurSpan(), kids)
    }

    /// 解析 try / catch / finally。
    ///
    /// kids **固定为 `[body, catchBlock, finallyBlock]`**：缺失的 catch/finally
    /// 补一个空 `Block` 占位。否则 `try { } finally { }` 与 `try { } catch { }`
    /// 的 kids 长度相同、含义不可区分（HirTry 只有位置信息可用）。
    fun parseTry(): Int {
        this.prsAdvance() // Try
        val body = this.parseBlock()
        var catchVar: String = ""
        var catchBlock: Int = -1
        if (this.prsCheck("Catch")) {
            this.prsAdvance()
            if (this.prsCheck("LParen")) {
                this.prsAdvance()
                if (this.prsCheck("Ident")) {
                    catchVar = this.prsCurLit()
                    this.prsAdvance()
                    if (this.prsMatch("Colon")) {
                        this.parseTypeName()
                    }
                }
                this.prsExpect("RParen")
            }
            catchBlock = this.parseBlock()
        }
        var finallyBlock: Int = -1
        if (this.prsCheck("Finally")) {
            this.prsAdvance()
            finallyBlock = this.parseBlock()
        }
        if (catchBlock < 0) {
            catchBlock = this.ast.add("Block", "", "", this.prsCurSpan(), noKids())
        }
        if (finallyBlock < 0) {
            finallyBlock = this.ast.add("Block", "", "", this.prsCurSpan(), noKids())
        }
        var kids = kidsAdd(kidsAdd(kidsAdd(noKids(), body), catchBlock), finallyBlock)
        return this.ast.add("Try", catchVar, "", this.prsCurSpan(), kids)
    }

    // ── 表达式：Pratt 优先级 ──

    /// 解析表达式入口（最低优先级）。
    fun parseExpr(): Int {
        return this.parseBinary(1)
    }

    /// 二元运算符优先级（0 表示非二元运算符）。
    fun binPrec(k: String): Int {
        if (k == "OrOr") { return 1 }
        if (k == "AndAnd") { return 2 }
        if (k == "EqEq" || k == "Neq" || k == "Is" || k == "As") {
            if (k == "Is" && this.prsNoBinaryIs) {
                return 0
            }
            return 3
        }
        if (k == "Lt" || k == "Gt" || k == "LtEq" || k == "GtEq") { return 4 }
        if (k == "LtLt" || k == "GtGt" || k == "GtGtGt") { return 5 }
        // 位运算：与 Rust 侧 `infix_binding_power` 一致
        //（`&` 5 / `^` 4 / `|` 3）。缺这三项时 `a & b` 会在 `&` 处直接中断二元
        // 解析 —— 左值留下、`& b` 变成独立垃圾语句（`Int.aura` 的
        // `and/or/xor` 方法体、`HashMap` 的桶下标取模都依赖它们）。
        if (k == "Ampersand") { return 5 }
        if (k == "Caret") { return 4 }
        if (k == "Pipe") { return 3 }
        if (k == "Plus" || k == "Minus") { return 6 }
        if (k == "Star" || k == "Slash" || k == "Percent") { return 7 }
        return 0
    }

    /// 左结合二元表达式解析。
    fun parseBinary(minPrec: Int): Int {
        var left = this.parseUnary()
        while (true) {
            // Elvis `?:`：由 `QuestionMark` + `Colon` 两个 token 组成，优先级最低、右结合。
            if (this.prsCurKind() == "QuestionMark" && this.prsKind(this.pos + 1) == "Colon") {
                if (minPrec > 1) {
                    break
                }
                this.prsAdvance() // `?`
                this.prsAdvance() // `:`
                val eRight = this.parseBinary(1)
                val eSpan = ParserUtils.mergeSpan(this.ast.spanOf(left), this.ast.spanOf(eRight))
                left = this.ast.add(
                    "Binary",
                    "ElvisColon",
                    "",
                    eSpan,
                    kidsAdd(kidsAdd(noKids(), left), eRight)
                )
                continue
            }
            // 中缀函数 `a to b`（Pair 构造）：词法器产出 **`To`** 关键字。
            // 不识别时 `val p = 3 to 4` 会被解析成 `val p = 3` + 独立语句 `to 4`，
            // `p` 退化为整数，后续解构/字段访问全部错乱。
            if (this.prsCurKind() == "To"
                && this.prsKind(this.pos + 1) != "Assign") {
                if (minPrec > 5) {
                    break
                }
                this.prsAdvance()
                val toRight = this.parseBinary(6)
                val toSp = ParserUtils.mergeSpan(this.ast.spanOf(left), this.ast.spanOf(toRight))
                left = this.ast.add("Binary", "to", "", toSp,
                    kidsAdd(kidsAdd(noKids(), left), toRight))
                continue
            }
            val op = this.prsCurKind()
            // 区间 `a..b`（闭）/ `a..<b`（左闭右开）：构造 `Range` AST 节点，
            // text 为 inclusive 标志（"1"/"0"）。此前完全未处理，`for (i in 1..5)`
            // 的迭代对象会被解析成裸 `1`（右界丢失 → 循环退化为 `count(1)`）。
            if (op == "DoubleDotOp" || op == "DoubleDotLtOp") {
                if (minPrec > 1) {
                    break
                }
                this.prsAdvance()
                val rEnd: Int = this.parseBinary(2)
                var rInc: String = "1"
                if (op == "DoubleDotLtOp") {
                    rInc = "0"
                }
                val rsp = ParserUtils.mergeSpan(this.ast.spanOf(left), this.ast.spanOf(rEnd))
                left = this.ast.add("Range", rInc, "", rsp, kidsAdd(kidsAdd(noKids(), left), rEnd))
                continue
            }
            val prec = this.binPrec(op)
            if (prec == 0 || prec < minPrec) {
                break
            }
            this.prsAdvance()
            // `x as T` / `x is T`：右侧是**类型名**而非表达式。
            // 若按表达式解析，`List<Any>` 会被拆成比较运算（`<` / `>`），
            // 整个表达式退化为垃圾 HIR（自举时 `Frames.pop` 就是这么坏掉的）。
            if (op == "As" || op == "Is") {
                val tname: String = this.parseTypeName()
                val tId: Int = this.ast.leaf("Lit", tname, this.prsCurSpan())
                val spT = ParserUtils.mergeSpan(this.ast.spanOf(left), this.ast.spanOf(tId))
                left = this.ast.add("Binary", op, "", spT, kidsAdd(kidsAdd(noKids(), left), tId))
                continue
            }
            val right = this.parseBinary(prec + 1)
            val sp = ParserUtils.mergeSpan(this.ast.spanOf(left), this.ast.spanOf(right))
            left = this.ast.add("Binary", op, "", sp, kidsAdd(kidsAdd(noKids(), left), right))
        }
        return left
    }

    /// 一元表达式（- / ! / + / await）。
    fun parseUnary(): Int {
        val k = this.prsCurKind()
        if (k == "Minus" || k == "Bang" || k == "Plus") {
            this.prsAdvance()
            val operand = this.parseUnary()
            val sp = ParserUtils.mergeSpan(this.prsCurSpan(), this.ast.spanOf(operand))
            return this.ast.add("Unary", k, "", sp, kidsAdd(noKids(), operand))
        }
        // `await expr` → 直接透传表达式（AOT 下同步执行，无挂起语义）。
        if (k == "Await") {
            this.prsAdvance()
            return this.parseUnary()
        }
        return this.parsePostfix()
    }

    /// 后缀表达式：调用 () / 成员 . / 下标 []。
    fun parsePostfix(): Int {
        var node = this.parsePrimary()
        while (true) {
            val k = this.prsCurKind()
            if (k == "LParen") {
                this.prsAdvance()
                var args = noKids()
                args = kidsAdd(args, node) // 被调用者作为首个子节点
                if (!this.prsCheck("RParen")) {
                    while (true) {
                        val a = this.parseExpr()
                        // 命名参数 `f(name = v)`：实参位置是裸标识符且后跟 `=`。
                        // 不识别会让参数列表在 `=` 处反同步（整条调用表达式被吞掉）。
                        // 记为 `NamedArg(text=参数名, kids=[值])`，供 HIR/发射器取用。
                        if (this.prsCheck("Assign")
                            && this.ast.kindOf(a) == "Ident") {
                            val nSp: Span = this.ast.spanOf(a)
                            val argName: String = this.ast.textOf(a)
                            this.prsAdvance() // `=`
                            val av: Int = this.parseExpr()
                            args = kidsAdd(args, this.ast.add("NamedArg", argName, "",
                                nSp, kidsAdd(noKids(), av)))
                        } else {
                            args = kidsAdd(args, a)
                        }
                        if (!this.prsMatch("Comma")) {
                            break
                        }
                    }
                }
                this.prsExpect("RParen")
                node = this.ast.add("Call", "", "", this.prsCurSpan(), args)
            } else if (k == "DoubleBang") {
                // 非空断言 `expr!!`：词法器产出 `DoubleBang`。
                // 不识别会让整个表达式在 `!!` 处反同步（编译期崩溃）。
                val sp: Span = ParserUtils.mergeSpan(this.ast.spanOf(node), this.prsCurSpan())
                this.prsAdvance()
                node = this.ast.add("Unwrap", "", "", sp, kidsAdd(noKids(), node))
            } else if (k == "Dot") {
                this.prsAdvance()
                val member: String = this.prsCurLit()
                this.prsExpectName()
                node = this.ast.add("Member", member, "", this.prsCurSpan(), kidsAdd(noKids(), node))
            } else if (k == "Lt") {
                // 泛型实参：`arrayListOf<String>()` / `mutableMapOf<String, Int>()`。
                // 必须在 postfix 处尝试消费：否则 `<` 会被当成比较运算符，
                // `arrayListOf<String>()` 被解析为 `arrayListOf < String > ()`，
                // 生成完全错误的 HIR/IR。仅在确认「尖括号内是类型形态且其后
                // 紧跟 `(` / `.` / `[`」时消费，`a < b` 仍按比较处理。
                if (!this.prsTrySkipTypeArgs()) {
                    break
                }
            } else if (k == "LBracket") {
                this.prsAdvance()
                val idx = this.parseExpr()
                this.prsExpect("RBracket")
                node = this.ast.add(
                    "Index",
                    "",
                    "",
                    this.prsCurSpan(),
                    kidsAdd(kidsAdd(noKids(), node), idx)
                )
            } else if (k == "LBrace" && this.ast.kindOf(node) == "Member"
                && this.prsCurSpan().startLine == this.ast.spanOf(node).endLine) {
                // 尾随 lambda：`nums.filter { it > 2 }` → `Call(filter, [接收者, 块])`。
                // 不识别时块会被当作独立语句，**后续 `.map { … }` 的 `.` 无法接续**
                // （postfix 循环已 break）→ 表达式反同步、编译期崩溃
                // （实测 `nums.filter { it > 2 }.map { it * 100 }`）。
                // 仅当「接收者是成员访问」且「`{` 与接收者同一行」时按尾随 lambda
                // 处理，避免把「成员访问语句后紧跟的块语句」误判为实参。
                val tBlkSp: Span = this.prsCurSpan()
                var tBlk: Int = this.parseBlock()
                // 单表达式块：取内层表达式作为 lambda 体。
                // 块体 lambda 在发射器里按「语句序列」处理，**末条表达式不会作为返回值**
                // （实测 `{ it % 2 == 0 }` 生成 `ret i32 0` → filter 恒空）。
                // 与 `parsePrimary` 的块表达式取法保持一致。
                val tBkKids: String = this.ast.kidsOf(tBlk)
                if (kidsCount(tBkKids) == 1) {
                    val tOnly: Int = this.ast.childOf(tBlk, 0)
                    if (this.ast.kindOf(tOnly) == "ExprStmt"
                        && kidsCount(this.ast.kidsOf(tOnly)) == 1) {
                        tBlk = this.ast.childOf(tOnly, 0)
                    }
                }
                // 包成 lambda：隐式单参 `it`（`nums.filter { it % 2 == 0 }`）。
                // 不包 lambda 时块只是普通表达式，`it` 是未定义变量（求值为 0），
                // 闭包实参退化为「装箱 0」的野指针 → 运行期访问违例。
                val tIt: Int = this.ast.add("Param", "it", "", tBlkSp, noKids())
                val tParams: Int = this.ast.add("Params", "", "", tBlkSp,
                    kidsAdd(noKids(), tIt))
                val tLam: Int = this.ast.add("Lambda", "", "", tBlkSp,
                    kidsAdd(kidsAdd(noKids(), tParams), tBlk))
                val tSp: Span = ParserUtils.mergeSpan(this.ast.spanOf(node), this.ast.spanOf(tBlk))
                node = this.ast.add("Call", "", "", tSp,
                    kidsAdd(kidsAdd(noKids(), node), tLam))
            } else {
                break
            }
        }
        return node
    }

    /// 尝试跳过泛型实参 `<T, U<V>>`（返回是否已消费）。
    ///
    /// 判定条件（全部满足才消费，否则回退到原位置）：
    ///   1. 尖括号**配平**（`>>` / `>>>` 折算 2 / 3 层闭合）；
    ///   2. 括号内只出现类型形态的 token（名字 / `,` / `.` / 嵌套 `<` / `?` / `*`）；
    ///   3. 闭合 `>` 之后紧跟 `(`、`.` 或 `[`（即确实是「泛型调用 / 泛型成员」）。
    ///
    /// 这样 `a < b`、`a < b && c` 等比较表达式不会被误消费。
    fun prsTrySkipTypeArgs(): Boolean {
        val save: Int = this.pos
        if (!this.prsCheck("Lt")) {
            return false
        }
        this.prsAdvance() // <
        var depth: Int = 1
        var scanned: Int = 0
        while (depth > 0) {
            val k: String = this.prsCurKind()
            if (k == "Lt") {
                depth = depth + 1
            } else if (k == "Gt") {
                depth = depth - 1
            } else if (k == "GtGt") {
                depth = depth - 2
            } else if (k == "GtGtGt") {
                depth = depth - 3
            } else if (this.prsIsTypeArgToken(k)) {
                // 类型形态 token：继续
            } else {
                // 非类型形态（字面量 / 算术运算符 / 语句边界）→ 不是泛型实参
                this.pos = save
                return false
            }
            this.prsAdvance()
            scanned = scanned + 1
            if (scanned > 96) {
                this.pos = save
                return false
            }
        }
        val nk: String = this.prsCurKind()
        if (nk == "LParen" || nk == "Dot" || nk == "LBracket") {
            return true
        }
        this.pos = save
        return false
    }

    /// 泛型实参内允许出现的 token 种类（类型形态）。
    fun prsIsTypeArgToken(k: String): Boolean {
        if (k == "" || k == "EOF") {
            return false
        }
        if (k == "Comma" || k == "Dot" || k == "QuestionMark" || k == "Star"
            || k == "In" || k == "Out" || k == "Arrow") {
            return true
        }
        // `String` / `Int` / 软关键字类型名等
        return this.prsIsNameToken()
    }

    /// 解析基础表达式（字面量 / 标识符 / 分组 / if / when）。
    fun parsePrimary(): Int {
        val k = this.prsCurKind()
        if (k == "IntLiteral") {
            return this.leafLit("IntLiteral")
        }
        if (k == "FloatLiteral") {
            return this.leafLit("FloatLiteral")
        }
        if (k == "StringLiteral") {
            val lit: Int = this.leafLit("StringLiteral")
            // 字符串插值：Lexer 按协议拆成 `StringLiteral` + `StringInterpStart` + …，
            // 此处重建为 `+` 拼接链（每段插值经 `toString(...)` 转字符串）。
            if (this.prsCurKind() == "StringInterpStart") {
                return this.parseStringInterp(lit)
            }
            return lit
        }
        // 字符串**以插值开头**（`"$x + $y = …"`）：词法器此时不产出前置
        // `StringLiteral`，直接以 `StringInterpStart` 开头。此前无分支 → 该 token
        // 落到「意外的 token」，整个插值的首段被丢弃（Phase B.3 的
        // testInterpMulti 因此只拼出后半段并返回错值）。
        if (k == "StringInterpStart") {
            val emptyLit: Int = this.ast.leaf("StringLiteral", "", this.prsCurSpan())
            return this.parseStringInterp(emptyLit)
        }
        if (k == "BoolLiteral") {
            return this.leafLit("BoolLiteral")
        }
        if (k == "CharLiteral") {
            return this.leafLit("CharLiteral")
        }
        if (k == "Null") {
            return this.leafLit("NullLiteral")
        }
        // `async { ... }` → 立即调用的无参 lambda（IIFE）。
        // 必须在 `prsIsNameToken()` 之前：`Async` 是软关键字，否则被当标识符
        // （求值为 0），后面的块变成独立表达式（返回值丢失）。
        if (k == "Async") {
            val aSp: Span = this.prsCurSpan()
            this.prsAdvance() // async
            var blk: Int = this.parseBlock()
            // 单表达式块：取内层表达式作为 lambda 体。
            // 块体 lambda 在发射器里按「语句序列」处理，**末条表达式不会作为返回值**
            // （实测 `{ it % 2 == 0 }` 生成 `ret i32 0` → filter 恒空）。
            val bkKids: String = this.ast.kidsOf(blk)
            if (kidsCount(bkKids) == 1) {
                val only: Int = this.ast.childOf(blk, 0)
                if (this.ast.kindOf(only) == "ExprStmt"
                    && kidsCount(this.ast.kidsOf(only)) == 1) {
                    blk = this.ast.childOf(only, 0)
                }
            }
            val emptyParams: Int = this.ast.add("Params", "", "", aSp, noKids())
            val lam: Int = this.ast.add("Lambda", "", "", aSp,
                kidsAdd(kidsAdd(noKids(), emptyParams), blk))
            return this.ast.add("Call", "", "", aSp, kidsAdd(noKids(), lam))
        }
        // 标识符：软关键字（`value` / `data` / …）同样按标识符处理
        if (this.prsIsNameToken()) {
            // 单参数 lambda: `x -> expr` 或 `x: Type -> expr`
            if (this.isLambdaStart()) {
                return this.parseLambda()
            }
            return this.leafLit("Ident")
        }
        if (k == "This") {
            return this.leafLit("This")
        }
        if (k == "Super") {
            return this.leafLit("Super")
        }
        if (k == "LParen") {
            // 括号参数 lambda 必须先试（`(a, b) -> a + b`）：否则会被当作分组
            // 表达式，`(a` 之后遇到 `,` 直接报「期望 RParen」并把 remainder 变成
            // ErrorExpr（Phase B.2 的 testLambdaTwoParams 由此损坏）。
            val lambdaId: Int = this.tryParseParenLambda()
            if (lambdaId >= 0) {
                return lambdaId
            }
            this.prsAdvance()
            val e = this.parseExpr()
            this.prsExpect("RParen")
            return e
        }
        if (k == "If") {
            return this.parseIf()
        }
        if (k == "When") {
            return this.parseWhen()
        }
        // `throw expr`（表达式位置；Rust 侧为 Expr::Throw）
        if (k == "Throw") {
            val throwSp: Span = this.prsCurSpan()
            this.prsAdvance()
            val thrown: Int = this.parseExpr()
            return this.ast.add("Throw", "", "", throwSp, kidsAdd(noKids(), thrown))
        }
        // 块表达式 `{ ... }`：单表达式块取值时直接返回该表达式
        if (k == "LBrace") {
            val blk: Int = this.parseBlock()
            if (kidsCount(this.ast.kidsOf(blk)) == 1) {
                val only: Int = this.ast.childOf(blk, 0)
                if (this.ast.kindOf(only) == "ExprStmt"
                    && kidsCount(this.ast.kidsOf(only)) == 1) {
                    return this.ast.childOf(only, 0)
                }
            }
            return blk
        }
        // 标识符 / 关键字作为表达式：与 Rust 侧原子解析一致（`advance().literal`），
        // 关键字 token 同样按其字面量作标识符 —— 源码里存在 `val val: Int = …`
        // 之后的 `toStr(-val)`、`isIntLiteral(val)` 这类把 `val` 当普通变量用的写法，
        // 直接报错会让整段反同步（Fold/MirOpt/Closures/FrameManager 实测如此）。
        val lit: String = this.prsCurLit()
        if (ParserUtils.prsIsWordLiteral(lit)) {
            val node = this.ast.leaf("Ident", lit, this.prsCurSpan())
            this.prsAdvance()
            return node
        }
        // 未知 token：报错并消费，避免死循环
        this.errors.pushAt(
            severityError(),
            "意外的 token: " + k,
            this.prsCurSpan().start,
            this.prsCurSpan().end
        )
        val bad = this.ast.leaf("ErrorExpr", lit, this.prsCurSpan())
        this.prsAdvance()
        return bad
    }

    /// 解析 when 表达式（模式 -> 分支）。
    fun parseWhen(): Int {
        this.prsAdvance() // When
        var subject: Int = -1
        if (this.prsCheck("LParen")) {
            this.prsAdvance()
            subject = this.parseExpr()
            this.prsExpect("RParen")
        }
        this.prsExpect("LBrace")
        var arms = noKids()
        while (!this.prsCheck("RBrace") && !this.prsAtEnd()) {
            var pat: Int
            if (this.prsCheck("Else")) {
                // `else -> body`：`else` 是关键字 token，而模式位置走 parseExpr
                // 会落进「意外 token」分支（产生 ErrorExpr + 诊断错误）。
                // 按约定降级为标识符 `__else__`（与 Rust 侧 `Ident("__else__")`
                // 一致），供 HIR 识别为恒真兜底分支。
                val elseSp: Span = this.prsCurSpan()
                this.prsAdvance()
                pat = this.ast.leaf("Ident", "__else__", elseSp)
            } else if (this.prsCheck("Is")) {
                // `is T` 模式：`is` 在模式位置没有左操作数，走 parseExpr 会落进
                // 「意外 token」分支。按 Rust 侧约定降级为标识符 `__is__T`。
                val isSp: Span = this.prsCurSpan()
                this.prsAdvance() // Is
                val tname: String = this.parseTypeName()
                pat = this.ast.leaf("Ident", "__is__" + tname, isSp)
            } else if (this.prsCheck("In")) {
                // `in a..b` 范围模式：`in` 在模式位置没有左操作数。
                // 降级为新节点 `InPattern(kids=[rangeExpr])`，由 HIR 侧翻译成
                // `Collections.contains(__range(...), subject)`。
                val inSp: Span = this.prsCurSpan()
                this.prsAdvance() // In
                val rngPat: Int = this.parseExpr()
                pat = this.ast.add("InPattern", "", "", inSp, kidsAdd(noKids(), rngPat))
            } else {
                // 模式位置**禁止 lambda 解析**：`CONST_INT -> "…"` 会被
                // `isLambdaStart()` 误判为单参 lambda 并连箭头带分支体一起吃掉，
                // 于是下一个分支的模式处变成「期望 Arrow，但遇到 Ident」
                // （Opcodes.aura 的 20 条诊断即由此而来）。
                val prevNoLambda: Boolean = this.prsNoLambda
                this.prsNoLambda = true
                pat = this.parseExpr()
                this.prsNoLambda = prevNoLambda
            }
            this.prsExpect("Arrow")
            // 分支体位置限制：
            //   * 禁止 `is` 二元运算符 —— 否则下一个分支模式 `is T` 会被当前
            //     分支体吞掉（`1 is Int`），`->` 悬空导致解析错位；
            //   * 禁止 lambda 识别 —— 否则 `"+" -> a` 后面紧跟的 `"-" -> b`
            //     会被当作单参 lambda `a -> b` 整体吃掉（分支体退化成闭包，
            //     `when (op) { "+" -> a; "-" -> b }` 生成垃圾值/崩溃）。
            val prevNoIs: Boolean = this.prsNoBinaryIs
            val prevNoLam: Boolean = this.prsNoLambda
            this.prsNoBinaryIs = true
            this.prsNoLambda = true
            val body = this.parseExpr()
            this.prsNoBinaryIs = prevNoIs
            this.prsNoLambda = prevNoLam
            arms = kidsAdd(arms, this.ast.add("WhenArm", "", "", this.prsCurSpan(), kidsAdd(kidsAdd(noKids(), pat), body)))
        }
        this.prsExpect("RBrace")
        var kids = noKids()
        if (subject >= 0) {
            kids = kidsAdd(kids, subject)
        }
        kids = kidsAdd(kids, this.ast.add("WhenArms", "", "", this.prsCurSpan(), arms))
        return this.ast.add("When", "", "", this.prsCurSpan(), kids)
    }

    /// 判断当前位置是否是 lambda 起始（Phase B.2）。
    ///
    /// `when` 分支模式中 `->` 是分支分隔符，不能当作 lambda 箭头。
    /// 但当前 Parser 的 `parseWhen` 使用 `prsExpect("Arrow")` 而非 `parseLambda`，
    /// 因此 `isLambdaStart` 不需要显式抑制。
    fun isLambdaStart(): Boolean {
        // 模式位置（when 分支）显式抑制：此处的 `->` 恒为分支分隔符
        if (this.prsNoLambda) {
            return false
        }
        // 单参数 lambda: `x -> expr` 或 `x: Type -> expr`
        val cur: String = this.prsCurKind()
        if (cur == "Ident" || cur == "Val" || cur == "Var") {
            // 检查后面是否是 `->` 或 `: ... ->`
            var i: Int = this.pos + 1
            var depth: Int = 0
            while (i < this.n) {
                val tk: String = this.prsKind(i)
                if (tk == "LParen" || tk == "LBrace") { depth = depth + 1 }
                else if (tk == "RParen" || tk == "RBrace") {
                    if (depth == 0) { return false }
                    depth = depth - 1
                } else if (tk == "Arrow") { return true }
                else if (tk == "Colon") {
                    // 检查类型后是否有 `->`
                    var j: Int = i + 1
                    while (j < this.n) {
                        val tk2: String = this.prsKind(j)
                        if (tk2 == "Arrow") { return true }
                        if (tk2 == "Comma" || tk2 == "RParen" || tk2 == "RBrace") { return false }
                        j = j + 1
                    }
                    return false
                } else if (tk == "Comma" || tk == "Semicolon" ||
                           tk == "RParen" || tk == "RBrace" || tk == "RBracket" ||
                           tk == "Plus" || tk == "Minus" || tk == "Star" ||
                           tk == "Slash" || tk == "Percent" || tk == "Assign" ||
                           tk == "EqEq" || tk == "Neq" || tk == "Lt" || tk == "Gt" ||
                           tk == "LtEq" || tk == "GtEq" || tk == "AndAnd" || tk == "OrOr" ||
                           tk == "Dot" || tk == "QuestionMark" || tk == "In" ||
                           tk == "If" || tk == "When" || tk == "Fun" || tk == "Return" ||
                           tk == "Break" || tk == "Continue" || tk == "While" ||
                           tk == "For" || tk == "Try" || tk == "Catch" || tk == "Finally" ||
                           tk == "LBracket" || tk == "LBrace" || tk == "Colon") {
                    return false
                }
                i = i + 1
            }
        }
        return false
    }

    /// 解析单参数 lambda（Phase B.2）：`x -> expr` 或 `x: Type -> expr`。
    fun parseLambda(): Int {
        val startSp: Span = this.prsCurSpan()
        var params: String = noKids()

        // 解析参数名（可能带类型标注）
        val name: String = this.prsCurLit()
        val sp: Span = this.prsCurSpan()
        this.prsExpectParamName()

        // 检查是否有类型标注
        if (this.prsCheck("Colon")) {
            this.prsAdvance()
            val typeStr: String = this.parseTypeName()
            val paramId: Int = this.ast.add("Param", name, typeStr, sp, noKids())
            params = kidsAdd(params, paramId)
        } else {
            val paramId: Int = this.ast.add("Param", name, "", sp, noKids())
            params = kidsAdd(params, paramId)
        }

        // 消费 ->
        this.prsExpect("Arrow")

        // 解析 body
        val body: Int = this.parseExpr()

        // 构造 Lambda AST 节点
        val paramsNode: Int = this.ast.add("Params", "", "", startSp, params)
        val lambdaKids: String = kidsAdd(kidsAdd(noKids(), paramsNode), body)
        return this.ast.add("Lambda", "", "", startSp, lambdaKids)
    }

    /// 尝试解析括号参数 lambda（Phase B.2）：`(x) -> expr` 或 `(x: T, y: T) -> expr`。
    ///
    /// 向前扫描配对 `)`，若其后紧跟 `->` 且括号内容形如参数列表则按 lambda 解析。
    /// 返回 lambda AST 节点 id，非 lambda 时返回 -1。
    fun tryParseParenLambda(): Int {
        // 扫描配对括号
        var depth: Int = 0
        var i: Int = this.pos
        while (i < this.n) {
            val tk: String = this.prsKind(i)
            if (tk == "LParen") { depth = depth + 1 }
            else if (tk == "RParen") {
                depth = depth - 1
                if (depth == 0) { break }
            }
            i = i + 1
        }
        if (depth != 0 || i >= this.n) { return -1 }

        // 检查 `)` 后面是否是 `->`
        if (i + 1 >= this.n) { return -1 }
        val afterParen: String = this.prsKind(i + 1)
        if (afterParen != "Arrow") { return -1 }

        // 检查括号内容是否是参数列表形态
        //
        // 用 while 而非 C 风格 for：该分支在被 parsePrimary 正式接入前是死代码，
        // C 风格 for 的（VM / AOT）降级从未被执行过；实测接入后此处会陷入死循环
        //（进程内存持续增长、CPU 0%）。while 形式无歧义，且与仓库其余循环一致。
        var j: Int = this.pos + 1
        while (j < i) {
            val t: String = this.prsKind(j)
            if (t != "Ident" && t != "Colon" && t != "Comma" &&
                t != "QuestionMark" && t != "Lt" && t != "Gt" &&
                t != "Val" && t != "Var") {
                return -1
            }
            j = j + 1
        }

        // 解析 lambda
        val startSp: Span = this.prsCurSpan()
        this.prsAdvance() // (
        var params: String = noKids()
        if (!this.prsCheck("RParen")) {
            val paramId: Int = this.parseLambdaParam()
            if (paramId >= 0) { params = kidsAdd(params, paramId) }
            while (this.prsCheck("Comma")) {
                this.prsAdvance()
                val p: Int = this.parseLambdaParam()
                if (p >= 0) { params = kidsAdd(params, p) }
            }
        }
        this.prsExpect("RParen")
        this.prsExpect("Arrow")

        // 解析 body
        val body: Int = this.parseExpr()

        // 构造 Lambda AST 节点
        val paramsNode: Int = this.ast.add("Params", "", "", startSp, params)
        val lambdaKids: String = kidsAdd(kidsAdd(noKids(), paramsNode), body)
        return this.ast.add("Lambda", "", "", startSp, lambdaKids)
    }

    /// 解析 lambda 参数（Phase B.2）：`name` 或 `name: Type`。
    fun parseLambdaParam(): Int {
        val name: String = this.prsCurLit()
        val sp: Span = this.prsCurSpan()
        this.prsExpectParamName()

        // 检查是否有类型标注
        if (this.prsCheck("Colon")) {
            this.prsAdvance()
            val typeStr: String = this.parseTypeName()
            return this.ast.add("Param", name, typeStr, sp, noKids())
        }
        return this.ast.add("Param", name, "", sp, noKids())
    }

    /// 便捷：把当前字面量 token 作为叶子节点消费。
    fun leafLit(kindName: String): Int {
        val text: String = this.prsCurLit()
        val sp = this.prsCurSpan()
        this.prsAdvance()
        return this.ast.leaf(kindName, text, sp)
    }

    /// 重建字符串插值：`left` 为已产出的首段字面量，随后交替出现
    /// `StringInterpStart` 与中段/尾部 `StringLiteral`，统一拼成 `+` 链。
    fun parseStringInterp(first: Int): Int {
        var left: Int = first
        while (this.prsCurKind() == "StringInterpStart") {
            val raw: String = this.prsCurLit()
            val sp: Span = this.prsCurSpan()
            this.prsAdvance()
            val part: Int = this.buildInterpPart(raw, sp)
            val sp1: Span = ParserUtils.mergeSpan(this.ast.spanOf(left), this.ast.spanOf(part))
            left = this.ast.add(
                "Binary",
                "Plus",
                "",
                sp1,
                kidsAdd(kidsAdd(noKids(), left), part)
            )
            if (this.prsCurKind() == "StringLiteral") {
                val seg: Int = this.leafLit("StringLiteral")
                val sp2: Span = ParserUtils.mergeSpan(this.ast.spanOf(left), this.ast.spanOf(seg))
                left = this.ast.add(
                    "Binary",
                    "Plus",
                    "",
                    sp2,
                    kidsAdd(kidsAdd(noKids(), left), seg)
                )
            }
        }
        return left
    }

    /// 构造单个插值片段：`$name` → `toString(name)`；`${expr}` → `toString(<expr>)`。
    fun buildInterpPart(raw: String, sp: Span): Int {
        var exprId: Int = -1
        // 注意：源码里不能直接写 `"${"`（词法器会当作插值起始），故动态拼接。
        val dollarBrace: String = "$" + "{"
        if (raw.startsWith(dollarBrace)) {
            val inner: String = ParserUtils.prsSlice(raw, 2, raw.length - 3)
            exprId = this.parseInterpExpr(inner, sp)
        } else if (raw.startsWith("$")) {
            val name: String = ParserUtils.prsSlice(raw, 1, raw.length - 1)
            exprId = this.ast.leaf("Ident", name, sp)
        }
        if (exprId < 0) {
            exprId = this.ast.leaf("StringLiteral", "", sp)
        }
        val callee: Int = this.ast.leaf("Ident", "toString", sp)
        return this.ast.add(
            "Call",
            "",
            "",
            sp,
            kidsAdd(kidsAdd(noKids(), callee), exprId)
        )
    }

    /// 用子解析器解析 `${...}` 内部表达式，并把其 AST 子树复制进当前 arena。
    fun parseInterpExpr(text: String, sp: Span): Int {
        if (text == "") {
            return this.ast.leaf("StringLiteral", "", sp)
        }
        val sub: Parser = Parser(text)
        if (sub.n <= 1) {
            return this.ast.leaf("StringLiteral", "", sp)
        }
        val subRoot: Int = sub.parseExpr()
        if (subRoot < 0) {
            return this.ast.leaf("StringLiteral", "", sp)
        }
        return this.copySubtree(sub.ast, subRoot)
    }

    /// 把 `src` 子树复制进当前 arena（`this.ast`）。
    ///
    /// 注意：必须作为方法写入 `this.ast`，**不能**把目标 Ast 作为参数传入 ——
    /// 自举 AOT 下类实例参数按值传递，`dst.add` 会写进副本并使返回的 id 在主
    /// arena 中错位（曾导致整个模块无函数）。
    fun copySubtree(src: Ast, id: Int): Int {
        var newKids: String = noKids()
        var i: Int = 0
        while (true) {
            val c: Int = src.childOf(id, i)
            if (c < 0) {
                break
            }
            newKids = kidsAdd(newKids, this.copySubtree(src, c))
            i = i + 1
        }
        return this.ast.add(src.kindOf(id), src.textOf(id), src.tyOf(id), src.spanOf(id), newKids)
    }
}

// ─────────────────────────────────────────────────────────────
// Parser 辅助（工具对象）
// ─────────────────────────────────────────────────────────────

object ParserUtils {

    /// 复合赋值 token → 对应二元运算符 token kind（供 `x += y` 脱糖为 `x = x + y`）。
    fun compoundAssignOp(k: String): String {
        if (k == "PlusEq") {
            return "Plus"
        } else if (k == "MinusEq") {
            return "Minus"
        } else if (k == "StarEq") {
            return "Star"
        } else if (k == "SlashEq") {
            return "Slash"
        } else if (k == "PercentEq") {
            return "Percent"
        }
        return "Plus"
    }

    /// 子串（start 起 length 长，越界截断）。
    ///
    /// **性能关键**：直接 `substring` 一次分配。旧实现逐字符
    /// `out = out + toStr(text[i])`：每个字符一次 `String_charAt` 分配 +
    /// 一次整串复制 —— 该函数为每个 token 文本调用，是解析阶段平方级
    /// 内存/耗时的主因之一。
    fun prsSlice(text: String, start: Int, length: Int): String {
        var s: Int = start
        if (s < 0) {
            s = 0
        }
        var end: Int = s + length
        val len: Int = text.length
        if (end > len) {
            end = len
        }
        if (end <= s) {
            return ""
        }
        return text.substring(s, end)
    }

    /// 合并两个 span（用于复合节点）。
    fun mergeSpan(a: Span, b: Span): Span {
        return Span(a.start, b.end, a.startLine, a.startCol, b.endLine, b.endCol)
    }

    /// 是否为「词」字面量（标识符 / 关键字这类由字母数字下划线组成的 token 文本）。
    ///
    /// 用于在表达式位置把关键字 token 按其字面量当作标识符处理，对齐 Rust 侧
    /// 原子解析 `advance().literal.clone()`；标点 token 的字面量（`(`、`+` …）与
    /// EOF 的空串一律判为 false（仍走「意外的 token」诊断路径）。
    fun prsIsWordLiteral(s: String): Boolean {
        if (s == "") {
            return false
        }
        // 逐字符查表（`indexOf`）而非 `c >= "a" && c <= "z"`：Aura 的字符串
        // 关系比较在 AOT/VM 下语义不可靠（实测 `"$" >= "a"` 会判为 true，
        // 于是 `$x` 被误当作标识符）。查表法用的是内容包含匹配，两边一致。
        val wordChars: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_"
        var i: Int = 0
        while (i < s.length) {
            if (wordChars.indexOf(aotSlice(s, i, 1)) < 0) {
                return false
            }
            i = i + 1
        }
        return true
    }
}
