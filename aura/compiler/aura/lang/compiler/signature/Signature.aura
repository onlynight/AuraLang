// aura:///aura/lang/compiler/signature/Signature.aura
package aura.lang.compiler.signature
// ─────────────────────────────────────────────────────────────
// 类型签名 (.sig) 格式 — 纯 Aura 化迁移
//
// 对应 Rust `compiler/src/signature.rs`。
//
// .sig 文件描述模块的类型信息，与 .auc 分离，
// 用于编译期类型检查和链接。
//
// 文件格式：
//   [4 bytes]  magic "ASIG"
//   [2 bytes]  version (u16 LE)
//   [4 bytes]  json_len (u32 LE)
//   [N bytes]  JSON 序列化的 ModuleSig
//
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String
import aura.lang.std.FileSystem
import aura.lang.std.Json
import aura.lang.std.Encoding
import aura.lang.compiler.lexer.Span

// ═══════════════════════════════════════════════════════════════
// TypeSig — 类型签名
// ═══════════════════════════════════════════════════════════════

/// 类型签名（表示任意 Aura 类型）。
class TypeSig {

    /// 类型种类标识。
    var kind: String = ""

    /// 用户类型名称（UserType / Generic 时使用）。
    var name: String = ""

    /// 泛型参数类型列表。
    var typeParams: List<TypeSig> = []

    /// 泛型参数名称列表（UserType 时使用）。
    var paramNameList: List<String> = []

    /// 引用类型目标。
    var refTarget: TypeSig = null

    /// 函数返回类型。
    var funcReturn: TypeSig = null

    initInt() {
        this.kind = "int"
    }

    initFloat() {
        this.kind = "float"
    }

    initBool() {
        this.kind = "bool"
    }

    initStr() {
        this.kind = "str"
    }

    initNull() {
        this.kind = "null"
    }

    initRef(target: TypeSig) {
        this.kind = "ref"
        this.refTarget = target
    }

    initTuple(params: List<TypeSig>) {
        this.kind = "tuple"
        this.typeParams = params
    }

    initFunc(params: List<TypeSig>, ret: TypeSig) {
        this.kind = "func"
        this.typeParams = params
        this.funcReturn = ret
    }

    initGeneric(name: String, params: List<TypeSig>) {
        this.kind = "generic"
        this.name = name
        this.typeParams = params
    }

    initUserType(name: String, typeParams: List<String>) {
        this.kind = "user"
        this.name = name
        this.paramNameList = typeParams
    }

    /// 类型签名的字符串表示。
    fun toStr(): String {
        if (this.kind == "int") {
            return "int"
        }
        if (this.kind == "float") {
            return "float"
        }
        if (this.kind == "bool") {
            return "bool"
        }
        if (this.kind == "str") {
            return "str"
        }
        if (this.kind == "null") {
            return "null"
        }
        if (this.kind == "ref") {
            return "&" + this.refTarget.toStr()
        }
        if (this.kind == "tuple") {
            var items: String = ""
            for (t in this.typeParams) {
                if (items.length > 0) {
                    items = items + ", "
                }
                items = items + t.toStr()
            }
            return "(" + items + ")"
        }
        if (this.kind == "func") {
            var params: String = ""
            for (t in this.typeParams) {
                if (params.length > 0) {
                    params = params + ", "
                }
                params = params + t.toStr()
            }
            return "(" + params + ") -> " + this.funcReturn.toStr()
        }
        if (this.kind == "generic") {
            var params: String = ""
            for (t in this.typeParams) {
                if (params.length > 0) {
                    params = params + ", "
                }
                params = params + t.toStr()
            }
            return this.name + "<" + params + ">"
        }
        if (this.kind == "user") {
            if (this.paramNameList.length == 0) {
                return this.name
            }
            return this.name + "<" + SignatureUtils.joinStrings(this.paramNameList, ", ") + ">"
        }
        return "unknown"
    }

    /// 序列化为 JSON 值。
    fun toJson(): Object {
        val obj: Object = {}
        obj["kind"] = this.kind
        if (this.kind == "ref") {
            obj["refTarget"] = this.refTarget.toJson()
        } else if (this.kind == "tuple" || this.kind == "generic") {
            val arr: Array = []
            for (t in this.typeParams) {
                arr.add(t.toJson())
            }
            obj["typeParams"] = arr
            if (this.kind == "generic") {
                obj["name"] = this.name
            }
        } else if (this.kind == "func") {
            val arr: Array = []
            for (t in this.typeParams) {
                arr.add(t.toJson())
            }
            obj["params"] = arr
            obj["returnType"] = this.funcReturn.toJson()
        } else if (this.kind == "user") {
            obj["name"] = this.name
            obj["typeParams"] = this.paramNameList
        }
        return obj
    }

    /// 从 JSON 值反序列化。
    fun fromJson(obj: Object): TypeSig {
        val ts: TypeSig = TypeSig()
        ts.kind = obj["kind"].asStr()

        if (ts.kind == "int") {
            ts.initInt()
        } else if (ts.kind == "float") {
            ts.initFloat()
        } else if (ts.kind == "bool") {
            ts.initBool()
        } else if (ts.kind == "str") {
            ts.initStr()
        } else if (ts.kind == "null") {
            ts.initNull()
        } else if (ts.kind == "ref") {
            ts.refTarget = TypeSig.fromJson(obj["refTarget"])
            ts.initRef(ts.refTarget)
        } else if (ts.kind == "tuple") {
            val arr: Array = obj["typeParams"].asArray()
            val params: List<TypeSig> = []
            for (item in arr) {
                params.add(TypeSig.fromJson(item))
            }
            ts.initTuple(params)
        } else if (ts.kind == "func") {
            val arr: Array = obj["params"].asArray()
            val params: List<TypeSig> = []
            for (item in arr) {
                params.add(TypeSig.fromJson(item))
            }
            val ret: TypeSig = TypeSig.fromJson(obj["returnType"])
            ts.initFunc(params, ret)
        } else if (ts.kind == "generic") {
            val name: String = obj["name"].asStr()
            val arr: Array = obj["typeParams"].asArray()
            val params: List<TypeSig> = []
            for (item in arr) {
                params.add(TypeSig.fromJson(item))
            }
            ts.initGeneric(name, params)
        } else if (ts.kind == "user") {
            val name: String = obj["name"].asStr()
            val arr: Array = obj["typeParams"].asArray()
            val params: List<String> = []
            for (item in arr) {
                params.add(item.asStr())
            }
            ts.initUserType(name, params)
        }
        return ts
    }

    /// 两个类型签名是否相等。
    fun equals(other: TypeSig): Boolean {
        if (this.kind != other.kind) {
            return false
        }
        if (this.kind == "ref") {
            return this.refTarget.equals(other.refTarget)
        }
        if (this.kind == "func") {
            if (this.typeParams.length != other.typeParams.length) {
                return false
            }
            for (i: Int in 0..this.typeParams.length) {
                if (!this.typeParams[i].equals(other.typeParams[i])) {
                    return false
                }
            }
            return this.funcReturn.equals(other.funcReturn)
        }
        if (this.kind == "generic" || this.kind == "tuple") {
            if (this.typeParams.length != other.typeParams.length) {
                return false
            }
            if (this.kind == "generic") {
                if (this.name != other.name) {
                    return false
                }
            }
            for (i: Int in 0..this.typeParams.length) {
                if (!this.typeParams[i].equals(other.typeParams[i])) {
                    return false
                }
            }
            return true
        }
        if (this.kind == "user") {
            if (this.name != other.name) {
                return false
            }
            if (this.paramNameList.length != other.paramNameList.length) {
                return false
            }
            for (i: Int in 0..this.paramNameList.length) {
                if (this.paramNameList[i] != other.paramNameList[i]) {
                    return false
                }
            }
            return true
        }
        return true
    }
}

// ═══════════════════════════════════════════════════════════════
// FuncSig — 函数签名
// ═══════════════════════════════════════════════════════════════

class FuncSig {
    var name: String = ""
    var params: List<TypeSig> = []
    var returnType: TypeSig = TypeSig()
    var isPublic: Boolean = true
    var typeParams: List<String> = []

    init() {
        this.returnType = TypeSig()
        this.returnType.initNull()
    }

    fun toJson(): Object {
        val obj: Object = {}
        obj["name"] = this.name
        val params: Array = []
        for (p in this.params) {
            params.add(p.toJson())
        }
        obj["params"] = params
        obj["returnType"] = this.returnType.toJson()
        obj["isPublic"] = this.isPublic
        obj["typeParams"] = this.typeParams
        return obj
    }

    fun fromJson(obj: Object): FuncSig {
        val fs: FuncSig = FuncSig()
        fs.name = obj["name"].asStr()
        fs.isPublic = obj["isPublic"].asBool()
        val params: Array = obj["params"].asArray()
        for (item in params) {
            fs.params.add(TypeSig.fromJson(item))
        }
        fs.returnType = TypeSig.fromJson(obj["returnType"])
        val tp: Array = obj["typeParams"].asArray()
        for (item in tp) {
            fs.typeParams.add(item.asStr())
        }
        return fs
    }
}

// ═══════════════════════════════════════════════════════════════
// TypeDefSig — 类型定义签名
// ═══════════════════════════════════════════════════════════════

class TypeDefSig {
    var name: String = ""
    var kind: String = "struct" // struct, class, interface, enum, typealias
    var typeParams: List<String> = []
    var fields: List<FieldSig> = []
    var methods: List<FuncSig> = []
    var variants: List<VariantSig> = []
    var superTypes: List<String> = []
    var isPublic: Boolean = true

    fun toJson(): Object {
        val obj: Object = {}
        obj["name"] = this.name
        obj["kind"] = this.kind
        obj["typeParams"] = this.typeParams
        val fields: Array = []
        for (f in this.fields) {
            fields.add(f.toJson())
        }
        obj["fields"] = fields
        val methods: Array = []
        for (m in this.methods) {
            methods.add(m.toJson())
        }
        obj["methods"] = methods
        val variants: Array = []
        for (v in this.variants) {
            variants.add(v.toJson())
        }
        obj["variants"] = variants
        obj["superTypes"] = this.superTypes
        obj["isPublic"] = this.isPublic
        return obj
    }

    fun fromJson(obj: Object): TypeDefSig {
        val ts: TypeDefSig = TypeDefSig()
        ts.name = obj["name"].asStr()
        ts.kind = obj["kind"].asStr()
        ts.isPublic = obj["isPublic"].asBool()
        val tp: Array = obj["typeParams"].asArray()
        for (item in tp) {
            ts.typeParams.add(item.asStr())
        }
        val fields: Array = obj["fields"].asArray()
        for (item in fields) {
            ts.fields.add(FieldSig.fromJson(item))
        }
        val methods: Array = obj["methods"].asArray()
        for (item in methods) {
            ts.methods.add(FuncSig.fromJson(item))
        }
        val variants: Array = obj["variants"].asArray()
        for (item in variants) {
            ts.variants.add(VariantSig.fromJson(item))
        }
        val st: Array = obj["superTypes"].asArray()
        for (item in st) {
            ts.superTypes.add(item.asStr())
        }
        return ts
    }
}

// ═══════════════════════════════════════════════════════════════
// FieldSig — 字段签名
// ═══════════════════════════════════════════════════════════════

class FieldSig {
    var name: String = ""
    var typeSig: TypeSig = TypeSig()
    var isPublic: Boolean = true
    var isMutable: Boolean = false

    init() {
        this.typeSig = TypeSig()
        this.typeSig.initNull()
    }

    fun toJson(): Object {
        val obj: Object = {}
        obj["name"] = this.name
        obj["typeSig"] = this.typeSig.toJson()
        obj["isPublic"] = this.isPublic
        obj["isMutable"] = this.isMutable
        return obj
    }

    fun fromJson(obj: Object): FieldSig {
        val fs: FieldSig = FieldSig()
        fs.name = obj["name"].asStr()
        fs.isPublic = obj["isPublic"].asBool()
        fs.isMutable = obj["isMutable"].asBool()
        fs.typeSig = TypeSig.fromJson(obj["typeSig"])
        return fs
    }
}

// ═══════════════════════════════════════════════════════════════
// VariantSig — 枚举变体签名
// ═══════════════════════════════════════════════════════════════

class VariantSig {
    var name: String = ""
    var fields: List<TypeSig> = []
    var isPublic: Boolean = true

    fun toJson(): Object {
        val obj: Object = {}
        obj["name"] = this.name
        val fields: Array = []
        for (f in this.fields) {
            fields.add(f.toJson())
        }
        obj["fields"] = fields
        obj["isPublic"] = this.isPublic
        return obj
    }

    fun fromJson(obj: Object): VariantSig {
        val vs: VariantSig = VariantSig()
        vs.name = obj["name"].asStr()
        vs.isPublic = obj["isPublic"].asBool()
        val fields: Array = obj["fields"].asArray()
        for (item in fields) {
            vs.fields.add(TypeSig.fromJson(item))
        }
        return vs
    }
}

// ═══════════════════════════════════════════════════════════════
// ConstSig — 常量签名
// ═══════════════════════════════════════════════════════════════

class ConstSig {
    var name: String = ""
    var typeSig: TypeSig = TypeSig()
    var value: String = "" // JSON string representation of value
    var isPublic: Boolean = true

    init() {
        this.typeSig = TypeSig()
        this.typeSig.initNull()
    }

    fun toJson(): Object {
        val obj: Object = {}
        obj["name"] = this.name
        obj["typeSig"] = this.typeSig.toJson()
        obj["value"] = this.value
        obj["isPublic"] = this.isPublic
        return obj
    }

    fun fromJson(obj: Object): ConstSig {
        val cs: ConstSig = ConstSig()
        cs.name = obj["name"].asStr()
        cs.isPublic = obj["isPublic"].asBool()
        cs.value = obj["value"].asStr()
        cs.typeSig = TypeSig.fromJson(obj["typeSig"])
        return cs
    }
}

// ═══════════════════════════════════════════════════════════════
// ImportSig — 导入声明签名
// ═══════════════════════════════════════════════════════════════

class ImportSig {
    var module: String = ""
    var symbols: List<ImportSymbolSig> = []
    var aliases: List<Pair<String, String>> = [] // simple key-value pairs

    fun toJson(): Object {
        val obj: Object = {}
        obj["module"] = this.module
        val symbols: Array = []
        for (s in this.symbols) {
            symbols.add(s.toJson())
        }
        obj["symbols"] = symbols
        val aliases: Array = []
        for (a in this.aliases) {
            aliases.add(a.first + "=" + a.second)
        }
        obj["aliases"] = aliases
        return obj
    }

    fun fromJson(obj: Object): ImportSig {
        val is: ImportSig = ImportSig()
        is.module = obj["module"].asStr()
        val symbols: Array = obj["symbols"].asArray()
        for (item in symbols) {
            is.symbols.add(ImportSymbolSig.fromJson(item))
        }
        val aliases: Array = obj["aliases"].asArray()
        for (item in aliases) {
            val s: String = item.asStr()
            val parts: Array = s.split("=")
            if (parts.length >= 2) {
                is.aliases.add(Pair<String, String>(parts[0], parts[1]))
            }
        }
        return is
    }
}

class ImportSymbolSig {
    var name: String = ""
    var kind: String = "function" // function, type, const

    fun toJson(): Object {
        val obj: Object = {}
        obj["name"] = this.name
        obj["kind"] = this.kind
        return obj
    }

    fun fromJson(obj: Object): ImportSymbolSig {
        val is: ImportSymbolSig = ImportSymbolSig()
        is.name = obj["name"].asStr()
        is.kind = obj["kind"].asStr()
        return is
    }
}

// ═══════════════════════════════════════════════════════════════
// ModuleSig — 模块签名
// ═══════════════════════════════════════════════════════════════

/// 完整的模块签名（.sig 文件内容）。
class ModuleSig {
    var moduleName: String = ""
    var moduleVersion: String = ""
    var uuid: String = "" // hex-encoded 16-byte UUID
    var version: Int = SignatureUtils.SIG_VERSION
    var functions: List<FuncSig> = []
    var types: List<TypeDefSig> = []
    var constants: List<ConstSig> = []
    var imports: List<ImportSig> = []
    var dependencies: List<String> = []

    init(name: String, ver: String, uuid: String) {
        this.moduleName = name
        this.moduleVersion = ver
        this.uuid = uuid
        this.version = SignatureUtils.SIG_VERSION
    }

    /// 查找函数签名。
    fun findFunction(name: String): FuncSig {
        for (f in this.functions) {
            if (f.name == name) {
                return f
            }
        }
        return null
    }

    /// 查找类型定义。
    fun findType(name: String): TypeDefSig {
        for (t in this.types) {
            if (t.name == name) {
                return t
            }
        }
        return null
    }

    /// 查找常量签名。
    fun findConstant(name: String): ConstSig {
        for (c in this.constants) {
            if (c.name == name) {
                return c
            }
        }
        return null
    }

    /// 序列化为 JSON 对象。
    fun toJson(): Object {
        val obj: Object = {}
        obj["moduleName"] = this.moduleName
        obj["moduleVersion"] = this.moduleVersion
        obj["uuid"] = this.uuid
        obj["version"] = this.version
        val functions: Array = []
        for (f in this.functions) {
            functions.add(f.toJson())
        }
        obj["functions"] = functions
        val types: Array = []
        for (t in this.types) {
            types.add(t.toJson())
        }
        obj["types"] = types
        val constants: Array = []
        for (c in this.constants) {
            constants.add(c.toJson())
        }
        obj["constants"] = constants
        val imports: Array = []
        for (imp in this.imports) {
            imports.add(imp.toJson())
        }
        obj["imports"] = imports
        obj["dependencies"] = this.dependencies
        return obj
    }

    /// 从 JSON 对象反序列化。
    fun fromJson(obj: Object): ModuleSig {
        val ms: ModuleSig = ModuleSig()
        ms.moduleName = obj["moduleName"].asStr()
        ms.moduleVersion = obj["moduleVersion"].asStr()
        ms.uuid = obj["uuid"].asStr()
        ms.version = obj["version"].asInt()
        val functions: Array = obj["functions"].asArray()
        for (item in functions) {
            ms.functions.add(FuncSig.fromJson(item))
        }
        val types: Array = obj["types"].asArray()
        for (item in types) {
            ms.types.add(TypeDefSig.fromJson(item))
        }
        val constants: Array = obj["constants"].asArray()
        for (item in constants) {
            ms.constants.add(ConstSig.fromJson(item))
        }
        val imports: Array = obj["imports"].asArray()
        for (item in imports) {
            ms.imports.add(ImportSig.fromJson(item))
        }
        val deps: Array = obj["dependencies"].asArray()
        for (item in deps) {
            ms.dependencies.add(item.asStr())
        }
        return ms
    }
}

// ═══════════════════════════════════════════════════════════════
// 常量与序列化/工具函数
// ═══════════════════════════════════════════════════════════════

object SignatureUtils {

    const val SIG_MAGIC: String = "ASIG"
    const val SIG_VERSION: Int = 1

    /// 序列化为字节（magic + version + json_len + json）。
    fun sigToBytes(sig: ModuleSig): String {
        val jsonStr: String = Json.stringify(sig.toJson())
        val jsonBytes: String = Encoding.strToBytes(jsonStr)
        val jsonLen: Int = jsonBytes.length

        var buf: String = ""
        // Magic
        buf = buf + SignatureUtils.SIG_MAGIC
        // Version (2 bytes LE)
        buf = buf + String.fromCharCode(sig.version & 0xFF)
        buf = buf + String.fromCharCode((sig.version >> 8) & 0xFF)
        // JSON length (4 bytes LE)
        buf = buf + String.fromCharCode(jsonLen & 0xFF)
        buf = buf + String.fromCharCode((jsonLen >> 8) & 0xFF)
        buf = buf + String.fromCharCode((jsonLen >> 16) & 0xFF)
        buf = buf + String.fromCharCode((jsonLen >> 24) & 0xFF)
        // JSON data
        buf = buf + jsonBytes

        return buf
    }

    /// 从字节反序列化。
    fun sigFromBytes(data: String): ModuleSig {
        if (data.length < 10) {
            return null
        }
        // Check magic
        val magic: String = data.substring(0, 4)
        if (magic != SignatureUtils.SIG_MAGIC) {
            return null
        }
        // Read version (2 bytes LE)
        val version: Int = data.charCodeAt(4) + (data.charCodeAt(5) << 8)
        if (version != SignatureUtils.SIG_VERSION) {
            return null
        }
        // Read JSON length (4 bytes LE)
        val jsonLen: Int = data.charCodeAt(6) + (data.charCodeAt(7) << 8)
            + (data.charCodeAt(8) << 16) + (data.charCodeAt(9) << 24)
        if (data.length < 10 + jsonLen) {
            return null
        }
        // Read JSON
        val jsonBytes: String = data.substring(10, 10 + jsonLen)
        val jsonStr: String = Encoding.bytesToStr(jsonBytes)
        val obj: Object = Json.parse(jsonStr)
        if (obj == null) {
            return null
        }
        return ModuleSig.fromJson(obj)
    }

    /// 写入 .sig 文件。
    fun writeSig(path: String, sig: ModuleSig): Boolean {
        val data: String = SignatureUtils.sigToBytes(sig)
        return FileSystem.writeFile(path, data)
    }

    /// 读取 .sig 文件。
    fun readSig(path: String): ModuleSig {
        val data: String = FileSystem.readFile(path)
        return SignatureUtils.sigFromBytes(data)
    }

    fun joinStrings(list: List<String>, sep: String): String {
        var result: String = ""
        for (i: Int in 0..list.length) {
            if (i > 0) {
                result = result + sep
            }
            result = result + list[i]
        }
        return result
    }
}
