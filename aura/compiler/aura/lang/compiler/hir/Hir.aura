// aura:///aura/lang/compiler/hir/Hir.aura
package aura.lang.compiler.hir
// ─────────────────────────────────────────────────────────────
// HIR（高级中间表示）— 纯 Aura 化迁移 · Phase 2 (任务 2.5)
//
// 对应 Rust `compiler/src/codegen/hir.rs`（211 KB / 5777 行）。
//
// ── 设计方式（与 Ast.aura 一致）──────────────────────────────
//
// HIR 是去除了语法糖的 AST。本版聚焦核心降级：
//   * 字面量 / 标识符 / 字面量 → HirLit / HirVar
//   * 一元 / 二元运算 → HirUnary / HirBinary
//   * 函数调用 → HirCall
//   * 成员访问 / 下标 → HirMember / HirIndex
//   * val / var 声明 → HirValDecl / HirVarDecl
//   * if / while / for 语句 → HirIf / HirWhile / HirFor
//   * return / break / continue / assign / exprStmt → 对应语句节点
//   * 块 → HirBlock
//
// ── 扁平 arena 表示（与 Ast 一致）───────────────────────────
//
//   * 每个 HIR 节点一个整数 id；
//   * 节点字段分别存在 5 条「每行一项」的 String 中
//     （kinds / texts / tys / span 的 6 条并列 Int 列表 / kids）；
//   * 子节点以逗号分隔的 id 列表存在 `kids` 中。
//
// ── 当前覆盖范围（Phase 2 起步，可逐步扩展）──────────────
//
// 暂不覆盖的降级（后续扩展）：
//   - `when` → 嵌套 `if`（本版保留 When 节点）
//   - `for` → `while` + 索引变量（本版保留 For 节点）
//   - 字符串插值降级
//   - 安全调用降级
//   - Elvis 降级
//   - 闭包 / lambda 降级
//   - 类方法分派（sema 类型信息依赖）
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String
// 本文件必须**自包含**：以下两个类是 HirLowerer 签名/实现直接依赖的
// 跨包类型，缺 import 时只有在「整个编译器一次性编译」的入口下才会
// 因为同编译单元而侥幸解析；单独/经 Parser 之外的入口编译时，接收者
// 类型退化为 `<error>`，`ast.kidsOf(...)` 等方法派发失败被降级为裸名调用
// （`[bytecode] error: 未解析的函数调用 'kidsOf'/'spanOf'` …）。
import aura.lang.compiler.lexer.Span
import aura.lang.compiler.ast.Ast

object HirUtils {

    /// 归一化二元运算符：把词法 TokenKind 名（Plus/Star…）转为符号（+/*…）。
    ///
    /// 说明：Parser 的 Binary.text 存的是 TokenKind 名，而 MIR/Codegen 按符号匹配，
    /// 若不归一化则所有二元运算都会退化为默认的 ADD。
    fun hirNormBinOp(op: String): String {
        if (op == "Plus" || op == "+") { return "+" }
        if (op == "Minus" || op == "-") { return "-" }
        if (op == "Star" || op == "*") { return "*" }
        if (op == "Slash" || op == "/") { return "/" }
        if (op == "Percent" || op == "%") { return "%" }
        if (op == "EqEq" || op == "==") { return "==" }
        if (op == "Neq" || op == "!=") { return "!=" }
        if (op == "Lt" || op == "<") { return "<" }
        if (op == "Gt" || op == ">") { return ">" }
        if (op == "LtEq" || op == "<=") { return "<=" }
        if (op == "GtEq" || op == ">=") { return ">=" }
        if (op == "AndAnd" || op == "&&") { return "&&" }
        if (op == "OrOr" || op == "||") { return "||" }
        if (op == "ElvisColon" || op == "?:") { return "?:" }
        if (op == "LtLt" || op == "<<") { return "<<" }
        if (op == "GtGt" || op == ">>") { return ">>" }
        if (op == "GtGtGt" || op == ">>>") { return ">>>" }
        // 位运算（符号形式）：`&` / `|` / `^`。不归一化则发射器拿不到运算符文本，
        // 二元表达式退化为默认可选分支（错误的 IR）。
        if (op == "Ampersand" || op == "&") { return "&" }
        if (op == "Pipe" || op == "|") { return "|" }
        if (op == "Caret" || op == "^") { return "^" }
        return op
    }

    /// 归一化一元运算符：Minus→-、Bang→!、Plus→+。
    fun hirNormUnOp(op: String): String {
        if (op == "Minus" || op == "-") { return "-" }
        if (op == "Bang" || op == "!") { return "!" }
        if (op == "Plus" || op == "+") { return "+" }
        return op
    }

    /// 空的子节点列表。
    fun hirNoKids(): List<Int> {
        return arrayListOf<Int>()
    }

    /// 列表安全取项（越界返回空串）；arena 各流（kinds/texts/tys）
    /// 的下标访问统一走此处，O(1)。
    fun hirItemAt(items: List<String>, index: Int): String {
        if (index < 0 || index >= items.size) {
            return ""
        }
        return items[index]
    }

    /// List<Int> 堆列表安全取项（越界返回空列表）；kids 流的下标访问。
    fun hirKidsItemAt(items: List<List<Int>>, index: Int): List<Int> {
        if (index < 0 || index >= items.size) {
            return arrayListOf<Int>()
        }
        return items[index]
    }

    /// Int 堆列表安全取项（越界返回 0）；span 的 6 条并列流下标访问统一走此处，O(1)。
    fun hirIntAt(items: List<Int>, index: Int): Int {
        if (index < 0 || index >= items.size) {
            return 0
        }
        return items[index]
    }

    /// 向子节点列表追加一个 id。
    /// ⚠️ 2026-09-29 P2.1：改用 List[Int>，均摊 O(1) 追加，取代旧版 O(n) 字符串拼接。
    fun hirKidsAdd(list: List<Int>, child: Int): List<Int> {
        val result: List<Int> = arrayListOf<Int>()
        var i: Int = 0
        while (i < list.size) {
            result.add(list[i])
            i = i + 1
        }
        result.add(child)
        return result
    }

    /// 拼接两个子节点 id 列表（空列表安全）。
    fun hirKidsConcat(a: List<Int>, b: List<Int>): List<Int> {
        val result: List<Int> = arrayListOf<Int>()
        var i: Int = 0
        while (i < a.size) {
            result.add(a[i])
            i = i + 1
        }
        var j: Int = 0
        while (j < b.size) {
            result.add(b[j])
            j = j + 1
        }
        return result
    }

    /// 把 child 插到列表最前。
    fun hirKidsPrepend(list: List<Int>, child: Int): List<Int> {
        val result: List<Int> = arrayListOf<Int>()
        result.add(child)
        var i: Int = 0
        while (i < list.size) {
            result.add(list[i])
            i = i + 1
        }
        return result
    }

    /// 子节点列表的长度。
    fun hirKidsCount(list: List<Int>): Int {
        return list.size
    }

    /// 取子节点列表的第 index 个 id。
    fun hirKidsAt(list: List<Int>, index: Int): Int {
        if (index < 0 || index >= list.size) {
            return -1
        }
        return list[index]
    }

    /// 取第 index 个以 sep 分隔的字段。
    ///
    /// 单次扫描 + 一次切片：旧实现用 substringAfter 链，索引 i 的调用要
    /// 分配 i 个「剩余串」，配合无 GC 的 AOT 运行时是平方级内存黑洞。
    fun hirFieldAt(text: String, index: Int, sep: String): String {
        if (index < 0) {
            return ""
        }
        val len: Int = text.length
        val sepCode: Int = sep.charCodeAt(0)
        var cur: Int = 0
        var start: Int = 0
        var i: Int = 0
        while (i < len) {
            if (text.charCodeAt(i) == sepCode) {
                if (cur == index) {
                    return text.substring(start, i)
                }
                cur = cur + 1
                start = i + 1
            }
            i = i + 1
        }
        if (cur == index) {
            return text.substring(start, len)
        }
        return ""
    }

    /// 十进制字符串 → Int。
    fun hirToIntOf(text: String): Int {
        if (text == "") {
            return 0
        }
        val len: Int = text.length
        var total: Int = 0
        var i: Int = 0
        var neg: Boolean = false
        // 处理负号
        if (len > 0 && text.charCodeAt(0) == 45) {
            neg = true
            i = 1
        }
        while (i < len) {
            // 字符码直接算数字（48 = '0'）。旧写法对每个字符做 10 次
            // 字符串比较，每次比较都要先分配一个临时字符串 —— 该函数被
            // `hirKidsAt` 每个子节点调用一次，是热点分配源。
            val digit: Int = text.charCodeAt(i) - 48
            if (digit >= 0 && digit <= 9) {
                total = total * 10 + digit
            }
            i = i + 1
        }
        if (neg) {
            return -total
        }
        return total
    }}



/// HIR 节点表示（扁平 arena，与 Ast.aura 结构一致）。
class Hir {

    private var kinds: List<String> = arrayListOf<String>()

    /// 节点主文本：标识符名 / 字面量文本 / 运算符（堆列表，换行已转义）。
    private var texts: List<String> = arrayListOf<String>()

    /// 节点类型名（堆列表；无类型信息时为空串）。
    private var tys: List<String> = arrayListOf<String>()

    /// Span 分量（6 条**并列 Int 堆列表**）。
    private var spanStart: List<Int> = arrayListOf<Int>()

    /// 结束偏移。
    private var spanEnd: List<Int> = arrayListOf<Int>()

    /// 起始行。
    private var spanStartLine: List<Int> = arrayListOf<Int>()

    /// 起始列。
    private var spanStartCol: List<Int> = arrayListOf<Int>()

    /// 结束行。
    private var spanEndLine: List<Int> = arrayListOf<Int>()

    /// 结束列。
    private var spanEndCol: List<Int> = arrayListOf<Int>()

    /// 子节点 id 列表（堆列表，每项为 List[Int>，P2.1 取代逗号分隔串）。
    private var kids: List<List<Int>> = arrayListOf<List<Int>>()

    /// 节点总数。
    var count: Int = 0

    /// 根节点 id（由 lower 方法设置）。
    var rootId: Int = 0

    // ── 构造 ──

    /// 追加一个节点，返回其 id。
    ///
    /// 注意：`id` 取 `kinds.size`、并在追加后回写 `count = kinds.size`。
    /// 这样即使 `Hir` 实例被**浅拷贝**（Rust AOT 后端对结构体参数/字段按值传递），
    /// 拷贝与原值仍共享同一组堆列表（`List` = `i8*`），`count` 也能自愈一致；
    /// 否则标量 `count` 会在拷贝间失步（曾导致原生编译器的 HIR 静默为空）。
    fun add(kind: String, text: String, ty: String, sp: Span, children: List<Int>): Int {
        // ⚠️ Initialize lists if null (defensive: constructor may not have been called)
        if (this.kinds == null) { this.kinds = arrayListOf<String>() }
        if (this.texts == null) { this.texts = arrayListOf<String>() }
        if (this.tys == null) { this.tys = arrayListOf<String>() }
        if (this.spanStart == null) { this.spanStart = arrayListOf<Int>() }
        if (this.spanEnd == null) { this.spanEnd = arrayListOf<Int>() }
        if (this.spanStartLine == null) { this.spanStartLine = arrayListOf<Int>() }
        if (this.spanStartCol == null) { this.spanStartCol = arrayListOf<Int>() }
        if (this.spanEndLine == null) { this.spanEndLine = arrayListOf<Int>() }
        if (this.spanEndCol == null) { this.spanEndCol = arrayListOf<Int>() }
        if (this.kids == null) { this.kids = arrayListOf<List<Int>>() }
        val id: Int = this.kinds.size
        this.kinds.add(kind)
        // 手动转义换行符（避免 replace 在 VM 内类调用时未链接）。
        // 绝大多数 text 不含换行：单次 `contains`（C `strstr`，零分配）判定后
        // 直接复用原串，避免逐字符重建长文本（token 文本可达数千字符）。
        var escaped: String = text
        if (text.contains("\n")) {
            val tlen: Int = text.length
            var buf: String = ""
            var i: Int = 0
            while (i < tlen) {
                if (text.charCodeAt(i) == 10) {
                    buf = buf + "\\n"
                } else {
                    buf = buf + text.substring(i, i + 1)
                }
                i = i + 1
            }
            escaped = buf
        }
        this.texts.add(escaped)
        this.tys.add(ty)
        this.spanStart.add(sp.start)
        this.spanEnd.add(sp.end)
        this.spanStartLine.add(sp.startLine)
        this.spanStartCol.add(sp.startCol)
        this.spanEndLine.add(sp.endLine)
        this.spanEndCol.add(sp.endCol)
        this.kids.add(children)
        this.count = this.kinds.size
        return id
    }

    /// 追加一个无类型、无子节点的叶子节点。
    fun leaf(kind: String, text: String, sp: Span): Int {
        return this.add(kind, text, "", sp, HirUtils.hirNoKids())
    }

    // ── 访问 ──

    /// 第 id 个节点的种类。
    fun kindOf(id: Int): String {
        if (this.kinds == null) {
            return ""
        }
        return HirUtils.hirItemAt(this.kinds, id)
    }

    /// 第 id 个节点的主文本。
    fun textOf(id: Int): String {
        if (this.texts == null) {
            return ""
        }
        val raw: String = HirUtils.hirItemAt(this.texts, id)
        // 绝大多数 text 不含换行转义：单次 `contains` 判定后直接复用原串，
        // 避免每次访问都逐字符重建（textOf 是发射期最热访问之一）。
        if (!raw.contains("\\")) {
            return raw
        }
        // 手动反转义换行符（避免 replace 在 VM 内类调用时未链接）
        var result: String = ""
        var i: Int = 0
        var len: Int = raw.length
        while (i < len) {
            if (i + 1 < len && raw.charCodeAt(i) == 92 && raw.charCodeAt(i + 1) == 110) {
                result = result + "\n"
                i = i + 2
            } else {
                result = result + raw.substring(i, i + 1)
                i = i + 1
            }
        }
        return result
    }

    /// 第 id 个节点的类型名。
    fun tyOf(id: Int): String {
        if (this.tys == null) {
            return ""
        }
        return HirUtils.hirItemAt(this.tys, id)
    }

    /// 第 id 个节点的位置。
    fun spanOf(id: Int): Span {
        if (this.spanStart == null) {
            return Span(0, 0, 0, 0, 0, 0)
        }
        return Span(
            HirUtils.hirIntAt(this.spanStart, id), HirUtils.hirIntAt(this.spanEnd, id),
            HirUtils.hirIntAt(this.spanStartLine, id), HirUtils.hirIntAt(this.spanStartCol, id),
            HirUtils.hirIntAt(this.spanEndLine, id), HirUtils.hirIntAt(this.spanEndCol, id)
        )
    }

    /// 第 id 个节点的子节点 id 列表（逗号分隔串，向后兼容旧调用方）。
    fun kidsOf(id: Int): String {
        val k: List<Int> = this.kidsOfList(id)
        var out: String = ""
        var i: Int = 0
        while (i < k.size) {
            if (i > 0) {
                out = out + ","
            }
            out = out + toStr(k[i])
            i = i + 1
        }
        return out
    }

    /// 第 id 个节点的子节点 id 列表（List[Int>，P2.1 新接口）。
    fun kidsOfList(id: Int): List<Int> {
        if (this.kids == null) {
            return HirUtils.hirNoKids()
        }
        return HirUtils.hirKidsItemAt(this.kids, id)
    }

    /// 第 id 个节点的第 i 个子节点 id（越界返回 -1）。
    fun childOf(id: Int, i: Int): Int {
        val k: List<Int> = this.kidsOfList(id)
        if (i >= HirUtils.hirKidsCount(k)) {
            return -1
        }
        return HirUtils.hirKidsAt(k, i)
    }

    // ── 输出 ──

    /// 从根节点开始的缩进文本转储。
    fun dump(): String {
        if (this.count == 0) {
            return "<empty hir>\n"
        }
        return this.dumpNode(this.rootId, 0)
    }

    /// 递归转储单个节点。
    fun dumpNode(id: Int, depth: Int): String {
        var line: String = this.indent(depth) + this.kindOf(id)
        val t: String = this.textOf(id)
        if (t != "") {
            line = line + " " + t
        }
        val ty: String = this.tyOf(id)
        if (ty != "") {
            line = line + " : " + ty
        }
        var out: String = line + "\n"

        val k: List<Int> = this.kidsOfList(id)
        val n: Int = HirUtils.hirKidsCount(k)
        var i: Int = 0
        while (i < n) {
            out = out + this.dumpNode(HirUtils.hirKidsAt(k, i), depth + 1)
            i = i + 1
        }
        return out
    }

    /// 生成 depth 级缩进（每级 2 空格）。
    fun indent(depth: Int): String {
        var s: String = ""
        var i: Int = 0
        while (i < depth) {
            s = s + "  "
            i = i + 1
        }
        return s
    }

    /// 取第 index 行（内部辅助）。
    fun lineAt(text: String, index: Int): String {
        return HirUtils.hirFieldAt(text, index, "\n")
    }
}

// ─────────────────────────────────────────────────────────────
// AST → HIR 降级器
// ─────────────────────────────────────────────────────────────



class HirLowerer {

    private var ast: Ast = Ast()

    /// 输出的 HIR。
    private var hir: Hir = Hir()

    // ── 2026-10-02 接收者类型传播（选项2 / 任务②）──
    // 目标：`vm.loadAucAndRun()` 这类**小写接收者**的方法调用，前端直接限定为
    // `VmRunner_loadAucAndRun`（过去只有"接收者名大写开头"的启发式，小写一律
    // 发裸名 → Photon/AOT 链接期 undefined symbol）。
    //   curTypeDecl   当前类型体名（class/object 体内部非空）
    //   localVarTys   函数内局部量 name=Ty（CSV；函数入口清空）
    //   typeMemberTys 类字段 Class.member=Ty（CSV；类型体声明登记）
    //   typeMethods   类方法 Class.method（CSV；类型体声明预登记，限定前校验，
    //                 防止把 toString 等误限定到不存在的 Class_toString）
    private var curTypeDecl: String = ""

    // P40x-c：当前类型的父类名表（List 条目）。Parser 在 parseTypeDecl 已把
    // 冒号后的首个名字（class Dog : Animal() 的 Animal）记入类型节点 ty 列；
    // lowerTypeDecl 时落表。super.m() 据此解析到父类实现——此前 super 无
    // 分支，落入隐式 this 解析 → 同名方法自递归（实测 test_super_only 栈溢出）。
    // 类型必须 List<String>（String 在 AOT 隐式转换退化，实测驱动段错误）；
    // 成员必须追加在 var 块末尾（对象槽位按声明序编号，插中段即崩）。
    private var classParents: List<String> = arrayListOf<String>()

    // P40x-e：已声明类型名表（CSV，逗号前导）。大写 Ident 接收者的类名约定
    // 静态限定必须先验此表——顶层 val/const 同样大写开头（DEC_INT），此前
    // 一律按类名限定并丢弃接收者 → DEC_INT_toString(mem)（无接收者值）。
    private var knownTypes: String = ""

    // ⚠️ P237：类体方法降级的**接收者注入通道**。lowerStmt 的 Function 分支
    // 在类型体上下文里把它设为类名，lowerFunction 据此：① 方法名限定为
    // `Class_method`；② params 顶部注入 `this: Class` 形参（并登记
    // localVarTys，方法体的 this.xxx / 隐式 this 字段解析依赖它）。
    // 旧实现值类方法展平成**无 this 的裸 @fn**（接收者物化成 @i32_const 0
    // ⇒ String.hashCode → strlen(0)，§10.40/§10.41）。
    private var pendingMethodSelf: String = ""

    // ⚠️ P237：接收者注入的**作用域白名单**——值包装类闭集。`value`/`override`
    // 修饰符在 AST 里不保留（parser 跳过软关键字），无法按修饰符判定；而这
    // 些包装类的 override 方法正是「无 this 展平」家族的全部成员（常规类
    // HashMap/FileUtils 等的既有调用图依赖裸名互调，不能波及）。
    private var valueLikeTypes: String = ",String,Byte,Boolean,Double,Unit,Char,Float,Int,Long,Short,"
    // [MEM-FIX] 2026-10-10：原为 CSV 累积串（`k=v,k=v,…`）——每条声明整段
    // 拷贝已累积串,O(条目²),AOT 无 GC 全驻留(OOM 归因 413MB×3936×6RA
    // ≈2.4GB 的真身,RA 指纹 [67,65,71,65,71] 唯一命中 lowerValDecl/
    // lowerVarDecl)。改为 List<String> 条目(`k=v`),追加 O(1)、查找
    // 零分配线性扫描;csvLookup 语义(精确 key、首条命中)由 kvGet 保持。
    private var localVarTys: List<String> = arrayListOf<String>()
    private var typeMemberTys: List<String> = arrayListOf<String>()
    private var typeMethods: String = ""
    /// 是否正处在类型体的直接成员层（方法体内部为 false）
    private var inTypeBody: Boolean = false
    // 函数/方法名 → 返回类型（`k=v` 条目，预登记期填充；lowerCall 回填
    // HirCall ty —— String 隐式拼接包裹需要它识别非 String 调用结果）。
    // ⚠️ 必须追加在字段块**末尾**：AOT 对象槽位按声明序编号，插中段会把
    // 后续字段槽位整体推歪（实测 llc 报 i32/ptr 混用，见类头注释）。
    private var funcRetTys: List<String> = arrayListOf<String>()

    /// import 别名表（2026-10-17）：行 \nalias|modulePath\n。
    /// `import aura.concurrent as cc` ⇒ `cc.newChannel(0)` 的接收者 cc 是
    /// 模块路径别名而非实例——旧实现降级成 __field_get(0,0) 且泄漏为
    /// arg0 ⇒ rcx=垃圾（实测 11 §11.2/§11.4 段错误）。
    private var importAliasCsv: String = ""

    /// enum 成员序号表（2026-10-16）：行。
    /// ColorKind.RED 折叠为 HirLit(序号)——此前发 __field_get(0,0)
    /// （基址 0 段错误，实测 05-classes §5.11）。
    private var enumMembersCsv: String = ""
    /// 伴生对象常量表（2026-10-16）：行 \nType.name=litText|litTy\n。
    /// `companion object { val BASE: Int = 100 }` 的**字面量**初始化成员
    /// 折叠为编译期常量——此前 MathUtil.BASE 走 __field_get(0,0)（基址 0
    /// 段错误；R62 注释预言的缺口）。非字面量初始化不登记。
    private var companionValsCsv: String = ""

    init() {
        this.ast = Ast()
        this.hir = Hir()
    }

    /// 执行降级，返回 HIR 根节点 id。
    ///
    /// 脚本模式（synthesize_main）：顶层可执行语句会被合成进 `main`，
    /// 见 [`synthesizeMainInKids`]。
    fun lower(program: Ast): Int {
        this.ast = program
        this.hir = Hir()
        // 查找 Program 根节点（可能不在 index 0）
        val n: Int = program.count
        var rootIdx: Int = -1
        var i: Int = 0
        while (i < n) {
            if (program.kindOf(i) == "Program") {
                rootIdx = i
                break
            }
            i = i + 1
        }
        if (rootIdx < 0) {
            rootIdx = 0
        }
        val rootSp: Span = program.spanOf(rootIdx)
        // 根节点是 Program，其子节点是顶层声明（与顶层可执行语句混排）
        val rootKids: List<Int> = program.kidsOfList(rootIdx)
        val kCount: Int = HirUtils.hirKidsCount(rootKids)
        // 2026-10-02 接收者类型传播：**预登记**全部类型体的方法/字段 ——
        // 必须在正式降级前完成，否则方法体内的调用点会早于同类其它方法的登记
        // （typeMethods 不完整 → 限定校验失败 → 仍发裸名）。
        // （2026-10-02：登记累进，不清空 —— localVarTys 由 lowerFunction 清，
        //  curTypeDecl/inTypeBody 由 lowerTypeDecl 保存/恢复。）
        var ri: Int = 0
        while (ri < kCount) {
            val declId: Int = HirUtils.hirKidsAt(rootKids, ri)
            val dk: String = program.kindOf(declId)
            if (dk == "Class" || dk == "Struct" || dk == "Object") {
                val tName: String = program.textOf(declId)
                this.knownTypes = this.knownTypes + "," + tName
                val tKids: List<Int> = program.kidsOfList(declId)
                if (HirUtils.hirKidsCount(tKids) >= 1) {
                    this.preRegisterTypeMembers(tName, HirUtils.hirKidsAt(tKids, 0))
                }
            } else if (dk == "Enum") {
                // enum 成员按声明序编号（parseTypeDecl 枚举分支产
                // ExprStmt(Ident) 挂 body Block）。
                this.registerEnumMembers(program, declId)
            } else if (dk == "Import") {
                // import aura.<path> as <alias> ⇒ 别名表（std 静态调用识别）。
                val itxt: String = program.textOf(declId)
                if (itxt.startsWith("aura.")) {
                    val asIdx: Int = itxt.indexOf(" as ")
                    if (asIdx > 0) {
                        val alias: String = itxt.substring(asIdx + 4, itxt.length)
                        if (alias != "") {
                            this.importAliasCsv = this.importAliasCsv + "\n"
                                    + alias + "|" + itxt.substring(0, asIdx) + "\n"
                        }
                    }
                }
            } else if (dk == "Function") {
                // 顶层函数返回类型预登记（lowerCall 回填 HirCall ty 用）。
                // 同时按 `名/元数` 登记：重载同名不同参各自有类型。
                val fName: String = program.textOf(declId)
                val frty: String = this.cleanTy(program.tyOf(declId))
                if (fName != "" && frty != "") {
                    if (this.kvGet(this.funcRetTys, fName) == "") {
                        this.funcRetTys = this.kvAdd(this.funcRetTys, fName, frty)
                    }
                    val arK: String = fName + "/" + toStr(this.paramCountOf(program, declId))
                    this.funcRetTys = this.kvAdd(this.funcRetTys, arK, frty)
                }
            }
            ri = ri + 1
        }
        var hirKids: List<Int> = HirUtils.hirNoKids()
        i = 0
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(rootKids, i)
            val childHirId: Int = this.lowerDecl(program, childId)
            if (childHirId >= 0) {
                hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
            }
            i = i + 1
        }
        // 脚本模式：顶层可执行语句合成进 main
        hirKids = this.synthesizeMainInKids(hirKids, rootSp)
        val rootHirId: Int = this.hir.add("HirProgram", "", "", rootSp, hirKids)
        this.hir.rootId = rootHirId
        return rootHirId
    }

    /// **脚本模式：隐式 main 合成**（对应 Rust 侧
    /// `synthesize_main_if_missing`，compiler/src/codegen/hir.rs）。
    ///
    /// 入参 `kids` 是顶层节点的 HIR id 列表（`List<Int>`，P2.1 取代逗号分隔串），
    /// 其中混排着两类节点：
    ///   * **声明**：`HirFunction` / `HirValDecl` / `HirVarDecl` / `HirTypeDecl`
    ///     / `HirTypealias` / `HirExternObject` / `HirNativeFunction` / `HirAotDecl`
    ///   * **顶层可执行语句**：`HirCall` / `HirAssign` / `HirWhile` / `HirFor` /
    ///     `HirIf` / `HirBlock` / `HirReturn` / `HirThrow` / …
    ///
    /// **仅在无 main 时合成**：把顶层可执行语句（含顶层 val/var）包成一个
    /// `fun main(): Unit`，插到顶层节点最前。
    /// 已有 main 时原样返回——Aura 侧 Hir 节点不可变且 AOT 发射器按
    /// `hir.count` 全量扫描（`Emit.aura` 函数定义循环），无法「重建」已有 main
    /// 的体；若在此处新建一个 main 节点，旧 main 仍会被发射，产生
    /// `invalid redefinition of function 'main'`。
    /// 与 Rust 侧「splice 到已有 main 体首」的差异：Rust 的 HIR 是可变树，
    /// 可原位改 body；Aura 侧受 VM 列表不可按下标赋值（见 Ast.aura 注释）
    /// 与发射器全量扫描的双重约束，暂只支持「无 main」这一分支。
    fun synthesizeMainInKids(kids: List<Int>, sp: Span): List<Int> {
        // 第一遍：是否已有 main
        var mainId: Int = -1
        var i: Int = 0
        while (i < HirUtils.hirKidsCount(kids)) {
            val id: Int = HirUtils.hirKidsAt(kids, i)
            if (this.hir.kindOf(id) == "HirFunction" && this.hir.textOf(id) == "main") {
                mainId = id
                break
            }
            i = i + 1
        }
        if (mainId >= 0) {
            // P40x-f：顶层 val/var 拼接进已存在 main 的体首（seed hir.rs
            // splice 同款）。此前「已有 main 不合成」→ 顶层 val 存储丢失，
            // 函数内引用读野槽（实测 p15：顶层 val .toString() 段错误）。
            var valKids: List<Int> = HirUtils.hirNoKids()
            var hasVal: Boolean = false
            var j: Int = 0
            while (j < HirUtils.hirKidsCount(kids)) {
                val id: Int = HirUtils.hirKidsAt(kids, j)
                val k: String = this.hir.kindOf(id)
                if (k == "HirValDecl" || k == "HirVarDecl") {
                    valKids = HirUtils.hirKidsAdd(valKids, id)
                    hasVal = true
                }
                j = j + 1
            }
            if (!hasVal) { return kids }
            val mKids: List<Int> = this.hir.kidsOfList(mainId)
            if (HirUtils.hirKidsCount(mKids) < 1) { return kids }
            val oldBody: Int = HirUtils.hirKidsAt(mKids, 0)
            val bodyStmts: List<Int> = this.hir.kidsOfList(oldBody)
            var newStmts: List<Int> = valKids
            var si: Int = 0
            while (si < HirUtils.hirKidsCount(bodyStmts)) {
                newStmts = HirUtils.hirKidsAdd(newStmts, HirUtils.hirKidsAt(bodyStmts, si))
                si = si + 1
            }
            val newBody: Int = this.hir.add("HirBlock", "", "", this.hir.spanOf(oldBody), newStmts)
            var mNewKids: List<Int> = HirUtils.hirKidsAdd(HirUtils.hirNoKids(), newBody)
            var mi: Int = 1
            while (mi < HirUtils.hirKidsCount(mKids)) {
                mNewKids = HirUtils.hirKidsAdd(mNewKids, HirUtils.hirKidsAt(mKids, mi))
                mi = mi + 1
            }
            val newMain: Int = this.hir.add("HirFunction", "main", this.hir.tyOf(mainId),
                this.hir.spanOf(mainId), mNewKids)
            var outKids: List<Int> = HirUtils.hirNoKids()
            j = 0
            while (j < HirUtils.hirKidsCount(kids)) {
                val id2: Int = HirUtils.hirKidsAt(kids, j)
                if (id2 == mainId) {
                    outKids = HirUtils.hirKidsAdd(outKids, newMain)
                } else {
                    outKids = HirUtils.hirKidsAdd(outKids, id2)
                }
                j = j + 1
            }
            return outKids
        }
        // 第二遍：无 main，收集顶层可执行语句。
        //
        // 顶层 val/var 归为「语句」：进入合成的 main 体成为局部变量。
        // 这是脚本模式的关键——`var i = 0` 之后的 `i = i + 1` 必须作用在
        // 同一变量上，否则循环变量被当全局符号解析、赋值丢失（实测 while 死循环）。
        var declKids: List<Int> = HirUtils.hirNoKids()
        var stmtKids: List<Int> = HirUtils.hirNoKids()
        i = 0
        while (i < HirUtils.hirKidsCount(kids)) {
            val id: Int = HirUtils.hirKidsAt(kids, i)
            if (this.isHirDeclaration(id, false)) {
                declKids = HirUtils.hirKidsAdd(declKids, id)
            } else {
                stmtKids = HirUtils.hirKidsAdd(stmtKids, id)
            }
            i = i + 1
        }
        if (stmtKids == HirUtils.hirNoKids()) {
            // 无顶层可执行语句：无需合成
            return kids
        }
        val body: Int = this.hir.add("HirBlock", "", "", sp, stmtKids)
        val newMain: Int = this.hir.add("HirFunction", "main", "Unit", sp,
            HirUtils.hirKidsAdd(HirUtils.hirNoKids(), body))
        return HirUtils.hirKidsPrepend(declKids, newMain)
    }

    /// 判断 HIR 节点是否为顶层「声明」（与顶层可执行语句相对）。
    ///
    /// `treatTopLevelValAsDeclaration` 为假时，顶层 `HirValDecl` / `HirVarDecl`
    /// 归为语句，进入合成的 main 体成为局部变量——见 [`synthesizeMainInKids`]。
    fun isHirDeclaration(hirId: Int, treatTopLevelValAsDeclaration: Boolean): Boolean {
        val k: String = this.hir.kindOf(hirId)
        if (k == "HirFunction" || k == "HirTypeDecl" || k == "HirTypealias"
            || k == "HirExternObject" || k == "HirNativeFunction" || k == "HirAotDecl") {
            return true
        }
        if (k == "HirValDecl" || k == "HirVarDecl") {
            return treatTopLevelValAsDeclaration
        }
        return false
    }

    /// 在子节点 id 列表中把 oldId 原位替换为 newId（脚本模式 splice 用）。
    fun hirKidsReplace(list: List<Int>, oldId: Int, newId: Int): List<Int> {
        val result: List<Int> = arrayListOf<Int>()
        var i: Int = 0
        while (i < list.size) {
            val c: Int = list[i]
            if (c == oldId) {
                result.add(newId)
            } else {
                result.add(c)
            }
            i = i + 1
        }
        return result
    }

    // ── 多模块合并（Phase 6.5.10：把多个 AST 的顶层声明降级进同一 HIR）──

    /// 设置目标 HIR（供模块链接器在多个源文件间共享同一产物）。
    fun useHir(target: Hir) {
        this.hir = target
    }

    /// 把 `program` 的顶层声明降级进当前 HIR，返回声明 id 列表（`List<Int>`）。
    ///
    /// 与 [`lower`] 的区别：不新建 HIR、不添加 `HirProgram` 根，
    /// 只产出顶层声明，供模块链接器拼接。
    ///
    /// **必须返回 `List<Int>`（而非逗号分隔串）**：`Hir.kids` 与
    /// `Hir.add(..., children: List<Int>)` 自 P2.1 起全部以堆列表承载子节点。
    /// 旧实现声明返回 `String` 却直接 `return out`（`out: List<Int>`），把列表
    /// 句柄当字符串一路传给 `ModuleLinkUtils.appendKids` / `synthesizeMainInKids`；
    /// 后者按 `list.size` 读取该句柄 —— `ArrayList<Int>` 的 `len` 字段是
    /// 小端 8 字节，被 `strlen` 读成 1~2，再被逗号拼接成垃圾串，最终在
    /// `synthesizeMainInKids` 里被 `hirKidsAt` 解成野 id（Photon 前端链接阶段
    /// 0xC0000005 的根因）。
    /// [R89] ModuleLink scratchRewind 前调用：置空本模块 AST 引用，
    /// 防止字段悬挂指向已被 scratch 回收的内存（后续读=碎尸）。
    fun releaseAst() {
        this.ast = Ast()
}

    fun lowerTopLevel(program: Ast): List<Int> {
        this.ast = program
        // 2026-10-02 接收者类型传播：本模块类型体的方法/字段**预登记**。
        // ModuleLink 链路逐模块调 lowerTopLevel，登记累进到 loader 实例
        // （跨模块共享，不清空 —— 局部表由 lowerFunction 清，类型体状态由
        // lowerTypeDecl 保存/恢复）。
        val pn2: Int = program.count
        var ppi: Int = 0
        while (ppi < pn2) {
            val declId: Int = ppi
            val dk: String = program.kindOf(declId)
            if (dk == "Class" || dk == "Struct" || dk == "Object") {
                val tName: String = program.textOf(declId)
                this.knownTypes = this.knownTypes + "," + tName
                val tKids: List<Int> = program.kidsOfList(declId)
                if (HirUtils.hirKidsCount(tKids) >= 1) {
                    this.preRegisterTypeMembers(tName, HirUtils.hirKidsAt(tKids, 0))
                }
            } else if (dk == "Enum") {
                // enum 成员按声明序编号（parseTypeDecl 枚举分支产
                // ExprStmt(Ident) 挂 body Block）。
                this.registerEnumMembers(program, declId)
            } else if (dk == "Import") {
                // import aura.<path> as <alias> ⇒ 别名表（std 静态调用识别）。
                val itxt: String = program.textOf(declId)
                if (itxt.startsWith("aura.")) {
                    val asIdx: Int = itxt.indexOf(" as ")
                    if (asIdx > 0) {
                        val alias: String = itxt.substring(asIdx + 4, itxt.length)
                        if (alias != "") {
                            this.importAliasCsv = this.importAliasCsv + "\n"
                                    + alias + "|" + itxt.substring(0, asIdx) + "\n"
                        }
                    }
                }
            } else if (dk == "Function") {
                // 顶层函数返回类型预登记（lowerCall 回填 HirCall ty 用）。
                // 同时按 `名/元数` 登记：重载同名不同参各自有类型。
                val fName: String = program.textOf(declId)
                val frty: String = this.cleanTy(program.tyOf(declId))
                if (fName != "" && frty != "") {
                    if (this.kvGet(this.funcRetTys, fName) == "") {
                        this.funcRetTys = this.kvAdd(this.funcRetTys, fName, frty)
                    }
                    val arK: String = fName + "/" + toStr(this.paramCountOf(program, declId))
                    this.funcRetTys = this.kvAdd(this.funcRetTys, arK, frty)
                }
            }
            ppi = ppi + 1
        }
        val n: Int = program.count
        var rootIdx: Int = -1
        var i: Int = 0
        while (i < n) {
            if (program.kindOf(i) == "Program") {
                rootIdx = i
                break
            }
            i = i + 1
        }
        if (rootIdx < 0) {
            return HirUtils.hirNoKids()
        }
        val rootKids: List<Int> = program.kidsOfList(rootIdx)
        val kCount: Int = HirUtils.hirKidsCount(rootKids)
        var out: List<Int> = HirUtils.hirNoKids()
        i = 0
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(rootKids, i)
            val h: Int = this.lowerDecl(program, childId)
            if (h >= 0) {
                out = HirUtils.hirKidsAdd(out, h)
            }
            i = i + 1
        }
        return out
    }

    // ── 声明降级 ──

    /// 降级一个顶层节点。
    fun lowerDecl(ast: Ast, id: Int): Int {
        val kind: String = ast.kindOf(id)
        val text: String = ast.textOf(id)
        val ty: String = ast.tyOf(id)
        val sp: Span = ast.spanOf(id)
        val kids: List<Int> = ast.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        if (kind == "Function") {
            return this.lowerFunction(ast, id)
        } else if (kind == "ValDecl") {
            return this.lowerValDecl(ast, id)
        } else if (kind == "VarDecl") {
            return this.lowerVarDecl(ast, id)
        } else if (kind == "Struct" || kind == "Class" || kind == "Object" || kind == "Enum") {
            return this.lowerTypeDecl(ast, id)
        } else if (kind == "ExternObject") {
            // extern object { @native ... / export fun ... / @aot fun ... }
            return this.lowerExternObject(ast, id)
        } else if (kind == "NativeMethod") {
            return this.lowerNativeMethod(ast, id)
        } else if (kind == "ExportMethod") {
            return this.lowerExportMethod(ast, id)
        } else if (kind == "AotMethod") {
            return this.lowerAotMethod(ast, id)
        } else if (kind == "Typealias") {
            // Typealias 在 HIR 中保留为注释性节点
            return this.hir.leaf("HirTypealias", text, sp)
        } else {
            // Import / Package 是元信息，不参与 HIR
            if (kind == "Import" || kind == "Package" || kind == "Empty") {
                return -1
            }
            // 顶层**可执行语句**（脚本模式）：parseStatement 产出的是
            // ExprStmt / Assign / If / While / For / Try / Return / Block /
            // Break / Continue / DoWhile 等**语句节点**，必须走 lowerStmt；
            // 直接走 lowerExpr 会把 ExprStmt 落到「未知种类」分支，退化成
            // 一个无子节点的 `HirExpr` 叶子（`HirExpr: ExprStmt`），
            // 语句体被整个丢弃（顶层 println 静默不执行）。
            if (kind == "ExprStmt" || kind == "Assign" || kind == "If"
                || kind == "While" || kind == "DoWhile" || kind == "For"
                || kind == "CFor" || kind == "Try" || kind == "Return"
                || kind == "Block" || kind == "Break" || kind == "Continue"
                || kind == "Throw" || kind == "Lambda" || kind == "Closure"
                || kind == "Defer" || kind == "InitBlock") {
                return this.lowerStmt(ast, id)
            }
            return this.lowerExpr(ast, id)
        }
    }

    /// 降级函数声明。
    fun lowerFunction(ast: Ast, id: Int): Int {
        // 2026-10-02 接收者类型传播：局部类型表按函数清空（作用域边界）。
        this.localVarTys = arrayListOf<String>()
        var name: String = ast.textOf(id)
        val retTy: String = ast.tyOf(id)
        val sp: Span = ast.spanOf(id)
        val kids: List<Int> = ast.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        var paramsStr: List<Int> = HirUtils.hirNoKids()
        var bodyId: Int = -1

        // ⚠️ P237：类体方法 → 限定名 `Class_method` + 顶部注入 `this` 形参。
        // 通道由 lowerStmt 的 Function 分支设置（仅类型体上下文非空）。
        if (this.pendingMethodSelf != "") {
            name = this.pendingMethodSelf + "_" + name
            val thisParam: Int = this.hir.add("HirParam", "this",
                this.pendingMethodSelf, sp, HirUtils.hirNoKids())
            paramsStr = HirUtils.hirKidsAdd(paramsStr, thisParam)
            // 接收者登记（方法体 this.length / this.charCodeAt 的派发依赖）
            this.localVarTys = this.kvAdd(this.localVarTys, "this", this.pendingMethodSelf)
            this.pendingMethodSelf = ""
        }

        // 子节点 0: Params 节点
        if (kCount > 0) {
            val paramsNodeId: Int = HirUtils.hirKidsAt(kids, 0)
            val paramsKids: List<Int> = ast.kidsOfList(paramsNodeId)
            val pkCount: Int = HirUtils.hirKidsCount(paramsKids)
            var pi: Int = 0
            while (pi < pkCount) {
                val pId: Int = HirUtils.hirKidsAt(paramsKids, pi)
                val pName: String = ast.textOf(pId)
                val pTy: String = this.cleanTy(ast.tyOf(pId))
                // 2026-10-02 接收者类型传播：参数登记进 localVarTys（List 参数
                // 接收者的 .size()/.get() 限定依赖它 —— 实测 registerAucClasses
                // 的 names.size()/parentIds.get(i) 全靠此登记）。
                if (pTy != "" && this.localVarTy(pName) == "") {
                    this.localVarTys = this.kvAdd(this.localVarTys, pName, pTy)
                }
                val pSp: Span = ast.spanOf(pId)
                // 默认参数值：作为 HirParam 的 kids[0]，供调用点补齐实参
                var pKids: List<Int> = HirUtils.hirNoKids()
                val pAstKids: List<Int> = ast.kidsOfList(pId)
                if (HirUtils.hirKidsCount(pAstKids) > 0) {
                    val dId: Int = this.lowerExpr(ast, HirUtils.hirKidsAt(pAstKids, 0))
                    if (dId >= 0) {
                        pKids = HirUtils.hirKidsAdd(pKids, dId)
                    }
                }
                val paramId: Int = this.hir.add("HirParam", pName, pTy, pSp, pKids)
                paramsStr = HirUtils.hirKidsAdd(paramsStr, paramId)
                pi = pi + 1
            }
        }

        // 子节点 1: 函数体（Block 或单个表达式）
        if (kCount > 1) {
            val bodyAstId: Int = HirUtils.hirKidsAt(kids, 1)
            if (ast.kindOf(bodyAstId) == "Block") {
                bodyId = this.lowerBlockOrExpr(ast, bodyAstId)
            } else {
                // 表达式体函数 `fun f(x: Int): Int = x * x`：必须包装成
                // `return <expr>`，否则函数体是一个裸表达式，发射器按语句求值后
                // 落到「隐式返回零值」路径 —— 实测 `square(5)` 恒得 0。
                val e: Int = this.lowerExpr(ast, bodyAstId)
                if (e >= 0) {
                    bodyId = this.hir.add("HirReturn", "", "",
                        ast.spanOf(bodyAstId), HirUtils.hirKidsAdd(HirUtils.hirNoKids(), e))
                }
            }
        }

        // 构造 HirFunction 节点
        var hirKids: List<Int> = paramsStr
        if (bodyId >= 0) {
            hirKids = HirUtils.hirKidsAdd(hirKids, bodyId)
        }
        return this.hir.add("HirFunction", name, retTy, sp, hirKids)
    }

    // ── FFI 声明降级（Phase C.2：@native / export / @aot）──
    //
    // Aura 侧 AOT 发射器（Emit.aura）只消费 HIR；`extern object` 内的
    // `@native(...)` / `export fun` / `@aot fun` 若在此被丢弃，发射出的模块
    // 就会缺少这些符号的 LLVM 定义（自举编译器编译 `Syscalls.aura` 一类
    // 源码时直接崩溃/链接失败）。这里把它们降级为 HIR 节点：
    //   * HirNativeFunction  `@native(N)` / `native fun` / `@native(asm=…)`
    //     kids = [HirNativeInfo(metadata), HirParam…]
    //   * HirExportFunction  `export fun`（按普通函数发射，符号默认外部可见）
    //   * HirAotDecl         `@aot fun`（AOT 库函数 → declare）
    // 均不带函数体（原生/外部符号由 C 运行库或目标库提供）。

    /// 降级 extern object：容器节点，其方法在 Block 子节点内。
    ///
    /// 容器自身不生成 IR（`HirExternObject` 仅承载分组信息），
    /// 方法各自降级为独立的 arena 节点（供发射器按 kind 扫描）。
    fun lowerExternObject(ast: Ast, id: Int): Int {
        val name: String = ast.textOf(id)
        val sp: Span = ast.spanOf(id)
        val kids: List<Int> = ast.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        var hirKids: List<Int> = HirUtils.hirNoKids()
        var i: Int = 0
        while (i < kCount) {
            val bodyId: Int = HirUtils.hirKidsAt(kids, i)
            if (ast.kindOf(bodyId) == "Block") {
                val bodyKids: List<Int> = ast.kidsOfList(bodyId)
                val bn: Int = HirUtils.hirKidsCount(bodyKids)
                var j: Int = 0
                while (j < bn) {
                    val h: Int = this.lowerDecl(ast, HirUtils.hirKidsAt(bodyKids, j))
                    if (h >= 0) {
                        hirKids = HirUtils.hirKidsAdd(hirKids, h)
                    }
                    j = j + 1
                }
            } else {
                val h: Int = this.lowerDecl(ast, bodyId)
                if (h >= 0) {
                    hirKids = HirUtils.hirKidsAdd(hirKids, h)
                }
            }
            i = i + 1
        }
        return this.hir.add("HirExternObject", name, "", sp, hirKids)
    }

    /// 降级 @native / native 方法 → `HirNativeFunction`。
    ///
    /// AST 形状：`NativeMethod(kids=[NativeInfo(metadata), Function])`；
    /// metadata 取值：`native|SYS_READ`（syscall）/ `asm|<code>` / `native`（内置）。
    fun lowerNativeMethod(ast: Ast, id: Int): Int {
        val kids: List<Int> = ast.kidsOfList(id)
        if (HirUtils.hirKidsCount(kids) < 2) {
            return -1
        }
        val infoId: Int = HirUtils.hirKidsAt(kids, 0)
        val meta: String = ast.textOf(infoId)
        val fnId: Int = HirUtils.hirKidsAt(kids, 1)
        if (ast.kindOf(fnId) != "Function") {
            return -1
        }
        var outKids: List<Int> = HirUtils.hirNoKids()
        outKids = HirUtils.hirKidsAdd(outKids, this.hir.leaf("HirNativeInfo", meta, ast.spanOf(infoId)))
        outKids = HirUtils.hirKidsConcat(outKids, this.lowerParamIds(ast, fnId))
        return this.hir.add("HirNativeFunction", ast.textOf(fnId), ast.tyOf(fnId),
            ast.spanOf(fnId), outKids)
    }

    /// 降级 `export fun`：按普通函数发射（LLVM `define` 默认外部链接，
    /// 符号即可被 C/其他模块解析）。
    fun lowerExportMethod(ast: Ast, id: Int): Int {
        val kids: List<Int> = ast.kidsOfList(id)
        if (HirUtils.hirKidsCount(kids) < 1) {
            return -1
        }
        val fnId: Int = HirUtils.hirKidsAt(kids, 0)
        if (ast.kindOf(fnId) != "Function") {
            return -1
        }
        return this.lowerFunction(ast, fnId)
    }

    /// 降级 `@aot fun`：AOT 库函数，发射为外部 `declare`（库在链接期解析）。
    fun lowerAotMethod(ast: Ast, id: Int): Int {
        val kids: List<Int> = ast.kidsOfList(id)
        if (HirUtils.hirKidsCount(kids) < 2) {
            return -1
        }
        val fnId: Int = HirUtils.hirKidsAt(kids, 1)
        if (ast.kindOf(fnId) != "Function") {
            return -1
        }
        val paramIds: String = this.lowerParamIds(ast, fnId)
        return this.hir.add("HirAotDecl", ast.textOf(fnId), ast.tyOf(fnId),
            ast.spanOf(fnId), paramIds)
    }

    /// 降级函数形参 → `HirParam` id 列表（逗号分隔；fkids[0] 为 Params）。
    fun lowerParamIds(ast: Ast, fnId: Int): String {
        val kids: List<Int> = ast.kidsOfList(fnId)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        var out: List<Int> = HirUtils.hirNoKids()
        var i: Int = 0
        while (i < kCount) {
            val kidId: Int = HirUtils.hirKidsAt(kids, i)
            if (ast.kindOf(kidId) == "Params") {
                val pk: List<Int> = ast.kidsOfList(kidId)
                val pn: Int = HirUtils.hirKidsCount(pk)
                var j: Int = 0
                while (j < pn) {
                    val pId: Int = HirUtils.hirKidsAt(pk, j)
                    if (ast.kindOf(pId) == "Param") {
                        val h: Int = this.hir.add("HirParam", ast.textOf(pId),
                            ast.tyOf(pId), ast.spanOf(pId), HirUtils.hirNoKids())
                        out = HirUtils.hirKidsAdd(out, h)
                    }
                    j = j + 1
                }
            }
            i = i + 1
        }
        return out
    }

    /// 降级 val 声明。
    fun lowerValDecl(ast: Ast, id: Int): Int {
        val name: String = ast.textOf(id)
        var ty: String = ast.tyOf(id)
        val sp: Span = ast.spanOf(id)
        val kids: List<Int> = ast.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        var hirKids: List<Int> = HirUtils.hirNoKids()
        if (kCount > 0) {
            val initId: Int = HirUtils.hirKidsAt(kids, 0)
            // Lambda 提升（R81）：`val f = x -> e` ⇒ 函数 f(x)=e，
            // ValDecl 本体省略（无一等函数值，直呼 f(…) 走函数调用）。
            if (ast.kindOf(initId) == "Lambda") {
                val lifted: Int = this.lowerLambdaLift(ast, name, initId)
                if (lifted >= 0) { return lifted }
            }
            val initHirId: Int = this.lowerExpr(ast, initId)
            hirKids = HirUtils.hirKidsAdd(hirKids, initHirId)
            // 无显式类型标注时，从初始化表达式推断（Phase 6.5.7）。
            // ⚠️ 门槛必须用 cleanTy（剥可见性前缀后判空）：parseDecl 无标注时
            // ty 列是 prsVisTy("") = "#public|"（**非空**），按 ty=="" 判会
            // 整体跳过推断 ⇒ 变量类型丢失 ⇒ String 拼接不包裹 ⇒ 段错误
            //（实测 `val x = 5` 崩、`val x: Int = 5` 正常）。
            if (this.cleanTy(ty) == "" && initHirId >= 0) {
                ty = this.hir.tyOf(initHirId)
            }
            // 2026-10-02：注解在解析器侧丢失（实测 `val vm: VmRunner = VmRunner()`
            // 的节点 ty 只剩 "#public|"）时，从构造器调用推断 —— 大写命名的
            // 初始化调用即类名。
            // R51：**只认空类型**，不再认标量类型。旧门槛 `ty == "" || isScalarTy(ty)`
            // 会在 `val a = Vec2()`（Vec2 是小写开头的类）这类形态上把已推断出的
            // 正确标量类型整体覆盖成 callee 名，下游 localTypes 记成
            // `a|Vec2` ⇒ 接收者定型错位（见 R51val/R51var 探针）。
            if (this.cleanTy(ty) == "" && initHirId >= 0
                && this.hir.kindOf(initHirId) == "HirCall") {
                val calleeNm: String = this.hir.textOf(initHirId)
                if (calleeNm.length() > 0) {
                    val fc3: Int = calleeNm.substring(0, 1).charCodeAt(0)
                    if (fc3 >= 65 && fc3 <= 90) {
                        ty = calleeNm
                    }
                }
            }
        }
        // 2026-10-02 接收者类型传播：登记局部/字段类型。
        // 类型体直接成员 → typeMemberTys（隐式 this 字段解析用）；
        // 函数内局部 → localVarTys（局部接收者解析用）。
        val cty: String = this.cleanTy(ty)
        if (cty != "") {
            if (this.inTypeBody && this.curTypeDecl != "") {
                this.typeMemberTys = this.kvAdd(this.typeMemberTys, this.curTypeDecl + "." + name, cty)
            }
            this.localVarTys = this.kvAdd(this.localVarTys, name, cty)
        }
        return this.hir.add("HirValDecl", name, ty, sp, hirKids)
    }

    /// 降级 var 声明。
    fun lowerVarDecl(ast: Ast, id: Int): Int {
        val name: String = ast.textOf(id)
        var ty: String = ast.tyOf(id)
        val sp: Span = ast.spanOf(id)
        val kids: List<Int> = ast.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        var hirKids: List<Int> = HirUtils.hirNoKids()
        if (kCount > 0) {
            val initId: Int = HirUtils.hirKidsAt(kids, 0)
            if (ast.kindOf(initId) == "Lambda") {
                val lifted: Int = this.lowerLambdaLift(ast, name, initId)
                if (lifted >= 0) { return lifted }
            }
            val initHirId: Int = this.lowerExpr(ast, initId)
            hirKids = HirUtils.hirKidsAdd(hirKids, initHirId)
            // 门槛同 lowerValDecl：必须 cleanTy（"#public|" 非空但无类型）。
            if (this.cleanTy(ty) == "" && initHirId >= 0) {
                ty = this.hir.tyOf(initHirId)
            }
            // 2026-10-02：同 lowerValDecl —— 注解丢失时从构造器调用推断类型。
            // R51：同 lowerValDecl，只认空类型（见那里的说明）。
            if (this.cleanTy(ty) == "" && initHirId >= 0
                && this.hir.kindOf(initHirId) == "HirCall") {
                val calleeNm: String = this.hir.textOf(initHirId)
                if (calleeNm.length() > 0) {
                    val fc3: Int = calleeNm.substring(0, 1).charCodeAt(0)
                    if (fc3 >= 65 && fc3 <= 90) {
                        ty = calleeNm
                    }
                }
            }
        }
        val cty: String = this.cleanTy(ty)
        if (cty != "") {
            if (this.inTypeBody && this.curTypeDecl != "") {
                this.typeMemberTys = this.kvAdd(this.typeMemberTys, this.curTypeDecl + "." + name, cty)
            }
            this.localVarTys = this.kvAdd(this.localVarTys, name, cty)
        }
        return this.hir.add("HirVarDecl", name, ty, sp, hirKids)
    }

    /// 降级类型声明（struct/class/object/enum）。
    fun lowerTypeDecl(ast: Ast, id: Int): Int {
        val kind: String = ast.kindOf(id)
        val name: String = ast.textOf(id)
        val sp: Span = ast.spanOf(id)
        val kids: List<Int> = ast.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        // 2026-10-02：进入类型体 —— 记录当前类型名（this 限定 / 隐式 this 字段
        // 解析用）。成员（方法/字段）已在 lower() 的预登记遍历里进入
        // typeMethods / typeMemberTys。
        val prevTypeDecl: String = this.curTypeDecl
        val prevInTypeBody: Boolean = this.inTypeBody
        this.curTypeDecl = name
        this.inTypeBody = true
        // P40x-c：登记父类名（ty 列，Parser 已写入）
        val parentName: String = this.cleanTy(ast.tyOf(id))
        if (parentName != "" && parentName != name) {
            this.classParents = this.kvAdd(this.classParents, name, parentName)
        }

        var hirKids: List<Int> = HirUtils.hirNoKids()
        if (kCount > 0) {
            // 类型体的 Block
            val bodyId: Int = HirUtils.hirKidsAt(kids, 0)
            val bodyHirId: Int = this.lowerBlockOrExpr(ast, bodyId)
            if (bodyHirId >= 0) {
                hirKids = HirUtils.hirKidsAdd(hirKids, bodyHirId)
            }
        }
        this.curTypeDecl = prevTypeDecl
        this.inTypeBody = prevInTypeBody

        val hirKind: String = if (kind == "Struct") { "HirStruct" }
            else if (kind == "Class") { "HirClass" }
            else if (kind == "Object") { "HirObject" }
            else { "HirEnum" }
        // ty 列承载**基类名**（`class Dog : Animal()` → "Animal"）：
        // 发射器据此解析 `super.m()` 与继承方法的回退查找
        return this.hir.add(hirKind, name, ast.tyOf(id), sp, hirKids)
    }

    // ── 块/表达式降级 ──

    /// 降级块或表达式（用于函数体等）。
    fun lowerBlockOrExpr(ast: Ast, id: Int): Int {
        val kind: String = ast.kindOf(id)
        if (kind == "Block") {
            return this.lowerBlock(ast, id)
        } else {
            return this.lowerExpr(ast, id)
        }
    }

    /// 降级 if/when 分支：块 / **单条语句** / 表达式。
    ///
    /// `Parser.parseBranch` 对无花括号的分支走 `parseStatement`，因此分支可能
    /// 是 `Assign` / `ExprStmt` / `Return` / `ValDecl` 等**语句节点**；这些必须
    /// 经 `lowerStmt` 降级并包一层 `HirBlock`（发射器按「块或表达式」消费分支，
    /// 单条语句直接放进值位置会丢失副作用）。
    fun lowerBranch(ast: Ast, id: Int): Int {
        val kind: String = ast.kindOf(id)
        if (kind == "Block") {
            return this.lowerBlock(ast, id)
        }
        // ⚠️ `else if` 的 else 是 **If 节点**：必须按语句降级并**包成 HirBlock**。
        // 旧实现无此分支 → 落到 lowerExpr → lowerIfExpr 产出**裸 HirIfExpr**
        //（无 HirBlock 包裹）→ SsaBuilder.buildIf 的 else 路径调 buildBlock
        // 把 HirIfExpr 的子节点当语句迭代：条件（HirBinary）与嵌套
        // HirIfExpr 链被 buildStmt 静默跳过（无 HirIfExpr 用例），只有第一个
        // else-if 的 then 体被**无条件**发射 ⇒ 所有 else-if 链坍缩成
        // `if (c0) A else { B }`（实测 readConstValue 的 tag==1/2/3 分支全部
        // 丢失 ⇒ 装载链读出垃圾常量 → streq 野指针崩溃，2026-10-06）。
        // seed Rust 前端无此缺陷，故只有 photon / 纯 Aura 自举链受影响。
        if (kind == "If") {
            val s: Int = this.lowerStmt(ast, id)
            if (s < 0) {
                return -1
            }
            var bk: List<Int> = HirUtils.hirKidsAdd(HirUtils.hirNoKids(), s)
            return this.hir.add("HirBlock", "", "", ast.spanOf(id), bk)
        }
        if (kind == "Assign" || kind == "ExprStmt" || kind == "Return"
            || kind == "ValDecl" || kind == "VarDecl" || kind == "While"
            || kind == "For" || kind == "CFor" || kind == "Break"
            || kind == "Continue" || kind == "Try") {
            val s: Int = this.lowerStmt(ast, id)
            if (s < 0) {
                return -1
            }
            var bk: List<Int> = HirUtils.hirKidsAdd(HirUtils.hirNoKids(), s)
            return this.hir.add("HirBlock", "", "", ast.spanOf(id), bk)
        }
        return this.lowerExpr(ast, id)
    }

    /// 降级语句块。
    fun lowerBlock(ast: Ast, id: Int): Int {
        return this.lowerBlockWithKind(ast, id, "HirBlock")
    }

    /// 通用块降级：kind 参数用于区分「普通 HirBlock」与「伴生对象体」
    /// （后者用 "HirCompanionBlock" 标记，SsaBuilder 侧据此跳过 `@this` 注入）。
    ///
    /// 伴生对象体的函数在 HIR 层就带 `Class_` 前缀（如 `add` → `MathUtil_add`），
    /// 这样 SsaBuilder 把伴生函数当自由函数处理时（不设 ownerCls），发射出的
    /// 符号名与调用点 `@call @MathUtil_add(...)` 一致。
    ///
    /// ⚠️ 伴生 `val`/`var`（如 `val BASE: Int = 100`）**当前不降级**——
    /// 伴生 val 的运行时支持需要单例承载（`MathUtil.getInstance().BASE`），
    /// 而 photon 后端尚未实现单例合成。若把伴生 val 当类字段降级，
    /// 调用侧 `MathUtil.BASE` 会退化成 `__field_get(0, idx)`（this=0）⇒
    /// 段错误（实测 05-classes §5.8）。这里直接跳过，牺牲运行时输出完整性
    /// 换取不崩溃；调用点 `MathUtil.BASE.toString()` 会走通用路径（可能返回
    /// 0/空串），至少不会崩。
    private fun lowerBlockWithKind(ast: Ast, id: Int, hirKind: String): Int {
        val sp: Span = ast.spanOf(id)
        val kids: List<Int> = ast.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        var hirKids: List<Int> = HirUtils.hirNoKids()
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            val childKind: String = ast.kindOf(childId)
            // 伴生 val/var：跳过（单例未实现，避免 this=0 段错误）
            if (hirKind == "HirCompanionBlock"
                    && (childKind == "ValDecl" || childKind == "VarDecl")) {
                i = i + 1
                continue
            }
            val childHirId: Int = this.lowerStmt(ast, childId)
            // 伴生对象体：给函数名加 `Class_` 前缀（如 `add` → `MathUtil_add`）。
            // 只对 HirFunction 生效；其他节点保持原名。
            if (hirKind == "HirCompanionBlock" && childHirId >= 0
                    && this.hir.kindOf(childHirId) == "HirFunction"
                    && this.curTypeDecl != "") {
                val origName: String = this.hir.textOf(childHirId)
                val newName: String = this.curTypeDecl + "_" + origName
                hirKids = HirUtils.hirKidsAdd(hirKids,
                    this.renameHirNode(childHirId, newName))
            } else if (childHirId >= 0) {
                hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
            }
            i = i + 1
        }
        return this.hir.add(hirKind, "", "", sp, hirKids)
    }

    /// 克隆 HirFunction 节点到新名字（arena 只读，不能原地改名）。
    private fun renameHirNode(nodeId: Int, newName: String): Int {
        val oldName: String = this.hir.textOf(nodeId)
        val ty: String = this.hir.tyOf(nodeId)
        val sp: Span = this.hir.spanOf(nodeId)
        val kids: List<Int> = this.hir.kidsOfList(nodeId)
        return this.hir.add("HirFunction", newName, ty, sp, kids)
    }

    // ── 语句降级 ──

    /// 降级语句。
    fun lowerStmt(ast: Ast, id: Int): Int {
        val kind: String = ast.kindOf(id)
        if (kind == "ValDecl") {
            return this.lowerValDecl(ast, id)
        } else if (kind == "VarDecl") {
            return this.lowerVarDecl(ast, id)
        } else if (kind == "Function") {
            // 类体/嵌套块中的函数声明（类方法）——此前未处理，导致类方法整体丢失
            // ⚠️ P237：类型体上下文且为**值包装类** ⇒ 设置接收者注入通道。
            if (this.inTypeBody && this.curTypeDecl != ""
                && this.csvContains(this.valueLikeTypes, this.curTypeDecl)
                // ⚠️ 暂排除 toUpperCase/toLowerCase：其现有调用点（Vm_callOrBuiltin
                // 的表达式 receiver）经解析期 demotion 保持裸名——限定定义会
                // 断链。待调用侧 demotion 限定补齐后移除排除。
                && ast.textOf(id) != "toUpperCase" && ast.textOf(id) != "toLowerCase") {
                this.pendingMethodSelf = this.curTypeDecl
            }
            val fnHirId: Int = this.lowerFunction(ast, id)
            this.pendingMethodSelf = ""
            return fnHirId
        } else if (kind == "InitBlock") {
            // 构造初始化块 `init { ... }` → 合成 `<Class>.init` 方法体（Phase 6.5.1b）
            return this.lowerInitBlock(ast, id)
        } else if (kind == "Return") {
            return this.lowerReturn(ast, id)
        } else if (kind == "If") {
            return this.lowerIfStmt(ast, id)
        } else if (kind == "While") {
            return this.lowerWhile(ast, id)
        } else if (kind == "For") {
            return this.lowerFor(ast, id)
        } else if (kind == "CFor") {
            return this.lowerCFor(ast, id)
        } else if (kind == "Block") {
            return this.lowerBlock(ast, id)
        } else if (kind == "CompanionBody") {
            // 伴生对象体（`companion object { fun add(a,b) ... }`）：走 Block
            // 同一降级路径，但产出 HirBlock 的 kind 用 "HirCompanionBlock"
            // 标记，SsaBuilder 侧的 `registerClassBodyEx` 见到该 kind 时
            // 递归下钻但**不设 ownerCls**——伴生函数是「静态」成员，调用点
            // `MathUtil.add(3, 4)` 视作自由函数（不加接收者），形参表若注入
            // `@this` 会与调用点 ABI 错位一位。
            return this.lowerBlockWithKind(ast, id, "HirCompanionBlock")
        } else if (kind == "Assign") {
            return this.lowerAssign(ast, id)
        } else if (kind == "Break") {
            return this.hir.leaf("HirBreak", "", ast.spanOf(id))
        } else if (kind == "Continue") {
            return this.hir.leaf("HirContinue", "", ast.spanOf(id))
        } else if (kind == "ExprStmt") {
            return this.lowerExprStmt(ast, id)
        } else if (kind == "Try") {
            return this.lowerTry(ast, id)
        } else if (kind == "Lambda") {
            return this.lowerLambda(ast, id)
        } else if (kind == "Closure") {
            return this.lowerLambda(ast, id)
        } else if (kind == "Defer") {
            return this.hir.leaf("HirDefer", "", ast.spanOf(id))
        } else if (kind == "Throw") {
            return this.lowerThrow(ast, id)
        } else {
            // 其他语句类型暂不处理
            return -1
        }
    }

    /// 降级构造初始化块：合成 `HirFunction "init"`（仅带方法体，无 HirParam）。
    ///
    /// 类体 Block 的某个子节点若是 InitBlock，则本方法产出 HirFunction，
    /// 使发射器侧的「方法所属类」扫描能把它识别为 `<Class>.init`；
    /// AOT 的 `X()` 构造在字段初始化后调用它。
    fun lowerInitBlock(ast: Ast, id: Int): Int {
        val sp: Span = ast.spanOf(id)
        val kids: List<Int> = ast.kidsOfList(id)
        var bodyId: Int = -1
        if (HirUtils.hirKidsCount(kids) > 0) {
            bodyId = this.lowerBlockOrExpr(ast, HirUtils.hirKidsAt(kids, 0))
        }
        var hirKids: List<Int> = HirUtils.hirNoKids()
        if (bodyId >= 0) {
            hirKids = HirUtils.hirKidsAdd(hirKids, bodyId)
        }
        return this.hir.add("HirFunction", "init", "", sp, hirKids)
    }

    /// 降级 return 语句。
    fun lowerReturn(ast: Ast, id: Int): Int {
        val sp: Span = ast.spanOf(id)
        val kids: List<Int> = ast.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        var hirKids: List<Int> = HirUtils.hirNoKids()
        if (kCount > 0) {
            val valId: Int = HirUtils.hirKidsAt(kids, 0)
            val valHirId: Int = this.lowerExpr(ast, valId)
            hirKids = HirUtils.hirKidsAdd(hirKids, valHirId)
        }
        return this.hir.add("HirReturn", "", "", sp, hirKids)
    }

    /// 降级 if 语句。
    ///
    /// AST 形状：`If(cond, thenBranch[, elseBranch])`。
    /// 条件可为任意表达式 kind（Binary/Call/Ident…），必须无条件降级（此前按
    /// `Expr/Block/If` 过滤，导致条件被丢弃）。
    fun lowerIfStmt(ast: Ast, id: Int): Int {
        val sp: Span = ast.spanOf(id)
        val kids: List<Int> = ast.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        var hirKids: List<Int> = HirUtils.hirNoKids()

        // 条件
        if (kCount >= 1) {
            val condHirId: Int = this.lowerExpr(ast, HirUtils.hirKidsAt(kids, 0))
            if (condHirId >= 0) {
                hirKids = HirUtils.hirKidsAdd(hirKids, condHirId)
            }
        }
        // then 分支（可能是块 / 单条语句 / 表达式）
        if (kCount >= 2) {
            val thenHirId: Int = this.lowerBranch(ast, HirUtils.hirKidsAt(kids, 1))
            if (thenHirId >= 0) {
                hirKids = HirUtils.hirKidsAdd(hirKids, thenHirId)
            }
        }
        // else 分支（可选）
        if (kCount >= 3) {
            val elseHirId: Int = this.lowerBranch(ast, HirUtils.hirKidsAt(kids, 2))
            if (elseHirId >= 0) {
                hirKids = HirUtils.hirKidsAdd(hirKids, elseHirId)
            }
        }

        return this.hir.add("HirIf", "", "", sp, hirKids)
    }

    /// 降级 while 循环。
    fun lowerWhile(ast: Ast, id: Int): Int {
        val sp: Span = ast.spanOf(id)
        val kids: List<Int> = ast.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        var hirKids: List<Int> = HirUtils.hirNoKids()
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            val childHirId: Int = this.lowerBlockOrExpr(ast, childId)
            if (childHirId >= 0) {
                hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
            }
            i = i + 1
        }
        return this.hir.add("HirWhile", "", "", sp, hirKids)
    }

    /// 降级 for 循环。
    fun lowerFor(ast: Ast, id: Int): Int {
        val sp: Span = ast.spanOf(id)
        val kids: List<Int> = ast.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        var hirKids: List<Int> = HirUtils.hirNoKids()
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            val childKind: String = ast.kindOf(childId)
            if (childKind == "ValDecl" || childKind == "VarDecl") {
                val childHirId: Int = this.lowerStmt(ast, childId)
                if (childHirId >= 0) {
                    hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
                }
            } else {
                val childHirId: Int = this.lowerBlockOrExpr(ast, childId)
                if (childHirId >= 0) {
                    hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
                }
            }
            i = i + 1
        }
        return this.hir.add("HirFor", "", "", sp, hirKids)
    }

    /// 降级 C 风格 for：`for (init; cond; incr) body`
    /// → `{ init; while (cond) { body; incr } }`（与 Rust 侧 `desugar_cfor` 同形）。
    ///
    /// AST kids 固定为 `[init, cond, incr, body]`（Parser.parseFor 的 C 分支
    /// 用 BoolLiteral/Block 占位补齐可选部分）。
    fun lowerCFor(ast: Ast, id: Int): Int {
        val sp: Span = ast.spanOf(id)
        val kids: List<Int> = ast.kidsOfList(id)
        if (HirUtils.hirKidsCount(kids) < 4) {
            return this.hir.add("HirBlock", "", "", sp, HirUtils.hirNoKids())
        }
        val initId: Int = HirUtils.hirKidsAt(kids, 0)
        val condId: Int = HirUtils.hirKidsAt(kids, 1)
        val incrId: Int = HirUtils.hirKidsAt(kids, 2)
        val bodyId: Int = HirUtils.hirKidsAt(kids, 3)

        var blockKids: List<Int> = HirUtils.hirNoKids()
        val initHir: Int = this.lowerStmt(ast, initId)
        if (initHir >= 0) {
            blockKids = HirUtils.hirKidsAdd(blockKids, initHir)
        }

        // while 体 = body + incr（步进在每次迭代末尾执行）
        var whileKids: List<Int> = HirUtils.hirNoKids()
        val bodyHir: Int = this.lowerBlockOrExpr(ast, bodyId)
        if (bodyHir >= 0) {
            whileKids = HirUtils.hirKidsAdd(whileKids, bodyHir)
        }
        // 步进多为赋值/复合赋值语句（Parser 已用 parseStatement 产出
        // Assign / ExprStmt 节点），故按语句降级
        val incrHir: Int = this.lowerStmt(ast, incrId)
        if (incrHir >= 0 && ast.kindOf(incrId) != "Block") {
            whileKids = HirUtils.hirKidsAdd(whileKids, incrHir)
        }
        val whileBody: Int = this.hir.add("HirBlock", "", "", sp, whileKids)

        var wKids: List<Int> = HirUtils.hirNoKids()
        val condHir: Int = this.lowerExpr(ast, condId)
        if (condHir >= 0) {
            wKids = HirUtils.hirKidsAdd(wKids, condHir)
        }
        wKids = HirUtils.hirKidsAdd(wKids, whileBody)
        val whileHir: Int = this.hir.add("HirWhile", "", "", sp, wKids)
        blockKids = HirUtils.hirKidsAdd(blockKids, whileHir)
        return this.hir.add("HirBlock", "", "", sp, blockKids)
    }

    /// 降级赋值语句。
    /// array[i] = v → array = Collections.set(array, i, v)
    /// （Value::List 不可变，set 返回新列表，需回赋到目标变量）
    fun lowerAssign(ast: Ast, id: Int): Int {
        val sp: Span = ast.spanOf(id)
        val kids: List<Int> = ast.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        if (kCount >= 2) {
            val targetId: Int = HirUtils.hirKidsAt(kids, 0)
            val valueId: Int = HirUtils.hirKidsAt(kids, 1)
            val targetKind: String = ast.kindOf(targetId)

            // 下标赋值：array[i] = v → array = Collections.set(array, i, v)
            if (targetKind == "Index") {
                val idxKids: List<Int> = ast.kidsOfList(targetId)
                val idxKCount: Int = HirUtils.hirKidsCount(idxKids)
                if (idxKCount >= 2) {
                    val containerId: Int = HirUtils.hirKidsAt(idxKids, 0)
                    val indexId: Int = HirUtils.hirKidsAt(idxKids, 1)
                    val containerKind: String = ast.kindOf(containerId)

                    var hirKids: List<Int> = HirUtils.hirNoKids()

                    // set(array, i, v) 调用
                    var callKids: List<Int> = HirUtils.hirNoKids()
                    val containerHirId: Int = this.lowerExpr(ast, containerId)
                    val indexHirId: Int = this.lowerExpr(ast, indexId)
                    val valueHirId: Int = this.lowerExpr(ast, valueId)
                    if (containerHirId >= 0) {
                        callKids = HirUtils.hirKidsAdd(callKids, containerHirId)
                    }
                    if (indexHirId >= 0) {
                        callKids = HirUtils.hirKidsAdd(callKids, indexHirId)
                    }
                    if (valueHirId >= 0) {
                        callKids = HirUtils.hirKidsAdd(callKids, valueHirId)
                    }
                    val setCallId: Int = this.hir.add("HirCall", "Collections.set", "", sp, callKids)

                    // 如果目标是变量，回赋到该变量
                    if (containerKind == "Ident") {
                        // 生成 assign: container = setCall
                        val containerHir: Int = this.lowerExpr(ast, containerId)
                        if (containerHir >= 0 && setCallId >= 0) {
                            val assignKids: List<Int> = HirUtils.hirKidsAdd(HirUtils.hirNoKids(), containerHir)
                            val assignKids2: List<Int> = HirUtils.hirKidsAdd(assignKids, setCallId)
                            return this.hir.add("HirAssign", "", "", sp, assignKids2)
                        }
                    }

                    // 非变量目标：仅生成 set 调用
                    return setCallId
                }
            }

            // 普通赋值：target = value
            // 把目标变量名写入 HirAssign.text（MIR 需要据此分配 STORE_VAR 槽位）
            var targetName: String = ""
            if (targetKind == "Ident" || targetKind == "This" || targetKind == "Super") {
                targetName = ast.textOf(targetId)
            }
            var hirKids: List<Int> = HirUtils.hirNoKids()
            var i: Int = 0
            while (i < kCount) {
                val childId: Int = HirUtils.hirKidsAt(kids, i)
                val childHirId: Int = this.lowerExpr(ast, childId)
                if (childHirId >= 0) {
                    hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
                }
                i = i + 1
            }
            return this.hir.add("HirAssign", targetName, "", sp, hirKids)
        }
        return -1
    }

    /// 降级 `throw expr` → `HirCall("__throw", [expr])`。
    ///
    /// 与 Rust 侧 `desugar_expr(Expr::Throw)` 的 HIR 形状一致（callee `__throw`）。
    /// Aura 侧 AOT 无异常机制，发射器对未解析符号不发调用 —— 语义上等价于
    /// 「不求值」的空操作，但**解析不再中断**（vm/*.aura 里大量 `throw Runtime(…)`）。
    fun lowerThrow(ast: Ast, id: Int): Int {
        val sp: Span = ast.spanOf(id)
        val kids: List<Int> = ast.kidsOfList(id)
        var hkids: List<Int> = HirUtils.hirNoKids()
        if (HirUtils.hirKidsCount(kids) > 0) {
            val v: Int = this.lowerExpr(ast, HirUtils.hirKidsAt(kids, 0))
            if (v >= 0) {
                hkids = HirUtils.hirKidsAdd(hkids, v)
            }
        }
        return this.hir.add("HirCall", "__throw", "", sp, hkids)
    }

    /// 降级表达式语句。
    ///
    /// ⚠️ 必须包裹一层 `HirExprStmt`：`buildStmt` 按 `kind == "HirExprStmt"` 分派，
    /// 直接返回 `lowerExpr` 的结果（`HirBinary` / `HirLit` 等）会落到
    /// `buildStmt` 的 else 分支被静默丢弃 —— 实测 `fun main() { 1+1 }` 生成空函数体。
    fun lowerExprStmt(ast: Ast, id: Int): Int {
        val kids: List<Int> = ast.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (kCount > 0) {
            val exprId: Int = HirUtils.hirKidsAt(kids, 0)
            val exprHirId: Int = this.lowerExpr(ast, exprId)
            if (exprHirId >= 0) {
                return this.hir.add("HirExprStmt", "", "",
                    ast.spanOf(id), HirUtils.hirKidsAdd(HirUtils.hirNoKids(), exprHirId))
            }
        }
        return -1
    }

    // ── 表达式降级 ──

    /// R51:radix 文本 → 十进制文本(跳过非法字符与下划线)。
    private fun radixToDec(text: String, radix: Int, from: Int): String {
        var v: Int = 0
        var i: Int = from
        while (i < text.length) {
            val ch: Int = text.charCodeAt(i)
            var d: Int = -1
            if (ch >= 48 && ch <= 57) { d = ch - 48 }
            else if (ch >= 97 && ch <= 122) { d = ch - 87 }   // a-z → 10-35
            else if (ch >= 65 && ch <= 90) { d = ch - 55 }    // A-Z → 10-35
            if (d >= 0 && d < radix) {
                v = v * radix + d
            }
            i = i + 1
        }
        return this.intToDec(v)
    }

    /// R51:Int → 十进制文本。
    private fun intToDec(v: Int): String {
        if (v == 0) { return "0" }
        var out: String = ""
        var n: Int = v
        var neg: Boolean = false
        if (n < 0) {
            neg = true
            n = -n
        }
        while (n > 0) {
            val d: Int = n % 10
            out = String.fromCharCode(48 + d) + out
            n = (n - d) / 10
        }
        if (neg) { out = "-" + out }
        return out
    }

    /// 降级表达式。
    fun lowerExpr(ast: Ast, id: Int): Int {
        val kind: String = ast.kindOf(id)
        val text: String = ast.textOf(id)
        val sp: Span = ast.spanOf(id)
        val kids: List<Int> = ast.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        // 字面量（携带类型信息，供 AOT 发射器选择表示；Phase 6.5.5/6.5.7）
        if (kind == "IntLiteral") {
            // R51:radix 字面量归一——lexer 保留 0x/0b 前缀,而 ISel 数值解析
            // 只认十进制(实测 01:0xFF→0、0b1100→1100)。此处转十进制文本。
            var litText: String = text
            if (litText.length > 2 && litText.charCodeAt(0) == 48) {
                val c1: Int = litText.charCodeAt(1)
                if (c1 == 120 || c1 == 88) {
                    litText = this.radixToDec(litText, 16, 2)
                } else if (c1 == 98 || c1 == 66) {
                    litText = this.radixToDec(litText, 2, 2)
                }
            }
            return this.hir.add("HirLit", litText, "Int", sp, HirUtils.hirNoKids())
        } else if (kind == "FloatLiteral" || kind == "DoubleLiteral") {
            return this.hir.add("HirLit", text, "Double", sp, HirUtils.hirNoKids())
        } else if (kind == "StringLiteral") {
            return this.hir.add("HirLit", text, "String", sp, HirUtils.hirNoKids())
        } else if (kind == "BoolLiteral") {
            return this.hir.add("HirLit", text, "Boolean", sp, HirUtils.hirNoKids())
        } else if (kind == "CharLiteral") {
            // R51:Char 字面量值 = 码点。旧实现文本 "A" 直落 ⇒ ISel 物化为串
            // "A" ⇒ toString 走 toStr 臂按数字解析 "A" ⇒ 0(实测 01:0/5/0)。
            var cpText: String = "0"
            if (text.length > 0) {
                cpText = this.intToDec(text.charCodeAt(0))
            }
            return this.hir.add("HirLit", cpText, "Char", sp, HirUtils.hirNoKids())
        } else if (kind == "NullLiteral") {
            return this.hir.add("HirLit", "null", "Any", sp, HirUtils.hirNoKids())
        }

        // 标识符
        if (kind == "Ident") {
            // 回填声明类型（局部量表 → 类字段表 → AST ty 列）。旧实现恒空 ⇒
            // lowerBinary 的 String 隐式拼接无法识别变量操作数的非 String
            // 身份 ⇒ `println("x=" + intVar)` 发 `@add(String, i32)` 段错误。
            var vty: String = this.localVarTy(text)
            if (vty == "" && this.curTypeDecl != "") {
                vty = this.kvGet(this.typeMemberTys, this.curTypeDecl + "." + text)
            }
            if (vty == "") {
                vty = ast.tyOf(id)
            }
            return this.hir.add("HirVar", text, vty, sp, HirUtils.hirNoKids())
        } else if (kind == "This") {
            return this.hir.leaf("HirVar", "this", sp)
        } else if (kind == "Super") {
            return this.hir.leaf("HirVar", "super", sp)
        }

        // 区间 `a..b` / `a..<b` → `__range(a, b, inclusive)`
        // （与 Rust 侧 `desugar_expr(Expr::Range)` 的 HIR 形状一致；AOT 发射器
        //  按 `__range` 生成 `aura_lang_std_Collections_range` 调用。）
        if (kind == "Range") {
            val rangeSp: Span = ast.spanOf(id)
            val rangeKids: List<Int> = ast.kidsOfList(id)
            var incText: String = "1"
            if (ast.textOf(id) == "0") {
                incText = "0"
            }
            var callKids: List<Int> = HirUtils.hirNoKids()
            var ri: Int = 0
            while (ri < HirUtils.hirKidsCount(rangeKids)) {
                val cid: Int = HirUtils.hirKidsAt(rangeKids, ri)
                val cHir: Int = this.lowerExpr(ast, cid)
                if (cHir >= 0) {
                    callKids = HirUtils.hirKidsAdd(callKids, cHir)
                }
                ri = ri + 1
            }
            val incNode: Int = this.hir.add("HirLit", incText, "Int", rangeSp, HirUtils.hirNoKids())
            callKids = HirUtils.hirKidsAdd(callKids, incNode)
            return this.hir.add("HirCall", "__range", "", rangeSp, callKids)
        }

        // 非空断言 `expr!!`（`Unwrap`）：HIR 层直接穿透（可空值在 AOT 下
        // 以值本身表示，`!!` 等价于原值，仅作类型收窄），
        // 但必须存在分支——否则落到「未知 AST 种类」返回 -1，
        // 整个表达式被静默丢弃并可能触发编译器崩溃。
        if (kind == "Unwrap") {
            val ukids: List<Int> = ast.kidsOfList(id)
            if (HirUtils.hirKidsCount(ukids) > 0) {
                return this.lowerExpr(ast, HirUtils.hirKidsAt(ukids, 0))
            }
            return -1
        }

        // 命名实参 `f(name = v)` → `HirNamedArg(name, [value])`
        if (kind == "NamedArg") {
            val naSp: Span = ast.spanOf(id)
            val naKids: List<Int> = ast.kidsOfList(id)
            var naHir: List<Int> = HirUtils.hirNoKids()
            if (HirUtils.hirKidsCount(naKids) > 0) {
                val v: Int = this.lowerExpr(ast, HirUtils.hirKidsAt(naKids, 0))
                if (v >= 0) {
                    naHir = HirUtils.hirKidsAdd(naHir, v)
                }
            }
            return this.hir.add("HirNamedArg", ast.textOf(id), "", naSp, naHir)
        }

        // 二元运算
        if (kind == "Binary") {
            return this.lowerBinary(ast, id)
        }

        // 一元运算
        if (kind == "Unary") {
            return this.lowerUnary(ast, id)
        }

        // 函数调用
        if (kind == "Call") {
            return this.lowerCall(ast, id)
        }

        // 成员访问
        if (kind == "Member") {
            return this.lowerMember(ast, id)
        }

        // 安全调用 `?.`：降级为 `if (recv != null) recv.name else null`。
        // 旧实现近似为普通成员访问（"空安全检查留待运行时"但运行时并无该
        // 语义）⇒ null 接收者照样求值成员 ⇒ nullStr?.length 打 0 而非 null
        //（实测 06 §6.4）。
        if (kind == "SafeAccess") {
            return this.lowerSafeAccess(ast, id)
        }

        // 下标访问
        if (kind == "Index") {
            return this.lowerIndex(ast, id)
        }

        // if 表达式
        if (kind == "If") {
            return this.lowerIfExpr(ast, id)
        }

        // 块表达式
        if (kind == "Block") {
            return this.lowerBlock(ast, id)
        }

        // when 表达式 → HirWhen（保留结构供 Desugar 降级为嵌套 If）
        if (kind == "When") {
            return this.lowerWhen(ast, id)
        }

        // C 风格 for 出现在表达式位置时同样降级为 `{ init; while … }` 块
        if (kind == "CFor") {
            return this.lowerCFor(ast, id)
        }

        // throw 出现在表达式位置（`if (c) throw X()`）
        if (kind == "Throw") {
            return this.lowerThrow(ast, id)
        }

        // lambda / closure → HirLambda
        if (kind == "Lambda" || kind == "Closure") {
            return this.lowerLambda(ast, id)
        }

        // 其他类型
        return this.hir.leaf("HirExpr", kind + ": " + text, sp)
    }

    /// 降级二元运算表达式。
    fun lowerBinary(ast: Ast, id: Int): Int {
        val op: String = ast.textOf(id)
        val sp: Span = ast.spanOf(id)
        val kids: List<Int> = ast.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        // 中缀 `a to b` → Pair 构造 `Collections.pairOf(a, b)`
        // （AOT 下是 2 元素 `AuraDynList`，`val (x, y) = p` 经 getAt(0/1) 解构）
        if (op == "to") {
            var toKids: List<Int> = HirUtils.hirNoKids()
            var ti: Int = 0
            while (ti < kCount) {
                val th: Int = this.lowerExpr(ast, HirUtils.hirKidsAt(kids, ti))
                if (th >= 0) {
                    toKids = HirUtils.hirKidsAdd(toKids, th)
                }
                ti = ti + 1
            }
            return this.hir.add("HirCall", "Collections.pairOf", "", sp, toKids)
        }

        var hirKids: List<Int> = HirUtils.hirNoKids()
        var opTy: String = ""
        var firstTy: String = ""
        var wideTy: String = ""
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            val childHirId: Int = this.lowerExpr(ast, childId)
            if (childHirId >= 0) {
                hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
                val cty: String = this.hir.tyOf(childHirId)
                if (cty == "String") {
                    opTy = "String"
                }
                if (i == 0 && firstTy == "") {
                    firstTy = cty
                }
                if (this.tyRank(cty) > this.tyRank(wideTy)) {
                    wideTy = cty
                }
            }
            i = i + 1
        }
        val normOp: String = HirUtils.hirNormBinOp(op)
        // 字符串隐式拼接（对齐 Kotlin `String + T`）：`+` 且任一操作数为
        // String 时，其余非 String 操作数显式包一层 `toString` 调用。
        // 旧实现直接发混型 kids 的 `HirBinary +` ⇒ SSA `@add(String, i32)`
        // ⇒ 后端按整数指针加法出垃圾指针 ⇒ println 段错误
        //（toString_implicit_test §1 首行 `"  Int: " + 42` 即崩）。
        // 与手写 `x.toString()` 完全同路（buildCall → `@call @toString`）。
        if (normOp == "+" && opTy == "String") {
            var wrapped: List<Int> = HirUtils.hirNoKids()
            var wi: Int = 0
            while (wi < HirUtils.hirKidsCount(hirKids)) {
                val kid: Int = HirUtils.hirKidsAt(hirKids, wi)
                var kty: String = this.hir.tyOf(kid)
                // HirCall ty 空时按调用名（含 `Class_method` 限定名）兜底查
                // 预登记返回类型表 —— 成员调用走限定名路径，ty 未回填。
                // ⚠️ kid 是 HIR 节点 **id**（Int）：取其子节点必须经
                // `hir.kidsOfList(id)`，直接把 id 传给 hirKidsCount（收
                // List）无类型检查器拦截，会编出 `Collections_count(i32)`
                // 非法 IR、llc 拒收（2026-10-16 实踩）。
                if (kty == "" && this.hir.kindOf(kid) == "HirCall") {
                    val cnm: String = this.hir.textOf(kid)
                    val cKids: List<Int> = this.hir.kidsOfList(kid)
                    kty = this.kvGet(this.funcRetTys,
                            cnm + "/" + toStr(HirUtils.hirKidsCount(cKids)))
                    if (kty == "") {
                        kty = this.kvGet(this.funcRetTys, cnm)
                    }
                }
                // `String`/`String?` 都不包（String? 的 toString 即原值）。
                if (kty != "String" && kty != "" && !kty.startsWith("String")) {
                    // 用户类/结构体若声明了 toString 方法 → 发**限定方法调用**
                    //（`Vec2_toString`）；运行库 `@toString` 只认标量，对象
                    // 指针进去会打出垃圾数字（实测 §10 `v1+v2`）。
                    var callName: String = "toString"
                    if (this.csvContains(this.typeMethods, kty + ".toString")) {
                        callName = kty + "_toString"
                    }
                    wrapped = HirUtils.hirKidsAdd(wrapped, this.hir.add(
                            "HirCall", callName, "String", sp,
                            HirUtils.hirKidsAdd(HirUtils.hirNoKids(), kid)))
                } else {
                    wrapped = HirUtils.hirKidsAdd(wrapped, kid)
                }
                wi = wi + 1
            }
            hirKids = wrapped
        }
        // ── 运算符重载（2026-10-16）：左操作数类型声明了 operator fun plus ──
        // `v1 + v2` → `Vec2_plus(v1, v2)`（接收者 kids[0]，走既有方法调用/
        // 重载解析链）。此前发裸 @add 把对象指针当整数加 → 垃圾/段错误
        //（实测 05 §5.17、toString_implicit §10）。
        if (normOp == "+" && opTy != "String"
                && HirUtils.hirKidsCount(hirKids) >= 2) {
            val olTy: String = this.hir.tyOf(HirUtils.hirKidsAt(hirKids, 0))
            if (olTy != "" && !this.isScalarTy(olTy)
                    && this.csvContains(this.typeMethods, olTy + ".plus")) {
                return this.hir.add("HirCall", olTy + "_plus", "", sp, hirKids)
            }
        }
        if (normOp != "+" && normOp != "&&" && normOp != "||" &&
            normOp != "==" && normOp != "!=" && normOp != "<" &&
            normOp != ">" && normOp != "<=" && normOp != ">=") {
            // R53:算术运算(-,*,/,%)结果类型 = 操作数取宽。
            // 旧实现 opTy 一律置空 ⇒ val r = pi * 2 的 HIR 类型为 ""
            // ⇒ lowerValDecl 推断 r 的类型为空 ⇒ Emit.inferType("r")
            // 回落 "i32" ⇒ r.toString() 走装箱整数路径(把 double 的
            // 8 字节按奇偶判指针/整数)⇒ 实测 14-string-interp §14.2
            // 输出 281392529211456 而非 6.28。
            // 2026-10-16：改为**取宽**（原实现取 firstTy，Int+Double 会
            // 静态标成 Int ⇒ double 位型按整数装箱打印出垃圾）。
            opTy = if (this.tyRank(wideTy) > this.tyRank(firstTy)) wideTy else firstTy
        } else if (normOp == "+" && opTy == "" && firstTy != "") {
            // 数值 `+`（无 String 操作数）结果类型 = 操作数取宽（理由同上）。
            // 旧实现把 `+` 排除在推断外 ⇒ `val total = add(3,4) + square(2)`
            // 的 total ty="" ⇒ String 拼接包裹跳过 ⇒ @add(String, i32) 段错误
            //（toString_implicit_test §12）。
            opTy = if (this.tyRank(wideTy) > this.tyRank(firstTy)) wideTy else firstTy
        }
        return this.hir.add("HirBinary", normOp, opTy, sp, hirKids)
    }

    /// 降级一元运算表达式。
    fun lowerUnary(ast: Ast, id: Int): Int {
        val op: String = ast.textOf(id)
        val sp: Span = ast.spanOf(id)
        val kids: List<Int> = ast.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        var hirKids: List<Int> = HirUtils.hirNoKids()
        var kidTy: String = ""
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            val childHirId: Int = this.lowerExpr(ast, childId)
            if (childHirId >= 0) {
                hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
                if (kidTy == "") {
                    kidTy = this.hir.tyOf(childHirId)
                }
            }
            i = i + 1
        }
        // 结果类型 = 首操作数类型（R53 算术同语义）。旧实现恒空 ⇒
        // `(-7)` 这类节点进 lowerBinary 的 String 隐式拼接包裹时因
        // ty=="" 被跳过 ⇒ `@add(String, i32)` 段错误。
        return this.hir.add("HirUnary", HirUtils.hirNormUnOp(op), kidTy, sp, hirKids)
    }

    /// 接收者是否为**不该降级为 `Collections.*`** 的对象。
    ///
    /// `Collections.getAt/set/contains/indexOf` 是给**运行期内建列表句柄**
    ///（`listOf`/`mutableListOf` 产生，`Value.List`）用的。若接收者是：
    ///   * 类内 `this`（如 `ArrayList.get` 里的 `this.get(i)`）；
    ///   * 显式 `Collections.xxx(...)` 调用里的 `Collections` 自身；
    ///   * 自带同名方法的用户集合类实例（`ArrayList`/`HashMap`/`HashSet`/…）；
    /// 就必须保留为普通方法调用。否则会把**类实例指针**当成列表头解引用 ——
    /// 实测 `this.get(i)` 被降级成 `Collections.getAt(this, i)` 后直接访问违规崩溃。
    private fun receiverNotForCollections(recvId: Int): Boolean {
        val k: String = this.ast.kindOf(recvId)
        if (k == "This") {
            return true
        }
        if (k == "Ident") {
            val n: String = this.ast.textOf(recvId)
            if (n == "this" || n == "Collections") {
                return true
            }
        }
        val t: String = this.ast.tyOf(recvId)
        if (t == "") {
            return false
        }
        return t.startsWith("ArrayList") || t.startsWith("LinkedList")
            || t.startsWith("HashMap") || t.startsWith("LinkedHashMap")
            || t.startsWith("HashSet") || t.startsWith("TreeSet")
            || t.startsWith("TreeMap") || t.startsWith("Deque")
    }

    /// 接收者类型是否为 Map/Set 族。
    ///
    /// `receiverNotForCollections` 会把它们判为「不走集合语义」（因为
    /// `get`/`set`/`contains` 对 Map 走的是另一套实现），但**长度与清空**
    ///（`count` / `getSize` / `size` / `clear`）对 List/Map/Set 是同一套运行时
    /// 实现 —— 该分支的原有注释已写明「对 List 与 Map 都成立，因此不需要区分
    /// 接收者」。自举 `Main.aura` 实测：`getSize` / `clear` 因被这里排除而退化
    /// 成裸名（lld-link: undefined symbol）。
    private fun isCollectionMapOrSetTy(ty: String): Boolean {
        if (ty == "") {
            return false
        }
        return ty.startsWith("Map") || ty.startsWith("HashMap")
            || ty.startsWith("LinkedHashMap") || ty.startsWith("TreeMap")
            || ty.startsWith("Set") || ty.startsWith("HashSet")
            || ty.startsWith("LinkedHashSet") || ty.startsWith("TreeSet")
    }

    /// `Env.get(...)` 的接收者是否为 std 的 `Env` 对象。
    ///
    /// 见 `lowerCall` 里该分支的说明：不拦下就会被当成集合取值。
    private fun isEnvReceiver(ast: Ast, calleeId: Int): Boolean {
        val ck: List<Int> = ast.kidsOfList(calleeId)
        if (HirUtils.hirKidsCount(ck) < 1) {
            return false
        }
        val r: Int = HirUtils.hirKidsAt(ck, 0)
        if (ast.kindOf(r) != "Ident") {
            return false
        }
        return ast.textOf(r) == "Env"
    }

    /// 降级函数调用表达式。
    // ── 2026-10-02 接收者类型传播辅助 ──

    /// 清理类型名：剥离访问修饰符前缀（解析器把 `#public|` 一并写进 ty 列，
    /// 实测 `val x: Int` 的节点 ty 是 "#public|Int"，类类型只剩 "#public|" ——
    /// 不剥离则一切基于类型名的逻辑失效）。
    private fun cleanTy(ty: String): String {
        if (ty == "") { return "" }
        val bar: Int = ty.indexOf("|")
        if (bar >= 0) {
            return ty.substring(bar + 1, ty.length)
        }
        return ty
    }

    /// 数值类型宽度序（取宽用）：Double > Float > Long > Int > 其它(0)。
    private fun tyRank(ty: String): Int {
        if (ty == "Int") { return 1 }
        if (ty == "Long") { return 2 }
        if (ty == "Float") { return 3 }
        if (ty == "Double") { return 4 }
        return 0
    }

    /// 函数声明节点的形参个数（`Params`→`Param` 两层）。
    private fun paramCountOf(ast: Ast, fnId: Int): Int {
        val kids: List<Int> = ast.kidsOfList(fnId)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        var n: Int = 0
        var i: Int = 0
        while (i < kCount) {
            val kidId: Int = HirUtils.hirKidsAt(kids, i)
            if (ast.kindOf(kidId) == "Params") {
                val pk: List<Int> = ast.kidsOfList(kidId)
                val pn: Int = HirUtils.hirKidsCount(pk)
                var j: Int = 0
                while (j < pn) {
                    if (ast.kindOf(HirUtils.hirKidsAt(pk, j)) == "Param") {
                        n = n + 1
                    }
                    j = j + 1
                }
            }
            i = i + 1
        }
        return n
    }

    /// 是否标量类型（接收者类型限定只对类/对象类型生效）。
    private fun isScalarTy(ty: String): Boolean {
        if (ty == "Int" || ty == "Long" || ty == "Bool" || ty == "Float"
            || ty == "Double" || ty == "String" || ty == "Unit" || ty == "Byte"
            || ty == "Short" || ty == "Any" || ty == "Basic" || ty == "") {
            return true
        }
        return false
    }

    /// CSV（逗号分隔）中是否含指定条目。
    private fun csvContains(csv: String, item: String): Boolean {
        if (csv == "" || item == "") { return false }
        var start: Int = 0
        var i: Int = 0
        val n: Int = csv.length
        while (i <= n) {
            if (i == n || csv.charCodeAt(i) == 44) {
                if (csv.substring(start, i) == item) { return true }
                start = i + 1
            }
            i = i + 1
        }
        return false
    }

    /// "k1=v1,k2=v2" 形式的 CSV 中按键取值（未命中返回 ""）。
    /// [MEM-FIX] 键值条目追加（O(1) 摊还,替代 CSV 整段拷贝累积）。
    private fun kvAdd(list: List<String>, key: String, value: String): List<String> {
        list.add(key + "=" + value)
        return list
    }

    /// 键值查找（精确 key、首条命中——csvLookup 同语义,零分配）。
    private fun kvGet(list: List<String>, key: String): String {
        if (key == "") { return "" }
        var i: Int = 0
        while (i < list.size) {
            val e: String = list[i]
            if (e.startsWith(key + "=")) {
                return e.substring(key.length + 1, e.length)
            }
            i = i + 1
        }
        return ""
    }

    private fun csvLookup(csv: String, key: String): String {
        if (csv == "" || key == "") { return "" }
        var start: Int = 0
        var i: Int = 0
        val n: Int = csv.length
        while (i <= n) {
            if (i == n || csv.charCodeAt(i) == 44) {
                if (i > start) {
                    val pair: String = csv.substring(start, i)
                    val eq: Int = pair.indexOf("=")
                    if (eq > 0 && pair.substring(0, eq) == key) {
                        return pair.substring(eq + 1, pair.length)
                    }
                }
                start = i + 1
            }
            i = i + 1
        }
        return ""
    }

    /// 局部量声明类型（localVarTys 查表）。
    private fun localVarTy(name: String): String {
        return this.kvGet(this.localVarTys, name)
    }

    /// P40x-e：name 是否为已声明类型名（knownTypes CSV 精确匹配）。
    private fun isKnownTypeName(name: String): Boolean {
        if (name == "" || this.knownTypes == "") { return false }
        var i: Int = 0
        val n: Int = this.knownTypes.length
        while (i + name.length + 1 <= n) {
            if (this.knownTypes.charCodeAt(i) == 44
                    && this.knownTypes.substring(i + 1, i + 1 + name.length) == name) {
                return true
            }
            i = i + 1
        }
        return false
    }

    /// R51：从 Member/Ident 嵌套链重建完整点分名。
    ///
    /// `aura.string.length` 的 AST 形态是
    ///   Member(length, kid= Member(string, kid= Ident(aura)))
    /// 递归把每层文本用 `.` 拼起来。遇到非 Member/Ident 节点（例如
    /// `This`、`Call`、`Literal`）即停止——那意味着基座是「值」而非「路径」，
    /// 返回已收集的部分供调用方判定。
    private fun collectQualifiedName(ast: Ast, id: Int): String {
        if (id < 0) { return "" }
        val k: String = ast.kindOf(id)
        if (k != "Member" && k != "Ident") { return ast.textOf(id) }
        val own: String = ast.textOf(id)
        val kids: List<Int> = ast.kidsOfList(id)
        val kc: Int = HirUtils.hirKidsCount(kids)
        if (kc == 0) { return own }
        // 取最后一个 kid 作为基座（约定：Member 的 kid 列表里第一个/唯一是基座）
        val baseId: Int = HirUtils.hirKidsAt(kids, kc - 1)
        val baseName: String = this.collectQualifiedName(ast, baseId)
        if (baseName == "") { return own }
        return baseName + "." + own
    }

    /// 类字段声明类型（typeMemberTys 查表，owner 为类/对象名）。
    private fun typeMemberTy(owner: String, field: String): String {
        if (owner == "" || field == "") { return "" }
        return this.kvGet(this.typeMemberTys, owner + "." + field)
    }

    /// 类型体成员预登记（在正式降级**之前**对每个 Class/Struct/Object 调用，
    /// 消除「方法体先于同类其它方法降级」的顺序依赖）。
    /// Lambda 提升（R81）：`val f = x -> e` ⇒ 函数 f(x) = e。
    /// 本后端无一等函数值：ValDecl 本体省略，`f(…)` 直呼走函数调用；
    /// 捕获外部变量的 lambda（闭包）提升后自由变量取 0 —— 需环境捕获，
    /// 留待闭包专项。函数体：HirBlock[HirReturn[body]]（隐式返回值）。
    private fun lowerLambdaLift(ast: Ast, fname: String, lambdaId: Int): Int {
        val kids: List<Int> = ast.kidsOfList(lambdaId)
        if (HirUtils.hirKidsCount(kids) < 2) { return -1 }
        val paramsNode: Int = HirUtils.hirKidsAt(kids, 0)
        val bodyId: Int = HirUtils.hirKidsAt(kids, 1)
        if (ast.kindOf(paramsNode) != "Params") { return -1 }
        val sp: Span = ast.spanOf(lambdaId)
        var outKids: List<Int> = HirUtils.hirNoKids()
        val pk: List<Int> = ast.kidsOfList(paramsNode)
        var i: Int = 0
        while (i < pk.size()) {
            val pid: Int = pk[i]
            outKids = HirUtils.hirKidsAdd(outKids, this.hir.add("HirParam",
                    ast.textOf(pid), ast.tyOf(pid), ast.spanOf(pid),
                    HirUtils.hirNoKids()))
            i = i + 1
        }
        val bodyHir: Int = this.lowerExpr(ast, bodyId)
        if (bodyHir < 0) { return -1 }
        val retHir: Int = this.hir.add("HirReturn", "", "", sp,
                HirUtils.hirKidsAdd(HirUtils.hirNoKids(), bodyHir))
        val blk: Int = this.hir.add("HirBlock", "", "", sp,
                HirUtils.hirKidsAdd(HirUtils.hirNoKids(), retHir))
        outKids = HirUtils.hirKidsAdd(outKids, blk)
        return this.hir.add("HirFunction", fname, "", sp, outKids)
    }

    /// enum 成员登记：body Block 的 ExprStmt(Ident) 按序入表。
    private fun registerEnumMembers(ast: Ast, id: Int): Unit {
        val name: String = ast.textOf(id)
        if (name == "") {
            return
        }
        this.knownTypes = this.knownTypes + "," + name
        val kids: List<Int> = ast.kidsOfList(id)
        if (HirUtils.hirKidsCount(kids) < 1) {
            return
        }
        val bodyId: Int = HirUtils.hirKidsAt(kids, 0)
        val bk: List<Int> = ast.kidsOfList(bodyId)
        var idx: Int = 0
        var i: Int = 0
        while (i < bk.size()) {
            val stmtId: Int = bk[i]
            if (ast.kindOf(stmtId) == "ExprStmt") {
                val sk: List<Int> = ast.kidsOfList(stmtId)
                if (sk.size() > 0 && ast.kindOf(sk[0]) == "Ident") {
                    val mname: String = ast.textOf(sk[0])
                    if (mname != "") {
                        this.enumMembersCsv = this.enumMembersCsv + "\n"
                                + name + "." + mname + "=" + toStr(idx) + "\n"
                        idx = idx + 1
                    }
                }
            }
            i = i + 1
        }
    }

    private fun preRegisterTypeMembers(name: String, bodyAst: Int): Unit {
        val mKids: List<Int> = this.ast.kidsOfList(bodyAst)
        var mi: Int = 0
        while (mi < mKids.size()) {
            val mk: String = this.ast.kindOf(mKids[mi])
            val mn: String = this.ast.textOf(mKids[mi])
            if (mk == "Function") {
                val key: String = name + "." + mn
                if (!this.csvContains(this.typeMethods, key)) {
                    this.typeMethods = this.typeMethods + "," + key
                }
                // 方法返回类型也登记（裸名 + 限定名 + 名/元数三份 —— String
                // 隐式拼接包裹需要 HirCall ty；同名方法按元数区分）。
                val rty: String = this.cleanTy(this.ast.tyOf(mKids[mi]))
                if (mn != "" && rty != "") {
                    if (this.kvGet(this.funcRetTys, mn) == "") {
                        this.funcRetTys = this.kvAdd(this.funcRetTys, mn, rty)
                    }
                    val qmn: String = name + "_" + mn
                    if (this.kvGet(this.funcRetTys, qmn) == "") {
                        this.funcRetTys = this.kvAdd(this.funcRetTys, qmn, rty)
                    }
                    val arK: String = mn + "/" + toStr(this.paramCountOf(this.ast, mKids[mi]))
                    this.funcRetTys = this.kvAdd(this.funcRetTys, arK, rty)
                }
            } else if (mk == "ValDecl" || mk == "VarDecl") {
                val fty: String = this.cleanTy(this.ast.tyOf(mKids[mi]))
                if (fty != "") {
                    val key: String = name + "." + mn + "=" + fty
                    if (this.kvGet(this.typeMemberTys, name + "." + mn) == "") {
                        this.typeMemberTys = this.kvAdd(this.typeMemberTys, key, "")
                    }
                }
            } else if (mk == "CompanionBody") {
                // 伴生 val/var 的**字面量**初始化 → 编译期常量表
                //（MathUtil.BASE 读取此前走 __field_get(0,0) 段错误）。
                val ck: List<Int> = this.ast.kidsOfList(mKids[mi])
                var cj: Int = 0
                while (cj < ck.size()) {
                    val cid: Int = ck[cj]
                    val ckind: String = this.ast.kindOf(cid)
                    if (ckind == "ValDecl" || ckind == "VarDecl") {
                        val vname: String = this.ast.textOf(cid)
                        val vKids: List<Int> = this.ast.kidsOfList(cid)
                        if (vname != "" && vKids.size() > 0) {
                            val initId: Int = vKids[0]
                            val ik: String = this.ast.kindOf(initId)
                            var litTy: String = ""
                            if (ik == "IntLiteral") { litTy = "Int" }
                            else if (ik == "StringLiteral") { litTy = "String" }
                            else if (ik == "BoolLiteral") { litTy = "Boolean" }
                            else if (ik == "FloatLiteral" || ik == "DoubleLiteral") { litTy = "Double" }
                            if (litTy != "") {
                                this.companionValsCsv = this.companionValsCsv + "\n"
                                        + name + "." + vname + "="
                                        + this.ast.textOf(initId) + "|" + litTy + "\n"
                            }
                        }
                    }
                    cj = cj + 1
                }
            }
            mi = mi + 1
        }
    }

    fun lowerCall(ast: Ast, id: Int): Int {
        val sp: Span = ast.spanOf(id)
        val kids: List<Int> = ast.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        // ── R51：`aura.string.length(s)` / `aura.string.size(s)` 归一 ──
        //
        // `aura.string.*` 是 stdlib 的老式**包对象**写法（14-string-interp.aura 等），
        // 但 `String.length` 在 `aura.core/aura/lang/String.aura` 里是**属性**、
        // 运行库也没有 `aura.string.length` 这个 C 函数 ⇒ 直译成
        // `@aura_string_length`（lld-link: undefined symbol）或退化成
        // `@StringBuilder_length`（把字符串指针当 StringBuilder 读字段 ⇒
        // 0xC0000005）。两种落法都是死路，必须在此改写成 `s.length()`。
        //
        // 实现上**改写 AST 调用节点本身**（把 callee 换成裸 `Member(length)`，
        // 实参整体右移一格），然后**重新调用 lowerCall**：这样复用全部既有降级逻辑
        // （`Member` → 接收者前置、裸成员名），不必复制分支。
        //
        // 只认**恰好两段**限定名（`pkg.member`）：`aura.lang.std.Math.max(a,b)` 这类
        // 三/四段形态是真正的 std 类静态调用，走 `stdClassReceiver` 既有路径。
        //
        // AST 形态：解析器对 `aura.string.length` 产出
        //   Call( Member(length, kid= Member(string, kid= Ident(aura))),  Ident(name) )
        // 递归把整条 Member/Ident 链的文本拼成 "aura.string.length"。
        val r51callee: Int = HirUtils.hirKidsAt(kids, 0)
        if (HirUtils.hirKidsCount(kids) >= 2
                && ast.kindOf(r51callee) == "Member") {
            val cText: String = this.collectQualifiedName(ast, r51callee)
            val nC: Int = cText.length
            // 判定「点分路径 + 末段为 length/size」：`cText` 以 `.length`/`.size`
            // 结尾，去掉该后缀后仍非空。不限定前缀段数——`aura.string.length`
            // （3 段）、`string.length`（2 段）都是老式**包对象**写法，
            // 都应改写成成员调用；前缀段数不影响语义。
            val tailLen: String = ".length"
            val tailSz: String = ".size"
            val mem: String = ""
            if (cText.endsWith(tailLen)) {
                val prefix: String = cText.substring(0, nC - tailLen.length)
                if (prefix != "") {
                    mem = "length"
                }
            } else if (cText.endsWith(tailSz)) {
                val prefix: String = cText.substring(0, nC - tailSz.length)
                if (prefix != "") {
                    mem = "size"
                }
            }
            if (mem != "") {
                val newCallee: Int = this.ast.leaf("Member", mem, ast.spanOf(r51callee))
                var nk: String = toStr(newCallee)
                var ci: Int = 1
                while (ci < kCount) {
                    nk = nk + "," + toStr(HirUtils.hirKidsAt(kids, ci))
                    ci = ci + 1
                }
                val nid: Int = this.ast.add("Call", "", "", sp, nk)
                // 递归降级改写后的调用。深度 1 即返回：改写结果不含点分 callee。
                return this.lowerCall(ast, nid)
            }
        }

        // List/Array/Set.get(i) / getAt(i) → Collections.getAt(collection, i)
        // P40x-g：门槛从 kCount >= 2 放宽到 >= 1——零参方法调用（toString()/
        // size()/isEmpty()…）此前被整体挡在接收者分派之外，直接落成裸名
        //（实测 01-lexer：DEC_INT.toString() → @toString 裸名 → runtime 恒等
        // 占位 → 标量值被当串指针段错误）。块内各特例自带参数校验，安全。
        if (kCount >= 1) {
            val calleeId: Int = HirUtils.hirKidsAt(kids, 0)
            if (ast.kindOf(calleeId) == "Member" || ast.kindOf(calleeId) == "SafeAccess") {
                val memberName: String = ast.textOf(calleeId)

                // ── std 模块静态调用（R80）：`aura.<mod>.<m>(…)` 与
                // `<alias>.<m>(…)`（alias = import aura.<path> as X）。
                // 接收者链是模块路径/导入别名，不是实例。旧实现把接收者
                // 降级成 __field_get(0,0) 并泄漏为 arg0 ⇒ rcx=垃圾
                //（实测 11 §11.2 aura.io.fileExists 段错误）。处理：丢弃
                // 接收者链，只发实参的裸名调用——由唯一属主（如
                // Stdio_fileExists）/自由函数（prelu max）/运行库映射解析。
                if (ast.kindOf(calleeId) == "Member") {
                    val cq: String = this.collectQualifiedName(ast, calleeId)
                    var stdCall: Int = 0
                    var methodName: String = ""
                    if (cq.startsWith("aura.")) {
                        var dots: Int = 0
                        var di: Int = 0
                        while (di < cq.length) {
                            if (cq.charCodeAt(di) == 46) { dots = dots + 1 }
                            di = di + 1
                        }
                        if (dots >= 2) {
                            stdCall = 1
                            var ld: Int = cq.length - 1
                            while (ld >= 0 && cq.charCodeAt(ld) != 46) { ld = ld - 1 }
                            methodName = cq.substring(ld + 1, cq.length)
                        }
                    } else {
                        val cKids: List<Int> = ast.kidsOfList(calleeId)
                        if (HirUtils.hirKidsCount(cKids) >= 1
                                && ast.kindOf(HirUtils.hirKidsAt(cKids, 0)) == "Ident") {
                            val alias: String = ast.textOf(HirUtils.hirKidsAt(cKids, 0))
                            if (alias != "" && this.importAliasCsv.indexOf("\n" + alias + "|") >= 0) {
                                stdCall = 1
                                methodName = memberName
                            }
                        }
                    }
                    if (stdCall == 1) {
                        var stdKids: List<Int> = HirUtils.hirNoKids()
                        var ai: Int = 1
                        while (ai < kCount) {
                            val ah: Int = this.lowerExpr(ast, HirUtils.hirKidsAt(kids, ai))
                            if (ah >= 0) { stdKids = HirUtils.hirKidsAdd(stdKids, ah) }
                            ai = ai + 1
                        }
                        return this.hir.add("HirCall", methodName, "", sp, stdKids)
                    }
                }

                // ── `Env.get(name[, default])`：**不是**集合取值，必须先拦下 ──
                //
                // 否则它会被下面的集合重写变成 `Collections.getAt(Env, name)`，
                // 再被 `InstructionSelection.mapStdlibFuncName` 映射为
                // `__list_get(null, name)`；而 `emitListGet` 的 **null 分支返回 0**
                // ⇒ `Env.get` 返回空指针 ⇒ 紧随的 `s == ""` 里 `streq(0, "")`
                // 解引用地址 0 ⇒ **自举 `Main.exe` 启动即 0xC0000005**
                //（`main` 第一条语句就是 `cliArgCount()` → `Env.get`）。
                //
                // 保留限定名 `Env.get`，由 `mapStdlibFuncName` 映射到运行库的
                // `Collections.getAt`（其实现语义正是「查不到 = 空串」）。
                if (memberName == "get" && this.isEnvReceiver(ast, calleeId)) {
                    var envKids: List<Int> = HirUtils.hirNoKids()
                    var ei: Int = 1
                    while (ei < kCount) {
                        val eArg: Int = HirUtils.hirKidsAt(kids, ei)
                        val eHir: Int = this.lowerExpr(ast, eArg)
                        if (eHir >= 0) {
                            envKids = HirUtils.hirKidsAdd(envKids, eHir)
                        }
                        ei = ei + 1
                    }
                    return this.hir.add("HirCall", "Env.get", "", sp, envKids)
                }

                if (memberName == "get" || memberName == "getAt") {
                    val calleeKids: List<Int> = ast.kidsOfList(calleeId)
                    val calleeKCount: Int = HirUtils.hirKidsCount(calleeKids)
                    if (calleeKCount >= 1
                        && !this.receiverNotForCollections(HirUtils.hirKidsAt(calleeKids, 0))) {
                        var hirKids: List<Int> = HirUtils.hirNoKids()
                        // **接收者必须作为 kids[0]**（发射器约定：接收者在 kids[0]）。
                        // 旧实现从 i=0 起遍历**全部** kids，把 callee 成员节点
                        // （`get` 本身）也降级进去 → kids[0] 变成一次成员访问
                        // （推断 i32），真正接收者被埋在其 kids 里。后果：
                        //   * `HashMap.get("k")` 被当集合下标 → 发射器走
                        //     `aura_lang_std_Collections_getAt(null, idx)`（语义错，
                        //     读不到值、恒为空）；
                        //   * `xs.get(i)`（合法集合取元素）实参整体错位。
                        // 正确形状：`Collections.getAt(recv, i)`。
                        val getRecvHir: Int = this.lowerExpr(ast, HirUtils.hirKidsAt(calleeKids, 0))
                        if (getRecvHir >= 0) {
                            hirKids = HirUtils.hirKidsAdd(hirKids, getRecvHir)
                        }
                        var i: Int = 1
                        while (i < kCount) {
                            val childId: Int = HirUtils.hirKidsAt(kids, i)
                            val childHirId: Int = this.lowerExpr(ast, childId)
                            if (childHirId >= 0) {
                                hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
                            }
                            i = i + 1
                        }
                        return this.hir.add("HirCall", "Collections.getAt", "", sp, hirKids)
                    }
                }
                // set(i, v) → Collections.set(collection, i, v)
                if (memberName == "set") {
                    val calleeKids: List<Int> = ast.kidsOfList(calleeId)
                    val calleeKCount: Int = HirUtils.hirKidsCount(calleeKids)
                    if (calleeKCount >= 1
                        && !this.receiverNotForCollections(HirUtils.hirKidsAt(calleeKids, 0))) {
                        var hirKids: List<Int> = HirUtils.hirNoKids()
                        // 同 `get`：接收者作 kids[0]，其余实参从 kids[1] 起
                        //（旧实现从 0 起 → 接收者丢失、实参错位）。
                        val setRecvHir: Int = this.lowerExpr(ast, HirUtils.hirKidsAt(calleeKids, 0))
                        if (setRecvHir >= 0) {
                            hirKids = HirUtils.hirKidsAdd(hirKids, setRecvHir)
                        }
                        var i: Int = 1
                        while (i < kCount) {
                            val childId: Int = HirUtils.hirKidsAt(kids, i)
                            val childHirId: Int = this.lowerExpr(ast, childId)
                            if (childHirId >= 0) {
                                hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
                            }
                            i = i + 1
                        }
                        return this.hir.add("HirCall", "Collections.set", "", sp, hirKids)
                    }
                }
                // contains(item) / indexOf(item) → Collections.<m>(collection, item)
                //
                // 接收者必须作为 kids[0]：与发射器「接收者在 kids[0]」的约定一致
                // （`set` 分支已如此）。旧实现把 callee 成员节点整个降级成 kids[0]，
                // 接收者被埋在其 kids 里，实参整体错位 —— 字符串 `indexOf` 因此
                // 走列表实现恒返回 -1。
                //
                // Phase E: 修复 —— 仅当接收者类型不是 String 时才应用此转换。
                // String.indexOf(sub) 应保留为方法调用，由 AOT 后端解析到
                // aura_lang_std_String_indexOf。
                if (memberName == "contains" || memberName == "indexOf") {
                    val calleeKids: List<Int> = ast.kidsOfList(calleeId)
                    if (HirUtils.hirKidsCount(calleeKids) >= 1) {
                        val recvId: Int = HirUtils.hirKidsAt(calleeKids, 0)
                        val recvTy: String = ast.tyOf(recvId)
                        // 仅当接收者不是 String、且不是用户集合类实例时才转换为 Collections 调用
                        if (recvTy != "String" && !this.receiverNotForCollections(recvId)) {
                            var hirKids: List<Int> = HirUtils.hirNoKids()
                            val recvHirId: Int = this.lowerExpr(ast, recvId)
                            if (recvHirId >= 0) {
                                hirKids = HirUtils.hirKidsAdd(hirKids, recvHirId)
                            }
                            var i: Int = 1
                            while (i < kCount) {
                                val childHirId: Int = this.lowerExpr(ast, HirUtils.hirKidsAt(kids, i))
                                if (childHirId >= 0) {
                                    hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
                                }
                                i = i + 1
                            }
                            var qname: String = "Collections.contains"
                            if (memberName == "indexOf") {
                                qname = "Collections.indexOf"
                            }
                            return this.hir.add("HirCall", qname, "", sp, hirKids)
                        }
                        // 接收者是 String：跳过 Collections 转换，走普通方法调用路径
                    }
                }
                // count() / getSize() / isEmpty() → Collections.count / Collections.isEmpty
                //
                // 这三个成员名此前**没有**映射表项，方法调用退化为裸名：
                // 字节码发射器报 `未解析的函数调用 'count'` 并落成函数下标 0xFFFF，
                // 运行期表现为 `call to undefined function #65535`（实测
                // `xs.count()`、`m.getSize()` 都是这条路径）。
                // 运行库侧的名字来自 Rust native 注册表（`std_collections.rs`）：
                //   aura.lang.std.Collections.count / isEmpty
                // 对 List 与 Map 都成立（内部按对象长度取值），因此不需要区分接收者。
                if (memberName == "count" || memberName == "getSize" || memberName == "size"
                    || memberName == "isEmpty" || memberName == "clear") {
                    val calleeKids: List<Int> = ast.kidsOfList(calleeId)
                    if (HirUtils.hirKidsCount(calleeKids) >= 1) {
                        val recvId: Int = HirUtils.hirKidsAt(calleeKids, 0)
                        val recvTy: String = ast.tyOf(recvId)
                        // String 有同名成员（`s.count()` / `s.size`），必须排除；
                        // Map/Set 族要放行（见 `isCollectionMapOrSetTy`）。
                        if (recvTy != "String"
                            && (!this.receiverNotForCollections(recvId)
                                || this.isCollectionMapOrSetTy(recvTy))) {
                            var hirKids: List<Int> = HirUtils.hirNoKids()
                            val recvHirId: Int = this.lowerExpr(ast, recvId)
                            if (recvHirId >= 0) {
                                hirKids = HirUtils.hirKidsAdd(hirKids, recvHirId)
                            }
                            var qname: String = "Collections.count"
                            if (memberName == "isEmpty") {
                                qname = "Collections.isEmpty"
                            } else if (memberName == "clear") {
                                qname = "Collections.clear"
                            }
                            return this.hir.add("HirCall", qname, "", sp, hirKids)
                        }
                    }
                }
                // ── take(n)：List 切片 → stdlib `Collections.take`（2026-10-16）──
                // 此前发**裸名** take → 撞运行库机器码同名符号（ABI 与 stdlib
                // Aura 实现的列表布局不同）⇒ 结果垃圾 + 堆 OOM（实测
                // 15-advanced §15.2）。限定到 stdlib 定义（Collections.aura:201）。
                if (memberName == "take" && kCount >= 2) {
                    val calleeKids: List<Int> = ast.kidsOfList(calleeId)
                    if (HirUtils.hirKidsCount(calleeKids) >= 1) {
                        val recvId: Int = HirUtils.hirKidsAt(calleeKids, 0)
                        if (!this.receiverNotForCollections(recvId)) {
                            var hirKids: List<Int> = HirUtils.hirNoKids()
                            val recvHirId: Int = this.lowerExpr(ast, recvId)
                            if (recvHirId >= 0) {
                                hirKids = HirUtils.hirKidsAdd(hirKids, recvHirId)
                            }
                            var ti: Int = 1
                            while (ti < kCount) {
                                val childHirId: Int = this.lowerExpr(ast, HirUtils.hirKidsAt(kids, ti))
                                if (childHirId >= 0) {
                                    hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
                                }
                                ti = ti + 1
                            }
                            return this.hir.add("HirCall", "Collections.take", "", sp, hirKids)
                        }
                    }
                }
                // ── Map 成员：containsKey / containsValue / keys / values / put ──
                //
                // 与上面的 `count/getSize/isEmpty` 同源：成员名缺映射 → 退化为裸名
                // → 字节码落成函数下标 0xFFFF → 运行期 `call to undefined function
                // #65535`（实测 `m.containsKey("a")` 编译期即未解析）。
                //
                // **两个后端的落点本轮已齐**：
                //   * VM（Rust native，`std_collections.rs`）：
                //     `Collections.mapContainsKey` / `mapContainsValue` /
                //     `mapKeys` / `mapValues` / `hashMapPut`；
                //   * AOT（`aura_std_cffi.c` 的调用点符号层，Plan A `AuraDynMap`）：
                //     `aura_lang_std_Collections_mapContainsKey` / `_mapContainsValue` /
                //     `_mapKeys` / `_mapValues` / `_hashMapPut`（本轮补齐）。
                //
                // 接收者守卫沿用 `receiverNotForCollections`（与 get/set/contains 一致）：
                //   * 用户集合类实例（`HashMap`/`ArrayList`/`HashSet`/…）与 `this`
                //     → **保留普通方法调用**，走该类自己的方法
                //     （`HashMap.put` / `HashMap.containsKey` / `HashMap.keys` …），
                //     语义与 Plan A 实现一致，也避免把类实例当裸映射头解引用；
                //   * 接口 / 未知接收者（`Map<...>`、泛型、`Any`）→ 降级为 `Collections.*`。
                //
                // 注意 `put` 的返回值语义：VM 的 `Collections.hashMapPut` 对
                // **值表示**映射返回新映射；对**堆表示**（`Value::Ref`，`mutableMapOf`
                // 产出）由解释器 `try_inline_coll_set` 原地写入（本轮已把 `hashMapPut`
                // 纳入该拦截），因此 `m.put(k, v)` 作为语句也能生效。
                if (memberName == "containsKey" || memberName == "containsValue"
                    || memberName == "keys" || memberName == "values"
                    || memberName == "put") {
                    val mapKids: List<Int> = ast.kidsOfList(calleeId)
                    if (HirUtils.hirKidsCount(mapKids) >= 1
                        && !this.receiverNotForCollections(HirUtils.hirKidsAt(mapKids, 0))) {
                        var mapHirKids: List<Int> = HirUtils.hirNoKids()
                        val mapRecvHirId: Int =
                            this.lowerExpr(ast, HirUtils.hirKidsAt(mapKids, 0))
                        if (mapRecvHirId >= 0) {
                            mapHirKids = HirUtils.hirKidsAdd(mapHirKids, mapRecvHirId)
                        }
                        var mi: Int = 1
                        while (mi < kCount) {
                            val mChildHirId: Int =
                                this.lowerExpr(ast, HirUtils.hirKidsAt(kids, mi))
                            if (mChildHirId >= 0) {
                                mapHirKids = HirUtils.hirKidsAdd(mapHirKids, mChildHirId)
                            }
                            mi = mi + 1
                        }
                        var mapQname: String = "Collections.mapContainsKey"
                        if (memberName == "containsValue") {
                            mapQname = "Collections.mapContainsValue"
                        } else if (memberName == "keys") {
                            mapQname = "Collections.mapKeys"
                        } else if (memberName == "values") {
                            mapQname = "Collections.mapValues"
                        } else if (memberName == "put") {
                            mapQname = "Collections.hashMapPut"
                        }
                        return this.hir.add("HirCall", mapQname, "", sp, mapHirKids)
                    }
                }
            }
        }

        // 普通调用：kids[0] 是 callee（Ident/This/Super/Member），其余为实参。
        // 提取被调用函数名写入 HirCall.text（此前留空，导致 MIR/Codegen 丢失函数名）。
        var calleeName: String = ""
        var argStart: Int = 0
        var hirKids: List<Int> = HirUtils.hirNoKids()
        if (kCount > 0) {
            val calleeId: Int = HirUtils.hirKidsAt(kids, 0)
            val calleeKind: String = ast.kindOf(calleeId)
            if (calleeKind == "Ident" || calleeKind == "This" || calleeKind == "Super") {
                calleeName = ast.textOf(calleeId)
                argStart = 1
            } else if (calleeKind == "Member" || calleeKind == "SafeAccess") {
                // 方法调用 `obj.method(args)`：名字取成员名，**接收者对象**作为首个实参。
                // 必须降级「成员节点的接收者子节点」本身，而不是成员节点：若降级成员节点，
                // kids[0] 会变成一次成员访问（求值得到 0/null），方法调用丢失接收者，
                // 生成 `toString(i32 0)` 这类错误 IR。
                val mKids: List<Int> = ast.kidsOfList(calleeId)
                if (HirUtils.hirKidsCount(mKids) > 0) {
                    val recvId: Int = HirUtils.hirKidsAt(mKids, 0)
                    // P1 fix: 若接收者是简单标识符且大写开头（类名约定），
                    // 生成限定名 ClassName_method 以匹配 functionSignature 的限定方法名。
                    // 小写开头视为变量，保留裸名由 Emit.aura 回退逻辑解析。
                    if (ast.kindOf(recvId) == "Ident") {
                        val recvName: String = ast.textOf(recvId)
                        var qualified: String = ""
                        if (recvName.length() > 0) {
                            val first: String = recvName.substring(0, 1)
                            val fc: Int = first.charCodeAt(0)
                            if (fc >= 65 && fc <= 90) {  // 'A'..'Z'
                                // P40x-e：大写开头且确为已声明类型名才走静态
                                // 限定；顶层 val/const 非类名 → 走按值路径
                                if (this.isKnownTypeName(recvName)) {
                                    qualified = recvName + "_" + ast.textOf(calleeId)
                                }
                            } else {
                                // 2026-10-02 接收者类型传播：小写接收者按
                                // ① 局部声明类型（`val vm: VmRunner`）② 隐式 this
                                // 字段声明类型，限定为 `Class_method` —— 且仅当
                                // 目标类确实声明了该方法（typeMethods 校验，防止
                                // 把 toString/equals 误限定到不存在的实现）。
                                var rty: String = this.cleanTy(this.localVarTy(recvName))
                                if (rty == "") {
                                    rty = this.cleanTy(this.typeMemberTy(this.curTypeDecl, recvName))
                                }
                                if (rty != "" && !this.isScalarTy(rty) && this.csvContains(this.typeMethods, rty + "." + ast.textOf(calleeId))) {
                                    qualified = rty + "_" + ast.textOf(calleeId)
                                } else if ((rty.startsWith("List") || rty.startsWith("Map")) && ast.textOf(calleeId) == "size") {
                                    // 接口类型 List/Map 的 size → Collections.count（runtime 导出）
                                    qualified = "Collections.count"
                                } else if (rty != "" && this.isScalarTy(rty) && ast.textOf(calleeId) == "toString") {
                                    // 标量接收者的 .toString() 定 `toString` 分派器
                                    //（后端按 SSA 值类型分派 Int/Long/Double/…）。
                                    // 旧实现定 `toStr` —— 运行库 toStr 只做**整数→
                                    // 十进制**，Double 位型按整数解析出垃圾
                                    //（实测 toString_implicit_test §9
                                    // `Manual Float: 140698358490360`）。
                                    qualified = "toString"
                                }
                            }
                        }
                        if (qualified != "") {
                            calleeName = qualified
                        } else {
                            calleeName = ast.textOf(calleeId)
                        }
                    } else if (ast.kindOf(recvId) == "This") {
                        // 2026-10-02：`this.method()` → Class_method（当前类型体）
                        if (this.curTypeDecl != "" && !this.isScalarTy(this.curTypeDecl) && this.csvContains(this.typeMethods, this.curTypeDecl + "." + ast.textOf(calleeId))) {
                            calleeName = this.curTypeDecl + "_" + ast.textOf(calleeId)
                        } else {
                            calleeName = ast.textOf(calleeId)
                        }
                    } else if (ast.kindOf(recvId) == "Member") {
                        // 2026-10-02：一级字段链接收者 `this.field.m()` / `field.m()` ——
                        // Member 节点 text 即字段名；基座 This → 当前类型体，
                        // 小写 Ident → 同名局部（无则视为隐式 this 字段）。
                        // 字段声明类型 → 限定；更深链保持裸名（既有行为）。
                        var qualified: String = ""
                        val fieldName: String = ast.textOf(recvId)
                        val m2: List<Int> = ast.kidsOfList(recvId)
                        if (fieldName != "" && HirUtils.hirKidsCount(m2) >= 1) {
                            val baseId: Int = HirUtils.hirKidsAt(m2, 0)
                            val baseKind: String = ast.kindOf(baseId)
                            var owner: String = this.curTypeDecl
                            var ok: Boolean = false
                            if (baseKind == "This") {
                                ok = true
                            } else if (baseKind == "Ident") {
                                val bn: String = ast.textOf(baseId)
                                if (bn.length() > 0) {
                                    val fc2: Int = bn.substring(0, 1).charCodeAt(0)
                                    if (fc2 >= 97 && fc2 <= 122) {
                                        val lt: String = this.localVarTy(bn)
                                        if (lt != "") {
                                            owner = lt
                                            ok = true
                                        }
                                    }
                                }
                            }
                            if (ok) {
                                val fty: String = this.cleanTy(this.typeMemberTy(owner, fieldName))
                                if (fty != "" && !this.isScalarTy(fty) && this.csvContains(this.typeMethods, fty + "." + ast.textOf(calleeId))) {
                                    qualified = fty + "_" + ast.textOf(calleeId)
                                } else if ((fty.startsWith("List") || fty.startsWith("Map")) && ast.textOf(calleeId) == "size") {
                                    qualified = "Collections.count"
                                }
                            }
                        }
                        if (Env.get("AURA_TOSTR_DIAG", "") == "1") {
                            println("[TOS] recv=" + recvName + " known=" + toStr(if (this.isKnownTypeName(recvName)) 1 else 0)
                                    + " rty=" + this.cleanTy(this.localVarTy(recvName)) + " member=" + ast.textOf(calleeId)
                                    + " qualified=" + qualified)
                        }
                        if (qualified != "") {
                            calleeName = qualified
                        } else {
                            calleeName = ast.textOf(calleeId)
                        }
                    } else if (ast.kindOf(recvId) == "Super") {
                        // P40x-c：super.m() → 父类实现 Parent_m（静态分派）
                        val parentCls: String = this.kvGet(this.classParents, this.curTypeDecl)
                        if (parentCls != "" && this.csvContains(this.typeMethods, parentCls + "." + ast.textOf(calleeId))) {
                            calleeName = parentCls + "_" + ast.textOf(calleeId)
                        } else {
                            calleeName = ast.textOf(calleeId)
                        }
                    } else {
                        calleeName = ast.textOf(calleeId)
                    }
                    // 大写 Ident 接收者 = 单例/extern 模块名（`Memory.write(...)`）：
                    // **保留 HirVar(name) 原样**，不降级。旧实现走 lowerExpr ⇒
                    // 模块名不是局部变量 ⇒ 降成 `@i32_const 0`，self 占位进实参
                    // ⇒ SsaBuilder.buildCall 的 skipFirst（要求 kids[0] 是 HirVar）
                    // 失效 ⇒ `Memory_write(0, buf, val, mem)` 实参整体错位。
                    // HirVar(name) 交给 buildCall 的 recvIsSingleton 判定：
                    // 单例/extern 都会丢掉接收者、对齐普通函数 ABI（rcx=首实参）。
                    var recvHir: Int = -1
                    var keepRawRecv: Boolean = false
                    if (ast.kindOf(recvId) == "Super") {
                        // P40x-c：super 的实参形态就是 this
                        recvHir = this.hir.leaf("HirVar", "this", ast.spanOf(recvId))
                        keepRawRecv = true
                    }
                    if (ast.kindOf(recvId) == "Ident") {
                        val rn: String = ast.textOf(recvId)
                        if (rn.length() > 0) {
                            val fc3: Int = rn.substring(0, 1).charCodeAt(0)
                            // P40x-e：仅已知类型名保留原始接收者；顶层 val 走 lowerExpr
                            if (fc3 >= 65 && fc3 <= 90 && this.isKnownTypeName(rn)) {
                                recvHir = this.hir.leaf("HirVar", rn, ast.spanOf(recvId))
                                keepRawRecv = true
                            }
                        }
                    }
                    if (!keepRawRecv) {
                        recvHir = this.lowerExpr(ast, recvId)
                    }
                    if (recvHir >= 0) {
                        hirKids = HirUtils.hirKidsAdd(hirKids, recvHir)
                    }
                } else {
                    calleeName = ast.textOf(calleeId)
                }
                argStart = 1
            } else {
                argStart = 0
            }
        }

        var i: Int = argStart
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            val childHirId: Int = this.lowerExpr(ast, childId)
            if (childHirId >= 0) {
                hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
            }
            i = i + 1
        }
        // 回填返回类型（预登记表；String 隐式拼接包裹依赖它识别调用结果）。
        // 先按 `名/实参个数` 查（重载各自类型），退回裸名。
        val arK: String = calleeName + "/" + toStr(kCount - argStart)
        var callTy: String = this.kvGet(this.funcRetTys, arK)
        if (callTy == "") {
            callTy = this.kvGet(this.funcRetTys, calleeName)
        }
        // 重载按元数撞键时（`add/2` 既有 (Int,Int) 又有 (Int,Double)），首见
        // 登记可能偏窄 ⇒ 结果静态标 Int、运行时 double 位型 ⇒ toString 装箱
        // 打印垃圾（实测 17-function-overload `add(3, 1.5)`）。按实参宽度
        // 提升数值返回类型。
        if (callTy != "" && this.tyRank(callTy) > 0) {
            var ai: Int = argStart
            while (ai < HirUtils.hirKidsCount(hirKids)) {
                val aty: String = this.hir.tyOf(HirUtils.hirKidsAt(hirKids, ai))
                if (this.tyRank(aty) > this.tyRank(callTy)) {
                    callTy = aty
                }
                ai = ai + 1
            }
        }
        return this.hir.add("HirCall", calleeName, callTy, sp, hirKids)
    }

    /// 降级成员访问表达式。
    fun lowerMember(ast: Ast, id: Int): Int {
        val memberName: String = ast.textOf(id)
        val sp: Span = ast.spanOf(id)
        val kids: List<Int> = ast.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        var hirKids: List<Int> = HirUtils.hirNoKids()
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            val childHirId: Int = this.lowerExpr(ast, childId)
            if (childHirId >= 0) {
                hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
            }
            i = i + 1
        }
        var mty: String = ""
        if (memberName == "length" || memberName == "size") {
            mty = "Int"
        }
        // enum 成员折叠：接收者是已知类型名且成员在 enum 表 → HirLit(序号)。
        // 此前 ColorKind.RED 发 __field_get(0,0)（基址 0 段错误）。
        if (kCount >= 1) {
            val evRecv: Int = HirUtils.hirKidsAt(kids, 0)
            if (this.ast.kindOf(evRecv) == "Ident") {
                val evCls: String = this.ast.textOf(evRecv)
                if (evCls != "" && this.isKnownTypeName(evCls)) {
                    val evKey: String = "\n" + evCls + "." + memberName + "="
                    val evPos: Int = this.enumMembersCsv.indexOf(evKey)
                    if (evPos >= 0) {
                        var evE: Int = evPos + evKey.length
                        while (evE < this.enumMembersCsv.length
                                && this.enumMembersCsv.charCodeAt(evE) != 10) {
                            evE = evE + 1
                        }
                        val evIdx: String = this.enumMembersCsv.substring(evPos + evKey.length, evE)
                        if (evIdx != "") {
                            return this.hir.add("HirLit", evIdx, "Int", sp,
                                    HirUtils.hirNoKids())
                        }
                    }
                }
            }
        }
        // 伴生常量折叠：接收者是已知类型名且成员在伴生常量表 → HirLit。
        // 此前 MathUtil.BASE 发 __field_get(0,0)（基址 0 段错误）。
        if (kCount >= 1) {
            val cvRecv: Int = HirUtils.hirKidsAt(kids, 0)
            if (this.ast.kindOf(cvRecv) == "Ident") {
                val cvCls: String = this.ast.textOf(cvRecv)
                if (cvCls != "" && this.isKnownTypeName(cvCls)) {
                    val cvKey: String = "\n" + cvCls + "." + memberName + "="
                    // 键唯一（Type.name），单次查找即可；双参 indexOf 在
                    // 本运行时忽略起点，不能用。
                    val cvPos: Int = this.companionValsCsv.indexOf(cvKey)
                    if (cvPos >= 0) {
                        var cvE: Int = cvPos + cvKey.length
                        while (cvE < this.companionValsCsv.length
                                && this.companionValsCsv.charCodeAt(cvE) != 10) {
                            cvE = cvE + 1
                        }
                        val cvRow: String = this.companionValsCsv.substring(cvPos + cvKey.length, cvE)
                        val cvBar: Int = cvRow.indexOf("|")
                        if (cvBar > 0) {
                            return this.hir.add("HirLit",
                                    cvRow.substring(0, cvBar),
                                    cvRow.substring(cvBar + 1, cvRow.length),
                                    sp, HirUtils.hirNoKids())
                        }
                    }
                }
            }
        }
        if (mty == "" && HirUtils.hirKidsCount(hirKids) > 0) {
            // 字段类型回填：接收者 ty（类名）→ 预登记字段表
            //（typeMemberTys 条目 `Class.field=Ty`，kvGet 按 `Class.field=`
            // 前缀命中、返回 Ty）。String 隐式拼接包裹依赖 HirMember ty。
            val recvTy: String = this.hir.tyOf(HirUtils.hirKidsAt(hirKids, 0))
            if (recvTy != "") {
                val fty: String = this.kvGet(this.typeMemberTys, recvTy + "." + memberName)
                if (fty != "") {
                    mty = fty
                }
            }
        }
        return this.hir.add("HirMember", memberName, mty, sp, hirKids)
    }

    /// 降级安全调用 `recv?.name` → `if (recv != null) recv.name else null`。
    /// SafeAccess 节点与 Member 同形（text=成员名,kids=[接收者]）,
    /// lowerMember 可原样复用。结果类型取 ast.tyOf,缺失按 length/size
    /// → Int?、其余 → Int? 兜底（可空语义,phi/toStrN 据此打 null）。
    fun lowerSafeAccess(ast: Ast, id: Int): Int {
        val memberName: String = ast.textOf(id)
        val sp: Span = ast.spanOf(id)
        val kids: List<Int> = ast.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (kCount < 1) {
            return -1
        }
        val memberHir: Int = this.lowerMember(ast, id)
        var resTy: String = ast.tyOf(id)
        if (resTy == "") {
            resTy = "Int?"
            if (memberName == "length" || memberName == "size") {
                resTy = "Int?"
            }
        }
        val recvHir: Int = this.lowerExpr(ast, HirUtils.hirKidsAt(kids, 0))
        if (recvHir < 0) {
            return memberHir
        }
        val nullLit: Int = this.hir.add("HirLit", "null", resTy, sp, HirUtils.hirNoKids())
        var condKids: List<Int> = HirUtils.hirKidsAdd(HirUtils.hirNoKids(), recvHir)
        condKids = HirUtils.hirKidsAdd(condKids, nullLit)
        val cond: Int = this.hir.add("HirBinary", "!=", "Boolean", sp, condKids)
        var ifKids: List<Int> = HirUtils.hirKidsAdd(HirUtils.hirNoKids(), cond)
        ifKids = HirUtils.hirKidsAdd(ifKids, memberHir)
        ifKids = HirUtils.hirKidsAdd(ifKids, nullLit)
        return this.hir.add("HirIfExpr", "", resTy, sp, ifKids)
    }

    /// 降级下标访问表达式。
    fun lowerIndex(ast: Ast, id: Int): Int {
        val sp: Span = ast.spanOf(id)
        val kids: List<Int> = ast.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        var hirKids: List<Int> = HirUtils.hirNoKids()
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            val childHirId: Int = this.lowerExpr(ast, childId)
            if (childHirId >= 0) {
                hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
            }
            i = i + 1
        }
        return this.hir.add("HirIndex", "", "", sp, hirKids)
    }

    /// 降级 if 表达式。
    fun lowerIfExpr(ast: Ast, id: Int): Int {
        val sp: Span = ast.spanOf(id)
        val kids: List<Int> = ast.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        var hirKids: List<Int> = HirUtils.hirNoKids()
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            // 条件按表达式、分支按「块/单条语句/表达式」降级
            var childHirId: Int = -1
            if (i == 0) {
                childHirId = this.lowerExpr(ast, childId)
            } else if (ast.kindOf(childId) == "If") {
                // else-if 链（表达式上下文）：必须按**嵌套 HirIfExpr 表达式**
                // 降级进 phi 链。走 lowerBranch 会包成 HirBlock 语句，
                // SsaBuilder.buildStmt 静默跳过 HirIfExpr ⇒ else 臂 = @null
                //（实测 toString_implicit_test §8 `grade` 外层 phi 合并出 null
                // → println 段错误）。
                childHirId = this.lowerIfExpr(ast, childId)
            } else {
                childHirId = this.lowerBranch(ast, childId)
            }
            if (childHirId >= 0) {
                hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
            }
            i = i + 1
        }
        return this.hir.add("HirIfExpr", "", "", sp, hirKids)
    }

    /// 降级 when 表达式（Phase B.1 / C.4）。
    ///
    /// AST 形状：`When([subject], WhenArms([WhenArm(pattern, body)...])])`
    /// HIR 形状：**直接降级为嵌套 `HirIfExpr`**。
    ///
    /// 为什么不再保留 `HirWhen`：Aura 侧 AOT 发射器（Emit.aura）只实现到
    /// `HirIfExpr`，不处理 `HirWhen` —— 保留结构会让整个 when 表达式**静默
    /// 求值为 0**（实测 `when (x) { 1 -> 10 … }` 恒得 0，自举时 when 语义全错）。
    /// 降级算法与 Rust 后端 `desugar_when`（`compiler/src/codegen/hir.rs`）
    /// 保持一致：**从后往前**构造 else 链（最后一个 arm 成为最内层 else，
    /// 源码中第一个 arm 在最外层），`else ->` 分支条件恒为 `true`。
    fun lowerWhen(ast: Ast, id: Int): Int {
        val sp: Span = ast.spanOf(id)
        val kids: List<Int> = ast.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        // 可选 subject（非 WhenArms 的子节点）
        var subjectHir: Int = -1
        var armsId: Int = -1
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            if (ast.kindOf(childId) == "WhenArms") {
                armsId = childId
            } else if (subjectHir < 0) {
                subjectHir = this.lowerExpr(ast, childId)
            }
            i = i + 1
        }
        if (armsId < 0) {
            return this.hir.add("HirLit", "0", "Int", sp, HirUtils.hirNoKids())
        }

        val armsKids: List<Int> = ast.kidsOfList(armsId)
        val armCount: Int = HirUtils.hirKidsCount(armsKids)

        var result: Int = -1
        var j: Int = armCount - 1
        while (j >= 0) {
            val armId: Int = HirUtils.hirKidsAt(armsKids, j)
            j = j - 1
            val armKids: List<Int> = ast.kidsOfList(armId)
            if (HirUtils.hirKidsCount(armKids) < 2) {
                continue
            }
            val patId: Int = HirUtils.hirKidsAt(armKids, 0)
            val bodyId: Int = HirUtils.hirKidsAt(armKids, 1)

            // 条件：`else ->` 恒真；有 subject → `subject == pattern`；
            // 无 subject → pattern 本身作为布尔条件
            var condHir: Int = -1
            val patText: String = ast.textOf(patId)
            if (patText == "__else__" || patText == "else") {
                condHir = this.hir.add("HirLit", "true", "Boolean", sp, HirUtils.hirNoKids())
            } else if (patText.startsWith("__is__")) {
                // `is T` 模式 → `aura_isOfType(subject, "T")`（不能走 `subject == pattern`：
                // 那会把模式标识符 `__is__T` 当变量比较，且 `aura_isOfType` 才是类型检查语义）
                if (subjectHir >= 0) {
                    val tname: String = patText.substring(6, patText.length)
                    var ik: List<Int> = HirUtils.hirKidsAdd(HirUtils.hirNoKids(), subjectHir)
                    val tl: Int = this.hir.add("HirLit", tname, "String", sp, HirUtils.hirNoKids())
                    ik = HirUtils.hirKidsAdd(ik, tl)
                    condHir = this.hir.add("HirCall", "aura_isOfType", "", ast.spanOf(armId), ik)
                }
            } else if (ast.kindOf(patId) == "InPattern") {
                // `in a..b` 范围模式 → `subject >= a && subject <= b`
                // （`a..<b` → `subject < b`）。分解区间上下界、复用既有比较/逻辑
                // 发射路径，避免为「区间成员测试」新增运行库/发射器分支。
                if (subjectHir >= 0) {
                    val pk: List<Int> = ast.kidsOfList(patId)
                    if (HirUtils.hirKidsCount(pk) > 0) {
                        val rngAst: Int = HirUtils.hirKidsAt(pk, 0)
                        val rk: List<Int> = ast.kidsOfList(rngAst)
                        if (HirUtils.hirKidsCount(rk) >= 2) {
                            val loHir: Int = this.lowerExpr(ast, HirUtils.hirKidsAt(rk, 0))
                            val hiHir: Int = this.lowerExpr(ast, HirUtils.hirKidsAt(rk, 1))
                            if (loHir >= 0 && hiHir >= 0) {
                                val kLo: List<Int> = HirUtils.hirKidsAdd(HirUtils.hirKidsAdd(HirUtils.hirNoKids(), subjectHir), loHir)
                                val geNode: Int = this.hir.add("HirBinary", ">=",
                                    "", ast.spanOf(armId), kLo)
                                var hiOp: String = "<="
                                if (ast.textOf(rngAst) == "0") {
                                    hiOp = "<"
                                }
                                val kHi: List<Int> = HirUtils.hirKidsAdd(HirUtils.hirKidsAdd(HirUtils.hirNoKids(), subjectHir), hiHir)
                                val leNode: Int = this.hir.add("HirBinary", hiOp,
                                    "", ast.spanOf(armId), kHi)
                                val kBoth: List<Int> = HirUtils.hirKidsAdd(HirUtils.hirKidsAdd(HirUtils.hirNoKids(), geNode), leNode)
                                condHir = this.hir.add("HirBinary", "&&",
                                    "", ast.spanOf(armId), kBoth)
                            }
                        }
                    }
                }
            } else {
                val patHir: Int = this.lowerExpr(ast, patId)
                if (patHir >= 0) {
                    if (subjectHir >= 0) {
                        var ck: List<Int> = HirUtils.hirNoKids()
                        ck = HirUtils.hirKidsAdd(ck, subjectHir)
                        ck = HirUtils.hirKidsAdd(ck, patHir)
                        condHir = this.hir.add("HirBinary", "==", "", ast.spanOf(armId), ck)
                    } else {
                        condHir = patHir
                    }
                }
            }
            if (condHir < 0) {
                continue
            }
            val bodyHir: Int = this.lowerBlockOrExpr(ast, bodyId)
            if (bodyHir < 0) {
                continue
            }

            var ifKids: List<Int> = HirUtils.hirNoKids()
            ifKids = HirUtils.hirKidsAdd(ifKids, condHir)
            ifKids = HirUtils.hirKidsAdd(ifKids, bodyHir)
            if (result >= 0) {
                ifKids = HirUtils.hirKidsAdd(ifKids, result)
            }
            result = this.hir.add("HirIfExpr", "", "", sp, ifKids)
        }

        if (result >= 0) {
            return result
        }
        return this.hir.add("HirLit", "0", "Int", sp, HirUtils.hirNoKids())
    }

    /// 降级 try/catch/finally（Phase B.4）。
    ///
    /// AST 形状：`Try(catchVar, [body, catchBlock, finallyBlock])`
    /// HIR 形状：`HirTry(catchVar, [body, catchBlock, finallyBlock])`
    ///
    /// 三段**恒存在**（Parser.parseTry 对缺失的 catch/finally 补空 Block 占位），
    /// 否则 `try {} finally {}` 与 `try {} catch {}` 无法区分。
    fun lowerTry(ast: Ast, id: Int): Int {
        val sp: Span = ast.spanOf(id)
        val catchVar: String = ast.textOf(id)
        val kids: List<Int> = ast.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        var hirKids: List<Int> = HirUtils.hirNoKids()
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            val childHirId: Int = this.lowerBlockOrExpr(ast, childId)
            if (childHirId >= 0) {
                hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
            }
            i = i + 1
        }
        return this.hir.add("HirTry", catchVar, "", sp, hirKids)
    }

    /// 降级 lambda / closure（Phase B.2）。
    ///
    /// AST 形状：`Lambda/Closure([params], body)`
    /// HIR 形状：`HirLambda([HirParam...], body)`
    fun lowerLambda(ast: Ast, id: Int): Int {
        val sp: Span = ast.spanOf(id)
        val kids: List<Int> = ast.kidsOfList(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        var hirKids: List<Int> = HirUtils.hirNoKids()
        var paramsStr: List<Int> = HirUtils.hirNoKids()

        // 子节点 0：参数列表
        if (kCount >= 1) {
            val paramsNodeId: Int = HirUtils.hirKidsAt(kids, 0)
            val paramsKids: List<Int> = ast.kidsOfList(paramsNodeId)
            val pkCount: Int = HirUtils.hirKidsCount(paramsKids)
            var pi: Int = 0
            while (pi < pkCount) {
                val pId: Int = HirUtils.hirKidsAt(paramsKids, pi)
                val pName: String = ast.textOf(pId)
                val pTy: String = this.cleanTy(ast.tyOf(pId))
                // 2026-10-02 接收者类型传播：参数登记进 localVarTys（List 参数
                // 接收者的 .size()/.get() 限定依赖它 —— 实测 registerAucClasses
                // 的 names.size()/parentIds.get(i) 全靠此登记）。
                if (pTy != "" && this.localVarTy(pName) == "") {
                    this.localVarTys = this.kvAdd(this.localVarTys, pName, pTy)
                }
                val pSp: Span = ast.spanOf(pId)
                // 默认参数值：作为 HirParam 的 kids[0]，供调用点补齐实参
                var pKids: List<Int> = HirUtils.hirNoKids()
                val pAstKids: List<Int> = ast.kidsOfList(pId)
                if (HirUtils.hirKidsCount(pAstKids) > 0) {
                    val dId: Int = this.lowerExpr(ast, HirUtils.hirKidsAt(pAstKids, 0))
                    if (dId >= 0) {
                        pKids = HirUtils.hirKidsAdd(pKids, dId)
                    }
                }
                val paramId: Int = this.hir.add("HirParam", pName, pTy, pSp, pKids)
                paramsStr = HirUtils.hirKidsAdd(paramsStr, paramId)
                pi = pi + 1
            }
        }
        // 注意：`paramsStr` 是**子节点 id 列表**（逗号分隔串），必须用
        // `hirKidsConcat` 拼接。旧实现误用 `hirKidsAdd`（形参是 Int）——
        // Rust 侧把 String 实参强转成 Int（取指针低 32 位），在自举产物里
        // 直接变成垃圾 id（`HirLambda kids=-919700240,3`），lambda 形参因此全部丢失。
        hirKids = HirUtils.hirKidsConcat(hirKids, paramsStr)

        // 子节点 1：body
        if (kCount >= 2) {
            val bodyAstId: Int = HirUtils.hirKidsAt(kids, 1)
            val bodyHirId: Int = this.lowerBlockOrExpr(ast, bodyAstId)
            if (bodyHirId >= 0) {
                hirKids = HirUtils.hirKidsAdd(hirKids, bodyHirId)
            }
        }

        return this.hir.add("HirLambda", "", "", sp, hirKids)
    }
}



