// aura:///aura/lang/compiler/hir/Hir.aura
package aura.lang.compiler.hir
// ─────────────────────────────────────────────────────────────
// HIR（高级中间表示）— 纯 Aura 化迁移 · Phase 2 (任务 2.5)
//
// 对应 Rust `compiler/src/codegen/hir.rs`（211 KB / 5777 行）。
//
// ── 设计方式（与 Ast.aura 一致）──────────────────────────────
//
// HIR 是去除了语法糖的 AST。本版聚焦核心降级：
//   * 字面量 / 标识符 / 字面量 → HirLit / HirVar
//   * 一元 / 二元运算 → HirUnary / HirBinary
//   * 函数调用 → HirCall
//   * 成员访问 / 下标 → HirMember / HirIndex
//   * val / var 声明 → HirValDecl / HirVarDecl
//   * if / while / for 语句 → HirIf / HirWhile / HirFor
//   * return / break / continue / assign / exprStmt → 对应语句节点
//   * 块 → HirBlock
//
// ── 扁平 arena 表示（与 Ast 一致）───────────────────────────
//
//   * 每个 HIR 节点一个整数 id；
//   * 节点字段分别存在 5 条「每行一项」的 String 中
//     （kinds / texts / tys / span 的 6 条并列 Int 列表 / kids）；
//   * 子节点以逗号分隔的 id 列表存在 `kids` 中。
//
// ── 当前覆盖范围（Phase 2 起步，可逐步扩展）──────────────
//
// 暂不覆盖的降级（后续扩展）：
//   - `when` → 嵌套 `if`（本版保留 When 节点）
//   - `for` → `while` + 索引变量（本版保留 For 节点）
//   - 字符串插值降级
//   - 安全调用降级
//   - Elvis 降级
//   - 闭包 / lambda 降级
//   - 类方法分派（sema 类型信息依赖）
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String

object HirUtils {

    /// 归一化二元运算符：把词法 TokenKind 名（Plus/Star…）转为符号（+/*…）。
    ///
    /// 说明：Parser 的 Binary.text 存的是 TokenKind 名，而 MIR/Codegen 按符号匹配，
    /// 若不归一化则所有二元运算都会退化为默认的 ADD。
    fun hirNormBinOp(op: String): String {
        if (op == "Plus" || op == "+") { return "+" }
        if (op == "Minus" || op == "-") { return "-" }
        if (op == "Star" || op == "*") { return "*" }
        if (op == "Slash" || op == "/") { return "/" }
        if (op == "Percent" || op == "%") { return "%" }
        if (op == "EqEq" || op == "==") { return "==" }
        if (op == "Neq" || op == "!=") { return "!=" }
        if (op == "Lt" || op == "<") { return "<" }
        if (op == "Gt" || op == ">") { return ">" }
        if (op == "LtEq" || op == "<=") { return "<=" }
        if (op == "GtEq" || op == ">=") { return ">=" }
        if (op == "AndAnd" || op == "&&") { return "&&" }
        if (op == "OrOr" || op == "||") { return "||" }
        if (op == "ElvisColon" || op == "?:") { return "?:" }
        if (op == "LtLt" || op == "<<") { return "<<" }
        if (op == "GtGt" || op == ">>") { return ">>" }
        if (op == "GtGtGt" || op == ">>>") { return ">>>" }
        // 位运算（符号形式）：`&` / `|` / `^`。不归一化则发射器拿不到运算符文本，
        // 二元表达式退化为默认可选分支（错误的 IR）。
        if (op == "Ampersand" || op == "&") { return "&" }
        if (op == "Pipe" || op == "|") { return "|" }
        if (op == "Caret" || op == "^") { return "^" }
        return op
    }

    /// 归一化一元运算符：Minus→-、Bang→!、Plus→+。
    fun hirNormUnOp(op: String): String {
        if (op == "Minus" || op == "-") { return "-" }
        if (op == "Bang" || op == "!") { return "!" }
        if (op == "Plus" || op == "+") { return "+" }
        return op
    }

    /// 空的子节点列表。
    fun hirNoKids(): String {
        return ""
    }

    /// 列表安全取项（越界返回空串）；arena 各流（kinds/texts/tys/kids）
    /// 的下标访问统一走此处，O(1)。
    fun hirItemAt(items: List<String>, index: Int): String {
        if (index < 0 || index >= items.size) {
            return ""
        }
        return items[index]
    }

    /// Int 堆列表安全取项（越界返回 0）；span 的 6 条并列流下标访问统一走此处，O(1)。
    fun hirIntAt(items: List<Int>, index: Int): Int {
        if (index < 0 || index >= items.size) {
            return 0
        }
        return items[index]
    }

    /// 向子节点列表追加一个 id。
    fun hirKidsAdd(list: String, child: Int): String {
        if (list == "") {
            return toStr(child)
        }
        return list + "," + toStr(child)
    }

    /// 拼接两个子节点 id 列表（逗号分隔，空串安全）。
    fun hirKidsConcat(a: String, b: String): String {
        if (a == "") {
            return b
        }
        if (b == "") {
            return a
        }
        return a + "," + b
    }

    /// 子节点列表的长度（单次扫描计数；不再 split 分配整张表）。
    fun hirKidsCount(list: String): Int {
        if (list == "") {
            return 0
        }
        var count: Int = 1
        var i: Int = 0
        val len: Int = list.length
        while (i < len) {
            if (toStr(list[i]) == ",") {
                count = count + 1
            }
            i = i + 1
        }
        return count
    }

    /// 取子节点列表的第 index 个 id。
    fun hirKidsAt(list: String, index: Int): Int {
        return HirUtils.hirToIntOf(HirUtils.hirFieldAt(list, index, ","))
    }

    /// 取第 index 个以 sep 分隔的字段。
    ///
    /// 单次扫描 + 一次切片：旧实现用 substringAfter 链，索引 i 的调用要
    /// 分配 i 个「剩余串」，配合无 GC 的 AOT 运行时是平方级内存黑洞。
    fun hirFieldAt(text: String, index: Int, sep: String): String {
        if (index < 0) {
            return ""
        }
        val len: Int = text.length
        var cur: Int = 0
        var start: Int = 0
        var i: Int = 0
        while (i < len) {
            if (toStr(text[i]) == sep) {
                if (cur == index) {
                    return text.substring(start, i)
                }
                cur = cur + 1
                start = i + 1
            }
            i = i + 1
        }
        if (cur == index) {
            return text.substring(start, len)
        }
        return ""
    }

    /// 十进制字符串 → Int。
    fun hirToIntOf(text: String): Int {
        if (text == "") {
            return 0
        }
        val len: Int = text.length
        var total: Int = 0
        var i: Int = 0
        var neg: Boolean = false
        // 处理负号
        if (len > 0 && toStr(text[0]) == "-") {
            neg = true
            i = 1
        }
        while (i < len) {
            val c: String = toStr(text[i])
            var digit: Int = -1
            if (c == "0") {
                digit = 0
            } else if (c == "1") {
                digit = 1
            } else if (c == "2") {
                digit = 2
            } else if (c == "3") {
                digit = 3
            } else if (c == "4") {
                digit = 4
            } else if (c == "5") {
                digit = 5
            } else if (c == "6") {
                digit = 6
            } else if (c == "7") {
                digit = 7
            } else if (c == "8") {
                digit = 8
            } else if (c == "9") {
                digit = 9
            }
            if (digit >= 0) {
                total = total * 10 + digit
            }
            i = i + 1
        }
        if (neg) {
            return -total
        }
        return total
    }}



/// HIR 节点表示（扁平 arena，与 Ast.aura 结构一致）。
class Hir {

    private var kinds: List<String> = arrayListOf<String>()

    /// 节点主文本：标识符名 / 字面量文本 / 运算符（堆列表，换行已转义）。
    private var texts: List<String> = arrayListOf<String>()

    /// 节点类型名（堆列表；无类型信息时为空串）。
    private var tys: List<String> = arrayListOf<String>()

    /// Span 分量（6 条**并列 Int 堆列表**）。
    private var spanStart: List<Int> = arrayListOf<Int>()

    /// 结束偏移。
    private var spanEnd: List<Int> = arrayListOf<Int>()

    /// 起始行。
    private var spanStartLine: List<Int> = arrayListOf<Int>()

    /// 起始列。
    private var spanStartCol: List<Int> = arrayListOf<Int>()

    /// 结束行。
    private var spanEndLine: List<Int> = arrayListOf<Int>()

    /// 结束列。
    private var spanEndCol: List<Int> = arrayListOf<Int>()

    /// 子节点 id 列表（堆列表，每项为逗号分隔串，可为空串）。
    private var kids: List<String> = arrayListOf<String>()

    /// 节点总数。
    var count: Int = 0

    /// 根节点 id（由 lower 方法设置）。
    var rootId: Int = 0

    // ── 构造 ──

    /// 追加一个节点，返回其 id。
    ///
    /// 注意：`id` 取 `kinds.size`、并在追加后回写 `count = kinds.size`。
    /// 这样即使 `Hir` 实例被**浅拷贝**（Rust AOT 后端对结构体参数/字段按值传递），
    /// 拷贝与原值仍共享同一组堆列表（`List` = `i8*`），`count` 也能自愈一致；
    /// 否则标量 `count` 会在拷贝间失步（曾导致原生编译器的 HIR 静默为空）。
    fun add(kind: String, text: String, ty: String, sp: Span, children: String): Int {
        val id: Int = this.kinds.size
        this.kinds.add(kind)
        // 手动转义换行符（避免 replace 在 VM 内类调用时未链接）。
        // 绝大多数 text 不含换行：单次 `contains`（C `strstr`，零分配）判定后
        // 直接复用原串，避免逐字符重建长文本（token 文本可达数千字符）。
        var escaped: String = text
        if (text.contains("\n")) {
            val tlen: Int = text.length
            var buf: String = ""
            var i: Int = 0
            while (i < tlen) {
                if (toStr(text[i]) == "\n") {
                    buf = buf + "\\n"
                } else {
                    buf = buf + toStr(text[i])
                }
                i = i + 1
            }
            escaped = buf
        }
        this.texts.add(escaped)
        this.tys.add(ty)
        this.spanStart.add(sp.start)
        this.spanEnd.add(sp.end)
        this.spanStartLine.add(sp.startLine)
        this.spanStartCol.add(sp.startCol)
        this.spanEndLine.add(sp.endLine)
        this.spanEndCol.add(sp.endCol)
        this.kids.add(children)
        this.count = this.kinds.size
        return id
    }

    /// 追加一个无类型、无子节点的叶子节点。
    fun leaf(kind: String, text: String, sp: Span): Int {
        return this.add(kind, text, "", sp, HirUtils.hirNoKids())
    }

    // ── 访问 ──

    /// 第 id 个节点的种类。
    fun kindOf(id: Int): String {
        return HirUtils.hirItemAt(this.kinds, id)
    }

    /// 第 id 个节点的主文本。
    fun textOf(id: Int): String {
        val raw: String = HirUtils.hirItemAt(this.texts, id)
        // 绝大多数 text 不含换行转义：单次 `contains` 判定后直接复用原串，
        // 避免每次访问都逐字符重建（textOf 是发射期最热访问之一）。
        if (!raw.contains("\\")) {
            return raw
        }
        // 手动反转义换行符（避免 replace 在 VM 内类调用时未链接）
        var result: String = ""
        var i: Int = 0
        var len: Int = raw.length
        while (i < len) {
            if (i + 1 < len && toStr(raw[i]) == "\\" && toStr(raw[i + 1]) == "n") {
                result = result + "\n"
                i = i + 2
            } else {
                result = result + toStr(raw[i])
                i = i + 1
            }
        }
        return result
    }

    /// 第 id 个节点的类型名。
    fun tyOf(id: Int): String {
        return HirUtils.hirItemAt(this.tys, id)
    }

    /// 第 id 个节点的位置。
    fun spanOf(id: Int): Span {
        return Span(
            HirUtils.hirIntAt(this.spanStart, id), HirUtils.hirIntAt(this.spanEnd, id),
            HirUtils.hirIntAt(this.spanStartLine, id), HirUtils.hirIntAt(this.spanStartCol, id),
            HirUtils.hirIntAt(this.spanEndLine, id), HirUtils.hirIntAt(this.spanEndCol, id)
        )
    }

    /// 第 id 个节点的子节点 id 列表（逗号分隔串）。
    fun kidsOf(id: Int): String {
        return HirUtils.hirItemAt(this.kids, id)
    }

    /// 第 id 个节点的第 i 个子节点 id（越界返回 -1）。
    fun childOf(id: Int, i: Int): Int {
        val k: String = this.kidsOf(id)
        if (i >= HirUtils.hirKidsCount(k)) {
            return -1
        }
        return HirUtils.hirKidsAt(k, i)
    }

    // ── 输出 ──

    /// 从根节点开始的缩进文本转储。
    fun dump(): String {
        if (this.count == 0) {
            return "<empty hir>\n"
        }
        return this.dumpNode(this.rootId, 0)
    }

    /// 递归转储单个节点。
    fun dumpNode(id: Int, depth: Int): String {
        var line: String = this.indent(depth) + this.kindOf(id)
        val t: String = this.textOf(id)
        if (t != "") {
            line = line + " " + t
        }
        val ty: String = this.tyOf(id)
        if (ty != "") {
            line = line + " : " + ty
        }
        var out: String = line + "\n"

        val k: String = this.kidsOf(id)
        val n: Int = HirUtils.hirKidsCount(k)
        var i: Int = 0
        while (i < n) {
            out = out + this.dumpNode(HirUtils.hirKidsAt(k, i), depth + 1)
            i = i + 1
        }
        return out
    }

    /// 生成 depth 级缩进（每级 2 空格）。
    fun indent(depth: Int): String {
        var s: String = ""
        var i: Int = 0
        while (i < depth) {
            s = s + "  "
            i = i + 1
        }
        return s
    }

    /// 取第 index 行（内部辅助）。
    fun lineAt(text: String, index: Int): String {
        return HirUtils.hirFieldAt(text, index, "\n")
    }
}

// ─────────────────────────────────────────────────────────────
// AST → HIR 降级器
// ─────────────────────────────────────────────────────────────



class HirLowerer {

    private var ast: Ast = Ast()

    /// 输出的 HIR。
    private var hir: Hir = Hir()

    init() {
        this.ast = Ast()
        this.hir = Hir()
    }

    /// 执行降级，返回 HIR 根节点 id。
    fun lower(program: Ast): Int {
        println("[H1] lower enter astCount=" + toStr(program.count))
        this.ast = program
        this.hir = Hir()
        // 查找 Program 根节点（可能不在 index 0）
        val n: Int = program.count
        var rootIdx: Int = -1
        var i: Int = 0
        while (i < n) {
            if (program.kindOf(i) == "Program") {
                rootIdx = i
                break
            }
            i = i + 1
        }
        if (rootIdx < 0) {
            rootIdx = 0
        }
        // 根节点是 Program，其子节点是顶层声明
        val rootKids: String = program.kidsOf(rootIdx)
        val kCount: Int = HirUtils.hirKidsCount(rootKids)
        var hirKids: String = HirUtils.hirNoKids()
        i = 0
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(rootKids, i)
            val childHirId: Int = this.lowerDecl(program, childId)
            if (childHirId >= 0) {
                hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
            }
            i = i + 1
        }
        val rootHirId: Int = this.hir.add("HirProgram", "", "", program.spanOf(rootIdx), hirKids)
        this.hir.rootId = rootHirId
        return rootHirId
    }

    // ── 多模块合并（Phase 6.5.10：把多个 AST 的顶层声明降级进同一 HIR）──

    /// 设置目标 HIR（供模块链接器在多个源文件间共享同一产物）。
    fun useHir(target: Hir) {
        this.hir = target
    }

    /// 把 `program` 的顶层声明降级进当前 HIR，返回声明 id 列表（逗号分隔）。
    ///
    /// 与 [`lower`] 的区别：不新建 HIR、不添加 `HirProgram` 根，
    /// 只产出顶层声明，供模块链接器拼接。
    fun lowerTopLevel(program: Ast): String {
        this.ast = program
        val n: Int = program.count
        var rootIdx: Int = -1
        var i: Int = 0
        while (i < n) {
            if (program.kindOf(i) == "Program") {
                rootIdx = i
                break
            }
            i = i + 1
        }
        if (rootIdx < 0) {
            return HirUtils.hirNoKids()
        }
        val rootKids: String = program.kidsOf(rootIdx)
        val kCount: Int = HirUtils.hirKidsCount(rootKids)
        var out: String = HirUtils.hirNoKids()
        i = 0
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(rootKids, i)
            val h: Int = this.lowerDecl(program, childId)
            if (h >= 0) {
                out = HirUtils.hirKidsAdd(out, h)
            }
            i = i + 1
        }
        return out
    }

    // ── 声明降级 ──

    /// 降级一个顶层节点。
    fun lowerDecl(ast: Ast, id: Int): Int {
        val kind: String = ast.kindOf(id)
        val text: String = ast.textOf(id)
        val ty: String = ast.tyOf(id)
        val sp: Span = ast.spanOf(id)
        val kids: String = ast.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        if (kind == "Function") {
            return this.lowerFunction(ast, id)
        } else if (kind == "ValDecl") {
            return this.lowerValDecl(ast, id)
        } else if (kind == "VarDecl") {
            return this.lowerVarDecl(ast, id)
        } else if (kind == "Struct" || kind == "Class" || kind == "Object" || kind == "Enum") {
            return this.lowerTypeDecl(ast, id)
        } else if (kind == "ExternObject") {
            // extern object { @native ... / export fun ... / @aot fun ... }
            return this.lowerExternObject(ast, id)
        } else if (kind == "NativeMethod") {
            return this.lowerNativeMethod(ast, id)
        } else if (kind == "ExportMethod") {
            return this.lowerExportMethod(ast, id)
        } else if (kind == "AotMethod") {
            return this.lowerAotMethod(ast, id)
        } else if (kind == "Typealias") {
            // Typealias 在 HIR 中保留为注释性节点
            return this.hir.leaf("HirTypealias", text, sp)
        } else {
            // 其他顶层节点：如果是表达式，降级为 HirExpr
            // 如果是 Import / Package 等，跳过
            if (kind == "Import" || kind == "Package") {
                return -1
            }
            return this.lowerExpr(ast, id)
        }
    }

    /// 降级函数声明。
    fun lowerFunction(ast: Ast, id: Int): Int {
        val name: String = ast.textOf(id)
        val retTy: String = ast.tyOf(id)
        val sp: Span = ast.spanOf(id)
        val kids: String = ast.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        var paramsStr: String = ""
        var bodyId: Int = -1

        // 子节点 0: Params 节点
        if (kCount > 0) {
            val paramsNodeId: Int = HirUtils.hirKidsAt(kids, 0)
            val paramsKids: String = ast.kidsOf(paramsNodeId)
            val pkCount: Int = HirUtils.hirKidsCount(paramsKids)
            var pi: Int = 0
            while (pi < pkCount) {
                val pId: Int = HirUtils.hirKidsAt(paramsKids, pi)
                val pName: String = ast.textOf(pId)
                val pTy: String = ast.tyOf(pId)
                val pSp: Span = ast.spanOf(pId)
                // 默认参数值：作为 HirParam 的 kids[0]，供调用点补齐实参
                var pKids: String = HirUtils.hirNoKids()
                val pAstKids: String = ast.kidsOf(pId)
                if (HirUtils.hirKidsCount(pAstKids) > 0) {
                    val dId: Int = this.lowerExpr(ast, HirUtils.hirKidsAt(pAstKids, 0))
                    if (dId >= 0) {
                        pKids = HirUtils.hirKidsAdd(pKids, dId)
                    }
                }
                val paramId: Int = this.hir.add("HirParam", pName, pTy, pSp, pKids)
                paramsStr = HirUtils.hirKidsAdd(paramsStr, paramId)
                pi = pi + 1
            }
        }

        // 子节点 1: 函数体（Block 或单个表达式）
        if (kCount > 1) {
            val bodyAstId: Int = HirUtils.hirKidsAt(kids, 1)
            if (ast.kindOf(bodyAstId) == "Block") {
                bodyId = this.lowerBlockOrExpr(ast, bodyAstId)
            } else {
                // 表达式体函数 `fun f(x: Int): Int = x * x`：必须包装成
                // `return <expr>`，否则函数体是一个裸表达式，发射器按语句求值后
                // 落到「隐式返回零值」路径 —— 实测 `square(5)` 恒得 0。
                val e: Int = this.lowerExpr(ast, bodyAstId)
                if (e >= 0) {
                    bodyId = this.hir.add("HirReturn", "", "",
                        ast.spanOf(bodyAstId), HirUtils.hirKidsAdd(HirUtils.hirNoKids(), e))
                }
            }
        }

        // 构造 HirFunction 节点
        var hirKids: String = paramsStr
        if (bodyId >= 0) {
            hirKids = HirUtils.hirKidsAdd(hirKids, bodyId)
        }
        return this.hir.add("HirFunction", name, retTy, sp, hirKids)
    }

    // ── FFI 声明降级（Phase C.2：@native / export / @aot）──
    //
    // Aura 侧 AOT 发射器（Emit.aura）只消费 HIR；`extern object` 内的
    // `@native(...)` / `export fun` / `@aot fun` 若在此被丢弃，发射出的模块
    // 就会缺少这些符号的 LLVM 定义（自举编译器编译 `Syscalls.aura` 一类
    // 源码时直接崩溃/链接失败）。这里把它们降级为 HIR 节点：
    //   * HirNativeFunction  `@native(N)` / `native fun` / `@native(asm=…)`
    //     kids = [HirNativeInfo(metadata), HirParam…]
    //   * HirExportFunction  `export fun`（按普通函数发射，符号默认外部可见）
    //   * HirAotDecl         `@aot fun`（AOT 库函数 → declare）
    // 均不带函数体（原生/外部符号由 C 运行库或目标库提供）。

    /// 降级 extern object：容器节点，其方法在 Block 子节点内。
    ///
    /// 容器自身不生成 IR（`HirExternObject` 仅承载分组信息），
    /// 方法各自降级为独立的 arena 节点（供发射器按 kind 扫描）。
    fun lowerExternObject(ast: Ast, id: Int): Int {
        val name: String = ast.textOf(id)
        val sp: Span = ast.spanOf(id)
        val kids: String = ast.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        var hirKids: String = HirUtils.hirNoKids()
        var i: Int = 0
        while (i < kCount) {
            val bodyId: Int = HirUtils.hirKidsAt(kids, i)
            if (ast.kindOf(bodyId) == "Block") {
                val bodyKids: String = ast.kidsOf(bodyId)
                val bn: Int = HirUtils.hirKidsCount(bodyKids)
                var j: Int = 0
                while (j < bn) {
                    val h: Int = this.lowerDecl(ast, HirUtils.hirKidsAt(bodyKids, j))
                    if (h >= 0) {
                        hirKids = HirUtils.hirKidsAdd(hirKids, h)
                    }
                    j = j + 1
                }
            } else {
                val h: Int = this.lowerDecl(ast, bodyId)
                if (h >= 0) {
                    hirKids = HirUtils.hirKidsAdd(hirKids, h)
                }
            }
            i = i + 1
        }
        return this.hir.add("HirExternObject", name, "", sp, hirKids)
    }

    /// 降级 @native / native 方法 → `HirNativeFunction`。
    ///
    /// AST 形状：`NativeMethod(kids=[NativeInfo(metadata), Function])`；
    /// metadata 取值：`native|SYS_READ`（syscall）/ `asm|<code>` / `native`（内置）。
    fun lowerNativeMethod(ast: Ast, id: Int): Int {
        val kids: String = ast.kidsOf(id)
        if (HirUtils.hirKidsCount(kids) < 2) {
            return -1
        }
        val infoId: Int = HirUtils.hirKidsAt(kids, 0)
        val meta: String = ast.textOf(infoId)
        val fnId: Int = HirUtils.hirKidsAt(kids, 1)
        if (ast.kindOf(fnId) != "Function") {
            return -1
        }
        var outKids: String = HirUtils.hirNoKids()
        outKids = HirUtils.hirKidsAdd(outKids, this.hir.leaf("HirNativeInfo", meta, ast.spanOf(infoId)))
        outKids = HirUtils.hirKidsConcat(outKids, this.lowerParamIds(ast, fnId))
        return this.hir.add("HirNativeFunction", ast.textOf(fnId), ast.tyOf(fnId),
            ast.spanOf(fnId), outKids)
    }

    /// 降级 `export fun`：按普通函数发射（LLVM `define` 默认外部链接，
    /// 符号即可被 C/其他模块解析）。
    fun lowerExportMethod(ast: Ast, id: Int): Int {
        val kids: String = ast.kidsOf(id)
        if (HirUtils.hirKidsCount(kids) < 1) {
            return -1
        }
        val fnId: Int = HirUtils.hirKidsAt(kids, 0)
        if (ast.kindOf(fnId) != "Function") {
            return -1
        }
        return this.lowerFunction(ast, fnId)
    }

    /// 降级 `@aot fun`：AOT 库函数，发射为外部 `declare`（库在链接期解析）。
    fun lowerAotMethod(ast: Ast, id: Int): Int {
        val kids: String = ast.kidsOf(id)
        if (HirUtils.hirKidsCount(kids) < 2) {
            return -1
        }
        val fnId: Int = HirUtils.hirKidsAt(kids, 1)
        if (ast.kindOf(fnId) != "Function") {
            return -1
        }
        val paramIds: String = this.lowerParamIds(ast, fnId)
        return this.hir.add("HirAotDecl", ast.textOf(fnId), ast.tyOf(fnId),
            ast.spanOf(fnId), paramIds)
    }

    /// 降级函数形参 → `HirParam` id 列表（逗号分隔；fkids[0] 为 Params）。
    fun lowerParamIds(ast: Ast, fnId: Int): String {
        val kids: String = ast.kidsOf(fnId)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        var out: String = HirUtils.hirNoKids()
        var i: Int = 0
        while (i < kCount) {
            val kidId: Int = HirUtils.hirKidsAt(kids, i)
            if (ast.kindOf(kidId) == "Params") {
                val pk: String = ast.kidsOf(kidId)
                val pn: Int = HirUtils.hirKidsCount(pk)
                var j: Int = 0
                while (j < pn) {
                    val pId: Int = HirUtils.hirKidsAt(pk, j)
                    if (ast.kindOf(pId) == "Param") {
                        val h: Int = this.hir.add("HirParam", ast.textOf(pId),
                            ast.tyOf(pId), ast.spanOf(pId), HirUtils.hirNoKids())
                        out = HirUtils.hirKidsAdd(out, h)
                    }
                    j = j + 1
                }
            }
            i = i + 1
        }
        return out
    }

    /// 降级 val 声明。
    fun lowerValDecl(ast: Ast, id: Int): Int {
        val name: String = ast.textOf(id)
        var ty: String = ast.tyOf(id)
        val sp: Span = ast.spanOf(id)
        val kids: String = ast.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        var hirKids: String = HirUtils.hirNoKids()
        if (kCount > 0) {
            val initId: Int = HirUtils.hirKidsAt(kids, 0)
            val initHirId: Int = this.lowerExpr(ast, initId)
            hirKids = HirUtils.hirKidsAdd(hirKids, initHirId)
            // 无显式类型标注时，从初始化表达式推断（Phase 6.5.7）
            if (ty == "" && initHirId >= 0) {
                ty = this.hir.tyOf(initHirId)
            }
        }
        return this.hir.add("HirValDecl", name, ty, sp, hirKids)
    }

    /// 降级 var 声明。
    fun lowerVarDecl(ast: Ast, id: Int): Int {
        val name: String = ast.textOf(id)
        var ty: String = ast.tyOf(id)
        val sp: Span = ast.spanOf(id)
        val kids: String = ast.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        var hirKids: String = HirUtils.hirNoKids()
        if (kCount > 0) {
            val initId: Int = HirUtils.hirKidsAt(kids, 0)
            val initHirId: Int = this.lowerExpr(ast, initId)
            hirKids = HirUtils.hirKidsAdd(hirKids, initHirId)
            if (ty == "" && initHirId >= 0) {
                ty = this.hir.tyOf(initHirId)
            }
        }
        return this.hir.add("HirVarDecl", name, ty, sp, hirKids)
    }

    /// 降级类型声明（struct/class/object/enum）。
    fun lowerTypeDecl(ast: Ast, id: Int): Int {
        val kind: String = ast.kindOf(id)
        val name: String = ast.textOf(id)
        val sp: Span = ast.spanOf(id)
        val kids: String = ast.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        var hirKids: String = HirUtils.hirNoKids()
        if (kCount > 0) {
            // 类型体的 Block
            val bodyId: Int = HirUtils.hirKidsAt(kids, 0)
            val bodyHirId: Int = this.lowerBlockOrExpr(ast, bodyId)
            if (bodyHirId >= 0) {
                hirKids = HirUtils.hirKidsAdd(hirKids, bodyHirId)
            }
        }

        val hirKind: String = if (kind == "Struct") { "HirStruct" }
            else if (kind == "Class") { "HirClass" }
            else if (kind == "Object") { "HirObject" }
            else { "HirEnum" }
        // ty 列承载**基类名**（`class Dog : Animal()` → "Animal"）：
        // 发射器据此解析 `super.m()` 与继承方法的回退查找
        return this.hir.add(hirKind, name, ast.tyOf(id), sp, hirKids)
    }

    // ── 块/表达式降级 ──

    /// 降级块或表达式（用于函数体等）。
    fun lowerBlockOrExpr(ast: Ast, id: Int): Int {
        val kind: String = ast.kindOf(id)
        if (kind == "Block") {
            return this.lowerBlock(ast, id)
        } else {
            return this.lowerExpr(ast, id)
        }
    }

    /// 降级 if/when 分支：块 / **单条语句** / 表达式。
    ///
    /// `Parser.parseBranch` 对无花括号的分支走 `parseStatement`，因此分支可能
    /// 是 `Assign` / `ExprStmt` / `Return` / `ValDecl` 等**语句节点**；这些必须
    /// 经 `lowerStmt` 降级并包一层 `HirBlock`（发射器按「块或表达式」消费分支，
    /// 单条语句直接放进值位置会丢失副作用）。
    fun lowerBranch(ast: Ast, id: Int): Int {
        val kind: String = ast.kindOf(id)
        if (kind == "Block") {
            return this.lowerBlock(ast, id)
        }
        if (kind == "Assign" || kind == "ExprStmt" || kind == "Return"
            || kind == "ValDecl" || kind == "VarDecl" || kind == "While"
            || kind == "For" || kind == "CFor" || kind == "Break"
            || kind == "Continue" || kind == "Try") {
            val s: Int = this.lowerStmt(ast, id)
            if (s < 0) {
                return -1
            }
            var bk: String = HirUtils.hirKidsAdd(HirUtils.hirNoKids(), s)
            return this.hir.add("HirBlock", "", "", ast.spanOf(id), bk)
        }
        return this.lowerExpr(ast, id)
    }

    /// 降级语句块。
    fun lowerBlock(ast: Ast, id: Int): Int {
        val sp: Span = ast.spanOf(id)
        val kids: String = ast.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        var hirKids: String = HirUtils.hirNoKids()
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            val childHirId: Int = this.lowerStmt(ast, childId)
            if (childHirId >= 0) {
                hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
            }
            i = i + 1
        }
        return this.hir.add("HirBlock", "", "", sp, hirKids)
    }

    // ── 语句降级 ──

    /// 降级语句。
    fun lowerStmt(ast: Ast, id: Int): Int {
        val kind: String = ast.kindOf(id)
        if (kind == "ValDecl") {
            return this.lowerValDecl(ast, id)
        } else if (kind == "VarDecl") {
            return this.lowerVarDecl(ast, id)
        } else if (kind == "Function") {
            // 类体/嵌套块中的函数声明（类方法）——此前未处理，导致类方法整体丢失
            return this.lowerFunction(ast, id)
        } else if (kind == "InitBlock") {
            // 构造初始化块 `init { ... }` → 合成 `<Class>.init` 方法体（Phase 6.5.1b）
            return this.lowerInitBlock(ast, id)
        } else if (kind == "Return") {
            return this.lowerReturn(ast, id)
        } else if (kind == "If") {
            return this.lowerIfStmt(ast, id)
        } else if (kind == "While") {
            return this.lowerWhile(ast, id)
        } else if (kind == "For") {
            return this.lowerFor(ast, id)
        } else if (kind == "CFor") {
            return this.lowerCFor(ast, id)
        } else if (kind == "Block") {
            return this.lowerBlock(ast, id)
        } else if (kind == "Assign") {
            return this.lowerAssign(ast, id)
        } else if (kind == "Break") {
            return this.hir.leaf("HirBreak", "", ast.spanOf(id))
        } else if (kind == "Continue") {
            return this.hir.leaf("HirContinue", "", ast.spanOf(id))
        } else if (kind == "ExprStmt") {
            return this.lowerExprStmt(ast, id)
        } else if (kind == "Try") {
            return this.lowerTry(ast, id)
        } else if (kind == "Lambda") {
            return this.lowerLambda(ast, id)
        } else if (kind == "Closure") {
            return this.lowerLambda(ast, id)
        } else if (kind == "Defer") {
            return this.hir.leaf("HirDefer", "", ast.spanOf(id))
        } else if (kind == "Throw") {
            return this.lowerThrow(ast, id)
        } else {
            // 其他语句类型暂不处理
            return -1
        }
    }

    /// 降级构造初始化块：合成 `HirFunction "init"`（仅带方法体，无 HirParam）。
    ///
    /// 类体 Block 的某个子节点若是 InitBlock，则本方法产出 HirFunction，
    /// 使发射器侧的「方法所属类」扫描能把它识别为 `<Class>.init`；
    /// AOT 的 `X()` 构造在字段初始化后调用它。
    fun lowerInitBlock(ast: Ast, id: Int): Int {
        val sp: Span = ast.spanOf(id)
        val kids: String = ast.kidsOf(id)
        var bodyId: Int = -1
        if (HirUtils.hirKidsCount(kids) > 0) {
            bodyId = this.lowerBlockOrExpr(ast, HirUtils.hirKidsAt(kids, 0))
        }
        var hirKids: String = HirUtils.hirNoKids()
        if (bodyId >= 0) {
            hirKids = HirUtils.hirKidsAdd(hirKids, bodyId)
        }
        return this.hir.add("HirFunction", "init", "", sp, hirKids)
    }

    /// 降级 return 语句。
    fun lowerReturn(ast: Ast, id: Int): Int {
        val sp: Span = ast.spanOf(id)
        val kids: String = ast.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        var hirKids: String = HirUtils.hirNoKids()
        if (kCount > 0) {
            val valId: Int = HirUtils.hirKidsAt(kids, 0)
            val valHirId: Int = this.lowerExpr(ast, valId)
            hirKids = HirUtils.hirKidsAdd(hirKids, valHirId)
        }
        return this.hir.add("HirReturn", "", "", sp, hirKids)
    }

    /// 降级 if 语句。
    ///
    /// AST 形状：`If(cond, thenBranch[, elseBranch])`。
    /// 条件可为任意表达式 kind（Binary/Call/Ident…），必须无条件降级（此前按
    /// `Expr/Block/If` 过滤，导致条件被丢弃）。
    fun lowerIfStmt(ast: Ast, id: Int): Int {
        val sp: Span = ast.spanOf(id)
        val kids: String = ast.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        var hirKids: String = HirUtils.hirNoKids()

        // 条件
        if (kCount >= 1) {
            val condHirId: Int = this.lowerExpr(ast, HirUtils.hirKidsAt(kids, 0))
            if (condHirId >= 0) {
                hirKids = HirUtils.hirKidsAdd(hirKids, condHirId)
            }
        }
        // then 分支（可能是块 / 单条语句 / 表达式）
        if (kCount >= 2) {
            val thenHirId: Int = this.lowerBranch(ast, HirUtils.hirKidsAt(kids, 1))
            if (thenHirId >= 0) {
                hirKids = HirUtils.hirKidsAdd(hirKids, thenHirId)
            }
        }
        // else 分支（可选）
        if (kCount >= 3) {
            val elseHirId: Int = this.lowerBranch(ast, HirUtils.hirKidsAt(kids, 2))
            if (elseHirId >= 0) {
                hirKids = HirUtils.hirKidsAdd(hirKids, elseHirId)
            }
        }

        return this.hir.add("HirIf", "", "", sp, hirKids)
    }

    /// 降级 while 循环。
    fun lowerWhile(ast: Ast, id: Int): Int {
        val sp: Span = ast.spanOf(id)
        val kids: String = ast.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        var hirKids: String = HirUtils.hirNoKids()
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            val childHirId: Int = this.lowerBlockOrExpr(ast, childId)
            if (childHirId >= 0) {
                hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
            }
            i = i + 1
        }
        return this.hir.add("HirWhile", "", "", sp, hirKids)
    }

    /// 降级 for 循环。
    fun lowerFor(ast: Ast, id: Int): Int {
        val sp: Span = ast.spanOf(id)
        val kids: String = ast.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        var hirKids: String = HirUtils.hirNoKids()
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            val childKind: String = ast.kindOf(childId)
            if (childKind == "ValDecl" || childKind == "VarDecl") {
                val childHirId: Int = this.lowerStmt(ast, childId)
                if (childHirId >= 0) {
                    hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
                }
            } else {
                val childHirId: Int = this.lowerBlockOrExpr(ast, childId)
                if (childHirId >= 0) {
                    hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
                }
            }
            i = i + 1
        }
        return this.hir.add("HirFor", "", "", sp, hirKids)
    }

    /// 降级 C 风格 for：`for (init; cond; incr) body`
    /// → `{ init; while (cond) { body; incr } }`（与 Rust 侧 `desugar_cfor` 同形）。
    ///
    /// AST kids 固定为 `[init, cond, incr, body]`（Parser.parseFor 的 C 分支
    /// 用 BoolLiteral/Block 占位补齐可选部分）。
    fun lowerCFor(ast: Ast, id: Int): Int {
        val sp: Span = ast.spanOf(id)
        val kids: String = ast.kidsOf(id)
        if (HirUtils.hirKidsCount(kids) < 4) {
            return this.hir.add("HirBlock", "", "", sp, HirUtils.hirNoKids())
        }
        val initId: Int = HirUtils.hirKidsAt(kids, 0)
        val condId: Int = HirUtils.hirKidsAt(kids, 1)
        val incrId: Int = HirUtils.hirKidsAt(kids, 2)
        val bodyId: Int = HirUtils.hirKidsAt(kids, 3)

        var blockKids: String = HirUtils.hirNoKids()
        val initHir: Int = this.lowerStmt(ast, initId)
        if (initHir >= 0) {
            blockKids = HirUtils.hirKidsAdd(blockKids, initHir)
        }

        // while 体 = body + incr（步进在每次迭代末尾执行）
        var whileKids: String = HirUtils.hirNoKids()
        val bodyHir: Int = this.lowerBlockOrExpr(ast, bodyId)
        if (bodyHir >= 0) {
            whileKids = HirUtils.hirKidsAdd(whileKids, bodyHir)
        }
        // 步进多为赋值/复合赋值语句（Parser 已用 parseStatement 产出
        // Assign / ExprStmt 节点），故按语句降级
        val incrHir: Int = this.lowerStmt(ast, incrId)
        if (incrHir >= 0 && ast.kindOf(incrId) != "Block") {
            whileKids = HirUtils.hirKidsAdd(whileKids, incrHir)
        }
        val whileBody: Int = this.hir.add("HirBlock", "", "", sp, whileKids)

        var wKids: String = HirUtils.hirNoKids()
        val condHir: Int = this.lowerExpr(ast, condId)
        if (condHir >= 0) {
            wKids = HirUtils.hirKidsAdd(wKids, condHir)
        }
        wKids = HirUtils.hirKidsAdd(wKids, whileBody)
        val whileHir: Int = this.hir.add("HirWhile", "", "", sp, wKids)
        blockKids = HirUtils.hirKidsAdd(blockKids, whileHir)
        return this.hir.add("HirBlock", "", "", sp, blockKids)
    }

    /// 降级赋值语句。
    /// array[i] = v → array = Collections.set(array, i, v)
    /// （Value::List 不可变，set 返回新列表，需回赋到目标变量）
    fun lowerAssign(ast: Ast, id: Int): Int {
        val sp: Span = ast.spanOf(id)
        val kids: String = ast.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        if (kCount >= 2) {
            val targetId: Int = HirUtils.hirKidsAt(kids, 0)
            val valueId: Int = HirUtils.hirKidsAt(kids, 1)
            val targetKind: String = ast.kindOf(targetId)

            // 下标赋值：array[i] = v → array = Collections.set(array, i, v)
            if (targetKind == "Index") {
                val idxKids: String = ast.kidsOf(targetId)
                val idxKCount: Int = HirUtils.hirKidsCount(idxKids)
                if (idxKCount >= 2) {
                    val containerId: Int = HirUtils.hirKidsAt(idxKids, 0)
                    val indexId: Int = HirUtils.hirKidsAt(idxKids, 1)
                    val containerKind: String = ast.kindOf(containerId)

                    var hirKids: String = HirUtils.hirNoKids()

                    // set(array, i, v) 调用
                    var callKids: String = HirUtils.hirNoKids()
                    val containerHirId: Int = this.lowerExpr(ast, containerId)
                    val indexHirId: Int = this.lowerExpr(ast, indexId)
                    val valueHirId: Int = this.lowerExpr(ast, valueId)
                    if (containerHirId >= 0) {
                        callKids = HirUtils.hirKidsAdd(callKids, containerHirId)
                    }
                    if (indexHirId >= 0) {
                        callKids = HirUtils.hirKidsAdd(callKids, indexHirId)
                    }
                    if (valueHirId >= 0) {
                        callKids = HirUtils.hirKidsAdd(callKids, valueHirId)
                    }
                    val setCallId: Int = this.hir.add("HirCall", "Collections.set", "", sp, callKids)

                    // 如果目标是变量，回赋到该变量
                    if (containerKind == "Ident") {
                        // 生成 assign: container = setCall
                        val containerHir: Int = this.lowerExpr(ast, containerId)
                        if (containerHir >= 0 && setCallId >= 0) {
                            val assignKids: String = HirUtils.hirKidsAdd(HirUtils.hirNoKids(), containerHir)
                            val assignKids2: String = HirUtils.hirKidsAdd(assignKids, setCallId)
                            return this.hir.add("HirAssign", "", "", sp, assignKids2)
                        }
                    }

                    // 非变量目标：仅生成 set 调用
                    return setCallId
                }
            }

            // 普通赋值：target = value
            // 把目标变量名写入 HirAssign.text（MIR 需要据此分配 STORE_VAR 槽位）
            var targetName: String = ""
            if (targetKind == "Ident" || targetKind == "This" || targetKind == "Super") {
                targetName = ast.textOf(targetId)
            }
            var hirKids: String = HirUtils.hirNoKids()
            var i: Int = 0
            while (i < kCount) {
                val childId: Int = HirUtils.hirKidsAt(kids, i)
                val childHirId: Int = this.lowerExpr(ast, childId)
                if (childHirId >= 0) {
                    hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
                }
                i = i + 1
            }
            return this.hir.add("HirAssign", targetName, "", sp, hirKids)
        }
        return -1
    }

    /// 降级 `throw expr` → `HirCall("__throw", [expr])`。
    ///
    /// 与 Rust 侧 `desugar_expr(Expr::Throw)` 的 HIR 形状一致（callee `__throw`）。
    /// Aura 侧 AOT 无异常机制，发射器对未解析符号不发调用 —— 语义上等价于
    /// 「不求值」的空操作，但**解析不再中断**（vm/*.aura 里大量 `throw Runtime(…)`）。
    fun lowerThrow(ast: Ast, id: Int): Int {
        val sp: Span = ast.spanOf(id)
        val kids: String = ast.kidsOf(id)
        var hkids: String = HirUtils.hirNoKids()
        if (HirUtils.hirKidsCount(kids) > 0) {
            val v: Int = this.lowerExpr(ast, HirUtils.hirKidsAt(kids, 0))
            if (v >= 0) {
                hkids = HirUtils.hirKidsAdd(hkids, v)
            }
        }
        return this.hir.add("HirCall", "__throw", "", sp, hkids)
    }

    /// 降级表达式语句。
    fun lowerExprStmt(ast: Ast, id: Int): Int {
        val kids: String = ast.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)
        if (kCount > 0) {
            val exprId: Int = HirUtils.hirKidsAt(kids, 0)
            return this.lowerExpr(ast, exprId)
        }
        return -1
    }

    // ── 表达式降级 ──

    /// 降级表达式。
    fun lowerExpr(ast: Ast, id: Int): Int {
        val kind: String = ast.kindOf(id)
        val text: String = ast.textOf(id)
        val sp: Span = ast.spanOf(id)
        val kids: String = ast.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        // 字面量（携带类型信息，供 AOT 发射器选择表示；Phase 6.5.5/6.5.7）
        if (kind == "IntLiteral") {
            return this.hir.add("HirLit", text, "Int", sp, HirUtils.hirNoKids())
        } else if (kind == "FloatLiteral" || kind == "DoubleLiteral") {
            return this.hir.add("HirLit", text, "Double", sp, HirUtils.hirNoKids())
        } else if (kind == "StringLiteral") {
            return this.hir.add("HirLit", text, "String", sp, HirUtils.hirNoKids())
        } else if (kind == "BoolLiteral") {
            return this.hir.add("HirLit", text, "Boolean", sp, HirUtils.hirNoKids())
        } else if (kind == "CharLiteral") {
            return this.hir.add("HirLit", text, "Char", sp, HirUtils.hirNoKids())
        } else if (kind == "NullLiteral") {
            return this.hir.add("HirLit", "null", "Any", sp, HirUtils.hirNoKids())
        }

        // 标识符
        if (kind == "Ident") {
            return this.hir.leaf("HirVar", text, sp)
        } else if (kind == "This") {
            return this.hir.leaf("HirVar", "this", sp)
        } else if (kind == "Super") {
            return this.hir.leaf("HirVar", "super", sp)
        }

        // 区间 `a..b` / `a..<b` → `__range(a, b, inclusive)`
        // （与 Rust 侧 `desugar_expr(Expr::Range)` 的 HIR 形状一致；AOT 发射器
        //  按 `__range` 生成 `aura_lang_std_Collections_range` 调用。）
        if (kind == "Range") {
            val rangeSp: Span = ast.spanOf(id)
            val rangeKids: String = ast.kidsOf(id)
            var incText: String = "1"
            if (ast.textOf(id) == "0") {
                incText = "0"
            }
            var callKids: String = HirUtils.hirNoKids()
            var ri: Int = 0
            while (ri < HirUtils.hirKidsCount(rangeKids)) {
                val cid: Int = HirUtils.hirKidsAt(rangeKids, ri)
                val cHir: Int = this.lowerExpr(ast, cid)
                if (cHir >= 0) {
                    callKids = HirUtils.hirKidsAdd(callKids, cHir)
                }
                ri = ri + 1
            }
            val incNode: Int = this.hir.add("HirLit", incText, "Int", rangeSp, HirUtils.hirNoKids())
            callKids = HirUtils.hirKidsAdd(callKids, incNode)
            return this.hir.add("HirCall", "__range", "", rangeSp, callKids)
        }

        // 非空断言 `expr!!`（`Unwrap`）：HIR 层直接穿透（可空值在 AOT 下
        // 以值本身表示，`!!` 等价于原值，仅作类型收窄），
        // 但必须存在分支——否则落到「未知 AST 种类」返回 -1，
        // 整个表达式被静默丢弃并可能触发编译器崩溃。
        if (kind == "Unwrap") {
            val ukids: String = ast.kidsOf(id)
            if (HirUtils.hirKidsCount(ukids) > 0) {
                return this.lowerExpr(ast, HirUtils.hirKidsAt(ukids, 0))
            }
            return -1
        }

        // 命名实参 `f(name = v)` → `HirNamedArg(name, [value])`
        if (kind == "NamedArg") {
            val naSp: Span = ast.spanOf(id)
            val naKids: String = ast.kidsOf(id)
            var naHir: String = HirUtils.hirNoKids()
            if (HirUtils.hirKidsCount(naKids) > 0) {
                val v: Int = this.lowerExpr(ast, HirUtils.hirKidsAt(naKids, 0))
                if (v >= 0) {
                    naHir = HirUtils.hirKidsAdd(naHir, v)
                }
            }
            return this.hir.add("HirNamedArg", ast.textOf(id), "", naSp, naHir)
        }

        // 二元运算
        if (kind == "Binary") {
            return this.lowerBinary(ast, id)
        }

        // 一元运算
        if (kind == "Unary") {
            return this.lowerUnary(ast, id)
        }

        // 函数调用
        if (kind == "Call") {
            return this.lowerCall(ast, id)
        }

        // 成员访问
        if (kind == "Member") {
            return this.lowerMember(ast, id)
        }

        // 下标访问
        if (kind == "Index") {
            return this.lowerIndex(ast, id)
        }

        // if 表达式
        if (kind == "If") {
            return this.lowerIfExpr(ast, id)
        }

        // 块表达式
        if (kind == "Block") {
            return this.lowerBlock(ast, id)
        }

        // when 表达式 → HirWhen（保留结构供 Desugar 降级为嵌套 If）
        if (kind == "When") {
            return this.lowerWhen(ast, id)
        }

        // C 风格 for 出现在表达式位置时同样降级为 `{ init; while … }` 块
        if (kind == "CFor") {
            return this.lowerCFor(ast, id)
        }

        // throw 出现在表达式位置（`if (c) throw X()`）
        if (kind == "Throw") {
            return this.lowerThrow(ast, id)
        }

        // lambda / closure → HirLambda
        if (kind == "Lambda" || kind == "Closure") {
            return this.lowerLambda(ast, id)
        }

        // 其他类型
        return this.hir.leaf("HirExpr", kind + ": " + text, sp)
    }

    /// 降级二元运算表达式。
    fun lowerBinary(ast: Ast, id: Int): Int {
        val op: String = ast.textOf(id)
        val sp: Span = ast.spanOf(id)
        val kids: String = ast.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        // 中缀 `a to b` → Pair 构造 `Collections.pairOf(a, b)`
        // （AOT 下是 2 元素 `AuraDynList`，`val (x, y) = p` 经 getAt(0/1) 解构）
        if (op == "to") {
            var toKids: String = HirUtils.hirNoKids()
            var ti: Int = 0
            while (ti < kCount) {
                val th: Int = this.lowerExpr(ast, HirUtils.hirKidsAt(kids, ti))
                if (th >= 0) {
                    toKids = HirUtils.hirKidsAdd(toKids, th)
                }
                ti = ti + 1
            }
            return this.hir.add("HirCall", "Collections.pairOf", "", sp, toKids)
        }

        var hirKids: String = HirUtils.hirNoKids()
        var opTy: String = ""
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            val childHirId: Int = this.lowerExpr(ast, childId)
            if (childHirId >= 0) {
                hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
                if (this.hir.tyOf(childHirId) == "String") {
                    opTy = "String"
                }
            }
            i = i + 1
        }
        val normOp: String = HirUtils.hirNormBinOp(op)
        if (normOp != "+" && normOp != "&&" && normOp != "||" &&
            normOp != "==" && normOp != "!=" && normOp != "<" &&
            normOp != ">" && normOp != "<=" && normOp != ">=") {
            opTy = ""
        }
        return this.hir.add("HirBinary", normOp, opTy, sp, hirKids)
    }

    /// 降级一元运算表达式。
    fun lowerUnary(ast: Ast, id: Int): Int {
        val op: String = ast.textOf(id)
        val sp: Span = ast.spanOf(id)
        val kids: String = ast.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        var hirKids: String = HirUtils.hirNoKids()
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            val childHirId: Int = this.lowerExpr(ast, childId)
            if (childHirId >= 0) {
                hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
            }
            i = i + 1
        }
        return this.hir.add("HirUnary", HirUtils.hirNormUnOp(op), "", sp, hirKids)
    }

    /// 降级函数调用表达式。
    fun lowerCall(ast: Ast, id: Int): Int {
        val sp: Span = ast.spanOf(id)
        val kids: String = ast.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        // List/Array/Set.get(i) / getAt(i) → Collections.getAt(collection, i)
        if (kCount >= 2) {
            val calleeId: Int = HirUtils.hirKidsAt(kids, 0)
            if (ast.kindOf(calleeId) == "Member") {
                val memberName: String = ast.textOf(calleeId)
                if (memberName == "get" || memberName == "getAt") {
                    val calleeKids: String = ast.kidsOf(calleeId)
                    val calleeKCount: Int = HirUtils.hirKidsCount(calleeKids)
                    if (calleeKCount >= 1) {
                        var hirKids: String = HirUtils.hirNoKids()
                        // **接收者必须作为 kids[0]**（发射器约定：接收者在 kids[0]）。
                        // 旧实现从 i=0 起遍历**全部** kids，把 callee 成员节点
                        // （`get` 本身）也降级进去 → kids[0] 变成一次成员访问
                        // （推断 i32），真正接收者被埋在其 kids 里。后果：
                        //   * `HashMap.get("k")` 被当集合下标 → 发射器走
                        //     `aura_lang_std_Collections_getAt(null, idx)`（语义错，
                        //     读不到值、恒为空）；
                        //   * `xs.get(i)`（合法集合取元素）实参整体错位。
                        // 正确形状：`Collections.getAt(recv, i)`。
                        val getRecvHir: Int = this.lowerExpr(ast, HirUtils.hirKidsAt(calleeKids, 0))
                        if (getRecvHir >= 0) {
                            hirKids = HirUtils.hirKidsAdd(hirKids, getRecvHir)
                        }
                        var i: Int = 1
                        while (i < kCount) {
                            val childId: Int = HirUtils.hirKidsAt(kids, i)
                            val childHirId: Int = this.lowerExpr(ast, childId)
                            if (childHirId >= 0) {
                                hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
                            }
                            i = i + 1
                        }
                        return this.hir.add("HirCall", "Collections.getAt", "", sp, hirKids)
                    }
                }
                // set(i, v) → Collections.set(collection, i, v)
                if (memberName == "set") {
                    val calleeKids: String = ast.kidsOf(calleeId)
                    val calleeKCount: Int = HirUtils.hirKidsCount(calleeKids)
                    if (calleeKCount >= 1) {
                        var hirKids: String = HirUtils.hirNoKids()
                        // 同 `get`：接收者作 kids[0]，其余实参从 kids[1] 起
                        //（旧实现从 0 起 → 接收者丢失、实参错位）。
                        val setRecvHir: Int = this.lowerExpr(ast, HirUtils.hirKidsAt(calleeKids, 0))
                        if (setRecvHir >= 0) {
                            hirKids = HirUtils.hirKidsAdd(hirKids, setRecvHir)
                        }
                        var i: Int = 1
                        while (i < kCount) {
                            val childId: Int = HirUtils.hirKidsAt(kids, i)
                            val childHirId: Int = this.lowerExpr(ast, childId)
                            if (childHirId >= 0) {
                                hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
                            }
                            i = i + 1
                        }
                        return this.hir.add("HirCall", "Collections.set", "", sp, hirKids)
                    }
                }
                // contains(item) / indexOf(item) → Collections.<m>(collection, item)
                //
                // 接收者必须作为 kids[0]：与发射器「接收者在 kids[0]」的约定一致
                // （`set` 分支已如此）。旧实现把 callee 成员节点整个降级成 kids[0]，
                // 接收者被埋在其 kids 里，实参整体错位 —— 字符串 `indexOf` 因此
                // 走列表实现恒返回 -1。
                //
                // Phase E: 修复 —— 仅当接收者类型不是 String 时才应用此转换。
                // String.indexOf(sub) 应保留为方法调用，由 AOT 后端解析到
                // aura_lang_std_String_indexOf。
                if (memberName == "contains" || memberName == "indexOf") {
                    val calleeKids: String = ast.kidsOf(calleeId)
                    if (HirUtils.hirKidsCount(calleeKids) >= 1) {
                        val recvId: Int = HirUtils.hirKidsAt(calleeKids, 0)
                        val recvTy: String = ast.tyOf(recvId)
                        // 仅当接收者不是 String 时才转换为 Collections 调用
                        if (recvTy != "String") {
                            var hirKids: String = HirUtils.hirNoKids()
                            val recvHirId: Int = this.lowerExpr(ast, recvId)
                            if (recvHirId >= 0) {
                                hirKids = HirUtils.hirKidsAdd(hirKids, recvHirId)
                            }
                            var i: Int = 1
                            while (i < kCount) {
                                val childHirId: Int = this.lowerExpr(ast, HirUtils.hirKidsAt(kids, i))
                                if (childHirId >= 0) {
                                    hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
                                }
                                i = i + 1
                            }
                            var qname: String = "Collections.contains"
                            if (memberName == "indexOf") {
                                qname = "Collections.indexOf"
                            }
                            return this.hir.add("HirCall", qname, "", sp, hirKids)
                        }
                        // 接收者是 String：跳过 Collections 转换，走普通方法调用路径
                    }
                }
            }
        }

        // 普通调用：kids[0] 是 callee（Ident/This/Super/Member），其余为实参。
        // 提取被调用函数名写入 HirCall.text（此前留空，导致 MIR/Codegen 丢失函数名）。
        var calleeName: String = ""
        var argStart: Int = 0
        var hirKids: String = HirUtils.hirNoKids()
        if (kCount > 0) {
            val calleeId: Int = HirUtils.hirKidsAt(kids, 0)
            val calleeKind: String = ast.kindOf(calleeId)
            if (calleeKind == "Ident" || calleeKind == "This" || calleeKind == "Super") {
                calleeName = ast.textOf(calleeId)
                argStart = 1
            } else if (calleeKind == "Member") {
                // 方法调用 `obj.method(args)`：名字取成员名，**接收者对象**作为首个实参。
                // 必须降级「成员节点的接收者子节点」本身，而不是成员节点：若降级成员节点，
                // kids[0] 会变成一次成员访问（求值得到 0/null），方法调用丢失接收者，
                // 生成 `toString(i32 0)` 这类错误 IR。
                calleeName = ast.textOf(calleeId)
                val mKids: String = ast.kidsOf(calleeId)
                if (HirUtils.hirKidsCount(mKids) > 0) {
                    val recvHir: Int = this.lowerExpr(ast, HirUtils.hirKidsAt(mKids, 0))
                    if (recvHir >= 0) {
                        hirKids = HirUtils.hirKidsAdd(hirKids, recvHir)
                    }
                }
                argStart = 1
            } else {
                argStart = 0
            }
        }

        var i: Int = argStart
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            val childHirId: Int = this.lowerExpr(ast, childId)
            if (childHirId >= 0) {
                hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
            }
            i = i + 1
        }
        return this.hir.add("HirCall", calleeName, "", sp, hirKids)
    }

    /// 降级成员访问表达式。
    fun lowerMember(ast: Ast, id: Int): Int {
        val memberName: String = ast.textOf(id)
        val sp: Span = ast.spanOf(id)
        val kids: String = ast.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        var hirKids: String = HirUtils.hirNoKids()
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            val childHirId: Int = this.lowerExpr(ast, childId)
            if (childHirId >= 0) {
                hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
            }
            i = i + 1
        }
        var mty: String = ""
        if (memberName == "length" || memberName == "size") {
            mty = "Int"
        }
        return this.hir.add("HirMember", memberName, mty, sp, hirKids)
    }

    /// 降级下标访问表达式。
    fun lowerIndex(ast: Ast, id: Int): Int {
        val sp: Span = ast.spanOf(id)
        val kids: String = ast.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        var hirKids: String = HirUtils.hirNoKids()
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            val childHirId: Int = this.lowerExpr(ast, childId)
            if (childHirId >= 0) {
                hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
            }
            i = i + 1
        }
        return this.hir.add("HirIndex", "", "", sp, hirKids)
    }

    /// 降级 if 表达式。
    fun lowerIfExpr(ast: Ast, id: Int): Int {
        val sp: Span = ast.spanOf(id)
        val kids: String = ast.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        var hirKids: String = HirUtils.hirNoKids()
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            // 条件按表达式、分支按「块/单条语句/表达式」降级
            var childHirId: Int = -1
            if (i == 0) {
                childHirId = this.lowerExpr(ast, childId)
            } else {
                childHirId = this.lowerBranch(ast, childId)
            }
            if (childHirId >= 0) {
                hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
            }
            i = i + 1
        }
        return this.hir.add("HirIfExpr", "", "", sp, hirKids)
    }

    /// 降级 when 表达式（Phase B.1 / C.4）。
    ///
    /// AST 形状：`When([subject], WhenArms([WhenArm(pattern, body)...])])`
    /// HIR 形状：**直接降级为嵌套 `HirIfExpr`**。
    ///
    /// 为什么不再保留 `HirWhen`：Aura 侧 AOT 发射器（Emit.aura）只实现到
    /// `HirIfExpr`，不处理 `HirWhen` —— 保留结构会让整个 when 表达式**静默
    /// 求值为 0**（实测 `when (x) { 1 -> 10 … }` 恒得 0，自举时 when 语义全错）。
    /// 降级算法与 Rust 后端 `desugar_when`（`compiler/src/codegen/hir.rs`）
    /// 保持一致：**从后往前**构造 else 链（最后一个 arm 成为最内层 else，
    /// 源码中第一个 arm 在最外层），`else ->` 分支条件恒为 `true`。
    fun lowerWhen(ast: Ast, id: Int): Int {
        val sp: Span = ast.spanOf(id)
        val kids: String = ast.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        // 可选 subject（非 WhenArms 的子节点）
        var subjectHir: Int = -1
        var armsId: Int = -1
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            if (ast.kindOf(childId) == "WhenArms") {
                armsId = childId
            } else if (subjectHir < 0) {
                subjectHir = this.lowerExpr(ast, childId)
            }
            i = i + 1
        }
        if (armsId < 0) {
            return this.hir.add("HirLit", "0", "Int", sp, HirUtils.hirNoKids())
        }

        val armsKids: String = ast.kidsOf(armsId)
        val armCount: Int = HirUtils.hirKidsCount(armsKids)

        var result: Int = -1
        var j: Int = armCount - 1
        while (j >= 0) {
            val armId: Int = HirUtils.hirKidsAt(armsKids, j)
            j = j - 1
            val armKids: String = ast.kidsOf(armId)
            if (HirUtils.hirKidsCount(armKids) < 2) {
                continue
            }
            val patId: Int = HirUtils.hirKidsAt(armKids, 0)
            val bodyId: Int = HirUtils.hirKidsAt(armKids, 1)

            // 条件：`else ->` 恒真；有 subject → `subject == pattern`；
            // 无 subject → pattern 本身作为布尔条件
            var condHir: Int = -1
            val patText: String = ast.textOf(patId)
            if (patText == "__else__" || patText == "else") {
                condHir = this.hir.add("HirLit", "true", "Boolean", sp, HirUtils.hirNoKids())
            } else if (patText.startsWith("__is__")) {
                // `is T` 模式 → `aura_isOfType(subject, "T")`（不能走 `subject == pattern`：
                // 那会把模式标识符 `__is__T` 当变量比较，且 `aura_isOfType` 才是类型检查语义）
                if (subjectHir >= 0) {
                    val tname: String = patText.substring(6, patText.length)
                    var ik: String = HirUtils.hirKidsAdd(HirUtils.hirNoKids(), subjectHir)
                    val tl: Int = this.hir.add("HirLit", tname, "String", sp, HirUtils.hirNoKids())
                    ik = HirUtils.hirKidsAdd(ik, tl)
                    condHir = this.hir.add("HirCall", "aura_isOfType", "", ast.spanOf(armId), ik)
                }
            } else if (ast.kindOf(patId) == "InPattern") {
                // `in a..b` 范围模式 → `subject >= a && subject <= b`
                // （`a..<b` → `subject < b`）。分解区间上下界、复用既有比较/逻辑
                // 发射路径，避免为「区间成员测试」新增运行库/发射器分支。
                if (subjectHir >= 0) {
                    val pk: String = ast.kidsOf(patId)
                    if (HirUtils.hirKidsCount(pk) > 0) {
                        val rngAst: Int = HirUtils.hirKidsAt(pk, 0)
                        val rk: String = ast.kidsOf(rngAst)
                        if (HirUtils.hirKidsCount(rk) >= 2) {
                            val loHir: Int = this.lowerExpr(ast, HirUtils.hirKidsAt(rk, 0))
                            val hiHir: Int = this.lowerExpr(ast, HirUtils.hirKidsAt(rk, 1))
                            if (loHir >= 0 && hiHir >= 0) {
                                val kLo: String = HirUtils.hirKidsAdd(HirUtils.hirKidsAdd(HirUtils.hirNoKids(), subjectHir), loHir)
                                val geNode: Int = this.hir.add("HirBinary", ">=",
                                    "", ast.spanOf(armId), kLo)
                                var hiOp: String = "<="
                                if (ast.textOf(rngAst) == "0") {
                                    hiOp = "<"
                                }
                                val kHi: String = HirUtils.hirKidsAdd(HirUtils.hirKidsAdd(HirUtils.hirNoKids(), subjectHir), hiHir)
                                val leNode: Int = this.hir.add("HirBinary", hiOp,
                                    "", ast.spanOf(armId), kHi)
                                val kBoth: String = HirUtils.hirKidsAdd(HirUtils.hirKidsAdd(HirUtils.hirNoKids(), geNode), leNode)
                                condHir = this.hir.add("HirBinary", "&&",
                                    "", ast.spanOf(armId), kBoth)
                            }
                        }
                    }
                }
            } else {
                val patHir: Int = this.lowerExpr(ast, patId)
                if (patHir >= 0) {
                    if (subjectHir >= 0) {
                        var ck: String = HirUtils.hirNoKids()
                        ck = HirUtils.hirKidsAdd(ck, subjectHir)
                        ck = HirUtils.hirKidsAdd(ck, patHir)
                        condHir = this.hir.add("HirBinary", "==", "", ast.spanOf(armId), ck)
                    } else {
                        condHir = patHir
                    }
                }
            }
            if (condHir < 0) {
                continue
            }
            val bodyHir: Int = this.lowerBlockOrExpr(ast, bodyId)
            if (bodyHir < 0) {
                continue
            }

            var ifKids: String = HirUtils.hirNoKids()
            ifKids = HirUtils.hirKidsAdd(ifKids, condHir)
            ifKids = HirUtils.hirKidsAdd(ifKids, bodyHir)
            if (result >= 0) {
                ifKids = HirUtils.hirKidsAdd(ifKids, result)
            }
            result = this.hir.add("HirIfExpr", "", "", sp, ifKids)
        }

        if (result >= 0) {
            return result
        }
        return this.hir.add("HirLit", "0", "Int", sp, HirUtils.hirNoKids())
    }

    /// 降级 try/catch/finally（Phase B.4）。
    ///
    /// AST 形状：`Try(catchVar, [body, catchBlock, finallyBlock])`
    /// HIR 形状：`HirTry(catchVar, [body, catchBlock, finallyBlock])`
    ///
    /// 三段**恒存在**（Parser.parseTry 对缺失的 catch/finally 补空 Block 占位），
    /// 否则 `try {} finally {}` 与 `try {} catch {}` 无法区分。
    fun lowerTry(ast: Ast, id: Int): Int {
        val sp: Span = ast.spanOf(id)
        val catchVar: String = ast.textOf(id)
        val kids: String = ast.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        var hirKids: String = HirUtils.hirNoKids()
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = HirUtils.hirKidsAt(kids, i)
            val childHirId: Int = this.lowerBlockOrExpr(ast, childId)
            if (childHirId >= 0) {
                hirKids = HirUtils.hirKidsAdd(hirKids, childHirId)
            }
            i = i + 1
        }
        return this.hir.add("HirTry", catchVar, "", sp, hirKids)
    }

    /// 降级 lambda / closure（Phase B.2）。
    ///
    /// AST 形状：`Lambda/Closure([params], body)`
    /// HIR 形状：`HirLambda([HirParam...], body)`
    fun lowerLambda(ast: Ast, id: Int): Int {
        val sp: Span = ast.spanOf(id)
        val kids: String = ast.kidsOf(id)
        val kCount: Int = HirUtils.hirKidsCount(kids)

        var hirKids: String = HirUtils.hirNoKids()
        var paramsStr: String = HirUtils.hirNoKids()

        // 子节点 0：参数列表
        if (kCount >= 1) {
            val paramsNodeId: Int = HirUtils.hirKidsAt(kids, 0)
            val paramsKids: String = ast.kidsOf(paramsNodeId)
            val pkCount: Int = HirUtils.hirKidsCount(paramsKids)
            var pi: Int = 0
            while (pi < pkCount) {
                val pId: Int = HirUtils.hirKidsAt(paramsKids, pi)
                val pName: String = ast.textOf(pId)
                val pTy: String = ast.tyOf(pId)
                val pSp: Span = ast.spanOf(pId)
                // 默认参数值：作为 HirParam 的 kids[0]，供调用点补齐实参
                var pKids: String = HirUtils.hirNoKids()
                val pAstKids: String = ast.kidsOf(pId)
                if (HirUtils.hirKidsCount(pAstKids) > 0) {
                    val dId: Int = this.lowerExpr(ast, HirUtils.hirKidsAt(pAstKids, 0))
                    if (dId >= 0) {
                        pKids = HirUtils.hirKidsAdd(pKids, dId)
                    }
                }
                val paramId: Int = this.hir.add("HirParam", pName, pTy, pSp, pKids)
                paramsStr = HirUtils.hirKidsAdd(paramsStr, paramId)
                pi = pi + 1
            }
        }
        // 注意：`paramsStr` 是**子节点 id 列表**（逗号分隔串），必须用
        // `hirKidsConcat` 拼接。旧实现误用 `hirKidsAdd`（形参是 Int）——
        // Rust 侧把 String 实参强转成 Int（取指针低 32 位），在自举产物里
        // 直接变成垃圾 id（`HirLambda kids=-919700240,3`），lambda 形参因此全部丢失。
        hirKids = HirUtils.hirKidsConcat(hirKids, paramsStr)

        // 子节点 1：body
        if (kCount >= 2) {
            val bodyAstId: Int = HirUtils.hirKidsAt(kids, 1)
            val bodyHirId: Int = this.lowerBlockOrExpr(ast, bodyAstId)
            if (bodyHirId >= 0) {
                hirKids = HirUtils.hirKidsAdd(hirKids, bodyHirId)
            }
        }

        return this.hir.add("HirLambda", "", "", sp, hirKids)
    }
}



