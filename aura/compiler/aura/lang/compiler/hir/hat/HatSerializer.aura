// aura:///aura/lang/compiler/hir/hat/HatSerializer.aura
package aura.lang.compiler.hir.hat
// ─────────────────────────────────────────────────────────────
// HAT v2.0 序列化器 — SSA MIR → HAT 文本
//
// 将 SSA MIR 程序序列化为 HAT 格式文本。
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String
import aura.lang.collection.ArrayList
import "../../mir/SsaMir.aura"
import "../../mir/TypeRegistry.aura"

/// HAT 序列化器：将 SSA MIR 程序序列化为 HAT 文本。
class HatSerializer {

    /// 模块名。
    private var moduleName: String = "main"

    /// 目标三元组。
    private var targetTriple: String = "x86_64-pc-windows-msvc"

    /// 输出缓冲（**分块列表**）。
    ///
    /// ⚠️ **不能用 `output: String` + `output = output + x`**：Aura 的 String
    /// 不可变，每次追加都要整段拷贝。N 次追加就是 O(N²) 字节分配，而 AOT/原生
    /// 运行时**没有 GC**（malloc 即泄漏）。实测自举 `Main.aura`：开启 `object`
    /// 方法下钻后函数数从 18 涨到 375+，序列化阶段在 4.4 s 内分配到 **8 GB**
    /// 被内存闸门杀掉；同一路径此前（18 个函数）恰好只有 ≈9 KB 输出，所以从未暴露。
    ///
    /// 这里改为「每段追加只入列表，最后两两归并成整串」（[`joinChunks`]）：
    /// 每段按引用存入列表（无拷贝），归并层数 O(log N)、每层总拷贝 O(总长)
    /// ⇒ 总分配 O(总长 · log N)，彻底消除平方级拷贝。
    ///
    /// 为什么不用 `EmitBuffer`（原生 StringBuilder）：它经 `CString(s)` → VM 的
    /// `native_builtin_cstring` 取得 C 字符串指针，而该指针缓存**以「字符串数据
    /// 地址」为键** —— 地址在 `Rc<str>` 释放后会被复用，于是后续追加会读到
    /// **上一个同地址字符串**的陈旧内容，串出乱序/重复的文本（实测
    /// `tests/hat_serializer_tests.aura` 由 30/30 变成 26/30）。分块列表不依赖
    /// 该 ABI，VM / AOT / Photon 三条路径行为一致。
    private var chunks: List<String> = arrayListOf<String>()

    /// 最近一次 `serialize()` 的产物（供 `getOutput()` 读取）。
    private var lastOutput: String = ""

    /// 类型注册表。
    private var types: TypeRegistry = TypeRegistry()

    /// 当前函数的入口块 BlockID（入口块的 HAT 标签固定为 `entry`）。
    private var curEntryBlock: Int = -1

    /// 当前函数内已输出定义的常量 ID（换行包裹分隔，用于按需补发常量定义行）。
    private var definedConsts: String = "\n"

    init() {
        this.moduleName = "main"
        this.targetTriple = "x86_64-pc-windows-msvc"
        this.chunks = arrayListOf<String>()
        this.lastOutput = ""
        this.types = TypeRegistry()
        this.curEntryBlock = -1
        this.definedConsts = "\n"
    }

    // ── 输出缓冲 ──

    /// 追加一段文本（O(1)，不做拷贝）。
    private fun w(s: String): Unit {
        this.chunks.add(s)
    }

    /// 把分块列表两两归并成整串（O(总长 · log 块数)）。
    ///
    /// 直接写 `r = r + c` 逐段拼接是 O(总长²)（每次都要拷贝已累积的全部内容）；
    /// 两两归并让每层的拷贝总量恒为 O(总长)，共 O(log 块数) 层。
    private fun joinChunks(items: List<String>): String {
        var cur: List<String> = items
        while (cur.size > 1) {
            val next: List<String> = arrayListOf<String>()
            var i: Int = 0
            while (i < cur.size) {
                if (i + 1 < cur.size) {
                    next.add(cur[i] + cur[i + 1])
                } else {
                    next.add(cur[i])
                }
                i = i + 2
            }
            cur = next
        }
        if (cur.size == 0) {
            return ""
        }
        return cur[0]
    }

    // ── 主入口 ──

    /// 从 SSA MIR 程序序列化为 HAT 文本。
    fun serialize(mir: MirSsaProgram): String {
        this.types = mir.types
        this.chunks = arrayListOf<String>()
        this.lastOutput = ""
        this.blockIndexReady = false

        // 元数据头
        this.w("; module " + this.moduleName + " target " + this.targetTriple + "\n")
        this.w("; schema=HAT/2.0\n")
        this.w("\n")

        // 函数定义
        var fi: Int = 0
        var funcCount: Int = mir.functionCount
        while (fi < funcCount) {
            val func: MirFunction = mir.functionOf(fi)
            this.serializeFunction(mir, func)
            this.w("\n")
            fi = fi + 1
        }

        val text: String = this.joinChunks(this.chunks)
        this.chunks = arrayListOf<String>()
        this.lastOutput = text
        return text
    }

    // ── 函数序列化 ──

    /// 序列化函数定义。
    private fun serializeFunction(mir: MirSsaProgram, func: MirFunction): Unit {
        this.curEntryBlock = func.entryBlock
        this.definedConsts = "\n"
        // 函数签名
        var retTy: String = this.typeName(mir, func.returnType)
        this.w("@fn " + func.name + "(")

        // 参数
        var params: String = func.params
        if (params != "") {
            var pi: Int = 0
            var first: Boolean = true
            var pStart: Int = 0
            var pLen: Int = params.length
            while (pi <= pLen) {
                if (pi == pLen || params.charCodeAt(pi) == 44) {
                    if (pi > pStart) {
                        val paramStr: String = HatParserUtils.safeSubstring(params, pStart, pi).trim()
                        val paramVal: Int = HatSerializerUtils.strToInt(paramStr)
                        if (paramVal >= 0) {
                            val value: MirValue = mir.valueOf(paramVal)
                            if (first) {
                                first = false
                            } else {
                                this.w(", ")
                            }
                            this.w("@" + value.aux + ": " + this.typeName(mir, value.type))
                        }
                    }
                    pStart = pi + 1
                }
                pi = pi + 1
            }
        }

        this.w(") -> " + retTy + "\n")

        // 基本块
        var blocks: String = func.blocks
        if (blocks != "") {
            var bi: Int = 0
            var first: Boolean = true
            var bStart: Int = 0
            var bLen: Int = blocks.length
            while (bi <= bLen) {
                if (bi == bLen || blocks.charCodeAt(bi) == 44) {
                    if (bi > bStart) {
                        val blockStr: String = HatParserUtils.safeSubstring(blocks, bStart, bi).trim()
                        val blockId: Int = HatSerializerUtils.strToInt(blockStr)
                        if (blockId >= 0) {
                            if (first) {
                                first = false
                            } else {
                                this.w("\n")
                            }
                            this.serializeBlock(mir, blockId, blockId == func.entryBlock)
                        }
                    }
                    bStart = bi + 1
                }
                bi = bi + 1
            }
        }
    }

    // ── 基本块序列化 ──

    /// 序列化基本块。
    private fun serializeBlock(mir: MirSsaProgram, blockId: Int, isEntry: Boolean): Unit {
        val block: MirBlock = mir.blockOf(blockId)

        // 块标签：优先使用 MIR 中记录的标签（HAT 解析会保留原始名），否则回退生成
        var label: String = this.blockLabel(mir, blockId)
        if (label == "" && isEntry) {
            label = "entry"
        }
        this.w("  bb " + label + ":\n")

        // Phi 节点
        var phis: String = block.phis
        if (phis != "") {
            var pi: Int = 0
            var pStart: Int = 0
            var pLen: Int = phis.length
            while (pi <= pLen) {
                if (pi == pLen || phis.charCodeAt(pi) == 44) {
                    if (pi > pStart) {
                        val phiStr: String = HatParserUtils.safeSubstring(phis, pStart, pi).trim()
                        val phiId: Int = HatSerializerUtils.strToInt(phiStr)
                        if (phiId >= 0) {
                            this.serializePhi(mir, phiId)
                        }
                    }
                    pStart = pi + 1
                }
                pi = pi + 1
            }
        }

        // 普通指令
        //
        // ⚠️ 不能遍历 `block.instrs`：`SsaBuilder` 走的是 `program.addValue(...)`
        // （只登记值 + `value.block`），**从不写 `MirBlock.instrs`** —— 按
        // `instrs` 遍历会把函数体整段丢掉（实测 `main` 只剩一条 `@ret @t2`，
        // 且 `@t2` 从未定义 ⇒ HAT 解析器报 unresolved value、DAG 空转）。
        // 这里与 `Lowering.lowerFunction` 保持一致：按全局 `values` 顺序、
        // 用 `v.block == blockId` 归块（值 id 顺序即程序顺序）。
        //
        // 归块本身走一次性索引（[`ensureBlockIndex`]）：对每个块全量扫 `values`
        // 是 O(块数 × 值数)，自举规模下会退化到 10^10 量级。
        this.forEachIndex(this.blockValueIndex(mir, blockId), block, mir)

        // 终结指令
        if (block.term >= 0) {
            val term: MirValue = mir.valueOf(block.term)
            this.serializeTerminator(mir, term)
        }
    }

    /// 遍历块索引给出的值 id 列表并序列化（跳过终结指令 / Phi / Param）。
    private fun forEachIndex(vals: String, block: MirBlock, mir: MirSsaProgram): Unit {
        var vi: Int = 0
        var vStart: Int = 0
        var vLen: Int = vals.length
        while (vi <= vLen) {
            if (vi == vLen || vals.charCodeAt(vi) == 44) {
                if (vi > vStart) {
                    val idStr: String = HatParserUtils.safeSubstring(vals, vStart, vi).trim()
                    val vid: Int = HatSerializerUtils.strToInt(idStr)
                    if (vid >= 0 && block.term != vid) {
                        val v: MirValue = mir.valueOf(vid)
                        if (v.op != "Phi" && v.op != "Param") {
                            this.serializeInstr(mir, vid)
                        }
                    }
                }
                vStart = vi + 1
            }
            vi = vi + 1
        }
    }


    /// 取「本块内普通值的 id 列表」（逗号分隔）。
    ///
    /// 旧实现在 `serializeBlock` 里对**每个块**都全量扫 `mir.valueCount` 个值，
    /// 总代价 O(块数 × 值数)。自举 `Main.aura` 规模下（数万块 × 数十万值）会退化到
    /// 10^10 量级。这里改为一次性建立索引。
    ///
    /// 索引以**每块一个 id 串**的形式缓存在 `blockValueBuckets` 里（下标 = 块 id），
    /// 构造只做一次 O(值数)，查询是一次列表下标。
    ///
    /// ⚠️ 曾把整张索引拼成一个巨大 CSV + 每块起始下标 CSV，查询时
    /// `indexFieldAt` 线性扫起点（O(块数²)）、`safeSubstring` 再切值列表
    /// （每次 `strlen(整张索引)` ≈ 750KB）。20826 个块时两者合计十几 GB
    /// 字节扫描 —— `.hat` 序列化 13 秒的主要来源。逐块一个字符串的列表
    /// 两者都省掉了（且逐块小串拼接只影响块内值数，是 O(值数) 总量）。
    private var blockValueBuckets: List<String> = arrayListOf<String>()

    /// 确保块索引已建立（幂等）。
    private fun ensureBlockIndex(mir: MirSsaProgram): Unit {
        if (this.blockIndexReady) {
            return
        }
        // 单遍扫描 values，把 vid 追加到所属块的桶里。
        // 用「每块一个 ArrayList<Int>」避免字符串拼接的平方开销。
        var buckets: List<String> = arrayListOf<String>()
        var bi: Int = 0
        while (bi < mir.blockCount) {
            buckets.add("")
            bi = bi + 1
        }
        var vi: Int = 0
        while (vi < mir.valueCount) {
            val v: MirValue = mir.valueOf(vi)
            val b: Int = v.block
            if (b >= 0 && b < buckets.size) {
                buckets[b] = buckets[b] + HatSerializerUtils.toStr(vi) + ","
            }
            vi = vi + 1
        }
        // 直接保留「每块一个 id 串」的列表：查询即一次列表下标，无需再拼整串。
        this.blockValueBuckets = buckets
        this.blockIndexReady = true
    }

    /// 块索引是否已建立。
    private var blockIndexReady: Boolean = false

    /// 取某一块的「普通值 id 列表」（逗号分隔）。
    ///
    /// 索引串里每个 id 后面都跟一个逗号，块 i 的区间为
    /// `[start_i, start_{i+1})`，因此切片即可。
    private fun blockValueIndex(mir: MirSsaProgram, blockId: Int): String {
        this.ensureBlockIndex(mir)
        if (blockId < 0 || blockId >= this.blockValueBuckets.size) {
            return ""
        }
        return this.blockValueBuckets[blockId]
    }

    // ── Phi 节点序列化 ──

    /// 序列化 Phi 节点。
    private fun serializePhi(mir: MirSsaProgram, phiId: Int): Unit {
        val phi: MirValue = mir.valueOf(phiId)
        var ty: String = this.typeName(mir, phi.type)
        val operands: String = this.operandsText(mir, phi.args)
        this.w("    @" + this.targetName(phi) + " = @phi(" +
            operands + ") : " + ty + "\n")
    }

    // ── 普通指令序列化 ──

    /// 序列化普通指令。
    private fun serializeInstr(mir: MirSsaProgram, instrId: Int): Unit {
        val instr: MirValue = mir.valueOf(instrId)
        var ty: String = this.typeName(mir, instr.type)
        var op: String = this.opName(mir, instr.op)
        val target: String = this.targetName(instr)

        // 常量：`@t0 = @<const_op> <literal> : Type`（aux 存放字面量）
        if (instr.op == "Const") {
            this.ensureConstDefined(mir, instr)
            return
        }

        var head: String = "    @" + target + " = @" + op

        // 副操作码：比较子操作（`@icmp @i32_slt`）/ 被调函数名（`@call @println`）
        if (instr.op == "Call") {
            if (instr.aux != "") {
                head = head + " @" + instr.aux
            }
        } else if (op == "icmp" || op == "fcmp") {
            // SsaBuilder 产出的比较 op 是「谓词内嵌」的（`ICmpSle` / `FCmpOLT`），
            // 需还原成 HAT 的 `@icmp @<pred>` 形态。
            val pred: String = this.cmpPredicate(instr.op, instr.aux)
            if (pred != "") {
                head = head + " @" + pred
            }
        }

        // 先算操作数（其中可能按需补发常量定义行），再整体写出本行
        val operands: String = this.operandsText(mir, instr.args)
        this.w(head + "(" + operands + ") : " + ty + "\n")
    }

    /// 生成操作数列表文本（`@a, @b, ...`）。
    ///
    /// 若某个操作数是常量值，则先确保它已输出定义行（常量在 MIR 中可能由
    /// `addValue` 直接创建、并不在块指令列表里），再以 `@t<id>` 引用它。
    private fun operandsText(mir: MirSsaProgram, args: String): String {
        var ai: Int = 0
        var aStart: Int = 0
        var aLen: Int = args.length
        var result: String = ""
        var first: Boolean = true
        while (ai <= aLen) {
            if (ai == aLen || args.charCodeAt(ai) == 44) {
                if (ai > aStart) {
                    val argStr: String = HatParserUtils.safeSubstring(args, aStart, ai).trim()
                    val argId: Int = HatSerializerUtils.strToInt(argStr)
                    if (argId >= 0) {
                        val arg: MirValue = mir.valueOf(argId)
                        if (arg.op == "Const") {
                            this.ensureConstDefined(mir, arg)
                        }
                        if (first) {
                            first = false
                            result = "@" + this.valueName(mir, arg)
                        } else {
                            result = result + ", @" + this.valueName(mir, arg)
                        }
                    }
                }
                aStart = ai + 1
            }
            ai = ai + 1
        }
        return result
    }

    /// 输出一条常量定义行。
    private fun serializeConst(mir: MirSsaProgram, value: MirValue): Unit {
        val ty: String = this.typeName(mir, value.type)
        val constOp: String = this.constOpName(mir, value)
        if (constOp == "null") {
            this.w("    @" + this.targetName(value) + " = @null : " + ty + "\n")
        } else {
            this.w("    @" + this.targetName(value) + " = @" + constOp + " " +
                this.constLiteral(mir, value) + " : " + ty + "\n")
        }
        this.definedConsts = this.definedConsts + HatSerializerUtils.toStr(value.id) + "|\n"
    }

    /// 按需补发常量定义行（每个常量在每个函数内只输出一次）。
    private fun ensureConstDefined(mir: MirSsaProgram, value: MirValue): Unit {
        val key: String = "\n" + HatSerializerUtils.toStr(value.id) + "|"
        if (this.definedConsts.indexOf(key) >= 0) {
            return
        }
        this.serializeConst(mir, value)
    }

    // ── 终结指令序列化 ──

    /// 序列化终结指令。
    private fun serializeTerminator(mir: MirSsaProgram, term: MirValue): Unit {
        var op: String = term.op

        if (op == "Br") {
            // @br @label
            var args: String = term.args
            val targetId: Int = HatSerializerUtils.strToInt(args)
            if (targetId >= 0) {
                var label: String = this.blockLabel(mir, targetId)
                this.w("    @br @" + label + "\n")
            }
        } else if (op == "CondBr") {
            // @br_if @cond => @then, @else
            var args: String = term.args
            val body: String = this.condBrArgsText(mir, args)
            this.w("    @br_if " + body + "\n")
        } else if (op == "Ret") {
            // @ret @val : Type  或  @ret () : Unit
            var args: String = term.args
            if (args == "") {
                this.w("    @ret () : Unit\n")
            } else {
                val valId: Int = HatSerializerUtils.strToInt(args)
                if (valId >= 0) {
                    val val: MirValue = mir.valueOf(valId)
                    if (val.op == "Const") {
                        this.ensureConstDefined(mir, val)
                    }
                    var ty: String = this.typeName(mir, term.type)
                    this.w("    @ret @" + this.valueName(mir, val) + " : " + ty + "\n")
                } else {
                    this.w("    @ret () : Unit\n")
                }
            }
        } else {
            // 其他终结指令
            this.w("    @" + op + "\n")
        }
    }

    /// 生成条件跳转的参数文本（`@cond => @then, @else`）。
    private fun condBrArgsText(mir: MirSsaProgram, args: String): String {
        // @cond => @then, @else
        var parts: List<String> = args.split(",")
        if (parts.size >= 3) {
            val condId: Int = HatSerializerUtils.strToInt(parts[0])
            val thenId: Int = HatSerializerUtils.strToInt(parts[1])
            val elseId: Int = HatSerializerUtils.strToInt(parts[2])

            var out: String = ""
            if (condId >= 0) {
                val cond: MirValue = mir.valueOf(condId)
                if (cond.op == "Const") {
                    this.ensureConstDefined(mir, cond)
                }
                out = out + "@" + this.valueName(mir, cond)
            }
            out = out + " => @"

            if (thenId >= 0) {
                out = out + this.blockLabel(mir, thenId)
            }
            out = out + ", @"
            if (elseId >= 0) {
                out = out + this.blockLabel(mir, elseId)
            }
            return out
        }
        return ""
    }

    // ── 辅助方法 ──

    /// 获取值在「操作数位置」的引用名。
    ///
    /// 约定：`aux` 存放的是载荷（Const 的字面量 / Call 的被调名 / ICmp 的子操作），
    /// **不是**值名。因此只有 Param 用 aux（参数名），其它值统一用 `t<id>`。
    ///
    /// 常量也必须以 `@t<id>` 引用（而不是内联字面量）：内联会产生
    /// `@0` / `@1` 这类与「临时变量编号」歧义的写法，重新解析时会被当成别的值。
    /// 常量定义行由 `ensureConstDefined` 按需补发。
    private fun valueName(mir: MirSsaProgram, value: MirValue): String {
        if (value.op == "Param") {
            return value.aux
        }
        return "t" + HatSerializerUtils.toStr(value.id)
    }

    /// 获取指令结果在「赋值左侧」的名字。
    private fun targetName(value: MirValue): String {
        return "t" + HatSerializerUtils.toStr(value.id)
    }

    /// 基本块标签：优先使用 MIR 记录的标签，其次入口块 `entry`，最后 `bb<id>`。
    private fun blockLabel(mir: MirSsaProgram, blockId: Int): String {
        if (blockId < 0) {
            return ""
        }
        val recorded: String = mir.blockOf(blockId).label
        if (recorded != "") {
            return recorded
        }
        if (blockId == this.curEntryBlock) {
            return "entry"
        }
        return "bb" + HatSerializerUtils.toStr(blockId)
    }

    /// 常量字面量文本（Const 的 aux 即字面量）。
    private fun constLiteral(mir: MirSsaProgram, value: MirValue): String {
        if (value.aux == "null" || value.aux == "") {
            return "null"
        }
        // 字符串常量需要引号包裹，并对 `\ " 换行 制表 |` 做转义
        //
        // HAT 是**行式**文本：字面量里的裸换行会把一条指令截成两行，HAT 解析
        // 出残骸（实测 P3/test_syscall_write 的 `"Hello, World!\r\n"` → 解析后
        // 值丢失，产物 exe 访问违例 0xC0000005）。设计文档 §3.5 也规定
        // `\` → `\\`、换行 → `\n`、`|` → `\|`。
        if (this.typeName(mir, value.type) == "String") {
            var body: String = value.aux
            val blen: Int = body.length
            if (blen >= 2 && body.startsWith("\"") && body.endsWith("\"")) {
                body = HatParserUtils.safeSubstring(body, 1, blen - 1)
            }
            return "\"" + this.escapeHatText(body) + "\""
        }
        return value.aux
    }

    /// 转义 HAT 字符串字面量载荷（`\` / `"` / 换行 / 回车 / 制表 / `|`）。
    private fun escapeHatText(s: String): String {
        // ⚠️ 旧实现有两处平方级：
        //   1. `out = out + …` 逐字符拼接 —— 对长度 L 的载荷是 O(L²) 拷贝；
        //   2. 普通字符走 `s.substring(i, i + 1)` —— AOT 下 `substring` 每次都要
        //      `strlen(s)`（O(L)），逐字符即 O(L²)。
        // 编译器自身的字符串常量里有数 KB 级的 LLVM IR 模板（`Emit.aura`），
        // 两者叠加在 `.hat` 序列化阶段吃掉十余秒。改为「按转义点切成若干段，
        // 段间原样切片、转义符单独成段，最后两两归并」：转义符少时总代价 O(L)。
        val len: Int = s.length
        val parts: List<String> = arrayListOf<String>()
        var runStart: Int = 0
        var i: Int = 0
        while (i < len) {
            val c: Int = s.charCodeAt(i)
            var rep: String = ""
            if (c == 92) {
                rep = "\\\\"
            } else if (c == 34) {
                rep = "\\\""
            } else if (c == 10) {
                rep = "\\n"
            } else if (c == 13) {
                rep = "\\r"
            } else if (c == 9) {
                rep = "\\t"
            } else if (c == 124) {
                rep = "\\|"
            }
            if (rep != "") {
                if (i > runStart) {
                    parts.add(s.substring(runStart, i))
                }
                parts.add(rep)
                runStart = i + 1
            }
            i = i + 1
        }
        if (runStart < len) {
            parts.add(s.substring(runStart, len))
        }
        return this.joinChunks(parts)
    }

    /// 根据常量类型名选择 HAT 常量操作码。
    ///
    /// 注意：HAT 解析产生的类型都是 `Basic` 种类（`fromTypeName` 只登记名字），
    /// 因此这里必须按 `typeName` 的字符串判断，而不是 `kindOf`。
    private fun constOpName(mir: MirSsaProgram, value: MirValue): String {
        if (value.aux == "null") {
            return "null"
        }
        val tn: String = this.typeName(mir, value.type)
        if (value.aux == "") {
            if (tn == "Unit") {
                return "null"
            }
            return "i32_const"
        }
        if (tn == "Float") {
            return "f64_const"
        }
        if (tn == "Bool") {
            return "bool_const"
        }
        if (tn == "String") {
            return "const_str"
        }
        return "i32_const"
    }

    /// 比较谓词还原：SSA op（`ICmpSle` / `FCmpOLT`）→ HAT 谓词（`i32_sle` / `f64_lt`）。
    ///
    /// `SsaBuilder.mapBinaryOp` 把谓词编进了 op 名（下游 `Lowering.mapCmpOp`
    /// 与 `InstructionSelection` 都按 `ICmpSle` 这类名字匹配），而 HAT 用
    /// `@icmp @<pred>` 形态，故此处需要一层双向映射。
    private fun cmpPredicate(op: String, aux: String): String {
        if (op == "ICmpEq") { return "i32_eq" }
        if (op == "ICmpNe") { return "i32_ne" }
        if (op == "ICmpSlt") { return "i32_slt" }
        if (op == "ICmpSgt") { return "i32_sgt" }
        if (op == "ICmpSle") { return "i32_sle" }
        if (op == "ICmpSge") { return "i32_sge" }
        if (op == "ICmpUlt") { return "i32_ult" }
        if (op == "ICmpUgt") { return "i32_ugt" }
        if (op == "ICmpUle") { return "i32_ule" }
        if (op == "ICmpUge") { return "i32_uge" }
        if (op == "FCmpOEQ") { return "f64_eq" }
        if (op == "FCmpONE") { return "f64_ne" }
        if (op == "FCmpOLT") { return "f64_lt" }
        if (op == "FCmpOGT") { return "f64_gt" }
        if (op == "FCmpOLE") { return "f64_le" }
        if (op == "FCmpOGE") { return "f64_ge" }
        // 兼容 HAT 解析路径（op 已归一为 ICmp/FCmp，谓词留在 aux）
        if (op == "ICmp" || op == "FCmp") {
            return aux
        }
        return ""
    }

    /// 获取操作码名称。
    private fun opName(mir: MirSsaProgram, op: String): String {
        if (op == "Const") {
            return "i32_const"
        }
        if (op == "Add") {
            return "add"
        }
        if (op == "Sub") {
            return "sub"
        }
        if (op == "Mul") {
            return "mul"
        }
        if (op == "Div" || op == "SDiv") {
            return "div"
        }
        if (op == "Rem" || op == "SRem") {
            return "rem"
        }
        if (op == "Neg") {
            return "neg"
        }
        if (op == "And") {
            return "and"
        }
        if (op == "Or") {
            return "or"
        }
        if (op == "Xor") {
            return "xor"
        }
        if (op == "Not") {
            return "not"
        }
        if (op == "ICmp" || op.startsWith("ICmp")) {
            return "icmp"
        }
        if (op == "FCmp" || op.startsWith("FCmp")) {
            return "fcmp"
        }
        if (op == "Call") {
            return "call"
        }
        if (op == "Alloc") {
            return "alloc"
        }
        if (op == "Store") {
            return "store"
        }
        if (op == "Load") {
            return "load"
        }
        if (op == "AllocList") {
            return "alloc_list"
        }
        if (op == "ListSet") {
            return "list_set"
        }
        if (op == "ListGet") {
            return "list_get"
        }
        if (op == "ListLen") {
            return "list_len"
        }
        if (op == "New") {
            return "new"
        }
        if (op == "GetField") {
            return "field"
        }
        if (op == "SetField") {
            return "field_set"
        }
        if (op == "StrConcat") {
            return "str_concat"
        }
        if (op == "StrLen") {
            return "str_len"
        }
        if (op == "StrSub") {
            return "str_sub"
        }
        if (op == "StrChar") {
            return "str_char"
        }
        if (op == "Band") {
            return "band"
        }
        if (op == "Bor") {
            return "bor"
        }
        if (op == "Bxor") {
            return "bxor"
        }
        if (op == "Shl") {
            return "shl"
        }
        if (op == "Shr") {
            return "shr"
        }
        return op
    }

    /// 获取类型名称。
    private fun typeName(mir: MirSsaProgram, typeId: Int): String {
        if (typeId < 0) {
            return "Int"
        }
        var kind: String = mir.types.kindOf(typeId)
        var name: String = mir.types.nameOf(typeId)

        if (kind == "Int") {
            return "Int"
        }
        if (kind == "Float") {
            return "Float"
        }
        if (kind == "Bool") {
            return "Bool"
        }
        if (kind == "Unit") {
            return "Unit"
        }
        if (kind == "String") {
            return "String"
        }
        if (kind == "Basic" && name != "") {
            return name
        }
        return kind
    }

    // ── 设置器 ──

    /// 设置模块名。
    fun setModuleName(name: String): Unit {
        this.moduleName = name
    }

    /// 设置目标三元组。
    fun setTargetTriple(triple: String): Unit {
        this.targetTriple = triple
    }

    /// 获取输出（最近一次 `serialize()` 的产物；未序列化时为空串）。
    fun getOutput(): String {
        return this.lastOutput
    }
}

// ─────────────────────────────────────────────────────────────
// HatSerializerUtils — 工具对象
// ─────────────────────────────────────────────────────────────

object HatSerializerUtils {

    /// 字符串转整数。
    fun strToInt(text: String): Int {
        if (text == "") {
            return 0
        }
        var total: Int = 0
        var i: Int = 0
        var neg: Boolean = false
        var len: Int = text.length
        if (len > 0 && text.charCodeAt(0) == 45) {
            neg = true
            i = 1
        }
        while (i < len) {
            val c: Int = text.charCodeAt(i)
            if (c >= 48 && c <= 57) {
                total = total * 10 + (c - 48)
            }
            i = i + 1
        }
        if (neg) {
            return -total
        }
        return total
    }

    /// 整数转字符串。
    fun toStr(n: Int): String {
        if (n == 0) {
            return "0"
        }
        var neg: Boolean = false
        if (n < 0) {
            neg = true
            n = -n
        }
        var result: String = ""
        while (n > 0) {
            result = HatSerializerUtils.digitChar(n % 10) + result
            n = n / 10
        }
        if (neg) {
            result = "-" + result
        }
        return result
    }

    /// 把 0-9 的数字转换为单字符字符串。
    private fun digitChar(d: Int): String {
        if (d == 0) { return "0" }
        if (d == 1) { return "1" }
        if (d == 2) { return "2" }
        if (d == 3) { return "3" }
        if (d == 4) { return "4" }
        if (d == 5) { return "5" }
        if (d == 6) { return "6" }
        if (d == 7) { return "7" }
        if (d == 8) { return "8" }
        return "9"
    }

    /// 空序列化器。
    fun emptySerializer(): HatSerializer {
        return HatSerializer()
    }

    /// 序列化 SSA MIR 为 HAT 文本。
    fun serializeHat(mir: MirSsaProgram, module: String): String {
        val serializer: HatSerializer = HatSerializer()
        serializer.setModuleName(module)
        return serializer.serialize(mir)
    }
}
