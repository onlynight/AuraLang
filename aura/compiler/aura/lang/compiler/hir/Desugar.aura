// aura:///aura/lang/compiler/hir/desugar.aura
package aura.lang.compiler.hir
// ─────────────────────────────────────────────────────────────
// 去语法糖 — 纯 Aura 化迁移 · Phase 2 (任务 2.6)
//
// 对应 Rust `compiler/src/codegen/hir.rs` 中的 desugar 部分。
//
// HIR 是去除了语法糖的 AST。本 pass 进一步降级：
//   * `when` → 嵌套 `if`（Phase B.1）
//   * `for` → 保留（Phase B：保留 HirFor 节点，由 MIR 降级）
//   * `try/catch/finally` → 保留 HirTry 节点（Phase B.4，MIR 降级）
//   * `lambda/closure` → 保留 HirLambda 节点（Phase B.2，MIR 降级）
//   * Elvis → 嵌套 if
//   * 安全调用 → 嵌套 if
//
// ── 设计方式（与 Hir.aura 一致）──────────────────────────────
//
// 使用扁平 arena 表示，与 Hir.aura 的节点格式一致。
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String

/// 去语法糖处理。
class Desugar {

    /// 输入的 HIR。
    var src: Hir = Hir()

    /// 输出的 HIR（去糖后的新 HIR）。
    var dst: Hir = Hir()

    init() {
        this.src = Hir()
        this.dst = Hir()
    }

    /// 执行去糖，返回新的 HIR 根节点 id。
    fun desugar(src: Hir): Int {
        this.src = src
        this.dst = Hir()
        // 查找 Program 根节点
        val n: Int = src.count
        var rootIdx: Int = -1
        var i: Int = 0
        while (i < n) {
            if (src.kindOf(i) == "HirProgram") {
                rootIdx = i
                break
            }
            i = i + 1
        }
        if (rootIdx < 0) {
            rootIdx = 0
        }
        return this.desugarNode(src, rootIdx)
    }

    /// 降级单个节点。
    fun desugarNode(src: Hir, id: Int): Int {
        val kind: String = src.kindOf(id)
        val text: String = src.textOf(id)
        val ty: String = src.tyOf(id)
        val sp: Span = src.spanOf(id)
        val kids: String = src.kidsOf(id)
        val kCount: Int = hirKidsCount(kids)

        // 递归降级子节点
        var newKids: String = hirNoKids()
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = hirKidsAt(kids, i)
            val childDstId: Int = this.desugarNode(src, childId)
            if (childDstId >= 0) {
                newKids = hirKidsAdd(newKids, childDstId)
            }
            i = i + 1
        }

        // 特定节点降级
        if (kind == "HirWhen") {
            return this.desugarWhen(src, id)
        } else if (kind == "HirFor") {
            return this.desugarFor(src, id)
        } else if (kind == "HirBinary" && (text == "?:" || text == "ElvisColon")) {
            return this.desugarElvis(src, id)
        } else {
            // 其他节点直接复制到 dst（HirTry / HirLambda 保留结构）
            return this.dst.add(kind, text, ty, sp, newKids)
        }
    }

    /// 降级 when 表达式为嵌套 if（Phase B.1）。
    ///
    /// 结构：HirWhen([subject?], HirWhenArms([HirWhenArm(pattern, body)...]))
    /// 降级为：if (subject == pat1) body1 else if (subject == pat2) body2 else ...
    fun desugarWhen(src: Hir, id: Int): Int {
        val sp: Span = src.spanOf(id)
        val kids: String = src.kidsOf(id)
        val kCount: Int = hirKidsCount(kids)

        // 提取 subject（可选，子节点 0）
        var subjectId: Int = -1
        var armsId: Int = -1
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = hirKidsAt(kids, i)
            val childKind: String = src.kindOf(childId)
            if (childKind == "HirWhenArms") {
                armsId = childId
            } else {
                subjectId = childId
            }
            i = i + 1
        }

        if (armsId < 0) {
            // 无 arms，返回空块
            return this.dst.leaf("HirBlock", "", sp)
        }

        // 提取 arms
        val armsKids: String = src.kidsOf(armsId)
        val armsKCount: Int = hirKidsCount(armsKids)

        // 从后往前构造 else 链
        var resultId: Int = -1
        var j: Int = 0
        while (j < armsKCount) {
            val armId: Int = hirKidsAt(armsKids, j)
            val armKids: String = src.kidsOf(armId)
            val armKCount: Int = hirKidsCount(armKids)

            if (armKCount < 2) {
                j = j + 1
                continue
            }

            // 提取 pattern 和 body
            val patternId: Int = hirKidsAt(armKids, 0)
            val bodyId: Int = hirKidsAt(armKids, 1)

            // 降级 pattern 和 body
            val patternDstId: Int = this.desugarNode(src, patternId)
            val bodyDstId: Int = this.desugarNode(src, bodyId)

            if (patternDstId < 0 || bodyDstId < 0) {
                j = j + 1
                continue
            }

            // 构造条件：subject == pattern
            var condDstId: Int = -1
            if (subjectId >= 0) {
                val subjectDstId: Int = this.desugarNode(src, subjectId)
                if (subjectDstId >= 0) {
                    // HirBinary("==", [subject, pattern])
                    var condKids: String = hirKidsAdd(hirNoKids(), subjectDstId)
                    condKids = hirKidsAdd(condKids, patternDstId)
                    condDstId = this.dst.add("HirBinary", "==", "", sp, condKids)
                }
            } else {
                // 无 subject：pattern 本身即条件
                condDstId = patternDstId
            }

            // 构造 else 链：如果已有 result，则当前 arm 的 else = 之前的 result
            var elseDstId: Int = -1
            if (resultId >= 0) {
                elseDstId = resultId
            }

            // 构造 HirIf(cond, then, else)
            var ifKids: String = hirNoKids()
            if (condDstId >= 0) {
                ifKids = hirKidsAdd(ifKids, condDstId)
            }
            ifKids = hirKidsAdd(ifKids, bodyDstId)
            if (elseDstId >= 0) {
                ifKids = hirKidsAdd(ifKids, elseDstId)
            }

            resultId = this.dst.add("HirIfExpr", "", "", sp, ifKids)
            j = j + 1
        }

        if (resultId >= 0) {
            return resultId
        }

        // 无有效 arm，返回空块
        return this.dst.leaf("HirBlock", "", sp)
    }

    /// 降级 for 循环（Phase B：保留 HirFor 节点，由 MIR 降级）。
    fun desugarFor(src: Hir, id: Int): Int {
        val sp: Span = src.spanOf(id)
        val kids: String = src.kidsOf(id)
        val kCount: Int = hirKidsCount(kids)

        var newKids: String = hirNoKids()
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = hirKidsAt(kids, i)
            val childDstId: Int = this.desugarNode(src, childId)
            if (childDstId >= 0) {
                newKids = hirKidsAdd(newKids, childDstId)
            }
            i = i + 1
        }
        return this.dst.add("HirFor", "", "", sp, newKids)
    }

    /// 降级 Elvis 操作符 `a ?: b` 为 `if (a != null) a else b`。
    fun desugarElvis(src: Hir, id: Int): Int {
        val sp: Span = src.spanOf(id)
        val kids: String = src.kidsOf(id)
        val kCount: Int = hirKidsCount(kids)

        if (kCount < 2) {
            return this.dst.leaf("HirExpr", "elvis", sp)
        }

        val lhsId: Int = hirKidsAt(kids, 0)
        val rhsId: Int = hirKidsAt(kids, 1)

        val lhsDstId: Int = this.desugarNode(src, lhsId)
        val rhsDstId: Int = this.desugarNode(src, rhsId)

        if (lhsDstId < 0 || rhsDstId < 0) {
            return this.dst.leaf("HirExpr", "elvis", sp)
        }

        // 构造 a != null
        val nullLitId: Int = this.dst.leaf("HirLit", "null", sp)
        var condKids: String = hirKidsAdd(hirNoKids(), lhsDstId)
        condKids = hirKidsAdd(condKids, nullLitId)
        val condDstId: Int = this.dst.add("HirBinary", "!=", "", sp, condKids)

        // 构造 if (cond) a else b
        var ifKids: String = hirKidsAdd(hirNoKids(), condDstId)
        ifKids = hirKidsAdd(ifKids, lhsDstId)
        ifKids = hirKidsAdd(ifKids, rhsDstId)
        return this.dst.add("HirIfExpr", "", "", sp, ifKids)
    }

    /// 获取去糖后的 HIR。
    fun getDst(): Hir {
        return this.dst
    }
}