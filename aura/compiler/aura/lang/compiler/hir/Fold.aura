// aura:///aura/lang/compiler/hir/fold.aura
package aura.lang.compiler.hir
// ─────────────────────────────────────────────────────────────
// 常量折叠 — 纯 Aura 化迁移 · Phase 2 (任务 2.9)
//
// 对应 Rust `compiler/src/codegen/hir.rs` 中的 fold 部分。
//
// 常量折叠是在编译期计算常量表达式的值，替换为常量字面量。
// 例如 `1 + 2` → `3`，`"hello" + " " + "world"` → `"hello world"`。
//
// ── 本版覆盖范围 ──
//
// 支持的基本折叠：
//   * 整数字面量 + 整数字面量 → 整数结果
//   * 浮点字面量 + 浮点字面量 → 浮点结果
//   * 字符串字面量 + 字符串字面量 → 字符串结果
//   * 布尔字面量 && / || → 布尔结果
//   * 一元运算（-、!）→ 常量结果
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String

/// 常量折叠处理。
class Fold {

    /// 输入的 HIR。
    var src: Hir = Hir()

    /// 输出的 HIR（折叠后的新 HIR）。
    var dst: Hir = Hir()

    init() {
        this.src = Hir()
        this.dst = Hir()
    }

    /// 执行常量折叠，返回新的 HIR 根节点 id。
    fun fold(src: Hir): Int {
        this.src = src
        this.dst = Hir()
        // 查找 Program 根节点
        val n: Int = src.count
        var rootIdx: Int = -1
        var i: Int = 0
        while (i < n) {
            if (src.kindOf(i) == "HirProgram") {
                rootIdx = i
                break
            }
            i = i + 1
        }
        if (rootIdx < 0) {
            rootIdx = 0
        }
        return this.foldNode(src, rootIdx)
    }

    /// 折叠处理单个节点。
    fun foldNode(src: Hir, id: Int): Int {
        val kind: String = src.kindOf(id)
        val text: String = src.textOf(id)
        val ty: String = src.tyOf(id)
        val sp: Span = src.spanOf(id)
        val kids: String = src.kidsOf(id)
        val kCount: Int = hirKidsCount(kids)

        // 递归折叠子节点
        var newKids: String = hirNoKids()
        var i: Int = 0
        while (i < kCount) {
            val childId: Int = hirKidsAt(kids, i)
            val childDstId: Int = this.foldNode(src, childId)
            if (childDstId >= 0) {
                newKids = hirKidsAdd(newKids, childDstId)
            }
            i = i + 1
        }

        // 二元运算常量折叠
        if (kind == "HirBinary" && kCount >= 2) {
            val op: String = text
            val leftId: Int = hirKidsAt(newKids, 0)
            val rightId: Int = hirKidsAt(newKids, 1)

            val leftKind: String = this.dst.kindOf(leftId)
            val rightKind: String = this.dst.kindOf(rightId)

            // 两个操作数都是字面量
            if (leftKind == "HirLit" && rightKind == "HirLit") {
                val leftVal: String = this.dst.textOf(leftId)
                val rightVal: String = this.dst.textOf(rightId)
                val result: String = this.tryFoldBinary(op, leftVal, rightVal)
                if (result != "") {
                    // 返回折叠后的常量节点
                    return this.dst.add("HirLit", result, "", sp, hirNoKids())
                }
            }
        }

        // 一元运算常量折叠
        if (kind == "HirUnary" && kCount >= 1) {
            val op: String = text
            val operandId: Int = hirKidsAt(newKids, 0)
            val operandKind: String = this.dst.kindOf(operandId)

            if (operandKind == "HirLit") {
                val operandVal: String = this.dst.textOf(operandId)
                val result: String = this.tryFoldUnary(op, operandVal)
                if (result != "") {
                    return this.dst.add("HirLit", result, "", sp, hirNoKids())
                }
            }
        }

        // 其他节点直接复制（使用已折叠的子节点）
        return this.dst.add(kind, text, ty, sp, newKids)
    }

    /// 尝试折叠二元运算。
    fun tryFoldBinary(op: String, left: String, right: String): String {
        // 整数运算
        if (op == "+" || op == "-" || op == "*" || op == "/" || op == "%") {
            val leftInt: Int = this.tryToInt(left)
            val rightInt: Int = this.tryToInt(right)
            if (leftInt >= 0 && rightInt >= 0) {
                // 标记为有效（-1 表示非整数）
                if (this.isInt(left) && this.isInt(right)) {
                    var result: Int = 0
                    if (op == "+") result = leftInt + rightInt
                    else if (op == "-") result = leftInt - rightInt
                    else if (op == "*") result = leftInt * rightInt
                    else if (op == "/" && rightInt != 0) result = leftInt / rightInt
                    else if (op == "%" && rightInt != 0) result = leftInt % rightInt
                    return toStr(result)
                }
            }
        }

        // 字符串拼接
        if (op == "+" && this.isStringLit(left) && this.isStringLit(right)) {
            // 去掉引号后拼接
            val leftStr: String = this.stripQuotes(left)
            val rightStr: String = this.stripQuotes(right)
            return "\"" + leftStr + rightStr + "\""
        }

        // 比较运算
        if (op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=") {
            if (this.isInt(left) && this.isInt(right)) {
                val leftInt: Int = this.tryToInt(left)
                val rightInt: Int = this.tryToInt(right)
                var result: Boolean = false
                if (op == "==") result = leftInt == rightInt
                else if (op == "!=") result = leftInt != rightInt
                else if (op == "<") result = leftInt < rightInt
                else if (op == ">") result = leftInt > rightInt
                else if (op == "<=") result = leftInt <= rightInt
                else if (op == ">=") result = leftInt >= rightInt
                if (result) return "true"
                else return "false"
            }
        }

        // 逻辑运算
        if (op == "&&" || op == "||") {
            if ((left == "true" || left == "false") && (right == "true" || right == "false")) {
                val leftBool: Boolean = (left == "true")
                val rightBool: Boolean = (right == "true")
                var result: Boolean = false
                if (op == "&&") result = leftBool && rightBool
                else result = leftBool || rightBool
                if (result) return "true"
                else return "false"
            }
        }

        return ""
    }

    /// 尝试折叠一元运算。
    fun tryFoldUnary(op: String, operand: String): String {
        if (op == "-" && this.isInt(operand)) {
            val val: Int = this.tryToInt(operand)
            return toStr(-val)
        }
        if (op == "!" && (operand == "true" || operand == "false")) {
            if (operand == "true") return "false"
            else return "true"
        }
        return ""
    }

    /// 检查是否为整数字面量。
    fun isInt(text: String): Boolean {
        val len: Int = text.length
        if (len == 0) return false
        var i: Int = 0
        while (i < len) {
            val c: String = toStr(text[i])
            if (c != "-" && c != "+" && c != "0" && c != "1" && c != "2" && c != "3"
                && c != "4" && c != "5" && c != "6" && c != "7" && c != "8" && c != "9") {
                return false
            }
            i = i + 1
        }
        return true
    }

    /// 尝试转换为整数（失败返回 -1）。
    fun tryToInt(text: String): Int {
        if (!this.isInt(text)) return -1
        var neg: Boolean = false
        var i: Int = 0
        val len: Int = text.length
        if (i < len && toStr(text[i]) == "-") {
            neg = true
            i = i + 1
        } else if (i < len && toStr(text[i]) == "+") {
            i = i + 1
        }
        var total: Int = 0
        while (i < len) {
            val c: String = toStr(text[i])
            var digit: Int = -1
            if (c == "0") digit = 0
            else if (c == "1") digit = 1
            else if (c == "2") digit = 2
            else if (c == "3") digit = 3
            else if (c == "4") digit = 4
            else if (c == "5") digit = 5
            else if (c == "6") digit = 6
            else if (c == "7") digit = 7
            else if (c == "8") digit = 8
            else if (c == "9") digit = 9
            total = total * 10 + digit
            i = i + 1
        }
        if (neg) return -total
        return total
    }

    /// 检查是否为字符串字面量。
    fun isStringLit(text: String): Boolean {
        if (text.length < 2) return false
        return toStr(text[0]) == "\"" && toStr(text[text.length - 1]) == "\""
    }

    /// 去掉字符串字面量的引号。
    fun stripQuotes(text: String): String {
        if (text.length < 2) return text
        var result: String = ""
        var i: Int = 1
        val len: Int = text.length - 1
        while (i < len) {
            result = result + toStr(text[i])
            i = i + 1
        }
        return result
    }

    /// 获取折叠后的 HIR。
    fun getDst(): Hir {
        return this.dst
    }
}
