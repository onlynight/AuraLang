// aura:///aura/lang/compiler/ast/Ast.aura
package aura.lang.compiler.ast
// ─────────────────────────────────────────────────────────────
// AST 定义 — 纯 Aura 化迁移 · Phase 1
//
// 对应 Rust `compiler/src/ast.rs`。
//
// ── 表示方式（受当前 VM 能力约束的重要设计决策）──────────────
//
// Rust 侧是 `enum Expr / enum Decl` 构成的树。Aura 侧若直接用 `sealed class` 层次 +
// `List<Node>` 子节点，会撞上当前 VM 的两个限制：
//   * `List.add` / `List.append` 不可用（参数约定不符，曾导致越界 panic）；
//   * 大量小对象 + 深递归的构造路径尚未充分验证。
//
// 因此这里采用**扁平 arena（索引化树）**，与 lexer 的 token 流表示保持一致：
//
//   * 每个节点一个整数 id（按创建顺序递增，0 为未使用/哨兵）；
//   * 节点字段分别存在 5 条「每行一项」的 String 中（kinds / texts / tys / spans / kids）；
//   * 子节点以**逗号分隔的 id 列表**存在 `kids` 中（解析时逐个追加成串，创建父节点时给定）。
//
// 这样既能在纯 Aura 中构造任意形状的树，又能用索引 O(1) 定位，且 `dump()` 可产出
// 稳定的缩进文本，便于与 Rust `aura ast` 输出做结构性对照。
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String

// ─────────────────────────────────────────────────────────────
// 子节点 id 列表的辅助（以逗号分隔的 String 表示）
// ─────────────────────────────────────────────────────────────

/// 空的子节点列表。
fun noKids(): String {
    return ""
}

/// 向子节点列表追加一个 id。
fun kidsAdd(list: String, child: Int): String {
    if (list == "") {
        return toStr(child)
    }
    return list + "," + toStr(child)
}

/// 子节点列表的长度。
fun kidsCount(list: String): Int {
    if (list == "") {
        return 0
    }
    val parts: List<String> = list.split(",")
    return parts.size
}

/// 取子节点列表的第 index 个 id。
fun kidsAt(list: String, index: Int): Int {
    return toIntOf(fieldAt(list, index, ","))
}

// ─────────────────────────────────────────────────────────────
// AST
// ─────────────────────────────────────────────────────────────

/// 扁平 arena 形式的抽象语法树。
class Ast {

    /// 节点种类（每行一个）。
    var kinds: String = ""

    /// 节点主文本：标识符名 / 字面量文本 / 运算符（每行一个，换行已转义）。
    var texts: String = ""

    /// 节点类型名（每行一个；无类型信息时为空）。
    var tys: String = ""

    /// Span（每行一个：`start end sl sc el ec`，空格分隔）。
    var spans: String = ""

    /// 子节点 id 列表（每行一个：逗号分隔，可为空行）。
    var kids: String = ""

    /// 节点总数。
    var count: Int = 0

    // ── 构造 ──

    /// 追加一个节点，返回其 id。
    fun add(kind: String, text: String, ty: String, sp: Span, children: String): Int {
        val id: Int = this.count
        this.count = id + 1
        this.kinds = this.kinds + kind + "\n"
        // 手动转义换行符（避免 replace 在 VM 内类调用时未链接）
        var escaped: String = ""
        var i: Int = 0
        var len: Int = text.length
        while (i < len) {
            val c: String = toStr(text[i])
            if (c == "\n") {
                escaped = escaped + "\\n"
            } else {
                escaped = escaped + c
            }
            i = i + 1
        }
        this.texts = this.texts + escaped + "\n"
        this.tys = this.tys + ty + "\n"
        this.spans = this.spans + toStr(sp.start) + " " + toStr(sp.end) + " "
            + toStr(sp.startLine) + " " + toStr(sp.startCol) + " "
            + toStr(sp.endLine) + " " + toStr(sp.endCol) + "\n"
        this.kids = this.kids + children + "\n"
        return id
    }

    /// 追加一个无类型、无子节点的节点。
    fun leaf(kind: String, text: String, sp: Span): Int {
        return this.add(kind, text, "", sp, noKids())
    }

    // ── 访问 ──

    /// 第 id 个节点的种类。
    fun kindOf(id: Int): String {
        return this.lineAt(this.kinds, id)
    }

    /// 第 id 个节点的主文本。
    fun textOf(id: Int): String {
        val raw: String = this.lineAt(this.texts, id)
        // 手动反转义换行符（避免 replace 在 VM 内类调用时未链接）
        var result: String = ""
        var i: Int = 0
        var len: Int = raw.length
        while (i < len) {
            if (i + 1 < len && toStr(raw[i]) == "\\" && toStr(raw[i + 1]) == "n") {
                result = result + "\n"
                i = i + 2
            } else {
                result = result + toStr(raw[i])
                i = i + 1
            }
        }
        return result
    }

    /// 第 id 个节点的类型名。
    fun tyOf(id: Int): String {
        return this.lineAt(this.tys, id)
    }

    /// 第 id 个节点的位置。
    fun spanOf(id: Int): Span {
        val line: String = fieldAt(this.spans, id, "\n")
        return Span(
            toIntOf(fieldAt(line, 0, " ")), toIntOf(fieldAt(line, 1, " ")),
            toIntOf(fieldAt(line, 2, " ")), toIntOf(fieldAt(line, 3, " ")),
            toIntOf(fieldAt(line, 4, " ")), toIntOf(fieldAt(line, 5, " "))
        )
    }

    /// 第 id 个节点的子节点 id 列表（逗号分隔串）。
    fun kidsOf(id: Int): String {
        return this.lineAt(this.kids, id)
    }

    /// 第 id 个节点的第 i 个子节点 id（越界返回 -1）。
    fun childOf(id: Int, i: Int): Int {
        val k: String = this.kidsOf(id)
        if (i >= kidsCount(k)) {
            return -1
        }
        return kidsAt(k, i)
    }

    // ── 输出 ──

    /// 从根节点（id 0）开始的缩进文本转储。
    fun dump(): String {
        if (this.count == 0) {
            return "<empty ast>\n"
        }
        return this.dumpNode(0, 0)
    }

    /// 递归转储单个节点。
    fun dumpNode(id: Int, depth: Int): String {
        var line: String = this.indent(depth) + this.kindOf(id)
        val t: String = this.textOf(id)
        if (t != "") {
            line = line + " " + t
        }
        val ty: String = this.tyOf(id)
        if (ty != "") {
            line = line + " : " + ty
        }
        var out: String = line + "\n"

        val k: String = this.kidsOf(id)
        val n: Int = kidsCount(k)
        var i: Int = 0
        while (i < n) {
            out = out + this.dumpNode(kidsAt(k, i), depth + 1)
            i = i + 1
        }
        return out
    }

    /// 生成 depth 级缩进（每级 2 空格）。
    fun indent(depth: Int): String {
        var s: String = ""
        var i: Int = 0
        while (i < depth) {
            s = s + "  "
            i = i + 1
        }
        return s
    }

    /// 取第 index 行（内部辅助）。本编译器不支持 list[i]，用顶层 fieldAt 字符扫描。
    fun lineAt(text: String, index: Int): String {
        return fieldAt(text, index, "\n")
    }
}

/// 取第 index 个以 sep 分隔的字段。
fun fieldAt(text: String, index: Int, sep: String): String {
    var i: Int = 0
    var fieldStart: Int = 0
    var cur: Int = 0
    var fieldLen: Int = text.length
    while (i < fieldLen) {
        val c: String = text[i]
        if (c == sep) {
            if (cur == index) {
                var result: String = ""
                var j: Int = fieldStart
                while (j < i) {
                    result = result + text[j]
                    j = j + 1
                }
                return result
            }
            cur = cur + 1
            fieldStart = i + 1
        }
        i = i + 1
    }
    if (cur == index) {
        var result: String = ""
        var j: Int = fieldStart
        while (j < fieldLen) {
            result = result + text[j]
            j = j + 1
        }
        return result
    }
    return ""
}

/// 十进制字符串 → Int（局部实现，避免与 Lexer 内部辅助耦合）。
fun toIntOf(text: String): Int {
    if (text == "") {
        return 0
    }
    val len: Int = text.length
    var total: Int = 0
    var i: Int = 0
    var neg: Boolean = false
    // 处理负号
    if (len > 0 && toStr(text[0]) == "-") {
        neg = true
        i = 1
    }
    while (i < len) {
        val c: String = toStr(text[i])
        // 手动计算数字值（避免 indexOf 在 VM 内类调用时未链接）
        var digit: Int = -1
        if (c == "0") {
            digit = 0
        }
        if (c == "1") {
            digit = 1
        }
        if (c == "2") {
            digit = 2
        }
        if (c == "3") {
            digit = 3
        }
        if (c == "4") {
            digit = 4
        }
        if (c == "5") {
            digit = 5
        }
        if (c == "6") {
            digit = 6
        }
        if (c == "7") {
            digit = 7
        }
        if (c == "8") {
            digit = 8
        }
        if (c == "9") {
            digit = 9
        }
        if (digit >= 0) {
            total = total * 10 + digit
        }
        i = i + 1
    }
    if (neg) {
        return -total
    }
    return total
}
