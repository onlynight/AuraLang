// aura:///aura/lang/compiler/serialize/AucSerializer.aura
package aura.lang.compiler.serialize
// ─────────────────────────────────────────────────────────────
// .auc 二进制序列化 / 反序列化 — Phase S2
//
// 对应 Rust `compiler/src/codegen/serialize.rs`。
//
// .auc 文件布局（小端）：
//   "AURA" | u16 version | u32 header_flags |
//   u16 module_name_len | module_name |
//   u16 module_version_len | module_version |
//   u8[16] uuid |
//   u32 consts_count | consts |
//   u16 natives_count | natives |
//   u16 funcs_count | funcs |
//   u16 entry |
//   u16 entry_kind_len | entry_kind |
//   u16 exports_count | exports |
//   u16 imports_count | imports |
//   u16 deps_count | deps |
//   u16 sig_ids_count | sig_ids |
// ─────────────────────────────────────────────────────────────

import aura.lang.native.Memory
import aura.lang.native.memory.Allocator
import aura.lang.native.file.FileOps
import aura.lang.native.Syscalls
import aura.lang.std.String
import aura.lang.std.FileSystem
import aura.lang.compiler.serialize.PlatformFileIO

/// .auc 格式常量。
object AucConstants {

    /// 魔数。
    const val MAGIC: String = "AURA"

    /// 当前格式版本。
    const val VERSION: Int = 7

    /// 常量标签。
    const val CONST_INT: Int = 0
    const val CONST_FLOAT: Int = 1
    const val CONST_STR: Int = 2
    const val CONST_BOOL: Int = 3
    const val CONST_NULL: Int = 4

    /// 段 id。
    const val SEG_BYTECODE: Int = 0
    const val SEG_MACHINE: Int = 1
    const val SEG_DESC_TABLE: Int = 2
    const val SEG_DEBUG: Int = 3
    const val SEG_STRING_POOL: Int = 4
    const val SEG_SIGNATURE: Int = 5

    /// 段标志。
    const val SEG_PROT_READ: Int = 1
    const val SEG_PROT_WRITE: Int = 2
    const val SEG_PROT_EXEC: Int = 4
    const val SEG_READONLY: Int = 8
}

/// 二进制写入器（小端）。
object AucWriter {

    /// 内部缓冲区。
    var buf: Long = 0
    var bufSize: Long = 65536
    var bufPos: Long = 0

    /// 初始化。
    fun init(): Boolean {
        buf = Allocator.malloc(bufSize)
        return buf != 0
    }

    /// 释放缓冲区。
    fun dispose() {
        if (buf != 0) {
            Allocator.free(buf)
            buf = 0
        }
        bufPos = 0
    }

    /// 确保容量。
    fun ensureCapacity(additional: Long) {
        if (bufPos + additional > bufSize) {
            val newSize: Long = bufSize * 2
            while (bufPos + additional > newSize) {
                newSize = newSize * 2
            }
            val newBuf: Long = Allocator.malloc(newSize)
            if (newBuf == 0) { return }
            Memory.copy(newBuf, buf, bufPos)
            Allocator.free(buf)
            buf = newBuf
            bufSize = newSize
        }
    }

    /// 写入 1 字节。
    fun writeByte(v: Byte) {
        ensureCapacity(1)
        Memory.write(buf + bufPos, v)
        bufPos = bufPos + 1
    }

    /// 写入 2 字节（小端）。位运算用符号形式（见 `readU16` 说明）。
    fun writeU16(v: Int) {
        ensureCapacity(2)
        Memory.write(buf + bufPos, (v & 0xFF) as Byte)
        Memory.write(buf + bufPos + 1, ((v >> 8) & 0xFF) as Byte)
        bufPos = bufPos + 2
    }

    /// 写入 4 字节（小端）。
    fun writeU32(v: Long) {
        ensureCapacity(4)
        Memory.write(buf + bufPos, (v & 0xFF) as Byte)
        Memory.write(buf + bufPos + 1, ((v >> 8) & 0xFF) as Byte)
        Memory.write(buf + bufPos + 2, ((v >> 16) & 0xFF) as Byte)
        Memory.write(buf + bufPos + 3, ((v >> 24) & 0xFF) as Byte)
        bufPos = bufPos + 4
    }

    /// 写入 8 字节（小端）。
    fun writeU64(v: Long) {
        ensureCapacity(8)
        Memory.write(buf + bufPos, (v & 0xFF) as Byte)
        Memory.write(buf + bufPos + 1, ((v >> 8) & 0xFF) as Byte)
        Memory.write(buf + bufPos + 2, ((v >> 16) & 0xFF) as Byte)
        Memory.write(buf + bufPos + 3, ((v >> 24) & 0xFF) as Byte)
        Memory.write(buf + bufPos + 4, ((v >> 32) & 0xFF) as Byte)
        Memory.write(buf + bufPos + 5, ((v >> 40) & 0xFF) as Byte)
        Memory.write(buf + bufPos + 6, ((v >> 48) & 0xFF) as Byte)
        Memory.write(buf + bufPos + 7, ((v >> 56) & 0xFF) as Byte)
        bufPos = bufPos + 8
    }

    /// 写入字符串（带长度前缀）。
    fun writeStr(s: String) {
        writeU16(s.length)
        var i: Int = 0
        while (i < s.length) {
            writeByte(s.charCodeAt(i) as Byte)
            i = i + 1
        }
    }

    /// 写入原始字节。
    fun writeBytes(data: Long, len: Long) {
        ensureCapacity(len)
        Memory.copy(buf + bufPos, data, len)
        bufPos = bufPos + len
    }

    /// 写入浮点数（f64，小端）。
    fun writeF64(v: Float) {
        // 简化：将 Float 转为位模式写入
        val bits: Long = 0  // 实际实现需要 f64 位模式
        writeU64(bits)
    }

    /// 写入常量（带标签）。
    fun writeConst(tag: Int, value: String) {
        writeByte(tag as Byte)
        if (tag == AucConstants.CONST_INT) {
            writeU64(value.toLong())
        } else if (tag == AucConstants.CONST_FLOAT) {
            writeF64(value.toFloat())
        } else if (tag == AucConstants.CONST_STR) {
            writeU32(value.length)
            var i: Int = 0
            while (i < value.length) {
                writeByte(value.charCodeAt(i) as Byte)
                i = i + 1
            }
        } else if (tag == AucConstants.CONST_BOOL) {
            writeByte(value.toByte())
        }
        // NULL: 无额外数据
    }

    /// 写入文件。
    fun writeToFile(path: String): Boolean {
        val pathBuf: Long = stringToBuffer(path)
        if (pathBuf == 0) { return false }
        val fd: Int = FileOps.open(pathBuf, Syscalls.O_WRONLY | Syscalls.O_CREAT | Syscalls.O_TRUNC)
        Allocator.free(pathBuf)
        if (fd < 0) { return false }

        var written: Long = 0
        while (written < bufPos) {
            val n: Long = FileOps.write(fd, buf + written, bufPos - written)
            if (n <= 0) { break }
            written = written + n
        }
        FileOps.close(fd)
        return written == bufPos
    }

    /// 字符串转缓冲区。
    private fun stringToBuffer(s: String): Long {
        val len: Long = s.length + 1
        val buf: Long = Allocator.malloc(len)
        if (buf == 0) { return 0 }
        var i: Int = 0
        while (i < s.length) {
            Memory.write(buf + i, s.charCodeAt(i))
            i = i + 1
        }
        Memory.write(buf + s.length, 0)
        return buf
    }
}

/// 二进制读取器（小端）。
///
/// 必须是 **class**（而非 `object` 单例）：自举 AOT 下对 `object` 单例**可变字段**
/// 的写入会直接访问违规（实测 `--run-auc` 首行即崩）。状态（data/dataLen/pos）
/// 放在实例字段上，由调用方 `AucReader()` 创建。
class AucReader {

    /// 数据缓冲区。
    var data: Long = 0
    var dataLen: Long = 0
    var pos: Long = 0

    /// 从文件读取整个文件到内存（按块 read + 按需扩容，跨平台走 FileOps）。
    fun readFromFile(path: String): Boolean {
        data = readFileToBuffer(path)
        if (data == 0) { return false }
        pos = 0
        return true
    }

    /// 读取文件到缓冲区，返回地址（0 = 失败），长度写入 `dataLen`。
    private fun readFileToBuffer(path: String): Long {
        dataLen = 0
        val pathBuf: Long = stringToBuffer(path)
        if (pathBuf == 0) { return 0 }

        val fd: Int = FileOps.open(pathBuf, 0x8000)  // O_RDONLY | 二进制位（见 winCrtWrapper）
        Allocator.free(pathBuf)
        if (fd < 0) { return 0 }

        val chunk: Long = 65536
        var buf: Long = Allocator.malloc(chunk)
        if (buf == 0) {
            FileOps.close(fd)
            return 0
        }
        var cap: Long = chunk
        var total: Long = 0
        while (true) {
            if (total >= cap) {
                val ncap: Long = cap * 2
                val nbuf: Long = Allocator.malloc(ncap)
                if (nbuf == 0) { break }
                var k: Long = 0
                while (k < total) {
                    Memory.write(nbuf + k, Memory.read(buf + k))
                    k = k + 1
                }
                Allocator.free(buf)
                buf = nbuf
                cap = ncap
            }
            val n: Long = FileOps.read(fd, buf + total, cap - total)
            if (n <= 0) { break }
            total = total + n
        }
        FileOps.close(fd)
        if (total <= 0) {
            Allocator.free(buf)
            return 0
        }
        dataLen = total
        return buf
    }

    /// 释放。
    fun dispose() {
        if (data != 0) {
            Allocator.free(data)
            data = 0
        }
        dataLen = 0
        pos = 0
    }

    /// 读取 1 字节（**无符号** 0..255；EOF 返回 -1）。
    ///
    /// `Memory.read` 返回带符号 `Byte`，>=0x80 的字节会变成负数。若直接用，
    /// 串/常量解析里的 `if (c < 0) break` 会**提前中断**（字符串按长度消费的
    /// 字节数变少）→ 读指针失步，后续常量/原生/函数全部错位。
    /// 含 UTF-8（中文）的 `.auc` 必然触发（实测 `vm_core_test.auc` 解析到
    /// 函数数为 0）。
    fun readByte(): Int {
        if (pos >= dataLen) { return -1 }
        var v: Int = Memory.read(data + pos)
        pos = pos + 1
        if (v < 0) {
            v = v + 256
        }
        return v
    }

    /// 读取 2 字节（小端）。
    ///
    /// 必须经 `readByte()`（**无符号**）：直接用 `Memory.read` 时 `0xfe` 会变成
    /// -2，`lo | (hi << 8)` 得到负数 → `readU32` 的 `lo < 0` 提前返回，
    /// 一个 8 字节整数只消费 2 字节（实测含负整数的 `.auc` 常量区立即失步）。
    /// 移位必须用符号形式 `<<`（单词 `shl` 在自举 AOT 下被静默丢弃）。
    fun readU16(): Int {
        val lo: Int = readByte()
        if (lo < 0) { return -1 }
        val hi: Int = readByte()
        if (hi < 0) { return -1 }
        return lo | (hi << 8)
    }

    /// 读取 4 字节并解释为**有符号** Int（小端）。
    fun readI32(): Int {
        val b0: Int = readByte()
        val b1: Int = readByte()
        val b2: Int = readByte()
        val b3: Int = readByte()
        return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
    }

    /// 读取 4 字节（小端）。
    ///
    /// 用「先 `as Long` 再 `<<`」而不是逐字节 `.toLong()`：自举 AOT 下
    /// `Int.toLong()` 不可靠（实测在 `readU32` 内直接访问违规）。
    fun readU32(): Long {
        val lo: Int = readU16()
        if (lo < 0) { return -1 }
        val hi: Int = readU16()
        if (hi < 0) { return -1 }
        return (lo as Long) | (((hi as Long) << 16))
    }

    /// 读取 8 字节（小端）。
    fun readU64(): Long {
        val lo: Long = readU32()
        if (lo < 0) { return -1 }
        val hi: Long = readU32()
        if (hi < 0) { return -1 }
        return lo | (hi << 32)
    }

    /// 读取字符串（带长度前缀）。
    fun readStr(): String {
        val len: Int = readU16()
        if (len < 0) { return "" }
        var result: String = ""
        var i: Int = 0
        while (i < len) {
            val c: Int = readByte()
            if (c < 0) { break }
            result = result + String.fromCharCode(c)
            i = i + 1
        }
        return result
    }

    /// 跳过字节。
    fun skip(n: Long) {
        pos = pos + n
    }

    /// 字符串转缓冲区。
    private fun stringToBuffer(s: String): Long {
        val len: Long = s.length + 1
        val buf: Long = Allocator.malloc(len)
        if (buf == 0) { return 0 }
        var i: Int = 0
        while (i < s.length) {
            Memory.write(buf + i, s.charCodeAt(i))
            i = i + 1
        }
        Memory.write(buf + s.length, 0)
        return buf
    }
}
