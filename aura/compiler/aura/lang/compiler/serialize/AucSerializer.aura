// aura:///aura/lang/compiler/serialize/AucSerializer.aura
package aura.lang.compiler.serialize
// ─────────────────────────────────────────────────────────────
// .auc 二进制序列化 / 反序列化 — Phase S2
//
// 对应 Rust `compiler/src/codegen/serialize.rs`。
//
// .auc 文件布局（小端）：
//   "AURA" | u16 version | u32 header_flags |
//   u16 module_name_len | module_name |
//   u16 module_version_len | module_version |
//   u8[16] uuid |
//   u32 consts_count | consts |
//   u16 natives_count | natives |
//   u16 funcs_count | funcs |
//   u16 entry |
//   u16 entry_kind_len | entry_kind |
//   u16 exports_count | exports |
//   u16 imports_count | imports |
//   u16 deps_count | deps |
//   u16 sig_ids_count | sig_ids |
// ─────────────────────────────────────────────────────────────

import aura.lang.native.Memory
import aura.lang.native.memory.Allocator
import aura.lang.native.file.FileOps
import aura.lang.native.Syscalls
import aura.lang.std.String
import aura.lang.std.FileSystem

/// .auc 格式常量。
object AucConstants {

    /// 魔数。
    const val MAGIC: String = "AURA"

    /// 当前格式版本。
    const val VERSION: Int = 7

    /// 常量标签。
    const val CONST_INT: Int = 0
    const val CONST_FLOAT: Int = 1
    const val CONST_STR: Int = 2
    const val CONST_BOOL: Int = 3
    const val CONST_NULL: Int = 4

    /// 段 id。
    const val SEG_BYTECODE: Int = 0
    const val SEG_MACHINE: Int = 1
    const val SEG_DESC_TABLE: Int = 2
    const val SEG_DEBUG: Int = 3
    const val SEG_STRING_POOL: Int = 4
    const val SEG_SIGNATURE: Int = 5

    /// 段标志。
    const val SEG_PROT_READ: Int = 1
    const val SEG_PROT_WRITE: Int = 2
    const val SEG_PROT_EXEC: Int = 4
    const val SEG_READONLY: Int = 8
}

/// 二进制写入器（小端）。
object AucWriter {

    /// 内部缓冲区。
    var buf: Long = 0
    var bufSize: Long = 65536
    var bufPos: Long = 0

    /// 初始化。
    fun init(): Boolean {
        buf = Allocator.malloc(bufSize)
        return buf != 0
    }

    /// 释放缓冲区。
    fun dispose() {
        if (buf != 0) {
            Allocator.free(buf)
            buf = 0
        }
        bufPos = 0
    }

    /// 确保容量。
    fun ensureCapacity(additional: Long) {
        if (bufPos + additional > bufSize) {
            val newSize: Long = bufSize * 2
            while (bufPos + additional > newSize) {
                newSize = newSize * 2
            }
            val newBuf: Long = Allocator.malloc(newSize)
            if (newBuf == 0) { return }
            Memory.copy(newBuf, buf, bufPos)
            Allocator.free(buf)
            buf = newBuf
            bufSize = newSize
        }
    }

    /// 写入 1 字节。
    fun writeByte(v: Byte) {
        ensureCapacity(1)
        Memory.write(buf + bufPos, v)
        bufPos = bufPos + 1
    }

    /// 写入 2 字节（小端）。
    fun writeU16(v: Int) {
        ensureCapacity(2)
        Memory.write(buf + bufPos, (v and 0xFF) as Byte)
        Memory.write(buf + bufPos + 1, ((v shr 8) and 0xFF) as Byte)
        bufPos = bufPos + 2
    }

    /// 写入 4 字节（小端）。
    fun writeU32(v: Long) {
        ensureCapacity(4)
        Memory.write(buf + bufPos, (v and 0xFF) as Byte)
        Memory.write(buf + bufPos + 1, ((v shr 8) and 0xFF) as Byte)
        Memory.write(buf + bufPos + 2, ((v shr 16) and 0xFF) as Byte)
        Memory.write(buf + bufPos + 3, ((v shr 24) and 0xFF) as Byte)
        bufPos = bufPos + 4
    }

    /// 写入 8 字节（小端）。
    fun writeU64(v: Long) {
        ensureCapacity(8)
        Memory.write(buf + bufPos, (v and 0xFF) as Byte)
        Memory.write(buf + bufPos + 1, ((v shr 8) and 0xFF) as Byte)
        Memory.write(buf + bufPos + 2, ((v shr 16) and 0xFF) as Byte)
        Memory.write(buf + bufPos + 3, ((v shr 24) and 0xFF) as Byte)
        Memory.write(buf + bufPos + 4, ((v shr 32) and 0xFF) as Byte)
        Memory.write(buf + bufPos + 5, ((v shr 40) and 0xFF) as Byte)
        Memory.write(buf + bufPos + 6, ((v shr 48) and 0xFF) as Byte)
        Memory.write(buf + bufPos + 7, ((v shr 56) and 0xFF) as Byte)
        bufPos = bufPos + 8
    }

    /// 写入字符串（带长度前缀）。
    fun writeStr(s: String) {
        writeU16(s.length)
        var i: Int = 0
        while (i < s.length) {
            writeByte(s.charCodeAt(i) as Byte)
            i = i + 1
        }
    }

    /// 写入原始字节。
    fun writeBytes(data: Long, len: Long) {
        ensureCapacity(len)
        Memory.copy(buf + bufPos, data, len)
        bufPos = bufPos + len
    }

    /// 写入浮点数（f64，小端）。
    fun writeF64(v: Float) {
        // 简化：将 Float 转为位模式写入
        val bits: Long = 0  // 实际实现需要 f64 位模式
        writeU64(bits)
    }

    /// 写入常量（带标签）。
    fun writeConst(tag: Int, value: String) {
        writeByte(tag as Byte)
        if (tag == AucConstants.CONST_INT) {
            writeU64(value.toLong())
        } else if (tag == AucConstants.CONST_FLOAT) {
            writeF64(value.toFloat())
        } else if (tag == AucConstants.CONST_STR) {
            writeU32(value.length)
            var i: Int = 0
            while (i < value.length) {
                writeByte(value.charCodeAt(i) as Byte)
                i = i + 1
            }
        } else if (tag == AucConstants.CONST_BOOL) {
            writeByte(value.toByte())
        }
        // NULL: 无额外数据
    }

    /// 写入文件。
    fun writeToFile(path: String): Boolean {
        val pathBuf: Long = stringToBuffer(path)
        if (pathBuf == 0) { return false }
        val fd: Int = FileOps.open(pathBuf, Syscalls.O_WRONLY | Syscalls.O_CREAT | Syscalls.O_TRUNC)
        Allocator.free(pathBuf)
        if (fd < 0) { return false }

        var written: Long = 0
        while (written < bufPos) {
            val n: Long = FileOps.write(fd, buf + written, bufPos - written)
            if (n <= 0) { break }
            written = written + n
        }
        FileOps.close(fd)
        return written == bufPos
    }

    /// 字符串转缓冲区。
    private fun stringToBuffer(s: String): Long {
        val len: Long = s.length + 1
        val buf: Long = Allocator.malloc(len)
        if (buf == 0) { return 0 }
        var i: Int = 0
        while (i < s.length) {
            Memory.write(buf + i, s.charCodeAt(i))
            i = i + 1
        }
        Memory.write(buf + s.length, 0)
        return buf
    }
}

/// 二进制读取器（小端）。
object AucReader {

    /// 数据缓冲区。
    var data: Long = 0
    var dataLen: Long = 0
    var pos: Long = 0

    /// 从文件读取。
    fun readFromFile(path: String): Boolean {
        val pathBuf: Long = stringToBuffer(path)
        if (pathBuf == 0) { return false }
        val fd: Int = FileOps.open(pathBuf, Syscalls.O_RDONLY)
        Allocator.free(pathBuf)
        if (fd < 0) { return false }

        val size: Long = FileOps.lseek(fd, 0, Syscalls.SEEK_END)
        FileOps.lseek(fd, 0, Syscalls.SEEK_SET)
        if (size <= 0) {
            FileOps.close(fd)
            return false
        }

        data = Allocator.malloc(size)
        if (data == 0) {
            FileOps.close(fd)
            return false
        }

        val bytesRead: Long = FileOps.read(fd, data, size)
        FileOps.close(fd)
        if (bytesRead <= 0) {
            Allocator.free(data)
            return false
        }

        dataLen = bytesRead
        pos = 0
        return true
    }

    /// 释放。
    fun dispose() {
        if (data != 0) {
            Allocator.free(data)
            data = 0
        }
        dataLen = 0
        pos = 0
    }

    /// 读取 1 字节。
    fun readByte(): Int {
        if (pos >= dataLen) { return -1 }
        val v: Int = Memory.read(data + pos)
        pos = pos + 1
        return v
    }

    /// 读取 2 字节（小端）。
    fun readU16(): Int {
        if (pos + 2 > dataLen) { return -1 }
        val lo: Int = Memory.read(data + pos)
        val hi: Int = Memory.read(data + pos + 1)
        pos = pos + 2
        return lo | (hi shl 8)
    }

    /// 读取 4 字节（小端）。
    fun readU32(): Long {
        if (pos + 4 > dataLen) { return -1 }
        val b0: Int = Memory.read(data + pos)
        val b1: Int = Memory.read(data + pos + 1)
        val b2: Int = Memory.read(data + pos + 2)
        val b3: Int = Memory.read(data + pos + 3)
        pos = pos + 4
        return b0.toLong() | (b1.toLong() shl 8) | (b2.toLong() shl 16) | (b3.toLong() shl 24)
    }

    /// 读取 8 字节（小端）。
    fun readU64(): Long {
        if (pos + 8 > dataLen) { return -1 }
        val b0: Int = Memory.read(data + pos)
        val b1: Int = Memory.read(data + pos + 1)
        val b2: Int = Memory.read(data + pos + 2)
        val b3: Int = Memory.read(data + pos + 3)
        val b4: Int = Memory.read(data + pos + 4)
        val b5: Int = Memory.read(data + pos + 5)
        val b6: Int = Memory.read(data + pos + 6)
        val b7: Int = Memory.read(data + pos + 7)
        pos = pos + 8
        return b0.toLong() | (b1.toLong() shl 8) | (b2.toLong() shl 16) | (b3.toLong() shl 24)
            | (b4.toLong() shl 32) | (b5.toLong() shl 40) | (b6.toLong() shl 48) | (b7.toLong() shl 56)
    }

    /// 读取字符串（带长度前缀）。
    fun readStr(): String {
        val len: Int = readU16()
        if (len < 0) { return "" }
        var result: String = ""
        var i: Int = 0
        while (i < len) {
            val c: Int = readByte()
            if (c < 0) { break }
            result = result + String.fromCharCode(c)
            i = i + 1
        }
        return result
    }

    /// 跳过字节。
    fun skip(n: Long) {
        pos = pos + n
    }

    /// 字符串转缓冲区。
    private fun stringToBuffer(s: String): Long {
        val len: Long = s.length + 1
        val buf: Long = Allocator.malloc(len)
        if (buf == 0) { return 0 }
        var i: Int = 0
        while (i < s.length) {
            Memory.write(buf + i, s.charCodeAt(i))
            i = i + 1
        }
        Memory.write(buf + s.length, 0)
        return buf
    }
}
