// aura:///aura/lang/compiler/serialize/AucLoader.aura
package aura.lang.compiler.serialize
// ─────────────────────────────────────────────────────────────
// .auc 模块加载器 — Phase S2
//
// 从 .auc 二进制文件解析模块结构，提取字节码供 VM 执行。
//
// 对应 Rust `compiler/src/codegen/serialize.rs::read_auc`。
// ─────────────────────────────────────────────────────────────

import aura.lang.native.Memory
import aura.lang.native.memory.Allocator
import aura.lang.native.file.FileOps
import aura.lang.native.Syscalls
import aura.lang.std.String
import aura.lang.std.fs.FileUtils
import aura.lang.compiler.serialize.AucSerializer

/// 加载后的模块信息。
class AucModule {
    var name: String = ""
    var version: String = ""
    var headerFlags: Long = 0
    var constsCount: Int = 0
    var nativesCount: Int = 0
    var funcsCount: Int = 0
    var entry: Int = 0
    var entryKind: String = ""
    var exportsCount: Int = 0
    var importsCount: Int = 0
    var depsCount: Int = 0
    var sigIdsCount: Int = 0
    /// 字节码（文本格式，每行一条指令）。
    var bytecode: String = ""
    /// 常量池。
    var constPool: String = ""
    /// 文本函数表（每行 `name|起始行|参数个数`）。
    ///
    /// 注意：**必须显式声明**——此前缺该字段，`mod.funcTable = ...` 的赋值被
    /// 静默丢弃（读取侧 `mod.funcTable` 解析到别的东西），VM 因此拿不到函数表，
    /// 入口/调用目标全部解析失败。
    var funcTable: String = ""
    /// 导出表（每行 `name|funcIdx`）。
    var exports: String = ""
    /// 导入表（每行 `name|module|symbol|funcIdx`）。
    var imports: String = ""
    /// 错误信息。
    var error: String = ""

    // ── P2.2：完整区段解析 + 数值化字节码（取消文本翻译层）──

    /// 数值模式标志：true 时 `numOpNames`/`numArgs` 为权威字节码表示，
    /// `bytecode` 文本不再生成（二进制 → 结构化指令数组，无文本中间层）。
    var numericMode: Boolean = false
    /// 每条指令的助记符（Aura VM 命名，经 VM 侧 `Opcodes.fromName` 数值化）。
    var numOpNames: List<String> = arrayListOf<String>()
    /// 每条指令的操作数（加载期已解析：函数名/常量下标/全局行号）。
    var numArgs: List<List<String>> = arrayListOf<List<String>>()
    /// 显式依赖表（每行 `module|version`）。
    var deps: String = ""
    /// 外部模块签名 ID（每行一个）。
    var sigIds: String = ""
    /// 启用的 std 模块（每行一个）。
    var enabledModules: String = ""
    /// 虚方法槽位 → 方法名（`CALL_METHOD` 槽位操作数的解析表）。
    var slotMethodNames: List<String> = arrayListOf<String>()
    /// 类定义表：类名（下标 = 类 ID，与 Rust `class_id_map` 一致）。
    var classNames: List<String> = arrayListOf<String>()
    /// 类定义表：父类 ID（-1 = 无父类；Rust 端 0 = Any 且无自环）。
    var classParentIds: List<Int> = arrayListOf<Int>()
    /// 类字段名表（每类一行，逗号分隔；仅供诊断）。
    var classFieldNames: String = ""
    /// AOT 段数量（段数据不再解析——随 Photon 任务）。
    var aotSegmentCount: Int = 0

    fun isValid(): Boolean {
        return error == "" && funcsCount > 0
    }

    fun describe(): String {
        var desc: String = "AucModule {"
        desc = desc + "name=" + name
        desc = desc + ", version=" + version
        desc = desc + ", funcs=" + funcsCount
        desc = desc + ", consts=" + constsCount
        desc = desc + ", entry=" + entry
        if (error != "") {
            desc = desc + ", error=" + error
        }
        desc = desc + "}"
        return desc
    }
}

/// .auc 加载器。
object AucLoaderUtils {

    /// 从文件加载 .auc 模块。
    fun loadModule(path: String): AucModule {
        val mod: AucModule = AucModule()

        val reader: AucReader = AucReader()
        if (!reader.readFromFile(path)) {
            mod.error = "cannot read file: " + path
            return mod
        }

        // 1. 魔数
        val magic: String = readMagic(reader)
        if (!isAuraMagic(magic)) {
            mod.error = "bad magic: " + magic
            reader.dispose()
            return mod
        }

        // 2. 版本
        //
        // 用**字面量** 7 而不是 `AucConstants.VERSION`：自举 AOT 下 `object`
        // 里的 `const val` 未被内联，运行期读该对象字段会取到不可靠的值
        //（实测 `AucConstants.VERSION` 读出来 ≠ 7，导致合法文件被判为不支持版本）。
        val SUPPORTED_VERSION: Int = 7
        val version: Int = reader.readU16()
        if (version < 0 || version > SUPPORTED_VERSION) {
            mod.error = "unsupported version: " + version
            reader.dispose()
            return mod
        }

        // 3. 头部标志
        val tmpFlags: Long = reader.readU32()
        mod.headerFlags = tmpFlags

        // 4. 模块标识
        mod.name = reader.readStr()
        mod.version = reader.readStr()
        reader.skip(16)  // UUID

        // 5. 常量池（不含标签，VM 从操作码推断类型）
        // 用 `as Int` 而不是 `.toInt()`（Long.toInt() 在自举 AOT 下同 `Int.toLong()` 一样不可靠）
        val constsCountL: Long = reader.readU32()
        mod.constsCount = constsCountL as Int
        // 常量**类型标签**要单独记录：`.auc` 里 `LoadConst` 是类型无关的单操作码
        //（整数/字符串/布尔共用 0），而文本字节码的 `CONST_INT`/`CONST_STRING`
        // 是有类型的 —— 加载期按标签把它翻译成对应的类型化助记符。
        val constTags: List<Int> = arrayListOf<Int>()
        var ci: Int = 0
        while (ci < mod.constsCount) {
            val tag: Int = reader.readByte()
            constTags.add(tag)
            val value: String = readConstValue(reader, tag)
            if (mod.constsCount <= 12) {
            }
            if (mod.constPool != "") {
                mod.constPool = mod.constPool + "\n"
            }
            mod.constPool = mod.constPool + value
            ci = ci + 1
        }

        // 6. Native 函数（布局对齐 Rust `to_bytes`）：
        //    write_str(name) + u16 param_count + u8 ffi_abi
        //    + u8 has_ffi_lib (+ write_str(lib) 当且仅当 1)
        //    + u16 param_types_len + param_types(u8 each) + u8 ret_type
        mod.nativesCount = reader.readU16()
        // 原生函数名/参数个数（下标与 `CALL_NATIVE(_ARGS)` 的操作数一致）：
        // 字节码里的操作数是**下标**，但 VM 的内建分派按**名字**调用
        //（`callOrBuiltin(name, argc)`），故加载期先把名字解析出来。
        val nativeNames: List<String> = arrayListOf<String>()
        val nativeParams: List<Int> = arrayListOf<Int>()
        var ni: Int = 0
        while (ni < mod.nativesCount) {
            val nname: String = reader.readStr()              // name
            val nparams: Int = reader.readU16()               // param_count
            nativeNames.add(nname)
            nativeParams.add(nparams)
            reader.readByte()             // ffi_abi
            val hasLib: Int = reader.readByte()
            if (hasLib == 1) {
                reader.readStr()          // ffi_lib
            }
            val ptCount: Int = reader.readU16()
            var pi: Int = 0
            while (pi < ptCount) {
                reader.readByte()         // param type
                pi = pi + 1
            }
            reader.readByte()             // ret_type
            ni = ni + 1
        }

        // 7. 函数（两遍扫描：P2.2 取消文本翻译）
        //
        // 第 1 遍：只读函数头（name/params/locals/aot 标记/codeLen），记录代码段
        //   起始位置；此时不解码 —— 因为 `CALL <函数下标>` 要解析成函数名，而
        //   被调函数可能定义在后面（前向引用），且 `CALL_METHOD <槽位>` 的解析
        //   需要 vtable（位于文件更后）。
        // 第 2 遍：读取 entry/exports/imports/deps/sigIds/enabledModules/
        //   vtables/classes/sourceIndex/aotSegments 之后，回跳到各函数代码段
        //   逐一数值化解码（`numOpNames`/`numArgs`，无文本中间层）。
        mod.funcsCount = reader.readU16()
        // 合理性校验：函数数为 0 / 异常巨大说明前面某段（常量或原生）消费字节数
        // 与写入端不一致，读指针已失步。早失败并带上下文，胜过继续读出垃圾。
        if (mod.funcsCount <= 0 || mod.funcsCount > 4096) {
            mod.error = "misaligned function table (consts=" + toStr(mod.constsCount)
                + " natives=" + toStr(mod.nativesCount) + " funcs=" + toStr(mod.funcsCount) + ")"
            reader.dispose()
            return mod
        }
        val funcNames: List<String> = arrayListOf<String>()
        val funcParams: List<Int> = arrayListOf<Int>()
        val codeStarts: List<Long> = arrayListOf<Long>()
        val codeLens: List<Int> = arrayListOf<Int>()
        var fi: Int = 0
        while (fi < mod.funcsCount) {
            val fname: String = reader.readStr()
            val params: Int = reader.readU16()
            val locals: Int = reader.readU16()
            // Rust `to_bytes`：u8 is_native + u8 aot_mode + **u32** aot_desc_idx
            reader.readByte()             // is_native
            reader.readByte()             // aot_mode
            reader.readU32()              // aot_desc_idx（u32）
            val codeLenL: Long = reader.readU32()
            val codeLen: Int = codeLenL as Int
            funcNames.add(fname)
            funcParams.add(params)
            codeStarts.add(reader.pos)
            codeLens.add(codeLen)
            reader.skip(codeLen as Long)
            fi = fi + 1
        }

        // 8. 入口点（可选解析；VM 走 `funcOffset("main")`，不依赖该字段）
        mod.entry = reader.readU16()
        mod.entryKind = reader.readStr()

        // 9. 导出符号表（CALL_EXPORT 解析需要）
        //    格式：u16 count, 每条: name(str) + kind(u8) + sig_id(str)
        //          + has_func_idx(u8) + func_idx(u16)? + type_table_idx(u16) + const_idx(u16)
        val nExportsL: Long = reader.readU16()
        val nExports: Int = nExportsL as Int
        var ei: Int = 0
        while (ei < nExports) {
            val expName: String = reader.readStr()
            reader.readByte()             // kind
            reader.readStr()              // sig_id
            val hasFunc: Int = reader.readByte()
            val expFuncIdx: Int = 0
            if (hasFunc != 0) {
                val fiL: Long = reader.readU16()
                expFuncIdx = fiL as Int
            }
            reader.readU16()              // type_table_idx
            reader.readU16()              // const_idx
            mod.exports = mod.exports + expName + "|" + toStr(expFuncIdx) + "\n"
            ei = ei + 1
        }

        // 10. 导入符号表（CALL_EXTERNAL 解析需要）
        //     格式：u16 count, 每条: name(str) + kind(u8) + module(str)
        //           + symbol(str) + sig_id(str) + func_idx(u16)
        val nImportsL: Long = reader.readU16()
        val nImports: Int = nImportsL as Int
        var ii: Int = 0
        while (ii < nImports) {
            val impName: String = reader.readStr()
            reader.readByte()             // kind
            val impModule: String = reader.readStr()
            val impSymbol: String = reader.readStr()
            reader.readStr()              // sig_id
            val impFuncIdxL: Long = reader.readU16()
            val impFuncIdx: Int = impFuncIdxL as Int
            mod.imports = mod.imports + impName + "|" + impModule + "|"
                + impSymbol + "|" + toStr(impFuncIdx) + "\n"
            ii = ii + 1
        }

        // 11. 显式依赖表（P2.2a：此前跳过）
        //     u16 count, 每条: module(str) + uuid(16) + version(str)
        val nDepsL: Long = reader.readU16()
        var di: Int = 0
        while (di < (nDepsL as Int)) {
            val depModule: String = reader.readStr()
            reader.skip(16)               // uuid
            val depVersion: String = reader.readStr()
            mod.deps = mod.deps + depModule + "|" + depVersion + "\n"
            di = di + 1
        }

        // 12. 外部模块签名 ID（P2.2a）
        val nSigsL: Long = reader.readU16()
        var si2: Int = 0
        while (si2 < (nSigsL as Int)) {
            mod.sigIds = mod.sigIds + reader.readStr() + "\n"
            si2 = si2 + 1
        }

        // 13. 启用的 std 模块（P2.2a）
        val nModsL: Long = reader.readU16()
        var mi2: Int = 0
        while (mi2 < (nModsL as Int)) {
            mod.enabledModules = mod.enabledModules + reader.readStr() + "\n"
            mi2 = mi2 + 1
        }

        // 14. v5: 虚方法表（P2.2a/P2.2c）
        //     u16 count, 每表: type_tag(u16) + u16 nslots + nslots × u16(func_idx)
        //     槽位 → 方法名的解析表：取任一非空槽的函数名（"Class.method"）
        //     的方法名部分；覆写只改函数、不改槽位语义，故任取即安全。
        val noMethodSentinel: Int = 65535
        var slotNames: List<String> = arrayListOf<String>()
        if (version >= 5 && reader.pos < reader.dataLen) {
            val nVtL: Long = reader.readU16()
            var vi: Int = 0
            while (vi < (nVtL as Int)) {
                reader.readU16()          // type_tag
                val nSlotsL: Long = reader.readU16()
                val nSlots: Int = nSlotsL as Int
                var sj: Int = 0
                while (sj < nSlots) {
                    val fidxL: Long = reader.readU16()
                    val fidx: Int = fidxL as Int
                    if (fidx != noMethodSentinel) {
                        // 扩容 slotNames 到 sj+1
                        while (slotNames.size() <= sj) {
                            slotNames.add("")
                        }
                        if (slotNames.get(sj) == "") {
                            val mname: String = methodNameOf(nameAt(funcNames, fidx))
                            slotNames.set(sj, mname)
                        }
                    }
                    sj = sj + 1
                }
                vi = vi + 1
            }
        }
        mod.slotMethodNames = slotNames

        // 15. v6: 类定义表（P2.2a/P2.2c）
        //     仅当 version >= 6 且 headerFlags 含 HEADER_HAS_CLASS_DEFS(1<<4=16)
        //     u16 count, 每类: name(str) + parent_id(u16) + field_count(u16)
        //       + vtable_idx(u16) + interfaces(u16 count + u16 each)
        //       + is_builtin(u8) + is_singleton(u8) + field_names(u16 count + str each)
        val hasClassDefs: Boolean = hasHeaderFlag(mod.headerFlags, 16)
        if (version >= 6 && hasClassDefs && reader.pos < reader.dataLen) {
            val nClsL: Long = reader.readU16()
            var ci2: Int = 0
            while (ci2 < (nClsL as Int)) {
                mod.classNames.add(reader.readStr())
                mod.classParentIds.add(reader.readU16() as Int)
                reader.readU16()          // field_count
                reader.readU16()          // vtable_idx
                val nIfL: Long = reader.readU16()
                var ii2: Int = 0
                while (ii2 < (nIfL as Int)) {
                    reader.readU16()      // interface id
                    ii2 = ii2 + 1
                }
                reader.readByte()         // is_builtin
                reader.readByte()         // is_singleton
                val nFnL: Long = reader.readU16()
                var fnLine: String = ""
                var fi2: Int = 0
                while (fi2 < (nFnL as Int)) {
                    if (fnLine != "") { fnLine = fnLine + "," }
                    fnLine = fnLine + reader.readStr()
                    fi2 = fi2 + 1
                }
                mod.classFieldNames = mod.classFieldNames + fnLine + "\n"
                ci2 = ci2 + 1
            }
        }

        // 16. v6: 源码索引段（LSP 专用，跳过其字节）
        val hasSourceIndex: Boolean = hasHeaderFlag(mod.headerFlags, 32)
        if (version >= 6 && hasSourceIndex && reader.pos < reader.dataLen) {
            val jsonLen: Long = reader.readU32()
            reader.skip(jsonLen)
        }

        // 17. v4: AOT 段表 + 段数据区（P2.2a：解析段表，段数据随 Photon 任务）
        if (version >= 4 && reader.pos < reader.dataLen) {
            val nSegL: Long = reader.readU16()
            mod.aotSegmentCount = nSegL as Int
            var gi: Int = 0
            while (gi < mod.aotSegmentCount) {
                reader.readU32()          // id
                reader.readU32()          // offset
                reader.readU32()          // size
                reader.readU32()          // flags
                gi = gi + 1
            }
            // 段数据区（剩余字节）不再消费——随 Photon 任务
        }

        // ═══ 第 2 遍：数值化解码（P2.2b，取消文本翻译层）═══
        mod.numericMode = true
        var lineNo2: Int = 0
        var startLines: List<Int> = arrayListOf<Int>()
        var fi3: Int = 0
        while (fi3 < mod.funcsCount) {
            startLines.add(lineNo2)
            reader.pos = codeStarts.get(fi3)
            val decoded: Int = decodeNumeric(reader, codeLens.get(fi3), nativeNames,
                nativeParams, constTags, funcNames, funcParams, mod.slotMethodNames,
                mod.classNames, lineNo2, mod)
            lineNo2 = lineNo2 + decoded
            fi3 = fi3 + 1
        }
        // 函数表：起始行 = 指令下标（无数值注释占位行）
        var fi4: Int = 0
        while (fi4 < mod.funcsCount) {
            mod.funcTable = mod.funcTable + funcNames.get(fi4) + "|"
                + toStr(startLines.get(fi4)) + "|" + toStr(funcParams.get(fi4)) + "\n"
            fi4 = fi4 + 1
        }

        reader.dispose()
        return mod
    }

    /// headerFlags 位检测（避免跨包位运算依赖：正整数用除法/取模实现）。
    private fun hasHeaderFlag(flags: Long, bit: Int): Boolean {
        if (flags < 0 || bit <= 0) { return false }
        val f: Long = flags
        val b: Long = bit as Long
        return ((f / b) % 2L) == 1L
    }

    /// 文件读取的安全终点（AucReader 越界读返回 -1/0，这里防御性判断）。
    private fun endOfModules(reader: AucReader): Long {
        return reader.dataLen
    }

    /// 从 "Class.method" 形态的函数名提取方法名部分（无点号返回原名）。
    private fun methodNameOf(funcName: String): String {
        var i: Int = funcName.length - 1
        while (i >= 0) {
            if (funcName.charCodeAt(i) == 46) {  // '.'
                return funcName.substring(i + 1, funcName.length)
            }
            i = i - 1
        }
        return funcName
    }

    /// 读取魔数。
    private fun readMagic(reader: AucReader): String {
        var result: String = ""
        var i: Int = 0
        while (i < 4) {
            val c: Int = reader.readByte()
            if (c < 0) { break }
            result = result + String.fromCharCode(c)
            i = i + 1
        }
        return result
    }

    /// 校验魔数是否为 "AURA"（按**字符码**比较）。
    ///
    /// 不用 `magic == AucConstants.MAGIC`：Aura AOT 下字符串字面量比较会走
    /// 指针比较路径，且 `object` 常量取值不稳定；按字符码逐个比较与
    /// 字符串内容比较的实现细节无关，最稳。
    private fun isAuraMagic(magic: String): Boolean {
        if (magic == null) { return false }
        if (magic.length != 4) { return false }
        if (magic.charCodeAt(0) != 65) { return false }  // 'A'
        if (magic.charCodeAt(1) != 85) { return false }  // 'U'
        if (magic.charCodeAt(2) != 82) { return false }  // 'R'
        if (magic.charCodeAt(3) != 65) { return false }  // 'A'
        return true
    }

    /// 读取常量值。
    private fun readConstValue(reader: AucReader, tag: Int): String {
        // 常量标签用字面量（同版本号：object 的 const val 在自举 AOT 下不可靠）
        if (tag == 0) {  // CONST_INT（i64）
            // 逐 32 位读取：写端是 `i64`，但字节码语义是 32 位 Int。
            // 高 32 位为 0（正）或 -1（负数）时，低 32 位的有符号值即真值
            //（实测 `-2` 若按无符号 Long 输出会变成 18446744073709551614）。
            val low: Int = reader.readI32()
            val high: Int = reader.readI32()
            if (high == 0 || high == -1) {
                return toStr(low)
            }
            return toStr(low)
        } else if (tag == 1) {  // CONST_FLOAT：IEEE-754 位模式 → 文本化
            // P2.2 修复：原实现 skip(8) 并桩返回 "0.0" —— 一切浮点常量在
            // Aura VM 上变成 0.0（实测差分用例 2.5*2.0 → 0.0）。
            //
            // 位模式 → 值采用**纯 Aura 拆位**实现（符号/指数/尾数 + pow 缩放）：
            // 宿主对外部接口的 Long 传参存在不可靠失真（实测
            // FloatOps.fromBits(2.5 的位模式) → 3.5），不能依赖新原生。
            // 常量按 f32 精度还原（Aura Float 为 32 位）——高位宽常量会
            // 舍入，已在 ADR 记录为已知限制。
            //
            // P4.1（AOT 基底适配）：位模式改为逐字节构造。自举 AOT 下
            // readU64 的 `(hi as Long) << 32` 路径不可靠（`as Long` 失真），
            // 而标量 Long 的乘加在双基底均可靠（探针实测 2^52 精确）。
            // 写端是小端：首字节为最低位，故按 b7..b0 逆序乘累加
            //（v1 把首字节累到最高位，5.0 被读成 0x1440 → 0.0，差分当场抓住）。
            val b0: Int = reader.readByte()
            val b1: Int = reader.readByte()
            val b2: Int = reader.readByte()
            val b3: Int = reader.readByte()
            val b4: Int = reader.readByte()
            val b5: Int = reader.readByte()
            val b6: Int = reader.readByte()
            val b7: Int = reader.readByte()
            var bits: Long = b7
            bits = bits * 256 + b6
            bits = bits * 256 + b5
            bits = bits * 256 + b4
            bits = bits * 256 + b3
            bits = bits * 256 + b2
            bits = bits * 256 + b1
            bits = bits * 256 + b0
            return f64BitsToText(bits)
        } else if (tag == 2) {  // CONST_STR
            // P4.1（AOT 基底适配）：长度改为两次 readU16 的组合。
            // 原实现 readU32 → `as Long` 在自举 AOT 下失真成巨值 → 常量区
            // 被吃穿到 EOF（实测 helloworld.auc consts=52 后 natives/funcs=-1）。
            // 组合用**乘法**（`lenHi * 65536`）而不是 `<< 16`：自举 AOT 下
            // Int 移位失真（实测 lenHi=0 时 `<<16` 产出巨值 → 吃穿到 EOF；
            // Long 移位与 Int 乘法均可靠，见 readU32 与 list_probe 探针）。
            // 串长实际 < 65536，读两个 u16 与写端 u32 字节序兼容。
            val lenLo: Int = reader.readU16()
            val lenHi: Int = reader.readU16()
            var i: Int = 0
            val len: Int = lenLo + lenHi * 65536
            var result: String = ""
            while (i < len) {
                val c: Int = reader.readByte()
                if (c < 0) { break }
                result = result + String.fromCharCode(c)
                i = i + 1
            }
            return result
        } else if (tag == 3) {  // CONST_BOOL
            val v: Int = reader.readByte()
            return toStr(v)
        }
        // NULL: 无数据
        return "null"
    }

    /// 读取字节码（正确解析变长指令，转换为文本格式）。
    ///
    /// 关键翻译（Rust `.auc` → 本项目的文本字节码）：
    /// 1. **常量**：`.auc` 的 `LoadConst(0)` 是类型无关的（常量池自带标签），
    ///    这里按标签发射 `LOAD_CONST_I/_F/_S/_B/_N`，否则字符串常量会被当成
    ///    整数（`"10+3="` → 0），字符串拼接随之退化成数字加法。
    /// 2. **跳转**：`.auc` 的操作数是**函数内字节偏移**，而文本字节码的跳转
    ///    目标是**全局行号**。翻译方式：把原字节（`codeLen` 字节）重新逐条
    ///    走一遍，数出目标偏移处的指令下标。**刻意不使用任何临时容器**：
    ///    自举 AOT 下局部 `List<String>` 的 add/get 往返会把元素读成 `0`
    ///（实测 size 正确但每个元素都是 "0"），`HashMap<Int,...>` 亦不敢依赖。
    /// 3. **原生调用**（27/78）的下标 → 名字，复用 VM 内建分派。
    private fun readBytecode(reader: AucReader, codeLen: Int, nativeNames: List<String>,
        nativeParams: List<Int>, constTags: List<Int>, baseLine: Int): String {
        // 严格以「函数字节长度」为界：读取位置由 reader 实际消费决定，
        // 一旦某条指令的操作数宽度判断有误就会漂移，进而让**后续函数全部错位**。
        // 这里记录起点并在结束时强制对齐到 `start + codeLen`。
        val startPos: Long = reader.pos
        val endPos: Long = startPos + (codeLen as Long)

        var result: String = ""
        var offset: Int = 0
        while (offset < codeLen && reader.pos < endPos) {
            val opcode: Int = reader.readByte()
            if (opcode < 0) { break }
            val operandSize: Int = operandSizeLookup(opcode)
            // 同 Emit.aura 的注意事项：方法调用返回值**不要**直接用作 `var` 的初始化
            //（自举 AOT 下会丢失），先用 `val` 承接。
            val name0: String = opcodeName(opcode)
            var text: String = name0
            if (opcode == 27 || opcode == 78) {
                text = "CALL_NATIVE_ARGS"
            }
            if (opcode == 0) {
                // LoadConst：操作数是常量**下标**，助记符由常量标签决定
                val idx: Int = reader.readU16()
                text = constMnemonic(constTags, idx) + " " + toStr(idx)
            } else if (opcode == 23 || opcode == 24 || opcode == 25) {
                // Jump / JumpIfTrue / JumpIfFalse：i32 字节偏移 → 全局行号
                val target: Int = reader.readI32()
                val li: Int = instrIndexAt(reader, startPos, target, codeLen)
                text = text + " " + toStr(baseLine + li)
            } else if (opcode == 78) {
                // CallNativeArgs: u16 idx + u16 argc
                val idx: Int = reader.readU16()
                val argc: Int = reader.readU16()
                var nname: String = nameAt(nativeNames, idx)
                if (nname == "") {
                    nname = toStr(idx)
                }
                text = text + " " + nname + " " + toStr(argc)
            } else if (opcode == 27) {
                // CallNative: u16 idx（argc 取该原生的形参个数）
                val idx: Int = reader.readU16()
                var nname: String = nameAt(nativeNames, idx)
                if (nname == "") {
                    nname = toStr(idx)
                }
                text = text + " " + nname + " " + toStr(paramAt(nativeParams, idx))
            } else if (opcode == 71) {
                // CallExternal: u16 mod_idx + u16 sym_idx
                val modIdx: Int = reader.readU16()
                val symIdx: Int = reader.readU16()
                text = text + " " + toStr(modIdx) + " " + toStr(symIdx)
            } else if (opcode == 32 || opcode == 33) {
                // GetField / SetField：操作数是 **field_index(字段名)** 哈希（不是下标）
                val h: Int = reader.readU16()
                val fname: String = fieldNameOf(h)
                if (fname != "") {
                    text = text + " " + fname
                } else {
                    text = text + " " + toStr(h)
                }
            } else if (operandSize == 2) {
                text = text + " " + toStr(reader.readU16())
            } else if (operandSize == 4) {
                text = text + " " + toStr(reader.readU16()) + " " + toStr(reader.readU16())
            } else if (operandSize == 8) {
                // PushHandler: i32 target（字节偏移，同样翻译成行号）+ u16 slot + u16 catchType
                val target: Int = reader.readI32()
                val slot: Int = reader.readU16()
                val catchType: Int = reader.readU16()
                val li: Int = instrIndexAt(reader, startPos, target, codeLen)
                text = text + " " + toStr(baseLine + li) + " " + toStr(slot) + " "
                    + toStr(catchType)
            }
            if (result != "") {
                result = result + "\n"
            }
            result = result + text
            // operandSize == 0: 无操作数
            offset = offset + 1 + operandSize
        }

        // 对齐函数边界（见上方说明）
        if (reader.pos < endPos) {
            reader.pos = endPos
        }
        return result
    }

    /// 数值化解码单个函数的字节码（P2.2b：二进制 → 结构化指令数组）。
    ///
    /// 与 `readBytecode`（文本翻译，遗留）的语义一致，但不拼装文本行，直接
    /// 向 `mod.numOpNames` / `mod.numArgs` 追加指令；操作数在加载期解析为
    /// 「函数名 / 常量下标 / 全局行号」等最终形态。返回解码出的指令数。
    ///
    /// 关键翻译（相对文本版的两处强化）：
    ///   * `CALL <函数下标>` → `CALL <函数名> <参数个数>`（文本版遗留为数字
    ///     下标，VM 无法解析——这是 `.auc` 用户函数调用不可用的根因之一）；
    ///   * `CALL_METHOD <vtable槽位>` → `CALL_METHOD <方法名>`（经槽位表解析；
    ///     接收者副本/参数绑定由 VM 的 aucMode 方法调用约定处理）。
    private fun decodeNumeric(reader: AucReader, codeLen: Int, nativeNames: List<String>,
        nativeParams: List<Int>, constTags: List<Int>, funcNames: List<String>,
        funcParams: List<Int>, slotNames: List<String>, classNames: List<String>,
        baseLine: Int, mod: AucModule): Int {
        val startPos: Long = reader.pos
        val endPos: Long = startPos + (codeLen as Long)

        var count: Int = 0
        var offset: Int = 0
        while (offset < codeLen && reader.pos < endPos) {
            val opcode: Int = reader.readByte()
            if (opcode < 0) { break }
            val operandSize: Int = operandSizeLookup(opcode)
            var name: String = opcodeName(opcode)
            var a0: String = ""
            var a1: String = ""

            if (opcode == 0) {
                // LoadConst：助记符由常量标签决定
                val idx: Int = reader.readU16()
                name = constMnemonic(constTags, idx)
                a0 = toStr(idx)
            } else if (opcode == 23 || opcode == 24 || opcode == 25) {
                // Jump/JumpIfTrue/JumpIfFalse：i32 字节偏移 → 全局行号
                val target: Int = reader.readI32()
                val li: Int = instrIndexAt(reader, startPos, target, codeLen)
                a0 = toStr(baseLine + li)
            } else if (opcode == 26) {
                // CALL 函数下标 → 函数名 + 参数个数（前向引用已由两遍扫描解决）
                val fidx: Int = reader.readU16()
                name = "CALL"
                a0 = nameAt(funcNames, fidx)
                a1 = toStr(paramAt(funcParams, fidx))
            } else if (opcode == 27) {
                // CallNative: u16 idx（argc 取该原生的形参个数）
                val idx: Int = reader.readU16()
                name = "CALL_NATIVE_ARGS"
                a0 = nameAt(nativeNames, idx)
                if (a0 == "") { a0 = toStr(idx) }
                a1 = toStr(paramAt(nativeParams, idx))
            } else if (opcode == 78) {
                // CallNativeArgs: u16 idx + u16 argc
                val idx: Int = reader.readU16()
                val argc: Int = reader.readU16()
                name = "CALL_NATIVE_ARGS"
                a0 = nameAt(nativeNames, idx)
                if (a0 == "") { a0 = toStr(idx) }
                a1 = toStr(argc)
            } else if (opcode == 30) {
                // NewObject(类 ID) → 类名（类表下标即 ID，与 Rust class_id_map 一致）
                val cid: Int = reader.readU16()
                a0 = classNameAt(classNames, cid)
            } else if (opcode == 32 || opcode == 33) {
                // GetField/SetField：字段名哈希（内建成员翻译回名字）
                val h: Int = reader.readU16()
                val fname: String = fieldNameOf(h)
                if (fname != "") { a0 = fname } else { a0 = toStr(h) }
            } else if (opcode == 40) {
                // CallMethod(vtable 槽位) → 方法名
                val slot: Int = reader.readU16()
                if (slot >= 0 && slot < slotNames.size() && slotNames.get(slot) != "") {
                    a0 = slotNames.get(slot)
                } else {
                    a0 = toStr(slot)
                }
            } else if (opcode == 71) {
                // CallExternal: u16 mod_idx + u16 sym_idx
                val modIdx: Int = reader.readU16()
                val symIdx: Int = reader.readU16()
                a0 = toStr(modIdx)
                a1 = toStr(symIdx)
            } else if (opcode == 70 || opcode == 77) {
                // CallExport / CallAot：函数下标 → 函数名
                val fidx: Int = reader.readU16()
                a0 = nameAt(funcNames, fidx)
                if (a0 == "") { a0 = toStr(fidx) }
            } else if (opcode == 72) {
                // MakeClosure: 函数下标 → 函数名（捕获经 CALL 侧语义，.auc 无捕获）
                val fidx: Int = reader.readU16()
                a0 = nameAt(funcNames, fidx)
                if (a0 == "") { a0 = toStr(fidx) }
            } else if (opcode == 80 || opcode == 81) {
                // InstanceOf/CheckCast(类 ID) → 类名
                val cid: Int = reader.readU16()
                a0 = classNameAt(classNames, cid)
            } else if (opcode == 82) {
                // PushHandler: i32 目标偏移 → 行号 + u16 slot + u16 catchType(类 ID)
                val target: Int = reader.readI32()
                val slot: Int = reader.readU16()
                val catchId: Int = reader.readU16()
                val li: Int = instrIndexAt(reader, startPos, target, codeLen)
                a0 = toStr(baseLine + li)
                a1 = toStr(slot)
                // catchType 作为第 3 个操作数单独追加；0xFFFF 哨兵 = 无类型过滤
                var catchName: String = ""
                if (catchId != 65535) {
                    catchName = classNameAt(classNames, catchId)
                }
                mod.numOpNames.add(name)
                mod.numArgs.add(arrayListOf<String>(a0, a1, catchName))
                count = count + 1
                offset = offset + 1 + operandSize
                continue
            } else if (operandSize == 2) {
                a0 = toStr(reader.readU16())
            } else if (operandSize == 4) {
                a0 = toStr(reader.readU16())
                a1 = toStr(reader.readU16())
            }
            // operandSize == 0：无操作数

            mod.numOpNames.add(name)
            val argList: List<String> = arrayListOf<String>()
            if (a0 != "") { argList.add(a0) }
            if (a1 != "") { argList.add(a1) }
            mod.numArgs.add(argList)
            count = count + 1
            // 对齐函数边界（防操作数宽度判断漂移）
            offset = offset + 1 + operandSize
        }

        if (reader.pos < endPos) {
            reader.pos = endPos
        }
        return count
    }

    /// IEEE-754 f64 位模式 → 可解析的十进制文本（纯 Aura 拆位实现）。
    ///
    /// value = (-1)^sign × (1.fraction) × 2^(exp-1023)；尾数位从高到低以
    /// 0.5 步进累加（f32 精确表示 0.5^i 直至 i=149），指数经 pow 缩放。
    /// 输出格式与 Rust f64 Display 一致的常见形态（"2.5"/"5.0"/"-1.25"）。
    private fun f64BitsToText(bits: Long): String {
        // Long 位运算在 Aura 侧不可靠，用除法/取模拆位。
        // P4.1（AOT 基底适配）：不再用 2^51/2^52 级巨型 Long 字面量作除数
        //（自举 AOT 下触发 0xC0000094 整除零，实测 arithmetic 样例必崩）——
        // 指数用 52 次 `/2` 提取，2^52 用连乘构造；标量 Long 的 `/2`、`%2048`
        // 与连乘在双基底均可靠（list_probe 探针实测）。
        val neg: Boolean = bits < 0
        val mag: Long = if (neg) (0 - bits) else bits
        var hi: Long = mag
        var hs: Int = 0
        while (hs < 52) {
            hi = hi / 2
            hs = hs + 1
        }
        val exp: Int = (hi % 2048) as Int   // bits >> 52 & 0x7FF
        var p52: Long = 1
        var pt: Int = 0
        while (pt < 52) {
            p52 = p52 * 2
            pt = pt + 1
        }
        val mantissa: Long = mag % p52       // bits & 0xFFFFFFFFFFFFF

        // 零 / 特殊值
        if (exp == 0 && mantissa == 0) {
            return if (neg) "-0.0" else "0.0"
        }
        if (exp == 2047) {
            if (mantissa == 0) {
                return if (neg) "-inf" else "inf"
            }
            return "nan"
        }

        // 1 + Σ fraction bit_i × 0.5^i（i = 1..52）
        var v: Float = 1.0
        var bitVal: Float = 0.5
        var div: Long = p52 / 2              // 2^51：从最高尾数位（i=1）向下
        var i: Int = 0
        while (i < 52) {
            val bit: Int = ((mantissa / div) % 2) as Int
            if (bit == 1) {
                v = v + bitVal
            }
            bitVal = bitVal / 2.0
            div = div / 2
            i = i + 1
        }
        // 非规格化（exp == 0）：值 = 0.fraction × 2^-1022 —— 按规格化公式
        // 减一个 2^-1022 的修正量在 f32 上不可表达，超小值一律退化为 0.0
        var e: Int = exp - 1023
        if (exp == 0) {
            v = v - 1.0
            e = -1022
        }
        val scaled: Float = VmOps.pow(v, 1.0) * VmOps.pow(2.0, e as Float)
        val signed: Float = if (neg) (0.0 - scaled) else scaled
        return toStr(signed)
    }

    /// 类 ID → 类名（越界回退：0 = "Any"，其余用数字串保持旧行为）。
    private fun classNameAt(classNames: List<String>, id: Int): String {
        if (id >= 0 && id < classNames.size()) {
            return classNames.get(id)
        }
        if (id == 0) { return "Any" }
        return toStr(id)
    }

    /// 数出「函数内字节偏移 `target`」处指令的下标（从 0 起）。
    ///
    /// 从函数起点重新逐条跳过（每个操作数按 `operandSizeLookup` 的长度）直到
    /// 抵达 `target`；不是指令边界时返回已数到的下标（尽力而为）。
    /// 结束后恢复 `reader.pos`。
    private fun instrIndexAt(reader: AucReader, startPos: Long, target: Int,
        codeLen: Int): Int {
        if (target <= 0) {
            return 0
        }
        val saved: Long = reader.pos
        reader.pos = startPos
        var off: Int = 0
        var idx: Int = 0
        while (off < codeLen && off < target) {
            val op: Int = reader.readByte()
            if (op < 0) { break }
            val sz: Int = operandSizeLookup(op)
            reader.skip(sz as Long)
            off = off + 1 + sz
            idx = idx + 1
        }
        reader.pos = saved
        return idx
    }

    /// 已知「内建成员名」的 `field_index` 哈希（FNV-1a 32 位 `% 65535`，
    /// 与 Rust `codegen::emit::field_index` 完全一致）。
    ///
    /// Rust 把 `x.length` / `xs.size` 这类访问编译成 `GET_FIELD <哈希>`：
    /// `length → 47589`、`size → 64764`、`isEmpty → 9133`、`first → 8387`、
    /// `last → 15355`。翻译回名字后 VM 才能按内建成员取值
    ///（旧实现把哈希当字段名查全局表 → 恒得 0，实测 `len=0`）。
    private fun fieldNameOf(hash: Int): String {
        if (hash == 47589) { return "length" }
        if (hash == 64764) { return "size" }
        if (hash == 9133) { return "isEmpty" }
        if (hash == 8387) { return "first" }
        if (hash == 15355) { return "last" }
        return ""
    }

    /// 按常量标签选择类型化加载助记符（越界按字符串处理）。
    private fun constMnemonic(tags: List<Int>, idx: Int): String {
        if (idx < 0 || idx >= tags.size()) {
            return "LOAD_CONST_S"
        }
        val tag: Int = tags.get(idx)
        if (tag == 0) { return "LOAD_CONST_I" }   // Int(i64)
        if (tag == 1) { return "LOAD_CONST_F" }   // Float(f64)
        if (tag == 3) { return "LOAD_CONST_B" }   // Bool
        if (tag == 4) { return "LOAD_CONST_N" }   // Null
        return "LOAD_CONST_S"                      // Str
    }

    /// 按下标取原生函数名（越界返回 ""）。
    private fun nameAt(names: List<String>, idx: Int): String {
        if (idx < 0) { return "" }
        if (idx >= names.size) { return "" }
        return names.get(idx)
    }

    /// 按下标取原生函数形参个数（越界返回 0）。
    private fun paramAt(params: List<Int>, idx: Int): Int {
        if (idx < 0) { return 0 }
        if (idx >= params.size) { return 0 }
        return params.get(idx)
    }

    /// 统计文本行数（不含结尾换行；空串计 0 行）。
    private fun countTextLines(text: String): Int {
        if (text == "") { return 0 }
        var count: Int = 1
        var i: Int = 0
        var len: Int = text.length
        while (i < len) {
            if (text.charCodeAt(i) == 10) {
                count = count + 1
            }
            i = i + 1
        }
        return count
    }

    /// 操作码名称映射（数字 → 助记符）。
    private fun opcodeName(op: Int): String {
        if (op == 0) return "CONST_INT"
        if (op == 1) return "LOAD_LOCAL"
        if (op == 2) return "STORE_LOCAL"
        if (op == 3) return "ADD"
        if (op == 4) return "SUB"
        if (op == 5) return "MUL"
        if (op == 6) return "DIV"
        if (op == 7) return "MOD"
        if (op == 8) return "NEG"
        if (op == 9) return "NOT"
        if (op == 10) return "AND"
        if (op == 11) return "OR"
        if (op == 12) return "BIT_AND"
        if (op == 13) return "BIT_OR"
        if (op == 14) return "BIT_XOR"
        if (op == 15) return "SHL"
        if (op == 16) return "SHR"
        if (op == 17) return "EQ"
        if (op == 18) return "NEQ"
        if (op == 19) return "LT"
        if (op == 20) return "GT"
        if (op == 21) return "LE"
        if (op == 22) return "GE"
        if (op == 23) return "JUMP"
        if (op == 24) return "JUMP_IF_TRUE"
        if (op == 25) return "JUMP_IF_FALSE"
        if (op == 26) return "CALL"
        if (op == 27) return "CALL_NATIVE"
        if (op == 28) return "RETURN"
        if (op == 29) return "RETURN_UNIT"
        if (op == 30) return "NEW_OBJECT"
        if (op == 31) return "NEW_ARRAY"
        if (op == 32) return "GET_FIELD"
        if (op == 33) return "SET_FIELD"
        if (op == 34) return "INC_REF"
        if (op == 35) return "DEC_REF"
        if (op == 36) return "CALL_C"
        if (op == 37) return "HALT"
        if (op == 38) return "GET_INDEX"
        if (op == 39) return "SET_INDEX"
        if (op == 40) return "CALL_METHOD"
        if (op == 41) return "CALL_CTOR"
        if (op == 42) return "NEW_LIST"
        if (op == 43) return "NEW_MAP"
        if (op == 44) return "LIST_PUSH"
        if (op == 45) return "LIST_POP"
        if (op == 46) return "LIST_LEN"
        if (op == 47) return "MAP_SET"
        if (op == 48) return "MAP_GET"
        if (op == 49) return "MAP_LEN"
        if (op == 50) return "YIELD"
        if (op == 51) return "NEW_COROUTINE"
        if (op == 52) return "RESUME_COROUTINE"
        if (op == 53) return "DROP_REF"
        if (op == 54) return "RETAIN"
        if (op == 55) return "RELEASE"
        if (op == 56) return "WEAK_REF"
        if (op == 57) return "WEAK_GET"
        if (op == 58) return "BOX_ALLOC"
        if (op == 59) return "DEFER_BEGIN"
        if (op == 60) return "DEFER_END"
        if (op == 61) return "CSTRING"
        if (op == 62) return "READ_CSTR"
        if (op == 63) return "PTR_IS_NULL"
        if (op == 64) return "PTR_TO_INT"
        if (op == 65) return "INT_TO_PTR"
        if (op == 66) return "MAKE_CALLBACK"
        if (op == 70) return "CALL_EXPORT"
        if (op == 71) return "CALL_EXTERNAL"
        if (op == 72) return "MAKE_CLOSURE"
        if (op == 73) return "CALL_CLOSURE"
        if (op == 74) return "ENUM_CONSTRUCT"
        if (op == 75) return "ENUM_TAG"
        if (op == 76) return "MAKE_FN_REF"
        if (op == 77) return "CALL_AOT"
        if (op == 78) return "CALL_NATIVE_ARGS"
        if (op == 80) return "INSTANCE_OF"
        if (op == 81) return "CHECK_CAST"
        if (op == 82) return "PUSH_HANDLER"
        if (op == 83) return "POP_HANDLER"
        if (op == 84) return "THREAD_SPAWN"
        if (op == 85) return "THREAD_JOIN"
        if (op == 86) return "THREAD_SLEEP"
        if (op == 87) return "THREAD_ID"
        if (op == 88) return "THREAD_PARALLELISM"
        if (op == 89) return "MUTEX_NEW"
        if (op == 90) return "MUTEX_LOCK"
        if (op == 91) return "MUTEX_UNLOCK"
        if (op == 92) return "MUTEX_TRY_LOCK"
        if (op == 93) return "ATOMIC_NEW"
        if (op == 94) return "ATOMIC_LOAD"
        if (op == 95) return "ATOMIC_STORE"
        if (op == 96) return "ATOMIC_ADD"
        if (op == 97) return "ATOMIC_CAS"
        if (op == 98) return "RWLOCK_NEW"
        if (op == 99) return "RWLOCK_READ_LOCK"
        if (op == 100) return "RWLOCK_WRITE_LOCK"
        if (op == 101) return "RWLOCK_READ_UNLOCK"
        if (op == 102) return "RWLOCK_WRITE_UNLOCK"
        if (op == 103) return "CHANNEL_NEW"
        if (op == 104) return "CHANNEL_SEND"
        if (op == 105) return "CHANNEL_RECV"
        if (op == 106) return "CONDVAR_NEW"
        if (op == 107) return "CONDVAR_WAIT"
        if (op == 108) return "CONDVAR_SIGNAL"
        if (op == 109) return "CONDVAR_BROADCAST"
        return "UNKNOWN_" + op.toString()
    }

    /// 操作数字节数查找表。
    private fun operandSizeLookup(op: Int): Int {
        if (op == 0 || op == 1 || op == 2) return 2
        if (op == 30 || op == 32 || op == 33) return 2
        if (op == 23 || op == 24 || op == 25) return 4
        if (op == 82) return 8
        if (op == 26 || op == 27 || op == 36) return 2
        if (op == 78) return 4  // CallNativeArgs: 2×u16
        if (op == 40 || op == 41 || op == 51 || op == 80 || op == 81) return 2
        if (op == 66) return 2
        if (op == 70) return 2
        if (op == 71) return 4  // CallExternal: 2×u16
        if (op == 84) return 2
        if (op == 72 || op == 74 || op == 76 || op == 77) return 2
        return 0
    }

    /// 验证 .auc 文件是否存在且有效。
    fun validateAuc(path: String): Boolean {
        if (!FileUtils.exists(path)) {
            return false
        }
        val size: Long = FileUtils.fileSize(path)
        if (size < 4) {
            return false  // 至少要有魔数
        }
        // 读取魔数
        val reader: AucReader = AucReader()
        if (!reader.readFromFile(path)) {
            return false
        }
        val magic: String = readMagic(reader)
        reader.dispose()
        return isAuraMagic(magic)
    }
}
