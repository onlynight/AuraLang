// aura:///aura/tests/concurrent/ThreadSpawnDemo.aura
package aura.tests.concurrent
// ─────────────────────────────────────────────────────────────
// Thread.spawn 分派表测试 Demo
//
// 验证 AOT 分派表 + trampoline 机制：
//   Thread.spawn(fn_name, arg) → aura_thread_create(fn_idx, arg)
//   运行时通过 __aura_fn_table[fn_idx] 查找 trampoline
//   trampoline 将 i64 arg 适配为函数签名后调用
// ─────────────────────────────────────────────────────────────

import aura.lang.concurrent.Thread
import aura.lang.concurrent.Channel
import aura.lang.std.String

// ── 子线程任务函数 ──

// 测试 1: 简单乘法
fun multiplyTask(arg: Int): Int {
    return arg * 7
}

// 测试 2: 循环计数
fun countTask(arg: Int): Int {
    var i: Int = 0
    var count: Int = 0
    while (i < arg) {
        count = count + 1
        i = i + 1
    }
    return count
}

// 测试 3: 线程 ID
fun idTask(arg: Int): Int {
    val tid: Int = Thread.id()
    return tid
}

fun main(): Unit {
    println("╔══════════════════════════════════════════╗")
    println("║     Thread.spawn 分派表测试 Demo          ║")
    println("╚══════════════════════════════════════════╝")
    println("")

    // ── 基础信息 ──
    val cores: Int = Thread.parallelism()
    println("可用核心数: " + toStr(cores))
    
    val mainTid: Int = Thread.id()
    println("主线程 ID: " + toStr(mainTid))
    println("")

    // ── 测试 1: 简单乘法 ──
    println("[测试 1] Thread.spawn(multiplyTask, 6)")
    val tid1: Int = Thread.spawn(multiplyTask, 6)
    println("  子线程 ID: " + toStr(tid1))
    
    if (tid1 != 0) {
        println("  ✓ 线程创建成功")
        Thread.join(tid1)
        println("  ✓ 线程已完成 (预期结果: 6 * 7 = 42)")
    } else {
        println("  ✗ 线程创建失败 (ID=0)")
    }
    println("")

    // ── 测试 2: 循环计数 ──
    println("[测试 2] Thread.spawn(countTask, 5)")
    val tid2: Int = Thread.spawn(countTask, 5)
    println("  子线程 ID: " + toStr(tid2))
    
    if (tid2 != 0) {
        println("  ✓ 线程创建成功")
        Thread.join(tid2)
        println("  ✓ 线程已完成 (预期计数: 5)")
    } else {
        println("  ✗ 线程创建失败 (ID=0)")
    }
    println("")

    // ── 测试 3: 线程 ID ──
    println("[测试 3] Thread.spawn(idTask, 0)")
    val tid3: Int = Thread.spawn(idTask, 0)
    println("  子线程 ID: " + toStr(tid3))
    
    if (tid3 != 0) {
        println("  ✓ 线程创建成功")
        Thread.join(tid3)
        println("  ✓ 线程已完成")
    } else {
        println("  ✗ 线程创建失败 (ID=0)")
    }
    println("")

    // ── 测试 4: 多线程并发 ──
    println("[测试 4] 多线程并发 (5 个线程)")
    val tid4a: Int = Thread.spawn(multiplyTask, 1)
    val tid4b: Int = Thread.spawn(multiplyTask, 2)
    val tid4c: Int = Thread.spawn(multiplyTask, 3)
    val tid4d: Int = Thread.spawn(multiplyTask, 4)
    val tid4e: Int = Thread.spawn(multiplyTask, 5)
    
    var spawned: Int = 0
    if (tid4a != 0) { spawned = spawned + 1 }
    if (tid4b != 0) { spawned = spawned + 1 }
    if (tid4c != 0) { spawned = spawned + 1 }
    if (tid4d != 0) { spawned = spawned + 1 }
    if (tid4e != 0) { spawned = spawned + 1 }
    
    println("  创建 " + toStr(spawned) + "/5 个线程")
    
    // 等待所有线程完成
    if (tid4a != 0) { Thread.join(tid4a) }
    if (tid4b != 0) { Thread.join(tid4b) }
    if (tid4c != 0) { Thread.join(tid4c) }
    if (tid4d != 0) { Thread.join(tid4d) }
    if (tid4e != 0) { Thread.join(tid4e) }
    println("  ✓ 所有线程已完成")
    println("")

    // ── 测试 5: Thread + Channel 组合 ──
    println("[测试 5] Thread + Channel 组合")
    val ch: Int = Channel.newChannel(3)
    
    // 主线程发送
    Channel.channelSend(ch, "from-main")
    
    // 主线程接收
    val msg: Any = Channel.channelRecv(ch)
    println("  收到消息: " + toStr(msg))
    println("")

    // ── 总结 ──
    println("═══════════════════════════════════════════════")
    println("分派表测试结果:")
    println("  ✓ Thread.spawn() — 分派表创建子线程")
    println("  ✓ trampoline — 参数类型适配 (i64→i32)")
    println("  ✓ Thread.join() — 等待子线程完成")
    println("  ✓ 多线程并发 — 多个线程同时运行")
    println("  ✓ Thread + Channel — 线程与通道组合")
    println("═══════════════════════════════════════════════")
}
