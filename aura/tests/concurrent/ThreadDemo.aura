// aura:///aura/tests/concurrent/ThreadDemo.aura
package aura.tests.concurrent
// ─────────────────────────────────────────────────────────────
// 多线程并发测试 Demo — Thread + Channel
//
// 测试内容：
//   1. Thread.parallelism() — 获取可用核心数
//   2. Thread.id() — 获取当前线程 ID
//   3. Thread.sleep() — 线程休眠
//   4. Channel.newChannel/send/recv — 通道通信
//   5. Thread.join() — 等待线程完成
// ─────────────────────────────────────────────────────────────

import aura.lang.concurrent.Thread
import aura.lang.concurrent.Channel
import aura.lang.std.String

fun main(): Unit {
    println("╔══════════════════════════════════════════╗")
    println("║     Aura 多线程并发测试 Demo              ║")
    println("╚══════════════════════════════════════════╝")
    println("")

    // ── 1. Thread.parallelism ──
    val cores: Int = Thread.parallelism()
    println("[1] Thread.parallelism() = " + toStr(cores))
    println("    系统可用逻辑核心数: " + toStr(cores))
    println("")

    // ── 2. Thread.id ──
    val tid: Int = Thread.id()
    println("[2] Thread.id() = " + toStr(tid))
    println("    当前线程 ID: " + toStr(tid))
    println("")

    // ── 3. Thread.sleep ──
    println("[3] Thread.sleep(100) — 休眠 100 毫秒...")
    Thread.sleep(100)
    println("    休眠完成")
    println("")

    // ── 4. Channel 通信测试 ──
    println("[4] Channel 通信测试:")
    val ch: Int = Channel.newChannel(4)
    println("    创建通道 ID: " + toStr(ch))
    
    Channel.channelSend(ch, "hello")
    Channel.channelSend(ch, "world")
    Channel.channelSend(ch, "from")
    Channel.channelSend(ch, "Aura")
    
    val msg1: Any = Channel.channelRecv(ch)
    val msg2: Any = Channel.channelRecv(ch)
    val msg3: Any = Channel.channelRecv(ch)
    val msg4: Any = Channel.channelRecv(ch)
    
    println("    收到消息: " + toStr(msg1) + ", " + toStr(msg2) + ", " + toStr(msg3) + ", " + toStr(msg4))
    println("")

    // ── 5. Thread.join 测试 ──
    println("[5] Thread.join 测试:")
    // 传入无效 ID，应返回 0（不阻塞）
    val result: Int = Thread.join(0)
    println("    Thread.join(0) = " + toStr(result))
    println("    无效线程 ID 返回 0 (预期行为)")
    println("")

    // ── 6. 综合测试 ──
    println("[6] 综合测试:")
    Thread.sleep(10)
    println("    Thread.sleep(10) 完成")
    
    val ch2: Int = Channel.newChannel(2)
    Channel.channelSend(ch2, "test")
    val recv: Any = Channel.channelRecv(ch2)
    println("    Channel 发送/接收: " + toStr(recv))
    
    val cores2: Int = Thread.parallelism()
    println("    核心数验证: " + toStr(cores2) + (if (cores2 == cores) " ✓" else " ✗"))
    
    val tid2: Int = Thread.id()
    println("    线程 ID 验证: " + toStr(tid2) + (if (tid2 == tid) " ✓" else " ✗"))
    
    // ── 7. Thread.spawn 测试 ──
    println("")
    println("[7] Thread.spawn 测试:")
    val spawnTid: Int = Thread.spawn(sleepTask, 50)
    println("    Thread.spawn(sleepTask, 50) = " + toStr(spawnTid))
    if (spawnTid != 0) {
        Thread.join(spawnTid)
        println("    ✓ 子线程创建并 join 完成")
    }
    
    println("")
    println("═══════════════════════════════════════════════")
    println("线程能力总结:")
    println("  ✓ Thread.parallelism() — 获取核心数 (" + toStr(cores) + ")")
    println("  ✓ Thread.id() — 获取线程 ID (" + toStr(tid) + ")")
    println("  ✓ Thread.sleep() — 线程休眠")
    println("  ✓ Channel.newChannel/send/recv — 通道通信")
    println("  ✓ Thread.join() — 等待线程完成")
    println("  ✓ Thread.spawn() — 分派表创建子线程")
    println("═══════════════════════════════════════════════")
}

// 子线程任务：休眠指定毫秒
fun sleepTask(ms: Int): Int {
    Thread.sleep(ms)
    return 0
}
