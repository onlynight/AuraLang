// aura:///aura/tests/concurrent/ThreadSpawnTest.aura
package aura.tests.concurrent
// Thread.spawn 基础测试 — 验证线程创建和 join

import aura.lang.concurrent.Thread
import aura.lang.std.String

// 子线程任务：简单返回 42
// 注意：这个函数会被 Thread.spawn 调用
fun spawnedTask(arg: Int): Int {
    // arg 是传入的参数
    return arg * 2
}

fun main(): Unit {
    println("=== Thread.spawn 测试 ===")
    
    val cores: Int = Thread.parallelism()
    println("可用核心数: " + toStr(cores))
    
    val tid: Int = Thread.id()
    println("当前线程 ID: " + toStr(tid))
    
    // 创建子线程执行 spawnedTask
    val threadId: Int = Thread.spawn(spawnedTask, 21)
    println("子线程 ID: " + toStr(threadId))
    
    // 等待子线程完成
    val result: Int = Thread.join(threadId)
    println("子线程结果: " + toStr(result))
    
    // Thread.sleep 测试
    println("休眠 100ms...")
    Thread.sleep(100)
    println("休眠完成")
    
    println("=== 测试完成 ===")
}
