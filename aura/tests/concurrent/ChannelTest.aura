// aura:///aura/tests/concurrent/ChannelTest.aura
package aura.tests.concurrent
// 最简 Channel 测试

import aura.lang.concurrent.Channel
import aura.lang.std.String

fun worker(taskCh: Int): Int {
    val raw: Any = Channel.channelRecv(taskCh)
    println("worker received: " + toStr(raw))
    val payload: String = toStr(raw)
    println("payload length: " + toStr(payload.length))
    return 42
}

fun main(): Unit {
    println("=== Channel Test ===")
    
    val ch: Int = Channel.newChannel(1)
    Channel.channelSend(ch, "hello world")
    
    val raw: Any = Channel.channelRecv(ch)
    println("main received: " + toStr(raw))
    
    println("=== Done ===")
}
