// aura:///debugger/aura/lang/debugger/Repl.aura
package aura.lang.debugger

// ── Standard library imports ──
import aura.lang.std.String
import aura.lang.std.IO

// ── Sibling module imports ──
import "DebugSession.aura"
import "DebugVm.aura"

// ═══════════════════════════════════════════════════════════════
// DebugRepl — interactive debugger command interpreter
//
// Reads commands from stdin (via IO.readLine) and dispatches
// them to DebugSession methods. Supports step, continue,
// breakpoints, variable inspection, watch, source listing,
// disassembly, and expression evaluation.
// ═══════════════════════════════════════════════════════════════

object DebugRepl {

    /// Print available commands.
    fun printHelp(): Unit {
        println("Commands:")
        println("  run          - Start execution")
        println("  c/continue   - Continue to next breakpoint")
        println("  s/step       - Step into (single instruction)")
        println("  so/step-over - Step over function calls")
        println("  o/step-out   - Step out of current function")
        println("  b <file>:<line>  - Set breakpoint")
        println("  d <id>       - Delete breakpoint")
        println("  bl           - List breakpoints")
        println("  v            - Show local variables")
        println("  g            - Show global variables")
        println("  st           - Show call stack")
        println("  frame <n>    - Show stack frame n")
        println("  l            - List source (current line)")
        println("  l <line>     - List source around line")
        println("  dis          - Disassemble (current instruction)")
        println("  watch <expr> - Add watch expression")
        println("  unwatch <id> - Remove watch expression")
        println("  w            - Print watch values")
        println("  eval <expr>  - Evaluate expression")
        println("  info/i       - Show debugger info")
        println("  help/h       - Show this help")
        println("  q/quit       - Exit debugger")
    }

    /// Print stop information (info + source + watch).
    fun printStopInfo(session: DebugSession, reason: String): Unit {
        println("")
        println("  Info:")
        println(session.info())
        println("  Source:")
        println(session.showSource(3))
        if (session.watchExprs.size > 0) {
            println("  Watch:")
            println(session.printWatch())
        }
    }

    /// Show source code around a specific line number.
    fun showSourceAroundLine(session: DebugSession, lineNum: Int, context: Int): Unit {
        var start: Int = lineNum - context
        if (start < 1) {
            start = 1
        }
        var end: Int = lineNum + context
        if (end > session.sourceLines.size) {
            end = session.sourceLines.size
        }
        println("  Around line " + toStr(lineNum) + ":")
        var i: Int = start
        while (i <= end) {
            val prefix: String = if (i == lineNum) {
                "> "
            } else {
                "  "
            }
            println(prefix + toStr(i) + " | " + session.sourceLines[i - 1])
            i = i + 1
        }
    }

    /// Extract an argument after a command prefix.
    fun extractArg(cmd: String, prefix1: String, prefix2: String): String {
        var p1Len: Int = prefix1.length
        if (DebugVmUtils.myStartsWith(cmd, prefix1)) {
            return DebugSessionUtils.safeSubstring(cmd, p1Len, cmd.length)
        }
        var p2Len: Int = prefix2.length
        if (DebugVmUtils.myStartsWith(cmd, prefix2)) {
            return DebugSessionUtils.safeSubstring(cmd, p2Len, cmd.length)
        }
        return ""
    }

    /// Run the REPL loop — read commands until quit.
    fun run(session: DebugSession): Int {
        printHelp()
        println("")
        println("Debugger ready. Type 'help' for commands, 'q' to quit.")
        println("")

        while (true) {
            print("dbg> ")
            val line: String = IO.readLine()
            if (line.length == 0) {
                continue
            }
            val trimmed: String = DebugSessionUtils.trim(line)
            if (trimmed.length == 0) {
                continue
            }

            if (trimmed == "q" || trimmed == "quit") {
                println("Quitting debugger...")
                return 0
            } else if (trimmed == "help" || trimmed == "h" || trimmed == "?") {
                printHelp()
            } else if (trimmed == "run") {
                val rc: Int = session.init(session.srcFile)
                if (rc != 0) {
                    println("  Init failed")
                    continue
                }
                val stop: String = session.run()
                printStopInfo(session, stop)
            } else if (trimmed == "c" || trimmed == "continue") {
                val stop: String = session.continueExec()
                printStopInfo(session, stop)
            } else if (trimmed == "s" || trimmed == "step") {
                val stop: String = session.stepInto()
                printStopInfo(session, stop)
            } else if (trimmed == "so" || trimmed == "step-over" || trimmed == "next") {
                val stop: String = session.stepOver()
                printStopInfo(session, stop)
            } else if (trimmed == "o" || trimmed == "step-out" || trimmed == "finish") {
                val stop: String = session.stepOut()
                printStopInfo(session, stop)
            } else if (DebugVmUtils.myStartsWith(trimmed, "b ") ||
                       DebugVmUtils.myStartsWith(trimmed, "break ")) {
                val bpArg: String = DebugRepl.extractArg(trimmed, "b ", "break ")
                val colon: Int = findChar(bpArg, 58)
                if (colon < 0) {
                    println("  Usage: b <file>:<line>")
                } else {
                    val file: String = DebugSessionUtils.safeSubstring(bpArg, 0, colon)
                    val lineStr: String = DebugSessionUtils.safeSubstring(bpArg, colon + 1, bpArg.length)
                    val line: Int = DebugSessionUtils.toInt(DebugSessionUtils.trim(lineStr))
                    val id: Int = session.addBreakpoint(file, line)
                    println("  Breakpoint #" + toStr(id) + " at " + file + ":" + toStr(line))
                }
            } else if (DebugVmUtils.myStartsWith(trimmed, "d ") ||
                       DebugVmUtils.myStartsWith(trimmed, "delete ")) {
                val dArg: String = DebugRepl.extractArg(trimmed, "d ", "delete ")
                val id: Int = DebugSessionUtils.toInt(DebugSessionUtils.trim(dArg))
                if (!session.removeBreakpoint(id)) {
                    println("  Breakpoint #" + toStr(id) + " not found")
                }
            } else if (trimmed == "bl" || trimmed == "breakpoints" || trimmed == "bp") {
                session.listBreakpoints()
            } else if (trimmed == "v" || trimmed == "variables" || trimmed == "locals") {
                println(session.variables())
            } else if (trimmed == "g" || trimmed == "globals") {
                println(session.globals())
            } else if (trimmed == "st" || trimmed == "stack") {
                println(session.callStack())
            } else if (DebugVmUtils.myStartsWith(trimmed, "frame ")) {
                val frameArg: String = DebugRepl.extractArg(trimmed, "frame ", "fr ")
                val depth: Int = DebugSessionUtils.toInt(DebugSessionUtils.trim(frameArg))
                println(session.stackFrame(depth))
            } else if (trimmed == "l" || trimmed == "list" || trimmed == "source" || trimmed == "src") {
                val context: Int = 3
                println(session.showSource(context))
            } else if (DebugVmUtils.myStartsWith(trimmed, "l ")) {
                val lArg: String = DebugRepl.extractArg(trimmed, "l ", "list ")
                val lineNum: Int = DebugSessionUtils.toInt(DebugSessionUtils.trim(lArg))
                if (lineNum > 0) {
                    showSourceAroundLine(session, lineNum, 3)
                } else {
                    println(session.showSource(3))
                }
            } else if (trimmed == "dis" || trimmed == "disassemble") {
                println(session.disassemble(3))
            } else if (DebugVmUtils.myStartsWith(trimmed, "watch ") || DebugVmUtils.myStartsWith(trimmed, "w ")) {
                val wArg: String = DebugRepl.extractArg(trimmed, "watch ", "w ")
                if (DebugSessionUtils.trim(wArg).length > 0) {
                    session.watch(DebugSessionUtils.trim(wArg))
                }
            } else if (DebugVmUtils.myStartsWith(trimmed, "unwatch ") || DebugVmUtils.myStartsWith(trimmed, "uw ")) {
                val idStr: String = DebugRepl.extractArg(trimmed, "unwatch ", "uw ")
                val id: Int = DebugSessionUtils.toInt(DebugSessionUtils.trim(idStr))
                if (!session.unwatch(id)) {
                    println("  Watch #" + toStr(id) + " not found")
                }
            } else if (trimmed == "info" || trimmed == "i") {
                println(session.info())
            } else if (DebugVmUtils.myStartsWith(trimmed, "eval ") || DebugVmUtils.myStartsWith(trimmed, "e ")) {
                val evalArg: String = DebugRepl.extractArg(trimmed, "eval ", "e ")
                val expr: String = DebugSessionUtils.trim(evalArg)
                if (expr.length > 0) {
                    println(session.eval(expr))
                }
            } else if (trimmed == "func" || trimmed == "functions") {
                println("  Functions:")
                println("  (source map not available in external mode)")
            } else {
                println("  Unknown command: " + trimmed)
                println("  Type 'help' for available commands")
            }
        }
    }

    /// Find the first occurrence of a character code in a string.
    private fun findChar(text: String, code: Int): Int {
        var i: Int = 0
        while (i < text.length) {
            if (text.charCodeAt(i) == code) {
                return i
            }
            i = i + 1
        }
        return -1
    }
}
