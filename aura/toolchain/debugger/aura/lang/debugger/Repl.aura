/// 闂傚倷娴囧畷鍨叏閹绢噮鏁勯柛娑欐綑閻ゎ噣鏌熼幆鏉啃撻柛搴★攻閵囧嫰寮介顫捕闂?REPL 闂傚倷娴囬褍霉閻戣棄鏋侀柟闂撮檷閳ь兛鐒︾换婵嬪炊閵娿儳妯侀梻浣告啞濞诧箓宕归幏宀€绠?object DebugRepl {

    /// 闂傚倸鍊烽懗鍫曞箠閹剧粯鍊舵慨妯挎硾缁犳壆绱掔€ｎ厽纭堕柡鍡愬€濋弻娑㈠箛閸忓摜鍑归梺鍝勬缁秹濡甸崟顖氱睄闁稿本鑹炬禒姗€鎮跺鍗炐ｇ紒缁樼洴閺佹劙宕ㄩ缁㈡Ш闂備礁鎲￠幐鑽ゆ崲閸愵亖鍋撻棃娑栧仮鐎规洏鍔戝鍫曞箠?    fun printHelp(): Unit {
        println("Commands:")
        println("  run          - Start execution")
        println("  c/continue   - Continue to next breakpoint")
        println("  s/step       - Step into (single instruction)")
        println("  so/step-over - Step over function calls")
        println("  o/step-out   - Step out of current function")
        println("  b <file>:<line>  - Set breakpoint")
        println("  d <id>       - Delete breakpoint")
        println("  bl           - List breakpoints")
        println("  v            - Show local variables")
        println("  g            - Show global variables")
        println("  st           - Show call stack")
        println("  frame <n>    - Show stack frame n")
        println("  l            - List source (current line)")
        println("  l <line>     - List source around line")
        println("  dis          - Disassemble (current instruction)")
        println("  dis <n>      - Disassemble with context")
        println("  p <expr>     - Evaluate expression")
        println("  w <expr>     - Watch expression")
        println("  uw <id>      - Unwatch expression")
        println("  info         - Show debug info")
        println("  func         - List functions")
        println("  help         - Show this help")
        println("  q/quit       - Exit debugger")
    }

    /// 闂傚倸鍊风粈渚€骞栭銈傚亾濮樼厧澧柡鍛板煐缁傛帞鈧綆鈧叏闄勯幈銊ノ熼幐搴ｃ€愮紒鎯у⒔缁垳鎹㈠┑鍥╃瘈闁稿本鍑规导宀勬⒑閸涘﹥灏伴柛搴＄枃瑜颁線姊洪幖鐐插姷缂佽尪濮ら弲鍫曞箵閹规缍婇幃鈩冩償閵忕姵鐣诲┑?    fun printStopInfo(session: DebugSession, reason: String): Unit {
        println("")
    /// Print stop information.
        println("  闂?" + session.info())
        println("  闂?Source:")
        println("  闂?" + session.showSource(3))
        if (session.watchExprs.size > 0) {
            println("  闂?Watch:")
            println("  闂?" + session.printWatch())
        }
            println("  [watch expressions]")
    }

    /// 闂傚倸鍊风粈渚€骞栭銈傚亾濮樼厧澧柡鍛板煐缁傛帞鈧綆鈧叏闄勯幈銊ノ熼幐搴ｃ€愮紓浣哄С閸楁娊寮诲☉銏犖ㄩ柟瀛樼箖閸ｇ儤鎱ㄩ敐鍛村弰闁哄矉缍侀幃娆戔偓鐢电《濡插牓姊哄ú璇插箹闁稿﹥鎮傞垾鏍ㄧ節閸ヨ埖鏅╅梺鍏间航閸庢澘顫濋敃鍌涒拺闁荤喖鍋婇崵鐔封攽椤旂偓鏆柟顔惧亾濞煎繘濡歌閻﹀牓鎮峰鍐弰鐎规洘绻傝灃闁告侗鍠栨禍顖氣攽閻樿宸ラ柣妤€妫滅换?    fun showSourceAroundLine(session: DebugSession, lineNum: Int, context: Int): Unit {
        var start: Int = lineNum - context
        if (start < 1) {
            start = 1
        }
        var end: Int = lineNum + context
        if (end > session.sourceLines.size) {
            end = session.sourceLines.size
        }
        println("  Around line " + toStr(lineNum) + ":")
        var i: Int = start
        while (i <= end) {
            val prefix: String = if (i == lineNum) {
                "> "
            } else {
                "  "
            }
            println("  " + prefix + toStr(i) + " | " + session.sourceLines[i - 1])
            i = i + 1
        }
    }

    /// 濠电姷鏁搁崑娑㈩敋椤撶喐鍙忛悗娑欙供濞堜粙鏌熼梻瀵割槮缂佺姷濞€閺屽秹鍩℃担鍛婃濡炪倐鏅濋崗姗€寮婚弴銏犻唶婵犻潧妫导鍌炴⒑閸涘渚涢柛鎾跺枛瀵鎮㈤搹鍦紲濠碘槅鍨伴幖顐︼綖瀹€鍕仭婵犲﹤瀚欢鍙夌箾瀹割喖骞栭柣锝囧厴閺佹劖寰勬繝鍕剁床婵犵數鍋為崹鍫曟偡閿曞偆鏁婄€广儱顦伴埛鎴︽煙缁嬫寧鎹ｉ柍钘夘樀閺岋絽螖娴ｇ懓纾抽悗娈垮枟婵炲﹪寮婚崱妤婂悑闁告侗鍘鹃悰鈺呮⒒娴ｇ儤鍤€闁宦板妿閺侇喖螖娴ｇ懓寮块梺闈涚箳婵＄銇愰幒鎴狀槯濠电偞娼欑€垫帗绂嶉鍕殾闁靛繒濮Σ鍫ユ煏韫囧﹤澧叉繛鍛墬缁绘繈濮€閿濆棛銆愰梺缁橆殔閸熸潙鐣?    fun extractArg(line: String, prefixLong: String, prefixShort: String): String {
        if (DebugVmUtils.myStartsWith(line, prefixLong)) {
            return DebugSessionUtils.safeSubstring(line, prefixLong.length, line.length)
        }
        if (DebugVmUtils.myStartsWith(line, prefixShort)) {
            return DebugSessionUtils.safeSubstring(line, prefixShort.length, line.length)
        }
        return ""
    }

    /// 濠电姷鏁搁崑娑㈩敋椤撶喐鍙忛悗娑欙供濞堜粙鏌熼梻瀵割槮缂佺姷濞€閺屽秹鍩℃担鍛婃濡炪倐鏅濋崗姗€寮婚弴銏犻唶婵犻潧妫导鍌炴⒑閸涘渚涢柛鎾跺枛瀵鎮㈤搹鍦紲濠碘槅鍨伴幖顐︼綖瀹€鍕仭婵犲﹤瀚欢鍙夌箾瀹割喖骞栭柣锝囧厴閺佹劖寰勬繝鍕剁床婵犵數鍋為崹鍫曟偡閿曞偆鏁婄€广儱顦伴埛鎴︽煙缁嬫寧鎹ｉ柍钘夘樀閺岋絽螖閳ь剟骞婇幇鏉跨闁圭儤鎸婚崕鐔兼煏婵犲繗鍚傞柟宄扮秺濮婃椽宕滈懠顒€甯ラ梺鍝ュУ椤ㄥ﹤鐣烽悽绋跨闁圭偨鍔岀紞濠囧箖閳哄拋鏁婇悘蹇旂墪娴滃墽鎲歌箛鎾愶綁骞囬澶嬪兊闁荤姾妗ㄧ紞?    fun extractArgOnly(line: String, prefix: String): String {
        if (DebugVmUtils.myStartsWith(line, prefix)) {
            return DebugSessionUtils.safeSubstring(line, prefix.length, line.length)
        }
        return ""
    }

    /// 闂傚倷娴囧畷鍨叏閹绢噮鏁勯柛娑欐綑閻ゎ噣鏌熼幆鏉啃撻柛搴★攻閵囧嫰寮介顫捕闂?REPL 濠电姷鏁搁崑鐐哄垂閸洖绠插〒姘ｅ亾妞ゃ垺淇洪ˇ瑙勵殽閻愬弶顥炵紒缁樼箞瀹曞爼濡搁妷銈堟濠碉紕鍋戦崐鏍偋濡ゅ嫬缍旈梻?    fun run(session: DebugSession): Unit {
        println("  ============================================================")
        println("  Aura Debugger (Pure Aura Self-Hosted)")
        println("  Target: " + session.srcFile)
        println("  Commands: help  |  q to quit")
        println("  ============================================================")
        println("")

        var quit: Boolean = false
        while (!quit) {
            // 闂傚倸鍊风粈渚€骞栭銈傚亾濮樼厧澧柡鍛板煐缁傛帞鈧綆鈧叏闄勯幈銊ノ熼幐搴ｃ€愮紓浣哄Х閺佸寮婚悢鍏肩劷闁挎洍鍋撻柡瀣煥闇夐柣妯虹－閵嗘帞绱?            val stateStr: String = if (session.debugVm.isRunning()) {
                "[running]"
            } else if (session.started) {
                "[paused]"
            } else {
                "[idle]"
            }
            print("(debug " + stateStr + ") ")
            val line: String = IO.readLine()

            // 缂傚倸鍊搁崐椋庣矆娓氣偓閹矂宕掑鍛紳濠殿喗顭堟ご鎼侇敃閼恒儯浜滈柟鎯у船閻忊晝绱掗埀顒勫磼閻愬鍘繝銏ｅ煐缁嬫捇鎮鹃柆宥嗙厽?EOF 闂傚倷娴囧畷鍨叏閹绢喖绠规い鎰堕檮閸嬵亪鏌涢妷銏℃珕鐎?            val trimmed: String = DebugSessionUtils.trim(line)
            if (trimmed.length == 0 || trimmed == "null") {
                // stdin 闂傚倸鍊烽懗鍫曗€﹂崼銏″床闁瑰鍋熺粻鎯р攽閻樿弓杩规繛鎴欏灩缁犵粯銇勯弮鍥т汗妞?EOF闂傚倸鍊烽悞锔锯偓绗涘懐鐭欓柟杈鹃檮閸庢鏌涘畝鈧崑娑㈡倿閸偁浜滈柟杈剧稻椤ュ霉濠婂牏鐣烘慨濠冩そ瀹曘劍绻濋崒婊€娣梻浣告贡閳峰牓宕戞繝鍥╁祦闁糕剝顭囩弧鈧梺鎼炲劘閸斿本绂?                if (trimmed == "null") {
                    println("  (stdin closed, exiting)")
                    quit = true
                }
                } else {

            // 闂傚倸鍊风粈渚€宕崸妤€鍌ㄦ繝濠傜墕绾惧鏌熼崜褏甯涢柣鎾冲暣閺屾稖绠涢幙鍐┬︽繛?闂傚倸鍊风粈渚€骞夐敍鍕煓闁圭儤顨呴崹鍌涚節闂堟侗鍎忕紒鐙€鍣ｉ弻鏇㈠醇濠垫劖笑缂備讲鍋撻柛鈩冪⊕閻撴洟鏌嶉埡浣稿絹闁硅揪闄勯崐?闂傚倸鍊风粈渚€宕崸妤€鍌ㄦ繝濠傜墕绾惧鏌熼崜褏甯涢柣鎾冲暣閺屾稖绠涢幙鍐┬︽繛?            if (trimmed == "quit" || trimmed == "q") {
                session.quit()
                println("Bye.")
                quit = true

            } else if (trimmed == "help" || trimmed == "h" || trimmed == "?") {
                DebugRepl.printHelp()

            } else if (trimmed == "run" || trimmed == "r") {
                val reason: String = session.run()
                if (reason == "completion") {
                    println("  Execution completed. Return: " +
                        session.debugVm.getReturnValue())
                } else if (reason == "error") {
                    println("  Error: " + session.debugVm.getError())
                } else {
                    DebugRepl.printStopInfo(session, reason)
                }

            } else if (trimmed == "continue" || trimmed == "c") {
                val reason: String = session.continueExec()
                if (reason == "completion") {
                    println("  Execution completed. Return: " +
                        session.debugVm.getReturnValue())
                } else if (reason == "error") {
                    println("  Error: " + session.debugVm.getError())
                } else {
                    DebugRepl.printStopInfo(session, reason)
                }

            } else if (trimmed == "step" || trimmed == "s" || trimmed == "si") {
                val reason: String = session.stepInto()
                DebugRepl.printStopInfo(session, reason)

            } else if (trimmed == "step-over" || trimmed == "so" || trimmed == "n") {
                val reason: String = session.stepOver()
                DebugRepl.printStopInfo(session, reason)

            } else if (trimmed == "step-out" || trimmed == "o") {
                val reason: String = session.stepOut()
                DebugRepl.printStopInfo(session, reason)

            } else if (DebugVmUtils.myStartsWith(trimmed, "break ") || DebugVmUtils.myStartsWith(trimmed, "b ")) {
                val spec: String = DebugRepl.extractArg(trimmed, "break ", "b ")
                val colonIdx: Int = spec.indexOf(":")
                if (colonIdx > 0) {
                    val file: String = DebugSessionUtils.safeSubstring(spec, 0, colonIdx)
                    val lineStr: String = DebugSessionUtils.safeSubstring(spec, colonIdx + 1)
                    val lineNum: Int = DebugSessionUtils.toInt(DebugSessionUtils.trim(lineStr))
                    session.addBreakpoint(file, lineNum)
                } else {
                    val lineNum: Int = DebugSessionUtils.toInt(DebugSessionUtils.trim(spec))
                    session.addBreakpoint(session.srcFile, lineNum)
                }

            } else if (DebugVmUtils.myStartsWith(trimmed, "delete ") || DebugVmUtils.myStartsWith(trimmed, "d ")) {
                val idStr: String = DebugRepl.extractArg(trimmed, "delete ", "d ")
                val id: Int = DebugSessionUtils.toInt(DebugSessionUtils.trim(idStr))
                if (session.removeBreakpoint(id)) {
                    println("  Breakpoint #" + toStr(id) + " deleted")
                } else {
                    println("  Breakpoint #" + toStr(id) + " not found")
                }

            } else if (trimmed == "breakpoints" || trimmed == "bl") {
                session.listBreakpoints()

            } else if (trimmed == "variables" || trimmed == "v" || trimmed == "locals") {
                println(session.variables())

            } else if (trimmed == "globals" || trimmed == "g") {
                println(session.globals())

            } else if (trimmed == "stack" || trimmed == "st") {
                println(session.callStack())

            } else if (DebugVmUtils.myStartsWith(trimmed, "frame ")) {
                val depthStr: String = DebugRepl.extractArgOnly(trimmed, "frame ")
                val depth: Int = DebugSessionUtils.toInt(DebugSessionUtils.trim(depthStr))
                println(session.stackFrame(depth))

            } else if (trimmed == "frame" || trimmed == "f") {
                println("  Frame 0 (current):")
                println(session.stackFrame(0))

            } else if (trimmed == "list" || trimmed == "l") {
                println(session.showSource(5))

            } else if (DebugVmUtils.myStartsWith(trimmed, "list ") || DebugVmUtils.myStartsWith(trimmed, "l ")) {
                val lineStr: String = DebugRepl.extractArg(trimmed, "list ", "l ")
                val lineNum: Int = DebugSessionUtils.toInt(DebugSessionUtils.trim(lineStr))
                DebugRepl.showSourceAroundLine(session, lineNum, 5)

            } else if (trimmed == "disassemble" || trimmed == "dis") {
                println(session.disassemble(5))

            } else if (DebugVmUtils.myStartsWith(trimmed, "disassemble ") || DebugVmUtils.myStartsWith(trimmed, "dis ")) {
                val ctxStr: String = DebugRepl.extractArg(trimmed, "disassemble ", "dis ")
                val ctx: Int = DebugSessionUtils.toInt(DebugSessionUtils.trim(ctxStr))
                println(session.disassemble(ctx))

            } else if (DebugVmUtils.myStartsWith(trimmed, "print ") || DebugVmUtils.myStartsWith(trimmed, "p ")) {
                val expr: String = DebugRepl.extractArg(trimmed, "print ", "p ")
                val result: String = session.eval(expr)
                println("  " + expr + " = " + result)

            } else if (DebugVmUtils.myStartsWith(trimmed, "eval ") || DebugVmUtils.myStartsWith(trimmed, "e ")) {
                val expr: String = DebugRepl.extractArg(trimmed, "eval ", "e ")
                val result: String = session.eval(expr)
                println("  " + expr + " = " + result)

            } else if (DebugVmUtils.myStartsWith(trimmed, "watch ") || DebugVmUtils.myStartsWith(trimmed, "w ")) {
                val expr: String = DebugRepl.extractArg(trimmed, "watch ", "w ")
                session.watch(expr)

            } else if (DebugVmUtils.myStartsWith(trimmed, "unwatch ") || DebugVmUtils.myStartsWith(trimmed, "uw ")) {
                val idStr: String = DebugRepl.extractArg(trimmed, "unwatch ", "uw ")
                val id: Int = DebugSessionUtils.toInt(DebugSessionUtils.trim(idStr))
                if (!session.unwatch(id)) {
                    println("  Watch #" + toStr(id) + " not found")
                }

            } else if (trimmed == "info" || trimmed == "i") {
                println(session.info())

            } else if (trimmed == "func" || trimmed == "functions") {
                println("  Functions:")
                println("  (source map not available in external mode)")

            } else {
                println("  Unknown command: " + trimmed)
                println("  Type 'help' for available commands")
            }
        }
    }
}
