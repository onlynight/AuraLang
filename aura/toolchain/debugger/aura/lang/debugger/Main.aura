// aura:///debugger/aura/lang/debugger/Main.aura
package aura.lang.debugger

// ── 标准库 ──
import aura.lang.std.String
import aura.lang.std.Process
import aura.lang.std.IO

// ── 兄弟模块 ──
import "DebugSession.aura"
import "Repl.aura"

// ═══════════════════════════════════════════════════════════════
// 入口函数
// ═══════════════════════════════════════════════════════════════

fun main(): Int {
    println("=== DEBUGGER MAIN STARTED ===")
    val argc: Int = Process.argCount()
    println("argc = " + toStr(argc))
    var dbgI: Int = 0
    while (dbgI < argc) {
        println("[arg " + toStr(dbgI) + "] = " + Process.arg(dbgI))
        dbgI = dbgI + 1
    }

    if (argc < 4) {
        println("Usage: aura run <debugger.auc> <file.aura>")
        return 1
    }

    // arg[0]=aura, arg[1]=run, arg[2]=.auc, arg[3]=source
    val src: String = Process.arg(3)

    // 初始化调试会话
    val session: DebugSession = new DebugSession()
    val initResult: Int = session.init(src)
    if (initResult != 0) {
        println("Failed to initialize debugger")
        return 1
    }

    println("")
    println("Debugger ready. Type 'help' for commands, 'q' to quit.")
    println("")

    // 启动 REPL
    DebugRepl.run(session)
    return 0
}
