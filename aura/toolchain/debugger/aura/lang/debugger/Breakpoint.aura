// aura:///debugger/aura/lang/debugger/Breakpoint.aura
package aura.lang.debugger

// ── 标准库 ──
import aura.lang.std.String

// ═══════════════════════════════════════════════════════════════
// 断点数据类 — 完全纯 Aura 实现
// ═══════════════════════════════════════════════════════════════

class Breakpoint {
    var id: Int
    var file: String
    var line: Int
    var funcName: String = ""
    var funcOffset: Int = -1
    var enabled: Boolean = true
    var hitCount: Int = 0
    var condition: String = ""

    init(id: Int, file: String, line: Int, enabled: Boolean) {
        this.id = id
        this.file = file
        this.line = line
        this.enabled = enabled
    }

    /// 人类可读描述。
    fun formatStr(): String {
        var s: String = "#" + toStr(id) + " "
        s = s + (if (enabled) { "[✓]" } else { "[✗]" }) + " "
        s = s + file + ":" + toStr(line)
        if (funcName != "") {
            s = s + " (func: " + funcName + ")"
        }
        if (funcOffset >= 0) {
            s = s + " @ instr " + toStr(funcOffset)
        }
        if (hitCount > 0) {
            s = s + " (hits: " + toStr(hitCount) + ")"
        }
        if (condition != "") {
            s = s + " if " + condition
        }
        return s
    }
}
