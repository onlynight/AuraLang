// aura:///debugger/aura/lang/debugger/SourceMap.aura
package aura.lang.debugger

// ── Standard library imports ──
import aura.lang.std.String

// ── Collection imports ──
import aura.lang.collection.ArrayList
import aura.lang.collection.HashMap

// ── Compiler imports ──
import aura.lang.compiler.ast.Ast

// ═══════════════════════════════════════════════════════════════
// SourceMap — maps source lines to function offsets
//
// Builds a mapping from the AST and funcTable so that:
//   - A source line can be resolved to a function offset (for breakpoints)
//   - A function offset can be resolved to a source line (for display)
// ═══════════════════════════════════════════════════════════════

/// Source map — maps source lines to function offsets.
class SourceMap {

    var funcNames: ArrayList<String> = ArrayList<String>()
    var funcStartLines: ArrayList<Int> = ArrayList<Int>()
    var funcEndLines: ArrayList<Int> = ArrayList<Int>()
    var funcOffsets: ArrayList<Int> = ArrayList<Int>()
    var lineToFunc: HashMap<Int, Int> = HashMap<Int, Int>()

    /// Build the source map from AST and funcTable.
    fun build(ast: Ast, funcTable: String): Unit {
        funcNames = ArrayList<String>()
        funcStartLines = ArrayList<Int>()
        funcEndLines = ArrayList<Int>()
        funcOffsets = ArrayList<Int>()
        lineToFunc = HashMap<Int, Int>()

        var i: Int = 0
        while (i < ast.count) {
            if (ast.kindOf(i) == "Function") {
                val name: String = ast.textOf(i)
                val sp = ast.spanOf(i)
                val offset: Int = SourceMapUtils.findFuncOffset(name, funcTable)

                funcNames.add(name)
                funcStartLines.add(sp.startLine)
                funcEndLines.add(sp.endLine)
                funcOffsets.add(offset)

                // Build line → funcIdx mapping for each line in the function
                var line: Int = sp.startLine
                val funcIdx: Int = funcNames.size - 1
                while (line <= sp.endLine) {
                    lineToFunc.put(line, funcIdx)
                    line = line + 1
                }
            }
            i = i + 1
        }
    }

    /// Resolve a source line to a function offset. Returns -1 if not found.
    fun resolveBreakpoint(line: Int): Int {
        val funcIdx = lineToFunc.get(line)
        if (toStr(funcIdx) == "null") {
            return -1
        }
        val idx: Int = funcIdx as Int
        if (idx < 0 || idx >= funcOffsets.size) {
            return -1
        }
        return funcOffsets[idx]
    }

    /// Get the function name for a source line. Returns "" if not found.
    fun funcNameAtLine(line: Int): String {
        val funcIdx = lineToFunc.get(line)
        if (toStr(funcIdx) == "null") {
            return ""
        }
        val idx: Int = funcIdx as Int
        if (idx < 0 || idx >= funcNames.size) {
            return ""
        }
        return funcNames[idx]
    }

    /// Get the function name for a bytecode offset.
    fun funcNameAtOffset(offset: Int): String {
        var i: Int = 0
        while (i < funcOffsets.size) {
            if (funcOffsets[i] >= 0 && offset >= funcOffsets[i]) {
                return funcNames[i]
            }
            i = i + 1
        }
        return ""
    }

    /// Get the source line for a bytecode offset.
    fun lineAtOffset(offset: Int): Int {
        var bestFunc: Int = -1
        var bestOffset: Int = -1
        var i: Int = 0
        while (i < funcOffsets.size) {
            if (funcOffsets[i] >= 0 && funcOffsets[i] <= offset && funcOffsets[i] > bestOffset) {
                bestOffset = funcOffsets[i]
                bestFunc = i
            }
            i = i + 1
        }
        if (bestFunc >= 0) {
            return funcStartLines[bestFunc]
        }
        return 0
    }

    /// List all functions with their line ranges and offsets.
    fun listFunctions(): String {
        if (funcNames.size == 0) {
            return "(no functions found)"
        }
        var result: String = ""
        var i: Int = 0
        while (i < funcNames.size) {
            result = result + toStr(i) + ": " + funcNames[i] + " [" +
                toStr(funcStartLines[i]) + "-" + toStr(funcEndLines[i]) +
                "] @ " + toStr(funcOffsets[i]) + "\n"
            i = i + 1
        }
        return result
    }
}

/// SourceMap utility functions.
object SourceMapUtils {

    /// Find the bytecode offset for a function name in the funcTable.
    fun findFuncOffset(name: String, funcTable: String): Int {
        val lines: ArrayList<String> = splitLines(funcTable)
        var i: Int = 0
        while (i < lines.size) {
            val line: String = lines[i]
            if (line != "") {
                val fields: ArrayList<String> = splitPipe(line)
                if (fields.size >= 2 && fields[0] == name) {
                    return vrToInt(fields[1])
                }
            }
            i = i + 1
        }
        return -1
    }

    /// Split text into lines by '\n'.
    fun splitLines(text: String): ArrayList<String> {
        val result: ArrayList<String> = ArrayList<String>()
        var lineStart: Int = 0
        var i: Int = 0
        val len: Int = text.length
        while (i < len) {
            if (text.charCodeAt(i) == 10) {  // '\n'
                result.add(safeSubstring(text, lineStart, i))
                lineStart = i + 1
            }
            i = i + 1
        }
        if (lineStart < len) {
            result.add(safeSubstring(text, lineStart, len))
        }
        return result
    }

    /// Split text by '|' delimiter.
    fun splitPipe(text: String): ArrayList<String> {
        val result: ArrayList<String> = ArrayList<String>()
        var start: Int = 0
        var i: Int = 0
        val len: Int = text.length
        while (i < len) {
            if (text.charCodeAt(i) == 124) {  // '|'
                result.add(safeSubstring(text, start, i))
                start = i + 1
            }
            i = i + 1
        }
        if (start < len) {
            result.add(safeSubstring(text, start, len))
        }
        return result
    }

    /// Convert string to integer, return -1 on empty.
    fun vrToInt(text: String): Int {
        if (text == "") {
            return -1
        }
        val len: Int = text.length
        var total: Int = 0
        var i: Int = 0
        var neg: Boolean = false
        if (len > 0 && text.charCodeAt(0) == 45) {  // '-'
            neg = true
            i = 1
        }
        while (i < len) {
            val c: Int = text.charCodeAt(i)
            if (c < 48 || c > 57) {
                break
            }
            total = total * 10 + (c - 48)
            i = i + 1
        }
        if (neg) {
            return -total
        }
        return total
    }

    /// Safe substring with bounds checking.
    fun safeSubstring(text: String, start: Int, end: Int): String {
        var result: String = ""
        if (start < 0) { start = 0 }
        if (end > text.length) { end = text.length }
        if (start >= end) { return "" }
        var i: Int = start
        while (i < end) {
            result = result + toStr(text[i])
            i = i + 1
        }
        return result
    }

    /// Get a field at a specific row and column in a delimited table.
    fun fieldAt(text: String, rowIdx: Int, rowSep: String, colSep: String, colIdx: Int): String {
        val line: String = fieldAtRow(text, rowIdx, rowSep)
        return fieldAtCol(line, colIdx, colSep)
    }

    /// Get the row-th field separated by rowSep.
    fun fieldAtRow(text: String, rowIdx: Int, sep: String): String {
        var lineStart: Int = 0
        var cur: Int = 0
        var i: Int = 0
        val len: Int = text.length
        val sepCode: Int = sep.charCodeAt(0)
        while (i < len) {
            if (text.charCodeAt(i) == sepCode) {
                if (cur == rowIdx) {
                    return safeSubstring(text, lineStart, i)
                }
                cur = cur + 1
                lineStart = i + 1
            }
            i = i + 1
        }
        if (cur == rowIdx) {
            return safeSubstring(text, lineStart, len)
        }
        return ""
    }

    /// Get the col-th field separated by sep.
    fun fieldAtCol(text: String, colIdx: Int, sep: String): String {
        var fieldStart: Int = 0
        var cur: Int = 0
        var i: Int = 0
        val len: Int = text.length
        val sepCode: Int = sep.charCodeAt(0)
        while (i < len) {
            if (text.charCodeAt(i) == sepCode) {
                if (cur == colIdx) {
                    return safeSubstring(text, fieldStart, i)
                }
                cur = cur + 1
                fieldStart = i + 1
            }
            i = i + 1
        }
        if (cur == colIdx) {
            return safeSubstring(text, fieldStart, len)
        }
        return ""
    }
}
