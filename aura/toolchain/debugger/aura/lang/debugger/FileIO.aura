// aura:///debugger/aura/lang/debugger/FileIO.aura
package aura.lang.debugger

// ── 标准库 ──
import aura.lang.std.String
import aura.lang.std.IO

// ── 集合 ──
import aura.lang.collection.ArrayList

// ── 兄弟模块 ──
import "DebugVm.aura"

// ═══════════════════════════════════════════════════════════════
// 文件 I/O 辅助（object 形式，AOT 兼容）
// ═══════════════════════════════════════════════════════════════

object FileIO {
    /// 读取文件内容。
    fun readDebugFile(path: String): String {
        val result: String = IO.readFile(path)
        if (result == "" || DebugVmUtils.myStartsWith(result, "IO error")) {
            println("[debug] Cannot read file: " + path)
            return ""
        }
        return result
    }

    /// 检查文件是否存在。
    fun fileExists(path: String): Boolean {
        return IO.fileExists(path)
    }

    /// 读取文件行（按行分割）。
    fun readLines(path: String): ArrayList<String> {
        var result: ArrayList<String> = ArrayList<String>()
        val content: String = IO.readFile(path)
        if (content == "") {
            return result
        }
        var i: Int = 0
        var lineStart: Int = 0
        val len: Int = content.length
        while (i < len) {
            if (content.charCodeAt(i) == 10) {
                result.add(DebugVmUtils.safeSubstring(content, lineStart, i))
                lineStart = i + 1
            }
            i = i + 1
        }
        if (lineStart < len) {
            result.add(DebugVmUtils.safeSubstring(content, lineStart, len))
        }
        return result
    }
}