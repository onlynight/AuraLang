/// 列出断点 → 断点列表字符串
fun debugBreakpointList(): String {
    return "[]"
}

/// 查看变量 → 变量列表字符串
fun debugVariables(): String {
    return "{}"
}

/// 查看栈帧 → 栈帧信息字符串
fun debugStackFrame(depth: Int): String {
    return "{}"
}

/// 查看调用栈 → 调用栈字符串
fun debugCallStack(): String {
    return "[]"
}

/// 求值表达式 → 结果字符串
fun debugEval(expr: String): String {
    val wrapper: String = "fun main() { " + expr + " }"
    val p = Parser(wrapper)
    p.parseProgram()
    if (p.errors.count > 0) {
        return "error: " + toStr(p.errors.count) + " parse errors"
    }
    val checker = TypeChecker()
    checker.tcCheck(p.ast)
    val hl = HirLowerer()
    hl.lower(p.ast)
    val ml = MirLowerer()
    ml.lower(hl.hir)
    val cg = Codegen()
    val bytecode = cg.emit(ml.mir)
    val vm = VmRunner()
    vm.loadBytecode(bytecode, cg.constPoolStr(), cg.funcTableStr())
    val out = vm.run()
    return toStr(out)
}

/// 下一个停止位置 → 停止位置字符串
fun debugNextStop(): String {
    return "main.aura:1"
}

/// 添加 watch 表达式 → exit code
fun debugWatch(expr: String): Int {
    Console.println("[debug] Watch: " + expr)
    return 0
}

/// 移除 watch 表达式 → exit code
fun debugUnwatch(id: Int): Int {
    Console.println("[debug] Unwatch #" + toStr(id))
    return 0
}

/// 退出调试器 → exit code
fun debugQuit(): Int {
    Console.println("[debug] Quit")
    return 0
}
