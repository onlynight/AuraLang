    /// 婵犳鍠氶幊鎾诲磹閹间礁鐒垫い鎺戝暙椤ュ秹鏌曢崱妤€鏆炴繛鐓庣箻楠炲棜顦寸痪顓涘亾闂備焦瀵х粙鎴︽偋閸涱垰鍨濋幖娣妼缂佲晜銇勯弽銊р槈闁伙富鍣ｉ弻娑樷枎閹版儼鈧潡鏌涢敐鍡樸仢鐎殿喖顭锋俊鐑芥晝閳ь剟藟濠靛鐓ユ繛鎴烇供濡插爼鏌?    fun eval(expr: String): String {
        val trimmed: String = DebugSessionUtils.trim(expr)
        val directVal: String = lookupVariable(trimmed)
        if (directVal != "") {
            return directVal
        }
        return "(not found: " + trimmed + ")"
    }

