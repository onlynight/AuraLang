        val cmd: String = "D:\\Code\\AuraLang\\target\\release\\aura.exe build " + src + " --output " + compiledFile
        val rc: Int = Process.run(cmd)
        if (rc != 0) {
            println("Compilation failed (exit code: " + toStr(rc) + ")")
            return 1
        }
        println("Compiled: " + compiledFile)

        initialized = true
