    /// 闂佽崵濮撮鍛村疮閹惰姤鍎婃い鏍ㄧ〒閳瑰秹鏌嶉埡浣告殨缂佽鲸鐗犻弻鐔兼嚍閵夘喚鍔稿銈傛櫔缁犳挻淇?    fun info(): String {
        var s: String = ""
        s = s + "  Program:     " + srcFile + "\n"
        s = s + "  Source:      " + toStr(sourceLines.size) + " lines\n"
        s = s + "  Bytecode:    " + toStr(debugVm.getBytecodeLineCount()) + " instructions\n"
        s = s + "  VM state:    " + (if (debugVm.isRunning()) { "running" } else { "paused" }) + "\n"
        s = s + "  IP:          " + toStr(debugVm.getCurrentIp()) + "\n"
        s = s + "  Function:    " + debugVm.getCurrentFunc() + "\n"
        s = s + "  Call depth:  " + toStr(debugVm.getCallDepth()) + "\n"
        s = s + "  Stack depth: " + toStr(debugVm.getStackDepth()) + "\n"
        s = s + "  Instructions: " + toStr(debugVm.getInstructionCount()) + "\n"
        s = s + "  Breakpoints: " + toStr(bpManager.breakpoints.size) + "\n"
        s = s + "  Watch:       " + toStr(watchExprs.size) + "\n"
        if (debugVm.getError() != "") {
            s = s + "  Error:       " + debugVm.getError() + "\n"
        }
        if (debugVm.getReturnValue() != "" && debugVm.getReturnValue() != "Unit") {
            s = s + "  Return:      " + debugVm.getReturnValue() + "\n"
        }
        return s
    }

