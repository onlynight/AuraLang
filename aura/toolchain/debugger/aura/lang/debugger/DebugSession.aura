    /// 闂備礁鎼悮顐﹀磿閸愯鑰块柛娑卞灟濞岊亪鏌嶈閸撶喖寮婚崼銉ノ╅柕澶堝劤缁夘噣姊绘担鐟扮祷濡ょ姴绻掑Σ鎰枎閹惧啿寮烽梺鍛婃寙娴ｉ椹虫繝纰樷偓鍐茬骇闁搞劍绻勭槐鐐哄川閺夋垹鐓戦悗鐟板婢ф鈧碍鐓￠弻娑欑節閸曗斁鍋撶€ｎ剚顫曟慨妯挎硾杩?    fun variables(): String {
        var result: String = ""
        val locals: HashMap<Int, String> = debugVm.getLocals()
        val keys: ArrayList<Int> 

        var slot: Int = 0
        while (slot < 32) {
            val v = locals.get(slot)
            if (toStr(v) != "null") {
                keys.add(slot)
            }
            slot = slot + 1
        }

        if (keys.size == 0) {
            return "  (no local variables)"
        }
        var i: Int = 0
        while (i < keys.size) {
            val s: Int = keys[i]
            val val: String = locals.get(s)
            result = result + "  [" + toStr(s) + "] = " + val + "\n"
            i = i + 1
        }
        return result
    }

    /// 闂備礁鎼悮顐﹀磿閸愯鑰块柛娑欐綑缁€鍌炴煏婵炲灝鍔ゆ繝鈧导瀛樼厱婵炲棙鍔ч懓鍧楁煕閿濆棙銇濆┑?    fun globals(): String {
        var result: String = ""
        val g: HashMap<String, String> = debugVm.getGlobals()
        if (g.size == 0) {
            return "  (no global variables)"
        }
        val keys: ArrayList<String> = g.keys()
        var i: Int = 0
        while (i < keys.size) {
            val name: String = keys[i]
            result = result + "  " + name + " = " + g.get(name) + "\n"
            i = i + 1
        }
        return result
    }

    /// 闂備礁鎼悮顐﹀磿閸愯鑰块柛娑欐綑缁犺偐鈧箍鍎辩€氼喚绮欐繝鍥ㄧ厸濞达絽鎼。濂告煟閺嶃儱鈧繃淇?    fun stack(): String {
        val st: ArrayList<String> = debugVm.getStack()
        if (st.size == 0) {
            return "  (empty stack)"
        }
        var result: String = ""
        var i: Int = 0
        while (i < st.size) {
            result = result + "  [" + toStr(i) + "] " + st[i] + "\n"
            i = i + 1
        }
        return result
    }

    /// 闂備礁鎼悮顐﹀磿閸愯鑰块柛娑卞灡鐎氼剟鏌涢幇鍏哥凹闁哄棗绻橀弻鈥愁吋閸涱垰顣堕梺?    fun callStack(): String {
        val cs: ArrayList<String> = debugVm.getCallStack()
        if (cs.size == 0) {
            return "  (no call stack 闂?in main frame)"
        }
        var result: String = "  Call stack (depth " + toStr(cs.size) + "):\n"
        var i: Int = 0
        while (i < cs.size) {
            val entry: String = cs[i]
            // 闂備礁鎼粔鍫曞储瑜忓Σ? "ip|frameId"
            val parts: ArrayList<String> = DebugSessionUtils.splitPipe(entry)
            val retIp: String = parts[0]
            result = result + "  #" + toStr(i) + " ret@instr " + retIp + "\n"
            i = i + 1
        }
        return result
    }

    /// 闂備礁鎼悮顐﹀磿閸愯鑰块柛娑欐綑缁犱即鏌涢妷鎴濇噺濮ｅ酣姊洪崫鍕㈤柣妤€妫濋獮搴☆潩鐠轰綍?    fun stackFrame(depth: Int): String {
        if (depth == 0) {
            return variables()
        }
        // 婵犵數鍎戠徊钘夌暦椤掑倵鍋?> 0 闂傚倸鍊稿ú鐘诲磻閹剧粯鍋￠柡鍥ㄧ缁佺増銇勯弮鈧悧鐘差潖婵犳凹鏁婇柣鎾抽濞堛儲绻涢敐鍛缂佽鍊块幃娲Ω閳哄倸鍓?locals
        val saved: ArrayList<HashMap<Int, String>> = debugVm.savedLocals
        if (depth < 0 || depth >= saved.size) {
            return "  Frame #" + toStr(depth) + " not available"
        }
        val frameLocals: HashMap<Int, String> = saved[depth]
        var result: String = "  Frame #" + toStr(depth) + ":\n"
        var slot: Int = 0
        while (slot < 32) {
            val v = frameLocals.get(slot)
            if (toStr(v) != "null") {
                result = result + "  [" + toStr(slot) + "] = " + v + "\n"
            }
            slot = slot + 1
        }
        return result
    }

