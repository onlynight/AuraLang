    /// 婵犵數鍎戠紞鈧い鏇嗗嫭鍙?watch 闂佽崵鍋炵粙蹇涘礉韫囨稑绠垫い蹇撳閸ゆ洟鐓崶褜鍎岄柛?    fun watch(expr: String): Int {
        watchExprs.add(expr)
        println("  Watch #" + toStr(nextWatchId) + ": " + expr)
        nextWatchId = nextWatchId + 1
        return nextWatchId
    }

    /// 缂傚倷绀侀ˇ顖炩€﹀畡鎵虫瀺?watch 闂佽崵鍋炵粙蹇涘礉韫囨稑绠垫い蹇撳閸ゆ洟鐓崶褜鍎岄柛?    fun unwatch(id: Int): Boolean {
        if (id < 1 || id > nextWatchId - 1) {
            return false
        }
        val idx: Int = id - 1
        if (idx < 0 || idx >= watchExprs.size) {
            return false
        }
        val removed: String = watchExprs.remove(idx)
        println("  Unwatch #" + toStr(id) + ": " + removed)
        return true
    }

    /// 闂備胶鎳撻悘姘跺箰缁嬭法鏆ら柛鎰靛枛缁犮儵鏌嶈閸撶喎顕?watch 闂佽崵鍋炵粙蹇涘礉韫囨稑绠垫い蹇撳閸ゆ洟鐓崶銊︾闁伙綀浜幉鎼佹偋閸喎纰嶆繝鈷€鍛枅鐎规洘鍔楃划顓犳偘閳ュ厖澹?    fun printWatch(): String {
        if (watchExprs.size == 0) {
            return "  (no watch expressions)"
        }
        var result: String = ""
        var i: Int = 0
        while (i < watchExprs.size) {
            val val: String = eval(watchExprs[i])
            result = result + "  #" + toStr(i + 1) + " " + watchExprs[i] +
                " = " + val + "\n"
            i = i + 1
        }
        return result
    }

    /// 闂傚倷绶￠崑鈧柛瀣崌閺屾盯骞嬮敂鍓х獥闂佹眹鍔庨崰鎾诲箯閻樿鍗抽柣鎰嚟瑜版粓姊?    fun quit(): Int {
        initialized = false
        started = false
        return 0
    }
}

/// DebugSession 闁诲氦顫夐幃鍫曞磿闁秴鐭楅悹鎭掑妷閸嬫捇鎮藉▓鎸庢暞闂佽姤鐗曠€氱増淇?object DebugSessionUtils {

    /// 闂備礁婀遍…鍫ニ囬弶璺ㄦ殾闁肩⒈鍓氶崑妯尖偓鍏夊亾闁逞屽墴椤㈡牗绗熼埀顒€鐣峰璺哄耿婵°倐鍋撴い銉ョ箻閹鈽夊▎妯荤暭濡炪倖鍨抽悞锔剧矙婢跺奔娌柛灞绢殔娴?    fun splitLines(text: String): ArrayList<String> {
        val result: ArrayList<String> 
        var i: Int = 0
        var lineStart: Int = 0
        val len: Int = text.length
        while (i < len) {
            if (text.charCodeAt(i) == 10) {  // '\n'
                result.add(DebugSessionUtils.safeSubstring(text, lineStart, i))
                lineStart = i + 1
            }
            i = i + 1
        }
        if (lineStart < len) {
            result.add(DebugSessionUtils.safeSubstring(text, lineStart, len))
        }
        return result
    }

    /// 闂?'|' 闂備礁鎲＄敮鎺懳涘Δ浣虹彾濠电姴瀚ч崑鎾斥槈濞嗘ɑ鐣煎銈嗗灣閻掞妇绮欐径灞兼勃闁稿本顨呮禍?    fun splitPipe(text: String): ArrayList<String> {
        val result: ArrayList<String> 
        var i: Int = 0
        var start: Int = 0
        val len: Int = text.length
        while (i < len) {
            if (text.charCodeAt(i) == 124) {  // '|'
                result.add(DebugSessionUtils.safeSubstring(text, start, i))
                start = i + 1
            }
            i = i + 1
        }
        if (start < len) {
            result.add(DebugSessionUtils.safeSubstring(text, start, len))
        }
        return result
    }

    /// 闂備礁鎲￠敋妞ゎ厼鍢查埢宥嗘償椤喚纾鹃梺鍝勮癁閸涱厽娈圭紓鍌欑閻礁鈻嶉敐鍛瀺鐟滄梹淇?    fun trim(text: String): String {
        var start: Int = 0
        var end: Int = text.length
        while (start < end && (text.charCodeAt(start) == 32 || text.charCodeAt(start) == 9 ||
            text.charCodeAt(start) == 10 || text.charCodeAt(start) == 13)) {
            start = start + 1
        }
        while (end > start && (text.charCodeAt(end - 1) == 32 || text.charCodeAt(end - 1) == 9 ||
            text.charCodeAt(end - 1) == 10 || text.charCodeAt(end - 1) == 13)) {
            end = end - 1
        }
        if (start == 0 && end == text.length) {
            return text
        }
        return DebugSessionUtils.safeSubstring(text, start, end)
    }

    /// 闂佽瀛╃粙鎺椼€冮崼銉晞濞达絽婀遍埢鏃堟煠閼规澘鐓愮紒渚囧櫍閺屸剝鎷呴崫銉︽喖闂佸搫妫涢崰鏍极瀹ュ閱囬柣鏂挎憸椤╄鲸绻?String.toInt闂備焦瀵х粙鎴λ囬銏犵劦?    fun toInt(text: String): Int {
        return DebugVmUtils.vrToInt(text)
    }

    /// 闂佽娴烽幊鎾凰囬鐐茬煑闊洦娲嶉崑鎾斥槈濞嗗繐顫堥柣鐔告礀濡繈寮澶婇敜闁哥偞鎸code VM 闂備胶顭堢换鎺楀储瑜旈、娆撳箛閻楀牊娅栨繝銏ｆ硾閻楀啴宕?    fun safeSubstring(text: String, start: Int, end: Int): String {
        return DebugVmUtils.safeSubstring(text, start, end)
    }

    /// 闂佽瀛╃粙鎺椼€冮崼銉晞濞达絽婀遍埢鏃堟煕濞嗗浚妲圭粭鎴︽⒑閸涘﹦鍟茬紓鍌涚缁傚秹骞掑Δ鈧粻浼存煕閵夋垵鎳忓В搴ㄦ⒑閸涘﹥灏紒澶婂濡叉劙骞嬪┑鎰闂侀€炲苯澧€垫澘瀚蹇涘礈瑜忛ˇ鈺呮⒑閸濆嫭鎼愰柕鍥耿瀹?text.startsWith闂備焦瀵х粙鎴λ囬銏犵劦?    fun myStartsWith(text: String, prefix: String): Boolean {
        if (prefix.length > text.length) {
            return false
        }
        var i: Int = 0
        while (i < prefix.length) {
            if (text.charCodeAt(i) != prefix.charCodeAt(i)) {
                return false
            }
            i = i + 1
        }
        return true
    }

    /// 闂佽崵鍠愰悷杈╁緤妤ｅ啯鍊靛ù鐘差儏閻鎱ㄥ璇蹭壕闂侀潻缍€濞咃綁骞冩导绮光偓锕傚箳閺冨偆妲遍梻浣告惈缁夊爼宕㈣濡? name|slot闂備焦瀵х粙鎴﹀嫉椤掑嫭鍎婇柨娑樺閸嬫﹢鎮橀悙璺轰汗妞ゅ繐宕埥澶愬箼閸愌勫€ｇ紓浣介哺瀹€鍛婁繆?    fun parseVarTable(varTable: String): HashMap<String, Int> {
        val map: HashMap<String, Int> 
        if (varTable == "") {
            return map
        }
        var pos: Int = 0
        val len: Int = varTable.length
        var lineStart: Int = 0
        while (pos < len) {
            if (varTable.charCodeAt(pos) == 10) {  // '\n'
                val line: String = DebugSessionUtils.safeSubstring(varTable, lineStart, pos)
                if (line.length > 0) {
                    val parts: ArrayList<String> = splitPipe(line)
                    if (parts.size >= 2) {
                        val name: String = parts[0]
                        val slot: Int = DebugVmUtils.vrToInt(parts[1])
                        map.put(name, slot)
                    }
                }
                lineStart = pos + 1
            }
            pos = pos + 1
        }
        // 濠电姰鍨煎▔娑氣偓姘煎櫍楠炲啯绻濋崶褍鐝橀梺閫炲苯澧寸€规洏鍎查幆鏂库攽閸偂绱橀梺?        if (lineStart < len) {
            val line: String = DebugSessionUtils.safeSubstring(varTable, lineStart, len)
            if (line.length > 0) {
                val parts: ArrayList<String> = splitPipe(line)
                if (parts.size >= 2) {
                    val name: String = parts[0]
                    val slot: Int = DebugVmUtils.vrToInt(parts[1])
                    map.put(name, slot)
                }
            }
        }
        return map
    }
}
