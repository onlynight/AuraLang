// aura:///debugger/aura/lang/debugger/DebugSession.aura
package aura.lang.debugger

// ── Standard library imports ──
import aura.lang.std.String
import aura.lang.std.IO
import aura.lang.std.Process

// ── Collection imports ──
import aura.lang.collection.ArrayList
import aura.lang.collection.HashMap

// ── Compiler imports (for source analysis) ──
import aura.lang.compiler.parser.Parser
import aura.lang.compiler.sema.TypeChecker
import aura.lang.compiler.hir.Hir
import aura.lang.compiler.mir.MirLower
import aura.lang.compiler.codegen.Codegen

// ── Sibling module imports ──
import "DebugVm.aura"
import "SourceMap.aura"
import "BreakpointManager.aura"
import "FileIO.aura"

// ═══════════════════════════════════════════════════════════════
// DebugSession — orchestrates the debugging lifecycle:
//   1. Load source file, compile to .auc
//   2. Initialize DebugVm (bytecode execution)
//   3. Manage breakpoints via BreakpointManager
//   4. Step / continue / interrupt execution
//   5. Inspect variables, stack, call stack, memory
//   6. Evaluate watch expressions
// ═══════════════════════════════════════════════════════════════

class DebugSession {

    // ── Source state ──
    var source: String = ""
    var srcFile: String = ""
    var sourceLines: ArrayList<String> = ArrayList<String>()

    // ── Compilation output ──
    var bytecode: String = ""
    var constPool: String = ""
    var funcTable: String = ""
    var varTable: String = ""

    // ── VM and breakpoint manager ──
    var debugVm: DebugVm = new DebugVm()
    var bpManager: BreakpointManager = new BreakpointManager()
    var compiledFile: String = ""

    // ── Watch expressions ──
    var watchExprs: ArrayList<String> = ArrayList<String>()
    var nextWatchId: Int = 1

    // ── State flags ──
    var initialized: Boolean = false
    var started: Boolean = false

    // ═══════════════════════════════════════════════════════════
    //  Initialization
    // ═══════════════════════════════════════════════════════════

    /// Load source file, compile to .auc, return 0 on success.
    fun init(src: String): Int {
        srcFile = src
        val content: String = FileIO.readDebugFile(src)
        if (content.length == 0) {
            println("Error: cannot read file: " + src)
            return 1
        }
        source = content
        sourceLines = DebugSessionUtils.splitLines(content)

        // Compile to .auc bytecode
        compiledFile = "build/debugger_tmp.auc"
        val cmd: String = "D:\\Code\\AuraLang\\target\\release\\aura.exe build " + src + " --output " + compiledFile
        val rc: Int = Process.run(cmd)
        if (rc != 0) {
            println("Compilation failed (exit code: " + toStr(rc) + ")")
            return 1
        }
        println("Compiled: " + compiledFile)

        initialized = true
        return 0
    }

    /// Re-compile (delegates to init since compilation is already done there).
    fun compile(): Int {
        return 0
    }

    // ═══════════════════════════════════════════════════════════
    //  Execution control
    // ═══════════════════════════════════════════════════════════

    /// Run the compiled program to completion.
    fun run(): String {
        if (!initialized) {
            return "error: debugger not initialized"
        }
        val cmd: String = "D:\\Code\\AuraLang\\target\\release\\aura.exe run " + compiledFile
        println("Running: " + cmd)
        val rc: Int = Process.run(cmd)
        started = true
        if (rc != 0) {
            return "error: exit code " + toStr(rc)
        }
        return "completion"
    }

    /// Continue execution from current state.
    fun continueExec(): String {
        if (!started) {
            return run()
        }
        return runUntilStop()
    }

    /// Step into the next instruction.
    fun stepInto(): String {
        debugVm.stepMode = "in"
        val stop: String = runUntilStop()
        debugVm.stepMode = "off"
        return stop
    }

    /// Step over the next instruction.
    fun stepOver(): String {
        debugVm.stepMode = "over"
        debugVm.stepOverDepth = debugVm.callStack.size
        val stop: String = runUntilStop()
        debugVm.stepMode = "off"
        return stop
    }

    /// Step out of the current function.
    fun stepOut(): String {
        debugVm.stepMode = "out"
        debugVm.stepOutFunc = debugVm.currentFunc
        val stop: String = runUntilStop()
        debugVm.stepMode = "off"
        return stop
    }

    /// Run until a stop reason is reached (step, breakpoint, completion, error).
    fun runUntilStop(): String {
        while (true) {
            val stop: String = debugVm.step()
            if (stop != "") {
                return stop
            }
            // Check breakpoints
            val bpId: Int = bpManager.checkBreakpoint(debugVm.getCurrentIp())
            if (bpId != 0) {
                return "breakpoint"
            }
            if (!debugVm.isRunning()) {
                return "completion"
            }
        }
    }

    // ═══════════════════════════════════════════════════════════
    //  Breakpoints
    // ═══════════════════════════════════════════════════════════

    /// Add a breakpoint at file:line, returns breakpoint ID.
    fun addBreakpoint(file: String, line: Int): Int {
        return bpManager.add(file, line)
    }

    /// Remove a breakpoint by ID.
    fun removeBreakpoint(id: Int): Boolean {
        return bpManager.remove(id)
    }

    /// Print all breakpoints.
    fun listBreakpoints(): Unit {
        bpManager.printAll()
    }

    // ═══════════════════════════════════════════════════════════
    //  Inspection
    // ═══════════════════════════════════════════════════════════

    /// Show local variables in the current frame.
    fun variables(): String {
        var result: String = ""
        val locals: HashMap<Int, String> = debugVm.getLocals()
        val keyList: ArrayList<Integer> = ArrayList<Integer>()

        var slot: Int = 0
        while (slot < 32) {
            val v = locals.get(slot)
            if (toStr(v) != "null") {
                keyList.add(slot)
            }
            slot = slot + 1
        }

        if (keyList.size == 0) {
            return "  (no local variables)"
        }
        var i: Int = 0
        while (i < keyList.size) {
            val s: Int = keyList[i]
            val v: String = locals.get(s)
            result = result + "  [" + toStr(s) + "] = " + v + "\n"
            i = i + 1
        }
        return result
    }

    /// Show global variables.
    fun globals(): String {
        var result: String = ""
        val g: HashMap<String, String> = debugVm.getGlobals()
        if (g.size == 0) {
            return "  (no global variables)"
        }
        val keyList: List<String> = g.keys()
        var i: Int = 0
        while (i < keyList.size) {
            val name: String = keyList[i]
            result = result + "  " + name + " = " + g.get(name) + "\n"
            i = i + 1
        }
        return result
    }

    /// Show the VM value stack.
    fun stack(): String {
        val st: ArrayList<String> = debugVm.getStack()
        if (st.size == 0) {
            return "  (empty stack)"
        }
        var result: String = ""
        var i: Int = 0
        while (i < st.size) {
            result = result + "  [" + toStr(i) + "] " + st[i] + "\n"
            i = i + 1
        }
        return result
    }

    /// Show the call stack.
    fun callStack(): String {
        val cs: ArrayList<String> = debugVm.getCallStack()
        if (cs.size == 0) {
            return "  (no call stack — in main frame)"
        }
        var result: String = "  Call stack (depth " + toStr(cs.size) + "):\n"
        var i: Int = 0
        while (i < cs.size) {
            val entry: String = cs[i]
            // Entry format: "ip|frameId"
            val parts: ArrayList<String> = DebugSessionUtils.splitPipe(entry)
            val retIp: String = parts[0]
            result = result + "  #" + toStr(i) + " ret@instr " + retIp + "\n"
            i = i + 1
        }
        return result
    }

    /// Show variables for a specific stack frame (0 = current).
    fun stackFrame(depth: Int): String {
        if (depth == 0) {
            return variables()
        }
        // Access saved locals for the given frame
        val saved: ArrayList<HashMap<Int, String>> = debugVm.savedLocals
        if (depth < 0 || depth >= saved.size) {
            return "  Frame #" + toStr(depth) + " not available"
        }
        val frameLocals: HashMap<Int, String> = saved[depth]
        var result: String = "  Frame #" + toStr(depth) + ":\n"
        var slot: Int = 0
        while (slot < 32) {
            val v = frameLocals.get(slot)
            if (toStr(v) != "null") {
                result = result + "  [" + toStr(slot) + "] = " + v + "\n"
            }
            slot = slot + 1
        }
        return result
    }

    /// Show source code around the current line.
    fun showSource(context: Int): String {
        if (sourceLines.size == 0) {
            return "  (no source loaded)"
        }
        val currentLine: Int = debugVm.getCurrentIp()
        var start: Int = currentLine - context
        if (start < 1) {
            start = 1
        }
        var end: Int = currentLine + context
        if (end > sourceLines.size) {
            end = sourceLines.size
        }
        var result: String = ""
        var i: Int = start
        while (i <= end) {
            val lineStr: String = sourceLines[i - 1]
            val prefix: String = if (i == currentLine) { "> " } else { "  " }
            result = result + prefix + toStr(i) + " | " + lineStr + "\n"
            i = i + 1
        }
        return result
    }

    /// Show disassembly around the current instruction.
    fun disassemble(context: Int): String {
        return debugVm.disassemble(context)
    }

    /// Show debugger session info.
    fun info(): String {
        var s: String = ""
        s = s + "  Program:     " + srcFile + "\n"
        s = s + "  Source:      " + toStr(sourceLines.size) + " lines\n"
        s = s + "  Bytecode:    " + toStr(debugVm.getBytecodeLineCount()) + " instructions\n"
        s = s + "  VM state:    " + (if (debugVm.isRunning()) { "running" } else { "paused" }) + "\n"
        s = s + "  IP:          " + toStr(debugVm.getCurrentIp()) + "\n"
        s = s + "  Function:    " + debugVm.getCurrentFunc() + "\n"
        s = s + "  Call depth:  " + toStr(debugVm.getCallDepth()) + "\n"
        s = s + "  Stack depth: " + toStr(debugVm.getStackDepth()) + "\n"
        s = s + "  Instructions: " + toStr(debugVm.getInstructionCount()) + "\n"
        s = s + "  Breakpoints: " + toStr(bpManager.breakpoints.size) + "\n"
        s = s + "  Watch:       " + toStr(watchExprs.size) + "\n"
        if (debugVm.getError() != "") {
            s = s + "  Error:       " + debugVm.getError() + "\n"
        }
        if (debugVm.getReturnValue() != "" && debugVm.getReturnValue() != "Unit") {
            s = s + "  Return:      " + debugVm.getReturnValue() + "\n"
        }
        return s
    }

    // ═══════════════════════════════════════════════════════════
    //  Expression evaluation
    // ═══════════════════════════════════════════════════════════

    /// Evaluate an expression — tries variable lookup, then arithmetic.
    fun eval(expr: String): String {
        val trimmed: String = DebugSessionUtils.trim(expr)

        // Try direct variable lookup first
        val directVal: String = lookupVariable(trimmed)
        if (directVal != "") {
            return directVal
        }

        // Try simple arithmetic: <var> + <var>, <var> + <int>, etc.
        val arithmeticResult: String = evalArithmetic(trimmed)
        if (arithmeticResult != "") {
            return arithmeticResult
        }

        // Try direct integer literal
        val intVal: Int = DebugSessionUtils.tryParseInt(trimmed)
        if (intVal != 0 || trimmed == "0") {
            return toStr(intVal)
        }

        return "(not found: " + trimmed + ")"
    }

    /// Evaluate simple arithmetic expressions like "a + b", "x * 2".
    private fun evalArithmetic(expr: String): String {
        // Try binary operations
        var opIdx: Int = -1
        var opChar: Char = 0
        var i: Int = 0
        while (i < expr.length) {
            val c: Int = expr.charCodeAt(i)
            if (c == 43 || c == 45 || c == 42 || c == 47 || c == 37) {
                // Avoid leading minus (negative number)
                if (i > 0 && c == 45) {
                    opIdx = i
                    opChar = (c as Char)
                } else if (i > 0) {
                    opIdx = i
                    opChar = (c as Char)
                }
            }
            i = i + 1
        }
        if (opIdx < 0) {
            return ""
        }
        val left: String = DebugSessionUtils.trim(DebugSessionUtils.safeSubstring(expr, 0, opIdx))
        val right: String = DebugSessionUtils.trim(DebugSessionUtils.safeSubstring(expr, opIdx + 1, expr.length))

        val leftVal: Int = lookupInt(left)
        val rightVal: Int = lookupInt(right)
        if (leftVal == 0 && left != "0") { return "" }
        if (rightVal == 0 && right != "0") { return "" }

        val result: Int
        if (opChar == 43) { result = leftVal + rightVal }
        else if (opChar == 45) { result = leftVal - rightVal }
        else if (opChar == 42) { result = leftVal * rightVal }
        else if (opChar == 47) {
            if (rightVal == 0) { return "division by zero" }
            result = leftVal / rightVal
        }
        else { result = leftVal % rightVal }

        return toStr(result)
    }

    /// Look up a variable or integer literal by name, return 0 if not found.
    private fun lookupInt(name: String): Int {
        // Try global variable first
        val g: String = debugVm.getGlobal(name)
        if (g != "") {
            return DebugSessionUtils.tryParseInt(g)
        }
        // Try as integer literal
        return DebugSessionUtils.tryParseInt(name)
    }

    /// Look up a variable by name, return "" if not found.
    fun lookupVariable(name: String): String {
        val g: String = debugVm.getGlobal(name)
        if (g != "") {
            return g
        }
        return ""
    }

    // ═══════════════════════════════════════════════════════════
    //  Watch expressions
    // ═══════════════════════════════════════════════════════════

    /// Add a watch expression, returns the watch ID.
    fun watch(expr: String): Int {
        watchExprs.add(expr)
        println("  Watch #" + toStr(nextWatchId) + ": " + expr)
        nextWatchId = nextWatchId + 1
        return nextWatchId
    }

    /// Remove a watch expression by ID.
    fun unwatch(id: Int): Boolean {
        if (id < 1 || id > nextWatchId - 1) {
            return false
        }
        val idx: Int = id - 1
        if (idx < 0 || idx >= watchExprs.size) {
            return false
        }
        val removed: String = watchExprs.remove(idx)
        println("  Unwatch #" + toStr(id) + ": " + removed)
        return true
    }

    /// Print all watch expressions with their current values.
    fun printWatch(): String {
        if (watchExprs.size == 0) {
            return "  (no watch expressions)"
        }
        var result: String = ""
        var i: Int = 0
        while (i < watchExprs.size) {
            val v: String = eval(watchExprs[i])
            result = result + "  #" + toStr(i + 1) + " " + watchExprs[i] +
                " = " + v + "\n"
            i = i + 1
        }
        return result
    }

    /// Quit the debugger session.
    fun quit(): Int {
        initialized = false
        started = false
        return 0
    }
}

// ═══════════════════════════════════════════════════════════════
// DebugSessionUtils — helper utilities
// ═══════════════════════════════════════════════════════════════

object DebugSessionUtils {

    /// Split text into lines by '\n'.
    fun splitLines(text: String): ArrayList<String> {
        val result: ArrayList<String> = ArrayList<String>()
        var i: Int = 0
        var lineStart: Int = 0
        val len: Int = text.length
        while (i < len) {
            if (text.charCodeAt(i) == 10) {  // '\n'
                result.add(DebugSessionUtils.safeSubstring(text, lineStart, i))
                lineStart = i + 1
            }
            i = i + 1
        }
        if (lineStart < len) {
            result.add(DebugSessionUtils.safeSubstring(text, lineStart, len))
        }
        return result
    }

    /// Split text by '|' delimiter.
    fun splitPipe(text: String): ArrayList<String> {
        val result: ArrayList<String> = ArrayList<String>()
        var i: Int = 0
        var start: Int = 0
        val len: Int = text.length
        while (i < len) {
            if (text.charCodeAt(i) == 124) {  // '|'
                result.add(DebugSessionUtils.safeSubstring(text, start, i))
                start = i + 1
            }
            i = i + 1
        }
        if (start < len) {
            result.add(DebugSessionUtils.safeSubstring(text, start, len))
        }
        return result
    }

    /// Trim leading and trailing whitespace.
    fun trim(text: String): String {
        var start: Int = 0
        var end: Int = text.length
        while (start < end && (text.charCodeAt(start) == 32 || text.charCodeAt(start) == 9 ||
            text.charCodeAt(start) == 10 || text.charCodeAt(start) == 13)) {
            start = start + 1
        }
        while (end > start && (text.charCodeAt(end - 1) == 32 || text.charCodeAt(end - 1) == 9 ||
            text.charCodeAt(end - 1) == 10 || text.charCodeAt(end - 1) == 13)) {
            end = end - 1
        }
        if (start == 0 && end == text.length) {
            return text
        }
        return DebugSessionUtils.safeSubstring(text, start, end)
    }

    /// Convert string to integer (delegates to DebugVmUtils.vrToInt).
    fun toInt(text: String): Int {
        return DebugVmUtils.vrToInt(text)
    }

    /// Try to parse a string as an integer, return 0 on failure.
    fun tryParseInt(text: String): Int {
        var total: Int = 0
        var i: Int = 0
        var neg: Boolean = false
        val len: Int = text.length
        if (len == 0) { return 0 }
        if (text.charCodeAt(0) == 45) {  // '-'
            neg = true
            i = 1
        }
        var foundDigit: Boolean = false
        while (i < len) {
            val c: Int = text.charCodeAt(i)
            if (c < 48 || c > 57) {
                break
            }
            total = total * 10 + (c - 48)
            foundDigit = true
            i = i + 1
        }
        if (!foundDigit) { return 0 }
        if (neg) {
            return -total
        }
        return total
    }

    /// Safe substring with bounds checking (delegates to DebugVmUtils).
    fun safeSubstring(text: String, start: Int, end: Int): String {
        return DebugVmUtils.safeSubstring(text, start, end)
    }

    /// Check if text starts with prefix.
    fun myStartsWith(text: String, prefix: String): Boolean {
        if (prefix.length > text.length) {
            return false
        }
        var i: Int = 0
        while (i < prefix.length) {
            if (text.charCodeAt(i) != prefix.charCodeAt(i)) {
                return false
            }
            i = i + 1
        }
        return true
    }

    /// Parse variable table (format: "name|slot\n" per line) into a HashMap.
    fun parseVarTable(varTable: String): HashMap<String, Int> {
        val map: HashMap<String, Int> = HashMap<String, Int>()
        if (varTable == "") {
            return map
        }
        var pos: Int = 0
        val len: Int = varTable.length
        var lineStart: Int = 0
        while (pos < len) {
            if (varTable.charCodeAt(pos) == 10) {  // '\n'
                val line: String = DebugSessionUtils.safeSubstring(varTable, lineStart, pos)
                if (line.length > 0) {
                    val parts: ArrayList<String> = splitPipe(line)
                    if (parts.size >= 2) {
                        val name: String = parts[0]
                        val slot: Int = DebugVmUtils.vrToInt(parts[1])
                        map.put(name, slot)
                    }
                }
                lineStart = pos + 1
            }
            pos = pos + 1
        }
        // Handle last line (no trailing newline)
        if (lineStart < len) {
            val line: String = DebugSessionUtils.safeSubstring(varTable, lineStart, len)
            if (line.length > 0) {
                val parts: ArrayList<String> = splitPipe(line)
                if (parts.size >= 2) {
                    val name: String = parts[0]
                    val slot: Int = DebugVmUtils.vrToInt(parts[1])
                    map.put(name, slot)
                }
            }
        }
        return map
    }
}
