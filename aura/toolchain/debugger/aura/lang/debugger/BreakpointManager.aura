// aura:///debugger/aura/lang/debugger/BreakpointManager.aura
package aura.lang.debugger

// ── Standard library imports ──
import aura.lang.std.String
import aura.lang.collection.HashMap
import aura.lang.collection.ArrayList

// ── Sibling module imports ──
import "DebugVm.aura"

// ═══════════════════════════════════════════════════════════════
// BreakpointManager — manages breakpoint set
//
// Breakpoints are stored in a HashMap keyed by unique ID.
// Each breakpoint is itself a HashMap<String, String> with fields:
//   id, file, line, funcName, funcOffset, enabled, hitCount, condition
// ═══════════════════════════════════════════════════════════════

class BreakpointManager {
    var breakpoints: HashMap<Int, HashMap<String, String>> = HashMap<Int, HashMap<String, String>>()
    var nextId: Int = 1

    /// Add a breakpoint at file:line, returns the breakpoint ID.
    fun add(file: String, line: Int): Int {
        val id: Int = nextId
        nextId = nextId + 1

        val bp: HashMap<String, String> = HashMap<String, String>()
        bp.put("id", toStr(id))
        bp.put("file", file)
        bp.put("line", toStr(line))
        bp.put("funcName", "")
        bp.put("funcOffset", "-1")
        bp.put("enabled", "true")
        bp.put("hitCount", "0")
        bp.put("condition", "")

        breakpoints.put(id, bp)
        return id
    }

    /// Remove a breakpoint by ID. Returns true if found.
    fun remove(id: Int): Boolean {
        val bp: HashMap<String, String>? = breakpoints.get(id)
        if (bp == null) {
            return false
        }
        breakpoints.remove(id)
        return true
    }

    /// List all breakpoint IDs.
    fun list(): ArrayList<Int> {
        val result: ArrayList<Int> = ArrayList<Int>()
        val keys: List<Int> = breakpoints.keys()
        var i: Int = 0
        while (i < keys.size) {
            result.add(keys[i])
            i = i + 1
        }
        return result
    }

    /// Get a breakpoint by ID.
    fun getBp(id: Int): HashMap<String, String>? {
        return breakpoints.get(id)
    }

    /// Toggle a breakpoint's enabled state.
    fun toggle(id: Int): Boolean {
        val bp: HashMap<String, String>? = breakpoints.get(id)
        if (bp == null) {
            return false
        }
        val enabled: String = bp.get("enabled")
        if (enabled == "true") {
            bp.put("enabled", "false")
        } else {
            bp.put("enabled", "true")
        }
        return true
    }

    /// Set the condition expression for a breakpoint.
    fun setCondition(id: Int, condition: String): Boolean {
        val bp: HashMap<String, String>? = breakpoints.get(id)
        if (bp == null) {
            return false
        }
        bp.put("condition", condition)
        return true
    }

    /// Check if current IP matches any enabled breakpoint. Returns ID or 0.
    fun checkBreakpoint(ip: Int): Int {
        val keys: List<Int> = breakpoints.keys()
        var i: Int = 0
        while (i < keys.size) {
            val bp: HashMap<String, String>? = breakpoints.get(keys[i])
            if (bp != null && bp.get("enabled") == "true") {
                val offset: Int = DebugVmUtils.vrToInt(bp.get("funcOffset"))
                if (offset == ip) {
                    val hits: Int = DebugVmUtils.vrToInt(bp.get("hitCount"))
                    bp.put("hitCount", toStr(hits + 1))
                    return keys[i]
                }
            }
            i = i + 1
        }
        return 0
    }

    /// Print all breakpoints with their state.
    fun printAll(): Unit {
        if (breakpoints.size == 0) {
            println("  No breakpoints")
            return
        }
        println("  Breakpoints:")
        val keys: List<Int> = breakpoints.keys()
        var i: Int = 0
        while (i < keys.size) {
            val bp: HashMap<String, String>? = breakpoints.get(keys[i])
            if (bp != null) {
                var s: String = "  #" + bp.get("id") + " "
                if (bp.get("enabled") == "true") {
                    s = s + "[v] "
                } else {
                    s = s + "[x] "
                }
                s = s + bp.get("file") + ":" + bp.get("line")
                if (bp.get("funcName") != "") {
                    s = s + " (func: " + bp.get("funcName") + ")"
                }
                if (DebugVmUtils.vrToInt(bp.get("funcOffset")) >= 0) {
                    s = s + " @ " + bp.get("funcOffset")
                }
                if (DebugVmUtils.vrToInt(bp.get("hitCount")) > 0) {
                    s = s + " (hits:" + bp.get("hitCount") + ")"
                }
                if (bp.get("condition") != "") {
                    s = s + " if " + bp.get("condition")
                }
                println(s)
            }
            i = i + 1
        }
    }

    /// Count enabled breakpoints.
    fun enabledCount(): Int {
        var count: Int = 0
        val keys: List<Int> = breakpoints.keys()
        var i: Int = 0
        while (i < keys.size) {
            val bp: HashMap<String, String>? = breakpoints.get(keys[i])
            if (bp != null && bp.get("enabled") == "true") {
                count = count + 1
            }
            i = i + 1
        }
        return count
    }

    /// Remove all breakpoints and reset the ID counter.
    fun clearAll(): Unit {
        breakpoints.clear()
        nextId = 1
    }
}
