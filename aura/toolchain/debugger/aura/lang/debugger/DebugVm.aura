// aura:///debugger/aura/lang/debugger/DebugVm.aura
package aura.lang.debugger

// ── Standard library imports ──
import aura.lang.std.String

// ── Collection imports ──
import aura.lang.collection.ArrayList
import aura.lang.collection.HashMap

// ── Standard library imports ──
import aura.lang.std.IO

// ═══════════════════════════════════════════════════════════════
// DebugVmUtils — utility functions for the debug VM
//
// Provides string parsing helpers (vrToInt, safeSubstring,
// myStartsWith) that are safe against encoding issues.
// ═══════════════════════════════════════════════════════════════

/// Utility functions for the debug VM.
object DebugVmUtils {

    /// Parse a string as an integer, returning 0 on failure.
    fun vrToInt(text: String): Int {
        var total: Int = 0
        var i: Int = 0
        val len: Int = text.length
        var neg: Boolean = false
        if (len > 0 && text.charCodeAt(0) == 45) {  // '-'
            neg = true
            i = 1
        }
        while (i < len) {
            val c: Int = text.charCodeAt(i)
            if (c < 48 || c > 57) {
                break
            }
            total = total * 10 + (c - 48)
            i = i + 1
        }
        if (neg) {
            return -total
        }
        return total
    }

    /// Safe substring using charCodeAt + toStr (avoids encoding issues).
    fun safeSubstring(text: String, start: Int, end: Int): String {
        var result: String = ""
        if (start < 0) { start = 0 }
        if (end > text.length) { end = text.length }
        if (start >= end) { return "" }
        var i: Int = start
        while (i < end) {
            result = result + toStr(text[i])
            i = i + 1
        }
        return result
    }

    /// Check if text starts with prefix (avoids encoding issues).
    fun myStartsWith(text: String, prefix: String): Boolean {
        if (prefix.length > text.length) {
            return false
        }
        var i: Int = 0
        while (i < prefix.length) {
            if (text.charCodeAt(i) != prefix.charCodeAt(i)) {
                return false
            }
            i = i + 1
        }
        return true
    }
}

// ═══════════════════════════════════════════════════════════════
// DebugVm — debug-capable VM interpreter
//
// Wraps a single-step execution loop with:
//   1. State inspection (ip, stack, locals, globals, callStack)
//   2. Step modes (in/over/out)
//   3. Breakpoint checking via current IP
//   4. Instruction dispatch for Aura bytecode opcodes
// ═══════════════════════════════════════════════════════════════

/// Debug VM — single-step interpreter with state inspection.
class DebugVm {

    // ── Bytecode data ──
    var bytecode: String = ""
    var constPool: String = ""
    var funcTable: String = ""

    // ── Execution state ──
    var ip: Int = 0
    var instructionCount: Int = 0
    var maxInstructions: Int = 1000000
    var running: Boolean = true
    var paused: Boolean = false
    var error: String = ""
    var returnValue: String = ""

    // ── VM memory ──
    var vmStack: ArrayList<String> = ArrayList<String>()
    var locals: HashMap<Int, String> = HashMap<Int, String>()
    var globals: HashMap<String, String> = HashMap<String, String>()
    var callStack: ArrayList<String> = ArrayList<String>()
    var savedLocals: ArrayList<HashMap<Int, String>> = ArrayList<HashMap<Int, String>>()

    // ── Frame state ──
    var currentFunc: String = ""
    var currentFrame: Int = -1
    var suspended: Boolean = false

    // ── Step control ──
    var stepMode: String = "off"   // "off", "in", "over", "out"
    var stepOverDepth: Int = 0
    var stepOutFunc: String = ""

    // ═══════════════════════════════════════════════════════════
    //  Bytecode loading and execution
    // ═══════════════════════════════════════════════════════════

    /// Load bytecode, constant pool, and function table.
    fun loadBytecode(code: String, consts: String, funcs: String): Unit {
        bytecode = code
        constPool = consts
        funcTable = funcs
        reset()
    }

    /// Reset all VM state.
    fun reset(): Unit {
        ip = 0
        instructionCount = 0
        running = true
        paused = false
        error = ""
        returnValue = ""
        vmStack = ArrayList<String>()
        locals = HashMap<Int, String>()
        globals = HashMap<String, String>()
        callStack = ArrayList<String>()
        savedLocals = ArrayList<HashMap<Int, String>>()
        currentFunc = ""
        currentFrame = -1
        suspended = false
        stepMode = "off"
        stepOverDepth = 0
        stepOutFunc = ""
    }

    /// Start execution at the "main" function.
    fun startExecution(): Unit {
        ip = funcOffset("main")
        currentFunc = "main"
        currentFrame = 0
        running = true
        paused = false
    }

    // ═══════════════════════════════════════════════════════════
    //  Step execution
    // ═══════════════════════════════════════════════════════════

    /// Execute one instruction. Returns stop reason:
    /// "", "step", "completion", "error"
    fun step(): String {
        if (!running) {
            return "completion"
        }

        instructionCount = instructionCount + 1
        if (instructionCount > maxInstructions) {
            error = "Instruction limit exceeded"
            running = false
            return "error"
        }

        val line: String = getBytecodeLine(ip)
        ip = ip + 1
        val opcode: String = parseOpcode(line)

        // Skip comments and labels
        if (opcode == "#" || opcode == "" || opcode == "LABEL") {
            return ""
        }

        val arg1: String = parseArg1(line)
        val arg2: String = parseArg2(line)
        val arg3: String = parseArg3(line)
        dispatch(opcode, arg1, arg2, arg3)

        if (!running) {
            if (error != "") {
                return "error"
            }
            return "completion"
        }

        // Check step mode
        if (stepMode == "in") {
            stepMode = "off"
            return "step"
        } else if (stepMode == "over") {
            // Step over: stop when call stack depth drops back
            if (callStack.size <= stepOverDepth) {
                stepMode = "off"
                return "step"
            }
            return ""
        } else if (stepMode == "out") {
            // Step out: stop when we leave the current function
            if (currentFunc != stepOutFunc) {
                stepMode = "off"
                return "step"
            }
            return ""
        }

        return ""
    }

    /// Dispatch an opcode to its handler.
    fun dispatch(opcode: String, arg1: String, arg2: String, arg3: String): Unit {
        if (opcode == "CONST_INT") {
            push(getConst(arg1))
        } else if (opcode == "CONST_FLOAT") {
            push(getConst(arg1))
        } else if (opcode == "CONST_STRING") {
            push(getConst(arg1))
        } else if (opcode == "CONST_BOOL") {
            push(arg1)
        } else if (opcode == "CONST_NULL") {
            push("null")
        } else if (opcode == "LOAD_LOCAL") {
            push(getLocal(DebugVmUtils.vrToInt(arg1)))
        } else if (opcode == "STORE_LOCAL") {
            setLocal(DebugVmUtils.vrToInt(arg1), pop())
        } else if (opcode == "DECL_LOCAL") {
            setLocal(DebugVmUtils.vrToInt(arg1), "0")
        } else if (opcode == "POP") {
            pop()
        } else if (opcode == "DUP") {
            push(peek())
        } else if (opcode == "ADD") {
            val b: String = pop()
            val a: String = pop()
            push(arithAdd(a, b))
        } else if (opcode == "SUB") {
            val b: String = pop()
            val a: String = pop()
            push(arithSub(a, b))
        } else if (opcode == "MUL") {
            val b: String = pop()
            val a: String = pop()
            push(arithMul(a, b))
        } else if (opcode == "DIV") {
            val b: String = pop()
            val a: String = pop()
            push(arithDiv(a, b))
        } else if (opcode == "MOD") {
            val b: String = pop()
            val a: String = pop()
            push(arithMod(a, b))
        } else if (opcode == "EQ") {
            val b: String = pop()
            val a: String = pop()
            push(eq(a, b))
        } else if (opcode == "NEQ") {
            val b: String = pop()
            val a: String = pop()
            push(neq(a, b))
        } else if (opcode == "LT") {
            val b: String = pop()
            val a: String = pop()
            push(cmpBool(DebugVmUtils.vrToInt(a) < DebugVmUtils.vrToInt(b)))
        } else if (opcode == "GT") {
            val b: String = pop()
            val a: String = pop()
            push(cmpBool(DebugVmUtils.vrToInt(a) > DebugVmUtils.vrToInt(b)))
        } else if (opcode == "LE") {
            val b: String = pop()
            val a: String = pop()
            push(cmpBool(DebugVmUtils.vrToInt(a) <= DebugVmUtils.vrToInt(b)))
        } else if (opcode == "GE") {
            val b: String = pop()
            val a: String = pop()
            push(cmpBool(DebugVmUtils.vrToInt(a) >= DebugVmUtils.vrToInt(b)))
        } else if (opcode == "NEG") {
            val a: String = pop()
            push(toStr(0 - DebugVmUtils.vrToInt(a)))
        } else if (opcode == "NOT") {
            val a: String = pop()
            push(cmpBool(!(a == "true")))
        } else if (opcode == "JUMP") {
            ip = DebugVmUtils.vrToInt(arg1)
        } else if (opcode == "JUMP_IF_FALSE") {
            val cond: String = pop()
            if (cond == "false" || cond == "0" || cond == "") {
                ip = DebugVmUtils.vrToInt(arg1)
            }
        } else if (opcode == "JUMP_IF_TRUE") {
            val cond: String = pop()
            if (cond == "true" || cond == "1") {
                ip = DebugVmUtils.vrToInt(arg1)
            }
        } else if (opcode == "CALL") {
            callOrBuiltin(arg1, DebugVmUtils.vrToInt(arg2))
        } else if (opcode == "RETURN") {
            returnFromFunc()
        } else if (opcode == "YIELD") {
            suspended = true
            running = false
        }
    }

    // ═══════════════════════════════════════════════════════════
    //  Function calls and returns
    // ═══════════════════════════════════════════════════════════

    /// Call a user function or built-in.
    fun callOrBuiltin(name: String, argc: Int): Unit {
        if (name == "println" || name == "print") {
            val text: String = collectArgs(argc)
            if (name == "println") {
                println(text)
            } else {
                print(text)
            }
            push("Unit")
            return
        } else if (name == "toStr" || name == "toString") {
            val v: String = pop()
            push(v)
            return
        } else {
            // User function call
            val target: Int = funcOffset(name)
            val pc: Int = funcParamCount(name)
            if (target <= 0 && pc < 0) {
                error = "unknown function: " + name
                running = false
                return
            }
            // Save return address and frame
            callStack.add(toStr(ip) + "|" + toStr(currentFrame))
            savedLocals.add(locals)
            locals = HashMap<Int, String>()

            // Copy arguments into parameter slots
            var k: Int = pc - 1
            while (k >= 0) {
                setLocal(k, pop())
                k = k - 1
            }

            currentFunc = name
            ip = target
        }
    }

    /// Return from the current function.
    fun returnFromFunc(): Unit {
        var retVal: String = "Unit"
        if (vmStack.size > 0) {
            retVal = pop()
        }
        returnValue = retVal

        if (callStack.size == 0) {
            // Returning from main
            running = false
            return
        }

        val last: String = callStack.get(callStack.size - 1)
        ip = DebugVmUtils.vrToInt(fieldAtSep(last, 0, "|"))
        callStack.remove(callStack.size - 1)
        locals = popSavedLocals()
        currentFrame = DebugVmUtils.vrToInt(fieldAtSep(last, 1, "|"))

        // Push return value for the caller
        push(retVal)
    }

    /// Collect argc arguments from the stack (reversed order).
    fun collectArgs(argc: Int): String {
        if (argc <= 0) {
            return ""
        }
        var result: String = ""
        var i: Int = argc - 1
        while (i >= 0) {
            val v: String = pop()
            if (result == "") {
                result = v
            } else {
                result = v + " " + result
            }
            i = i - 1
        }
        return result
    }

    /// Pop the saved locals for the previous frame.
    fun popSavedLocals(): HashMap<Int, String> {
        if (savedLocals.size == 0) {
            return HashMap<Int, String>()
        }
        return savedLocals.remove(savedLocals.size - 1)
    }

    // ═══════════════════════════════════════════════════════════
    //  Stack operations
    // ═══════════════════════════════════════════════════════════

    fun push(value: String): Unit {
        vmStack.add(value)
    }

    fun pop(): String {
        if (vmStack.size == 0) {
            error = "Stack underflow"
            running = false
            return ""
        }
        return vmStack.remove(vmStack.size - 1)
    }

    fun peek(): String {
        if (vmStack.size == 0) {
            return ""
        }
        return vmStack.get(vmStack.size - 1)
    }

    // ═══════════════════════════════════════════════════════════
    //  Variable access
    // ═══════════════════════════════════════════════════════════

    fun getLocal(slotIdx: Int): String {
        val v = locals.get(slotIdx)
        if (toStr(v) == "null") {
            return "0"
        }
        return v as String
    }

    fun setLocal(slotIdx: Int, value: String): Unit {
        locals.put(slotIdx, value)
    }

    fun getGlobal(name: String): String {
        val v = globals.get(name)
        if (toStr(v) == "null") {
            return ""
        }
        return v as String
    }

    fun setGlobal(name: String, value: String): Unit {
        globals.put(name, value)
    }

    // ═══════════════════════════════════════════════════════════
    //  State accessors
    // ═══════════════════════════════════════════════════════════

    fun getCurrentIp(): Int {
        return ip
    }

    fun getCurrentFunc(): String {
        return currentFunc
    }

    fun getCurrentLine(): String {
        return getBytecodeLine(ip)
    }

    fun getStack(): ArrayList<String> {
        return vmStack
    }

    fun getLocals(): HashMap<Int, String> {
        return locals
    }

    fun getGlobals(): HashMap<String, String> {
        return globals
    }

    fun getCallStack(): ArrayList<String> {
        return callStack
    }

    fun getStackDepth(): Int {
        return vmStack.size
    }

    fun getCallDepth(): Int {
        return callStack.size
    }

    fun getError(): String {
        return error
    }

    fun getReturnValue(): String {
        return returnValue
    }

    fun isRunning(): Boolean {
        return running
    }

    fun getInstructionCount(): Int {
        return instructionCount
    }

    fun getBytecodeLineCount(): Int {
        return bytecodeLineCount()
    }

    // ═══════════════════════════════════════════════════════════
    //  Disassembly
    // ═══════════════════════════════════════════════════════════

    /// Show disassembly around the current IP.
    fun disassemble(context: Int): String {
        val total: Int = bytecodeLineCount()
        var start: Int = ip - context
        if (start < 0) {
            start = 0
        }
        var end: Int = ip + context
        if (end >= total) {
            end = total - 1
        }
        var result: String = ""
        var i: Int = start
        while (i <= end) {
            val line: String = getBytecodeLine(i)
            val prefix: String = if (i == ip) { "> " } else { "  " }
            result = result + prefix + toStr(i) + ": " + line + "\n"
            i = i + 1
        }
        return result
    }

    // ═══════════════════════════════════════════════════════════
    //  Bytecode parsing
    // ═══════════════════════════════════════════════════════════

    /// Count the number of lines in the bytecode.
    fun bytecodeLineCount(): Int {
        var count: Int = 0
        var i: Int = 0
        val len: Int = bytecode.length
        while (i < len) {
            if (bytecode.charCodeAt(i) == 10) {  // '\n'
                count = count + 1
            }
            i = i + 1
        }
        if (bytecode.length > 0 && bytecode.charCodeAt(bytecode.length - 1) != 10) {
            count = count + 1
        }
        return count
    }

    /// Get the line at a given index in the bytecode.
    fun getBytecodeLine(lineIdx: Int): String {
        var pos: Int = 0
        val len: Int = bytecode.length
        var lineStart: Int = 0
        var cur: Int = 0
        while (pos < len) {
            if (bytecode.charCodeAt(pos) == 10) {  // '\n'
                if (cur == lineIdx) {
                    return DebugVmUtils.safeSubstring(bytecode, lineStart, pos)
                }
                cur = cur + 1
                lineStart = pos + 1
            }
            pos = pos + 1
        }
        if (cur == lineIdx) {
            return DebugVmUtils.safeSubstring(bytecode, lineStart, len)
        }
        return ""
    }

    /// Parse the opcode from a bytecode line.
    fun parseOpcode(line: String): String {
        var pos: Int = 0
        val len: Int = line.length
        while (pos < len) {
            if (line.charCodeAt(pos) == 32) {  // ' '
                break
            }
            pos = pos + 1
        }
        return DebugVmUtils.safeSubstring(line, 0, pos)
    }

    /// Parse the first argument from a bytecode line.
    fun parseArg1(line: String): String {
        var pos: Int = 0
        val len: Int = line.length
        // Skip opcode
        while (pos < len && line.charCodeAt(pos) != 32) {
            pos = pos + 1
        }
        pos = pos + 1  // Skip space
        if (pos >= len) {
            return ""
        }
        // Read first argument
        var argStart: Int = pos
        while (pos < len && line.charCodeAt(pos) != 32) {
            pos = pos + 1
        }
        return DebugVmUtils.safeSubstring(line, argStart, pos)
    }

    /// Parse the second argument from a bytecode line.
    fun parseArg2(line: String): String {
        var pos: Int = 0
        val len: Int = line.length
        // Skip opcode
        while (pos < len && line.charCodeAt(pos) != 32) {
            pos = pos + 1
        }
        pos = pos + 1  // Skip space
        // Skip first argument
        while (pos < len && line.charCodeAt(pos) != 32) {
            pos = pos + 1
        }
        if (pos >= len) {
            return ""
        }
        pos = pos + 1  // Skip space
        // Read second argument
        var argStart: Int = pos
        while (pos < len && line.charCodeAt(pos) != 32) {
            pos = pos + 1
        }
        return DebugVmUtils.safeSubstring(line, argStart, pos)
    }

    /// Parse the third argument from a bytecode line.
    fun parseArg3(line: String): String {
        var pos: Int = 0
        val len: Int = line.length
        // Skip opcode
        while (pos < len && line.charCodeAt(pos) != 32) {
            pos = pos + 1
        }
        pos = pos + 1  // Skip space
        // Skip first argument
        while (pos < len && line.charCodeAt(pos) != 32) {
            pos = pos + 1
        }
        if (pos >= len) {
            return ""
        }
        pos = pos + 1  // Skip space
        // Skip second argument
        while (pos < len && line.charCodeAt(pos) != 32) {
            pos = pos + 1
        }
        if (pos >= len) {
            return ""
        }
        pos = pos + 1  // Skip space
        // Read third argument
        var argStart: Int = pos
        while (pos < len && line.charCodeAt(pos) != 32) {
            pos = pos + 1
        }
        return DebugVmUtils.safeSubstring(line, argStart, pos)
    }

    // ═══════════════════════════════════════════════════════════
    //  Constant and function table lookup
    // ═══════════════════════════════════════════════════════════

    /// Get a constant by index from the constant pool.
    fun getConst(idx: String): String {
        return fieldAtRow(constPool, DebugVmUtils.vrToInt(idx))
    }

    // ═══════════════════════════════════════════════════════════
    //  Function table lookup
    // ═══════════════════════════════════════════════════════════

    /// Find the bytecode offset for a function name. Returns -1 if not found.
    fun funcOffset(name: String): Int {
        var pos: Int = 0
        val len: Int = funcTable.length
        var lineStart: Int = 0
        while (pos < len) {
            if (funcTable.charCodeAt(pos) == 10) {  // '\n'
                val line: String = DebugVmUtils.safeSubstring(funcTable, lineStart, pos)
                val colName: String = fieldAtSep(line, 0, "|")
                if (colName == name) {
                    return DebugVmUtils.vrToInt(fieldAtSep(line, 1, "|"))
                }
                lineStart = pos + 1
            }
            pos = pos + 1
        }
        return -1
    }

    /// Find the parameter count for a function name. Returns -1 if not found.
    fun funcParamCount(name: String): Int {
        var pos: Int = 0
        val len: Int = funcTable.length
        var lineStart: Int = 0
        while (pos < len) {
            if (funcTable.charCodeAt(pos) == 10) {  // '\n'
                val line: String = DebugVmUtils.safeSubstring(funcTable, lineStart, pos)
                val colName: String = fieldAtSep(line, 0, "|")
                if (colName == name) {
                    return DebugVmUtils.vrToInt(fieldAtSep(line, 2, "|"))
                }
                lineStart = pos + 1
            }
            pos = pos + 1
        }
        return -1
    }

    // ═══════════════════════════════════════════════════════════
    //  String field parsing utilities
    // ═══════════════════════════════════════════════════════════

    /// Get the index-th line (row) from a newline-delimited text.
    fun fieldAtRow(text: String, index: Int): String {
        var i: Int = 0
        var fieldStart: Int = 0
        var cur: Int = 0
        val fieldLen: Int = text.length
        while (i < fieldLen) {
            if (text.charCodeAt(i) == 10) {  // '\n'
                if (cur == index) {
                    return DebugVmUtils.safeSubstring(text, fieldStart, i)
                }
                cur = cur + 1
                fieldStart = i + 1
            }
            i = i + 1
        }
        if (cur == index) {
            return DebugVmUtils.safeSubstring(text, fieldStart, fieldLen)
        }
        return ""
    }

    /// Get a field at a specific row and column (5-arg version).
    fun fieldAt(text: String, rowIdx: Int, rowSep: String, colSep: String, colIdx: Int): String {
        val line: String = fieldAtRow(text, rowIdx)
        return fieldAtCol(line, colIdx, colSep)
    }

    /// Get a field at a specific column index, separated by sep.
    fun fieldAt(text: String, colIdx: Int, sep: String): String {
        return fieldAtSep(text, colIdx, sep)
    }

    /// Get the index-th field separated by sep.
    fun fieldAtSep(text: String, index: Int, sep: String): String {
        var i: Int = 0
        var fieldStart: Int = 0
        var cur: Int = 0
        val fieldLen: Int = text.length
        val sepCode: Int = sep.charCodeAt(0)
        while (i < fieldLen) {
            if (text.charCodeAt(i) == sepCode) {
                if (cur == index) {
                    return DebugVmUtils.safeSubstring(text, fieldStart, i)
                }
                cur = cur + 1
                fieldStart = i + 1
            }
            i = i + 1
        }
        if (cur == index) {
            return DebugVmUtils.safeSubstring(text, fieldStart, fieldLen)
        }
        return ""
    }

    /// Get the index-th field separated by sep (alias for fieldAtSep).
    fun fieldAtCol(text: String, index: Int, sep: String): String {
        return fieldAtSep(text, index, sep)
    }

    // ═══════════════════════════════════════════════════════════
    //  Arithmetic and comparison helpers
    // ═══════════════════════════════════════════════════════════

    /// Convert boolean to string.
    fun cmpBool(b: Boolean): String {
        if (b) {
            return "true"
        }
        return "false"
    }

    /// Check equality.
    fun eq(a: String, b: String): String {
        if (a == b) {
            return "true"
        }
        return "false"
    }

    /// Check inequality.
    fun neq(a: String, b: String): String {
        if (a == b) {
            return "false"
        }
        return "true"
    }

    /// Integer addition.
    fun arithAdd(a: String, b: String): String {
        return toStr(DebugVmUtils.vrToInt(a) + DebugVmUtils.vrToInt(b))
    }

    /// Integer subtraction.
    fun arithSub(a: String, b: String): String {
        return toStr(DebugVmUtils.vrToInt(a) - DebugVmUtils.vrToInt(b))
    }

    /// Integer multiplication.
    fun arithMul(a: String, b: String): String {
        return toStr(DebugVmUtils.vrToInt(a) * DebugVmUtils.vrToInt(b))
    }

    /// Integer division.
    fun arithDiv(a: String, b: String): String {
        val bb: Int = DebugVmUtils.vrToInt(b)
        if (bb == 0) {
            return "0"
        }
        return toStr(DebugVmUtils.vrToInt(a) / bb)
    }

    /// Integer modulo.
    fun arithMod(a: String, b: String): String {
        val bb: Int = DebugVmUtils.vrToInt(b)
        if (bb == 0) {
            return "0"
        }
        return toStr(DebugVmUtils.vrToInt(a) % bb)
    }
}
