        var pos: Int = 0
        val len: Int = funcTable.length
        var lineStart: Int = 0
        while (pos < len) {
            if (funcTable.charCodeAt(pos) == 10) {  // '\n'
                val line: String = DebugVmUtils.safeSubstring(funcTable, lineStart, pos)
                val colName: String = fieldAt(line, 0, "|")
                if (colName == name) {
                    return DebugVmUtils.vrToInt(fieldAtSep(line, 1, "|"))
                }
                lineStart = pos + 1
            }
            pos = pos + 1
        }
        return -1
    }

