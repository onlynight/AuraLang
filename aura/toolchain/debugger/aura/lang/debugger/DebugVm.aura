    fun getLocal(slotIdx: Int): String {
        val v = locals.get(slotIdx)
        if (toStr(v) == "null") {
            return "0"
        }
        return v as String
    }

    fun setLocal(slotIdx: Int, value: String): Unit {
        locals.put(slotIdx, value)
    }

    fun getGlobal(name: String): String {
        val v = globals.get(name)
        if (toStr(v) == "null") {
            return ""
        }
        return v as String
    }

    fun setGlobal(name: String, value: String): Unit {
        globals.put(name, value)
    }

