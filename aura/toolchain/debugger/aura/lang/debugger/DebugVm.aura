/// DebugVm 閻庤鎮堕崕閬嶅矗鐠恒劉鍋撻悽娈挎敯闁芥牕瀚版俊?object DebugVmUtils {

    /// 闁诲孩绋掗〃鍫ヮ敄娴ｅ湱鈻旈柤鑹板煐缁侇噣鏌℃担鍝ユ憼闁哄棛鍠栭弫宥夊锤閸ф攣rCodeAt 闂佺儵鏅涢悺銊ф暜鐎靛憡濯奸柨娑樺閺嗩剟鏌ㄥ☉妯肩劯婵炴潙鍊垮畷妯侯渻閸撗呪枏濠殿噯绲惧Λ浣烘濠靛鏅璺虹墐閸?    fun vrToInt(text: String): Int {
        var total: Int = 0
        var i: Int = 0
        val len: Int = text.length
        var neg: Boolean = false
        if (len > 0 && text.charCodeAt(0) == 45) {  // '-'
            neg = true
            i = 1
        }
        while (i < len) {
            val c: Int = text.charCodeAt(i)
            if (c < 48 || c > 57) {
                break
            }
            total = total * 10 + (c - 48)
            i = i + 1
        }
        if (neg) {
            return -total
        }
        return total
    }

    /// 闁诲海鎳撻ˇ顖炲矗韫囨洍鍋撳☉娆忓閻熸洖妫濋弫宥夊锤閸炴挤ecode VM 闂佺绻掗崢褔顢欓幇鐗堟櫖婵﹩鍋勯埢蹇涙煟?text[i] + toStr闂佹寧绋戦ˇ顓㈠焵?    fun safeSubstring(text: String, start: Int, end: Int): String {
        var result: String = ""
        if (start < 0) { start = 0 }
        if (end > text.length) { end = text.length }
        if (start >= end) { return "" }
        var i: Int = start
        while (i < end) {
            result = result + toStr(text[i])
            i = i + 1
        }
        return result
    }

    /// 闁诲孩绋掗〃鍫ヮ敄娴ｅ湱鈻旈柛娆忣槹绗戦梺鍛婄啲缂傛碍绂嶉幒妤€绠伴柛銉戝懏姣庨梺鍛婃尭缁夊墎妲愰幋婵愬殨闁逞屽墯瀵板嫭娼忛崜褏顦╅梺鍝勬搐閵囨﹢宕?text.startsWith闂佹寧绋戦ˇ顓㈠焵?    fun myStartsWith(text: String, prefix: String): Boolean {
        if (prefix.length > text.length) {
            return false
        }
        var i: Int = 0
        while (i < prefix.length) {
            if (text.charCodeAt(i) != prefix.charCodeAt(i)) {
                return false
            }
            i = i + 1
        }
        return true
    }
}

