    /// 闂佸吋鍎抽崲鑼躲亹閸モ斁鍋撳☉娆樻畽濠碘槅鍙冮幆宥嗘媴缁涘鏂€闂佽桨娴囬崺鍥焵?    fun bytecodeLineCount(): Int {
        var count: Int = 0
        var i: Int = 0
        val len: Int = bytecode.length
        while (i < len) {
            if (bytecode.charCodeAt(i) == 10) {  // '\n'
                count = count + 1
            }
            i = i + 1
        }
        if (bytecode.length > 0 && bytecode.charCodeAt(bytecode.length - 1) != 10) {
            count = count + 1
        }
        return count
    }

    /// 闂佸吋鍎抽崲鑼躲亹閸ヮ剙绠伴柛銉戝懏姣庨柣鐐寸☉閻厧鈻撻幋鐘亾濞戞瑯娈欏┑鈽嗗弮閹秵鎷呯喊妯轰壕?    fun getBytecodeLine(lineIdx: Int): String {
        var pos: Int = 0
        val len: Int = bytecode.length
        var lineStart: Int = 0
        var cur: Int = 0
        while (pos < len) {
            if (bytecode.charCodeAt(pos) == 10) {  // '\n'
                if (cur == lineIdx) {
                    return DebugVmUtils.safeSubstring(bytecode, lineStart, pos)
                }
                cur = cur + 1
                lineStart = pos + 1
            }
            pos = pos + 1
        }
        if (cur == lineIdx) {
            return DebugVmUtils.safeSubstring(bytecode, lineStart, len)
        }
        return ""
    }

    /// 闁荤喐鐟辩徊楣冩倵娴犲绠伴柛銉檮婵垽鏌ㄥ☉娆庝孩缂佺粯鍨垮畷?opcode闂?    fun parseOpcode(line: String): String {
        var pos: Int = 0
        val len: Int = line.length
        while (pos < len) {
            if (line.charCodeAt(pos) == 32) {  // ' '
                break
            }
            pos = pos + 1
        }
        return DebugVmUtils.safeSubstring(line, 0, pos)
    }

    /// 闁荤喐鐟辩徊楣冩倵娴犲绠伴柛銉檮婵垽鏌ㄥ☉娆庝孩缂佺粯鍨垮畷鍫曟倷濞堝灝鍓虫繛鎴炴尨閸嬫挸鈽夐幙鍐х盎鐎殿噮鍓熷顐︽嚋椤戣棄浜?    fun parseArg1(line: String): String {
        var pos: Int = 0
        val len: Int = line.length
        // 闁荤姴鎼悿鍥╂崲?opcode
        while (pos < len && line.charCodeAt(pos) != 32) {
            pos = pos + 1
        }
        pos = pos + 1  // 闁荤姴鎼悿鍥╂崲閸愵亞鐭氶柣鎴烆焽婢?        if (pos >= len) {
            return ""
        }
