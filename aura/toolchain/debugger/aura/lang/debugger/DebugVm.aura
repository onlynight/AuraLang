    fun push(value: String): Unit {
        vmStack.add(value)
    }

    fun pop(): String {
        if (vmStack.size == 0) {
            error = "Stack underflow"
            running = false
            return ""
        }
        return vmStack.remove(vmStack.size - 1)
    }

    fun peek(): String {
        if (vmStack.size == 0) {
            return ""
        }
        return vmStack.get(vmStack.size - 1)
    }

