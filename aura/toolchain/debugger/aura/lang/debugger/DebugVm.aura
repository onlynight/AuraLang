    // 闂佸磭鍎ら崝蹇涘疾閺屻儱鐓涢柟鑸妽濞呮粓鏌嶉悜妯哄闁哄懏鐓￠崺锟犲箛閵婏附鐝抽梺宕囧劋閸斿繘寮查弻銉ョ厸闁硅埇鍔嶅▍婊堟煃閻戞ê濮€闁哄懏鐓￠崺锟犲箛閵婏附鐝抽梺宕囧劋閸斿繘寮查弻銉ョ厸闁硅埇鍔嶅▍婊堟煃閻戞ê濮€闁哄懏鐓￠崺锟犲箛閵婏附鐝抽梺宕囧劋閸斿繘寮查弻銉ョ厸闁硅埇鍔嶅▍婊堟煃閻戞ê濮€闁哄懏鐓￠崺锟犲箛閵婏附鐝抽梺宕囧劋閸斿繘寮查弻銉ョ厸闁硅埇鍔嶅▍婊堟煃閻戞ê濮€闁哄懏鐓￠崺锟犲箛閵婏附鐝抽梺宕囧劋閸斿繘寮查弻銉ョ厸闁硅埇鍔嶅▍婊堟煃閻戞ê濮€闁哄懏鐓￠崺锟犲箛閵婏附鐝抽梺宕囧劋閸斿繘寮查弻銉ョ厸闁硅埇鍔嶅▍婊堟煃閻戞ê濮€闁哄懏鐓￠崺锟犲箛閵婏附鐝抽梺宕囧劋閸斿繘寮查弻銉ョ厸闁硅埇鍔嶅▍婊堟煃閻戞ê濮€闁哄懏鐓￠崺?
    /// Execute one instruction. Return stop reason: "", "step", "completion", "error"
        // 閻庣懓鎲¤ぐ鍐╃閻樺樊娼?        if (!running) {
            return "completion"
        }

        // 闂佸湱顭堝ú锝夊箮閵堝鏋佸ù鐓庣摠椤庢瑩鏌?        instructionCount = instructionCount + 1
        if (instructionCount > maxInstructions) {
            error = "Instruction limit exceeded"
            running = false
            return "error"
        }

        // 闁荤姴娲╅褑銇愰崶顏備汗闁规儳鍟块·鍛存煙缁嬫寧鐭楅柟?        val line: String = getBytecodeLine(ip)
        ip = ip + 1
        val opcode: String = parseOpcode(line)

        // 闁荤姴鎼悿鍥╂崲閸愩劉鏋栭柕濞炬櫅濞呯偤鎮跺☉妯垮闁归攱澹嗙划姘偊濞嗙偓鏂€
        if (opcode == "#" || opcode == "" || opcode == "LABEL") {
            return ""
        }

        // 闂佸憡甯掑Λ娆徢庨幎钘夌闁搞儻闄勬慨?        val arg1: String = parseArg1(line)
        val arg2: String = parseArg2(line)
        val arg3: String = parseArg3(line)
        dispatch(opcode, arg1, arg2, arg3)

        // 濠碘槅鍋€閸嬫捇鏌＄仦璇插姕婵″弶鎮傚畷銉╂晝閳ь剟宕甸銏＄叆?        if (!running) {
            if (error != "") {
                return "error"
            }
            return "completion"
        }

        // 濠碘槅鍋€閸嬫捇鏌＄仦璇插姎鐎规洜鍠庨～銏ゅΨ鏈担鍓插殨?        if (stepMode == "in") {
            stepMode = "off"
            return "step"
        } else if (stepMode == "over") {
            // 閻熸粎澧楅幑浣烘崲閹达箑鐐婇柣鎰絻閻撳倿鎮规担瑙勭凡缂傚秴绉归幆鍐礋椤旂偓顔嶉梺娲绘娇閸斿秶鎹㈡担瑙勫劅闁挎棁濮らˇ褔鏌涚€ｎ偆鐭嬫い?            if (callStack.size <= stepOverDepth) {
                stepMode = "off"
                return "step"
            }
            return ""
        } else if (stepMode == "out") {
            // 閻熸粎澧楅幐楣冣€栭崶褜鍤曢柍褜鍓濋妵鎰板箻閸愬樊鏋€闂佸憡鍨兼慨銈夊汲閻旂厧绫嶉悹楦挎〃缁粯鎱?            if (currentFunc != stepOutFunc) {
                stepMode = "off"
                return "step"
            }
            return ""
        }

        return ""
    }

    /// 闂佸湱顭堝ú锝夊箮閵堝绀嗛柛鈩兩戦悜锕傛煏?    fun dispatch(opcode: String, arg1: String, arg2: String, arg3: String): Unit {
        if (opcode == "CONST_INT") {
            push(getConst(arg1))
        } else if (opcode == "CONST_FLOAT") {
            push(getConst(arg1))
        } else if (opcode == "CONST_STRING") {
            push(getConst(arg1))
        } else if (opcode == "CONST_BOOL") {
            push(arg1)
        } else if (opcode == "CONST_NULL") {
            push("null")
        } else if (opcode == "LOAD_LOCAL") {
            push(getLocal(DebugVmUtils.vrToInt(arg1)))
        } else if (opcode == "STORE_LOCAL") {
            setLocal(DebugVmUtils.vrToInt(arg1), pop())
        } else if (opcode == "DECL_LOCAL") {
            setLocal(DebugVmUtils.vrToInt(arg1), "0")
        } else if (opcode == "POP") {
            pop()
        } else if (opcode == "DUP") {
            push(peek())
        } else if (opcode == "ADD") {
            val b: String = pop()
            val a: String = pop()
            push(arithAdd(a, b))
        } else if (opcode == "SUB") {
            val b: String = pop()
            val a: String = pop()
            push(arithSub(a, b))
        } else if (opcode == "MUL") {
            val b: String = pop()
            val a: String = pop()
            push(arithMul(a, b))
        } else if (opcode == "DIV") {
            val b: String = pop()
            val a: String = pop()
            push(arithDiv(a, b))
        } else if (opcode == "MOD") {
            val b: String = pop()
            val a: String = pop()
            push(arithMod(a, b))
        } else if (opcode == "EQ") {
            val b: String = pop()
            val a: String = pop()
            push(eq(a, b))
        } else if (opcode == "NEQ") {
            val b: String = pop()
            val a: String = pop()
            push(neq(a, b))
        } else if (opcode == "LT") {
            val b: String = pop()
            val a: String = pop()
            push(cmpBool(DebugVmUtils.vrToInt(a) < DebugVmUtils.vrToInt(b)))
        } else if (opcode == "GT") {
            val b: String = pop()
            val a: String = pop()
            push(cmpBool(DebugVmUtils.vrToInt(a) > DebugVmUtils.vrToInt(b)))
        } else if (opcode == "LE") {
            val b: String = pop()
            val a: String = pop()
            push(cmpBool(DebugVmUtils.vrToInt(a) <= DebugVmUtils.vrToInt(b)))
        } else if (opcode == "GE") {
            val b: String = pop()
            val a: String = pop()
            push(cmpBool(DebugVmUtils.vrToInt(a) >= DebugVmUtils.vrToInt(b)))
        } else if (opcode == "NEG") {
            val a: String = pop()
            push(toStr(0 - DebugVmUtils.vrToInt(a)))
        } else if (opcode == "NOT") {
            val a: String = pop()
            push(cmpBool(!(a == "true")))
        } else if (opcode == "JUMP") {
            ip = DebugVmUtils.vrToInt(arg1)
        } else if (opcode == "JUMP_IF_FALSE") {
            val cond: String = pop()
            if (cond == "false" || cond == "0" || cond == "") {
                ip = DebugVmUtils.vrToInt(arg1)
            }
        } else if (opcode == "JUMP_IF_TRUE") {
            val cond: String = pop()
            if (cond == "true" || cond == "1") {
                ip = DebugVmUtils.vrToInt(arg1)
            }
        } else if (opcode == "CALL") {
            callOrBuiltin(arg1, DebugVmUtils.vrToInt(arg2))
        } else if (opcode == "RETURN") {
            returnFromFunc()
        } else if (opcode == "YIELD") {
            suspended = true
            running = false
        }
        // 闂佸搫鐗滄禍鐐烘偂閿熺姴绠伴柛銉檮婵垽鏌ㄥ☉娆掑闁归鍏橀幃楣冨Ψ椤栨粎顦╂繛?VmRunner 闁荤偞绋戞總鏃傛嫻閻斿摜鈻旈柍褜鍓熼幊娑欐綇閸撗咁槴
    }

    // 闂佸磭鍎ら崝蹇涘疾閺屻儱鐓涢柟鑸妽濞呮粓鏌嶉悜妯哄闁哄懏鐓￠崺锟犲箛閵婏附鐝抽梺宕囧劋閸斿繘寮查弻銉ョ厸闁硅埇鍔嶅▍婊堟煃閻戞ê濮€闁哄懏鐓￠崺锟犲箛閵婏附鐝抽梺宕囧劋閸斿繘寮查弻銉ョ厸闁硅埇鍔嶅▍婊堟煃閻戞ê濮€闁哄懏鐓￠崺锟犲箛閵婏附鐝抽梺宕囧劋閸斿繘寮查弻銉ョ厸闁硅埇鍔嶅▍婊堟煃閻戞ê濮€闁哄懏鐓￠崺锟犲箛閵婏附鐝抽梺宕囧劋閸斿繘寮查弻銉ョ厸闁硅埇鍔嶅▍婊堟煃閻戞ê濮€闁哄懏鐓￠崺锟犲箛閵婏附鐝抽梺宕囧劋閸斿繘寮查弻銉ョ厸闁硅埇鍔嶅▍婊堟煃閻戞ê濮€闁哄懏鐓￠崺锟犲箛閵婏附鐝抽梺宕囧劋閸斿繘寮查弻銉ョ厸闁硅埇鍔嶅▍婊堟煃閻戞ê濮€闁哄懏鐓￠崺锟犲箛閵婏附鐝抽梺宕囧劋閸斿繘寮查弻銉ョ厸闁硅埇鍔嶅▍婊堟煃閻戞ê濮€闁哄懏鐓￠崺?    // 闂佸憡鍨兼慨銈夊汲閻旂儤瀚柛鎰典簼閺?    // 闂佸磭鍎ら崝蹇涘疾閺屻儱鐓涢柟鑸妽濞呮粓鏌嶉悜妯哄闁哄懏鐓￠崺锟犲箛閵婏附鐝抽梺宕囧劋閸斿繘寮查弻銉ョ厸闁硅埇鍔嶅▍婊堟煃閻戞ê濮€闁哄懏鐓￠崺锟犲箛閵婏附鐝抽梺宕囧劋閸斿繘寮查弻銉ョ厸闁硅埇鍔嶅▍婊堟煃閻戞ê濮€闁哄懏鐓￠崺锟犲箛閵婏附鐝抽梺宕囧劋閸斿繘寮查弻銉ョ厸闁硅埇鍔嶅▍婊堟煃閻戞ê濮€闁哄懏鐓￠崺锟犲箛閵婏附鐝抽梺宕囧劋閸斿繘寮查弻銉ョ厸闁硅埇鍔嶅▍婊堟煃閻戞ê濮€闁哄懏鐓￠崺锟犲箛閵婏附鐝抽梺宕囧劋閸斿繘寮查弻銉ョ厸闁硅埇鍔嶅▍婊堟煃閻戞ê濮€闁哄懏鐓￠崺锟犲箛閵婏附鐝抽梺宕囧劋閸斿繘寮查弻銉ョ厸闁硅埇鍔嶅▍婊堟煃閻戞ê濮€闁哄懏鐓￠崺锟犲箛閵婏附鐝抽梺宕囧劋閸斿繘寮查弻銉ョ厸闁硅埇鍔嶅▍婊堟煃閻戞ê濮€闁哄懏鐓￠崺?
    /// 闁荤姴顑呴崯浼村极閵堝绀冮柛娑卞灣閺嬪倿鏌涢幋锝呅撻柡鍡欏枛楠炲寮介锝嗘闂佽娼欓崲鏌ュ吹闁秴鏋侀柤鍓插厴閸?    fun callOrBuiltin(name: String, argc: Int): Unit {
        if (name == "println" || name == "print") {
            val text: String = collectArgs(argc)
            if (name == "println") {
                println(text)
            } else {
                print(text)
            }
            push("Unit")
            return
        } else if (name == "toStr" || name == "toString") {
            val v: String = pop()
            push(v)
            return
        } else {
            // 闂佹椿娼块崝宥夊春濞戙垹绀勯柤鎭掑劜濞堝爼鎮圭€ｎ亜鏆熼柡?            val target: Int = funcOffset(name)
            val pc: Int = funcParamCount(name)
            if (target <= 0 && pc < 0) {
                error = "unknown function: " + name
                running = false
                return
            }
            // 婵烇絽娲︾换鍌炴偤閵婏附浜ら柡鍌涘缁€鈧梺闈╅檮濠㈡ê顭囬崘顔兼そ閻忕偟鏅粔濂告煕閹惧磭孝闁?            callStack.add(toStr(ip) + "|" + toStr(currentFrame))
            savedLocals.add(locals)
            locals = HashMap<Int, String>()

            // 缂傚倷鐒﹂崹鐢告偩閸撗€鍋撻崷顓炰粶鐎殿噮鍓熷畷姘跺级閸喗顥濋梺杞拌兌婢ф娼曟繛杈剧到缁嬪嫮妲愬▎鎾寸劵闁糕剝顨堢喊宥団偓娈垮枤閹虫捇宕甸銏℃櫖?            var k: Int = pc - 1
            while (k >= 0) {
                setLocal(k, pop())
                k = k - 1
            }

            currentFunc = name
            ip = target
        }
    }

    /// 婵炲濮存鎼佸吹闁秴鏋侀柟宄扮灱缁犳煡鏌涢妷褍浜奸柍?    fun returnFromFunc(): Unit {
        var retVal: String = "Unit"
        if (vmStack.size > 0) {
            retVal = pop()
        }
        returnValue = retVal

        if (callStack.size == 0) {
            // 婵犮垼娉涚€氼亞鑺?main 闁汇埄鍨庡鍥╊槷闂佸湱鐟抽崱鈺傛杸缂傚倷鐒﹂幐璇差焽?            running = false
            return
        }

        val last: String = callStack.get(callStack.size - 1)
        ip = DebugVmUtils.vrToInt(fieldAtSep(last, 0, "|"))
        callStack.remove(callStack.size - 1)
        locals = popSavedLocals()
        currentFrame = DebugVmUtils.vrToInt(fieldAtSep(last, 1, "|"))

        // 闂佺娉涢敃銊ф崲閹达箑鐐婇柣鎰ゴ閸嬫捇鎮℃惔锛勵伝闂佹悶鍎抽崑鐘绘儍閻斿吋鍋ㄩ柕濞垮妷閸嬫捇宕ㄩ鎯х伈
        push(retVal)
    }

    /// 閻庢鍠氶幊鎾诲吹?argc 婵炴垶鎼╂禍婊堟偪閸曨垰鐭楅柛灞句亢鐎氭瑩鏌熺粙娆炬Ч缂侇煈鍠楅妵鍕传閸曨厾顣查梺鐟板槻閸氬鏁幘顔嘉?    fun collectArgs(argc: Int): String {
        if (argc <= 0) {
            return ""
        }
        var result: String = ""
        var i: Int = argc - 1
        while (i >= 0) {
            val v: String = pop()
            if (result == "") {
                result = v
            } else {
                result = v + " " + result
            }
            i = i - 1
        }
        return result
    }

    /// 閻庢鍠氶幊鎾诲吹椤撱垹瀚夐柍褜鍓熷畷銉︽償濠靛牜浼囨繛鎴炴惄娴滄瑧鎹㈠鎵佸亾濞戞瑯鐒芥繛鍫熷灩娴狅箓鍩€椤掑嫭鐒鹃柕濞垮劚缂嶄線姊洪幓鎺旂婵炵》绻濇俊?    fun popSavedLocals(): HashMap<Int, String> {
        if (savedLocals.size == 0) {
            return HashMap<Int, String>()
        }
        return savedLocals.remove(savedLocals.size - 1)
    }

