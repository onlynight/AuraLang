    fun getCurrentIp(): Int {
        return ip
    }

    fun getCurrentFunc(): String {
        return currentFunc
    }

    fun getCurrentLine(): String {
        return getBytecodeLine(ip)
    }

    fun getStack(): ArrayList<String> {
        return vmStack
    }

    fun getLocals(): HashMap<Int, String> {
        return locals
    }

    fun getGlobals(): HashMap<String, String> {
        return globals
    }

    fun getCallStack(): ArrayList<String> {
        return callStack
    }

    fun getStackDepth(): Int {
        return vmStack.size
    }

    fun getCallDepth(): Int {
        return callStack.size
    }

    fun getError(): String {
        return error
    }

    fun getReturnValue(): String {
        return returnValue
    }

    fun isRunning(): Boolean {
        return running
    }

    fun getInstructionCount(): Int {
        return instructionCount
    }

    fun getBytecodeLineCount(): Int {
        return bytecodeLineCount()
    }

    /// 闂佸憡鐟ョ粔鐢告儑閸︻厾纾介柡宓懐歇闂佸憡鎸哥粔鐢碘偓鍨缁傛帡濡舵径瀣碘偓宥夊级閳哄倸鐏熼柍?    fun disassemble(context: Int): String {
        val total: Int = bytecodeLineCount()
        var start: Int = ip - context
        if (start < 0) {
            start = 0
        }
        var end: Int = ip + context
        if (end >= total) {
            end = total - 1
        }
        var result: String = ""
        var i: Int = start
        while (i <= end) {
            val line: String = getBytecodeLine(i)
            val prefix: String = if (i == ip) { "> " } else { "  " }
            result = result + prefix + toStr(i) + ": " + line + "\n"
            i = i + 1
        }
        return result
    }

