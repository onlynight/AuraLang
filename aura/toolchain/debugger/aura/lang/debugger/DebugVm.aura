    /// 闂佸憡鐟﹂悧婊堫敄?index 闁荤偞绋戦惌澶屾濮楃单 闂佸憡甯掑Λ婵嗏枔瑜旈弫宥嗗緞閸艾浜?    fun fieldAtRow(text: String, index: Int): String {
        var i: Int = 0
        var fieldStart: Int = 0
        var cur: Int = 0
        val fieldLen: Int = text.length
        while (i < fieldLen) {
            if (text.charCodeAt(i) == 10) {  // '\n'
                if (cur == index) {
                    return DebugVmUtils.safeSubstring(text, fieldStart, i)
                }
                cur = cur + 1
                fieldStart = i + 1
            }
            i = i + 1
        }
        if (cur == index) {
            return DebugVmUtils.safeSubstring(text, fieldStart, fieldLen)
        }
        return ""
    }

    /// 闂佸憡鐟﹂悧婊堫敄?rowIdx 闁荤偞绋戠悮顐﹀焵椤戣儻鍏屾い?colIdx 闂佸憡甯楅〃鍫濃枔閹达箑纾圭紒妤勩€€閸?    fun fieldAt(text: String, rowIdx: Int, rowSep: String, colSep: String, colIdx: Int): String {
        val line: String = fieldAtRow(text, rowIdx)
        return fieldAtCol(line, colIdx, colSep)
    }

    /// 闂佸憡鐟﹂悧婊堫敄?index 婵炴垶鎼╂禍娆愮?sep 闂佸憡甯掑Λ婵嗏枔瑜旈幆鍐礋椤愩倖鎲诲┑鐐茬墢閸嬶綁鍩€?    fun fieldAtSep(text: String, index: Int, sep: String): String {
        var i: Int = 0
        var fieldStart: Int = 0
        var cur: Int = 0
        val fieldLen: Int = text.length
        val sepCode: Int = sep.charCodeAt(0)
        while (i < fieldLen) {
            if (text.charCodeAt(i) == sepCode) {
                if (cur == index) {
                    return DebugVmUtils.safeSubstring(text, fieldStart, i)
                }
                cur = cur + 1
                fieldStart = i + 1
            }
            i = i + 1
        }
        if (cur == index) {
            return DebugVmUtils.safeSubstring(text, fieldStart, fieldLen)
        }
        return ""
    }

    /// 闂佸憡鐟﹂悧婊堫敄?index 闂佸憡甯楅妵婊堝焵?    fun fieldAtCol(text: String, index: Int, sep: String): String {
        return fieldAtSep(text, index, sep)
    }

