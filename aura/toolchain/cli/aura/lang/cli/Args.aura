// aura:///cli/aura/lang/cli/Args.aura
package aura.lang.cli

import aura.lang.native.process.ProcessNative

// ═══════════════════════════════════════════════════════════════
// 命令行参数解析
// ═══════════════════════════════════════════════════════════════

/// 命令行参数容器（基于字符串缓冲，避免 ArrayList 字段访问 bug）
class Args {
    private var buffer: String = ""
    private var count: Int = 0

    constructor() {
        buffer = ""
        count = 0
    }

    fun add(arg: String): Unit {
        if (count > 0) {
            buffer = buffer + "\n" + arg
        } else {
            buffer = arg
        }
        count = count + 1
    }

    fun get(index: Int): String {
        val parts = buffer.split("\n")
        if (index < 0 || index >= count) {
            return ""
        }
        return parts.getAt(index)
    }

    fun size(): Int {
        return count
    }

    fun isEmpty(): Boolean {
        return count == 0
    }

    fun hasFlag(flag: String): Boolean {
        var i: Int = 0
        while (i < count) {
            if (get(i) == flag) {
                return true
            }
            i = i + 1
        }
        return false
    }

    fun getValue(flag: String): String {
        var i: Int = 0
        while (i < count - 1) {
            if (get(i) == flag) {
                return get(i + 1)
            }
            i = i + 1
        }
        return ""
    }
}

/// 参数解析工具对象
object ArgsUtils {
    fun parseArgs(): Args {
        val args = Args()
        val count: Int = ProcessNative.argCount()
        var i: Int = 1
        while (i < count) {
            args.add(ProcessNative.arg(i))
            i = i + 1
        }
        return args
    }
}