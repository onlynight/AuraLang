// aura:///cli/aura/lang/cli/Args.aura
package aura.lang.cli

import aura.lang.std.String
import aura.lang.std.Env

// ═══════════════════════════════════════════════════════════════
// 命令行参数解析
// ═══════════════════════════════════════════════════════════════

/// 命令行参数容器（基于字符串缓冲，避免 ArrayList 字段访问 bug）
class Args {
    private var buffer: String = ""
    private var count: Int = 0

    constructor() {
        buffer = ""
        count = 0
    }

    fun add(arg: String): Unit {
        if (count > 0) {
            buffer = buffer + "\n" + arg
        } else {
            buffer = arg
        }
        count = count + 1
    }

    fun get(index: Int): String {
        if (index < 0 || index >= count) {
            return ""
        }
        // 手动按 '\n' 切分——`split` 返回的 `List` 在引导 VM 下取元素
        // （`getAt` / 下标）无法解析，见 `core/collection/ArrayList.aura` 注释。
        var start: Int = 0
        var i: Int = 0
        var seen: Int = 0
        while (seen < index) {
            if (i >= buffer.length) {
                return ""
            }
            val c: String = buffer.substring(i, i + 1)
            if (c == "\n") {
                start = i + 1
                seen = seen + 1
            }
            i = i + 1
        }
        var end: Int = start
        while (end < buffer.length && buffer.substring(end, end + 1) != "\n") {
            end = end + 1
        }
        return buffer.substring(start, end)
    }

    fun size(): Int {
        return count
    }

    fun isEmpty(): Boolean {
        return count == 0
    }

    fun hasFlag(flag: String): Boolean {
        var i: Int = 0
        while (i < count) {
            if (get(i) == flag) {
                return true
            }
            i = i + 1
        }
        return false
    }

    fun getValue(flag: String): String {
        var i: Int = 0
        while (i < count - 1) {
            if (get(i) == flag) {
                return get(i + 1)
            }
            i = i + 1
        }
        return ""
    }
}

/// 参数解析工具对象
object ArgsUtils {

    /// 通过环境变量获取参数个数（VM 下 ProcessNative 不可用时的降级路径）。
    fun envArgCount(): Int {
        val s: String = Env.get("AURA_ARGV_COUNT", "")
        if (s == "") {
            return -1
        }
        var n: Int = 0
        var k: Int = 0
        while (k < s.length) {
            val c: Int = s.charCodeAt(k)
            if (c < 48 || c > 57) {
                return -1
            }
            n = n * 10 + (c - 48)
            k = k + 1
        }
        return n
    }

    /// 通过环境变量获取第 i 个参数。
    fun envArg(i: Int): String {
        return Env.get("AURA_ARG_" + toStr(i), "")
    }

    fun parseArgs(): Args {
        val args = Args()
        val envN: Int = ArgsUtils.envArgCount()
        if (envN >= 0) {
            var i: Int = 1
            while (i < envN) {
                args.add(ArgsUtils.envArg(i))
                i = i + 1
            }
            return args
        }
        return args
    }
}