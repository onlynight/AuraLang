/// AOT 编译源码 → LLVM IR 文本
fun codegenCompile(src: String): String {
    val p = Parser(src)
    p.parseProgram()
    if (p.errors.count > 0) {
        return "error: parse errors: " + toStr(p.errors.count)
    }
    val hl = HirLowerer()
    hl.lower(p.ast)
    val options = defaultAotOptions()
    val gen = AotCodeGenerator()
    val result = gen.compile(hl.hir, options)
    return result.llvmIr
}

/// VM 执行源码 → exit code
fun vmRun(src: String): Int {
    val p = Parser(src)
    p.parseProgram()
    if (p.errors.count > 0) {
        Console.println("Parse errors: " + toStr(p.errors.count))
        return 1
    }
    val checker = TypeChecker()
    checker.tcCheck(p.ast)
    val hl = HirLowerer()
    hl.lower(p.ast)
    val ml = MirLowerer()
    ml.lower(hl.hir)
    val cg = Codegen()
    val bytecode = cg.emit(ml.mir)
    val vm = VmRunner()
    vm.loadBytecode(bytecode, cg.constPoolStr(), cg.funcTableStr())
    vm.run()
    return 0
}

/// 语义检查 → 错误信息字符串
fun semaCheck(src: String): String {
    val p = Parser(src)
    p.parseProgram()
    if (p.errors.count > 0) {
        return "error: " + toStr(p.errors.count) + " parse errors"
    }
    val checker = TypeChecker()
    checker.tcCheck(p.ast)
    val errors = checker.tcGetErrors()
    if (errors.count > 0) {
        return "error: " + toStr(errors.count) + " semantic errors"
    }
    return "ok"
}

/// 反汇编 .auc → 反汇编文本
fun codegenDisasm(src: String): String {
    return "disasm: " + src
}

/// 词法分析 → token 列表字符串
fun lexerTokenize(src: String): String {
    val p = Parser(src)
    p.parseProgram()
    var result: String = ""
    var i: Int = 0
    while (i < p.n) {
        result = result + p.prKind(i) + ":" + p.prLit(i) + "\n"
        i = i + 1
    }
    return result
}

/// AST 打印 → AST 文本
fun astToString(src: String): String {
    val p = Parser(src)
    p.parseProgram()
    return "ast: " + p.ast.toStr()
}

/// 格式化代码 → 格式化后的源码（简化：原样返回）
fun fmtFormat(src: String): String {
    return src
}

/// 格式化检查 → exit code (0=已格式化, 1=未格式化)
fun fmtCheck(src: String): Int {
    return 0
}

/// 生成文档 → HTML 文本（简化）
fun docGenerate(src: String): String {
    return "<html><body>" + src + "</body></html>"
}

/// 执行表达式 → 结果字符串
fun evalExec(expr: String): String {
    val wrapper: String = "fun main() { " + expr + " }"
    val p = Parser(wrapper)
    p.parseProgram()
    if (p.errors.count > 0) {
        return "error: parse errors: " + toStr(p.errors.count)
    }
    val checker = TypeChecker()
    checker.tcCheck(p.ast)
    val hl = HirLowerer()
    hl.lower(p.ast)
    val ml = MirLowerer()
    ml.lower(hl.hir)
    val cg = Codegen()
    val bytecode = cg.emit(ml.mir)
    val vm = VmRunner()
    vm.loadBytecode(bytecode, cg.constPoolStr(), cg.funcTableStr())
    val out = vm.run()
    return toStr(out)
}

/// 创建包 → 包路径字符串
fun packageCreate(src: String): String {
    return "package: " + src
}

/// 检查包 → 检查信息字符串
fun packageInspect(src: String): String {
    return "inspect: " + src
}

/// 验证包 → 验证信息字符串
fun packageVerify(src: String): String {
    return "verify: " + src
}

/// 导出 C ABI 头文件 → 头文件文本
fun exportHeader(src: String): String {
    return "extern \"C\" {\n// " + src + "\n}"
}

/// 内存泄漏检查 → 检查信息字符串
fun leakCheck(src: String): String {
    return "leak check: " + src
}
