// ═══════════════════════════════════════════════════════════════
// 编译器 API 包装（纯 Aura，调用编译器模块）
//
// 所有顶层函数均收敛到 CompilerApiUtils 对象中，
// 避免顶层游离方法在 AOT 无 GC 下增加静态符号数。
// ═══════════════════════════════════════════════════════════════

/// 编译器 API 工具对象
object CompilerApiUtils {

    // ─────────────────────────────────────────────────────────────
    // 路径辅助（AOT 产物路径推导）
    // ─────────────────────────────────────────────────────────────

    /// 取路径的目录部分（无分隔符返回 "."）。
    fun cliDirOf(p: String): String {
        var i: Int = p.length - 1
        while (i >= 0) {
            val cc: Int = p.charCodeAt(i)
            if (cc == 47 || cc == 92) {
                return p.substring(0, i)
            }
            i = i - 1
        }
        return "."
    }

    /// 取路径的文件名主干（去目录与最后一个扩展名）。
    fun cliStemOf(p: String): String {
        var start: Int = 0
        var i: Int = 0
        while (i < p.length) {
            val cc: Int = p.charCodeAt(i)
            if (cc == 47 || cc == 92) {
                start = i + 1
            }
            i = i + 1
        }
        var name: String = p.substring(start, p.length)
        var dot: Int = -1
        var j: Int = 0
        while (j < name.length) {
            if (name.charCodeAt(j) == 46) {
                dot = j
            }
            j = j + 1
        }
        if (dot > 0) {
            name = name.substring(0, dot)
        }
        return name
    }

    /// 取路径的目录前缀（含尾部分隔符；无分隔符返回 ""）。
    fun cliBaseDirOf(p: String): String {
        var i: Int = p.length - 1
        var found: Int = -1
        while (i >= 0) {
            val cc: Int = p.charCodeAt(i)
            if (cc == 47 || cc == 92) {
                found = i
                break
            }
            i = i - 1
        }
        if (found < 0) {
            return ""
        }
        return p.substring(0, found + 1)
    }

    // ─────────────────────────────────────────────────────────────
    // 编译管线（VM 路径）
    // ─────────────────────────────────────────────────────────────

    /// 源码 → LLVM IR 文本（AOT 路径前半段）。
    fun codegenCompile(src: String): String {
        val p = Parser(src)
        p.parseProgram()
        if (p.errors.count > 0) {
            return "error: parse errors: " + toStr(p.errors.count)
        }
        val hl = HirLowerer()
        hl.lower(p.ast)
        val options = AotUtils.defaultAotOptions()
        val result = AotUtils.aotCompile(hl.hir, options)
        return result.llvmIr
    }

    /// VM 执行源码 → exit code（AOT 路径：写入临时文件，编译为原生 exe 并执行）。
    fun vmRun(src: String): Int {
        val p = Parser(src)
        p.parseProgram()
        if (p.errors.count > 0) {
            println("Parse errors: " + toStr(p.errors.count))
            return 1
        }
        val checker = TypeChecker()
        checker.tcCheck(p.ast)
        if (checker.tcGetErrors().count > 0) {
            println("Semantic errors: " + toStr(checker.tcGetErrors().count))
            return 1
        }
        // 写入临时文件，使用 AOT 路径编译并执行
        val tmpPath: String = "build/tmp/vmrun_src.aura"
        FileSystem.mkdirP("build/tmp")
        FileSystem.writeText(tmpPath, src)
        val outDir: String = "build/tmp"
        val outPath: String = "build/tmp/vmrun_exe"
        val code: Int = CompilerApiUtils.aotBuildExeFile(tmpPath, outPath, "")
        if (code != 0) {
            return 1
        }
        // 执行编译后的 exe（Windows 路径需反斜杠）
        val exePath: String = AotUtils.aotWinPath(outPath + ".exe")
        val runCode: Int = ProcessNative.run(exePath)
        return runCode
    }

    /// 语义检查 → 错误信息字符串。
    fun semaCheck(src: String): String {
        val p = Parser(src)
        p.parseProgram()
        if (p.errors.count > 0) {
            return "error: " + toStr(p.errors.count) + " parse errors"
        }
        val checker = TypeChecker()
        checker.tcCheck(p.ast)
        val errors = checker.tcGetErrors()
        if (errors.count > 0) {
            return "error: " + toStr(errors.count) + " semantic errors"
        }
        return "ok"
    }

    /// 词法分析 → token 列表字符串。
    fun lexerTokenize(src: String): String {
        val p = Parser(src)
        p.parseProgram()
        var result: String = ""
        var i: Int = 0
        while (i < p.n) {
            result = result + p.prsKind(i) + ":" + p.prsLit(i) + "\n"
            i = i + 1
        }
        return result
    }

    /// AST 打印 → AST 文本。
    fun astToString(src: String): String {
        val p = Parser(src)
        p.parseProgram()
        var result: String = "AST (" + toStr(p.ast.count) + " nodes):\n"
        var i: Int = 0
        while (i < p.ast.count) {
            result = result + "  [" + toStr(i) + "] " + p.ast.kindOf(i)
            val txt = p.ast.textOf(i)
            if (txt.length > 0) {
                result = result + " " + txt
            }
            result = result + "\n"
            i = i + 1
        }
        return result
    }

    /// 格式化代码 → 格式化后的源码（简化：原样返回）。
    fun fmtFormat(src: String): String {
        return src
    }

    /// 格式化检查 → exit code (0=已格式化, 1=未格式化)。
    fun fmtCheck(src: String): Int {
        return 0
    }

    /// 生成文档 → HTML 文本（简化）。
    fun docGenerate(src: String): String {
        return "<html><body><pre>" + src + "</pre></body></html>"
    }

    /// 执行表达式 → 结果字符串（AOT 路径：写入临时文件，编译为原生 exe 并执行）。
    fun evalExec(expr: String): String {
        val wrapper: String = "fun main() { val _r: Any = " + expr + "; println(toStr(_r)) }"
        val tmpPath: String = "build/tmp/eval_src.aura"
        FileSystem.mkdirP("build/tmp")
        FileSystem.writeText(tmpPath, wrapper)
        val outPath: String = "build/tmp/eval_exe"
        val code: Int = CompilerApiUtils.aotBuildExeFile(tmpPath, outPath, "")
        if (code != 0) {
            return "error: AOT compilation failed"
        }
        val exePath: String = AotUtils.aotWinPath(outPath + ".exe")
        val runCode: Int = ProcessNative.run(exePath)
        if (runCode != 0) {
            return "error: execution failed with code " + toStr(runCode)
        }
        return "evaluated (exit code: " + toStr(runCode) + ")"
    }

    /// 导出 C ABI 头文件 → 头文件文本。
    fun exportHeader(src: String): String {
        return "/* Auto-generated C ABI header */\nextern \"C\" {\n// " + src + "\n}\n"
    }

    /// 内存泄漏检查 → 检查信息字符串。
    fun leakCheck(src: String): String {
        return "leak check: " + src
    }

    // ─────────────────────────────────────────────────────────────
    // AOT：源文件（含递归 import）→ 原生可执行文件
    // ─────────────────────────────────────────────────────────────

    /// AOT 编译源文件 → 原生可执行文件；返回退出码（0 成功）。
    ///
    /// 与 VM 路径的区别：先经 `AotModuleLinker` 合并入口文件及其递归 import，
    /// 再交给 Aura 侧 AOT 后端（HIR → LLVM IR → llc → clang → exe）。
    fun aotBuildExeFile(inputPath: String, outPath: String, llvmHome: String): Int {
        val linker = AotModuleLinker()
        val hir: Hir = linker.link(inputPath)
        val home: String = if (llvmHome.length > 0) {
            llvmHome
        } else {
            AotUtils.llvmHomeDefault()
        }
        val r = AotUtils.aotBuildExeFromHirEx(hir, cliStemOf(outPath), cliDirOf(outPath),
            home, cliBaseDirOf(inputPath))
        if (r.ok) {
            println("✓ Executable generated: " + r.exePath)
            return 0
        }
        println("Error: AOT compilation failed")
        println("  llc=" + toStr(r.llcExit) + " clang=" + toStr(r.clangExit))
        if (r.irError != "") {
            println("  IR error: " + r.irError)
        }
        return 1
    }
}