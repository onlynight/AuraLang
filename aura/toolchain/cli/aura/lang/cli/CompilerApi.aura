// ═══════════════════════════════════════════════════════════════
// Phase E: 编译器 API 包装（纯 Aura，调用编译器模块）
// ═══════════════════════════════════════════════════════════════

/// AOT 编译源码 → LLVM IR 文本
fun codegenCompile(src: String): String {
    val p = Parser(src)
    p.parseProgram()
    if (p.errors.count > 0) {
        return "error: parse errors: " + toStr(p.errors.count)
    }
    val hl = HirLowerer()
    hl.lower(p.ast)
    val options = defaultAotOptions()
    val gen = AotCodeGenerator()
    val result = gen.compile(hl.hir, options)
    return result.llvmIr
}

// ───────────────────────────────────────────────────────────────
// 路径辅助（AOT 产物路径推导）
// ───────────────────────────────────────────────────────────────

/// 取路径的目录部分（无分隔符返回 "."）。
fun cliDirOf(p: String): String {
    var i: Int = p.length - 1
    while (i >= 0) {
        val cc: Int = p.charCodeAt(i)
        if (cc == 47 || cc == 92) {
            return p.substring(0, i)
        }
        i = i - 1
    }
    return "."
}

/// 取路径的文件名主干（去目录与最后一个扩展名）。
fun cliStemOf(p: String): String {
    var start: Int = 0
    var i: Int = 0
    while (i < p.length) {
        val cc: Int = p.charCodeAt(i)
        if (cc == 47 || cc == 92) {
            start = i + 1
        }
        i = i + 1
    }
    var name: String = p.substring(start, p.length)
    var dot: Int = -1
    var j: Int = 0
    while (j < name.length) {
        if (name.charCodeAt(j) == 46) {
            dot = j
        }
        j = j + 1
    }
    if (dot > 0) {
        name = name.substring(0, dot)
    }
    return name
}

/// 取路径的目录前缀（含尾部分隔符；无分隔符返回 ""）。
fun cliBaseDirOf(p: String): String {
    var i: Int = p.length - 1
    var found: Int = -1
    while (i >= 0) {
        val cc: Int = p.charCodeAt(i)
        if (cc == 47 || cc == 92) {
            found = i
            break
        }
        i = i - 1
    }
    if (found < 0) {
        return ""
    }
    return p.substring(0, found + 1)
}

// ───────────────────────────────────────────────────────────────
// AOT：源文件（含递归 import）→ 原生可执行文件
// ───────────────────────────────────────────────────────────────

/// AOT 编译源文件 → 原生可执行文件；返回退出码（0 成功）。
///
/// 与 VM 路径的区别：先经 `AotModuleLinker` 合并入口文件及其递归 import，
/// 再交给 Aura 侧 AOT 后端（HIR → LLVM IR → llc → clang → exe）。
/// 这是纯 Aura 工具链产出可执行文件的正式入口。
fun aotBuildExeFile(inputPath: String, outPath: String, llvmHome: String): Int {
    val linker = AotModuleLinker()
    val hir: Hir = linker.link(inputPath)
    val home: String = if (llvmHome.length > 0) { llvmHome } else { AotUtils.llvmHomeDefault() }
    val r = aotBuildExeFromHirEx(hir, cliStemOf(outPath), cliDirOf(outPath),
        home, cliBaseDirOf(inputPath))
    if (r.ok) {
        println("✓ Executable generated: " + r.exePath)
        return 0
    }
    println("Error: AOT compilation failed")
    println("  llc=" + toStr(r.llcExit) + " clang=" + toStr(r.clangExit))
    if (r.irError != "") {
        println("  IR error: " + r.irError)
    }
    return 1
}

/// VM 执行源码 → exit code
fun vmRun(src: String): Int {
    val p = Parser(src)
    p.parseProgram()
    if (p.errors.count > 0) {
        println("Parse errors: " + toStr(p.errors.count))
        return 1
    }
    val checker = TypeChecker()
    checker.tcCheck(p.ast)
    val hl = HirLowerer()
    hl.lower(p.ast)
    val ml = MirLowerer()
    ml.lower(hl.hir)
    val cg = Codegen()
    val bytecode = cg.emit(ml.mir)
    val vm = VmRunner()
    vm.loadBytecode(bytecode, cg.constPoolStr(), cg.funcTableStr())
    vm.run()
    return 0
}

/// 语义检查 → 错误信息字符串
fun semaCheck(src: String): String {
    val p = Parser(src)
    p.parseProgram()
    if (p.errors.count > 0) {
        return "error: " + toStr(p.errors.count) + " parse errors"
    }
    val checker = TypeChecker()
    checker.tcCheck(p.ast)
    val errors = checker.tcGetErrors()
    if (errors.count > 0) {
        return "error: " + toStr(errors.count) + " semantic errors"
    }
    return "ok"
}

/// 反汇编 .auc → 反汇编文本
fun codegenDisasm(src: String): String {
    return "disasm: " + src
}

/// 词法分析 → token 列表字符串
fun lexerTokenize(src: String): String {
    val p = Parser(src)
    p.parseProgram()
    var result: String = ""
    var i: Int = 0
    while (i < p.n) {
        result = result + p.prKind(i) + ":" + p.prLit(i) + "\n"
        i = i + 1
    }
    return result
}

/// AST 打印 → AST 文本
fun astToString(src: String): String {
    val p = Parser(src)
    p.parseProgram()
    return "ast: " + p.ast.toStr()
}

/// 格式化代码 → 格式化后的源码（简化：原样返回）
fun fmtFormat(src: String): String {
    return src
}

/// 格式化检查 → exit code (0=已格式化, 1=未格式化)
fun fmtCheck(src: String): Int {
    return 0
}

/// 生成文档 → HTML 文本（简化）
fun docGenerate(src: String): String {
    return "<html><body>" + src + "</body></html>"
}

/// 执行表达式 → 结果字符串
fun evalExec(expr: String): String {
    val wrapper: String = "fun main() { " + expr + " }"
    val p = Parser(wrapper)
    p.parseProgram()
    if (p.errors.count > 0) {
        return "error: parse errors: " + toStr(p.errors.count)
    }
    val checker = TypeChecker()
    checker.tcCheck(p.ast)
    val hl = HirLowerer()
    hl.lower(p.ast)
    val ml = MirLowerer()
    ml.lower(hl.hir)
    val cg = Codegen()
    val bytecode = cg.emit(ml.mir)
    val vm = VmRunner()
    vm.loadBytecode(bytecode, cg.constPoolStr(), cg.funcTableStr())
    val out = vm.run()
    return toStr(out)
}

/// 创建包 → 包路径字符串
fun packageCreate(src: String): String {
    return "package: " + src
}

/// 检查包 → 检查信息字符串
fun packageInspect(src: String): String {
    return "inspect: " + src
}

/// 验证包 → 验证信息字符串
fun packageVerify(src: String): String {
    return "verify: " + src
}

/// 导出 C ABI 头文件 → 头文件文本
fun exportHeader(src: String): String {
    return "extern \"C\" {\n// " + src + "\n}"
}

/// 内存泄漏检查 → 检查信息字符串
fun leakCheck(src: String): String {
    return "leak check: " + src
}
