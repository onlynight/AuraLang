// aura:///cli/aura/lang/cli/FileIO.aura
package aura.lang.cli

import aura.lang.std.String
import aura.lang.std.FileSystem
import aura.lang.native.Syscalls
import aura.lang.native.file.FileOps
import aura.lang.native.memory.Allocator
import aura.lang.native.Memory

// ═══════════════════════════════════════════════════════════════
// 文件 I/O 辅助
//
// 读/写统一委托给已验证的标准库实现（`Stdio.readFile` / `writeFile`）。
// 旧实现用 `FileOps` + 逐字节 `String.fromCharCode` 手工拼串，在 AOT 下
// 依赖 `String.fromCharCode` 的表示，实测会崩溃（0xC0000409），故弃用。
// ═══════════════════════════════════════════════════════════════

/// 读取文本文件（失败返回空串）。
fun readTextFile(path: String): String {
    return FileSystem.readText(path)
}

/// 写入文本文件；返回写入的字符数（失败返回 -1）。
fun writeTextFile(path: String, content: String): Int {
    FileSystem.writeText(path, content)
    return content.length
}

/// 将内存缓冲区转换为 String
fun bufferToString(addr: Long, len: Long): String {
    var result: String = ""
    var i: Long = 0
    while (i < len) {
        val c: Byte = Memory.read(addr + i)
        result = result + String.fromCharCode(c)
        i = i + 1
    }
    return result
}

/// 将 String 复制到内存缓冲区（NUL 终止）
fun stringToBuffer(s: String): Long {
    val len: Long = s.length + 1
    val buf: Long = Allocator.malloc(len)
    if (buf == 0) { return 0 }
    var i: Int = 0
    while (i < s.length) {
        Memory.write(buf + i, s.charCodeAt(i))
        i = i + 1
    }
    Memory.write(buf + s.length, 0)
    return buf
}
