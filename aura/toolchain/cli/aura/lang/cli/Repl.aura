// aura:///cli/aura/lang/cli/Repl.aura
package aura.lang.cli

import aura.lang.std.IO
import aura.lang.std.String
import aura.lang.std.FileSystem
import aura.lang.cli.CompilerApi
import aura.lang.native.process.ProcessNative
import aura.lang.compiler.aot.Aot

// ═══════════════════════════════════════════════════════════════
// 交互式 REPL（纯 Aura 实现）
//
// 支持多行输入（括号深度跟踪）、表达式求值、
// 语句执行。类 python -i / node -i 风格。
//
// 评估策略（AOT 路径）：
// - 纯表达式 → 包装为 fun main() { val _r = <expr>; println(toStr(_r)) }
// - 语句/块   → 包装为 fun main() { <code> }
// 编译为原生 exe 后直接执行，stdout 透出到终端。
// ═══════════════════════════════════════════════════════════════

/// REPL 工具对象
object ReplUtils {

    /// 运行 REPL，返回退出码。
    fun run(): Int {
        IO.println("Aura REPL — Enter code and press Enter to execute.")
        IO.println("Multi-line continues with { or (. Exit: exit or Ctrl+D")
        IO.println("")

        var buffer: String = ""
        var depth: Int = 0

        while (true) {
            val prompt: String
            if (buffer.length == 0) {
                prompt = ">>> "
            } else {
                prompt = "... "
            }
            IO.print(prompt)

            val line: String = IO.readLine()

            // EOF（readLine 返回空串）
            if (line.length == 0) {
                if (buffer.length > 0) {
                    ReplUtils.evalCode(buffer)
                    buffer = ""
                    depth = 0
                    continue
                }
                IO.println("")
                IO.println("Goodbye!")
                return 0
            }

            val trimmed: String = line.trim()

            // 退出命令
            if (trimmed == "exit" || trimmed == "quit") {
                if (buffer.length > 0) {
                    ReplUtils.evalCode(buffer)
                    buffer = ""
                    depth = 0
                }
                IO.println("Goodbye!")
                return 0
            }

            // 空白输入
            if (trimmed.length == 0) {
                if (buffer.length > 0) {
                    ReplUtils.evalCode(buffer)
                    buffer = ""
                    depth = 0
                }
                continue
            }

            // 跟踪括号深度
            val d: Int = ReplUtils.countDepth(trimmed)
            depth = depth + d

            // 续行（括号未闭合或行尾为续行符）
            if (depth > 0 || trimmed.endsWith(",") || trimmed.endsWith(".")) {
                buffer = buffer + line + "\n"
                continue
            }

            // 空行：如果 buffer 有内容，执行之
            if (trimmed.length == 0) {
                if (buffer.length > 0) {
                    ReplUtils.evalCode(buffer)
                    buffer = ""
                    depth = 0
                }
                continue
            }

            // 累积到 buffer，等待空行或 exit 触发执行
            buffer = buffer + line + "\n"
        }
    }

    /// 统计一行代码的括号深度变化（正=增加，负=减少）。
    fun countDepth(line: String): Int {
        var d: Int = 0
        var i: Int = 0
        while (i < line.length) {
            val c: Int = line.charCodeAt(i)
            if (c == 123 || c == 40 || c == 91) {
                d = d + 1
            } else if (c == 125 || c == 41 || c == 93) {
                d = d - 1
            }
            i = i + 1
        }
        return d
    }

    /// AOT 执行一段代码，打印结果。
    /// 返回 exit code（0 成功）。
    fun evalCode(code: String): Int {
        val trimmed: String = code.trim()
        if (trimmed.length == 0) {
            return 0
        }

        // 判断是否为纯表达式
        var wrapper: String
        if (ReplUtils.isBareExpression(trimmed)) {
            wrapper = "fun main() { val _r: Any = " + trimmed + "; println(toStr(_r)) }"
        } else {
            wrapper = "fun main() { " + trimmed + " }"
        }

        // 写入临时文件，使用 AOT 路径编译并执行
        val tmpPath: String = "build/tmp/repl_src.aura"
        FileSystem.mkdirP("build/tmp")
        FileSystem.writeText(tmpPath, wrapper)

        val outPath: String = "build/tmp/repl_exe"
        val compileCode: Int = CompilerApiUtils.aotBuildExeFile(tmpPath, outPath, "")
        if (compileCode != 0) {
            return 1
        }

        val exePath: String = AotUtils.aotWinPath(outPath + ".exe")
        val runCode: Int = ProcessNative.run(exePath)
        return runCode
    }

    /// 判断代码是否为纯表达式（非语句/块）。
    /// 纯表达式会被包装为 fun main() { val _r = <expr>; println(toStr(_r)) }，
    /// 自动打印求值结果。
    fun isBareExpression(code: String): Boolean {
        // 如果包含声明关键字
        if (code.contains("fun ") || code.contains("class ") || code.contains("object ")) {
            return false
        }
        if (code.contains("enum ") || code.contains("interface ") || code.contains("struct ")) {
            return false
        }
        // 如果包含控制流关键字
        if (code.contains("if ") || code.contains("else ") || code.contains("while ")) {
            return false
        }
        if (code.contains("for ") || code.contains("do ") || code.contains("when ")) {
            return false
        }
        if (code.contains("match ")) {
            return false
        }
        // 如果包含语句关键字
        if (code.contains("return ") || code.contains("break ") || code.contains("continue ")) {
            return false
        }
        if (code.contains("throw ") || code.contains("try ") || code.contains("catch ")) {
            return false
        }
        if (code.contains("finally ")) {
            return false
        }
        // 如果包含导入/包声明
        if (code.contains("import ") || code.contains("package ")) {
            return false
        }
        // 如果包含变量声明
        if (code.contains("val ") || code.contains("var ")) {
            return false
        }
        // 如果包含内置 I/O 函数调用
        if (code.contains("println") || code.contains("print(")) {
            return false
        }
        return true
    }
}
