// aura:///loom/aura/lang/loom/LoomMain.aura
package aura.lang.loom

import aura.lang.std.String
import aura.lang.std.Collections
import aura.lang.std.IO
import aura.lang.std.FileSystem

import "Manifest.aura"
import "TaskGraph.aura"
import "BuildCache.aura"
import "TaskExecutor.aura"
import "Task.aura"
import "LoomError.aura"
import "TaskType.aura"
import "FileIO.aura"

// Loom — main class
class Loom {
    var manifest: Manifest
    var taskGraph: TaskGraph
    var cache: BuildCache
    var executor: TaskExecutor
    var projectDir: String
    var verbose: Boolean

    constructor() {
        this.manifest = null
        this.taskGraph = TaskGraph()
        this.cache = null
        this.executor = null
        this.projectDir = ""
        this.verbose = false
    }

    fun init(projectDir: String): Int {
        this.projectDir = projectDir
        val manifestPath: String = projectDir + "/aura.toml"

        manifest = createManifest("my-project", manifestPath)
        val loadResult: Int = manifest.load()
        if (loadResult != LoomError.OK) {
            println("[loom] No aura.toml found, creating default")
            manifest.save()
        }

        cache = BuildCache(projectDir + "/" + manifest.cacheDir)
        executor = TaskExecutor(manifest, cache)
        loadDefaultTasks()
        return LoomError.OK
    }

    fun loadDefaultTasks(): Unit {
        taskGraph.addTaskByName("clean", TaskType.CLEAN)
        taskGraph.addTaskByName("resolve", TaskType.RESOLVE)
        taskGraph.addTaskByName("check", TaskType.CHECK)
        taskGraph.addTaskByName("compile", TaskType.COMPILE)
        taskGraph.addTaskByName("test", TaskType.TEST)
        taskGraph.addTaskByName("fmt", TaskType.FMT)
        taskGraph.addTaskByName("doc", TaskType.DOC)
        taskGraph.addTaskByName("package", TaskType.PACKAGE)
        taskGraph.addTaskByName("run", TaskType.EXECUTE)
        taskGraph.addTaskByName("watch", TaskType.WATCH)

        // Set up dependencies
        val compile: Task = taskGraph.getTask("compile")
        if (compile != null) {
            compile.addDep("resolve")
            compile.addDep("check")
        }
        val testTask: Task = taskGraph.getTask("test")
        if (testTask != null) { testTask.addDep("compile") }
        val pkgTask: Task = taskGraph.getTask("package")
        if (pkgTask != null) { pkgTask.addDep("compile") }
        val runTask: Task = taskGraph.getTask("run")
        if (runTask != null) { runTask.addDep("compile") }
    }

    fun runTask(taskName: String): Int {
        val task: Task = taskGraph.getTask(taskName)
        if (task == null) {
            println("[loom] Unknown task: " + taskName)
            return LoomError.NOT_FOUND
        }
        return executor.execute(task)
    }

    fun runAll(): Int { return taskGraph.executeAll(executor) }
    fun build(): Int { return runTask("compile") }
    fun test(): Int { return runTask("test") }
    fun check(): Int { return runTask("check") }
    fun fmt(): Int { return runTask("fmt") }
    fun run(): Int { return runTask("run") }
    fun clean(): Int { return runTask("clean") }

    fun newProject(name: String, dir: String): Int {
        loomMkdirP(dir)
        loomMkdirP(dir + "/src")
        loomMkdirP(dir + "/tests")

        val m: Manifest = createManifest(name, dir + "/aura.toml")
        m.version = "0.1.0"
        m.description = "A new Aura project"
        m.save()

        val mainContent: String = "fun main(): Int {\n    println(\"Hello, " + name + "!\")\n    return 0\n}\n"
        loomWriteText(dir + "/src/main.aura", mainContent)

        val testContent: String = "fun testHello(): Int {\n    val result: Int = 1 + 1\n    if (result != 2) { println(\"FAIL\") ; return 1 }\n    return 0\n}\nfun main(): Int {\n    return testHello()\n}\n"
        loomWriteText(dir + "/tests/test_main.aura", testContent)

        println("[loom] Project created: " + dir)
        return LoomError.OK
    }
}
