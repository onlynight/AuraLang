// aura:///loom/plugin/aura/lang/loom/plugin/ExplicitPlugin.aura
package aura.lang.loom.plugin

import aura.lang.std.String
import aura.lang.std.Collections
import aura.lang.std.IO
import aura.lang.loom.plugin.Plugin

// ═══════════════════════════════════════════════════════════════
// 显式插件
// 对标 Rust: plugin/explicit.rs
// ═══════════════════════════════════════════════════════════════

class ExplicitPlugin {
    val name: String
    val path: String
    private var version: String = "0.1.0"

    fun ExplicitPlugin(name: String, path: String) {
        this.name = name
        this.path = path
    }

    fun load(): Plugin {
        // 简化：创建插件实例
        val plugin: Plugin = Plugin(name, version)
        IO.println("[explicit] Loaded plugin: " + name)
        return plugin
    }
}
