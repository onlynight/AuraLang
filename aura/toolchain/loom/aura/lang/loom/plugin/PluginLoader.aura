// aura:///loom/plugin/aura/lang/loom/plugin/PluginLoader.aura
package aura.lang.loom.plugin

import aura.lang.std.String
import aura.lang.std.Collections
import aura.lang.std.IO
import aura.lang.loom.plugin.Plugin
import aura.lang.loom.plugin.PluginRegistry
import aura.lang.loom.plugin.ExplicitPlugin
import aura.lang.loom.plugin.ConventionPlugin

// ═══════════════════════════════════════════════════════════════
// 插件加载器
// ═══════════════════════════════════════════════════════════════

class PluginLoader {
    val registry: PluginRegistry
    val projectDir: String

    fun PluginLoader(registry: PluginRegistry, projectDir: String) {
        this.registry = registry
        this.projectDir = projectDir
    }

    fun loadAll(plugins: List<String>): Int {
        var i: Int = 0
        while (i < plugins.size) {
            val pluginSpec: String = plugins[i]
            loadPlugin(pluginSpec)
            i = i + 1
        }
        
        // 加载约定式插件
        val conventionPlugins: List<Plugin> = ConventionPlugin.discover(projectDir)
        var j: Int = 0
        while (j < conventionPlugins.size) {
            registry.register(conventionPlugins[j])
            j = j + 1
        }
        
        // 加载内置插件
        val builtinPlugins: List<Plugin> = ConventionPlugin.builtin()
        var k: Int = 0
        while (k < builtinPlugins.size) {
            registry.register(builtinPlugins[k])
            k = k + 1
        }
        
        return 0
    }

    fun loadPlugin(spec: String): Int {
        // 格式: name@version 或 name=path
        val eqIdx: Int = spec.indexOf("=")
        if (eqIdx > 0) {
            // 显式插件: name=path
            val name: String = String.substring(spec, 0, eqIdx)
            val path: String = String.substring(spec, eqIdx + 1)
            val plugin: ExplicitPlugin = ExplicitPlugin(name, path)
            registry.register(plugin.load())
            return 0
        }
        
        val atIdx: Int = spec.indexOf("@")
        if (atIdx > 0) {
            // 版本指定: name@version
            val name: String = String.substring(spec, 0, atIdx)
            val version: String = String.substring(spec, atIdx + 1)
            val plugin: Plugin = Plugin(name, version)
            registry.register(plugin)
            return 0
        }
        
        // 仅名称: name
        val plugin: Plugin = Plugin(spec, "0.1.0")
        registry.register(plugin)
        return 0
    }
}
