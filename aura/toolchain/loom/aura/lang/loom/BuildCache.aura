// aura:///loom/aura/lang/loom/BuildCache.aura
package aura.lang.loom

// ── 标准库 ──
import aura.lang.std.Collections
import aura.lang.std.Encoding

// ── Native 包 ──
import aura.lang.native.console.Console

// ── 项目内模块 ──
import aura.lang.loom.Task
import aura.lang.loom.FileIO

// ═══════════════════════════════════════════════════════════════
// BuildCache（增量构建 + 指纹）
// ═══════════════════════════════════════════════════════════════

class BuildCache {
    val cacheDir: String
    var enabled: Boolean = true

    fun BuildCache(cacheDir: String) {
        this.cacheDir = cacheDir
        if (!loomExists(cacheDir)) { loomMkdirP(cacheDir) }
    }

    fun fingerprint(task: Task): String {
        val input: String = task.name + task.kind + task.inputs.files.join("|")
        return Encoding.sha256(input)
    }

    fun isCached(task: Task): Boolean {
        if (!enabled) { return false }
        val fp: String = fingerprint(task)
        val cacheFile: String = cacheDir + "/" + task.name + ".fp"
        if (!loomExists(cacheFile)) { return false }
        val cachedFp: String = loomReadText(cacheFile)
        return cachedFp == fp
    }

    fun save(task: Task): Unit {
        if (!enabled) { return }
        val fp: String = fingerprint(task)
        val cacheFile: String = cacheDir + "/" + task.name + ".fp"
        loomWriteText(cacheFile, fp)
    }

    fun clear(): Unit {
        if (!loomExists(cacheDir)) { return }
        val files: List<String> = loomListFiles(cacheDir)
        var i: Int = 0
        while (i < files.size) {
            loomDelete(cacheDir + "/" + files[i])
            i = i + 1
        }
    }
}
