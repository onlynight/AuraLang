// aura:///loom/aura/lang/loom/BuildCache.aura
package aura.lang.loom

import aura.lang.std.String

import "Task.aura"
import "FileIO.aura"

// BuildCache — incremental build cache with simple hash
class BuildCache {
    val cacheDir: String
    var enabled: Boolean = true

    constructor(cacheDir: String) {
        this.cacheDir = cacheDir
        if (!loomExists(cacheDir)) { loomMkdirP(cacheDir) }
    }

    // Simple hash function (no Encoding.sha256, no String.fromCharCode)
    private fun simpleHash(s: String): String {
        var h: Int = 0
        var i: Int = 0
        while (i < s.length) {
            h = h * 31 + s.charCodeAt(i)
            i = i + 1
        }
        // Use integer string representation instead of hex
        return h.toString()
    }

    fun fingerprint(task: Task): String {
        var input: String = task.name
        input = input + ":" + task.kind.toString()
        var i: Int = 0
        while (i < task.inputs.files.size) {
            input = input + ":" + task.inputs.files.get(i).toString()
            i = i + 1
        }
        return simpleHash(input)
    }

    fun isCached(task: Task): Boolean {
        if (!enabled) { return false }
        val fp: String = fingerprint(task)
        val cacheFile: String = cacheDir + "/" + task.name + ".fp"
        if (!loomExists(cacheFile)) { return false }
        val cachedFp: String = loomReadText(cacheFile)
        return cachedFp == fp
    }

    fun save(task: Task): Unit {
        if (!enabled) { return }
        val fp: String = fingerprint(task)
        val cacheFile: String = cacheDir + "/" + task.name + ".fp"
        loomWriteText(cacheFile, fp)
    }

    fun clear(): Unit {
        if (!loomExists(cacheDir)) { return }
        val files: List<String> = loomListFiles(cacheDir)
        var i: Int = 0
        while (i < files.size) {
            loomDelete(cacheDir + "/" + files.get(i))
            i = i + 1
        }
    }
}
