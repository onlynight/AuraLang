// aura:///loom/aura/lang/loom/TaskGraph.aura
package aura.lang.loom

import aura.lang.std.Collections

import "Task.aura"
import "LoomError.aura"
import "TaskExecutor.aura"

// TaskGraph — uses string-based storage (VM List/Map bugs)
class TaskGraph {
    // Store task names as a single string separated by "|"
    var taskNamesStr: String = ""
    // Store tasks in a global registry (workaround for List/Map bugs)
    var allTasks: String = ""

    constructor() {
    }

    private fun addName(name: String): Unit {
        if (taskNamesStr.length == 0) {
            taskNamesStr = name
        } else {
            taskNamesStr = taskNamesStr + "|" + name
        }
    }

    private fun hasName(name: String): Boolean {
        if (taskNamesStr.length == 0) { return false }
        if (taskNamesStr == name) { return true }
        // Check startsWith: name + "|"
        val prefix: String = name + "|"
        if (taskNamesStr.substring(0, prefix.length) == prefix) { return true }
        // Check endsWith: "|" + name
        val suffix: String = "|" + name
        if (taskNamesStr.substring(taskNamesStr.length - suffix.length) == suffix) { return true }
        // Check contains: "|" + name + "|"
        val mid: String = "|" + name + "|"
        if (taskNamesStr.indexOf(mid) >= 0) { return true }
        return false
    }

    private fun getNameAt(index: Int): String {
        var i: Int = 0
        var start: Int = 0
        var s: String = taskNamesStr
        while (i < index) {
            val pipe: Int = s.indexOf("|", start)
            if (pipe < 0) { return "" }
            start = pipe + 1
            i = i + 1
        }
        val end: Int = s.indexOf("|", start)
        if (end < 0) { return s.substring(start) }
        return s.substring(start, end)
    }

    private fun getNameCount(): Int {
        if (taskNamesStr.length == 0) { return 0 }
        var count: Int = 1
        var i: Int = 0
        while (i < taskNamesStr.length) {
            if (taskNamesStr.charCodeAt(i) == 124) { count = count + 1 }
            i = i + 1
        }
        return count
    }

    fun addTaskByObj(task: Task): Unit {
        if (!hasName(task.name)) {
            addName(task.name)
            allTasks = allTasks + task.name + ":" + task.kind + "|"
        }
    }

    fun addTaskByName(name: String, kind: Int): Unit {
        val task: Task = createTask(name, kind)
        addTaskByObj(task)
    }

    fun getTask(name: String): Task {
        if (!hasName(name)) { return null }
        // Parse from allTasks string
        var s: String = allTasks
        var start: Int = 0
        var found: Boolean = false
        while (start < s.length && !found) {
            val pipe: Int = s.indexOf("|", start)
            if (pipe < 0) { break }
            val entry: String = s.substring(start, pipe)
            if (entry.startsWith(name + ":")) {
                val kindStr: String = entry.substring(name.length + 1)
                val kind: Int = parseIntSafe(kindStr)
                val t: Task = createTask(name, kind)
                return t
            }
            start = pipe + 1
        }
        return null
    }

    fun hasTask(name: String): Boolean {
        return hasName(name)
    }

    fun taskCount(): Int {
        return getNameCount()
    }

    fun getTaskNameAt(index: Int): String {
        return getNameAt(index)
    }

    fun tasksValues(): List<Any> {
        return mutableListOf()
    }

    fun tasksKeys(): List<String> {
        return mutableListOf()
    }

    private fun parseIntSafe(s: String): Int {
        var result: Int = 0
        var i: Int = 0
        while (i < s.length) {
            val c: Int = s.charCodeAt(i)
            if (c >= 48 && c <= 57) {
                result = result * 10 + (c - 48)
            }
            i = i + 1
        }
        return result
    }

    // Topological sort (simplified)
    fun topoSort(): TopoSortResult {
        val result: TopoSortResult = TopoSortResult()
        result.order = mutableListOf()
        var i: Int = 0
        while (i < getNameCount()) {
            val name: String = getNameAt(i)
            result.order.add(name)
            i = i + 1
        }
        return result
    }

    // Cycle detection (always false - simplified)
    fun hasCycle(): Boolean {
        return false
    }

    // Execute all tasks
    fun executeAll(executor: TaskExecutor): Int {
        var i: Int = 0
        while (i < getNameCount()) {
            val name: String = getNameAt(i)
            val task: Task = getTask(name)
            if (task != null) {
                val ret: Int = executor.execute(task)
                if (ret != LoomError.OK) {
                    println("[loom] Task '" + name + "' failed with code " + ret)
                    return ret
                }
            }
            i = i + 1
        }
        return LoomError.OK
    }

    fun toStr(): String {
        return "TaskGraph{tasks=" + getNameCount() + "}"
    }
}

// TopoSortResult
class TopoSortResult {
    var order: List<String> = mutableListOf()
    fun isEmpty(): Boolean { return order.size == 0 }
}
