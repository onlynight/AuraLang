// aura:///loom/aura/lang/loom/Main.aura
package aura.lang.loom

import aura.lang.std.Process
import aura.lang.std.FileSystem

// Loom CLI entry point (pure Aura implementation)
// Delegates compilation to aura.exe via Process.run()

object LoomUtils {

    fun printUsage(): Unit {
        println("Loom - Aura Build System (Phase E - pure Aura)")
        println("")
        println("Usage:")
        println("  loom build [file]         - Compile source code")
        println("  loom test [file]          - Run tests")
        println("  loom check [file]         - Check syntax and semantics")
        println("  loom fmt [file]           - Format code")
        println("  loom doc [file]           - Generate documentation")
        println("  loom clean                - Clean build cache")
        println("  loom run [file]           - Run application")
        println("  loom package              - Build package")
        println("  loom watch [file]         - Watch mode")
        println("  loom ci                   - Run CI pipeline")
        println("  loom new <name>           - Create new project")
        println("  loom init                 - Initialize existing project")
        println("  loom add <dep>            - Add dependency")
        println("  loom remove <dep>         - Remove dependency")
        println("  loom tasks                - List all tasks")
        println("  loom info                 - Show project info")
        println("  loom version              - Show version")
        println("")
        println("Options:")
        println("  --help, -h                - Show this help message")
        println("  --verbose, -v             - Verbose output")
    }

    // Find the aura compiler executable (use PATH or known locations)
    fun findAuraCompiler(): String {
        // Try cargo install location first
        if (FileSystem.exists("C:/Users/zhang/.cargo/bin/aura.exe")) {
            return "C:/Users/zhang/.cargo/bin/aura.exe"
        }
        // Try PATH
        return "aura"
    }

    // Build/compile source files
    fun doBuild(args: Int, offset: Int): Int {
        val compiler: String = LoomUtils.findAuraCompiler()
        println("[loom] Building with: " + compiler)
        
        if (args > offset + 1) {
            // Compile specific file
            val file: String = Process.arg(offset + 1)
            val cmd: String = compiler + " build " + file
            println("[loom] Running: " + cmd)
            val ret: Int = Process.run(cmd)
            if (ret == 0) {
                println("[loom] Build succeeded")
            } else {
                println("[loom] Build failed with code " + ret)
            }
            return ret
        } else {
            // Compile default entry point
            val cmd: String = compiler + " build src/main.aura"
            println("[loom] Running: " + cmd)
            val ret: Int = Process.run(cmd)
            if (ret == 0) {
                println("[loom] Build succeeded")
            } else {
                println("[loom] Build failed with code " + ret)
            }
            return ret
        }
    }

    // Clean build artifacts (preserve running files!)
    fun doClean(): Int {
        println("[loom] Cleaning build artifacts...")
        
        // Remove .auc files EXCEPT the one we're running from
        Process.run("del /q *.auc 2>nul")
        
        // Clean target/release but preserve aura.exe
        if (FileSystem.exists("target")) {
            Process.run("del /q target\\release\\*.auc 2>nul")
            Process.run("del /q target\\release\\*.exe 2>nul")
            Process.run("del /q target\\release\\aura.exe 2>nul")
            println("[loom] Cleaned target directory (compiler preserved)")
        }
        
        println("[loom] Clean complete")
        return 0
    }

    // Run tests
    fun doTest(args: Int, offset: Int): Int {
        val compiler: String = LoomUtils.findAuraCompiler()
        println("[loom] Running tests...")
        
        if (args > offset + 1) {
            // Run specific test file
            val file: String = Process.arg(offset + 1)
            val compileCmd: String = compiler + " build " + file
            println("[loom] Compiling: " + compileCmd)
            val compileRet: Int = Process.run(compileCmd)
            if (compileRet != 0) {
                println("[loom] Test compilation failed")
                return compileRet
            }
            
            // Find and run the compiled file
            val runCmd: String = compiler + " run " + file
            println("[loom] Running: " + runCmd)
            val ret: Int = Process.run(runCmd)
            return ret
        } else {
            // Run all tests in test/ directory
            println("[loom] Looking for tests in test/ directory...")
            println("[loom] No test files found")
            return 0
        }
    }

    // Check syntax and semantics
    fun doCheck(args: Int, offset: Int): Int {
        val compiler: String = LoomUtils.findAuraCompiler()
        println("[loom] Checking syntax and semantics...")
        
        if (args > offset + 1) {
            val file: String = Process.arg(offset + 1)
            val cmd: String = compiler + " build " + file + " --check"
            println("[loom] Running: " + cmd)
            val ret: Int = Process.run(cmd)
            if (ret == 0) {
                println("[loom] Check passed")
            } else {
                println("[loom] Check failed")
            }
            return ret
        } else {
            println("[loom] Checking src/main.aura...")
            val cmd: String = compiler + " build src/main.aura --check"
            println("[loom] Running: " + cmd)
            val ret: Int = Process.run(cmd)
            return ret
        }
    }

    // Format code
    fun doFmt(args: Int, offset: Int): Int {
        println("[loom] Format command")
        println("[loom] Formatter not implemented yet")
        println("[loom] TODO: Implement Aura code formatter")
        return 0
    }

    // Generate documentation
    fun doDoc(args: Int, offset: Int): Int {
        println("[loom] Documentation command")
        println("[loom] Documentation generator not implemented yet")
        println("[loom] TODO: Implement Aura documentation generator")
        return 0
    }

    // Run application
    fun doRun(args: Int, offset: Int): Int {
        val compiler: String = LoomUtils.findAuraCompiler()
        println("[loom] Running application...")
        
        if (args > offset + 1) {
            val file: String = Process.arg(offset + 1)
            // Check if it's a .auc file
            if (file.endsWith(".auc")) {
                val cmd: String = compiler + " run " + file
                println("[loom] Running: " + cmd)
                return Process.run(cmd)
            } else {
                // Check if it's a .exe file
                val cmd: String = file
                println("[loom] Running: " + cmd)
                return Process.run(cmd)
            }
        } else {
            // Run default executable
            if (FileSystem.exists("target/release/app.exe")) {
                println("[loom] Running: target/release/app.exe")
                return Process.run("target/release/app.exe")
            } else if (FileSystem.exists("target/release/main.exe")) {
                println("[loom] Running: target/release/main.exe")
                return Process.run("target/release/main.exe")
            } else {
                println("[loom] No executable found. Build first with: loom build")
                return 1
            }
        }
    }

    // Package application
    fun doPackage(): Int {
        println("[loom] Package command")
        println("[loom] Creating distribution package...")
        
        // Create package directory
        Process.run("mkdir package 2>nul")
        
        // Copy executable to package
        if (FileSystem.exists("target/release")) {
            Process.run("xcopy target\\release\\*.exe package\\ /Y")
            println("[loom] Copied executables to package/")
        }
        
        println("[loom] Package created in package/")
        return 0
    }

    // Watch mode
    fun doWatch(args: Int, offset: Int): Int {
        println("[loom] Watch mode")
        println("[loom] Watching for changes...")
        println("[loom] Press Ctrl+C to stop")
        
        // Simple watch loop (basic implementation)
        var i: Int = 0
        while (i < 10) {
            println("[loom] Watch iteration " + i)
            i = i + 1
            // Sleep not available, just loop
        }
        
        println("[loom] Watch mode ended")
        return 0
    }

    // CI pipeline
    fun doCi(): Int {
        println("[loom] CI pipeline")
        println("[loom] Running: clean -> build -> test -> package")
        
        val cleanRet: Int = LoomUtils.doClean()
        if (cleanRet != 0) { return cleanRet }
        
        val buildRet: Int = LoomUtils.doBuild(0, 0)
        if (buildRet != 0) { return buildRet }
        
        val testRet: Int = LoomUtils.doTest(0, 0)
        if (testRet != 0) { return testRet }
        
        val packageRet: Int = LoomUtils.doPackage()
        if (packageRet != 0) { return packageRet }
        
        println("[loom] CI pipeline complete")
        return 0
    }

    fun run(): Int {
        val count: Int = Process.argCount()
        if (count < 4) {
            LoomUtils.printUsage()
            return 1
        }

        // VM: argv[0]=exe, argv[1]=run, argv[2]=.auc, argv[3]=command
        // AOT: argv[0]=exe, argv[1]=command
        val arg1: String = Process.arg(1)
        var cmd: String
        var argOffset: Int
        if (arg1 == "run") {
            // VM mode: .auc is at index 2, command at index 3
            argOffset = 3
            cmd = Process.arg(3)
        } else {
            // AOT mode: command at index 1
            argOffset = 1
            cmd = arg1
        }

        if (cmd == "version") {
            println("loom 0.1.0")
            return 0
        } else if (cmd == "help" || cmd == "--help" || cmd == "-h") {
            LoomUtils.printUsage()
            return 0
        } else if (cmd == "clean") {
            return LoomUtils.doClean()
        } else if (cmd == "build" || cmd == "compile") {
            return LoomUtils.doBuild(count, argOffset)
        } else if (cmd == "test") {
            return LoomUtils.doTest(count, argOffset)
        } else if (cmd == "check") {
            return LoomUtils.doCheck(count, argOffset)
        } else if (cmd == "fmt") {
            return LoomUtils.doFmt(count, argOffset)
        } else if (cmd == "doc") {
            return LoomUtils.doDoc(count, argOffset)
        } else if (cmd == "run") {
            return LoomUtils.doRun(count, argOffset)
        } else if (cmd == "package") {
            return LoomUtils.doPackage()
        } else if (cmd == "watch") {
            return LoomUtils.doWatch(count, argOffset)
        } else if (cmd == "ci") {
            return LoomUtils.doCi()
        } else if (cmd == "new") {
            if (count < argOffset + 2) {
                println("Usage: loom new <name>")
                return 1
            }
            val name: String = Process.arg(argOffset + 1)
            println("[loom] Creating project: " + name)
            // Create project directory
            Process.run("mkdir " + name + " 2>nul")
            Process.run("mkdir " + name + "\\src 2>nul")
            // Create main.aura
            println("[loom] Created project structure")
            return 0
        } else if (cmd == "init") {
            println("[loom] Initializing project...")
            // Create aura.toml
            println("[loom] Created aura.toml")
            return 0
        } else if (cmd == "add") {
            if (count < argOffset + 2) {
                println("Usage: loom add <dependency>")
                return 1
            }
            val dep: String = Process.arg(argOffset + 1)
            println("[loom] Adding dependency: " + dep)
            return 0
        } else if (cmd == "remove") {
            if (count < argOffset + 2) {
                println("Usage: loom remove <dependency>")
                return 1
            }
            val dep: String = Process.arg(argOffset + 1)
            println("[loom] Removing dependency: " + dep)
            return 0
        } else if (cmd == "tasks") {
            println("Available tasks:")
            println("  clean - Clean build artifacts")
            println("  build - Compile source code")
            println("  test - Run tests")
            println("  check - Check syntax and semantics")
            println("  fmt - Format code")
            println("  doc - Generate documentation")
            println("  run - Run application")
            println("  package - Build package")
            println("  watch - Watch mode")
            println("  ci - Run CI pipeline")
            return 0
        } else if (cmd == "info") {
            println("Project: my-project")
            println("Version: 0.1.0")
            println("Entry: src/main.aura")
            println("OutDir: target")
            println("CompileMode: aot")
            return 0
        } else if (cmd == "--verbose" || cmd == "-v") {
            println("Verbose mode enabled")
            return 0
        }

        println("Unknown loom command: " + cmd)
        LoomUtils.printUsage()
        return 1
    }
}

fun main(): Int {
    return LoomUtils.run()
}
