// aura:///loom/aura/lang/loom/Manifest.aura
package aura.lang.loom

import aura.lang.std.String

import "FileIO.aura"
import "LoomError.aura"

// Manifest — aura.toml parser/writer
class Manifest {
    var name: String
    var version: String
    var description: String
    var authors: List<String>
    var license: String
    var repository: String

    var entry: String
    var outDir: String
    var cacheDir: String
    var compileMode: String
    var ffiMode: String

    var dependencies: List<String>
    var devDependencies: List<String>
    var buildDependencies: List<String>

    var srcDirs: List<String>
    var testDirs: List<String>
    var benchDirs: List<String>

    var buildTasks: List<String>
    var plugins: List<String>
    var workspaceMembers: List<String>

    var path: String

    // No-arg constructor (VM bug: args not passed)
    constructor() {
        this.name = "my-project"
        this.path = ""
        this.version = "0.1.0"
        this.description = ""
        this.authors = mutableListOf()
        this.license = ""
        this.repository = ""
        this.entry = "src/main.aura"
        this.outDir = "target"
        this.cacheDir = "target/cache"
        this.compileMode = "aot"
        this.ffiMode = "native"
        this.dependencies = mutableListOf()
        this.devDependencies = mutableListOf()
        this.buildDependencies = mutableListOf()
        this.srcDirs = mutableListOf()
        this.srcDirs.add("src")
        this.testDirs = mutableListOf()
        this.testDirs.add("tests")
        this.benchDirs = mutableListOf()
        this.buildTasks = mutableListOf()
        this.plugins = mutableListOf()
        this.workspaceMembers = mutableListOf()
    }

    fun setName(n: String): Unit { this.name = n }
    fun setPath(p: String): Unit { this.path = p }

    fun addDependency(dep: String): Unit { dependencies.add(dep) }
    fun addDevDependency(dep: String): Unit { devDependencies.add(dep) }
    fun addBuildDependency(dep: String): Unit { buildDependencies.add(dep) }
    fun addBuildTask(task: String): Unit { buildTasks.add(task) }
    fun addPlugin(plugin: String): Unit { plugins.add(plugin) }
    fun addWorkspaceMember(member: String): Unit { workspaceMembers.add(member) }
    fun addSrcDir(dir: String): Unit { srcDirs.add(dir) }
    fun addTestDir(dir: String): Unit { testDirs.add(dir) }

    fun save(): Unit {
        var content: String = ""
        content = content + "# Aura project manifest\n"
        content = content + "schema-version = \"1.0\"\n"
        content = content + "name = \"" + name + "\"\n"
        content = content + "version = \"" + version + "\"\n"
        if (description.length > 0) {
            content = content + "description = \"" + description + "\"\n"
        }
        if (authors.size > 0) {
            content = content + "authors = ["
            var i: Int = 0
            while (i < authors.size) {
                if (i > 0) { content = content + ", " }
                content = content + "\"" + authors.get(i) + "\""
                i = i + 1
            }
            content = content + "]\n"
        }
        if (license.length > 0) {
            content = content + "license = \"" + license + "\"\n"
        }
        if (repository.length > 0) {
            content = content + "repository = \"" + repository + "\"\n"
        }
        content = content + "entry = \"" + entry + "\"\n"
        content = content + "out-dir = \"" + outDir + "\"\n"
        content = content + "cache-dir = \"" + cacheDir + "\"\n"
        content = content + "compile-mode = \"" + compileMode + "\"\n"
        content = content + "ffi-mode = \"" + ffiMode + "\"\n"
        if (srcDirs.size > 0) {
            content = content + "src-dirs = ["
            var j: Int = 0
            while (j < srcDirs.size) {
                if (j > 0) { content = content + ", " }
                content = content + "\"" + srcDirs.get(j) + "\""
                j = j + 1
            }
            content = content + "]\n"
        }
        if (testDirs.size > 0) {
            content = content + "test-dirs = ["
            var k: Int = 0
            while (k < testDirs.size) {
                if (k > 0) { content = content + ", " }
                content = content + "\"" + testDirs.get(k) + "\""
                k = k + 1
            }
            content = content + "]\n"
        }
        if (dependencies.size > 0) {
            content = content + "[dependencies]\n"
            var l: Int = 0
            while (l < dependencies.size) {
                content = content + dependencies.get(l) + "\n"
                l = l + 1
            }
        }
        if (devDependencies.size > 0) {
            content = content + "[dev-dependencies]\n"
            var m: Int = 0
            while (m < devDependencies.size) {
                content = content + devDependencies.get(m) + "\n"
                m = m + 1
            }
        }
        if (buildDependencies.size > 0) {
            content = content + "[build-dependencies]\n"
            var n: Int = 0
            while (n < buildDependencies.size) {
                content = content + buildDependencies.get(n) + "\n"
                n = n + 1
            }
        }
        if (buildTasks.size > 0) {
            content = content + "[build.tasks]\n"
            var o: Int = 0
            while (o < buildTasks.size) {
                content = content + "  \"" + buildTasks.get(o) + "\"\n"
                o = o + 1
            }
        }
        if (plugins.size > 0) {
            content = content + "[plugins]\n"
            var p: Int = 0
            while (p < plugins.size) {
                content = content + plugins.get(p) + "\n"
                p = p + 1
            }
        }
        if (workspaceMembers.size > 0) {
            content = content + "[workspace.members]\n"
            var q: Int = 0
            while (q < workspaceMembers.size) {
                content = content + "  \"" + workspaceMembers.get(q) + "\"\n"
                q = q + 1
            }
        }
        loomWriteText(path, content)
    }

    fun load(): Int {
        if (!loomExists(path)) {
            return LoomError.NOT_FOUND
        }
        // TOML parsing deferred (VM String.splitLines bug)
        return LoomError.OK
    }

    private fun parseManifest(content: String): Int {
        // TODO: implement TOML parsing when VM String functions are fixed
        return LoomError.OK
    }

    fun toStr(): String {
        var s: String = "Manifest{name='" + name + "', version='" + version + "'"
        if (description.length > 0) {
            s = s + ", description='" + description + "'"
        }
        if (dependencies.size > 0) {
            s = s + ", deps=" + dependencies.size
        }
        s = s + "}"
        return s
    }
}

// Factory function
fun createManifest(name: String, path: String): Manifest {
    val m: Manifest = Manifest()
    m.setName(name)
    m.setPath(path)
    return m
}
