// aura:///loom/aura/lang/loom/FileIO.aura
package aura.lang.loom

// ── Native 包 ──
import aura.lang.native.file.FileOps
import aura.lang.native.memory.Allocator
import aura.lang.native.string.StrOps
import aura.lang.std.String
import aura.lang.native.Syscalls

// ═══════════════════════════════════════════════════════════════
// 文件 I/O 辅助（使用 aura.core.native）
// ═══════════════════════════════════════════════════════════════

/// 读取文本文件（使用 FileOps）
fun loomReadText(path: String): String {
    val fd: Int = FileOps.open(CString(path), FileOps.O_RDONLY)
    if (fd < 0) { return "" }
    val buf: Long = Allocator.malloc(65536)
    if (buf == 0) { FileOps.close(fd); return "" }
    var total: Long = 0
    var bytesRead: Long = 0
    while (true) {
        bytesRead = FileOps.read(fd, buf + total, 65536 - total)
        if (bytesRead <= 0) { break }
        total = total + bytesRead
        if (total >= 65536) { break }
    }
    FileOps.close(fd)
    val result: String = bufferToString(buf, total)
    Allocator.free(buf)
    return result
}

/// 写入文本文件（使用 FileOps）
fun loomWriteText(path: String, content: String): Int {
    val fd: Int = FileOps.open(CString(path), FileOps.O_WRONLY | FileOps.O_CREAT | FileOps.O_TRUNC)
    if (fd < 0) { return -1 }
    val len: Long = content.length
    val buf: Long = stringToBuffer(content)
    if (buf == 0) { FileOps.close(fd); return -1 }
    var written: Long = 0
    var total: Long = 0
    while (total < len) {
        written = FileOps.write(fd, buf + total, len - total)
        if (written <= 0) { break }
        total = total + written
    }
    FileOps.close(fd)
    Allocator.free(buf)
    return total as Int
}

/// 检查文件是否存在
fun loomExists(path: String): Boolean {
    val fd: Int = FileOps.open(CString(path), FileOps.O_RDONLY)
    if (fd < 0) { return false }
    FileOps.close(fd)
    return true
}

/// 创建目录（递归）
fun loomMkdirP(path: String): Int {
    // 简化实现：使用 mkdir syscall
    val buf: Long = stringToBuffer(path)
    if (buf == 0) { return -1 }
    val result: Int = Syscalls.syscall_mkdir(buf, 493)  // 0755
    Allocator.free(buf)
    return result
}

/// 列出目录文件
fun loomListFiles(path: String): List<String> {
    val result: List<String> = mutableListOf()
    // 简化：返回空列表（目录遍历需要 readdir syscall，暂不实现）
    return result
}

/// 删除文件
fun loomDelete(path: String): Int {
    val buf: Long = stringToBuffer(path)
    if (buf == 0) { return -1 }
    val result: Int = Syscalls.syscall_unlink(buf)
    Allocator.free(buf)
    return result
}

/// 缓冲区转字符串
fun bufferToString(addr: Long, len: Long): String {
    var result: String = ""
    var i: Long = 0
    while (i < len) {
        val c: Byte = StrOps.readByte(addr + i)
        result = result + String.fromCharCode(c)
        i = i + 1
    }
    return result
}

/// 字符串转缓冲区（NUL 终止）
fun stringToBuffer(s: String): Long {
    val len: Long = s.length + 1
    val buf: Long = Allocator.malloc(len)
    if (buf == 0) { return 0 }
    var i: Int = 0
    while (i < s.length) {
        StrOps.writeByte(buf + i, s.charCodeAt(i))
        i = i + 1
    }
    StrOps.writeByte(buf + s.length, 0)
    return buf
}
