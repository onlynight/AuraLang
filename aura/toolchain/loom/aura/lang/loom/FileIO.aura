// aura:///loom/aura/lang/loom/FileIO.aura
package aura.lang.loom

import aura.lang.std.String
import aura.lang.std.fs.FileUtils

// File I/O helpers (using aura.lang.std.FileUtils)

/// Read text file
fun loomReadText(path: String): String {
    if (!FileUtils.exists(path)) { return "" }
    return FileUtils.readText(path)
}

/// Write text file
fun loomWriteText(path: String, content: String): Int {
    FileUtils.writeText(path, content)
    return 0
}

/// Check if file exists
fun loomExists(path: String): Boolean {
    return FileUtils.exists(path)
}

/// Create directory (recursive)
fun loomMkdirP(path: String): Int {
    FileUtils.mkdirP(path)
    return 0
}

/// List directory files
fun loomListFiles(path: String): List<String> {
    return FileUtils.listFiles(path)
}

/// Delete file
fun loomDelete(path: String): Int {
    FileUtils.delete(path)
    return 0
}

/// Recursively delete directory contents (simplified: only delete files)
fun loomDeleteDir(path: String): Int {
    val files: List<String> = loomListFiles(path)
    var i: Int = 0
    while (i < files.size) {
        loomDelete(path + "/" + files.get(i))
        i = i + 1
    }
    return 0
}
