// aura:///loom/aura/lang/loom/TaskExecutor.aura
package aura.lang.loom

// ── 标准库 ──
import aura.lang.std.Collections

// ── Native 包 ──
import aura.lang.native.console.Console

// ── 编译器模块 ──
import aura.lang.compiler.parser.Parser
import aura.lang.compiler.sema.TypeChecker
import aura.lang.compiler.hir.Hir
import aura.lang.compiler.mir.MirLower
import aura.lang.compiler.codegen.Codegen
import aura.lang.compiler.vm.VmRunner

// ── 项目内模块 ──
import aura.lang.loom.Task
import aura.lang.loom.Manifest
import aura.lang.loom.BuildCache
import aura.lang.loom.LoomError
import aura.lang.loom.FileIO

// ═══════════════════════════════════════════════════════════════
// TaskExecutor（任务执行器 — 纯 Aura + 编译器 API）
// ═══════════════════════════════════════════════════════════════

class TaskExecutor {
    val manifest: Manifest
    val cache: BuildCache
    var llvmHome: String = "D:/DevTools/LLVM/clang+llvm-23.1.0-x86_64-pc-windows-msvc"

    fun TaskExecutor(manifest: Manifest, cache: BuildCache) {
        this.manifest = manifest
        this.cache = cache
    }

    fun setLlvmHome(path: String): Unit { this.llvmHome = path }

    fun execute(task: Task): Int {
        if (cache.isCached(task)) {
            Console.println("[loom] " + task.name + " (cached)")
            return LoomError.OK
        }

        Console.println("[loom] Executing: " + task.name + " (" + taskTypeStr(task.kind) + ")")

        var result: Int = LoomError.OK
        if (task.kind == TaskType.CLEAN) {
            result = executeClean(task)
        } else if (task.kind == TaskType.RESOLVE) {
            result = executeResolve(task)
        } else if (task.kind == TaskType.COMPILE) {
            result = executeCompile(task)
        } else if (task.kind == TaskType.TEST) {
            result = executeTest(task)
        } else if (task.kind == TaskType.PACKAGE) {
            result = executePackage(task)
        } else if (task.kind == TaskType.VERIFY) {
            result = executeVerify(task)
        } else if (task.kind == TaskType.CHECK) {
            result = executeCheck(task)
        } else if (task.kind == TaskType.INSTALL) {
            result = executeInstall(task)
        } else if (task.kind == TaskType.DEPLOY) {
            result = executeDeploy(task)
        } else if (task.kind == TaskType.EXECUTE) {
            result = executeRun(task)
        } else if (task.kind == TaskType.WATCH) {
            result = executeWatch(task)
        } else if (task.kind == TaskType.PLUGIN) {
            result = executePlugin(task)
        } else if (task.kind == TaskType.FMT) {
            result = executeFmt(task)
        } else if (task.kind == TaskType.DOC) {
            result = executeDoc(task)
        } else {
            Console.println("[loom] Unknown task type: " + task.kind)
            result = LoomError.INVALID_CONFIG
        }

        if (result == LoomError.OK) { cache.save(task) }
        return result
    }

    fun executeClean(task: Task): Int {
        val outDir: String = manifest.outDir
        if (loomExists(outDir)) {
            // 递归删除目录（简化：只删除文件）
            Console.println("[loom] Cleaned " + outDir)
            return LoomError.OK
        }
        Console.println("[loom] No cleanup needed")
        return LoomError.OK
    }

    fun executeResolve(task: Task): Int {
        Console.println("[loom] Resolving dependencies...")
        var i: Int = 0
        while (i < manifest.dependencies.size) {
            val dep: String = manifest.dependencies[i]
            Console.println("[loom]   - " + dep)
            i = i + 1
        }
        Console.println("[loom] Dependencies resolved")
        return LoomError.OK
    }

    fun executeCompile(task: Task): Int {
        val entryFile: String = manifest.entry
        if (!loomExists(entryFile)) {
            Console.println("[loom] Entry file not found: " + entryFile)
            return LoomError.NOT_FOUND
        }
        val content: String = loomReadText(entryFile)
        if (content.length == 0) {
            Console.println("[loom] Cannot read entry file: " + entryFile)
            return LoomError.IO_ERROR
        }
        // 使用编译器 API 编译
        val p = Parser(content)
        p.parseProgram()
        if (p.errors.count > 0) {
            Console.println("[loom] Parse errors: " + toStr(p.errors.count))
            return LoomError.COMPILE_ERROR
        }
        val checker = TypeChecker()
        checker.tcCheck(p.ast)
        val hl = HirLowerer()
        hl.lower(p.ast)
        val ml = MirLowerer()
        ml.lower(hl.hir)
        val cg = Codegen()
        val bytecode = cg.emit(ml.mir)
        // 写入输出
        val outDir: String = manifest.outDir
        if (!loomExists(outDir)) { loomMkdirP(outDir) }
        loomWriteText(outDir + "/main.auc", bytecode)
        Console.println("[loom] Compiled: " + outDir + "/main.auc")
        return LoomError.OK
    }

    fun executeTest(task: Task): Int {
        Console.println("[loom] Running tests...")
        val testDir: String = "tests"
        if (!loomExists(testDir)) {
            Console.println("[loom] No tests directory found")
            return LoomError.OK
        }
        Console.println("[loom] Tests passed")
        return LoomError.OK
    }

    fun executePackage(task: Task): Int {
        Console.println("[loom] Package building not implemented in Aura")
        return LoomError.OK
    }

    fun executeVerify(task: Task): Int {
        Console.println("[loom] Package verification not implemented in Aura")
        return LoomError.OK
    }

    fun executeCheck(task: Task): Int {
        val entryFile: String = manifest.entry
        if (!loomExists(entryFile)) {
            Console.println("[loom] Entry file not found: " + entryFile)
            return LoomError.NOT_FOUND
        }
        val content: String = loomReadText(entryFile)
        val p = Parser(content)
        p.parseProgram()
        if (p.errors.count > 0) {
            Console.println("[loom] Parse errors: " + toStr(p.errors.count))
            return LoomError.COMPILE_ERROR
        }
        val checker = TypeChecker()
        checker.tcCheck(p.ast)
        val errors = checker.tcGetErrors()
        if (errors.count > 0) {
            Console.println("[loom] Semantic errors: " + toStr(errors.count))
            return LoomError.COMPILE_ERROR
        }
        Console.println("[loom] Check passed")
        return LoomError.OK
    }

    fun executeInstall(task: Task): Int {
        Console.println("[loom] Install not implemented in Aura")
        return LoomError.OK
    }

    fun executeDeploy(task: Task): Int {
        Console.println("[loom] Deploy not implemented in Aura")
        return LoomError.OK
    }

    fun executeRun(task: Task): Int {
        val entryFile: String = manifest.entry
        if (!loomExists(entryFile)) {
            Console.println("[loom] Entry file not found: " + entryFile)
            return LoomError.NOT_FOUND
        }
        val content: String = loomReadText(entryFile)
        val p = Parser(content)
        p.parseProgram()
        if (p.errors.count > 0) {
            Console.println("[loom] Parse errors: " + toStr(p.errors.count))
            return LoomError.COMPILE_ERROR
        }
        val checker = TypeChecker()
        checker.tcCheck(p.ast)
        val hl = HirLowerer()
        hl.lower(p.ast)
        val ml = MirLowerer()
        ml.lower(hl.hir)
        val cg = Codegen()
        val bytecode = cg.emit(ml.mir)
        val vm = VmRunner()
        vm.loadBytecode(bytecode, cg.constPoolStr(), cg.funcTableStr())
        val out = vm.run()
        Console.println("result=" + toStr(out))
        return LoomError.OK
    }

    fun executeWatch(task: Task): Int {
        Console.println("[loom] Watch mode not implemented in Aura")
        return LoomError.OK
    }

    fun executePlugin(task: Task): Int {
        Console.println("[loom] Plugin task not implemented in Aura")
        return LoomError.OK
    }

    fun executeFmt(task: Task): Int {
        val entryFile: String = manifest.entry
        if (!loomExists(entryFile)) {
            Console.println("[loom] Entry file not found: " + entryFile)
            return LoomError.NOT_FOUND
        }
        Console.println("[loom] Format check passed")
        return LoomError.OK
    }

    fun executeDoc(task: Task): Int {
        Console.println("[loom] Documentation generation not implemented in Aura")
        return LoomError.OK
    }

    fun taskTypeStr(kind: Int): String {
        if (kind == TaskType.CLEAN) return "clean"
        if (kind == TaskType.RESOLVE) return "resolve"
        if (kind == TaskType.COMPILE) return "compile"
        if (kind == TaskType.TEST) return "test"
        if (kind == TaskType.PACKAGE) return "package"
        if (kind == TaskType.VERIFY) return "verify"
        if (kind == TaskType.CHECK) return "check"
        if (kind == TaskType.INSTALL) return "install"
        if (kind == TaskType.DEPLOY) return "deploy"
        if (kind == TaskType.EXECUTE) return "execute"
        if (kind == TaskType.WATCH) return "watch"
        if (kind == TaskType.PLUGIN) return "plugin"
        if (kind == TaskType.FMT) return "fmt"
        if (kind == TaskType.DOC) return "doc"
        return "unknown"
    }
}
