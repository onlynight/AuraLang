// aura:///loom/aura/lang/loom/TaskExecutor.aura
package aura.lang.loom

import aura.lang.std.Collections
import aura.lang.std.FileSystem
import aura.lang.std.Process

import "Task.aura"
import "Manifest.aura"
import "BuildCache.aura"
import "LoomError.aura"
import "TaskType.aura"
import "FileIO.aura"

// ═══════════════════════════════════════════════════════════════
// TaskExecutor（任务执行器 — 纯 Aura，编译委托外部 aura 编译器）
// ═══════════════════════════════════════════════════════════════

class TaskExecutor {
    val manifest: Manifest
    val cache: BuildCache
    var llvmHome: String
    var auraExe: String

    constructor(manifest: Manifest, cache: BuildCache) {
        this.manifest = manifest
        this.cache = cache
        this.llvmHome = "D:/DevTools/LLVM/clang+llvm-23.1.0-x86_64-pc-windows-msvc"
        this.auraExe = "target/release/aura.exe"
    }

    fun setLlvmHome(path: String): Unit { this.llvmHome = path }
    fun setAuraExe(path: String): Unit { this.auraExe = path }

    fun execute(task: Task): Int {
        if (cache.isCached(task)) {
            println("[loom] " + task.name + " (cached)")
            return LoomError.OK
        }

        println("[loom] Executing: " + task.name + " (" + taskTypeStr(task.kind) + ")")

        var result: Int = LoomError.OK
        if (task.kind == TaskType.CLEAN) {
            result = executeClean(task)
        } else if (task.kind == TaskType.RESOLVE) {
            result = executeResolve(task)
        } else if (task.kind == TaskType.COMPILE) {
            result = executeCompile(task)
        } else if (task.kind == TaskType.TEST) {
            result = executeTest(task)
        } else if (task.kind == TaskType.PACKAGE) {
            result = executePackage(task)
        } else if (task.kind == TaskType.VERIFY) {
            result = executeVerify(task)
        } else if (task.kind == TaskType.CHECK) {
            result = executeCheck(task)
        } else if (task.kind == TaskType.INSTALL) {
            result = executeInstall(task)
        } else if (task.kind == TaskType.DEPLOY) {
            result = executeDeploy(task)
        } else if (task.kind == TaskType.EXECUTE) {
            result = executeRun(task)
        } else if (task.kind == TaskType.WATCH) {
            result = executeWatch(task)
        } else if (task.kind == TaskType.PLUGIN) {
            result = executePlugin(task)
        } else if (task.kind == TaskType.FMT) {
            result = executeFmt(task)
        } else if (task.kind == TaskType.DOC) {
            result = executeDoc(task)
        } else {
            println("[loom] Unknown task type: " + task.kind)
            result = LoomError.INVALID_CONFIG
        }

        if (result == LoomError.OK) { cache.save(task) }
        return result
    }

    fun executeClean(task: Task): Int {
        val outDir: String = manifest.outDir
        if (loomExists(outDir)) {
            loomDeleteDir(outDir)
            println("[loom] Cleaned " + outDir)
            return LoomError.OK
        }
        println("[loom] No cleanup needed")
        return LoomError.OK
    }

    fun executeResolve(task: Task): Int {
        println("[loom] Resolving dependencies...")
        var i: Int = 0
        while (i < manifest.dependencies.size) {
            println("[loom]   - " + manifest.dependencies.get(i))
            i = i + 1
        }
        println("[loom] Dependencies resolved")
        return LoomError.OK
    }

    fun executeCompile(task: Task): Int {
        val entryFile: String = manifest.entry
        if (!loomExists(entryFile)) {
            println("[loom] Entry file not found: " + entryFile)
            return LoomError.NOT_FOUND
        }
        val outDir: String = manifest.outDir
        if (!loomExists(outDir)) { loomMkdirP(outDir) }
        val outPath: String = outDir + "/main.auc"
        val cmd: String = auraExe + " build " + entryFile + " --output " + outPath
        println("[loom] Compiling: " + entryFile + " -> " + outPath)
        val exitCode: Int = Process.run(cmd)
        if (exitCode != 0) {
            println("[loom] Compilation failed (exit code: " + exitCode + ")")
            return LoomError.COMPILE_ERROR
        }
        println("[loom] Compiled: " + outPath)
        return LoomError.OK
    }

    fun executeTest(task: Task): Int {
        println("[loom] Running tests...")
        val testDir: String = "tests"
        if (!loomExists(testDir)) {
            println("[loom] No tests directory found")
            return LoomError.OK
        }
        val cmd: String = auraExe + " build " + testDir + "/test_main.aura"
        val exitCode: Int = Process.run(cmd)
        if (exitCode != 0) {
            println("[loom] Test compilation failed")
            return LoomError.COMPILE_ERROR
        }
        println("[loom] Tests passed")
        return LoomError.OK
    }

    fun executePackage(task: Task): Int {
        println("[loom] Package building not implemented in Aura")
        return LoomError.OK
    }

    fun executeVerify(task: Task): Int {
        println("[loom] Package verification not implemented in Aura")
        return LoomError.OK
    }

    fun executeCheck(task: Task): Int {
        val entryFile: String = manifest.entry
        if (!loomExists(entryFile)) {
            println("[loom] Entry file not found: " + entryFile)
            return LoomError.NOT_FOUND
        }
        val cmd: String = auraExe + " check " + entryFile
        println("[loom] Checking: " + entryFile)
        val exitCode: Int = Process.run(cmd)
        if (exitCode != 0) {
            println("[loom] Check failed (exit code: " + exitCode + ")")
            return LoomError.COMPILE_ERROR
        }
        println("[loom] Check passed")
        return LoomError.OK
    }

    fun executeInstall(task: Task): Int {
        println("[loom] Install not implemented in Aura")
        return LoomError.OK
    }

    fun executeDeploy(task: Task): Int {
        println("[loom] Deploy not implemented in Aura")
        return LoomError.OK
    }

    fun executeRun(task: Task): Int {
        val entryFile: String = manifest.entry
        if (!loomExists(entryFile)) {
            println("[loom] Entry file not found: " + entryFile)
            return LoomError.NOT_FOUND
        }
        val cmd: String = auraExe + " run " + entryFile
        println("[loom] Running: " + entryFile)
        val exitCode: Int = Process.run(cmd)
        return exitCode
    }

    fun executeWatch(task: Task): Int {
        println("[loom] Watch mode not implemented in Aura")
        return LoomError.OK
    }

    fun executePlugin(task: Task): Int {
        println("[loom] Plugin task not implemented in Aura")
        return LoomError.OK
    }

    fun executeFmt(task: Task): Int {
        val entryFile: String = manifest.entry
        if (!loomExists(entryFile)) {
            println("[loom] Entry file not found: " + entryFile)
            return LoomError.NOT_FOUND
        }
        val cmd: String = auraExe + " fmt " + entryFile
        println("[loom] Formatting: " + entryFile)
        val exitCode: Int = Process.run(cmd)
        if (exitCode != 0) {
            println("[loom] Format failed (exit code: " + exitCode + ")")
            return LoomError.COMPILE_ERROR
        }
        println("[loom] Format check passed")
        return LoomError.OK
    }

    fun executeDoc(task: Task): Int {
        println("[loom] Documentation generation not implemented in Aura")
        return LoomError.OK
    }

    fun taskTypeStr(kind: Int): String {
        if (kind == TaskType.CLEAN) return "clean"
        if (kind == TaskType.RESOLVE) return "resolve"
        if (kind == TaskType.COMPILE) return "compile"
        if (kind == TaskType.TEST) return "test"
        if (kind == TaskType.PACKAGE) return "package"
        if (kind == TaskType.VERIFY) return "verify"
        if (kind == TaskType.CHECK) return "check"
        if (kind == TaskType.INSTALL) return "install"
        if (kind == TaskType.DEPLOY) return "deploy"
        if (kind == TaskType.EXECUTE) return "execute"
        if (kind == TaskType.WATCH) return "watch"
        if (kind == TaskType.PLUGIN) return "plugin"
        if (kind == TaskType.FMT) return "fmt"
        if (kind == TaskType.DOC) return "doc"
        return "unknown"
    }
}
