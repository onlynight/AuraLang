package aura.lang.loom.advanced

import aura.lang.std.String
import aura.lang.std.FileSystem
import aura.lang.std.Collections

// ═══════════════════════════════════════════════════════════════
// 工具函数
// ═══════════════════════════════════════════════════════════════

fun basename(path: String): String {
    val lastSlash: Int = path.lastIndexOf("/")
    if (lastSlash < 0) {
        return path
    }
    return String.substring(path, lastSlash + 1)
}

fun dirname(path: String): String {
    val lastSlash: Int = path.lastIndexOf("/")
    if (lastSlash <= 0) {
        return "."
    }
    return String.substring(path, 0, lastSlash)
}

fun fileExists(path: String): Boolean {
    return FileSystem.exists(path)
}

fun listDir(path: String): List<String> {
    if (!FileSystem.exists(path)) {
        return mutableListOf()
    }
    return FileSystem.listFiles(path)
}
