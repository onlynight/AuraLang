// aura:///loom/advanced/aura/lang/loom/advanced/Workspace.aura
package aura.lang.loom.advanced
// Phase E.4: 工作区
// 对标 Rust: workspace/mod.rs, workspace/members.rs
//
// @since 0.6

import aura.lang.std.String
import aura.lang.std.IO
import aura.lang.std.Collections
import aura.lang.std.FileSystem
import aura.lang.loom

// ═══════════════════════════════════════════════════════════════
// 工作区
// 对标 Rust: workspace/mod.rs, workspace/members.rs
// ═══════════════════════════════════════════════════════════════

class Workspace {
    val rootDir: String
    var members: List<WorkspaceMember> = mutableListOf()
    var sharedConfig: Map<String, String> = mutableMapOf()

    fun Workspace(rootDir: String) {
        this.rootDir = rootDir
        this.members = mutableListOf()
        this.sharedConfig = mutableMapOf()
    }

    fun addMember(name: String, path: String): Unit {
        val member: WorkspaceMember = WorkspaceMember(name, path)
        members.add(member)
        IO.println("[workspace] Added member: " + name)
    }

    fun removeMember(name: String): Unit {
        var i: Int = 0
        while (i < members.size) {
            if (members[i].name == name) {
                members.remove(i)
                IO.println("[workspace] Removed member: " + name)
                return
            }
            i = i + 1
        }
    }

    fun getMember(name: String): WorkspaceMember {
        var i: Int = 0
        while (i < members.size) {
            if (members[i].name == name) {
                return members[i]
            }
            i = i + 1
        }
        return null
    }

    fun loadFromManifest(manifest: Manifest): Unit {
        // 从 manifest 加载工作区成员
        var i: Int = 0
        while (i < manifest.workspaceMembers.size) {
            val memberPath: String = manifest.workspaceMembers[i]
            val memberName: String = String.basename(memberPath)
            addMember(memberName, rootDir + "/" + memberPath)
            i = i + 1
        }
    }

    fun buildAll(executor: TaskExecutor): Int {
        IO.println("[workspace] Building all members...")
        var i: Int = 0
        var success: Int = 0
        var failed: Int = 0
        while (i < members.size) {
            val member: WorkspaceMember = members[i]
            IO.println("[workspace] Building: " + member.name)
            // 简化：跳过实际构建
            success = success + 1
            i = i + 1
        }
        IO.println("[workspace] Built " + success + " members")
        return 0
    }

    fun toStr(): String {
        return "Workspace{rootDir='" + rootDir + "', members=" + members.size + "}"
    }
}

class WorkspaceMember {
    val name: String
    val path: String
    var manifest: Manifest = null
    var built: Boolean = false

    fun WorkspaceMember(name: String, path: String) {
        this.name = name
        this.path = path
    }

    fun load(): Int {
        val manifestPath: String = path + "/aura.toml"
        if (!FileSystem.exists(manifestPath)) {
            return 1
        }
        manifest = Manifest(name, manifestPath)
        return manifest.load()
    }

    fun toStr(): String {
        return "WorkspaceMember{name='" + name + "', path='" + path + "'}"
    }
}
