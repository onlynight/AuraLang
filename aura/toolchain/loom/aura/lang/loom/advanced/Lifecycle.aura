// aura:///loom/advanced/aura/lang/loom/advanced/Lifecycle.aura
package aura.lang.loom.advanced

import aura.lang.std.String
import aura.lang.std.Collections
import aura.lang.std.IO

// ═══════════════════════════════════════════════════════════════
// 生命周期钩子
// 对标 Rust: lifecycle/mod.rs, lifecycle/phases.rs
// ═══════════════════════════════════════════════════════════════

object LifecyclePhase {
    const val PRE_BUILD: Int = 0
    const val POST_BUILD: Int = 1
    const val PRE_TEST: Int = 2
    const val POST_TEST: Int = 3
    const val PRE_CLEAN: Int = 4
    const val POST_CLEAN: Int = 5
    const val PRE_PACKAGE: Int = 6
    const val POST_PACKAGE: Int = 7
    const val PRE_INSTALL: Int = 8
    const val POST_INSTALL: Int = 9
}

class LifecycleHook {
    val name: String
    val phase: Int
    var enabled: Boolean = true
    var command: String = ""

    fun LifecycleHook(name: String, phase: Int) {
        this.name = name
        this.phase = phase
    }

    fun LifecycleHook(name: String, phase: Int, command: String) {
        this.name = name
        this.phase = phase
        this.command = command
    }

    fun execute(): Int {
        if (!enabled) {
            return 0
        }
        IO.println("[lifecycle] Executing hook: " + name + " (phase=" + phase + ")")
        if (command.length > 0) {
            IO.println("[lifecycle] Command: " + command)
        }
        return 0
    }

    fun toStr(): String {
        return "LifecycleHook{name='" + name + "', phase=" + phase + "}"
    }
}

class Lifecycle {
    var hooks: List<LifecycleHook> = mutableListOf()

    fun Lifecycle() {
        this.hooks = mutableListOf()
    }

    fun addHook(hook: LifecycleHook): Unit {
        hooks.add(hook)
    }

    fun addHook(name: String, phase: Int): Unit {
        val hook: LifecycleHook = LifecycleHook(name, phase)
        hooks.add(hook)
    }

    fun run(phase: Int): Unit {
        IO.println("[lifecycle] Running phase: " + phase)
        var i: Int = 0
        while (i < hooks.size) {
            val hook: LifecycleHook = hooks[i]
            if (hook.phase == phase && hook.enabled) {
                hook.execute()
            }
            i = i + 1
        }
    }

    fun loadDefaultHooks(): Unit {
        addHook("pre-build", LifecyclePhase.PRE_BUILD)
        addHook("post-build", LifecyclePhase.POST_BUILD)
        addHook("pre-test", LifecyclePhase.PRE_TEST)
        addHook("post-test", LifecyclePhase.POST_TEST)
        addHook("pre-clean", LifecyclePhase.PRE_CLEAN)
        addHook("post-clean", LifecyclePhase.POST_CLEAN)
    }

    fun toStr(): String {
        return "Lifecycle{hooks=" + hooks.size + "}"
    }
}
