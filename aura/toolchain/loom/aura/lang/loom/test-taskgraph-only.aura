// aura:///test/taskgraph-only.aura
package test

import aura.lang.loom.TaskGraph
import aura.lang.loom.Task
import aura.lang.loom.TaskType

fun testTaskGraph(): Int {
    println("creating taskgraph...")
    val tg: TaskGraph = TaskGraph()
    println("taskgraph created")
    tg.addTaskByName("clean", TaskType.CLEAN)
    println("task added")
    return 0
}

fun main(): Int {
    return testTaskGraph()
}
