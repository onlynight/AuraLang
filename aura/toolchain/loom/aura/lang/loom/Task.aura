// aura:///loom/aura/lang/loom/Task.aura
package aura.lang.loom

import aura.lang.std.Collections

// Task — build task definition (factory pattern due to VM constructor bug)
class TaskInputs {
    var files: List<Any>
    constructor() {
        this.files = mutableListOf()
    }
}

class TaskOutputs {
    var files: List<Any>
    constructor() {
        this.files = mutableListOf()
    }
}

class Task {
    var name: String
    var kind: Int
    var description: String
    var inputs: TaskInputs
    var outputs: TaskOutputs
    var dependsOn: List<String>
    var workingDir: String

    // No-arg constructor (VM bug: args not passed)
    constructor() {
        this.name = ""
        this.kind = 0
        this.description = ""
        this.inputs = TaskInputs()
        this.outputs = TaskOutputs()
        this.dependsOn = mutableListOf()
        this.workingDir = "."
    }

    fun setName(n: String): Unit { this.name = n }
    fun setKind(k: Int): Unit { this.kind = k }
    fun setDescription(d: String): Unit { this.description = d }
    fun setWorkingDir(d: String): Unit { this.workingDir = d }

    fun addDep(dep: String): Unit { dependsOn.add(dep) }

    fun toStr(): String {
        return "Task{name='" + name + "', kind=" + kind + ", deps=" + dependsOn.size + "}"
    }
}

// Factory function
fun createTask(name: String, kind: Int): Task {
    val t: Task = Task()
    t.setName(name)
    t.setKind(kind)
    return t
}
