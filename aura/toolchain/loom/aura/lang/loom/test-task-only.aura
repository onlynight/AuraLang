// aura:///test/task-only.aura
package test

import aura.lang.loom.Task
import aura.lang.loom.TaskType

fun testTask(): Int {
    println("creating task...")
    val t: Task = createTask("clean", TaskType.CLEAN)
    println("task created: " + t.name)
    return 0
}

fun main(): Int {
    return testTask()
}
