// aura:///loom/dep/aura/lang/loom/dep/Utils.aura
package aura.lang.loom.dep
// Phase E.4: Loom Dependency Management - Utility Functions
//
// @since 0.6

import aura.lang.std.String
import aura.lang.std.Collections
import aura.lang.loom.dep.Dependency

// ══════════════════════════════════════════════════════════════
// 工具函数
// ══════════════════════════════════════════════════════════════
/// 从依赖字符串解析依赖
fun parseDependency(s: String): Dependency {
    // 格式: name@version 或 name 或 name="version"
    val atIdx: Int = s.indexOf("@")
    if (atIdx > 0) {
        val name: String = String.substring(s, 0, atIdx)
        val version: String = String.substring(s, atIdx + 1)
        return Dependency(name, version)
    }
    
    // 检查是否是 "name = 'version'" 格式
    val eqIdx: Int = s.indexOf("=")
    if (eqIdx > 0) {
        val name: String = String.trim(String.substring(s, 0, eqIdx))
        val version: String = String.unquote(String.trim(String.substring(s, eqIdx + 1)))
        return Dependency(name, version)
    }
    
    return Dependency(s, "*")
}

/// 解析依赖列表
fun parseDependencies(lines: List<String>): List<Dependency> {
    val deps: List<Dependency> = mutableListOf()
    var i: Int = 0
    while (i < lines.size) {
        val line: String = String.trim(lines[i])
        if (line.length > 0 && !line.startsWith("#")) {
            val dep: Dependency = parseDependency(line)
            deps.add(dep)
        }
        i = i + 1
    }
    return deps
}
