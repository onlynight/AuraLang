}

// ═══════════════════════════════════════════════════════════
//  Markdown 渲染
// ═══════════════════════════════════════════════════════════

object DocgenMarkdown {

    /// 渲染为 Markdown。
    fun render(registry: DocRegistry): String {
        val modules: ArrayList<String> = registry.moduleNames()
        val all: ArrayList<DocEntry> = registry.all()
        var out: String = ""

        // 标题
        out = out + "# Aura 标准库 API 文档\n\n"
        out = out + "> 共 " + toStr(modules.size) + " 个模块，" + toStr(all.size) + " 个函数\n\n"

        // 目录
        out = out + "## 目录\n\n"
        var mi: Int = 0
        while (mi < modules.size) {
            val mod: String = modules.get(mi)
            val count: Int = registry.byModule(mod).size
            out = out + "- [std." + mod + "](#std-" + mod + ") — " + toStr(count) + " 个函数\n"
            mi = mi + 1
        }
        out = out + "\n---\n\n"

        // 各模块
        mi = 0
        while (mi < modules.size) {
            val mod: String = modules.get(mi)
            val docs: ArrayList<DocEntry> = registry.byModule(mod)
            out = out + "## std." + mod + "\n\n"
            out = out + "> 函数数: " + toStr(docs.size) + " | [返回目录](#目录)\n\n"

            var di: Int = 0
            while (di < docs.size) {
                val doc: DocEntry = docs.get(di)
                val anchor: String = doc.name.replace(".", "-").replace("/", "-")
                out = out + "### " + doc.name + "\n\n"
                out = out + doc.summary + "\n\n"
                out = out + "**签名:** `" + formatSign(doc) + "`\n\n"

                if (doc.params.size > 0) {
                    out = out + "| 参数 | 类型 | 描述 |\n"
                    out = out + "|------|------|------|\n"
                    var pi: Int = 0
                    while (pi < doc.params.size) {
                        val p: DocParam = doc.params.get(pi)
                        out = out + "| `" + p.name + "` | `" + p.type + "` | " + p.desc + " |\n"
                        pi = pi + 1
                    }
                    out = out + "\n"
                }

                out = out + "**返回值:** `" + doc.returns + "` — " + doc.returnsDesc + "\n\n"

                if (doc.example != "") {
                    out = out + "**示例:**\n\n"
                    out = out + "```aura\n" + doc.example + "\n```\n\n"
                }

                out = out + "---\n\n"
                di = di + 1
            }

            out = out + "---\n\n"
            mi = mi + 1
        }

        return out
    }

    /// 格式化函数签名。
    private fun formatSign(doc: DocEntry): String {
        if (doc.params.size == 0) {
            return doc.name + "(): " + doc.returns
        }
        var sign: String = doc.name + "("
        var i: Int = 0
        while (i < doc.params.size) {
            val p: DocParam = doc.params.get(i)
            if (i > 0) {
                sign = sign + ", "
            }
            sign = sign + p.name + ": " + p.type
            i = i + 1
        }
        sign = sign + "): " + doc.returns
        return sign
    }
}

// ═══════════════════════════════════════════════════════════
//  HTML 渲染
// ═══════════════════════════════════════════════════════════

object DocgenHtml {

    /// 渲染为 HTML。
    fun render(registry: DocRegistry): String {
        val modules: ArrayList<String> = registry.moduleNames()
        val all: ArrayList<DocEntry> = registry.all()
        var out: String = ""

        out = out + "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n"
        out = out + "<meta charset=\"UTF-8\">\n"
        out = out + "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n"
        out = out + "<title>Aura 标准库 API 文档</title>\n"
        out = out + "<style>\n"
        out = out + "body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; "
        out = out + "max-width: 900px; margin: 0 auto; padding: 20px; line-height: 1.6; color: #333; }\n"
        out = out + "h1 { border-bottom: 2px solid #0066cc; padding-bottom: 10px; }\n"
        out = out + "h2 { color: #0066cc; margin-top: 30px; }\n"
        out = out + "h3 { color: #333; margin-top: 20px; }\n"
        out = out + "code { background: #f4f4f4; padding: 2px 6px; border-radius: 3px; font-size: 0.9em; }\n"
        out = out + "pre { background: #f4f4f4; padding: 15px; border-radius: 5px; overflow-x: auto; }\n"
        out = out + "pre code { background: none; padding: 0; }\n"
        out = out + "table { border-collapse: collapse; width: 100%; margin: 10px 0; }\n"
        out = out + "th, td { border: 1px solid #ddd; padding: 8px 12px; text-align: left; }\n"
        out = out + "th { background: #f0f0f0; }\n"
        out = out + "blockquote { border-left: 4px solid #0066cc; margin: 0; padding-left: 15px; color: #666; }\n"
        out = out + "hr { border: none; border-top: 1px solid #eee; margin: 30px 0; }\n"
        out = out + "a { color: #0066cc; text-decoration: none; }\n"
        out = out + "a:hover { text-decoration: underline; }\n"
        out = out + "</style>\n</head>\n<body>\n"

        // 标题
        out = out + "<h1>Aura 标准库 API 文档</h1>\n"
        out = out + "<blockquote>共 " + toStr(modules.size) + " 个模块，" + toStr(all.size) + " 个函数</blockquote>\n\n"

        // 目录
        out = out + "<h2>目录</h2>\n<ul>\n"
        var mi: Int = 0
        while (mi < modules.size) {
            val mod: String = modules.get(mi)
            val count: Int = registry.byModule(mod).size
            out = out + "<li><a href=\"#std" + mod + "\">std." + mod + "</a> — " + toStr(count) + " 个函数</li>\n"
            mi = mi + 1
        }
        out = out + "</ul>\n<hr>\n\n"

        // 各模块
        mi = 0
        while (mi < modules.size) {
            val mod: String = modules.get(mi)
            val docs: ArrayList<DocEntry> = registry.byModule(mod)
            out = out + "<h2 id=\"std" + mod + "\">std." + mod + "</h2>\n"
            out = out + "<blockquote>函数数: " + toStr(docs.size) + " | <a href=\"#目录\">返回目录</a></blockquote>\n\n"

            var di: Int = 0
            while (di < docs.size) {
                val doc: DocEntry = docs.get(di)
                val anchor: String = doc.name.replace(".", "_").replace("/", "_")
                out = out + "<h3 id=\"" + anchor + "\">" + doc.name + "</h3>\n"
                out = out + "<p>" + escapeHtml(doc.summary) + "</p>\n"
                out = out + "<p><strong>签名:</strong> <code>" + escapeHtml(formatSign(doc)) + "</code></p>\n"

                if (doc.params.size > 0) {
                    out = out + "<table>\n<thead><tr><th>参数</th><th>类型</th><th>描述</th></tr></thead>\n<tbody>\n"
                    var pi: Int = 0
                    while (pi < doc.params.size) {
                        val p: DocParam = doc.params.get(pi)
                        out = out + "<tr><td><code>" + escapeHtml(p.name) + "</code></td>"
                        out = out + "<td><code>" + escapeHtml(p.type) + "</code></td>"
                        out = out + "<td>" + escapeHtml(p.desc) + "</td></tr>\n"
                        pi = pi + 1
                    }
                    out = out + "</tbody>\n</table>\n"
                }

                out = out + "<p><strong>返回值:</strong> <code>" + escapeHtml(doc.returns) + "</code> — "
                out = out + escapeHtml(doc.returnsDesc) + "</p>\n"

                if (doc.example != "") {
                    out = out + "<p><strong>示例:</strong></p>\n"
                    out = out + "<pre><code>" + escapeHtml(doc.example) + "</code></pre>\n"
                }

                out = out + "<hr>\n"
                di = di + 1
            }

            out = out + "<hr>\n\n"
            mi = mi + 1
        }

        out = out + "</body>\n</html>\n"
        return out
    }

    /// 格式化函数签名。
    private fun formatSign(doc: DocEntry): String {
        if (doc.params.size == 0) {
            return doc.name + "(): " + doc.returns
        }
        var sign: String = doc.name + "("
        var i: Int = 0
        while (i < doc.params.size) {
            val p: DocParam = doc.params.get(i)
            if (i > 0) {
                sign = sign + ", "
            }
            sign = sign + p.name + ": " + p.type
            i = i + 1
        }
        sign = sign + "): " + doc.returns
        return sign
    }

    /// HTML 转义。
    private fun escapeHtml(s: String): String {
        var result: String = ""
        var i: Int = 0
        val len: Int = s.length
        while (i < len) {
            val c: Int = s.charCodeAt(i)
            if (c == 38) {  // &
                result = result + "&amp;"
            } else if (c == 60) {  // <
                result = result + "&lt;"
            } else if (c == 62) {  // >
                result = result + "&gt;"
            } else if (c == 34) {  // "
                result = result + "&quot;"
            } else {
                result = result + String.fromCharCode(c)
            }
            i = i + 1
        }
        return result
    }
}

// ═══════════════════════════════════════════════════════════
//  CLI 入口
// ═══════════════════════════════════════════════════════════

object DocgenUtils {

    /// 打印用法。
    fun usage(): Unit {
        println("用法: aura doc [选项]")
        println("")
        println("选项:")
        println("  --format <markdown|html>   输出格式（默认: markdown）")
        println("  --output <dir>            输出目录（默认: stdout）")
        println("  --module <name>           仅生成指定模块文档")
        println("  --help                    显示此帮助")
        println("")
        println("示例:")
        println("  aura doc --format html --output ./docs")
        println("  aura doc --module io")
    }

    /// 检查是否包含指定参数。
    private fun hasArg(args: List<String>, target: String): Boolean {
        var i: Int = 0
        while (i < args.size) {
            if (args.get(i) == target) {
                return true
            }
            i = i + 1
        }
        return false
    }

    /// 获取参数值。
    private fun getArgValue(args: List<String>, key: String): String {
        var i: Int = 0
        while (i < args.size) {
            if (args.get(i) == key && i + 1 < args.size) {
                return args.get(i + 1)
            }
            i = i + 1
        }
        return ""
    }

    /// 收集命令行参数为列表。
    private fun collectArgs(): List<String> {
        val args: ArrayList<String> = ArrayList<String>()
        val argc: Int = Process.argCount()
        var i: Int = 0
        while (i < argc) {
            args.add(Process.arg(i))
            i = i + 1
        }
        return args
    }
}

/// 文档生成器入口。
fun main(): Int {
    println("=== Docgen STARTED ===")

    val args: List<String> = DocgenUtils.collectArgs()

    if (DocgenUtils.hasArg(args, "--help") || DocgenUtils.hasArg(args, "-h")) {
        DocgenUtils.usage()
        return 0
    }

    // 解析参数
    val format: String = DocgenUtils.getArgValue(args, "--format")
    val outputDir: String = DocgenUtils.getArgValue(args, "--output")
    val module: String = DocgenUtils.getArgValue(args, "--module")

    // 加载文档
    val registry: DocRegistry = DocRegistryBuilder.new()
    DocRegistryBuilder.loadAll(registry)

    println("已加载 " + toStr(registry.count()) + " 个文档条目")
    println("模块列表: " + toStr(registry.moduleNames().size) + " 个")

    // 渲染
    var content: String = ""
    if (format == "html") {
        content = DocgenHtml.render(registry)
    } else {
        content = DocgenMarkdown.render(registry)
    }

    // 输出
    if (outputDir != "") {
        if (!FileSystem.exists(outputDir)) {
            FileSystem.mkdir(outputDir)
        }
        val ext: String = if (format == "html") "html" else "md"
        val filename: String = if (ext == "html") "index." + ext else "INDEX." + ext.toUpperCase()
        val outPath: String = outputDir + "/" + filename
        IO.fileWrite(outPath, content)
        println("文档已写入: " + outPath)
    } else {
        println(content)
    }

    println("=== Docgen DONE ===")
    return 0
}
