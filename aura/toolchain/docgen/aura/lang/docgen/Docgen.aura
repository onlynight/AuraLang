// aura:///docgen/aura/lang/docgen/Docgen.aura
package aura.lang.docgen

// ─────────────────────────────────────────────────────────────
// Aura 标准库 API 文档生成器 — P2（替代 Rust docgen.rs）
//
// 数据驱动：每个标准库函数以 DocEntry 记录声明式维护，
// 支持 Markdown 和 HTML 两种输出格式。
//
// CLI: aura doc [--format markdown|html] [--output <dir>] [--module <name>]
// ─────────────────────────────────────────────────────────────

import aura.lang.std.String
import aura.lang.std.FileSystem
import aura.lang.std.Process
import aura.lang.collection.ArrayList
import aura.lang.collection.HashMap
import aura.lang.collection.Map

// ═══════════════════════════════════════════════════════════
//  数据结构
// ═══════════════════════════════════════════════════════════

/// 参数描述。
class DocParam {
    var name: String = ""
    var type: String = ""
    var desc: String = ""

    init() {
        this.name = ""
        this.type = ""
        this.desc = ""
    }

    init(name: String, type: String, desc: String) {
        this.name = name
        this.type = type
        this.desc = desc
    }
}

/// 单个函数的文档条目。
class DocEntry {
    var module: String = ""
    var name: String = ""
    var summary: String = ""
    var params: ArrayList<DocParam> = ArrayList<DocParam>()
    var returns: String = ""
    var returnsDesc: String = ""
    var example: String = ""

    init() {
        this.params = ArrayList<DocParam>()
        this.example = ""
    }

    init(module: String, name: String, summary: String,
         params: ArrayList<DocParam>, returns: String,
         returnsDesc: String, example: String) {
        this.module = module
        this.name = name
        this.summary = summary
        this.params = params
        this.returns = returns
        this.returnsDesc = returnsDesc
        this.example = example
    }
}

/// 文档注册表。
class DocRegistry {
    private var entries: ArrayList<DocEntry> = ArrayList<DocEntry>()

    init() {
        this.entries = ArrayList<DocEntry>()
    }

    /// 添加文档条目。
    fun add(entry: DocEntry): Unit {
        this.entries.add(entry)
    }

    /// 获取全部条目数。
    fun count(): Int {
        return this.entries.size
    }

    /// 获取全部条目。
    fun all(): ArrayList<DocEntry> {
        return this.entries
    }

    /// 获取模块名列表（去重）。
    fun moduleNames(): ArrayList<String> {
        val seen: HashMap<String, Boolean> = HashMap<String, Boolean>()
        val names: ArrayList<String> = ArrayList<String>()
        var i: Int = 0
        while (i < this.entries.size) {
            val mod: String = this.entries.get(i).module
            if (!seen.containsKey(mod)) {
                seen.put(mod, true)
                names.add(mod)
            }
            i = i + 1
        }
        return names
    }

    /// 按模块分组。
    fun byModule(mod: String): ArrayList<DocEntry> {
        val result: ArrayList<DocEntry> = ArrayList<DocEntry>()
        var i: Int = 0
        while (i < this.entries.size) {
            if (this.entries.get(i).module == mod) {
                result.add(this.entries.get(i))
            }
            i = i + 1
        }
        return result
    }
}

// ═══════════════════════════════════════════════════════════
//  文档填充（标准库文档数据）
// ═══════════════════════════════════════════════════════════

object DocRegistryBuilder {

    /// 创建空注册表。
    fun new(): DocRegistry {
        return DocRegistry()
    }

    /// 添加一组参数并返回参数列表。
    private fun param(name: String, type: String, desc: String): ArrayList<DocParam> {
        val params: ArrayList<DocParam> = ArrayList<DocParam>()
        params.add(DocParam(name, type, desc))
        return params
    }

    /// 添加多个参数并返回参数列表。
    private fun param2(n1: String, t1: String, d1: String,
                       n2: String, t2: String, d2: String): ArrayList<DocParam> {
        val params: ArrayList<DocParam> = ArrayList<DocParam>()
        params.add(DocParam(n1, t1, d1))
        params.add(DocParam(n2, t2, d2))
        return params
    }

    /// 加载全部标准库文档。
    fun loadAll(registry: DocRegistry): DocRegistry {

        // ── std.io ──
        registry.add(DocEntry(
            "io", "aura.lang.std.IO.println",
            "打印一行文本到标准输出，末尾自动追加换行符。",
            param("msg", "String", "要输出的文本（可多参数拼接）"),
            "Unit", "无返回值",
            "println(\"Hello, Aura!\")"
        ))
        registry.add(DocEntry(
            "io", "aura.lang.std.IO.print",
            "打印文本到标准输出，不追加换行符。",
            param("msg", "String", "要输出的文本"),
            "Unit", "无返回值",
            "print(\"Hello \")  // 不换行"
        ))
        registry.add(DocEntry(
            "io", "aura.lang.std.IO.readLine",
            "从标准输入读取一行文本。",
            ArrayList<DocParam>(),
            "String", "读取到的文本（去除尾部换行），无输入时返回空字符串",
            "val line = IO.readLine()"
        ))
        registry.add(DocEntry(
            "io", "aura.lang.std.IO.fileRead",
            "读取文件全部内容为字符串。",
            param("path", "String", "文件路径"),
            "String", "文件内容，读取失败返回空字符串",
            "val content = IO.fileRead(\"data.txt\")"
        ))
        registry.add(DocEntry(
            "io", "aura.lang.std.IO.fileWrite",
            "将字符串写入文件（覆盖模式）。",
            param2("path", "String", "文件路径", "content", "String", "要写入的内容"),
            "Unit", "写入结果（成功/失败）",
            "IO.fileWrite(\"out.txt\", \"Hello\")"
        ))

        // ── std.math ──
        registry.add(DocEntry(
            "math", "aura.lang.std.Math.abs",
            "返回整数的绝对值。",
            param("n", "Int", "输入整数"),
            "Int", "n 的绝对值",
            "val result = Math.abs(-42)  // 42"
        ))
        registry.add(DocEntry(
            "math", "aura.lang.std.Math.min",
            "返回两个整数中的较小值。",
            param2("a", "Int", "第一个整数", "b", "Int", "第二个整数"),
            "Int", "a 和 b 中的较小值",
            "val result = Math.min(3, 7)  // 3"
        ))
        registry.add(DocEntry(
            "math", "aura.lang.std.Math.max",
            "返回两个整数中的较大值。",
            param2("a", "Int", "第一个整数", "b", "Int", "第二个整数"),
            "Int", "a 和 b 中的较大值",
            "val result = Math.max(3, 7)  // 7"
        ))
        registry.add(DocEntry(
            "math", "aura.lang.std.Math.round",
            "将浮点数四舍五入为整数。",
            param("f", "Float", "输入浮点数"),
            "Int", "四舍五入后的整数",
            "val result = Math.round(3.7)  // 4"
        ))
        registry.add(DocEntry(
            "math", "aura.lang.std.Math.floor",
