// aura:///aura/lang/loom/Dep.aura
// Phase E.4: Loom Dependency Management
//
// 纯 Aura 实现，对标 Rust loom 的 dep/ 模块：
// - resolver.rs: 本地路径解析器
// - bom.rs: Bill of Materials
// - lock.rs: 锁文件管理
// - graph.rs: 依赖图
//
// @since 0.6

import aura.lang.std.String
import aura.lang.std.FileSystem
import aura.lang.std.IO
import aura.lang.std.Collections
import aura.lang.std.Encoding

// ═══════════════════════════════════════════════════════════════
// 依赖定义
// ═══════════════════════════════════════════════════════════════

class Dependency {
    val name: String
    var version: String = "*"
    var path: String = ""  // 本地路径
    var registry: String = ""  // 远程注册表
    var features: List<String> = mutableListOf()
    var optional: Boolean = false

    fun Dependency(name: String) {
        this.name = name
        this.features = mutableListOf()
    }

    fun Dependency(name: String, version: String) {
        this.name = name
        this.version = version
        this.features = mutableListOf()
    }

    fun Dependency(name: String, version: String, path: String) {
        this.name = name
        this.version = version
        this.path = path
        this.features = mutableListOf()
    }

    fun addFeature(feature: String): Unit { features.add(feature) }
    fun setOptional(optional: Boolean): Unit { this.optional = optional }

    fun toStr(): String {
        var s: String = name + "@" + version
        if (path.length > 0) {
            s = s + " (local: " + path + ")"
        }
        if (features.size > 0) {
            s = s + " features=" + features.join(",")
        }
        return s
    }
}

// ═══════════════════════════════════════════════════════════════
// 锁文件（aura.lock）
// 对标 Rust: dep/lock.rs
// ═══════════════════════════════════════════════════════════════

class LockFile {
    val path: String
    var packages: List<LockPackage> = mutableListOf()

    fun LockFile(path: String) {
        this.path = path
        this.packages = mutableListOf()
    }

    fun addPackage(pkg: LockPackage): Unit { packages.add(pkg) }

    fun save(): Unit {
        var content: String = "# Aura lock file\n"
        content = content + "# Generated by loom, do not edit manually\n\n"
        var i: Int = 0
        while (i < packages.size) {
            val pkg: LockPackage = packages[i]
            content = content + "[[package]]\n"
            content = content + "name = \"" + pkg.name + "\"\n"
            content = content + "version = \"" + pkg.version + "\"\n"
            if (pkg.source.length > 0) {
                content = content + "source = \"" + pkg.source + "\"\n"
            }
            if (pkg.checksum.length > 0) {
                content = content + "checksum = \"" + pkg.checksum + "\"\n"
            }
            if (pkg.dependencies.size > 0) {
                content = content + "dependencies = ["
                var j: Int = 0
                while (j < pkg.dependencies.size) {
                    if (j > 0) { content = content + ", " }
                    content = content + "\"" + pkg.dependencies[j] + "\""
                    j = j + 1
                }
                content = content + "]\n"
            }
            content = content + "\n"
            i = i + 1
        }
        FileSystem.writeText(path, content)
    }

    fun load(): Int {
        if (!FileSystem.exists(path)) {
            return 0  // 锁文件不存在，正常
        }
        val content: String = FileSystem.readText(path)
        return parseLock(content)
    }

    fun parseLock(content: String): Int {
        val lines: List<String> = String.splitLines(content)
        var currentPkg: LockPackage = null
        var i: Int = 0
        while (i < lines.size) {
            val line: String = String.trim(lines[i])
            if (line.length == 0 || line.startsWith("#")) {
                i = i + 1
                continue
            }
            if (line == "[[package]]") {
                currentPkg = LockPackage("", "")
                packages.add(currentPkg)
            } else if (currentPkg != null && line.startsWith("name")) {
                val colonIdx: Int = line.indexOf("=")
                if (colonIdx > 0) {
                    val value: String = String.trim(String.substring(line, colonIdx + 1))
                    currentPkg.name = String.unquote(value)
                }
            } else if (currentPkg != null && line.startsWith("version")) {
                val colonIdx: Int = line.indexOf("=")
                if (colonIdx > 0) {
                    val value: String = String.trim(String.substring(line, colonIdx + 1))
                    currentPkg.version = String.unquote(value)
                }
            } else if (currentPkg != null && line.startsWith("source")) {
                val colonIdx: Int = line.indexOf("=")
                if (colonIdx > 0) {
                    val value: String = String.trim(String.substring(line, colonIdx + 1))
                    currentPkg.source = String.unquote(value)
                }
            } else if (currentPkg != null && line.startsWith("checksum")) {
                val colonIdx: Int = line.indexOf("=")
                if (colonIdx > 0) {
                    val value: String = String.trim(String.substring(line, colonIdx + 1))
                    currentPkg.checksum = String.unquote(value)
                }
            }
            i = i + 1
        }
        return 0
    }

    fun find(name: String): LockPackage {
        var i: Int = 0
        while (i < packages.size) {
            if (packages[i].name == name) {
                return packages[i]
            }
            i = i + 1
        }
        return null
    }

    fun len(): Int {
        return packages.size
    }

    fun toStr(): String {
        var s: String = "LockFile{packages=" + packages.size + "}"
        return s
    }
}

class LockPackage {
    val name: String
    val version: String
    var source: String = ""
    var checksum: String = ""
    var dependencies: List<String> = mutableListOf()

    fun LockPackage(name: String, version: String) {
        this.name = name
        this.version = version
        this.dependencies = mutableListOf()
    }

    fun addDependency(dep: String): Unit { dependencies.add(dep) }

    fun toStr(): String {
        var s: String = "LockPackage{name='" + name + "', version='" + version + "'"
        if (source.length > 0) {
            s = s + ", source='" + source + "'"
        }
        s = s + "}"
        return s
    }
}

// ═══════════════════════════════════════════════════════════════
// BOM (Bill of Materials)
// 对标 Rust: dep/bom.rs
// ═══════════════════════════════════════════════════════════════

class Bom {
    var packages: List<BomEntry> = mutableListOf()

    fun addPackage(name: String, version: String, source: String): Unit {
        val entry: BomEntry = BomEntry(name, version, source)
        packages.add(entry)
    }

    fun resolve(deps: List<Dependency>): Int {
        // 简化：仅处理本地路径依赖
        var i: Int = 0
        while (i < deps.size) {
            val dep: Dependency = deps[i]
            if (dep.path.length > 0) {
                // 本地路径依赖
                if (FileSystem.exists(dep.path)) {
                    val manifestPath: String = dep.path + "/aura.toml"
                    if (FileSystem.exists(manifestPath)) {
                        // 读取本地包的 manifest 获取版本
                        val content: String = FileSystem.readText(manifestPath)
                        val version: String = extractVersion(content)
                        addPackage(dep.name, version, "path:" + dep.path)
                    } else {
                        addPackage(dep.name, dep.version, "path:" + dep.path)
                    }
                }
            } else {
                // 远程依赖，跳过
            }
            i = i + 1
        }
        return 0
    }

    fun extractVersion(content: String): String {
        val lines: List<String> = String.splitLines(content)
        var i: Int = 0
        while (i < lines.size) {
            val line: String = String.trim(lines[i])
            if (line.startsWith("version")) {
                val colonIdx: Int = line.indexOf("=")
                if (colonIdx > 0) {
                    val value: String = String.trim(String.substring(line, colonIdx + 1))
                    return String.unquote(value)
                }
            }
            i = i + 1
        }
        return "0.0.0"
    }

    fun toStr(): String {
        var s: String = "Bom{packages=" + packages.size + "}"
        return s
    }
}

class BomEntry {
    val name: String
    val version: String
    val source: String

    fun BomEntry(name: String, version: String, source: String) {
        this.name = name
        this.version = version
        this.source = source
    }

    fun toStr(): String {
        return name + "@" + version + " (" + source + ")"
    }
}

// ═══════════════════════════════════════════════════════════════
// 依赖图
// 对标 Rust: dep/graph.rs
// ═══════════════════════════════════════════════════════════════

class DepGraph {
    var nodes: Map<String, DependencyNode> = mutableMapOf()
    var edges: Map<String, List<String>> = mutableMapOf()

    fun addNode(node: DependencyNode): Unit {
        nodes.put(node.name, node)
    }

    fun addEdge(from: String, to: String): Unit {
        if (!edges.containsKey(from)) {
            edges.put(from, mutableListOf())
        }
        edges.get(from).add(to)
    }

    fun get(name: String): DependencyNode {
        return nodes.getOrDefault(name, null)
    }

    fun contains(name: String): Boolean {
        return nodes.containsKey(name)
    }

    fun len(): Int {
        return nodes.size
    }

    fun toStr(): String {
        var s: String = "DepGraph{nodes=" + nodes.size + ", edges="
        var iter = edges.values()
        var totalEdges: Int = 0
        for (list in iter) {
            totalEdges = totalEdges + list.size
        }
        s = s + totalEdges + "}"
        return s
    }
}

class DependencyNode {
    val name: String
    val version: String
    val deps: List<String> = mutableListOf()

    fun DependencyNode(name: String, version: String) {
        this.name = name
        this.version = version
        this.deps = mutableListOf()
    }

    fun addDep(dep: String): Unit { deps.add(dep) }

    fun toStr(): String {
        return name + "@" + version
    }
}

// ═══════════════════════════════════════════════════════════════
// 依赖解析器
// 对标 Rust: dep/resolver.rs
// ═══════════════════════════════════════════════════════════════

class DepResolver {
    val cacheDir: String = "~/.aura/cache/packages"
    var graph: DepGraph = DepGraph()
    var lockFile: LockFile = null

    fun DepResolver(lockFile: LockFile) {
        this.lockFile = lockFile
    }

    fun resolve(deps: List<Dependency>): Int {
        graph = DepGraph()
        
        var i: Int = 0
        while (i < deps.size) {
            val dep: Dependency = deps[i]
            resolveDep(dep)
            i = i + 1
        }
        
        return 0
    }

    fun resolveDep(dep: Dependency): Unit {
        // 检查锁文件
        if (lockFile != null) {
            val locked: LockPackage = lockFile.find(dep.name)
            if (locked != null) {
                // 使用锁文件中的版本
                val node: DependencyNode = DependencyNode(dep.name, locked.version)
                graph.addNode(node)
                return
            }
        }
        
        // 本地路径依赖
        if (dep.path.length > 0) {
            if (FileSystem.exists(dep.path)) {
                val version: String = resolveLocalVersion(dep.path)
                val node: DependencyNode = DependencyNode(dep.name, version)
                graph.addNode(node)
                return
            }
        }
        
        // 远程依赖（简化：跳过）
        val node: DependencyNode = DependencyNode(dep.name, dep.version)
        graph.addNode(node)
    }

    fun resolveLocalVersion(path: String): String {
        val manifestPath: String = path + "/aura.toml"
        if (FileSystem.exists(manifestPath)) {
            val content: String = FileSystem.readText(manifestPath)
            val lines: List<String> = String.splitLines(content)
            var i: Int = 0
            while (i < lines.size) {
                val line: String = String.trim(lines[i])
                if (line.startsWith("version")) {
                    val colonIdx: Int = line.indexOf("=")
                    if (colonIdx > 0) {
                        val value: String = String.trim(String.substring(line, colonIdx + 1))
                        return String.unquote(value)
                    }
                }
                i = i + 1
            }
        }
        return "0.0.0"
    }
}

// ═══════════════════════════════════════════════════════════════
// 工具函数
// ═══════════════════════════════════════════════════════════════

/// 从依赖字符串解析依赖
fun parseDependency(s: String): Dependency {
    // 格式: name@version 或 name 或 name="version"
    val atIdx: Int = s.indexOf("@")
    if (atIdx > 0) {
        val name: String = String.substring(s, 0, atIdx)
        val version: String = String.substring(s, atIdx + 1)
        return Dependency(name, version)
    }
    
    // 检查是否是 "name = 'version'" 格式
    val eqIdx: Int = s.indexOf("=")
    if (eqIdx > 0) {
        val name: String = String.trim(String.substring(s, 0, eqIdx))
        val version: String = String.unquote(String.trim(String.substring(s, eqIdx + 1)))
        return Dependency(name, version)
    }
    
    return Dependency(s, "*")
}

/// 解析依赖列表
fun parseDependencies(lines: List<String>): List<Dependency> {
    val deps: List<Dependency> = mutableListOf()
    var i: Int = 0
    while (i < lines.size) {
        val line: String = String.trim(lines[i])
        if (line.length > 0 && !line.startsWith("#")) {
            val dep: Dependency = parseDependency(line)
            deps.add(dep)
        }
        i = i + 1
    }
    return deps
}
