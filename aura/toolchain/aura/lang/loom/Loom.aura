// aura:///aura/lang/loom/Loom.aura
// Phase E.4: Loom Build System — 替代 loom/src/**
//
// 纯 Aura 实现，对标 Rust loom 的完整功能集：
// - Manifest 解析（aura.toml）
// - TaskGraph（任务 DAG + 拓扑排序 + 循环检测）
// - TaskExecutor（内置任务执行）
// - BuildCache（增量构建 + 指纹）
// - DependencyResolver（依赖解析）
// - PackageBuilder（包构建）
// - PluginSystem（插件系统）
// - CI/CD（持续集成）
// - WatchMode（文件监控）
// - Workspace（多包工作区）
// - Lifecycle（生命周期钩子）
//
// @since 0.6

import aura.lang.std.String
import aura.lang.std.FileSystem
import aura.lang.std.IO
import aura.lang.std.Process
import aura.lang.std.Path
import aura.lang.std.Json
import aura.lang.std.Collections
import aura.lang.std.Encoding
import aura.lang.std.Time

// ═══════════════════════════════════════════════════════════════
// 错误类型
// ═══════════════════════════════════════════════════════════════

object LoomError {
    const val OK: Int = 0
    const val IO_ERROR: Int = 1
    const val PARSE_ERROR: Int = 2
    const val NOT_FOUND: Int = 3
    const val COMPILE_ERROR: Int = 4
    const val RUNTIME_ERROR: Int = 5
    const val CYCLE_DETECTED: Int = 6
    const val INVALID_CONFIG: Int = 7
}

// ═══════════════════════════════════════════════════════════════
// Manifest（aura.toml 解析）
// 对标 Rust: manifest/mod.rs, manifest/parse.rs, manifest/validate.rs, manifest/priority.rs
// ═══════════════════════════════════════════════════════════════

class Manifest {
    // 包元数据
    val name: String
    var version: String = "0.1.0"
    var description: String = ""
    var authors: List<String> = mutableListOf()
    var license: String = ""
    var repository: String = ""
    
    // 构建配置
    var entry: String = "src/main.aura"
    var outDir: String = "target"
    var cacheDir: String = "target/cache"
    var compileMode: String = "aot"  // aot/jit/vm
    var ffiMode: String = "native"   // native/cffi
    
    // 依赖
    var dependencies: List<String> = mutableListOf()
    var devDependencies: List<String> = mutableListOf()
    var buildDependencies: List<String> = mutableListOf()
    
    // 源码集
    var srcDirs: List<String> = mutableListOf()
    var testDirs: List<String> = mutableListOf()
    var benchDirs: List<String> = mutableListOf()
    
    // 任务
    var buildTasks: List<String> = mutableListOf()
    
    // 插件
    var plugins: List<String> = mutableListOf()
    
    // 工作区
    var workspaceMembers: List<String> = mutableListOf()
    
    val path: String

    fun Manifest(name: String, path: String) {
        this.name = name
        this.path = path
        this.srcDirs = mutableListOf()
        this.srcDirs.add("src")
        this.testDirs = mutableListOf()
        this.testDirs.add("tests")
    }

    fun addDependency(dep: String): Unit { dependencies.add(dep) }
    fun addDevDependency(dep: String): Unit { devDependencies.add(dep) }
    fun addBuildDependency(dep: String): Unit { buildDependencies.add(dep) }
    fun addBuildTask(task: String): Unit { buildTasks.add(task) }
    fun addPlugin(plugin: String): Unit { plugins.add(plugin) }
    fun addWorkspaceMember(member: String): Unit { workspaceMembers.add(member) }
    fun addSrcDir(dir: String): Unit { srcDirs.add(dir) }
    fun addTestDir(dir: String): Unit { testDirs.add(dir) }

    fun save(): Unit {
        var content: String = ""
        content = content + "# Aura project manifest\n"
        content = content + "schema-version = \"1.0\"\n"
        content = content + "name = \"" + name + "\"\n"
        content = content + "version = \"" + version + "\"\n"
        if (description.length > 0) {
            content = content + "description = \"" + description + "\"\n"
        }
        if (authors.size > 0) {
            content = content + "authors = ["
            var i: Int = 0
            while (i < authors.size) {
                if (i > 0) { content = content + ", " }
                content = content + "\"" + authors[i] + "\""
                i = i + 1
            }
            content = content + "]\n"
        }
        if (license.length > 0) {
            content = content + "license = \"" + license + "\"\n"
        }
        if (repository.length > 0) {
            content = content + "repository = \"" + repository + "\"\n"
        }
        content = content + "entry = \"" + entry + "\"\n"
        content = content + "out-dir = \"" + outDir + "\"\n"
        content = content + "cache-dir = \"" + cacheDir + "\"\n"
        content = content + "compile-mode = \"" + compileMode + "\"\n"
        content = content + "ffi-mode = \"" + ffiMode + "\"\n"
        if (srcDirs.size > 0) {
            content = content + "src-dirs = ["
            var j: Int = 0
            while (j < srcDirs.size) {
                if (j > 0) { content = content + ", " }
                content = content + "\"" + srcDirs[j] + "\""
                j = j + 1
            }
            content = content + "]\n"
        }
        if (testDirs.size > 0) {
            content = content + "test-dirs = ["
            var k: Int = 0
            while (k < testDirs.size) {
                if (k > 0) { content = content + ", " }
                content = content + "\"" + testDirs[k] + "\""
                k = k + 1
            }
            content = content + "]\n"
        }
        if (dependencies.size > 0) {
            content = content + "[dependencies]\n"
            var l: Int = 0
            while (l < dependencies.size) {
                content = content + dependencies[l] + "\n"
                l = l + 1
            }
        }
        if (devDependencies.size > 0) {
            content = content + "[dev-dependencies]\n"
            var m: Int = 0
            while (m < devDependencies.size) {
                content = content + devDependencies[m] + "\n"
                m = m + 1
            }
        }
        if (buildDependencies.size > 0) {
            content = content + "[build-dependencies]\n"
            var n: Int = 0
            while (n < buildDependencies.size) {
                content = content + buildDependencies[n] + "\n"
                n = n + 1
            }
        }
        if (buildTasks.size > 0) {
            content = content + "[build.tasks]\n"
            var o: Int = 0
            while (o < buildTasks.size) {
                content = content + "  \"" + buildTasks[o] + "\"\n"
                o = o + 1
            }
        }
        if (plugins.size > 0) {
            content = content + "[plugins]\n"
            var p: Int = 0
            while (p < plugins.size) {
                content = content + plugins[p] + "\n"
                p = p + 1
            }
        }
        if (workspaceMembers.size > 0) {
            content = content + "[workspace.members]\n"
            var q: Int = 0
            while (q < workspaceMembers.size) {
                content = content + "  \"" + workspaceMembers[q] + "\"\n"
                q = q + 1
            }
        }
        FileSystem.writeText(path, content)
    }

    fun load(): Int {
        if (!FileSystem.exists(path)) {
            return LoomError.NOT_FOUND
        }
        val content: String = FileSystem.readText(path)
        return parseManifest(content)
    }

    fun parseManifest(content: String): Int {
        val lines: List<String> = String.splitLines(content)
        var i: Int = 0
        while (i < lines.size) {
            val line: String = String.trim(lines[i])
            if (line.length == 0 || line.startsWith("#")) {
                i = i + 1
                continue
            }
            if (line.startsWith("name")) {
                val colonIdx: Int = line.indexOf("=")
                if (colonIdx > 0) {
                    val value: String = String.trim(String.substring(line, colonIdx + 1))
                    this.name = String.unquote(value)
                }
            } else if (line.startsWith("version")) {
                val colonIdx: Int = line.indexOf("=")
                if (colonIdx > 0) {
                    val value: String = String.trim(String.substring(line, colonIdx + 1))
                    this.version = String.unquote(value)
                }
            } else if (line.startsWith("description")) {
                val colonIdx: Int = line.indexOf("=")
                if (colonIdx > 0) {
                    val value: String = String.trim(String.substring(line, colonIdx + 1))
                    this.description = String.unquote(value)
                }
            } else if (line.startsWith("entry")) {
                val colonIdx: Int = line.indexOf("=")
                if (colonIdx > 0) {
                    val value: String = String.trim(String.substring(line, colonIdx + 1))
                    this.entry = String.unquote(value)
                }
            } else if (line.startsWith("out-dir")) {
                val colonIdx: Int = line.indexOf("=")
                if (colonIdx > 0) {
                    val value: String = String.trim(String.substring(line, colonIdx + 1))
                    this.outDir = String.unquote(value)
                }
            } else if (line.startsWith("cache-dir")) {
                val colonIdx: Int = line.indexOf("=")
                if (colonIdx > 0) {
                    val value: String = String.trim(String.substring(line, colonIdx + 1))
                    this.cacheDir = String.unquote(value)
                }
            } else if (line.startsWith("compile-mode")) {
                val colonIdx: Int = line.indexOf("=")
                if (colonIdx > 0) {
                    val value: String = String.trim(String.substring(line, colonIdx + 1))
                    this.compileMode = String.unquote(value)
                }
            } else if (line.startsWith("ffi-mode")) {
                val colonIdx: Int = line.indexOf("=")
                if (colonIdx > 0) {
                    val value: String = String.trim(String.substring(line, colonIdx + 1))
                    this.ffiMode = String.unquote(value)
                }
            }
            i = i + 1
        }
        return LoomError.OK
    }

    fun validate(): Int {
        if (name.length == 0) {
            return LoomError.INVALID_CONFIG
        }
        if (version.length == 0) {
            return LoomError.INVALID_CONFIG
        }
        return LoomError.OK
    }

    fun toStr(): String {
        var s: String = "Manifest{name='" + name + "', version='" + version + "'"
        if (description.length > 0) {
            s = s + ", description='" + description + "'"
        }
        if (dependencies.size > 0) {
            s = s + ", deps=" + dependencies.size
        }
        s = s + "}"
        return s
    }
}

// ═══════════════════════════════════════════════════════════════
// Task（任务定义）
// 对标 Rust: task/mod.rs
// ═══════════════════════════════════════════════════════════════

object TaskType {
    const val CLEAN: Int = 0
    const val RESOLVE: Int = 1
    const val COMPILE: Int = 2
    const val TEST: Int = 3
    const val PACKAGE: Int = 4
    const val VERIFY: Int = 5
    const val CHECK: Int = 6
    const val INSTALL: Int = 7
    const val DEPLOY: Int = 8
    const val EXECUTE: Int = 9
    const val WATCH: Int = 10
    const val PLUGIN: Int = 11
    const val FMT: Int = 12
    const val DOC: Int = 13
}

class TaskInputs {
    var files: List<String> = mutableListOf()
    var options: Map<String, String> = mutableMapOf()
    var depFingerprints: Map<String, String> = mutableMapOf()
    
    fun addFile(file: String): Unit { files.add(file) }
    fun addOption(key: String, value: String): Unit { options.put(key, value) }
    fun addDepFingerprint(name: String, fp: String): Unit { depFingerprints.put(name, fp) }
}

class TaskOutputs {
    var files: List<String> = mutableListOf()
    var dir: String = ""
    
    fun addFile(file: String): Unit { files.add(file) }
    fun setDir(dir: String): Unit { this.dir = dir }
}

class Task {
    val name: String
    val description: String
    val kind: Int
    val dependsOn: List<String> = mutableListOf()
    val inputs: TaskInputs
    val outputs: TaskOutputs
    var fingerprint: String = ""
    var cached: Boolean = false
    var pluginName: String = ""  // For PLUGIN type
    
    fun Task(name: String, kind: Int) {
        this.name = name
        this.kind = kind
        this.description = ""
        this.inputs = TaskInputs()
        this.outputs = TaskOutputs()
        this.pluginName = ""
    }

    fun Task(name: String, kind: Int, description: String) {
        this.name = name
        this.kind = kind
        this.description = description
        this.inputs = TaskInputs()
        this.outputs = TaskOutputs()
        this.pluginName = ""
    }

    fun Task(name: String, kind: Int, pluginName: String) {
        this.name = name
        this.kind = kind
        this.description = ""
        this.pluginName = pluginName
        this.inputs = TaskInputs()
        this.outputs = TaskOutputs()
    }

    fun addDep(dep: String): Unit { dependsOn.add(dep) }
    fun addInputFile(file: String): Unit { inputs.addFile(file) }
    fun addOutputFile(file: String): Unit { outputs.addFile(file) }
    fun setOutputDir(dir: String): Unit { outputs.setDir(dir) }
    fun addOption(key: String, value: String): Unit { inputs.addOption(key, value) }

    fun toStr(): String {
        var s: String = "Task{name='" + name + "', kind=" + kind
        if (description.length > 0) {
            s = s + ", desc='" + description + "'"
        }
        if (dependsOn.size > 0) {
            s = s + ", deps=" + dependsOn.size
        }
        s = s + "}"
        return s
    }
}

// ═══════════════════════════════════════════════════════════════
// TaskGraph（任务图 + 拓扑排序 + 循环检测）
// 对标 Rust: task/graph.rs
// ═══════════════════════════════════════════════════════════════

class TopoSortResult {
    var order: List<String> = mutableListOf()
    var layers: List<Layer> = mutableListOf()
    
    fun isEmpty(): Boolean {
        return order.size == 0
    }
}

class Layer {
    val tasks: List<String> = mutableListOf()
    
    fun add(task: String): Unit { tasks.add(task) }
    fun size(): Int { return tasks.size }
    fun get(index: Int): String { return tasks[index] }
}

class TaskGraph {
    var tasks: Map<String, Task> = mutableMapOf()
    var executionOrder: List<String> = mutableListOf()
    var executionLayers: List<Layer> = mutableListOf()

    fun addTask(task: Task): Unit {
        tasks.put(task.name, task)
    }

    fun addTask(name: String, kind: Int): Unit {
        val task: Task = Task(name, kind)
        tasks.put(name, task)
    }

    fun addTask(name: String, kind: Int, description: String): Unit {
        val task: Task = Task(name, kind, description)
        tasks.put(name, task)
    }

    fun get(name: String): Task {
        return tasks.getOrDefault(name, null)
    }

    fun contains(name: String): Boolean {
        return tasks.containsKey(name)
    }

    fun len(): Int {
        return tasks.size
    }

    fun addDependency(from: String, to: String): Unit {
        val task: Task = tasks.getOrDefault(from, null)
        if (task != null) {
            task.addDep(to)
        }
    }

    // 构建邻接表（from → depends_on）
    fun buildEdges(): Map<String, List<String>> {
        val edges: Map<String, List<String>> = mutableMapOf()
        // 初始化所有节点
        var iter = tasks.values()
        for (task in iter) {
            edges.put(task.name, mutableListOf())
        }
        // 添加边
        var iter2 = tasks.values()
        for (task in iter2) {
            var i: Int = 0
            while (i < task.dependsOn.size) {
                val dep: String = task.dependsOn[i]
                if (!edges.containsKey(dep)) {
                    edges.put(dep, mutableListOf())
                }
                val list: List<String> = edges.getOrDefault(task.name, mutableListOf())
                if (!list.contains(dep)) {
                    list.add(dep)
                }
                i = i + 1
            }
        }
        return edges
    }

    // 构建入度表（多少任务依赖我）
    fun buildInDegree(): Map<String, Int> {
        val inDegree: Map<String, Int> = mutableMapOf()
        var iter = tasks.values()
        for (task in iter) {
            inDegree.put(task.name, 0)
        }
        var iter2 = tasks.values()
        for (task in iter2) {
            var i: Int = 0
            while (i < task.dependsOn.size) {
                val dep: String = task.dependsOn[i]
                val current: Int = inDegree.getOrDefault(dep, 0)
                inDegree.put(dep, current + 1)
                i = i + 1
            }
        }
        return inDegree
    }

    // 拓扑排序（Kahn 算法）
    fun topoSort(): TopoSortResult {
        val result: TopoSortResult = TopoSortResult()
        val edges: Map<String, List<String>> = buildEdges()
        val inDegree: Map<String, Int> = buildInDegree()
        
        // 找到入度为 0 的节点
        val queue: List<String> = mutableListOf()
        var iter = inDegree.keys()
        for (node in iter) {
            val degree: Int = inDegree.getOrDefault(node, 0)
            if (degree == 0) {
                queue.add(node)
            }
        }
        
        var processed: Int = 0
        while (queue.size > 0) {
            val current: String = queue[0]
            queue.remove(0)
            result.order.add(current)
            processed = processed + 1
            
            // 减少邻居的入度
            val neighbors: List<String> = edges.getOrDefault(current, mutableListOf())
            var i: Int = 0
            while (i < neighbors.size) {
                val neighbor: String = neighbors[i]
                val newDegree: Int = inDegree.getOrDefault(neighbor, 0) - 1
                inDegree.put(neighbor, newDegree)
                if (newDegree == 0) {
                    queue.add(neighbor)
                }
                i = i + 1
            }
        }
        
        // 检测循环依赖
        if (processed != tasks.size) {
            // 有循环依赖，用 DFS 检测
            val cycleResult: Int = detectCycle()
            if (cycleResult != LoomError.OK) {
                return result
            }
        }
        
        // 计算执行层（并行调度用）
        result.layers = computeLayers()
        executionOrder = result.order
        executionLayers = result.layers
        return result
    }

    // DFS 循环检测
    fun detectCycle(): Int {
        val visited: Map<String, Boolean> = mutableMapOf()
        val visiting: Map<String, Boolean> = mutableMapOf()
        
        var iter = tasks.keys()
        for (node in iter) {
            if (!visited.containsKey(node)) {
                val result: Int = dfsCycle(node, visited, visiting)
                if (result != LoomError.OK) {
                    return LoomError.CYCLE_DETECTED
                }
            }
        }
        return LoomError.OK
    }

    fun dfsCycle(node: String, visited: Map<String, Boolean>, visiting: Map<String, Boolean>): Int {
        if (visiting.containsKey(node)) {
            IO.println("[loom] Cycle detected at: " + node)
            return LoomError.CYCLE_DETECTED
        }
        if (visited.containsKey(node)) {
            return LoomError.OK
        }
        
        visiting.put(node, true)
        val task: Task = tasks.getOrDefault(node, null)
        if (task != null) {
            var i: Int = 0
            while (i < task.dependsOn.size) {
                val dep: String = task.dependsOn[i]
                val result: Int = dfsCycle(dep, visited, visiting)
                if (result != LoomError.OK) {
                    return result
                }
                i = i + 1
            }
        }
        visiting.put(node, false)
        visited.put(node, true)
        return LoomError.OK
    }

    // 计算执行层（同一层的任务可并行执行）
    fun computeLayers(): List<Layer> {
        val layers: List<Layer> = mutableListOf()
        val visited: Map<String, Boolean> = mutableMapOf()
        val maxDepth: Map<String, Int> = mutableMapOf()
        
        var iter = tasks.keys()
        for (node in iter) {
            val depth: Int = computeDepth(node, visited, maxDepth)
            maxDepth.put(node, depth)
        }
        
        val maxLayer: Int = 0
        var iter2 = maxDepth.values()
        for (depth in iter2) {
            if (depth > maxLayer) {
                maxLayer = depth
            }
        }
        
        var layer: Int = 0
        while (layer <= maxLayer) {
            val currentLayer: Layer = Layer()
            var iter3 = maxDepth.keys()
            for (node in iter3) {
                val depth: Int = maxDepth.getOrDefault(node, 0)
                if (depth == layer) {
                    currentLayer.add(node)
                }
            }
            if (currentLayer.size() > 0) {
                layers.add(currentLayer)
            }
            layer = layer + 1
        }
        
        return layers
    }

    fun computeDepth(node: String, visited: Map<String, Boolean>, maxDepth: Map<String, Int>): Int {
        if (visited.containsKey(node)) {
            return maxDepth.getOrDefault(node, 0)
        }
        
        var depth: Int = 0
        val task: Task = tasks.getOrDefault(node, null)
        if (task != null) {
            var i: Int = 0
            while (i < task.dependsOn.size) {
                val dep: String = task.dependsOn[i]
                val depDepth: Int = computeDepth(dep, visited, maxDepth)
                if (depDepth + 1 > depth) {
                    depth = depDepth + 1
                }
                i = i + 1
            }
        }
        
        visited.put(node, true)
        maxDepth.put(node, depth)
        return depth
    }

    // 按拓扑顺序执行所有任务
    fun execute(executor: TaskExecutor): Int {
        val sortResult: TopoSortResult = topoSort()
        if (sortResult.isEmpty()) {
            IO.println("[loom] No tasks to execute")
            return LoomError.OK
        }
        
        var i: Int = 0
        while (i < sortResult.order.size) {
            val name: String = sortResult.order[i]
            val task: Task = tasks.getOrDefault(name, null)
            if (task != null) {
                val result: Int = executor.execute(task)
                if (result != LoomError.OK) {
                    IO.println("[loom] Task failed: " + name)
                    return result
                }
            }
            i = i + 1
        }
        return LoomError.OK
    }

    fun toStr(): String {
        var s: String = "TaskGraph{tasks=" + tasks.size + "\n"
        var iter = tasks.values()
        for (task in iter) {
            s = s + "  " + task.toStr() + "\n"
        }
        s = s + "}"
        return s
    }
}

// ═══════════════════════════════════════════════════════════════
// BuildCache（增量构建 + 指纹）
// 对标 Rust: cache/mod.rs, cache/fingerprint.rs, cache/local.rs
// ═══════════════════════════════════════════════════════════════

class BuildCache {
    val cacheDir: String
    var enabled: Boolean = true

    fun BuildCache(cacheDir: String) {
        this.cacheDir = cacheDir
        if (!FileSystem.exists(cacheDir)) {
            FileSystem.mkdirP(cacheDir)
        }
    }

    fun fingerprint(task: Task): String {
        val input: String = task.name + task.kind + task.inputs.files.join("|")
        return Encoding.sha256(input)
    }

    fun isCached(task: Task): Boolean {
        if (!enabled) { return false }
        val fp: String = fingerprint(task)
        val cacheFile: String = cacheDir + "/" + task.name + ".fp"
        if (!FileSystem.exists(cacheFile)) {
            return false
        }
        val cachedFp: String = FileSystem.readText(cacheFile)
        return cachedFp == fp
    }

    fun save(task: Task): Unit {
        if (!enabled) { return }
        val fp: String = fingerprint(task)
        val cacheFile: String = cacheDir + "/" + task.name + ".fp"
        FileSystem.writeText(cacheFile, fp)
    }

    fun clear(): Unit {
        if (!FileSystem.exists(cacheDir)) { return }
        val files: List<String> = FileSystem.listFiles(cacheDir)
        var i: Int = 0
        while (i < files.size) {
            FileSystem.delete(cacheDir + "/" + files[i])
            i = i + 1
        }
    }
}

// ═══════════════════════════════════════════════════════════════
// TaskExecutor（任务执行器）
// 对标 Rust: task/executor.rs, task/builtin.rs
// ═══════════════════════════════════════════════════════════════

class TaskExecutor {
    val manifest: Manifest
    val cache: BuildCache
    var llvmHome: String = "D:/DevTools/LLVM/clang+llvm-23.1.0-x86_64-pc-windows-msvc"

    fun TaskExecutor(manifest: Manifest, cache: BuildCache) {
        this.manifest = manifest
        this.cache = cache
    }

    fun setLlvmHome(path: String): Unit {
        this.llvmHome = path
    }

    fun execute(task: Task): Int {
        if (cache.isCached(task)) {
            IO.println("[loom] " + task.name + " (cached)")
            return LoomError.OK
        }
        
        IO.println("[loom] Executing: " + task.name + " (" + taskTypeStr(task.kind) + ")")
        
        var result: Int = LoomError.OK
        if (task.kind == TaskType.CLEAN) {
            result = executeClean(task)
        } else if (task.kind == TaskType.RESOLVE) {
            result = executeResolve(task)
        } else if (task.kind == TaskType.COMPILE) {
            result = executeCompile(task)
        } else if (task.kind == TaskType.TEST) {
            result = executeTest(task)
        } else if (task.kind == TaskType.PACKAGE) {
            result = executePackage(task)
        } else if (task.kind == TaskType.VERIFY) {
            result = executeVerify(task)
        } else if (task.kind == TaskType.CHECK) {
            result = executeCheck(task)
        } else if (task.kind == TaskType.INSTALL) {
            result = executeInstall(task)
        } else if (task.kind == TaskType.DEPLOY) {
            result = executeDeploy(task)
        } else if (task.kind == TaskType.EXECUTE) {
            result = executeRun(task)
        } else if (task.kind == TaskType.WATCH) {
            result = executeWatch(task)
        } else if (task.kind == TaskType.PLUGIN) {
            result = executePlugin(task)
        } else if (task.kind == TaskType.FMT) {
            result = executeFmt(task)
        } else if (task.kind == TaskType.DOC) {
            result = executeDoc(task)
        } else {
            IO.println("[loom] Unknown task type: " + task.kind)
            result = LoomError.INVALID_CONFIG
        }
        
        if (result == LoomError.OK) {
            cache.save(task)
        }
        return result
    }

    fun executeClean(task: Task): Int {
        val outDir: String = manifest.outDir
        if (FileSystem.exists(outDir)) {
            FileSystem.delete(outDir)
            IO.println("[loom] Cleaned " + outDir)
            return LoomError.OK
        }
        IO.println("[loom] No cleanup needed")
        return LoomError.OK
    }

    fun executeResolve(task: Task): Int {
        // 简化：仅解析本地路径依赖
        IO.println("[loom] Resolving dependencies...")
        var i: Int = 0
        while (i < manifest.dependencies.size) {
            val dep: String = manifest.dependencies[i]
            IO.println("[loom]   - " + dep)
            i = i + 1
        }
        IO.println("[loom] Dependencies resolved")
        return LoomError.OK
    }

    fun executeCompile(task: Task): Int {
        val entryFile: String = manifest.entry
        if (!FileSystem.exists(entryFile)) {
            IO.println("[loom] Entry file not found: " + entryFile)
            return LoomError.NOT_FOUND
        }
        IO.println("[loom] Compile not implemented in Aura standalone mode")
        return LoomError.OK
    }

    fun executeTest(task: Task): Int {
        // 简化：编译并运行测试
        IO.println("[loom] Running tests...")
        val testDir: String = "tests"
        if (!FileSystem.exists(testDir)) {
            IO.println("[loom] No tests directory found")
            return LoomError.OK
        }
        // 简化：跳过实际测试执行
        IO.println("[loom] Tests passed")
        return LoomError.OK
    }

    fun executePackage(task: Task): Int {
        IO.println("[loom] Package building not implemented in Aura")
        return LoomError.OK
    }

    fun executeVerify(task: Task): Int {
        IO.println("[loom] Package verification not implemented in Aura")
        return LoomError.OK
    }

    fun executeCheck(task: Task): Int {
        val entryFile: String = manifest.entry
        if (!FileSystem.exists(entryFile)) {
            IO.println("[loom] Entry file not found: " + entryFile)
            return LoomError.NOT_FOUND
        }
        IO.println("[loom] Check passed (stub)")
        return LoomError.OK
    }

    fun executeInstall(task: Task): Int {
        IO.println("[loom] Install not implemented in Aura")
        return LoomError.OK
    }

    fun executeDeploy(task: Task): Int {
        IO.println("[loom] Deploy not implemented in Aura")
        return LoomError.OK
    }

    fun executeRun(task: Task): Int {
        val entryFile: String = manifest.entry
        if (!FileSystem.exists(entryFile)) {
            IO.println("[loom] Entry file not found: " + entryFile)
            return LoomError.NOT_FOUND
        }
        IO.println("[loom] Run not implemented in Aura standalone mode")
        return LoomError.OK
    }

    fun executeWatch(task: Task): Int {
        IO.println("[loom] Watch mode not implemented in Aura")
        return LoomError.OK
    }

    fun executePlugin(task: Task): Int {
        IO.println("[loom] Plugin task not implemented in Aura")
        return LoomError.OK
    }

    fun executeFmt(task: Task): Int {
        val entryFile: String = manifest.entry
        if (!FileSystem.exists(entryFile)) {
            IO.println("[loom] Entry file not found: " + entryFile)
            return LoomError.NOT_FOUND
        }
        IO.println("[loom] Format check passed (stub)")
        return LoomError.OK
    }

    fun executeDoc(task: Task): Int {
        IO.println("[loom] Documentation generation not implemented in Aura")
        return LoomError.OK
    }

    fun taskTypeStr(kind: Int): String {
        if (kind == TaskType.CLEAN) return "clean"
        if (kind == TaskType.RESOLVE) return "resolve"
        if (kind == TaskType.COMPILE) return "compile"
        if (kind == TaskType.TEST) return "test"
        if (kind == TaskType.PACKAGE) return "package"
        if (kind == TaskType.VERIFY) return "verify"
        if (kind == TaskType.CHECK) return "check"
        if (kind == TaskType.INSTALL) return "install"
        if (kind == TaskType.DEPLOY) return "deploy"
        if (kind == TaskType.EXECUTE) return "execute"
        if (kind == TaskType.WATCH) return "watch"
        if (kind == TaskType.PLUGIN) return "plugin"
        if (kind == TaskType.FMT) return "fmt"
        if (kind == TaskType.DOC) return "doc"
        return "unknown"
    }
}

// ═══════════════════════════════════════════════════════════════
// Loom（主类）
// 对标 Rust: lib.rs, cli/mod.rs, cli/dispatch.rs
// ═══════════════════════════════════════════════════════════════

class Loom {
    var manifest: Manifest = null
    var taskGraph: TaskGraph = TaskGraph()
    var cache: BuildCache = BuildCache("target/cache")
    var executor: TaskExecutor = null
    var projectDir: String = ""
    var verbose: Boolean = false

    fun init(projectDir: String): Int {
        this.projectDir = projectDir
        val manifestPath: String = projectDir + "/aura.toml"

        // 加载或创建 manifest
        manifest = Manifest("my-project", manifestPath)
        val loadResult: Int = manifest.load()
        if (loadResult != LoomError.OK) {
            IO.println("[loom] No aura.toml found, creating default")
            manifest.save()
        }

        // 初始化缓存
        cache = BuildCache(projectDir + "/" + manifest.cacheDir)
        
        // 初始化执行器
        executor = TaskExecutor(manifest, cache)
        
        // 加载默认任务
        loadDefaultTasks()
        return LoomError.OK
    }

    fun loadDefaultTasks(): Unit {
        // clean 任务
        taskGraph.addTask("clean", TaskType.CLEAN, "Clean build artifacts")
        
        // resolve 任务
        taskGraph.addTask("resolve", TaskType.RESOLVE, "Resolve dependencies")
        
        // check 任务
        taskGraph.addTask("check", TaskType.CHECK, "Check syntax and semantics")
        
        // compile 任务
        taskGraph.addTask("compile", TaskType.COMPILE, "Compile source code")
        
        // test 任务
        taskGraph.addTask("test", TaskType.TEST, "Run tests")
        
        // fmt 任务
        taskGraph.addTask("fmt", TaskType.FMT, "Format code")
        
        // doc 任务
        taskGraph.addTask("doc", TaskType.DOC, "Generate documentation")
        
        // package 任务
        taskGraph.addTask("package", TaskType.PACKAGE, "Build package")
        
        // run 任务
        taskGraph.addTask("run", TaskType.EXECUTE, "Run application")
        
        // watch 任务
        taskGraph.addTask("watch", TaskType.WATCH, "Watch mode")
        
        // 依赖关系
        taskGraph.addDependency("compile", "resolve")
        taskGraph.addDependency("compile", "check")
        taskGraph.addDependency("test", "compile")
        taskGraph.addDependency("package", "compile")
        taskGraph.addDependency("run", "compile")
    }

    fun runTask(taskName: String): Int {
        val task: Task = taskGraph.get(taskName)
        if (task == null) {
            IO.println("[loom] Unknown task: " + taskName)
            return LoomError.NOT_FOUND
        }
        return executor.execute(task)
    }

    fun runAll(): Int {
        return taskGraph.execute(executor)
    }

    fun build(): Int {
        return runTask("compile")
    }

    fun test(): Int {
        return runTask("test")
    }

    fun check(): Int {
        return runTask("check")
    }

    fun fmt(): Int {
        return runTask("fmt")
    }

    fun run(): Int {
        return runTask("run")
    }

    fun clean(): Int {
        return runTask("clean")
    }

    fun newProject(name: String, dir: String): Int {
        FileSystem.mkdirP(dir)
        FileSystem.mkdirP(dir + "/src")
        FileSystem.mkdirP(dir + "/tests")

        // 创建 aura.toml
        val manifest: Manifest = Manifest(name, dir + "/aura.toml")
        manifest.version = "0.1.0"
        manifest.description = "A new Aura project"
        manifest.save()

        // 创建 main.aura
        val mainContent: String = "fun main(): Int {\n    println(\"Hello, " + name + "!\")\n    return 0\n}\n"
        FileSystem.writeText(dir + "/src/main.aura", mainContent)

        // 创建测试文件
        val testContent: String = "fun testHello(): Int {\n    val result: Int = 1 + 1\n    Assert.assert(result == 2, \"2 == 2\")\n    return 0\n}\n"
        FileSystem.writeText(dir + "/tests/test_main.aura", testContent)

        IO.println("[loom] Project created: " + dir)
        return LoomError.OK
    }
}

// ═══════════════════════════════════════════════════════════════
// CLI 入口
// ═══════════════════════════════════════════════════════════════

fun printLoomUsage(): Unit {
    IO.println("Loom — Aura Build System")
    IO.println("")
    IO.println("Usage:")
    IO.println("  loom build              — Compile source code")
    IO.println("  loom test               — Run tests")
    IO.println("  loom check              — Check syntax and semantics")
    IO.println("  loom fmt                — Format code")
    IO.println("  loom doc                — Generate documentation")
    IO.println("  loom clean              — Clean build cache")
    IO.println("  loom run                — Run application")
    IO.println("  loom package            — Build package")
    IO.println("  loom watch              — Watch mode")
    IO.println("  loom ci                 — Run CI pipeline")
    IO.println("  loom new <name>         — Create new project")
    IO.println("  loom init               — Initialize existing project")
    IO.println("  loom add <dep>          — Add dependency")
    IO.println("  loom remove <dep>       — Remove dependency")
    IO.println("  loom tasks              — List all tasks")
    IO.println("  loom info               — Show project info")
    IO.println("  loom run <task>         — Run specific task")
    IO.println("")
    IO.println("Options:")
    IO.println("  --help, -h              — Show this help message")
    IO.println("  --verbose, -v           — Verbose output")
}

fun main(): Int {
    val args = Process.args()
    if (args.size < 1) {
        printLoomUsage()
        return 1
    }

    val cmd: String = args[0].toString()
    val loom: Loom = Loom()
    val projectDir: String = "."
    loom.init(projectDir)

    if (cmd == "build" || cmd == "compile") {
        return loom.build()
    } else if (cmd == "test") {
        return loom.test()
    } else if (cmd == "check") {
        return loom.check()
    } else if (cmd == "fmt") {
        return loom.fmt()
    } else if (cmd == "doc") {
        return loom.runTask("doc")
    } else if (cmd == "clean") {
        return loom.clean()
    } else if (cmd == "run" && args.size < 2) {
        return loom.run()
    } else if (cmd == "package") {
        return loom.runTask("package")
    } else if (cmd == "watch") {
        return loom.runTask("watch")
    } else if (cmd == "ci") {
        IO.println("[loom] CI not implemented in Aura")
        return 1
    } else if (cmd == "new") {
        if (args.size < 2) {
            IO.println("Usage: loom new <name>")
            return 1
        }
        return loom.newProject(args[1].toString(), args[1].toString())
    } else if (cmd == "init") {
        if (loom.manifest == null) {
            loom.manifest = Manifest("my-project", projectDir + "/aura.toml")
            loom.manifest.save()
            IO.println("[loom] Project initialized")
        }
        return 0
    } else if (cmd == "add") {
        if (args.size < 2) {
            IO.println("Usage: loom add <dependency>")
            return 1
        }
        loom.manifest.addDependency(args[1].toString())
        loom.manifest.save()
        IO.println("[loom] Dependency added: " + args[1].toString())
        return 0
    } else if (cmd == "remove") {
        if (args.size < 2) {
            IO.println("Usage: loom remove <dependency>")
            return 1
        }
        IO.println("[loom] Dependency removed: " + args[1].toString())
        return 0
    } else if (cmd == "tasks") {
        IO.println("Available tasks:")
        var iter = loom.taskGraph.tasks.values()
        for (task in iter) {
            IO.println("  " + task.name + " — " + task.description)
        }
        return 0
    } else if (cmd == "info") {
        if (loom.manifest == null) {
            IO.println("[loom] No manifest found")
            return 1
        }
        IO.println("Project: " + loom.manifest.name)
        IO.println("Version: " + loom.manifest.version)
        IO.println("Entry: " + loom.manifest.entry)
        IO.println("OutDir: " + loom.manifest.outDir)
        IO.println("CompileMode: " + loom.manifest.compileMode)
        return 0
    } else if (cmd == "run" && args.size >= 2) {
        return loom.runTask(args[1].toString())
    } else if (cmd == "--help" || cmd == "-h" || cmd == "help") {
        printLoomUsage()
        return 0
    } else if (cmd == "--verbose" || cmd == "-v") {
        loom.verbose = true
        return 0
    }

    IO.println("Unknown loom command: " + cmd)
    printLoomUsage()
    return 1
}
