import aura.lang.std.String
import aura.lang.std.FileSystem
import aura.lang.std.IO
import aura.lang.std.Collections
import aura.lang.std.Time

// ═══════════════════════════════════════════════════════════════
// CI/CD 配置
// 对标 Rust: ci/mod.rs, ci/config.rs
// ═══════════════════════════════════════════════════════════════

class CiConfig {
    var phases: List<String> = mutableListOf()
    var timeout: Int = 300  // seconds
    var parallel: Boolean = false
    var notify: List<String> = mutableListOf()

    fun CiConfig() {
        this.phases = mutableListOf()
        this.notify = mutableListOf()
    }

    fun addPhase(phase: String): Unit {
        phases.add(phase)
    }

    fun addNotify(target: String): Unit {
        notify.add(target)
    }

    fun run(executor: TaskExecutor): Int {
        IO.println("[ci] Starting CI pipeline")
        IO.println("[ci]   Timeout: " + timeout + "s")
        IO.println("[ci]   Parallel: " + parallel)
        
        var i: Int = 0
        while (i < phases.size) {
            val phase: String = phases[i]
            IO.println("[ci] Running phase: " + phase)
            
            // 执行阶段任务
            val result: Int = executor.executeByName(phase)
            if (result != 0) {
                IO.println("[ci] Phase failed: " + phase)
                return result
            }
            
            IO.println("[ci] Phase passed: " + phase)
            i = i + 1
        }
        
        IO.println("[ci] CI pipeline completed")
        
        // 发送通知
        var j: Int = 0
        while (j < notify.size) {
            val target: String = notify[j]
            IO.println("[ci] Notifying: " + target)
            j = j + 1
        }
        
        return 0
    }

    fun toStr(): String {
        return "CiConfig{phases=" + phases.size + ", timeout=" + timeout + "}"
    }
}

// ═══════════════════════════════════════════════════════════════
// Watch 模式
// 对标 Rust: watch/mod.rs, watch/monitor.rs
// ═══════════════════════════════════════════════════════════════

class Watcher {
    var watching: Boolean = false
    var watchPaths: List<String> = mutableListOf()
    var callback: Int = 0  // callback id
    var lastCheckTime: Long = 0
    var pollInterval: Int = 1000  // ms

    fun Watcher() {
        this.watchPaths = mutableListOf()
    }

    fun start(paths: List<String>): Int {
        watchPaths = paths
        watching = true
        lastCheckTime = Time.currentTimeMillis()
        IO.println("[watch] Watching " + paths.size + " paths")
        return 0
    }

    fun stop(): Unit {
        watching = false
        IO.println("[watch] Watch stopped")
    }

    fun isWatching(): Boolean {
        return watching
    }

    fun check(): Int {
        if (!watching) {
            return 0
        }
        
        val currentTime: Long = Time.currentTimeMillis()
        if (currentTime - lastCheckTime < pollInterval) {
            return 0
        }
        
        lastCheckTime = currentTime
        
        // 简化：检查文件修改时间
        var i: Int = 0
        while (i < watchPaths.size) {
            val path: String = watchPaths[i]
            if (FileSystem.exists(path)) {
                // 简化：跳过实际文件监控
            }
            i = i + 1
        }
        
        return 0
    }

    fun toStr(): String {
        return "Watcher{watching=" + watching + ", paths=" + watchPaths.size + "}"
    }
}

// ═══════════════════════════════════════════════════════════════
// 工作区
// 对标 Rust: workspace/mod.rs, workspace/members.rs
// ═══════════════════════════════════════════════════════════════

class Workspace {
    val rootDir: String
    var members: List<WorkspaceMember> = mutableListOf()
    var sharedConfig: Map<String, String> = mutableMapOf()

    fun Workspace(rootDir: String) {
        this.rootDir = rootDir
        this.members = mutableListOf()
        this.sharedConfig = mutableMapOf()
    }

    fun addMember(name: String, path: String): Unit {
        val member: WorkspaceMember = WorkspaceMember(name, path)
        members.add(member)
        IO.println("[workspace] Added member: " + name)
    }

    fun removeMember(name: String): Unit {
        var i: Int = 0
        while (i < members.size) {
            if (members[i].name == name) {
                members.remove(i)
                IO.println("[workspace] Removed member: " + name)
                return
            }
            i = i + 1
        }
    }

    fun getMember(name: String): WorkspaceMember {
        var i: Int = 0
        while (i < members.size) {
            if (members[i].name == name) {
                return members[i]
            }
            i = i + 1
        }
        return null
    }

    fun loadFromManifest(manifest: Manifest): Unit {
        // 从 manifest 加载工作区成员
        var i: Int = 0
        while (i < manifest.workspaceMembers.size) {
            val memberPath: String = manifest.workspaceMembers[i]
            val memberName: String = String.basename(memberPath)
            addMember(memberName, rootDir + "/" + memberPath)
            i = i + 1
        }
    }

    fun buildAll(executor: TaskExecutor): Int {
        IO.println("[workspace] Building all members...")
        var i: Int = 0
        var success: Int = 0
        var failed: Int = 0
        while (i < members.size) {
            val member: WorkspaceMember = members[i]
            IO.println("[workspace] Building: " + member.name)
            // 简化：跳过实际构建
            success = success + 1
            i = i + 1
        }
        IO.println("[workspace] Built " + success + " members")
        return 0
    }

    fun toStr(): String {
        return "Workspace{rootDir='" + rootDir + "', members=" + members.size + "}"
    }
}

class WorkspaceMember {
    val name: String
    val path: String
    var manifest: Manifest = null
    var built: Boolean = false

    fun WorkspaceMember(name: String, path: String) {
        this.name = name
        this.path = path
    }

    fun load(): Int {
        val manifestPath: String = path + "/aura.toml"
        if (!FileSystem.exists(manifestPath)) {
            return 1
        }
        manifest = Manifest(name, manifestPath)
        return manifest.load()
    }

    fun toStr(): String {
        return "WorkspaceMember{name='" + name + "', path='" + path + "'}"
    }
}

// ═══════════════════════════════════════════════════════════════
// 生命周期钩子
// 对标 Rust: lifecycle/mod.rs, lifecycle/phases.rs
// ═══════════════════════════════════════════════════════════════

object LifecyclePhase {
    const val PRE_BUILD: Int = 0
    const val POST_BUILD: Int = 1
    const val PRE_TEST: Int = 2
    const val POST_TEST: Int = 3
    const val PRE_CLEAN: Int = 4
    const val POST_CLEAN: Int = 5
    const val PRE_PACKAGE: Int = 6
    const val POST_PACKAGE: Int = 7
    const val PRE_INSTALL: Int = 8
    const val POST_INSTALL: Int = 9
}

class LifecycleHook {
    val name: String
    val phase: Int
    var enabled: Boolean = true
    var command: String = ""

    fun LifecycleHook(name: String, phase: Int) {
        this.name = name
        this.phase = phase
    }

    fun LifecycleHook(name: String, phase: Int, command: String) {
        this.name = name
        this.phase = phase
        this.command = command
    }

    fun execute(): Int {
        if (!enabled) {
            return 0
        }
        IO.println("[lifecycle] Executing hook: " + name + " (phase=" + phase + ")")
        if (command.length > 0) {
            IO.println("[lifecycle] Command: " + command)
        }
        return 0
    }

    fun toStr(): String {
        return "LifecycleHook{name='" + name + "', phase=" + phase + "}"
    }
}

class Lifecycle {
    var hooks: List<LifecycleHook> = mutableListOf()

    fun Lifecycle() {
        this.hooks = mutableListOf()
    }

    fun addHook(hook: LifecycleHook): Unit {
        hooks.add(hook)
    }

    fun addHook(name: String, phase: Int): Unit {
        val hook: LifecycleHook = LifecycleHook(name, phase)
        hooks.add(hook)
    }

    fun run(phase: Int): Unit {
        IO.println("[lifecycle] Running phase: " + phase)
        var i: Int = 0
        while (i < hooks.size) {
            val hook: LifecycleHook = hooks[i]
            if (hook.phase == phase && hook.enabled) {
                hook.execute()
            }
            i = i + 1
        }
    }

    fun loadDefaultHooks(): Unit {
        // 默认钩子
        addHook("pre-build", LifecyclePhase.PRE_BUILD)
        addHook("post-build", LifecyclePhase.POST_BUILD)
        addHook("pre-test", LifecyclePhase.PRE_TEST)
        addHook("post-test", LifecyclePhase.POST_TEST)
        addHook("pre-clean", LifecyclePhase.PRE_CLEAN)
        addHook("post-clean", LifecyclePhase.POST_CLEAN)
    }

    fun toStr(): String {
        return "Lifecycle{hooks=" + hooks.size + "}"
    }
}

// ═══════════════════════════════════════════════════════════════
// 源码集
// 对标 Rust: sourceset/mod.rs, sourceset/discover.rs, sourceset/resolve.rs
// ═══════════════════════════════════════════════════════════════

class SourceSet {
    val name: String
    val srcDir: String
    var files: List<String> = mutableListOf()
    var testDir: String = ""
    var testFiles: List<String> = mutableListOf()

    fun SourceSet(name: String, srcDir: String) {
        this.name = name
        this.srcDir = srcDir
        this.files = mutableListOf()
        this.testFiles = mutableListOf()
    }

    fun discover(): Int {
        if (!FileSystem.exists(srcDir)) {
            return 1
        }
        val found: List<String> = FileSystem.listFiles(srcDir)
        var i: Int = 0
        while (i < found.size) {
            val file: String = found[i]
            if (file.endsWith(".aura")) {
                files.add(file)
            }
            i = i + 1
        }
        IO.println("[sourceset] Discovered " + files.size + " files in " + srcDir)
        return 0
    }

    fun resolve(include: List<String>): Unit {
        // 简化：直接使用所有文件
    }

    fun getFiles(): List<String> {
        return files
    }

    fun len(): Int {
        return files.size
    }

    fun toStr(): String {
        return "SourceSet{name='" + name + "', files=" + files.size + "}"
    }
}

class SourceSetManager {
    var sourceSets: List<SourceSet> = mutableListOf()

    fun SourceSetManager() {
        this.sourceSets = mutableListOf()
    }

    fun addSourceSet(set: SourceSet): Unit {
        sourceSets.add(set)
    }

    fun addSourceSet(name: String, srcDir: String): Unit {
        val set: SourceSet = SourceSet(name, srcDir)
        sourceSets.add(set)
    }

    fun discoverAll(): Int {
        IO.println("[sourceset] Discovering all source sets...")
        var i: Int = 0
        while (i < sourceSets.size) {
            sourceSets[i].discover()
            i = i + 1
        }
        return 0
    }

    fun resolveAll(include: List<String>): Unit {
        var i: Int = 0
        while (i < sourceSets.size) {
            sourceSets[i].resolve(include)
            i = i + 1
        }
    }

    fun getAllFiles(): List<String> {
        val allFiles: List<String> = mutableListOf()
        var i: Int = 0
        while (i < sourceSets.size) {
            val files: List<String> = sourceSets[i].getFiles()
            var j: Int = 0
            while (j < files.size) {
                allFiles.add(files[j])
                j = j + 1
            }
            i = i + 1
        }
        return allFiles
    }

    fun toStr(): String {
        return "SourceSetManager{sourceSets=" + sourceSets.size + "}"
    }
}

// ═══════════════════════════════════════════════════════════════
// 标准库编译
// 对标 Rust: stdlib/mod.rs
// ═══════════════════════════════════════════════════════════════

class StdlibBuilder {
    val projectDir: String
    val outDir: String
    var verbose: Boolean = false

    fun StdlibBuilder(projectDir: String, outDir: String) {
        this.projectDir = projectDir
        this.outDir = outDir
    }

    fun build(): Int {
        IO.println("[stdlib] Building standard library...")
        
        // 简化：跳过实际构建
        IO.println("[stdlib] Standard library built")
        
        return 0
    }

    fun compileModule(modulePath: String): Int {
        if (!FileSystem.exists(modulePath)) {
            IO.println("[stdlib] Module not found: " + modulePath)
            return 1
        }
        IO.println("[stdlib] Compiling: " + modulePath)
        return 0
    }
}

// ═══════════════════════════════════════════════════════════════
// 工具函数
// ═══════════════════════════════════════════════════════════════

/// 获取文件名（不含路径）
fun basename(path: String): String {
    val lastSlash: Int = path.lastIndexOf("/")
    if (lastSlash < 0) {
        return path
    }
    return String.substring(path, lastSlash + 1)
}

/// 获取目录名
fun dirname(path: String): String {
    val lastSlash: Int = path.lastIndexOf("/")
    if (lastSlash <= 0) {
        return "."
    }
    return String.substring(path, 0, lastSlash)
}

/// 检查文件是否存在
fun fileExists(path: String): Boolean {
    return FileSystem.exists(path)
}

/// 列出目录文件
fun listDir(path: String): List<String> {
    if (!FileSystem.exists(path)) {
        return mutableListOf()
    }
    return FileSystem.listFiles(path)
}
