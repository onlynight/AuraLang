// aura:///aura/lang/loom/Plugin.aura
// Phase E.4: Loom Plugin System
//
// 纯 Aura 实现，对标 Rust loom 的 plugin/ 模块：
// - trait.rs: 插件接口
// - context.rs: 插件上下文
// - registry.rs: 插件注册表
// - explicit.rs: 显式插件
// - external.rs: 外部插件
// - convention.rs: 约定式插件
//
// @since 0.6

import aura.lang.std.String
import aura.lang.std.FileSystem
import aura.lang.std.IO
import aura.lang.std.Collections
import aura.lang.std.Json

// ═══════════════════════════════════════════════════════════════
// 插件接口
// 对标 Rust: plugin/trait.rs
// ═══════════════════════════════════════════════════════════════

class Plugin {
    val name: String
    val version: String
    var enabled: Boolean = true
    var config: String = ""
    var tasks: List<String> = mutableListOf()

    fun Plugin(name: String, version: String) {
        this.name = name
        this.version = version
        this.tasks = mutableListOf()
    }

    fun addTask(task: String): Unit { tasks.add(task) }

    // 生命周期钩子
    fun onInit(projectDir: String): Int {
        IO.println("[plugin] " + name + " initialized")
        return 0
    }

    fun beforeBuild(): Int {
        return 0
    }

    fun afterBuild(): Int {
        return 0
    }

    fun beforeTest(): Int {
        return 0
    }

    fun afterTest(): Int {
        return 0
    }

    fun beforeClean(): Int {
        return 0
    }

    fun afterClean(): Int {
        return 0
    }

    fun beforePackage(): Int {
        return 0
    }

    fun afterPackage(): Int {
        return 0
    }

    fun onTask(taskName: String): Int {
        // 执行插件自定义任务
        IO.println("[plugin] " + name + " executing task: " + taskName)
        return 0
    }

    fun toStr(): String {
        return "Plugin{name='" + name + "', version='" + version + "', tasks=" + tasks.size + "}"
    }
}

// ═══════════════════════════════════════════════════════════════
// 插件上下文
// 对标 Rust: plugin/context.rs
// ═══════════════════════════════════════════════════════════════

class PluginContext {
    val projectDir: String
    var manifest: String = ""
    var outDir: String = "target"
    var cacheDir: String = "target/cache"
    var compileMode: String = "aot"
    var env: Map<String, String> = mutableMapOf()
    var logs: List<String> = mutableListOf()

    fun PluginContext(projectDir: String) {
        this.projectDir = projectDir
        this.env = mutableMapOf()
        this.logs = mutableListOf()
    }

    fun setManifest(manifest: String): Unit { this.manifest = manifest }
    fun setOutDir(dir: String): Unit { this.outDir = dir }
    fun setCacheDir(dir: String): Unit { this.cacheDir = dir }
    fun setCompileMode(mode: String): Unit { this.compileMode = mode }

    fun getEnv(key: String): String {
        return env.getOrDefault(key, "")
    }

    fun setEnv(key: String, value: String): Unit {
        env.put(key, value)
    }

    fun log(message: String): Unit {
        logs.add(message)
    }

    fun getLogs(): List<String> {
        return logs
    }

    fun toStr(): String {
        return "PluginContext{projectDir='" + projectDir + "', outDir='" + outDir + "'}"
    }
}

// ═══════════════════════════════════════════════════════════════
// 插件注册表
// 对标 Rust: plugin/registry.rs
// ═══════════════════════════════════════════════════════════════

class PluginRegistry {
    var plugins: List<Plugin> = mutableListOf()
    var contexts: Map<String, PluginContext> = mutableMapOf()

    fun register(plugin: Plugin): Unit {
        plugins.add(plugin)
        IO.println("[registry] Plugin registered: " + plugin.name)
    }

    fun unregister(name: String): Unit {
        var i: Int = 0
        while (i < plugins.size) {
            if (plugins[i].name == name) {
                plugins.remove(i)
                IO.println("[registry] Plugin unregistered: " + name)
                return
            }
            i = i + 1
        }
    }

    fun get(name: String): Plugin {
        var i: Int = 0
        while (i < plugins.size) {
            if (plugins[i].name == name) {
                return plugins[i]
            }
            i = i + 1
        }
        return null
    }

    fun contains(name: String): Boolean {
        return get(name) != null
    }

    fun len(): Int {
        return plugins.size
    }

    fun list(): List<Plugin> {
        return plugins
    }

    fun initAll(projectDir: String): Int {
        var i: Int = 0
        while (i < plugins.size) {
            val plugin: Plugin = plugins[i]
            if (plugin.enabled) {
                plugin.onInit(projectDir)
                contexts.put(plugin.name, PluginContext(projectDir))
            }
            i = i + 1
        }
        return 0
    }

    fun runBeforeBuild(): Unit {
        var i: Int = 0
        while (i < plugins.size) {
            val plugin: Plugin = plugins[i]
            if (plugin.enabled) {
                plugin.beforeBuild()
            }
            i = i + 1
        }
    }

    fun runAfterBuild(): Unit {
        var i: Int = 0
        while (i < plugins.size) {
            val plugin: Plugin = plugins[i]
            if (plugin.enabled) {
                plugin.afterBuild()
            }
            i = i + 1
        }
    }

    fun runBeforeTest(): Unit {
        var i: Int = 0
        while (i < plugins.size) {
            val plugin: Plugin = plugins[i]
            if (plugin.enabled) {
                plugin.beforeTest()
            }
            i = i + 1
        }
    }

    fun runAfterTest(): Unit {
        var i: Int = 0
        while (i < plugins.size) {
            val plugin: Plugin = plugins[i]
            if (plugin.enabled) {
                plugin.afterTest()
            }
            i = i + 1
        }
    }

    fun toStr(): String {
        var s: String = "PluginRegistry{plugins=" + plugins.size + "\n"
        var i: Int = 0
        while (i < plugins.size) {
            s = s + "  " + plugins[i].toStr() + "\n"
            i = i + 1
        }
        s = s + "}"
        return s
    }
}

// ═══════════════════════════════════════════════════════════════
// 显式插件
// 对标 Rust: plugin/explicit.rs
// ═══════════════════════════════════════════════════════════════

class ExplicitPlugin {
    val name: String
    val path: String
    var version: String = "0.1.0"

    fun ExplicitPlugin(name: String, path: String) {
        this.name = name
        this.path = path
    }

    fun load(): Plugin {
        // 简化：创建插件实例
        val plugin: Plugin = Plugin(name, version)
        IO.println("[explicit] Loaded plugin: " + name)
        return plugin
    }
}

// ═══════════════════════════════════════════════════════════════
// 外部插件
// 对标 Rust: plugin/external.rs
// ═══════════════════════════════════════════════════════════════

class ExternalPlugin {
    val name: String
    val command: String
    var args: List<String> = mutableListOf()

    fun ExternalPlugin(name: String, command: String) {
        this.name = name
        this.command = command
        this.args = mutableListOf()
    }

    fun addArg(arg: String): Unit { args.add(arg) }

    fun load(): Plugin {
        // 简化：创建插件实例
        val plugin: Plugin = Plugin(name, "0.1.0")
        IO.println("[external] Loaded plugin: " + name)
        return plugin
    }
}

// ═══════════════════════════════════════════════════════════════
// 约定式插件
// 对标 Rust: plugin/convention.rs
// ═══════════════════════════════════════════════════════════════

object ConventionPlugin {
    // 约定式插件自动发现
    fun discover(projectDir: String): List<Plugin> {
        val plugins: List<Plugin> = mutableListOf()
        val pluginDir: String = projectDir + "/.aura/plugins"
        if (FileSystem.exists(pluginDir)) {
            // 简化：返回空列表
            IO.println("[convention] Plugin directory found: " + pluginDir)
        }
        return plugins
    }

    // 内置插件
    fun builtin(): List<Plugin> {
        val plugins: List<Plugin> = mutableListOf()
        
        // 格式化插件
        val fmtPlugin: Plugin = Plugin("formatter", "0.1.0")
        fmtPlugin.addTask("fmt")
        plugins.add(fmtPlugin)
        
        // 文档插件
        val docPlugin: Plugin = Plugin("docgen", "0.1.0")
        docPlugin.addTask("doc")
        plugins.add(docPlugin)
        
        // 测试插件
        val testPlugin: Plugin = Plugin("testrunner", "0.1.0")
        testPlugin.addTask("test")
        plugins.add(testPlugin)
        
        return plugins
    }
}

// ═══════════════════════════════════════════════════════════════
// 插件加载器
// ═══════════════════════════════════════════════════════════════

class PluginLoader {
    val registry: PluginRegistry
    val projectDir: String

    fun PluginLoader(registry: PluginRegistry, projectDir: String) {
        this.registry = registry
        this.projectDir = projectDir
    }

    fun loadAll(plugins: List<String>): Int {
        var i: Int = 0
        while (i < plugins.size) {
            val pluginSpec: String = plugins[i]
            loadPlugin(pluginSpec)
            i = i + 1
        }
        
        // 加载约定式插件
        val conventionPlugins: List<Plugin> = ConventionPlugin.discover(projectDir)
        var j: Int = 0
        while (j < conventionPlugins.size) {
            registry.register(conventionPlugins[j])
            j = j + 1
        }
        
        // 加载内置插件
        val builtinPlugins: List<Plugin> = ConventionPlugin.builtin()
        var k: Int = 0
        while (k < builtinPlugins.size) {
            registry.register(builtinPlugins[k])
            k = k + 1
        }
        
        return 0
    }

    fun loadPlugin(spec: String): Int {
        // 格式: name@version 或 name=path
        val eqIdx: Int = spec.indexOf("=")
        if (eqIdx > 0) {
            // 显式插件: name=path
            val name: String = String.substring(spec, 0, eqIdx)
            val path: String = String.substring(spec, eqIdx + 1)
            val plugin: ExplicitPlugin = ExplicitPlugin(name, path)
            registry.register(plugin.load())
            return 0
        }
        
        val atIdx: Int = spec.indexOf("@")
        if (atIdx > 0) {
            // 版本指定: name@version
            val name: String = String.substring(spec, 0, atIdx)
            val version: String = String.substring(spec, atIdx + 1)
            val plugin: Plugin = Plugin(name, version)
            registry.register(plugin)
            return 0
        }
        
        // 仅名称: name
        val plugin: Plugin = Plugin(spec, "0.1.0")
        registry.register(plugin)
        return 0
    }
}
