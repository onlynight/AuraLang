@native fun exportHeader(src: String): String { }

@native fun leakCheck(src: String): String { }

// ── 命令行参数解析 ──

/// 命令行参数容器
class Args {
    var raw: List<String> = mutableListOf()

    fun add(arg: String): Unit { raw.add(arg) }

    fun get(index: Int): String { return raw[index] }

    fun size(): Int { return raw.size }

    fun isEmpty(): Boolean { return raw.size == 0 }

    fun hasFlag(flag: String): Boolean {
        var i: Int = 0
        while (i < raw.size) {
            if (raw[i] == flag) { return true }
            i = i + 1
        }
        return false
    }

    fun getValue(flag: String): String {
        var i: Int = 0
        while (i < raw.size - 1) {
            if (raw[i] == flag) { return raw[i + 1] }
            i = i + 1
        }
        return ""
    }
}

/// 从原生进程参数构建 Args
fun parseArgs(): Args {
    val args = Args()
    // 通过 native 调用获取进程参数
    val rawArgs = Process.args()
    var i: Int = 0
    while (i < rawArgs.size) {
        args.add(rawArgs[i].toString())
        i = i + 1
    }
    return args
}

// ── 帮助信息 ──

fun printUsage(): Unit {
    IO.println("Aura language toolchain")
    IO.println("")
    IO.println("Usage:")
    IO.println("  aura build <file.aura> [--output <out>]        Compile to bytecode .auc / native executable")
    IO.println("  aura build <file.aura> --aot [--output <exe>]   AOT compile to native executable")
    IO.println("  aura build <file.aura> --aot-embed              Compile .auc v4 (embed AOT machine code)")
    IO.println("  aura build <file.aura> --lib [--output <out>]   Compile to library")
    IO.println("  aura run <file.aura>                            Compile and run")
    IO.println("  aura check <file.aura>                          Syntax/semantics check only")
    IO.println("  aura disasm <file.auc> [--source <file.aura>]   Disassemble .auc")
    IO.println("  aura tokens <file.aura>                         Output lexer tokens")
    IO.println("  aura ast <file.aura>                            Output AST")
    IO.println("  aura fmt <file.aura> [--check]                  Format code")
    IO.println("  aura leak-check <file.aura>                     Memory leak check")
    IO.println("  aura doc [--output <dir>]                       Generate documentation")
    IO.println("  aura eval [--expr <code>]                       Evaluate expression")
    IO.println("  aura repl                                       Interactive REPL")
    IO.println("  aura install                                    Install dependencies")
    IO.println("  aura update                                     Update dependencies")
    IO.println("  aura publish                                    Publish package")
    IO.println("  aura deps                                       List dependencies")
    IO.println("  aura new                                        Create new project")
    IO.println("  aura package <file.aura>                        Package as .auz")
    IO.println("  aura inspect <file.auz>                         Inspect .auz package")
    IO.println("  aura verify <file.auz>                          Verify .auz package")
    IO.println("  aura lsp                                        Start LSP server")
    IO.println("  aura debug <file.aura>                          Start debugger")
    IO.println("  aura export-header <file.aura>                  Export C ABI header")
    IO.println("")
