// ── 入口函数 ──

fun main(): Int {
    val args: Args = parseArgs()
    if (args.isEmpty()) {
        printUsage()
        return 1
    }

    val cmd: String = args.get(0)
    // 构建子命令参数（跳过第一个参数 = 命令名）
    val subArgs = Args()
    var i: Int = 1
    while (i < args.size) {
        subArgs.add(args.get(i))
        i = i + 1
    }

    if (cmd == "build") {
        return cmdBuild(subArgs)
    } else if (cmd == "run") {
        return cmdRun(subArgs)
    } else if (cmd == "check") {
        return cmdCheck(subArgs)
    } else if (cmd == "disasm") {
        return cmdDisasm(subArgs)
    } else if (cmd == "tokens") {
        return cmdTokens(subArgs)
    } else if (cmd == "ast") {
        return cmdAst(subArgs)
    } else if (cmd == "fmt") {
        return cmdFmt(subArgs)
    } else if (cmd == "leak-check") {
        return cmdLeakCheck(subArgs)
    } else if (cmd == "doc") {
        return cmdDoc(subArgs)
    } else if (cmd == "eval") {
        return cmdEval(subArgs)
    } else if (cmd == "repl") {
        return cmdRepl(subArgs)
    } else if (cmd == "install") {
        return cmdInstall(subArgs)
    } else if (cmd == "update") {
        return cmdUpdate(subArgs)
    } else if (cmd == "publish") {
        return cmdPublish(subArgs)
    } else if (cmd == "deps") {
        return cmdDepList(subArgs)
    } else if (cmd == "new") {
        return cmdNew(subArgs)
    } else if (cmd == "package") {
        return cmdPackage(subArgs)
    } else if (cmd == "inspect") {
        return cmdInspect(subArgs)
    } else if (cmd == "verify") {
        return cmdVerify(subArgs)
    } else if (cmd == "lsp") {
        return cmdLsp(subArgs)
    } else if (cmd == "debug") {
        return cmdDebug(subArgs)
    } else if (cmd == "export-header") {
        return cmdExportHeader(subArgs)
    } else if (cmd == "--help" || cmd == "-h" || cmd == "help") {
        printUsage()
        return 0
    } else if (cmd == "--version") {
        IO.println("Aura v0.6.0")
        return 0
    }

    IO.println("Unknown subcommand: " + cmd)
    printUsage()
    return 1
}