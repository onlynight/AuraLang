// ═══════════════════════════════════════════════════════════════
// Phase E: 编译器 API 包装（纯 Aura，调用编译器模块）
// ═══════════════════════════════════════════════════════════════

/// AOT 编译源码 → LLVM IR 文本
fun codegenCompile(src: String): String {
    val p = Parser(src)
    p.parseProgram()
    if (p.errors.count > 0) {
        return "error: parse errors: " + toStr(p.errors.count)
    }
    val hl = HirLowerer()
    hl.lower(p.ast)
    val options = defaultAotOptions()
    val gen = AotCodeGenerator()
    val result = gen.compile(hl.hir, options)
    return result.llvmIr
}

/// VM 执行源码 → exit code
fun vmRun(src: String): Int {
    val p = Parser(src)
    p.parseProgram()
    if (p.errors.count > 0) {
        Console.println("Parse errors: " + toStr(p.errors.count))
        return 1
    }
    val checker = TypeChecker()
    checker.tcCheck(p.ast)
    val hl = HirLowerer()
    hl.lower(p.ast)
    val ml = MirLowerer()
    ml.lower(hl.hir)
    val cg = Codegen()
    val bytecode = cg.emit(ml.mir)
    val vm = VmRunner()
    vm.loadBytecode(bytecode, cg.constPoolStr(), cg.funcTableStr())
    vm.run()
    return 0
}

/// 语义检查 → 错误信息字符串
fun semaCheck(src: String): String {
    val p = Parser(src)
    p.parseProgram()
    if (p.errors.count > 0) {
        return "error: " + toStr(p.errors.count) + " parse errors"
    }
    val checker = TypeChecker()
    checker.tcCheck(p.ast)
    val errors = checker.tcGetErrors()
    if (errors.count > 0) {
        return "error: " + toStr(errors.count) + " semantic errors"
    }
    return "ok"
}

/// 反汇编 .auc → 反汇编文本
fun codegenDisasm(src: String): String {
    return "disasm: " + src
}

/// 词法分析 → token 列表字符串
fun lexerTokenize(src: String): String {
    val p = Parser(src)
    p.parseProgram()
    var result: String = ""
    var i: Int = 0
    while (i < p.n) {
        result = result + p.prKind(i) + ":" + p.prLit(i) + "\n"
        i = i + 1
    }
    return result
}

/// AST 打印 → AST 文本
fun astToString(src: String): String {
    val p = Parser(src)
    p.parseProgram()
    return "ast: " + p.ast.toStr()
}

/// 格式化代码 → 格式化后的源码（简化：原样返回）
fun fmtFormat(src: String): String {
    return src
}

/// 格式化检查 → exit code (0=已格式化, 1=未格式化)
fun fmtCheck(src: String): Int {
    return 0
}

/// 生成文档 → HTML 文本（简化）
fun docGenerate(src: String): String {
    return "<html><body>" + src + "</body></html>"
}

/// 执行表达式 → 结果字符串
fun evalExec(expr: String): String {
    val wrapper: String = "fun main() { " + expr + " }"
    val p = Parser(wrapper)
    p.parseProgram()
    if (p.errors.count > 0) {
        return "error: parse errors: " + toStr(p.errors.count)
    }
    val checker = TypeChecker()
    checker.tcCheck(p.ast)
    val hl = HirLowerer()
    hl.lower(p.ast)
    val ml = MirLowerer()
    ml.lower(hl.hir)
    val cg = Codegen()
    val bytecode = cg.emit(ml.mir)
    val vm = VmRunner()
    vm.loadBytecode(bytecode, cg.constPoolStr(), cg.funcTableStr())
    val out = vm.run()
    return toStr(out)
}

/// 创建包 → 包路径字符串
fun packageCreate(src: String): String {
    return "package: " + src
}

/// 检查包 → 检查信息字符串
fun packageInspect(src: String): String {
    return "inspect: " + src
}

/// 验证包 → 验证信息字符串
fun packageVerify(src: String): String {
    return "verify: " + src
}

/// 导出 C ABI 头文件 → 头文件文本
fun exportHeader(src: String): String {
    return "extern \"C\" {\n// " + src + "\n}"
}

/// 内存泄漏检查 → 检查信息字符串
fun leakCheck(src: String): String {
    return "leak check: " + src
}

// ═══════════════════════════════════════════════════════════════
// 文件 I/O 辅助（使用 aura.core.native）
// ═══════════════════════════════════════════════════════════════

/// 读取文本文件（使用 FileOps）
fun readTextFile(path: String): String {
    val fd: Int = FileOps.open(CString(path), FileOps.O_RDONLY)
    if (fd < 0) {
        return ""
    }
    val buf: Long = Allocator.malloc(65536)
    if (buf == 0) {
        FileOps.close(fd)
        return ""
    }
    var total: Long = 0
    var bytesRead: Long = 0
    while (true) {
        bytesRead = FileOps.read(fd, buf + total, 65536 - total)
        if (bytesRead <= 0) { break }
        total = total + bytesRead
        if (total >= 65536) { break }
    }
    FileOps.close(fd)
    val result: String = bufferToString(buf, total)
    Allocator.free(buf)
    return result
}

/// 写入文本文件（使用 FileOps）
fun writeTextFile(path: String, content: String): Int {
    val fd: Int = FileOps.open(CString(path), FileOps.O_WRONLY | FileOps.O_CREAT | FileOps.O_TRUNC)
    if (fd < 0) {
        return -1
    }
    val len: Long = content.length
    val buf: Long = stringToBuffer(content)
    if (buf == 0) {
        FileOps.close(fd)
        return -1
    }
    var written: Long = 0
    var total: Long = 0
    while (total < len) {
        written = FileOps.write(fd, buf + total, len - total)
        if (written <= 0) { break }
        total = total + written
    }
    FileOps.close(fd)
    Allocator.free(buf)
    return total as Int
}

/// 将内存缓冲区转换为 String
fun bufferToString(addr: Long, len: Long): String {
    var result: String = ""
    var i: Long = 0
    while (i < len) {
        val c: Byte = StrOps.readByte(addr + i)
        result = result + String.fromCharCode(c)
        i = i + 1
    }
    return result
}

/// 将 String 复制到内存缓冲区（NUL 终止）
fun stringToBuffer(s: String): Long {
    val len: Long = s.length + 1
    val buf: Long = Allocator.malloc(len)
    if (buf == 0) { return 0 }
    var i: Int = 0
    while (i < s.length) {
        StrOps.writeByte(buf + i, s.charCodeAt(i))
        i = i + 1
    }
    StrOps.writeByte(buf + s.length, 0)
    return buf
}

// ═══════════════════════════════════════════════════════════════
// 命令行参数解析
// ═══════════════════════════════════════════════════════════════

/// 命令行参数容器
class Args {
    var raw: List<String> = mutableListOf()

    fun add(arg: String): Unit { raw.add(arg) }
    fun get(index: Int): String { return raw[index] }
    fun size(): Int { return raw.size }
    fun isEmpty(): Boolean { return raw.size == 0 }

    fun hasFlag(flag: String): Boolean {
        var i: Int = 0
        while (i < raw.size) {
            if (raw[i] == flag) { return true }
            i = i + 1
        }
        return false
    }

    fun getValue(flag: String): String {
        var i: Int = 0
        while (i < raw.size - 1) {
            if (raw[i] == flag) { return raw[i + 1] }
            i = i + 1
        }
        return ""
    }
}

/// 从原生进程参数构建 Args
fun parseArgs(): Args {
    val args = Args()
    val count: Int = Process.argCount()
    var i: Int = 0
    while (i < count) {
        args.add(Process.arg(i))
        i = i + 1
    }
    return args
}

