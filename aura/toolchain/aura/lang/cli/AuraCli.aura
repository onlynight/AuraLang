/// AOT 编译源码 → LLVM IR 文本
fun codegenCompile(src: Pointer<Byte>): Pointer<Byte> {
    // 简化：返回占位字符串，实际应调用 Main.aotBuildExeSource
    return "define i32 @main() { ret i32 0 }"
}

/// VM 执行源码 → exit code
fun vmRun(src: Pointer<Byte>): Int {
    // 简化实现：通过 C runtime system() 调用 aura 编译器执行
    return 0
}

/// 语义检查 → 错误信息字符串
fun semaCheck(src: Pointer<Byte>): Pointer<Byte> {
    return "ok"
}

/// 反汇编 .auc → 反汇编文本
fun codegenDisasm(src: Pointer<Byte>): Pointer<Byte> {
    return "disasm: " + src.toString()
}

/// 词法分析 → token 列表字符串
fun lexerTokenize(src: Pointer<Byte>): Pointer<Byte> {
    return "tokens: " + src.toString()
}

/// AST 打印 → AST 文本
fun astToString(src: Pointer<Byte>): Pointer<Byte> {
    return "ast: " + src.toString()
}

/// 格式化代码 → 格式化后的源码
fun fmtFormat(src: Pointer<Byte>): Pointer<Byte> {
    return src  // 简化：原样返回
}

/// 格式化检查 → exit code (0=已格式化, 1=未格式化)
fun fmtCheck(src: Pointer<Byte>): Int {
    return 0  // 简化：假设已格式化
}

/// 生成文档 → HTML 文本
fun docGenerate(src: Pointer<Byte>): Pointer<Byte> {
    return "<html><body>" + src.toString() + "</body></html>"
}

/// 执行表达式 → 结果字符串
fun evalExec(expr: Pointer<Byte>): Pointer<Byte> {
    return ""
}

