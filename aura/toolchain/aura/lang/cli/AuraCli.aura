// ── 入口函数 ──

fun main(): Int {
    val args: Args = parseArgs()
    if (args.isEmpty()) {
        printUsage()
        return 1
    }

    val cmd: String = args.get(0)
    // 构建子命令参数（跳过第一个参数 = 命令名）
    val subArgs = Args()
    var i: Int = 1
    while (i < args.size) {
        subArgs.add(args.get(i))
        i = i + 1
    }

    when (cmd) {
        "build" => return cmdBuild(subArgs)
        "run" => return cmdRun(subArgs)
        "check" => return cmdCheck(subArgs)
        "disasm" => return cmdDisasm(subArgs)
        "tokens" => return cmdTokens(subArgs)
        "ast" => return cmdAst(subArgs)
        "fmt" => return cmdFmt(subArgs)
        "leak-check" => return cmdLeakCheck(subArgs)
        "doc" => return cmdDoc(subArgs)
        "eval" => return cmdEval(subArgs)
        "repl" => return cmdRepl(subArgs)
        "install" => return cmdInstall(subArgs)
        "update" => return cmdUpdate(subArgs)
        "publish" => return cmdPublish(subArgs)
        "deps" => return cmdDepList(subArgs)
        "new" => return cmdNew(subArgs)
        "package" => return cmdPackage(subArgs)
        "inspect" => return cmdInspect(subArgs)
        "verify" => return cmdVerify(subArgs)
        "lsp" => return cmdLsp(subArgs)
        "debug" => return cmdDebug(subArgs)
        "export-header" => return cmdExportHeader(subArgs)
        "--help" => printUsage(); return 0
        "-h" => printUsage(); return 0
        "help" => printUsage(); return 0
        "--version" => IO.println("Aura v0.6.0"); return 0
    }

    IO.println("Unknown subcommand: " + cmd)
    printUsage()
    return 1
}