}

// ── 子命令处理 ──

/// aura build <file.aura> [--output <out>] [--aot] [--aot-embed] [--lib]
fun cmdBuild(args: Args): Int {
    if (args.size < 1) {
        IO.println("Error: build requires a source file")
        return 1
    }
    val src: String = args.get(0)
    val out: String = args.getValue("--output")
    val isAot: Boolean = args.hasFlag("--aot")
    val isAotEmbed: Boolean = args.hasFlag("--aot-embed")
    val isLib: Boolean = args.hasFlag("--lib")

    // 读取源文件
    val content: String = FileSystem.readText(src)
    if (content.length == 0) {
        IO.println("Error: cannot read file: " + src)
        return 1
    }

    if (isAot) {
        val result: String = codegenCompile(content)
        if (out.length > 0) {
            FileSystem.writeText(out, result)
            IO.println("AOT compiled: " + out)
        } else {
            IO.println(result)
        }
        return 0
    } else if (isAotEmbed) {
        val result: String = codegenCompile(content)
        if (out.length > 0) {
            FileSystem.writeText(out, result)
            IO.println("AOT-embed compiled: " + out)
        }
        return 0
    } else if (isLib) {
        val result: String = codegenCompile(content)
        if (out.length > 0) {
            FileSystem.writeText(out, result)
            IO.println("Library compiled: " + out)
        }
        return 0
    } else {
        val result: String = codegenCompile(content)
        if (out.length > 0) {
            FileSystem.writeText(out, result)
            IO.println("Compiled: " + out)
        } else {
            IO.println(result)
        }
        return 0
    }
}

/// aura run <file.aura>
fun cmdRun(args: Args): Int {
    if (args.size < 1) {
        IO.println("Error: run requires a source file")
        return 1
    }
    val src: String = args.get(0)
    val content: String = FileSystem.readText(src)
    if (content.length == 0) {
        IO.println("Error: cannot read file: " + src)
        return 1
    }
    return vmRun(content)
}

/// aura check <file.aura>
fun cmdCheck(args: Args): Int {
    if (args.size < 1) {
        IO.println("Error: check requires a source file")
        return 1
    }
    val src: String = args.get(0)
    val content: String = FileSystem.readText(src)
    val result: String = semaCheck(content)
    IO.println(result)
    // 检查结果中是否包含错误
    if (result.contains("error")) {
        return 1
    }
    return 0
}

/// aura disasm <file.auc>
fun cmdDisasm(args: Args): Int {
    if (args.size < 1) {
        IO.println("Error: disasm requires a .auc file")
        return 1
    }
    val src: String = args.get(0)
    val content: String = FileSystem.readText(src)
    val result: String = codegenDisasm(content)
    IO.println(result)
    return 0
}

