/// aura fmt <file.aura> [--check]
fun cmdFmt(args: Args): Int {
    if (args.size < 1) {
        IO.println("Error: fmt requires a source file")
        return 1
    }
    val src: String = args.get(0)
    val content: String = FileSystem.readText(src)

    if (args.hasFlag("--check")) {
        return fmtCheck(content)
    } else {
        val result: String = fmtFormat(content)
        FileSystem.writeText(src, result)
        IO.println("Formatted: " + src)
        return 0
    }
}

/// aura leak-check <file.aura>
fun cmdLeakCheck(args: Args): Int {
    if (args.size < 1) {
        IO.println("Error: leak-check requires a source file")
        return 1
    }
    val src: String = args.get(0)
    val content: String = FileSystem.readText(src)
    val result: String = leakCheck(content)
    IO.println(result)
    return 0
}

/// aura doc [--output <dir>]
fun cmdDoc(args: Args): Int {
    val out: String = args.getValue("--output")
    if (args.size >= 1) {
        val src: String = args.get(0)
        val content: String = FileSystem.readText(src)
        val result: String = docGenerate(content)
        if (out.length > 0) {
            FileSystem.writeText(out + "/index.html", result)
            IO.println("Documentation generated: " + out)
        } else {
            IO.println(result)
        }
    } else {
        IO.println("Error: doc requires a source file")
    }
    return 0
}

/// aura eval [--expr <code>]
fun cmdEval(args: Args): Int {
    val expr: String = args.getValue("--expr")
    if (expr.length > 0) {
        val result: String = evalExec(expr)
        IO.println(result)
    } else {
        IO.println("Error: eval requires --expr <code>")
        return 1
    }
    return 0
}

