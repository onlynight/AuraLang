@native fun vmRun(src: String): Int { }

@native fun fmtFormat(src: String): String { }

@native fun fmtCheck(src: String): Int { }

@native fun docGenerate(src: String): String { }

@native fun evalExec(expr: String): String { }

@native fun replMain(): Int { }

@native fun packageCreate(src: String): String { }

@native fun packageInspect(src: String): String { }

@native fun packageVerify(src: String): String { }

@native fun lspMain(): Int { }

@native fun debuggerMain(args: Int): Int { }

@native fun installDep(args: Int): Int { }

@native fun updateDep(args: Int): Int { }

@native fun publishPkg(args: Int): Int { }

