// aura:///aura/lang/cli/AuraCli.aura
// Phase E.1: Aura CLI — 替代 cli/src/main.rs
//
// 纯 Aura 实现，通过 @native 调用 C 层 aura_std_cffi.c / aura_syscalls.c。
// 替代 Rust cli/src/main.rs，完全脱离 Rust CLI。
//
// 用法：
//   aura build <file.aura> [--output <out>]
//   aura build <file.aura> --aot [--output <exe>]
//   aura run <file.aura>
//   aura check <file.aura>
//   aura disasm <file.auc>
//   aura tokens <file.aura>
//   aura ast <file.aura>
//   aura fmt <file.aura> [--check]
//   aura leak-check <file.aura>
//   aura doc [--output <dir>]
//   aura eval [--expr <code>]
//   aura repl
//   aura install / update / publish / deps / new
//   aura package / inspect / verify
//   aura lsp
//   aura debug <file.aura>
//
// @since 0.6

import aura.lang.std.String
import aura.lang.std.Encoding
import aura.lang.std.FileSystem
import aura.lang.std.IO
import aura.lang.std.Process
import aura.lang.std.Path
import aura.lang.std.Json
import aura.lang.std.Collections

// ── 编译器 API（@native 桥接到 Rust 编译器或 C 层）──

