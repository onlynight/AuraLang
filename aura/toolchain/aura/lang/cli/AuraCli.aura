/// aura ast <file.aura>
fun cmdAst(args: Args): Int {
    if (args.size < 1) {
        IO.println("Error: ast requires a source file")
        return 1
    }
    val src: String = args.get(0)
    val content: String = FileSystem.readText(src)
    val result: String = astToString(content)
    IO.println(result)
