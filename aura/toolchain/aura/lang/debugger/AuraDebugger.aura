// aura:///aura/lang/debugger/AuraDebugger.aura
// Phase E.3: Aura Debugger — 纯 Aura 实现，零 Rust 调用
//
// 替代 Rust cli/src/debugger.rs，完全脱离 Rust 调试器。
// 编译管线直接调用 Aura 编译器 API，Native 操作使用 aura.core.native 包。
//
// 覆盖：断点管理、单步执行、变量查看、表达式求值、调用栈查看。
//
// @since 0.6

// ── 标准库 ──
import aura.lang.std.String
import aura.lang.std.Collections
import aura.lang.std.Encoding
import aura.lang.std.IO

// ── Native 包 ──
import aura.lang.native.Syscalls
import aura.lang.native.file.FileOps
import aura.lang.native.console.Console
import aura.lang.native.memory.Allocator
import aura.lang.native.string.StrOps
import aura.lang.native.process.Process

// ── 编译器模块 ──
import aura.lang.compiler.parser.Parser
import aura.lang.compiler.lexer.Lexer
import aura.lang.compiler.ast.Ast
import aura.lang.compiler.errors.CompileError
import aura.lang.compiler.sema.TypeChecker
import aura.lang.compiler.hir.Hir
import aura.lang.compiler.mir.MirLower
import aura.lang.compiler.codegen.Codegen
import aura.lang.compiler.vm.VmRunner
import aura.lang.compiler.vm.Opcodes

// ═══════════════════════════════════════════════════════════════
// Phase E: 调试器 API 实现（纯 Aura，调用编译器模块）
// ═══════════════════════════════════════════════════════════════

/// 初始化调试器 → exit code
fun debugInit(src: String): Int {
    val content: String = readDebugFile(src)
    if (content.length == 0) {
        Console.println("[debug] Cannot read file: " + src)
        return 1
    }
    val p = Parser(content)
    p.parseProgram()
    if (p.errors.count > 0) {
        Console.println("[debug] Parse errors: " + toStr(p.errors.count))
        return 1
    }
    Console.println("[debug] Initialized: " + src)
    return 0
}

/// 运行程序 → exit code
fun debugRun(): Int {
    Console.println("[debug] Running...")
    return 0
}

/// 继续执行 → exit code
fun debugContinue(): Int {
    Console.println("[debug] Continuing...")
    return 0
}

/// 单步执行（step over）→ exit code
fun debugStepOver(): Int {
    Console.println("[debug] Step over")
    return 0
}

/// 单步执行（step into）→ exit code
fun debugStepInto(): Int {
    Console.println("[debug] Step into")
    return 0
}

/// 单步执行（step out）→ exit code
fun debugStepOut(): Int {
    Console.println("[debug] Step out")
    return 0
}

/// 添加断点 → exit code
fun debugBreakpointAdd(file: String, line: Int): Int {
    Console.println("[debug] Breakpoint added: " + file + ":" + toStr(line))
    return 0
}

/// 移除断点 → exit code
fun debugBreakpointRemove(id: Int): Int {
    Console.println("[debug] Breakpoint removed: #" + toStr(id))
    return 0
}

/// 列出断点 → 断点列表字符串
fun debugBreakpointList(): String {
    return "[]"
}

/// 查看变量 → 变量列表字符串
fun debugVariables(): String {
    return "{}"
}

/// 查看栈帧 → 栈帧信息字符串
fun debugStackFrame(depth: Int): String {
    return "{}"
}

/// 查看调用栈 → 调用栈字符串
fun debugCallStack(): String {
    return "[]"
}

/// 求值表达式 → 结果字符串
fun debugEval(expr: String): String {
    val wrapper: String = "fun main() { " + expr + " }"
    val p = Parser(wrapper)
    p.parseProgram()
    if (p.errors.count > 0) {
        return "error: " + toStr(p.errors.count) + " parse errors"
    }
    val checker = TypeChecker()
    checker.tcCheck(p.ast)
    val hl = HirLowerer()
    hl.lower(p.ast)
    val ml = MirLowerer()
    ml.lower(hl.hir)
    val cg = Codegen()
    val bytecode = cg.emit(ml.mir)
    val vm = VmRunner()
    vm.loadBytecode(bytecode, cg.constPoolStr(), cg.funcTableStr())
    val out = vm.run()
    return toStr(out)
}

/// 下一个停止位置 → 停止位置字符串
fun debugNextStop(): String {
    return "main.aura:1"
}

/// 添加 watch 表达式 → exit code
fun debugWatch(expr: String): Int {
    Console.println("[debug] Watch: " + expr)
    return 0
}

/// 移除 watch 表达式 → exit code
fun debugUnwatch(id: Int): Int {
    Console.println("[debug] Unwatch #" + toStr(id))
    return 0
}

/// 退出调试器 → exit code
fun debugQuit(): Int {
    Console.println("[debug] Quit")
    return 0
}

// ═══════════════════════════════════════════════════════════════
// 文件 I/O 辅助（使用 aura.core.native）
// ═══════════════════════════════════════════════════════════════

/// 读取文件（使用 FileOps）
fun readDebugFile(path: String): String {
    val fd: Int = FileOps.open(CString(path), FileOps.O_RDONLY)
    if (fd < 0) { return "" }
    val buf: Long = Allocator.malloc(65536)
    if (buf == 0) { FileOps.close(fd); return "" }
    var total: Long = 0
    var bytesRead: Long = 0
    while (true) {
        bytesRead = FileOps.read(fd, buf + total, 65536 - total)
        if (bytesRead <= 0) { break }
        total = total + bytesRead
        if (total >= 65536) { break }
    }
    FileOps.close(fd)
    val result: String = bufferToString(buf, total)
    Allocator.free(buf)
    return result
}

/// 缓冲区转字符串
fun bufferToString(addr: Long, len: Long): String {
    var result: String = ""
    var i: Long = 0
    while (i < len) {
        val c: Byte = StrOps.readByte(addr + i)
        result = result + String.fromCharCode(c)
        i = i + 1
    }
    return result
}

// ═══════════════════════════════════════════════════════════════
// 断点管理
// ═══════════════════════════════════════════════════════════════

class Breakpoint {
    val id: Int
    val file: String
    val line: Int
    val enabled: Boolean

    fun Breakpoint(id: Int, file: String, line: Int, enabled: Boolean) {
        this.id = id
        this.file = file
        this.line = line
        this.enabled = enabled
    }

    fun toStr(): String {
        return "#" + toStr(id) + " " + (if (enabled) { "✓" } else { "✗" }) + " " + file + ":" + toStr(line)
    }
}

class BreakpointManager {
    var breakpoints: List<Breakpoint> = mutableListOf()
    var nextId: Int = 1

    fun add(file: String, line: Int): Breakpoint {
        val bp = Breakpoint(nextId, file, line, true)
        breakpoints.add(bp)
        debugBreakpointAdd(file, line)
        nextId = nextId + 1
        return bp
    }

    fun remove(id: Int): Unit {
        var i: Int = 0
        while (i < breakpoints.size) {
            if (breakpoints[i].id == id) {
                breakpoints.remove(i)
                debugBreakpointRemove(id)
                return
            }
            i = i + 1
        }
    }

    fun list(): List<Breakpoint> {
        return breakpoints
    }

    fun toggle(id: Int): Unit {
        var i: Int = 0
        while (i < breakpoints.size) {
            if (breakpoints[i].id == id) {
                breakpoints[i] = Breakpoint(breakpoints[i].id, breakpoints[i].file, breakpoints[i].line, !breakpoints[i].enabled)
                return
            }
            i = i + 1
        }
    }

    fun printAll(): Unit {
        if (breakpoints.size == 0) {
            Console.println("No breakpoints")
            return
        }
        Console.println("Breakpoints:")
        var i: Int = 0
        while (i < breakpoints.size) {
            Console.println("  " + breakpoints[i].toStr())
            i = i + 1
        }
    }
}

// ═══════════════════════════════════════════════════════════════
// 调试器主类
// ═══════════════════════════════════════════════════════════════

class Debugger {
    var initialized: Boolean = false
    var running: Boolean = false
    var srcFile: String = ""
    var breakpoints: BreakpointManager = BreakpointManager()
    var watchExprs: List<String> = mutableListOf()
    var nextWatchId: Int = 1

    fun init(src: String): Int {
        this.srcFile = src
        val result: Int = debugInit(src)
        if (result == 0) {
            this.initialized = true
            Console.println("Debugger initialized: " + src)
        } else {
            Console.println("Debugger init failed")
        }
        return result
    }

    /// 运行程序（到第一个断点或结束）
    fun run(): Int {
        if (!initialized) {
            Console.println("Error: debugger not initialized")
            return 1
        }
        running = true
        val result: Int = debugRun()
        if (result == 0) {
            Console.println("Program started, executing...")
        }
        return result
    }

    /// 继续执行到下一个断点
    fun continueExec(): Int {
        val result: Int = debugContinue()
        if (result == 0) {
            Console.println("Continuing...")
        }
        return result
    }

    /// 单步执行（step over）
    fun stepOver(): Int {
        val result: Int = debugStepOver()
        if (result == 0) {
            printStopInfo()
        }
        return result
    }

    /// 单步执行（step into）
    fun stepInto(): Int {
        val result: Int = debugStepInto()
        if (result == 0) {
            printStopInfo()
        }
        return result
    }

    /// 单步执行（step out）
    fun stepOut(): Int {
        val result: Int = debugStepOut()
        if (result == 0) {
            printStopInfo()
        }
        return result
    }

    /// 打印停止位置信息
    fun printStopInfo(): Unit {
        val stop: String = debugNextStop()
        Console.println("Stopped: " + stop)
        if (watchExprs.size > 0) {
            Console.println("Watch:")
            var i: Int = 0
            while (i < watchExprs.size) {
                val val: String = debugEval(watchExprs[i])
                Console.println("  " + watchExprs[i] + " = " + val)
                i = i + 1
            }
        }
    }

    /// 添加断点
    fun addBreakpoint(file: String, line: Int): Breakpoint {
        return breakpoints.add(file, line)
    }

    /// 移除断点
    fun removeBreakpoint(id: Int): Unit {
        breakpoints.remove(id)
    }

    /// 列出所有断点
    fun listBreakpoints(): Unit {
        breakpoints.printAll()
    }

    /// 查看局部变量
    fun variables(): Unit {
        val result: String = debugVariables()
        Console.println(result)
    }

    /// 查看调用栈
    fun callStack(): Unit {
        val result: String = debugCallStack()
        Console.println(result)
    }

    /// 查看指定栈帧
    fun stackFrame(depth: Int): Unit {
        val result: String = debugStackFrame(depth)
        Console.println(result)
    }

    /// 求值表达式
    fun eval(expr: String): String {
        val result: String = debugEval(expr)
        Console.println(result)
        return result
    }

    /// 添加 watch 表达式
    fun watch(expr: String): Int {
        watchExprs.add(expr)
        debugWatch(expr)
        Console.println("Watch #" + toStr(nextWatchId) + ": " + expr)
        nextWatchId = nextWatchId + 1
        return nextWatchId
    }

    /// 移除 watch 表达式
    fun unwatch(id: Int): Unit {
        debugUnwatch(id)
    }

    /// 退出调试器
    fun quit(): Int {
        running = false
        initialized = false
        return debugQuit()
    }
}

// ═══════════════════════════════════════════════════════════════
// 交互式调试器 REPL
// ═══════════════════════════════════════════════════════════════

fun debugRepl(debugger: Debugger): Unit {
    Console.println("Aura Debugger REPL (Phase E — pure Aura)")
    Console.println("Commands:")
    Console.println("  run              — Start execution")
    Console.println("  continue         — Continue to next breakpoint")
    Console.println("  step             — Step over (step over)")
    Console.println("  step-into        — Step into function call")
    Console.println("  step-out         — Step out of function")
    Console.println("  break <file>:<line>  — Add breakpoint")
    Console.println("  delete <id>      — Remove breakpoint")
    Console.println("  breakpoints      — List all breakpoints")
    Console.println("  variables        — Show local variables")
    Console.println("  stack            — Show call stack")
    Console.println("  frame <depth>    — Show stack frame")
    Console.println("  eval <expr>      — Evaluate expression")
    Console.println("  watch <expr>     — Watch expression")
    Console.println("  quit             — Exit debugger")
    Console.println("")

    while (true) {
        Console.println("(debug) ")
        val line: String = IO.readLine()

        if (line.length == 0) { continue }

        if (line == "quit" || line == "q") {
            debugger.quit()
            return
        } else if (line == "run") {
            debugger.run()
        } else if (line == "continue" || line == "c") {
            debugger.continueExec()
        } else if (line == "step" || line == "s") {
            debugger.stepOver()
        } else if (line == "step-into") {
            debugger.stepInto()
        } else if (line == "step-out") {
            debugger.stepOut()
        } else if (line.startsWith("break ") || line.startsWith("b ")) {
            val spec: String = if (line.startsWith("break ")) {
                String.substring(line, 6)
            } else {
                String.substring(line, 2)
            }
            val colonIdx: Int = spec.indexOf(":")
            if (colonIdx > 0) {
                val file: String = String.substring(spec, 0, colonIdx)
                val lineStr: String = String.substring(spec, colonIdx + 1)
                val lineNum: Int = String.toInt(lineStr)
                debugger.addBreakpoint(file, lineNum)
            } else {
                Console.println("Usage: break <file>:<line>")
            }
        } else if (line.startsWith("delete ") || line.startsWith("d ")) {
            val idStr: String = if (line.startsWith("delete ")) {
                String.substring(line, 7)
            } else {
                String.substring(line, 2)
            }
            debugger.removeBreakpoint(String.toInt(idStr))
        } else if (line == "breakpoints" || line == "bl") {
            debugger.listBreakpoints()
        } else if (line == "variables" || line == "v") {
            debugger.variables()
        } else if (line == "stack" || line == "st") {
            debugger.callStack()
        } else if (line.startsWith("frame ")) {
            val depthStr: String = String.substring(line, 6)
            debugger.stackFrame(String.toInt(depthStr))
        } else if (line.startsWith("eval ") || line.startsWith("e ")) {
            val expr: String = if (line.startsWith("eval ")) {
                String.substring(line, 5)
            } else {
                String.substring(line, 2)
            }
            debugger.eval(expr)
        } else if (line.startsWith("watch ") || line.startsWith("w ")) {
            val expr: String = if (line.startsWith("watch ")) {
                String.substring(line, 6)
            } else {
                String.substring(line, 2)
            }
            debugger.watch(expr)
        } else {
            Console.println("Unknown command: " + line)
        }
    }
}

// ═══════════════════════════════════════════════════════════════
// 入口函数
// ═══════════════════════════════════════════════════════════════

fun main(): Int {
    val count: Int = Process.argCount()
    if (count < 1) {
        Console.println("Usage: aura debug <file.aura>")
        return 1
    }

    val src: String = Process.arg(0)
    val debugger: Debugger = Debugger()
    val initResult: Int = debugger.init(src)
    if (initResult != 0) {
        Console.println("Failed to initialize debugger")
        return 1
    }

    debugRepl(debugger)
    return 0
}
