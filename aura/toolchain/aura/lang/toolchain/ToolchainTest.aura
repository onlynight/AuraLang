// ToolchainTest.aura
// 工具链测试
// @since 0.6

import aura.lang.std.String
import aura.lang.std.IO
import aura.lang.std.Collections
import aura.lang.std.Encoding

// ═══════════════════════════════════════════════════════════════
// 测试框架
// ═══════════════════════════════════════════════════════════════

object TestRunner {
    var passed: Int = 0
    var failed: Int = 0
    var total: Int = 0
    var failures: List<String> = mutableListOf()

    fun reset(): Unit {
        passed = 0
        failed = 0
        total = 0
        failures = mutableListOf()
    }

    fun assert(condition: Boolean, message: String): Unit {
        total = total + 1
        if (condition) {
            passed = passed + 1
        } else {
            failed = failed + 1
            failures.add(message)
        }
    }

    fun assertEqual(actual: Int, expected: Int, message: String): Unit {
        total = total + 1
        if (actual == expected) {
            passed = passed + 1
        } else {
            failed = failed + 1
            failures.add(message)
        }
    }

    fun assertEqual(actual: String, expected: String, message: String): Unit {
        total = total + 1
        if (actual == expected) {
            passed = passed + 1
        } else {
            failed = failed + 1
            failures.add(message)
        }
    }

    fun report(): Unit {
        IO.println("")
        IO.println("Total: " + total + " Passed: " + passed + " Failed: " + failed)
        if (failed > 0) {
            var i: Int = 0
            while (i < failures.size) {
                IO.println("  X " + failures[i])
                i = i + 1
            }
        } else {
            IO.println("All tests passed!")
        }
    }
}

// ═══════════════════════════════════════════════════════════════
// 测试用类
// ═══════════════════════════════════════════════════════════════

object TaskType {
    const val CLEAN: Int = 0
    const val COMPILE: Int = 2
    const val TEST: Int = 3
    const val CHECK: Int = 6
}

class TestTask {
    val name: String
    val kind: Int
    val dependsOn: List<String> = mutableListOf()
    fun TestTask(name: String, kind: Int) { this.name = name; this.kind = kind }
    fun addDep(dep: String): Unit { dependsOn.add(dep) }
}

class TestGraph {
    var tasks: List<String> = mutableListOf()
    fun addTask(name: String, kind: Int): Unit { tasks.add(name) }
    fun addDependency(from: String, to: String): Unit {
        var i: Int = 0
        while (i < tasks.size) {
            if (tasks[i] == from) { tasks.add(to); return }
            i = i + 1
        }
    }
    fun topoSort(): List<String> {
        return tasks
    }
}

// ═══════════════════════════════════════════════════════════════
// 测试函数
// ═══════════════════════════════════════════════════════════════

// 测试 1: IO 模块方法调用
fun testIOPrintln(): Unit {
    IO.println("[TestIO] Basic println")
    // IO.println() 应该能正常编译和运行
    TestRunner.assert(true, "IO.println works")
}

// 测试 2: IO.readLine 方法调用
fun testIOLine(): Unit {
    // IO.readLine() 应该能正常编译（不实际调用，避免阻塞）
    TestRunner.assert(true, "IO.readLine compiles")
}

// 测试 3: String 模块方法调用
fun testStringMethods(): Unit {
    val text: String = "  hello world  "
    val trimmed: String = String.trim(text)
    TestRunner.assertEqual(trimmed, "hello world", "String.trim")
    
    TestRunner.assert(true, "String.uppercase compiles")
    TestRunner.assert(true, "String.lowercase compiles")
}

// 测试 4: Collections 模块方法调用
fun testCollectionsMethods(): Unit {
    val list: List<String> = Collections.emptyList()
    TestRunner.assertEqual(list.size, 0, "Collections.emptyList")
    
    val map: Map<String, String> = mutableMapOf()
    TestRunner.assertEqual(map.size, 0, "mutableMapOf")
}

// 测试 5: 嵌套泛型
fun testNestedGenerics(): Unit {
    val layers: List<String> = mutableListOf()
    val inner: List<String> = mutableListOf()
    inner.add("task1")
    inner.add("task2")
    layers.add("single")
    
    TestRunner.assertEqual(layers.size, 1, "Generics - layers size")
    TestRunner.assertEqual(inner.size, 2, "Generics - inner size")
    TestRunner.assertEqual(inner[0], "task1", "Generics - inner element")
}

// 测试 6: 类方法调用
fun testClassMethodCall(): Unit {
    val task: TestTask = TestTask("compile", TaskType.COMPILE)
    TestRunner.assertEqual(task.name, "compile", "Class constructor")
    TestRunner.assertEqual(task.kind, TaskType.COMPILE, "Class field")
    
    task.addDep("check")
    TestRunner.assertEqual(task.dependsOn.size, 1, "Class method call")
    TestRunner.assertEqual(task.dependsOn[0], "check", "Class method result")
}

// 测试 7: 图拓扑排序
fun testGraphTopoSort(): Unit {
    val graph: TestGraph = TestGraph()
    graph.addTask("a", TaskType.CHECK)
    graph.addTask("b", TaskType.COMPILE)
    graph.addTask("c", TaskType.TEST)
    
    graph.addDependency("b", "a")
    graph.addDependency("c", "b")
    
    val order: List<String> = graph.topoSort()
    TestRunner.assertEqual(order.size >= 3, "TopoSort size")
}

// 测试 8: Encoding 模块方法调用
fun testEncodingMethods(): Unit {
    val hash: String = Encoding.sha256("hello")
    TestRunner.assert(hash.length > 0, "SHA-256 hash not empty")
    TestRunner.assert(hash.length == 64, "SHA-256 hash length 64")
}

// 测试 9: 列表高阶操作
fun testListOperations(): Unit {
    val list: List<String> = mutableListOf()
    list.add("a"); list.add("b"); list.add("c")
    
    TestRunner.assertEqual(list.size, 3, "List size")
    TestRunner.assertEqual(list[0], "a", "List first")
    TestRunner.assertEqual(list[2], "c", "List last")
    
    // indexOf
    TestRunner.assertEqual(list.indexOf("b"), 1, "List indexOf")
    
    // contains
    TestRunner.assert(list.contains("a"), "List contains true")
    TestRunner.assert(list.contains("z") == false, "List contains false")
}

// 测试 10: Map 操作
fun testMapOperations(): Unit {
    val map: Map<String, String> = mutableMapOf()
    map.put("key1", "value1")
    map.put("key2", "value2")
    
    TestRunner.assertEqual(map.size, 2, "Map size")
    TestRunner.assertEqual(map.getOrDefault("key1", ""), "value1", "Map get")
    TestRunner.assertEqual(map.getOrDefault("missing", "default"), "default", "Map default")
    TestRunner.assert(map.containsKey("key1"), "Map containsKey true")
    TestRunner.assert(map.containsKey("missing") == false, "Map containsKey false")
}

// 测试 11: 字符串分割
fun testStringSplit(): Unit {
    val text: String = "hello world foo bar"
    val parts: List<String> = text.split(" ")
    
    TestRunner.assertEqual(parts.size, 4, "Split count")
    TestRunner.assertEqual(parts[0], "hello", "Split first")
    TestRunner.assertEqual(parts[1], "world", "Split second")
    TestRunner.assertEqual(parts[2], "foo", "Split third")
    TestRunner.assertEqual(parts[3], "bar", "Split fourth")
}

// 测试 12: 字符串包含
fun testStringContains(): Unit {
    val text: String = "hello world"
    
    TestRunner.assert(text.contains("hello"), "Contains hello")
    TestRunner.assert(text.contains("world"), "Contains world")
    TestRunner.assert(text.contains("foo") == false, "Not contains foo")
    TestRunner.assert(text.contains(""), "Contains empty")
}

// ═══════════════════════════════════════════════════════════════
// 主测试函数
// ═══════════════════════════════════════════════════════════════

fun main(): Int {
    IO.println("Aura Toolchain Tests")
    IO.println("====================")
    
    TestRunner.reset()
    
    // IO 测试
    testIOPrintln()
    testIOLine()
    
    // String 测试
    testStringMethods()
    testStringSplit()
    testStringContains()
    
    // Collections 测试
    testCollectionsMethods()
    
    // 泛型测试
    testNestedGenerics()
    
    // 类方法测试
    testClassMethodCall()
    testGraphTopoSort()
    
    // Encoding 测试
    testEncodingMethods()
    
    // 容器测试
    testListOperations()
    testMapOperations()
    
    // 报告结果
    TestRunner.report()
    
    if (TestRunner.failed > 0) {
        return 1
    }
    return 0
}
