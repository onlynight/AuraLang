// aura:///aura/lang/lsp/AuraLsp.aura
// Phase E.2: Aura LSP — 替代 compiler/src/lsp.rs
//
// 纯 Aura 实现，通过 @native 调用 C 层 LSP 基础设施。
// 覆盖：JSON-RPC over stdio、completion、hover、definition、
// references、diagnostic、formatting。
//
// @since 0.6

import aura.lang.std.String
import aura.lang.std.FileSystem
import aura.lang.std.IO
import aura.lang.std.Json
import aura.lang.std.Encoding
import aura.lang.std.Collections

// ── LSP native API ──

@native fun lspStart(): Int { }

@native fun lspStop(): Int { }

@native fun lspParseRequest(data: String): String { }

@native fun lspCompletion(file: String, pos: Int): String { }

@native fun lspHover(file: String, pos: Int): String { }

@native fun lspDefinition(file: String, pos: Int): String { }

@native fun lspReferences(file: String, pos: Int): String { }

@native fun lspDiagnostic(file: String): String { }

@native fun lspFormatting(file: String, text: String): String { }

@native fun lspDocumentSymbol(file: String): String { }

@native fun lspSignatureHelp(file: String, pos: Int): String { }

@native fun lspInlayHint(file: String): String { }

@native fun lspCodeAction(file: String, range: String): String { }

// ── LSP 消息类型 ──

/// LSP 请求
class LspRequest {
    val id: Int
    val method: String
    val params: String

    fun LspRequest(id: Int, method: String, params: String) {
        this.id = id
        this.method = method
        this.params = params
    }
}

/// LSP 响应
class LspResponse {
    val id: Int
    val result: String
    val error: String

    fun LspResponse(id: Int, result: String, error: String) {
        this.id = id
        this.result = result
        this.error = error
    }

    fun toJson(): String {
        if (error.length > 0) {
            return Json.stringify(["jsonrpc": "2.0", "id": id, "error": error])
        }
        return Json.stringify(["jsonrpc": "2.0", "id": id, "result": result])
    }
}

// ── LSP 服务器主类 ──

class LspServer {
    var running: Boolean = false
    var requestId: Int = 1
    var documents: Map<String, String> = mutableMapOf()
    var diagnostics: Map<String, String> = mutableMapOf()

    /// 启动 LSP 服务器
    fun start(): Int {
        val result: Int = lspStart()
        if (result == 0) {
            this.running = true
            IO.println("LSP server started")
        }
        return result
    }

    /// 停止 LSP 服务器
    fun stop(): Int {
        running = false
        return lspStop()
    }

    /// 处理 incoming 请求
    fun handleRequest(data: String): String {
        val parsed: String = lspParseRequest(data)
        // 解析 JSON-RPC 请求
        val request: LspRequest = parseRequest(parsed)
        if (request == null) {
            return Json.stringify(["jsonrpc": "2.0", "error": "Invalid request"])
        }

        val result: String = dispatchRequest(request)
        val response: LspResponse = LspResponse(request.id, result, "")
        return response.toJson()
    }

    /// 分派请求到具体处理器
    fun dispatchRequest(req: LspRequest): String {
        val params: String = req.params
        // 从 params 中提取文件路径和位置
        val file: String = extractField(params, "textDocument", "uri")
        val pos: Int = extractIntField(params, "position", "character")

        when (req.method) {
            "textDocument/didOpen" => return handleDidOpen(params)
            "textDocument/didChange" => return handleDidChange(params)
            "textDocument/didClose" => return handleDidClose(params)
            "textDocument/completion" => return lspCompletion(file, pos)
            "textDocument/hover" => return lspHover(file, pos)
            "textDocument/definition" => return lspDefinition(file, pos)
            "textDocument/references" => return lspReferences(file, pos)
            "textDocument/diagnostic" => return lspDiagnostic(file)
            "textDocument/formatting" => {
                val text: String = documents.getOrDefault(file, "")
                return lspFormatting(file, text)
            }
            "textDocument/documentSymbol" => return lspDocumentSymbol(file)
            "textDocument/signatureHelp" => return lspSignatureHelp(file, pos)
            "textDocument/inlayHint" => return lspInlayHint(file)
            "textDocument/codeAction" => return lspCodeAction(file, params)
            "shutdown" => return "null"
            "exit" => { stop(); return "null" }
        }
        return Json.stringify(["error": "Unknown method: " + req.method])
    }

    /// 处理 didOpen
    fun handleDidOpen(params: String): String {
        val uri: String = extractField(params, "textDocument", "uri")
        val text: String = extractField(params, "textDocument", "text")
        documents.put(uri, text)
        // 触发诊断
        val diag: String = lspDiagnostic(uri)
        diagnostics.put(uri, diag)
        return "null"
    }

    /// 处理 didChange
    fun handleDidChange(params: String): String {
        val uri: String = extractField(params, "textDocument", "uri")
        val text: String = extractField(params, "contentChanges", "text")
        documents.put(uri, text)
        val diag: String = lspDiagnostic(uri)
        diagnostics.put(uri, diag)
        return "null"
    }

    /// 处理 didClose
    fun handleDidClose(params: String): String {
        val uri: String = extractField(params, "textDocument", "uri")
        documents.remove(uri)
        diagnostics.remove(uri)
        return "null"
    }

    /// 从 JSON 中提取嵌套字段
    fun extractField(json: String, parent: String, key: String): String {
        // 简化实现：查找 "parent":{"key":"value"} 模式
        val parentStart: Int = json.indexOf("\"" + parent + "\"")
        if (parentStart < 0) { return "" }
        val braceStart: Int = json.indexOf("{", parentStart)
        if (braceStart < 0) { return "" }
        val keyStart: Int = json.indexOf("\"" + key + "\"", braceStart)
        if (keyStart < 0) { return "" }
        val colonIdx: Int = json.indexOf(":", keyStart)
        if (colonIdx < 0) { return "" }
        val valueStart: Int = json.indexOf("\"", colonIdx)
        if (valueStart < 0) { return "" }
        val valueEnd: Int = json.indexOf("\"", valueStart + 1)
        if (valueEnd < 0) { return "" }
        return String.substring(json, valueStart + 1, valueEnd)
    }

    /// 从 JSON 中提取整数字段
    fun extractIntField(json: String, parent: String, key: String): Int {
        val parentStart: Int = json.indexOf("\"" + parent + "\"")
        if (parentStart < 0) { return 0 }
        val keyStart: Int = json.indexOf("\"" + key + "\"", parentStart)
        if (keyStart < 0) { return 0 }
        val colonIdx: Int = json.indexOf(":", keyStart)
        if (colonIdx < 0) { return 0 }
        // 找到下一个数字
        var i: Int = colonIdx + 1
        while (i < json.length && (json[i] == ' ' || json[i] == '\t')) {
            i = i + 1
        }
        var numStr: String = ""
        while (i < json.length && json[i] >= '0' && json[i] <= '9') {
            numStr = numStr + json[i]
            i = i + 1
        }
        if (numStr.length == 0) { return 0 }
        return String.toInt(numStr)
    }

    /// 解析 JSON-RPC 请求
    fun parseRequest(json: String): LspRequest {
        val id: Int = extractIntField(json, null, "id")
        val method: String = extractTopField(json, "method")
        val params: String = ""

        if (method.length == 0) {
            return null
        }

        // 提取 params 对象
        val paramsStart: Int = json.indexOf("\"params\"")
        if (paramsStart >= 0) {
            val braceStart: Int = json.indexOf("{", paramsStart)
            if (braceStart >= 0) {
                var depth: Int = 0
                var i: Int = braceStart
                while (i < json.length) {
                    if (json[i] == '{') { depth = depth + 1 }
                    else if (json[i] == '}') {
                        depth = depth - 1
                        if (depth == 0) {
                            params = String.substring(json, braceStart, i + 1)
                            break
                        }
                    }
                    i = i + 1
                }
            }
        }

        return LspRequest(id, method, params)
    }

    /// 从顶层 JSON 提取字段
    fun extractTopField(json: String, key: String): String {
        val keyStart: Int = json.indexOf("\"" + key + "\"")
        if (keyStart < 0) { return "" }
        val colonIdx: Int = json.indexOf(":", keyStart)
        if (colonIdx < 0) { return "" }
        val valueStart: Int = json.indexOf("\"", colonIdx)
        if (valueStart < 0) { return "" }
        val valueEnd: Int = json.indexOf("\"", valueStart + 1)
        if (valueEnd < 0) { return "" }
        return String.substring(json, valueStart + 1, valueEnd)
    }
}

// ── 主循环 ──

fun lspMainLoop(): Unit {
    val server: LspServer = LspServer()
    server.start()

    IO.println("LSP server ready")

    while (server.running) {
        // 从 stdin 读取一行（Content-Length 头 + JSON 正文）
        val headerLine: String = IO.readLine()
        if (headerLine.length == 0) { break }

        // 解析 Content-Length
        val len: Int = parseContentLength(headerLine)
        if (len <= 0) { continue }

        // 读取空行（分隔符）
        IO.readLine()

        // 读取 JSON 正文
        val data: String = IO.readAll(len)
        if (data.length == 0) { continue }

        // 处理请求
        val response: String = server.handleRequest(data)
        if (response.length > 0) {
            // 输出响应（Content-Length 头 + 空行 + JSON）
            IO.println("Content-Length: " + response.length + "\n")
            IO.println(response)
        }
    }

    server.stop()
}

/// 解析 Content-Length 头
fun parseContentLength(header: String): Int {
    val prefix: String = "Content-Length: "
    if (String.startsWith(header, prefix)) {
        val numStr: String = String.substring(header, prefix.length)
        return String.toInt(String.trim(numStr))
    }
    return -1
}

// ── 入口函数 ──

fun main(): Int {
    lspMainLoop()
    return 0
}