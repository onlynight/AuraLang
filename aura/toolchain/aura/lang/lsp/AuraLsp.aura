// ═══════════════════════════════════════════════════════════════
// Phase E: LSP API 实现（纯 Aura，调用编译器模块）
// ═══════════════════════════════════════════════════════════════

/// 启动 LSP 服务器 → exit code
fun lspStart(): Int {
    Console.println("[LSP] Server started (pure Aura, Phase E)")
    return 0
}

/// 停止 LSP 服务器 → exit code
fun lspStop(): Int {
    Console.println("[LSP] Server stopped")
    return 0
}

/// 解析 JSON-RPC 请求 → 解析后的 JSON 字符串
fun lspParseRequest(data: String): String {
    return data  // 简化：原样返回
}

/// 代码补全 → 补全项 JSON 数组
fun lspCompletion(file: String, pos: Int): String {
    val content: String = readLspFile(file)
    if (content.length == 0) { return "[]" }
    val p = Parser(content)
    p.parseProgram()
    if (p.errors.count > 0) { return "[]" }
    // 简化：返回所有顶级函数名作为补全
    var result: String = "["
    var i: Int = 0
    var first: Boolean = true
    while (i < p.ast.count) {
        if (p.ast.kindOf(i) == "FunDecl") {
            if (!first) { result = result + "," }
            val name: String = p.ast.literalAt(i)
            result = result + "{\"label\":\"" + name + "\",\"kind\":2}"
            first = false
        }
        i = i + 1
    }
    result = result + "]"
    return result
}

/// 悬停信息 → 悬停信息 JSON
fun lspHover(file: String, pos: Int): String {
    val content: String = readLspFile(file)
    if (content.length == 0) { return "{}" }
    val p = Parser(content)
    p.parseProgram()
    // 简化：返回基本类型信息
    return "{\"contents\":{\"kind\":\"markdown\",\"value\":\"*Hover info*\"}}"
}

/// 跳转定义 → 定义位置 JSON
fun lspDefinition(file: String, pos: Int): String {
    val content: String = readLspFile(file)
    if (content.length == 0) { return "null" }
    val p = Parser(content)
    p.parseProgram()
    return "null"
}

/// 查找引用 → 引用位置 JSON 数组
fun lspReferences(file: String, pos: Int): String {
    val content: String = readLspFile(file)
    if (content.length == 0) { return "[]" }
    val p = Parser(content)
    p.parseProgram()
    return "[]"
}

/// 诊断信息 → 诊断 JSON 数组
fun lspDiagnostic(file: String): String {
    val content: String = readLspFile(file)
    if (content.length == 0) { return "[]" }
    val p = Parser(content)
    p.parseProgram()
    var result: String = "["
    var first: Boolean = true
    // 添加解析错误
    val errors = p.errors
    if (errors.count > 0) {
        // 简化：返回错误计数
        result = result + "{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":0}},\"severity\":1,\"message\":\"" + toStr(errors.count) + " parse error(s)\"}"
    }
    // 添加语义错误
    val checker = TypeChecker()
    checker.tcCheck(p.ast)
    val semaErrors = checker.tcGetErrors()
    if (semaErrors.count > 0) {
        if (!first) { result = result + "," }
        result = result + "{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":0}},\"severity\":1,\"message\":\"" + toStr(semaErrors.count) + " semantic error(s)\"}"
        first = false
    }
    result = result + "]"
    return result
}

/// 代码格式化 → 格式化后的文本
fun lspFormatting(file: String, text: String): String {
    return text  // 简化：原样返回
}

/// 文档符号 → 文档符号 JSON 数组
fun lspDocumentSymbol(file: String): String {
    val content: String = readLspFile(file)
    if (content.length == 0) { return "[]" }
    val p = Parser(content)
    p.parseProgram()
    var result: String = "["
    var first: Boolean = true
    var i: Int = 0
    while (i < p.ast.count) {
        if (p.ast.kindOf(i) == "FunDecl" || p.ast.kindOf(i) == "ClassDecl" || p.ast.kindOf(i) == "ObjectDecl") {
            if (!first) { result = result + "," }
            val name: String = p.ast.literalAt(i)
            val kind: Int = if (p.ast.kindOf(i) == "FunDecl") { 12 } else if (p.ast.kindOf(i) == "ClassDecl") { 5 } else { 7 }
            result = result + "{\"name\":\"" + name + "\",\"kind\":" + kind + "}"
            first = false
        }
        i = i + 1
    }
    result = result + "]"
    return result
}

/// 签名帮助 → 签名信息 JSON
fun lspSignatureHelp(file: String, pos: Int): String {
    return "{}"
}

/// 内联提示 → 内联提示 JSON 数组
fun lspInlayHint(file: String): String {
    return "[]"
}

/// 代码操作 → 代码操作 JSON 数组
fun lspCodeAction(file: String, range: String): String {
    return "[]"
}

// ═══════════════════════════════════════════════════════════════
// 文件 I/O 辅助（使用 aura.core.native）
// ═══════════════════════════════════════════════════════════════

/// 读取文件（使用 FileOps）
fun readLspFile(path: String): String {
    val fd: Int = FileOps.open(CString(path), FileOps.O_RDONLY)
    if (fd < 0) { return "" }
    val buf: Long = Allocator.malloc(65536)
    if (buf == 0) { FileOps.close(fd); return "" }
    var total: Long = 0
    var bytesRead: Long = 0
    while (true) {
        bytesRead = FileOps.read(fd, buf + total, 65536 - total)
        if (bytesRead <= 0) { break }
        total = total + bytesRead
        if (total >= 65536) { break }
    }
    FileOps.close(fd)
    val result: String = bufferToString(buf, total)
    Allocator.free(buf)
    return result
}

/// 缓冲区转字符串
fun bufferToString(addr: Long, len: Long): String {
    var result: String = ""
    var i: Long = 0
    while (i < len) {
        val c: Byte = StrOps.readByte(addr + i)
        result = result + String.fromCharCode(c)
        i = i + 1
    }
    return result
}

// ═══════════════════════════════════════════════════════════════
// LSP 消息类型
// ═══════════════════════════════════════════════════════════════

/// LSP 请求
class LspRequest {
    val id: Int
    val method: String
    val params: String

    fun LspRequest(id: Int, method: String, params: String) {
        this.id = id
        this.method = method
        this.params = params
    }
}

/// LSP 响应
class LspResponse {
    val id: Int
    val result: String
    val error: String

    fun LspResponse(id: Int, result: String, error: String) {
        this.id = id
        this.result = result
        this.error = error
    }

    fun toJson(): String {
        if (error.length > 0) {
            return "{\"jsonrpc\":\"2.0\",\"id\":" + toStr(id) + ",\"error\":\"" + error + "\"}"
        }
        return "{\"jsonrpc\":\"2.0\",\"id\":" + toStr(id) + ",\"result\":" + result + "}"
    }
}

// ═══════════════════════════════════════════════════════════════
// LSP 服务器主类
// ═══════════════════════════════════════════════════════════════

class LspServer {
    var running: Boolean = false
    var requestId: Int = 1
    var documents: Map<String, String> = mutableMapOf()
    var diagnostics: Map<String, String> = mutableMapOf()

    /// 启动 LSP 服务器
    fun start(): Int {
        val result: Int = lspStart()
        if (result == 0) {
            this.running = true
            Console.println("LSP server started (pure Aura)")
        }
        return result
    }

    /// 停止 LSP 服务器
    fun stop(): Int {
        running = false
        return lspStop()
    }

    /// 处理 incoming 请求
    fun handleRequest(data: String): String {
        val parsed: String = lspParseRequest(data)
        val request: LspRequest = parseRequest(parsed)
        if (request == null) {
            return "{\"jsonrpc\":\"2.0\",\"error\":\"Invalid request\"}"
        }
        val result: String = dispatchRequest(request)
        val response: LspResponse = LspResponse(request.id, result, "")
        return response.toJson()
    }

    /// 分派请求到具体处理器
    fun dispatchRequest(req: LspRequest): String {
        val params: String = req.params
        val file: String = extractField(params, "textDocument", "uri")
        val pos: Int = extractIntField(params, "position", "character")

        if (req.method == "textDocument/didOpen") {
            return handleDidOpen(params)
        } else if (req.method == "textDocument/didChange") {
            return handleDidChange(params)
        } else if (req.method == "textDocument/didClose") {
            return handleDidClose(params)
        } else if (req.method == "textDocument/completion") {
            return lspCompletion(file, pos)
        } else if (req.method == "textDocument/hover") {
            return lspHover(file, pos)
        } else if (req.method == "textDocument/definition") {
            return lspDefinition(file, pos)
        } else if (req.method == "textDocument/references") {
            return lspReferences(file, pos)
        } else if (req.method == "textDocument/diagnostic") {
            return lspDiagnostic(file)
        } else if (req.method == "textDocument/formatting") {
            val text: String = documents.getOrDefault(file, "")
            return lspFormatting(file, text)
        } else if (req.method == "textDocument/documentSymbol") {
            return lspDocumentSymbol(file)
        } else if (req.method == "textDocument/signatureHelp") {
            return lspSignatureHelp(file, pos)
        } else if (req.method == "textDocument/inlayHint") {
            return lspInlayHint(file)
        } else if (req.method == "textDocument/codeAction") {
            return lspCodeAction(file, params)
        } else if (req.method == "shutdown") {
            return "null"
        } else if (req.method == "exit") {
            stop()
            return "null"
        }
        return "{\"error\":\"Unknown method: " + req.method + "\"}"
    }

    /// 处理 didOpen
    fun handleDidOpen(params: String): String {
        val uri: String = extractField(params, "textDocument", "uri")
        val text: String = extractField(params, "textDocument", "text")
        documents.put(uri, text)
        val diag: String = lspDiagnostic(uri)
        diagnostics.put(uri, diag)
        return "null"
    }

    /// 处理 didChange
    fun handleDidChange(params: String): String {
        val uri: String = extractField(params, "textDocument", "uri")
        val text: String = extractField(params, "contentChanges", "text")
        documents.put(uri, text)
        val diag: String = lspDiagnostic(uri)
        diagnostics.put(uri, diag)
        return "null"
    }

    /// 处理 didClose
    fun handleDidClose(params: String): String {
        val uri: String = extractField(params, "textDocument", "uri")
        documents.remove(uri)
        diagnostics.remove(uri)
        return "null"
    }

    /// 从 JSON 中提取嵌套字段
    fun extractField(json: String, parent: String, key: String): String {
        val parentStart: Int = json.indexOf("\"" + parent + "\"")
        if (parentStart < 0) { return "" }
        val braceStart: Int = json.indexOf("{", parentStart)
        if (braceStart < 0) { return "" }
        val keyStart: Int = json.indexOf("\"" + key + "\"", braceStart)
        if (keyStart < 0) { return "" }
        val colonIdx: Int = json.indexOf(":", keyStart)
        if (colonIdx < 0) { return "" }
        val valueStart: Int = json.indexOf("\"", colonIdx)
        if (valueStart < 0) { return "" }
        val valueEnd: Int = json.indexOf("\"", valueStart + 1)
        if (valueEnd < 0) { return "" }
        return String.substring(json, valueStart + 1, valueEnd)
    }

    /// 从 JSON 中提取整数字段
    fun extractIntField(json: String, parent: String, key: String): Int {
        val parentStart: Int = json.indexOf("\"" + parent + "\"")
        if (parentStart < 0) { return 0 }
        val keyStart: Int = json.indexOf("\"" + key + "\"", parentStart)
        if (keyStart < 0) { return 0 }
        val colonIdx: Int = json.indexOf(":", keyStart)
        if (colonIdx < 0) { return 0 }
        var i: Int = colonIdx + 1
        while (i < json.length && (String.charCodeAt(json, i) == 32 || String.charCodeAt(json, i) == 9)) {
            i = i + 1
        }
        var numStr: String = ""
        while (i < json.length && String.charCodeAt(json, i) >= 48 && String.charCodeAt(json, i) <= 57) {
            numStr = numStr + String.substring(json, i, i + 1)
            i = i + 1
        }
        if (numStr.length == 0) { return 0 }
        return String.toInt(numStr)
    }

    /// 解析 JSON-RPC 请求
    fun parseRequest(json: String): LspRequest {
        val id: Int = extractIntField(json, null, "id")
        val method: String = extractTopField(json, "method")
        val params: String = ""

        if (method.length == 0) { return null }

        val paramsStart: Int = json.indexOf("\"params\"")
        if (paramsStart >= 0) {
            val braceStart: Int = json.indexOf("{", paramsStart)
            if (braceStart >= 0) {
                var depth: Int = 0
                var i: Int = braceStart
                while (i < json.length) {
                    if (String.charCodeAt(json, i) == 123) { depth = depth + 1 }
                    else if (String.charCodeAt(json, i) == 125) {
                        depth = depth - 1
                        if (depth == 0) {
                            params = String.substring(json, braceStart, i + 1)
                            break
                        }
                    }
                    i = i + 1
                }
            }
        }
        return LspRequest(id, method, params)
    }

    /// 从顶层 JSON 提取字段
    fun extractTopField(json: String, key: String): String {
        val keyStart: Int = json.indexOf("\"" + key + "\"")
        if (keyStart < 0) { return "" }
        val colonIdx: Int = json.indexOf(":", keyStart)
        if (colonIdx < 0) { return "" }
        val valueStart: Int = json.indexOf("\"", colonIdx)
        if (valueStart < 0) { return "" }
        val valueEnd: Int = json.indexOf("\"", valueStart + 1)
        if (valueEnd < 0) { return "" }
        return String.substring(json, valueStart + 1, valueEnd)
    }
}

// ═══════════════════════════════════════════════════════════════
// 主循环
// ═══════════════════════════════════════════════════════════════

fun lspMainLoop(): Unit {
    val server: LspServer = LspServer()
    server.start()
    Console.println("LSP server ready (pure Aura, Phase E)")

    while (server.running) {
        val headerLine: String = IO.readLine()
        if (headerLine.length == 0) { break }

        val len: Int = parseContentLength(headerLine)
        if (len <= 0) { continue }

        IO.readLine()  // 读取空行（分隔符）
        val data: String = IO.readAll(len)
        if (data.length == 0) { continue }

        val response: String = server.handleRequest(data)
        if (response.length > 0) {
            IO.println("Content-Length: " + toStr(response.length) + "\n")
            IO.println(response)
        }
    }
    server.stop()
}

/// 解析 Content-Length 头
fun parseContentLength(header: String): Int {
    val prefix: String = "Content-Length: "
    if (String.startsWith(header, prefix)) {
        val numStr: String = String.substring(header, prefix.length)
        return String.toInt(String.trim(numStr))
    }
    return -1
}

// ═══════════════════════════════════════════════════════════════
// 入口函数
// ═══════════════════════════════════════════════════════════════

fun main(): Int {
    lspMainLoop()
    return 0
}
