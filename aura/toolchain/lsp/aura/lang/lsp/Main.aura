package aura.lang.lsp

import aura.lang.std.String
import aura.lang.native.file.FileOps
import aura.lang.native.memory.Allocator
import aura.lang.native.Memory

import aura.lang.lsp.LspServer

object LspMain {

    fun lspMainLoop(): Unit {
        val server: LspServer = LspServer()
        server.start()
        println("LSP server ready (pure Aura, self-bootstrapping)")

        while (server.running) {
            val headerLine: String = readLineExact()
            if (headerLine.length == 0) { break }

            val len: Int = parseContentLength(headerLine)
            if (len <= 0) {
                readLineExact()
                continue
            }

            readLineExact()

            val data: String = readExact(len)
            if (data.length == 0) { continue }

            val response: String = server.handleRequest(data)

            if (response.length > 0) {
                println("Content-Length: " + toStr(response.length) + "\r")
                println("\r")
                print(response)
            }
        }
        server.stop()
    }

    fun readLineExact(): String {
        var result: String = ""
        while (true) {
            val buf: Long = Allocator.malloc(1)
            if (buf == 0) { break }
            val bytesRead: Long = FileOps.read(0, buf, 1)
            if (bytesRead <= 0) {
                Allocator.free(buf)
                break
            }
            val c: Byte = Memory.read(buf)
            Allocator.free(buf)
            if (c == 10) { break }
            result = result + String.fromCharCode(c as Int)
        }
        return result
    }

    fun myStartsWith(s: String, prefix: String): Boolean {
        if (s.length < prefix.length) { return false }
        var i: Int = 0
        while (i < prefix.length) {
            if (s.charCodeAt(i) != prefix.charCodeAt(i)) { return false }
            i = i + 1
        }
        return true
    }

    fun parseContentLength(header: String): Int {
        val prefix: String = "Content-Length:"
        if (myStartsWith(header, prefix)) {
            val numStr: String = header.substring(prefix.length, header.length).trim()
            return numStr.toInt()
        }
        return -1
    }

    fun readExact(n: Int): String {
        if (n <= 0) { return "" }
        val buf: Long = Allocator.malloc(n as Long)
        if (buf == 0) { return "" }
        var total: Long = 0
        var remaining: Long = n as Long
        while (remaining > 0) {
            val bytesRead: Long = FileOps.read(0, buf + total, remaining)
            if (bytesRead <= 0) { break }
            total = total + bytesRead
            remaining = remaining - bytesRead
        }
        if (total <= 0) {
            Allocator.free(buf)
            return ""
        }
        Memory.write(buf + total, 0 as Byte)
        return buf
    }
}

fun main(): Int {
    LspMain.lspMainLoop()
    return 0
}
