// aura:///lsp/aura/lang/lsp/Formatter.aura
package aura.lang.lsp

import aura.lang.std.String

// ═══════════════════════════════════════════════════════════════
// 代码格式化器
//
// 基于缩进级别的格式化：
//   - 遇到 `{` 或 `(` 增加缩进
//   - 遇到 `}` 减少缩进
//   - 每行前添加对应级别的空格缩进
// ═══════════════════════════════════════════════════════════════

object Formatter {

    /// 格式化源码。
    ///
    /// 策略：
    ///   1. 逐行处理
    ///   2. 空行保留为空
    ///   3. 以 `}` 开头的行先减缩进
    ///   4. 以 `{` 或 `(` 结尾的行后增缩进
    ///   5. 4 空格缩进
    fun formatSource(source: String): String {
        if (source.length == 0) { return "" }
        val lines: List<String> = source.split("\n")
        var result: String = ""
        var indent: Int = 0
        var i: Int = 0
        while (i < lines.size) {
            val line: String = lines[i]
            val trimmed: String = line.trim()
            if (trimmed.length == 0) {
                result = result + "\n"
                i = i + 1
                continue
            }
            // 以 `}` 开头 → 先减缩进
            if (trimmed.charCodeAt(0) == 125) {
                if (indent > 0) { indent = indent - 1 }
            }
            // 添加缩进
            result = result + makeIndent(indent)
            result = result + trimmed
            // 以 `{` 或 `(` 结尾 → 增缩进
            val lastChar: Int = trimmed.charCodeAt(trimmed.length - 1)
            if (lastChar == 123 || lastChar == 40) {
                indent = indent + 1
            }
            if (i < lines.size - 1) {
                result = result + "\n"
            }
            i = i + 1
        }
        return result
    }

    /// 生成指定级别的缩进字符串（4 空格/级）。
    private fun makeIndent(level: Int): String {
        var result: String = ""
        var i: Int = 0
        while (i < level) {
            result = result + "    "
            i = i + 1
        }
        return result
    }
}
