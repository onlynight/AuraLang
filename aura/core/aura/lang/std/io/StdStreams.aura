// aura:///aura/lang/std/io/StdStreams.aura
package aura.lang.std.io

import aura.lang.std.IO

/// 默认标准输出流实现。
///
/// @since 0.2
class DefaultConsoleOut {
    fun println(msg: String): Unit {
        IO.println(msg)
    }
    fun print(msg: String): Unit {
        IO.print(msg)
    }
    fun flush(): Unit {}
}

class DefaultConsoleErr {
    fun println(msg: String): Unit {
        IO.println(msg)
    }
    fun print(msg: String): Unit {
        IO.print(msg)
    }
    fun flush(): Unit {}
}

class DefaultConsoleIn {
    fun read(buffer: Long, count: Int): Int {
        return 0
    }
    fun readLine(): String {
        return ""
    }
    fun readAll(): String {
        return ""
    }
    fun close(): Unit {}
}
