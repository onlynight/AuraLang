// aura:///aura/lang/std/Math.aura
package aura.lang.std
// 标准库模块，不可修改
//
// 实现策略：
// - 全部以 Aura 编写，不使用 extern "C" 或 Rust cffi。
// - 三角函数、指数对数、取整等数学运算委托到 aura.lang.native.math.MathOps。
// - MathOps 使用 Taylor 级数 / 牛顿法实现，不依赖 libm。
//
// @since 0.1

import aura.lang.native.math.MathOps.*

/// 数学函数与常量模块。
///
/// 使用前需 import：
/// ```aura
/// import aura.lang.std.Math
/// ```
///
/// 部分函数也在 prelu 中可用（免 import）：`abs`, `sqrt`, `pow`
///
/// @since 0.1
object Math {

    // ── 常量 ──

    /// 圆周率 π
    const val PI: Float = MathOps.PI

    /// 自然常数 e
    const val E: Float = MathOps.E

    /// 32 位整数最大值
    const val INT_MAX: Int = 2147483647

    /// 32 位整数最小值
    const val INT_MIN: Int = -2147483648

    /// 浮点数最大值
    const val FLOAT_MAX: Float = 3.4028235e38f

    // ── 基础运算（纯逻辑，Aura 实现）──

    /// 返回绝对值。
    fun abs(x: Int): Int {
        if (x < 0) {
            return 0 - x
        }
        return x
    }

    /// 返回绝对值（浮点数版本）。
    fun abs(x: Float): Float {
        if (x < 0.0f) {
            return 0.0f - x
        }
        return x
    }

    /// 返回最小值。
    fun min(a: Int, b: Int): Int {
        if (a < b) {
            return a
        }
        return b
    }

    /// 返回最小值（浮点数版本）。
    fun min(a: Float, b: Float): Float {
        return MathOps.fmin(a, b)
    }

    /// 返回最大值。
    fun max(a: Int, b: Int): Int {
        if (a > b) {
            return a
        }
        return b
    }

    /// 返回最大值（浮点数版本）。
    fun max(a: Float, b: Float): Float {
        return MathOps.fmax(a, b)
    }

    // ── 取整（委托到 native.math.MathOps）──

    /// 向下取整（返回不超过 x 的最大整数）。
    fun floor(x: Float): Float {
        return MathOps.floor(x)
    }

    /// 向上取整（返回不小于 x 的最小整数）。
    fun ceil(x: Float): Float {
        return MathOps.ceil(x)
    }

    /// 向零取整（直接截断小数部分）。
    fun trunc(x: Float): Float {
        return MathOps.trunc(x)
    }

    /// 四舍五入（.5 向上取整）。
    fun round(x: Float): Float {
        return MathOps.round(x)
    }

    // ── 指数与开方（委托到 native.math.MathOps）──

    /// 平方根。
    fun sqrt(x: Float): Float {
        return MathOps.sqrt(x)
    }

    /// 立方根。
    fun cbrt(x: Float): Float {
        return MathOps.cbrt(x)
    }

    /// 幂运算 x^y。
    fun pow(base: Float, exp: Float): Float {
        return MathOps.pow(base, exp)
    }

    /// e 的 x 次方。
    fun exp(x: Float): Float {
        return MathOps.exp_fn(x)
    }

    // ── 对数（委托到 native.math.MathOps）──

    /// 自然对数。
    fun log(x: Float): Float {
        return MathOps.log(x)
    }

    /// 以 2 为底的对数。
    fun log2(x: Float): Float {
        return MathOps.log2(x)
    }

    /// 以 10 为底的对数。
    fun log10(x: Float): Float {
        return MathOps.log10(x)
    }

    // ── 三角函数（委托到 native.math.MathOps）──

    /// 正弦（弧度）。
    fun sin(x: Float): Float {
        return MathOps.sin(x)
    }

    /// 余弦（弧度）。
    fun cos(x: Float): Float {
        return MathOps.cos(x)
    }

    /// 正切（弧度）。
    fun tan(x: Float): Float {
        return MathOps.tan(x)
    }

    /// 反正弦（返回弧度）。
    fun asin(x: Float): Float {
        return MathOps.asin(x)
    }

    /// 反余弦（返回弧度）。
    fun acos(x: Float): Float {
        return MathOps.acos(x)
    }

    /// 反正切（返回弧度）。
    fun atan(x: Float): Float {
        return MathOps.atan(x)
    }

    /// 双参数反正切 atan2(y, x)（返回弧度）。
    fun atan2(y: Float, x: Float): Float {
        return MathOps.atan2(y, x)
    }

    // ── 幂与根（纯逻辑，Aura 实现）──

    /// 整数幂运算（指数为负数时返回 0）。
    fun powInt(base: Int, exp: Int): Int {
        if (exp < 0) {
            return 0
        }
        var result: Int = 1
        var b: Int = base
        var e: Int = exp
        while (e > 0) {
            if (e % 2 == 1) {
                result = result * b
            }
            b = b * b
            e = e / 2
        }
        return result
    }

    /// 平方。
    fun square(x: Float): Float {
        return x * x
    }

    /// 立方。
    fun cube(x: Float): Float {
        return x * x * x
    }

    // ── 辅助（纯逻辑，Aura 实现）──

    /// 符号函数：-1, 0, 1。
    fun sign(x: Float): Int {
        if (x > 0.0f) {
            return 1
        } else if (x < 0.0f) {
            return -1
        } else {
            return 0
        }
    }

    /// 限制在 `[lo, hi]` 范围内。
    fun clamp(x: Float, lo: Float, hi: Float): Float {
        if (x < lo) {
            return lo
        } else if (x > hi) {
            return hi
        } else {
            return x
        }
    }

    /// 限制在 `[lo, hi]` 范围内（整数版本）。
    fun clampInt(x: Int, lo: Int, hi: Int): Int {
        if (x < lo) {
            return lo
        } else if (x > hi) {
            return hi
        } else {
            return x
        }
    }

    /// 线性插值：`a + (b - a) * t`（t 不裁剪）。
    fun lerp(a: Float, b: Float, t: Float): Float {
        return a + (b - a) * t
    }

    /// 把 x 从 `[inMin, inMax]` 映射到 `[outMin, outMax]`。
    fun mapRange(x: Float, inMin: Float, inMax: Float, outMin: Float, outMax: Float): Float {
        if (inMax == inMin) {
            return outMin
        }
        return outMin + (x - inMin) * (outMax - outMin) / (inMax - inMin)
    }

    /// 把角度制转换为弧度制。
    fun toRadians(degrees: Float): Float {
        return degrees * PI / 180.0f
    }

    /// 把弧度制转换为角度制。
    fun toDegrees(radians: Float): Float {
        return radians * 180.0f / PI
    }
}
