// aura:///aura/lang/std\Console.aura
package aura.lang.std
// 标准库模块，不可修改
// 实现：纯逻辑模块，全部以 Aura 编写（ANSI 转义序列生成）
// (package 声明由编译器自动注入，无需显式声明)

/// 控制台操作模块（ANSI 转义序列）。
///
/// 本模块本身不做任何 IO，只负责生成 ANSI 转义序列字符串；
/// 需要真正输出时由调用方交给 `aura.lang.std.IO`。
/// 唯一直接输出的成员是 `clear` / `cursorShow` / `cursorHide`，它们内部调用 `IO.print`。
///
/// 使用前需 import：
/// ```aura
/// import aura.lang.std.Console
/// ```
///
/// @see IO, ansi.Ansi
/// @since 0.1
import aura.lang.std.io.Ansi
import aura.lang.std.io.OutputStream
import aura.lang.std.io.InputStream
import aura.lang.std.io.StreamImpl

object Console {

    // ── 内部常量 ──

    /// 默认终端宽度。
    const val DEFAULT_WIDTH: Int = 80

    /// 默认终端高度。
    const val DEFAULT_HEIGHT: Int = 24

    // ── 可替换的输出/输入流（stdout/stderr/stdin）──

    val stdout: OutputStream = StreamImpl.defaultStdout()
    val stderr: OutputStream = StreamImpl.defaultStdout()
    val stdin: InputStream = StreamImpl.defaultStdin()

    fun println(msg: String): Unit {
        stdout.println(msg)
    }

    fun print(msg: String): Unit {
        stdout.print(msg)
    }

    // ── 光标控制（委托到 Ansi）──

    /// 清屏并把光标移到左上角。
    fun clear(): Unit {
        stdout.print(Ansi.clearScreen())
    }

    /// 光标上移 n 行。
    fun cursorUp(lines: Int): String {
        return Ansi.cursorUp(lines)
    }

    /// 光标下移 n 行。
    fun cursorDown(lines: Int): String {
        return Ansi.cursorDown(lines)
    }

    /// 光标左移 n 列。
    fun cursorLeft(cols: Int): String {
        return Ansi.cursorLeft(cols)
    }

    /// 光标右移 n 列。
    fun cursorRight(cols: Int): String {
        return Ansi.cursorRight(cols)
    }

    /// 光标移到指定行列（1-based）。
    fun cursorTo(line: Int, column: Int): String {
        return Ansi.cursorTo(line, column)
    }

    /// 显示光标。
    fun cursorShow(): Unit {
        stdout.print(Ansi.cursorShow())
    }

    /// 隐藏光标。
    fun cursorHide(): Unit {
        stdout.print(Ansi.cursorHide())
    }

    // ── 重置（委托到 Ansi）──

    /// 重置所有 ANSI 格式。
    fun reset(): String {
        return Ansi.reset()
    }

    // ── 前景色（委托到 Ansi）──

    /// 黑色文本。
    fun black(text: String): String {
        return Ansi.black(text)
    }

    /// 红色文本。
    fun red(text: String): String {
        return Ansi.red(text)
    }

    /// 绿色文本。
    fun green(text: String): String {
        return Ansi.green(text)
    }

    /// 黄色文本。
    fun yellow(text: String): String {
        return Ansi.yellow(text)
    }

    /// 蓝色文本。
    fun blue(text: String): String {
        return Ansi.blue(text)
    }

    /// 紫色文本。
    fun magenta(text: String): String {
        return Ansi.magenta(text)
    }

    /// 青色文本。
    fun cyan(text: String): String {
        return Ansi.cyan(text)
    }

    /// 白色文本。
    fun white(text: String): String {
        return Ansi.white(text)
    }

    /// 256 色前景色（0-255）。
    fun color256(text: String, index: Int): String {
        return Ansi.color256(text, index)
    }

    /// 真彩色前景色（RGB，各分量 0-255）。
    fun rgb(text: String, r: Int, g: Int, b: Int): String {
        return Ansi.rgb(text, r, g, b)
    }

    // ── 背景色（委托到 Ansi）──

    /// 红色背景。
    fun onRed(text: String): String {
        return Ansi.onRed(text)
    }

    /// 绿色背景。
    fun onGreen(text: String): String {
        return Ansi.onGreen(text)
    }

    /// 黄色背景。
    fun onYellow(text: String): String {
        return Ansi.onYellow(text)
    }

    /// 蓝色背景。
    fun onBlue(text: String): String {
        return Ansi.onBlue(text)
    }

    // ── 样式（委托到 Ansi）──

    /// 粗体文本。
    fun bold(text: String): String {
        return Ansi.bold(text)
    }

    /// 斜体文本。
    fun italic(text: String): String {
        return Ansi.italic(text)
    }

    /// 下划线文本。
    fun underline(text: String): String {
        return Ansi.underline(text)
    }

    /// 暗色文本。
    fun dim(text: String): String {
        return Ansi.dim(text)
    }

    /// 反色文本。
    fun inverse(text: String): String {
        return Ansi.inverse(text)
    }

    /// 删除线文本。
    fun strikethrough(text: String): String {
        return Ansi.strikethrough(text)
    }

    // ── 屏幕尺寸（终端尺寸探测为 native；此处给出稳定默认值）──

    /// 屏幕尺寸（[width, height]）。
    val size: List<Int> {
        val result: List<Int> = mutableListOf<Int>()
        result.add(DEFAULT_WIDTH)
        result.add(DEFAULT_HEIGHT)
        return result
    }

    /// 屏幕宽度。
    val width: Int {
        return 80
    }

    /// 屏幕高度。
    val height: Int {
        return 24
    }
}
