// aura:///aura/lang/std/Encoding.aura
package aura.lang.std
// 标准库模块，不可修改
// 实现：纯逻辑模块，全部以 Aura 编写
// (package 声明由编译器自动注入，无需显式声明)
/// 编码与解码模块（Base64 / Hex / URL）。
///
/// 全部为纯逻辑实现，不依赖任何 native 函数。
///
/// 使用前需 import：
/// ```aura
/// import aura.lang.std.Encoding
/// ```
///
/// @since 0.1
internal object Encoding {

    // ── 常量 ──

    /// Base64 字母表（标准 RFC 4648 变体）。
    private const val BASE64_CHARS: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

    /// 十六进制字母表（大写）。
    private const val HEX_CHARS: String = "0123456789ABCDEF"

    // ── Base64（纯逻辑，Aura 实现）──

    /// Base64 编码。
    fun base64Encode(text: String): String {
        var result: String = ""
        var i: Int = 0
        while (i < text.length) {
            val b1: Int = text.charCodeAt(i)
            val b2: Int = if (i + 1 < text.length) text.charCodeAt(i + 1) else 0
            val b3: Int = if (i + 2 < text.length) text.charCodeAt(i + 2) else 0
            val triplet: Int = b1 * 65536 + b2 * 256 + b3
            result = result + BASE64_CHARS[(triplet / 262144) % 64].toString()
            result = result + BASE64_CHARS[(triplet / 4096) % 64].toString()
            if (i + 1 < text.length) {
                result = result + BASE64_CHARS[(triplet / 64) % 64].toString()
            } else {
                result = result + "="
            }
            if (i + 2 < text.length) {
                result = result + BASE64_CHARS[triplet % 64].toString()
            } else {
                result = result + "="
            }
            i = i + 3
        }
        return result
    }

    /// Base64 解码；非法字符被跳过，残缺分组按已解出字节返回。
    fun base64Decode(text: String): String {
        var result: String = ""
        var i: Int = 0
        while (i < text.length) {
            if (text[i] == '=') {
                i = i + 1
            } else {
                val b1: Int = BASE64_CHARS.indexOf(text[i].toString())
                if (b1 < 0) {
                    i = i + 1
                } else if (i + 1 >= text.length || text[i + 1] == '=') {
                    result = result + String.fromCharCode(b1 * 4)
                    i = i + 1
                } else {
                    val b2: Int = BASE64_CHARS.indexOf(text[i + 1].toString())
                    if (b2 < 0) {
                        i = i + 1
                    } else {
                        result = result + String.fromCharCode(b1 * 4 + b2 / 16)
                        if (i + 2 >= text.length || text[i + 2] == '=') {
                            i = i + 2
                        } else {
                            val b3: Int = BASE64_CHARS.indexOf(text[i + 2].toString())
                            if (b3 < 0) {
                                i = i + 1
                            } else {
                                result = result + String.fromCharCode((b2 % 16) * 16 + b3 / 4)
                                if (i + 3 >= text.length || text[i + 3] == '=') {
                                    i = i + 3
                                } else {
                                    val b4: Int = BASE64_CHARS.indexOf(text[i + 3].toString())
                                    if (b4 >= 0) {
                                        result = result + String.fromCharCode((b3 % 4) * 64 + b4)
                                    }
                                    i = i + 4
                                }
                            }
                        }
                    }
                }
            }
        }
        return result
    }

    // ── Hex（纯逻辑，Aura 实现）──

    /// 十六进制编码（大写，无分隔符）。
    fun hexEncode(text: String): String {
        var result: String = ""
        var i: Int = 0
        while (i < text.length) {
            val code: Int = text.charCodeAt(i)
            result = result + hexDigit(code / 16) + hexDigit(code % 16)
            i = i + 1
        }
        return result
    }

    /// 十六进制解码；非法字符被跳过，奇数长度时最后一个半字节被忽略。
    fun hexDecode(text: String): String {
        var result: String = ""
        var i: Int = 0
        while (i + 1 < text.length) {
            val hi: Int = hexValue(text[i])
            val lo: Int = hexValue(text[i + 1])
            if (hi >= 0 && lo >= 0) {
                result = result + String.fromCharCode(hi * 16 + lo)
            }
            i = i + 2
        }
        return result
    }

    // ── URL（纯逻辑，Aura 实现）──

    /// URL 编码（保留 unreserved 字符：A-Z a-z 0-9 - _ . ~）。
    fun urlEncode(text: String): String {
        var result: String = ""
        var i: Int = 0
        while (i < text.length) {
            val c: Char = text[i]
            if (isUnreserved(c)) {
                result = result + c.toString()
            } else {
                val code: Int = text.charCodeAt(i)
                result = result + "%" + hexDigit(code / 16) + hexDigit(code % 16)
            }
            i = i + 1
        }
        return result
    }

    /// URL 解码（`+` 视为空格，`%XX` 解码为字节）。
    fun urlDecode(text: String): String {
        var result: String = ""
        var i: Int = 0
        while (i < text.length) {
            val c: Char = text[i]
            if (c == '%') {
                if (i + 2 < text.length) {
                    val hi: Int = hexValue(text[i + 1])
                    val lo: Int = hexValue(text[i + 2])
                    if (hi >= 0 && lo >= 0) {
                        result = result + String.fromCharCode(hi * 16 + lo)
                    }
                    i = i + 3
                } else {
                    result = result + c.toString()
                    i = i + 1
                }
            } else if (c == '+') {
                result = result + " "
                i = i + 1
            } else {
                result = result + c.toString()
                i = i + 1
            }
        }
        return result
    }

    // ── 内部工具（纯逻辑，Aura 实现）──

    /// 将 0-15 的值转换为单个十六进制字符；越界返回空字符串。
    private fun hexDigit(value: Int): String {
        if (value < 0 || value > 15) { return "" }
        return HEX_CHARS[value].toString()
    }

    /// 将十六进制字符转换为 0-15 的值；非法字符返回 -1。
    private fun hexValue(c: Char): Int {
        if (c >= '0' && c <= '9') { return c - '0' }
        if (c >= 'A' && c <= 'F') { return c - 'A' + 10 }
        if (c >= 'a' && c <= 'f') { return c - 'a' + 10 }
        return -1
    }

    /// 判断字符是否为 URL unreserved 字符。
    private fun isUnreserved(c: Char): Boolean {
        if (c >= 'a' && c <= 'z') { return true }
        if (c >= 'A' && c <= 'Z') { return true }
        if (c >= '0' && c <= '9') { return true }
        return c == '-' || c == '_' || c == '.' || c == '~'
    }

    // ── 密码学哈希（SHA256 运行时实现 + HMAC Aura 实现）──

    /// SHA256 哈希（运行时内置实现）。
    /// 返回 64 字符十六进制小写字符串。
    fun sha256(text: String): String

    /// HMAC-SHA256 消息认证码（Aura 实现，调用 sha256）。
    ///
    /// 算法：HMAC(K, m) = SHA256((K ⊕ opad) || SHA256((K ⊕ ipad) || m))
    /// 其中 ipad = 0x36 重复，opad = 0x5C 重复。
    ///
    /// 返回 64 字符十六进制小写字符串。
    /// 注意：key 和 message 必须是 ASCII 字符串（0-127）。
    fun hmacSha256(key: String, message: String): String {
        // 1. 准备 64 字节 key（如果超过 64 字节则先哈希）
        val keyStr: String = if (key.length > 64) {
            // key 超长：先 SHA256 得到 32 字节，再补零到 64
            val kh: String = sha256(key)
            val kBytes: String = bytesFromHex(kh)
            kBytes + stringOfNul(64 - 32)
        } else {
            key + stringOfNul(64 - key.length)
        }

        // 2. 计算 ipad 和 opad（XOR 0x36 / 0x5C）
        val ipad: String = xorString(keyStr, 0x36)
        val opad: String = xorString(keyStr, 0x5C)

        // 3. inner = SHA256(ipad || message)
        val innerHex: String = sha256(ipad + message)
        val innerBytes: String = bytesFromHex(innerHex)

        // 4. outer = SHA256(opad || inner)
        return sha256(opad + innerBytes)
    }

    /// 返回 n 个 NUL 字符组成的字符串
    private fun stringOfNul(n: Int): String {
        var s: String = ""
        var i: Int = 0
        while (i < n) {
            s = s + String.fromCharCode(0)
            i = i + 1
        }
        return s
    }

    /// 对字符串每个字符的 code 与 x 做异或，返回新字符串
    private fun xorString(s: String, x: Int): String {
        var result: String = ""
        var i: Int = 0
        while (i < s.length) {
            result = result + String.fromCharCode(s.charCodeAt(i) xor x)
            i = i + 1
        }
        return result
    }

    /// 将 64 字符十六进制字符串转换为 32 字节字符串
    private fun bytesFromHex(hex: String): String {
        var result: String = ""
        var i: Int = 0
        while (i + 1 < hex.length) {
            val hi: Int = hexValue(hex.charCodeAt(i))
            val lo: Int = hexValue(hex.charCodeAt(i + 1))
            if (hi >= 0 && lo >= 0) {
                result = result + String.fromCharCode(hi * 16 + lo)
            }
            i = i + 2
        }
        return result
    }
}
