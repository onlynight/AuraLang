// aura:///aura/lang/std/string/StringBuilder.aura
package aura.lang.std.string
// ─────────────────────────────────────────────────────────────
// 原生可变字符串缓冲区 — Phase P1
//
// 每个 StringBuilder 是独立实例（class），持有自己的内部句柄 h（AuraSb* 指针）。
// 不再依赖单例 object，避免并发编译时共享同一缓冲区导致数据互踩。
//
// 内存布局（AuraSb 结构体，由 C 层 aura_std_cffi.c 管理）：
//   offset 0  : buf ptr (i64, 数据区)
//   offset 8  : len (i64, 已用字节)
//   offset 16 : cap (i64, 容量)
//
// 所有分配走 Memory.alloc（带上限检查），保持内存闸门记账一致。
// 句柄用 i64 承载指针，规避 Plan A「i8* 低位标记装箱整数」的历史坑。
// ─────────────────────────────────────────────────────────────

import aura.lang.native.Memory
import aura.lang.std.string.StringOps

/// 原生可变字符串缓冲区（纯 Aura 实现，每个实例独立）。
class StringBuilder {

    /// 内部句柄（AuraSb* 指针，i64 承载）。
    var h: Long = 0

    /// 初始容量（字节）。
    const val SB_INIT_CAP: Long = 256

    init() {
        this.h = newHandle()
    }

    // ── 公开接口 ──

    /// 追加字符串（返回 self，便于链式调用）。
    fun append(text: String): StringBuilder {
        if (text == "") { return this }
        val ptr: Long = CString(text)
        if (ptr == 0) { return this }
        var n: Long = 0
        var c: Byte = Memory.read(ptr + n)
        while (c != 0) {
            n = n + 1
            c = Memory.read(ptr + n)
        }
        appendN(this.h, ptr, n)
        return this
    }

    /// 追加单个字符（返回 self）。
    fun appendChar(ch: Char): StringBuilder {
        val sb: Long = this.h
        val len: Long = sbLen(sb)
        sbReserve(sb, len + 2)
        val buf: Long = sbBuf(sb)
        if (buf == 0) { return this }
        Memory.write(buf + len, ch as Byte)
        Memory.write64(sb + 8, len + 1)
        Memory.write(buf + len + 1, 0 as Byte)
        return this
    }

    /// 追加整数（返回 self）。
    fun appendInt(value: Int): StringBuilder {
        val sb: Long = this.h
        val len: Long = sbLen(sb)
        sbReserve(sb, len + 12)
        val buf: Long = sbBuf(sb)
        if (buf == 0) { return this }
        var v: Long = value as Long
        var neg: Boolean = false
        if (v < 0) { neg = true; v = -v }
        val tmp: Long = Memory.alloc(32)
        if (tmp == 0) { return this }
        if (v == 0) {
            Memory.write(tmp, 48 as Byte)
            v = 1
        }
        var pos: Long = 0
        while (v > 0) {
            val digit: Long = v % 10
            Memory.write(tmp + pos, (48 + digit) as Byte)
            pos = pos + 1
            v = v / 10
        }
        if (neg) {
            Memory.write(tmp + pos, 45 as Byte)
            pos = pos + 1
        }
        var start: Long = 0
        var end: Long = pos - 1
        while (start < end) {
            val a: Byte = Memory.read(tmp + start)
            val b: Byte = Memory.read(tmp + end)
            Memory.write(tmp + start, b)
            Memory.write(tmp + end, a)
            start = start + 1
            end = end - 1
        }
        val newLen: Long = len + pos
        Memory.copy(buf + len, tmp, pos)
        Memory.write64(sb + 8, newLen)
        Memory.write(buf + newLen, 0 as Byte)
        Memory.free(tmp)
        return this
    }

    /// 当前字节长度。
    fun length(): Int {
        return sbLen(this.h) as Int
    }

    /// 检查缓冲区是否包含指定子串。
    fun contains(sub: String): Boolean {
        if (sub == "") {
            return true
        }
        val buf: Long = sbBuf(this.h)
        val len: Long = sbLen(this.h)
        if (buf == 0 || len <= 0) {
            return false
        }
        val subPtr: Long = CString(sub)
        // 在缓冲区中搜索子串（类似 C 的 strstr）
        val subLen: Long = sub.length as Long
        if (subLen > len) {
            return false
        }
        // 逐字符比较
        var i: Long = 0
        while (i + subLen <= len) {
            var found: Boolean = true
            var j: Long = 0
            while (j < subLen) {
                if (Memory.read(buf + i + j) != Memory.read(subPtr + j)) {
                    found = false
                    break
                }
                j = j + 1
            }
            if (found) {
                return true
            }
            i = i + 1
        }
        return false
    }

    /// 获取当前内容快照（**不重置**缓冲区，之后可继续 append）。
    ///
    /// 返回的 String 是独立分配（与缓冲区解耦），
    /// 后续 append 不影响已取出的 String 内容。
    fun build(): String {
        val sb: Long = this.h
        val buf: Long = sbBuf(sb)
        val len: Long = sbLen(sb)
        if (buf == 0 || len <= 0) { return "" }
        return ReadCStr(buf)
    }

    /// 清空（保留容量，返回 self）。
    fun reset(): StringBuilder {
        val sb: Long = this.h
        var buf: Long = sbBuf(sb)
        if (buf == 0) {
            buf = Memory.alloc(SB_INIT_CAP)
            if (buf == 0) {
                Memory.write64(sb + 16, 0)
            } else {
                Memory.write(buf, 0 as Byte)
                Memory.write64(sb + 16, SB_INIT_CAP)
            }
            Memory.write64(sb, buf)
        } else {
            Memory.write(buf, 0 as Byte)
        }
        Memory.write64(sb + 8, 0)
        return this
    }

    /// 深拷贝当前内容到新实例。
    fun copy(): StringBuilder {
        val newSb: StringBuilder = StringBuilder()
        val newH: Long = newSb.h
        val srcH: Long = this.h
        val srcLen: Long = sbLen(srcH)
        if (srcLen > 0) {
            val srcBuf: Long = sbBuf(srcH)
            if (srcBuf != 0) {
                appendN(newH, srcBuf, srcLen)
            }
        }
        return newSb
    }

    // ── 内部辅助方法 ──

    private fun newHandle(): Long {
        val sb: Long = Memory.alloc(24)
        if (sb == 0) { return 0 }
        val buf: Long = Memory.alloc(SB_INIT_CAP)
        if (buf == 0) {
            Memory.write64(sb, 0)
            Memory.write64(sb + 8, 0)
            Memory.write64(sb + 16, 0)
            return sb
        }
        Memory.write64(sb, buf)
        Memory.write(buf, 0 as Byte)
        Memory.write64(sb + 8, 0)
        Memory.write64(sb + 16, SB_INIT_CAP)
        return sb
    }

    private fun sbBuf(handle: Long): Long {
        return Memory.read64(handle)
    }

    private fun sbLen(handle: Long): Long {
        return Memory.read64(handle + 8)
    }

    private fun sbReserve(sb: Long, need: Long) {
        if (sb == 0) { return }
        val SB_MAX_CAP: Long = 268435456
        var want: Long = need
        if (want < 0 || want > SB_MAX_CAP) { return }
        val cap: Long = Memory.read64(sb + 16)
        if (cap >= want) { return }
        var newcap: Long = cap
        if (newcap < SB_INIT_CAP) { newcap = SB_INIT_CAP }
        while (newcap < want) {
            val next: Long = newcap * 2
            if (next <= newcap || next > SB_MAX_CAP) {
                newcap = SB_MAX_CAP
                break
            }
            newcap = next
        }
        val oldBuf: Long = Memory.read64(sb)
        val newBuf: Long = Memory.alloc(newcap)
        if (newBuf == 0) { return }
        val oldLen: Long = Memory.read64(sb + 8)
        if (oldLen > 0 && oldBuf != 0) {
            Memory.copy(newBuf, oldBuf, oldLen)
            Memory.write(newBuf + oldLen, 0 as Byte)
        }
        Memory.free(oldBuf)
        Memory.write64(sb, newBuf)
        Memory.write64(sb + 16, newcap)
    }

    private fun appendN(handle: Long, src: Long, n: Long) {
        val sb: Long = handle
        if (sb == 0) { return }
        if (n < 0 || n > 67108864) { return }
        val len: Long = sbLen(sb)
        sbReserve(sb, len + n + 1)
        val cap: Long = Memory.read64(sb + 16)
        if (cap < len + n + 1) { return }
        val buf: Long = sbBuf(sb)
        if (buf == 0) { return }
        if (src != 0 && n > 0) {
            Memory.copy(buf + len, src, n)
        }
        Memory.write64(sb + 8, len + n)
        Memory.write(buf + len + n, 0 as Byte)
    }
}
