// aura:///aura/lang/std/File.aura
package aura.lang.std

import aura.lang.native.memory.Allocator
import aura.lang.native.file.FileOps
import aura.lang.native.io.Stdio

/// 文件资源实例（有状态）。
///
/// 打开标志一律写字面量而不是 `FileOps.O_WRONLY` 等常量成员：
/// **跨模块**的对象/接口常量成员在 AOT 下无法折叠（`FileOps` 是独立编译
/// 单元，其 `const val` 不参与本编译单元的 HIR），会发射出未定义值
/// `%FileOps` 导致链接失败。
///
/// ```aura
/// val f: File = File("hello.txt")
/// f.writeText("Hello, World!")
/// val content: String = f.readText()
/// f.exists()
/// f.delete()
/// ```
///
/// @since 0.2
class File {

    /// 原始路径（供 `exists` 等需要字符串的 API 使用）。
    private var pathStr: String = ""

    /// 路径的 C 缓冲区（NUL 结尾，`init` 中填充）。
    private var pathBuf: Long = 0

    /// 绑定到指定路径。
    init(path: String) {
        this.pathStr = path
        this.pathBuf = Stdio.stringToBuffer(path)
    }

    /// 读取整个文件为字符串；失败返回空串。
    fun readText(): String {
        val fd: Int = FileOps.open(pathBuf, 0)  // O_RDONLY
        if (fd < 0) { return "" }

        val size: Long = FileOps.lseek(fd, 0, 2)  // SEEK_END
        FileOps.lseek(fd, 0, 0)                   // SEEK_SET

        if (size <= 0) {
            FileOps.close(fd)
            return ""
        }

        val buf: Long = Allocator.malloc(size + 1)
        if (buf == 0) {
            FileOps.close(fd)
            return ""
        }

        val read: Long = FileOps.read(fd, buf, size)
        FileOps.close(fd)

        if (read <= 0) {
            Allocator.free(buf)
            return ""
        }

        // ⚠️ `Stdio.bufferToString` 是**零拷贝**：返回的 String 就是 `buf` 本身
        // （见其文档「调用方此后**不得** `Allocator.free(buf)`」）。
        // 旧实现在此处 free 后再返回 ⇒ 悬垂指针：调用方拿到的是已释放内存，
        // 后续任何分配都会覆盖它 —— 实测自举驱动 `AotModuleLinker.loadPath`
        // 读到的源码长度变成 6、内容全错（`parse-start len=6 nodes=1`），
        // 读 `aura/core/aura/lang/String.aura` 时直接 0xC0000005。
        // 因此这里**不能** free；缓冲区随返回的字符串一起存活（少量泄漏可接受）。
        val text: String = Stdio.bufferToString(buf, read)
        return text
    }

    /// 覆写整个文件。
    fun writeText(content: String): Unit {
        val fd: Int = FileOps.open(pathBuf, 1 | 0x40 | 0x200)  // O_WRONLY|O_CREAT|O_TRUNC
        if (fd < 0) { return }

        val buf: Long = Stdio.stringToBuffer(content)
        if (buf == 0) {
            FileOps.close(fd)
            return
        }

        val len: Long = Stdio.strlen(buf)
        FileOps.write(fd, buf, len)
        Allocator.free(buf)
        FileOps.close(fd)
    }

    /// 读取整个文件为字节数组；失败返回空数组。
    fun readBytes(): Array<Byte> {
        val text: String = readText()
        val arr: Array<Byte> = arrayOf<Byte>()
        var i: Int = 0
        while (i < text.length) {
            arr[i] = text.charCodeAt(i) as Byte
            i = i + 1
        }
        return arr
    }

    /// 覆写整个文件（二进制）。
    fun writeBytes(bytes: Array<Byte>): Unit {
        var content: String = ""
        var i: Int = 0
        while (i < bytes.size) {
            content = content + String.fromCharCode(bytes[i])
            i = i + 1
        }
        writeText(content)
    }

    /// 文件是否存在。
    fun exists(): Boolean {
        return Stdio.fileExists(pathStr)
    }

    /// 是否为普通文件。
    fun isFile(): Boolean {
        return Stdio.fileExists(pathStr)
    }

    /// 文件大小（字节）；不存在返回 -1。
    fun size(): Long {
        val fd: Int = FileOps.open(pathBuf, 0)  // O_RDONLY
        if (fd < 0) { return -1 }
        val n: Long = FileOps.lseek(fd, 0, 2)  // SEEK_END
        FileOps.close(fd)
        return n
    }

    /// 删除文件。
    fun delete(): Unit {
        FileOps.unlink(pathBuf)
    }

    /// 重命名文件到 newPath。
    fun renameTo(newPath: String): Unit {
        val newBuf: Long = Stdio.stringToBuffer(newPath)
        if (newBuf == 0) { return }
        FileOps.rename(pathBuf, newBuf)
        Allocator.free(newBuf)
    }

    /// 复制文件到 targetPath。
    fun copyTo(targetPath: String): Unit {
        val target: File = File(targetPath)
        target.writeText(readText())
    }
}