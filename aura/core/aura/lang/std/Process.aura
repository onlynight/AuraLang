// aura:///aura/lang/std/Process.aura
package aura.lang.std
// ─────────────────────────────────────────────────────────────
// 进程管理模块 — 兼容包装层
//
// 实现已移至 aura.core.native 包（native/process/Process.aura）。
// 本文件保留为向后兼容包装，委托调用 native 实现。
//
// @since 0.1
// ─────────────────────────────────────────────────────────────

import aura.lang.native.process.Process as NativeProcess

/// 进程管理模块（兼容包装）。
///
/// 使用前需 import：
/// ```aura
/// import aura.lang.std.Process
/// ```
///
/// @since 0.1
object Process {

    // ── 退出 ──

    /// 退出进程并返回指定状态码。
    fun exit(code: Int): Unit {
        NativeProcess.exit(code)
    }

    /// 获取进程退出状态码。
    val exitCode: Int = 0

    // ── 命令行参数 ──

    /// 获取命令行参数列表。
    val args: List<String> = NativeProcess.args()

    /// 获取指定索引的命令行参数。
    fun arg(index: Int): String {
        return NativeProcess.arg(index)
    }

    /// 获取命令行参数数量。
    val argCount: Int = NativeProcess.argCount()

    // ── 进程信息 ──

    /// 获取当前进程 ID。
    val pid: Int = NativeProcess.pid()

    // ── 进程控制 ──

    /// 启动新进程。
    fun spawn(command: String): Any {
        val pid: Int = NativeProcess.spawn(command)
        return pid
    }

    /// 以 shell 同步执行命令行，返回退出码（阻塞直到结束）。
    fun run(command: String): Int {
        return NativeProcess.run(command)
    }

    /// 杀死指定进程。
    fun kill(pid: Int): Unit {
        NativeProcess.kill(pid)
    }

    /// 等待指定进程结束并返回退出码。
    fun wait(pid: Int): Int {
        return NativeProcess.wait(pid)
    }

    /// 退出进程（`exit` 的别名）。
    fun exitProcess(code: Int): Unit {
        NativeProcess.exitProcess(code)
    }
}
