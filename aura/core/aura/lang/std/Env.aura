// aura:///aura/lang/std/Env.aura
package aura.lang.std
// 标准库模块，不可修改
//
// 实现策略：
// - 全部以 Aura 编写，不使用 extern "C" 或 Rust cffi。
// - 环境变量读取委托到 aura.lang.native.env.EnvOps（读取 /proc/self/environ）。
// - set/remove 操作因 Linux 内核限制不支持，调用无效果。
//
// 使用前需 import：
// ```aura
// import aura.env.*
// ```
//
// @since 0.1

import aura.lang.native.env.EnvOps

/// 环境变量模块。
///
/// 实现全部为纯 Aura 代码，系统能力委托到 aura.lang.native 包。
///
/// @since 0.1
object Env {

    // ── 环境变量操作 ──

    /// 获取环境变量值，不存在时返回默认值。
    fun get(name: String, default: String): String {
        return EnvOps.get(name, default)
    }

    /// 设置环境变量（不支持：Linux 内核限制）。
    fun set(name: String, value: String): Unit {
        EnvOps.set(name, value)
    }

    /// 删除环境变量（不支持：Linux 内核限制）。
    fun remove(name: String): Unit {
        EnvOps.remove(name)
    }

    /// 检查环境变量是否存在。
    fun has(name: String): Boolean {
        return EnvOps.has(name)
    }

    // ── 环境变量列表 ──

    /// 获取所有环境变量名。
    val keys: List<String> = EnvOps.keys()

    /// 获取所有环境变量的值。
    val values: List<String> = EnvOps.values()

    /// 获取所有环境变量（键值对列表，简化实现：返回键名列表）。
    val all: List<String> = EnvOps.keys()

    // ── 系统路径 ──

    /// 获取用户主目录。
    val home: String = EnvOps.home()

    /// 获取临时目录。
    val tmp: String = EnvOps.tmp()

    /// 获取当前工作目录。
    val pwd: String = EnvOps.pwd()

    // ── 平台信息 ──

    /// 获取平台名称（"windows"/"linux"/"macos"）。
    val platform: String = EnvOps.platform()

    /// 获取操作系统名称（同 platform）。
    val os: String = EnvOps.platform()

    /// 获取 CPU 架构（"x86_64"/"aarch64"/"armv7"）。
    val arch: String = EnvOps.arch()
}
