// aura:///aura/lang/std/Json.aura
// 标准库模块，不可修改
// 实现：纯逻辑模块，词法/语法分析与序列化全部以 Aura 编写
// (package 声明由编译器自动注入，无需显式声明)
/// JSON 解析与序列化模块。
///
/// 映射关系：
/// - JSON 对象 → `Map<Any, Any>`（键为 String）
/// - JSON 数组 → `List<Any>`
/// - JSON 字符串 → `String`，数字 → `Int` / `Float`
/// - `true` / `false` → `Boolean`，`null` → `null`
///
/// 解析器采用递归下降实现，游标由单元素 `List<Int>` 在递归之间共享，
/// 因此不依赖任何 native 函数。
///
/// 使用前需 import：
/// ```aura
/// import aura.lang.std.Json
/// ```
///
/// @since 0.1

import aura.lang.std.Collections
import aura.lang.std.Builtin

internal object Json {

    // ── 解析（纯逻辑，Aura 实现）──

    /// 解析 JSON 文本；解析失败返回 null。
    fun parse(text: String): Any {
        val pos: List<Int> = mutableListOf<Int>()
        pos.add(0)
        skipWhitespace(text, pos)
        val value: Any = parseValue(text, pos)
        skipWhitespace(text, pos)
        return value
    }

    /// 检查字符串是否为合法 JSON。
    fun isValid(text: String): Boolean {
        return parse(text) != null
    }

    // ── 序列化（纯逻辑，Aura 实现）──

    /// 将 Aura 值序列化为 JSON 字符串。
    ///
    /// @param pretty 是否格式化输出（缩进换行）
    fun stringify(value: Any, pretty: Boolean): String {
        return stringifyAt(value, pretty, 0)
    }

    /// 将 Aura 值序列化为紧凑格式的 JSON 字符串。
    fun toCompactString(value: Any): String {
        return stringify(value, false)
    }

    // ── 访问（纯逻辑，Aura 实现）──

    /// 获取 JSON 对象指定键的值（不存在返回 null）。
    fun get(obj: Any, key: String): Any {
        if (obj == null || !isObject(obj)) {
            return null
        }
        val map: Map<Any, Any> = obj as Map<Any, Any>
        return map[key]
    }

    /// 获取 JSON 对象指定键的值（`get` 别名）。
    fun getOrNull(obj: Any, key: String): Any {
        return get(obj, key)
    }

    /// 获取 JSON 数组指定下标的元素。
    fun at(array: Any, index: Int): Any {
        if (array == null || !isArray(array)) {
            return null
        }
        val list: List<Any> = array as List<Any>
        if (index < 0 || index >= list.size) {
            return null
        }
        return list[index]
    }

    /// 设置 JSON 对象指定键的值。
    fun set(obj: Any, key: String, value: Any): Unit {
        if (obj == null || !isObject(obj)) {
            return
        }
        val map: Map<Any, Any> = obj as Map<Any, Any>
        map[key] = value
    }

    /// 检查 JSON 对象是否包含指定键。
    fun contains(obj: Any, key: String): Boolean {
        return get(obj, key) != null
    }

    /// 移除 JSON 对象指定键。
    fun remove(obj: Any, key: String): Unit {
        if (obj == null || !isObject(obj)) {
            return
        }
        val map: Map<Any, Any> = obj as Map<Any, Any>
        map[key] = null
    }

    // ── 遍历（纯逻辑，Aura 实现）──

    /// 获取 JSON 对象的所有键。
    fun keys(obj: Any): List<String> {
        val result: List<String> = mutableListOf<String>()
        if (obj == null || !isObject(obj)) {
            return result
        }
        val map: Map<Any, Any> = obj as Map<Any, Any>
        val all: List<Any> = map.keys
        var i: Int = 0
        while (i < all.size) {
            result.add(toStr(all[i]))
            i = i + 1
        }
        return result
    }

    /// 获取 JSON 对象的所有值。
    fun values(obj: Any): List<Any> {
        val result: List<Any> = mutableListOf<Any>()
        val allKeys: List<String> = keys(obj)
        var i: Int = 0
        while (i < allKeys.size) {
            result.add(get(obj, allKeys[i]))
            i = i + 1
        }
        return result
    }

    /// 获取 JSON 数组/对象的元素数量。
    fun length(obj: Any): Int {
        if (obj == null) {
            return 0
        }
        if (isArray(obj)) {
            val list: List<Any> = obj as List<Any>
            return list.size
        }
        if (isObject(obj)) {
            val map: Map<Any, Any> = obj as Map<Any, Any>
            return map.size
        }
        if (typeof(obj) == "String") {
            val text: String = obj as String
            return text.length
        }
        return 0
    }

    /// 检查值是否为 JSON 对象（Map）。
    fun isObject(value: Any): Boolean {
        if (value == null) {
            return false
        }
        return typeof(value) == "Map"
    }

    /// 检查值是否为 JSON 数组（List）。
    fun isArray(value: Any): Boolean {
        if (value == null) {
            return false
        }
        return typeof(value) == "List"
    }

    // ── 解析内部实现（纯逻辑，Aura 实现）──

    /// 解析任意 JSON 值。
    private fun parseValue(text: String, pos: List<Int>): Any {
        skipWhitespace(text, pos)
        if (pos[0] >= text.length) {
            return null
        }
        val c: Char = text[pos[0]]
        if (c == '{') {
            return parseObject(text, pos)
        }
        if (c == '[') {
            return parseArray(text, pos)
        }
        if (c == '"') {
            return parseString(text, pos)
        }
        if (c == 't') {
            if (matchesWord(text, pos[0], "true")) {
                pos[0] = pos[0] + 4
                return true
            }
            return null
        }
        if (c == 'f') {
            if (matchesWord(text, pos[0], "false")) {
                pos[0] = pos[0] + 5
                return false
            }
            return null
        }
        if (c == 'n') {
            if (matchesWord(text, pos[0], "null")) {
                pos[0] = pos[0] + 4
                return null
            }
            return null
        }
        return parseNumber(text, pos)
    }

    /// 解析 JSON 对象。
    private fun parseObject(text: String, pos: List<Int>): Any {
        val result: Map<Any, Any> = Collections.mutableMapOf()
        pos[0] = pos[0] + 1
        skipWhitespace(text, pos)
        if (pos[0] < text.length && text[pos[0]] == '}') {
            pos[0] = pos[0] + 1
            return result
        }
        while (pos[0] < text.length) {
            skipWhitespace(text, pos)
            if (pos[0] >= text.length || text[pos[0]] != '"') {
                return null
            }
            val key: Any = parseString(text, pos)
            if (key == null) {
                return null
            }
            skipWhitespace(text, pos)
            if (pos[0] >= text.length || text[pos[0]] != ':') {
                return null
            }
            pos[0] = pos[0] + 1
            val value: Any = parseValue(text, pos)
            result[key] = value
            skipWhitespace(text, pos)
            if (pos[0] < text.length && text[pos[0]] == ',') {
                pos[0] = pos[0] + 1
            } else {
                if (pos[0] < text.length && text[pos[0]] == '}') {
                    pos[0] = pos[0] + 1
                    return result
                }
                return null
            }
        }
        return null
    }

    /// 解析 JSON 数组。
    private fun parseArray(text: String, pos: List<Int>): Any {
        val result: List<Any> = mutableListOf<Any>()
        pos[0] = pos[0] + 1
        skipWhitespace(text, pos)
        if (pos[0] < text.length && text[pos[0]] == ']') {
            pos[0] = pos[0] + 1
            return result
        }
        while (pos[0] < text.length) {
            val value: Any = parseValue(text, pos)
            result.add(value)
            skipWhitespace(text, pos)
            if (pos[0] < text.length && text[pos[0]] == ',') {
                pos[0] = pos[0] + 1
            } else {
                if (pos[0] < text.length && text[pos[0]] == ']') {
                    pos[0] = pos[0] + 1
                    return result
                }
                return null
            }
        }
        return null
    }

    /// 解析 JSON 字符串（含转义处理）。
    private fun parseString(text: String, pos: List<Int>): Any {
        pos[0] = pos[0] + 1
        var result: String = ""
        while (pos[0] < text.length) {
            val c: Char = text[pos[0]]
            if (c == '"') {
                pos[0] = pos[0] + 1
                return result
            }
            if (c == '\\') {
                pos[0] = pos[0] + 1
                result = result + escapeChar(text, pos)
            } else {
                result = result + c.toString()
                pos[0] = pos[0] + 1
            }
        }
        return null
    }

    /// 解析一个转义字符。
    private fun escapeChar(text: String, pos: List<Int>): String {
        if (pos[0] >= text.length) {
            return ""
        }
        val e: Char = text[pos[0]]
        pos[0] = pos[0] + 1
        if (e == 'n') {
            return "\n"
        }
        if (e == 't') {
            return "\t"
        }
        if (e == 'r') {
            return "\r"
        }
        if (e == 'b') {
            return "\b"
        }
        if (e == 'f') {
            return "\f"
        }
        if (e == 'u') {
            val code: Int = hex4(text, pos)
            return String.fromCharCode(code)
        }
        return e.toString()
    }

    /// 读取 4 位十六进制数。
    private fun hex4(text: String, pos: List<Int>): Int {
        var value: Int = 0
        var i: Int = 0
        while (i < 4 && pos[0] < text.length) {
            value = value * 16 + hexDigitValue(text[pos[0]])
            pos[0] = pos[0] + 1
            i = i + 1
        }
        return value
    }

    /// 单个十六进制字符的值。
    private fun hexDigitValue(c: Char): Int {
        if (c >= '0' && c <= '9') {
            return c - '0'
        }
        if (c >= 'a' && c <= 'f') {
            return c - 'a' + 10
        }
        if (c >= 'A' && c <= 'F') {
            return c - 'A' + 10
        }
        return 0
    }

    /// 解析 JSON 数字；含 `.` / `e` / `E` 时返回 Float，否则返回 Int。
    private fun parseNumber(text: String, pos: List<Int>): Any {
        val start: Int = pos[0]
        var isFloat: Boolean = false
        if (pos[0] < text.length && (text[pos[0]] == '-' || text[pos[0]] == '+')) {
            pos[0] = pos[0] + 1
        }
        while (pos[0] < text.length) {
            val c: Char = text[pos[0]]
            if (c >= '0' && c <= '9') {
                pos[0] = pos[0] + 1
            } else if (c == '.' || c == 'e' || c == 'E' || c == '-' || c == '+') {
                isFloat = true
                pos[0] = pos[0] + 1
            } else {
                break
            }
        }
        if (pos[0] == start) {
            return null
        }
        val literal: String = text.substring(start, pos[0])
        if (isFloat) {
            return Builtin.parseFloat(literal)
        }
        return Builtin.parseInt(literal)
    }

    /// 跳过空白字符。
    private fun skipWhitespace(text: String, pos: List<Int>): Unit {
        while (pos[0] < text.length) {
            val c: Char = text[pos[0]]
            if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
                pos[0] = pos[0] + 1
            } else {
                return
            }
        }
    }

    /// 判断位置 i 处是否匹配给定字面量。
    private fun matchesWord(text: String, i: Int, word: String): Boolean {
        if (i + word.length > text.length) {
            return false
        }
        return text.substring(i, i + word.length) == word
    }

    // ── 序列化内部实现（纯逻辑，Aura 实现）──

    /// 按缩进层级序列化值。
    private fun stringifyAt(value: Any, pretty: Boolean, depth: Int): String {
        if (value == null) {
            return "null"
        }
        val name: String = typeof(value)
        if (name == "String") {
            return quote(value as String)
        }
        if (name == "Boolean") {
            return if (value as Boolean) "true" else "false"
        }
        if (name == "Int" || name == "Long" || name == "Short" || name == "Byte") {
            return toStr(value)
        }
        if (name == "Float" || name == "Double") {
            return toStr(value)
        }
        if (name == "List" || name == "Array") {
            return stringifyArray(value as List<Any>, pretty, depth)
        }
        if (name == "Map") {
            return stringifyObject(value as Map<Any, Any>, pretty, depth)
        }
        return quote(toStr(value))
    }

    /// 序列化数组。
    private fun stringifyArray(list: List<Any>, pretty: Boolean, depth: Int): String {
        if (list.size == 0) {
            return "[]"
        }
        var result: String = "["
        var i: Int = 0
        while (i < list.size) {
            if (i > 0) {
                result = result + ","
            }
            if (pretty) {
                result = result + "\n" + indent(depth + 1)
            }
            result = result + stringifyAt(list[i], pretty, depth + 1)
            i = i + 1
        }
        if (pretty) {
            result = result + "\n" + indent(depth)
        }
        return result + "]"
    }

    /// 序列化对象。
    private fun stringifyObject(map: Map<Any, Any>, pretty: Boolean, depth: Int): String {
        val allKeys: List<Any> = map.keys
        if (allKeys.size == 0) {
            return "{}"
        }
        var result: String = "{"
        var i: Int = 0
        while (i < allKeys.size) {
            if (i > 0) {
                result = result + ","
            }
            if (pretty) {
                result = result + "\n" + indent(depth + 1)
            }
            val key: Any = allKeys[i]
            result = result + quote(toStr(key)) + (if (pretty) ": " else ":")
            result = result + stringifyAt(map[key], pretty, depth + 1)
            i = i + 1
        }
        if (pretty) {
            result = result + "\n" + indent(depth)
        }
        return result + "}"
    }

    /// 生成缩进。
    private fun indent(depth: Int): String {
        var result: String = ""
        var i: Int = 0
        while (i < depth) {
            result = result + "  "
            i = i + 1
        }
        return result
    }

    /// 把字符串包装为带转义的 JSON 字符串字面量。
    private fun quote(text: String): String {
        var result: String = "\""
        var i: Int = 0
        while (i < text.length) {
            val c: Char = text[i]
            if (c == '"') {
                result = result + "\\\""
            } else if (c == '\\') {
                result = result + "\\\\"
            } else if (c == '\n') {
                result = result + "\\n"
            } else if (c == '\t') {
                result = result + "\\t"
            } else if (c == '\r') {
                result = result + "\\r"
            } else {
                result = result + c.toString()
            }
            i = i + 1
        }
        return result + "\""
    }
}
