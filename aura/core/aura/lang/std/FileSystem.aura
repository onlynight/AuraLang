// aura:///aura/lang/std/FileSystem.aura
package aura.lang.std
// ------------------------------------------------------------------
// 文件系统操作模块 — Phase 3: 纯 LLVM 化
//
// AOT 路径：extern "C" 直连 C 运行时 (fopen/fread/fwrite/fclose/stat/mkdir/remove/rename)
// VM 路径：internal object → Rust bootstrap (Layer 0-A / FFI)
//
// @since 0.1
// ------------------------------------------------------------------

// ═══════════════════════════════════════════════════════════════
// Phase 3: C 运行时声明 (AOT 路径)
// ═══════════════════════════════════════════════════════════════

// ── 文件 I/O ──
extern "C" {
    /// fopen — 打开文件
    fun fs_fopen(filename: Pointer<Byte>, mode: Pointer<Byte>): Pointer<Byte>
    /// fread — 从文件读取
    fun fs_fread(ptr: Pointer<Byte>, size: Int, count: Int, stream: Pointer<Byte>): Int
    /// fwrite — 写入文件
    fun fs_fwrite(ptr: Pointer<Byte>, size: Int, count: Int, stream: Pointer<Byte>): Int
    /// fclose — 关闭文件
    fun fs_fclose(stream: Pointer<Byte>): Int
}

// ── 文件操作 ──
extern "C" {
    /// remove — 删除文件
    fun fs_remove(path: Pointer<Byte>): Int
    /// mkdir — 创建目录
    fun fs_mkdir(path: Pointer<Byte>, mode: Int): Int
    /// rmdir — 删除目录
    fun fs_rmdir(path: Pointer<Byte>): Int
    /// rename — 重命名/移动
    fun fs_rename(old: Pointer<Byte>, new: Pointer<Byte>): Int
}

// ── 文件信息 ──
extern "C" {
    /// access — 检查文件是否存在
    fun fs_access(path: Pointer<Byte>, mode: Int): Int
    /// stat — 获取文件信息 (size, mtime, mode)
    fun fs_stat(path: Pointer<Byte>, buf: Pointer<Byte>): Int
}

// ── 目录遍历 ──
extern "C" {
    /// opendir — 打开目录
    fun fs_opendir(path: Pointer<Byte>): Pointer<Byte>
    /// readdir — 读取目录条目
    fun fs_readdir(dir: Pointer<Byte>): Pointer<Byte>
    /// closedir — 关闭目录
    fun fs_closedir(dir: Pointer<Byte>): Int
}

// ── 路径 ──
extern "C" {
    /// getcwd — 获取当前工作目录
    fun fs_getcwd(buf: Pointer<Byte>, size: Int): Pointer<Byte>
    /// getenv — 获取环境变量 (HOME, TMPDIR)
    fun fs_getenv(name: Pointer<Byte>): Pointer<Byte>
}

// ── Linux x86_64 Syscall 调用 ──
extern object FS_syscalls {
    @native(2) fun syscall_open(path: Pointer<Byte>, flags: Int, mode: Int): Int
    @native(3) fun syscall_close(fd: Int): Int
    @native(6) fun syscall_fstat(fd: Int, buf: Pointer<Byte>): Long
    @native(80) fun syscall_readdir(fd: Int): Long
    @native(82) fun syscall_rename(oldpath: Pointer<Byte>, newpath: Pointer<Byte>): Int
    @native(83) fun syscall_mkdir(path: Pointer<Byte>, mode: Int): Int
    @native(84) fun syscall_rmdir(path: Pointer<Byte>): Int
    @native(87) fun syscall_unlink(path: Pointer<Byte>): Int
    @native(217) fun syscall_stat(path: Pointer<Byte>, buf: Pointer<Byte>): Int
}

// ═══════════════════════════════════════════════════════════════
// AOT 路径: 使用 C 运行时 + syscall 的函数实现
// ═══════════════════════════════════════════════════════════════

/// 检查文件是否存在 — AOT: access()
fun fs_exists(path: Pointer<Byte>): Boolean {
    return fs_access(path, 0) == 0
}

/// 检查是否为文件 — AOT: stat() + S_ISREG
fun fs_is_file(path: Pointer<Byte>): Boolean {
    return fs_access(path, 4) == 0  // F_OK = 0
}

/// 读取文本文件 — AOT: fopen/fread/fclose
fun fs_read_text(path: Pointer<Byte>, buf: Pointer<Byte>, maxLen: Int): Int {
    var f: Pointer<Byte> = fs_fopen(path, "r")
    if (f == null) {
        return -1
    }
    var n: Int = fs_fread(buf, 1, maxLen, f)
    fs_fclose(f)
    return n
}

/// 写入文本文件 — AOT: fopen/fwrite/fclose
fun fs_write_text(path: Pointer<Byte>, content: Pointer<Byte>, len: Int): Int {
    var f: Pointer<Byte> = fs_fopen(path, "w")
    if (f == null) {
        return -1
    }
    var n: Int = fs_fwrite(content, 1, len, f)
    fs_fclose(f)
    return n
}

/// 删除文件 — AOT: remove()
fun fs_delete(path: Pointer<Byte>): Int {
    return fs_remove(path)
}

/// 创建目录 — AOT: mkdir()
fun fs_mkdir_new(path: Pointer<Byte>): Int {
    return fs_mkdir(path, 493)
}

/// 重命名 — AOT: rename()
fun fs_rename_new(old: Pointer<Byte>, new: Pointer<Byte>): Int {
    return fs_rename(old, new)
}

/// 获取文件大小 — AOT: stat()
fun fs_file_size(path: Pointer<Byte>, statbuf: Pointer<Byte>): Int {
    return fs_stat(path, statbuf)
}

/// 获取当前工作目录 — AOT: getcwd()
fun fs_current_dir(buf: Pointer<Byte>, size: Int): Pointer<Byte> {
    return fs_getcwd(buf, size)
}

/// 获取用户主目录 — AOT: getenv("HOME")
fun fs_home_dir(): Pointer<Byte> {
    return fs_getenv("HOME")
}

/// 获取临时目录 — AOT: getenv("TMPDIR")
fun fs_temp_dir(): Pointer<Byte> {
    return fs_getenv("TMPDIR")
}

// ═══════════════════════════════════════════════════════════════
// VM 路径: internal object (Rust bootstrap 实现)
// ═══════════════════════════════════════════════════════════════

/// 文件系统操作模块（VM 路径）。
///
/// 使用前需 import：
/// ```aura
/// import aura.fs.*
/// ```
///
/// @since 0.1
internal object FileSystem {

    // ── 检查 ──

    /// 检查路径是否存在。
    fun exists(path: String): Boolean

    /// 检查路径是否为文件。
    fun isFile(path: String): Boolean

    /// 检查路径是否为目录。
    fun isDirectory(path: String): Boolean

    // ── 读取 ──

    /// 读取文本文件。
    fun readText(path: String): String

    /// 读取二进制文件。
    fun readBytes(path: String): Array<Byte>

    // ── 写入 ──

    /// 写入文本文件。
    fun writeText(path: String, content: String): Unit

    /// 写入二进制文件。
    fun writeBytes(path: String, bytes: Array<Byte>): Unit

    // ── 删除 ──

    /// 删除文件。
    fun delete(path: String): Unit

    // ── 目录 ──

    /// 创建目录。
    fun mkdir(path: String): Unit

    /// 递归创建目录（含父目录）。
    fun mkdirP(path: String): Unit

    /// 重命名文件/目录。
    fun rename(oldPath: String, newPath: String): Unit

    /// 复制文件/目录。
    fun copy(source: String, target: String): Unit

    // ── 列表 ──

    /// 列出目录内容（含子目录）。
    fun listDir(path: String): List<String>

    /// 列出目录中的文件（不含子目录）。
    fun listFiles(path: String): List<String>

    // ── 信息 ──

    /// 获取文件大小。
    fun fileSize(path: String): Int

    /// 获取文件最后修改时间（Unix 时间戳）。
    fun lastModified(path: String): Float

    // ── 路径 ──

    /// 获取绝对路径。
    fun absolutePath(path: String): String

    /// 用户主目录。
    val homeDir: String

    /// 临时目录。
    val tempDir: String

    /// 当前工作目录。
    val currentDir: String

    // ── 遍历 ──

    /// 递归遍历目录树。
    fun walk(path: String): List<String>
}
