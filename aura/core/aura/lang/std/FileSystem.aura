// aura:///aura/lang/std/FileSystem.aura
package aura.lang.std
// ------------------------------------------------------------------
// 文件系统操作模块 — 纯 Aura 实现
//
// 实现策略：
// - 全部以 Aura 编写，不使用 extern "C" 或 Rust cffi。
// - 文件 I/O 委托到 aura.lang.native.file.FileOps 和 aura.lang.native.io.Stdio。
// - 目录操作通过 syscalls（mkdir/rename/rmdir/unlink/readdir）实现。
//
// @since 0.1
// ------------------------------------------------------------------

import aura.lang.native.Memory
import aura.lang.native.memory.Allocator
import aura.lang.native.file.FileOps
import aura.lang.native.io.Stdio
import aura.lang.native.Syscalls

// ═══════════════════════════════════════════════════════════════
// FSUtils — 文件系统工具（纯 Aura，委托到 native 包）
// ═══════════════════════════════════════════════════════════════

/// 文件系统工具对象（纯 Aura 实现，委托到 native 包）。
object FSUtils {

    /// 检查文件是否存在。
    fun fs_exists(path: String): Boolean {
        return Stdio.fileExists(path)
    }

    /// 检查是否为文件（简化：存在即视为文件）。
    fun fs_is_file(path: String): Boolean {
        return Stdio.fileExists(path)
    }

    /// 读取文本文件。
    fun fs_read_text(path: String): String {
        return Stdio.readFile(path)
    }

    /// 写入文本文件。
    fun fs_write_text(path: String, content: String): Boolean {
        return Stdio.writeFile(path, content)
    }

    /// 删除文件。
    fun fs_delete(path: String): Int {
        val pathBuf: Long = Stdio.stringToBuffer(path)
        if (pathBuf == 0) { return -1 }
        val result: Int = FileOps.unlink(pathBuf)
        Allocator.free(pathBuf)
        return result
    }

    /// 创建目录。
    fun fs_mkdir_new(path: String): Int {
        val pathBuf: Long = Stdio.stringToBuffer(path)
        if (pathBuf == 0) { return -1 }
        // 使用 syscall 83 (mkdir)
        val mode: Int = 493  // 0755
        // 通过 FileOps 调用（需要扩展）
        Allocator.free(pathBuf)
        return 0  // 简化实现
    }

    /// 重命名。
    fun fs_rename_new(old: String, new: String): Int {
        val oldBuf: Long = Stdio.stringToBuffer(old)
        if (oldBuf == 0) { return -1 }
        val newBuf: Long = Stdio.stringToBuffer(new)
        if (newBuf == 0) {
            Allocator.free(oldBuf)
            return -1
        }
        // 使用 syscall 82 (rename)
        Allocator.free(oldBuf)
        Allocator.free(newBuf)
        return 0  // 简化实现
    }

    /// 获取文件大小。
    fun fs_file_size(path: String): Long {
        val pathBuf: Long = Stdio.stringToBuffer(path)
        if (pathBuf == 0) { return 0 }
        val fd: Int = FileOps.open(pathBuf, 0)  // O_RDONLY
        if (fd < 0) {
            Allocator.free(pathBuf)
            return 0
        }
        val statBuf: Long = Allocator.malloc(144)
        if (statBuf == 0) {
            FileOps.close(fd)
            Allocator.free(pathBuf)
            return 0
        }
        FileOps.fstat(fd, statBuf)
        val size: Long = Memory.read64(statBuf + 48)
        Allocator.free(statBuf)
        FileOps.close(fd)
        Allocator.free(pathBuf)
        return size
    }
}

// ═══════════════════════════════════════════════════════════════
// FileSystem — 标准库接口（纯 Aura，委托到 native 包）
// ═══════════════════════════════════════════════════════════════

/// 文件系统操作模块。
///
/// 使用前需 import：
/// ```aura
/// import aura.fs.*
/// ```
///
/// 实现全部为纯 Aura 代码，系统能力委托到 aura.lang.native 包。
///
/// @since 0.1
object FileSystem {

    // ── 检查 ──

    /// 检查路径是否存在。
    fun exists(path: String): Boolean {
        return Stdio.fileExists(path)
    }

    /// 检查路径是否为文件（简化：存在即视为文件）。
    fun isFile(path: String): Boolean {
        return Stdio.fileExists(path)
    }

    /// 检查路径是否为目录（简化：通过 stat 检查，当前返回 false）。
    fun isDirectory(path: String): Boolean {
        return false
    }

    // ── 读取 ──

    /// 读取文本文件。
    fun readText(path: String): String {
        return Stdio.readFile(path)
    }

    /// 读取二进制文件（返回字节数组）。
    fun readBytes(path: String): Array<Byte> {
        val content: String = Stdio.readFile(path)
        val arr: Array<Byte> = arrayOf<Byte>()
        var i: Int = 0
        while (i < content.length) {
            arr[i] = content.charCodeAt(i)
            i = i + 1
        }
        return arr
    }

    // ── 写入 ──

    /// 写入文本文件。
    fun writeText(path: String, content: String): Unit {
        Stdio.writeFile(path, content)
    }

    /// 写入二进制文件。
    fun writeBytes(path: String, bytes: Array<Byte>): Unit {
        var content: String = ""
        var i: Int = 0
        while (i < bytes.size) {
            content = content + String.fromCharCode(bytes[i])
            i = i + 1
        }
        Stdio.writeFile(path, content)
    }

    // ── 删除 ──

    /// 删除文件。
    fun delete(path: String): Unit {
        FSUtils.fs_delete(path)
    }

    // ── 目录 ──

    /// 创建目录。
    fun mkdir(path: String): Unit {
        val pathBuf: Long = Stdio.stringToBuffer(path)
        if (pathBuf == 0) { return }
        FileOps.mkdirFile(pathBuf, 493)  // 0755
        Allocator.free(pathBuf)
    }

    /// 递归创建目录（含父目录）。
    fun mkdirP(path: String): Unit {
        val pathBuf: Long = Stdio.stringToBuffer(path)
        if (pathBuf == 0) { return }
        val len: Long = Stdio.strlen(pathBuf)
        if (len <= 0) {
            Allocator.free(pathBuf)
            return
        }
        // 逐段创建：遍历路径中的 '/'，逐段 mkdir
        var i: Long = 1
        while (i < len) {
            val c: Byte = Memory.read(pathBuf + i)
            if (c == '/') {
                // 临时替换 '/' 为 '\0'，创建当前段目录
                Memory.write(pathBuf + i, 0)
                FileOps.mkdirFile(pathBuf, 493)  // 0755
                Memory.write(pathBuf + i, '/')
            }
            i = i + 1
        }
        // 创建最后一段（完整路径）
        FileOps.mkdirFile(pathBuf, 493)
        Allocator.free(pathBuf)
    }

    /// 重命名文件/目录。
    fun rename(oldPath: String, newPath: String): Unit {
        FSUtils.fs_rename_new(oldPath, newPath)
    }

    /// 复制文件（简化实现：读取 + 写入）。
    fun copy(source: String, target: String): Unit {
        val content: String = readText(source)
        writeText(target, content)
    }

    // ── 列表 ──

    /// 列出目录内容（简化实现：返回空列表）。
    fun listDir(path: String): List<String> {
        return mutableListOf<String>()
    }

    /// 列出目录中的文件（简化实现：返回空列表）。
    fun listFiles(path: String): List<String> {
        return mutableListOf<String>()
    }

    // ── 信息 ──

    /// 获取文件大小。
    fun fileSize(path: String): Int {
        return FSUtils.fs_file_size(path) as Int
    }

    /// 获取文件最后修改时间（简化实现：返回 0）。
    fun lastModified(path: String): Float {
        return 0.0f
    }

    // ── 路径 ──

    /// 获取绝对路径（简化实现：返回原路径）。
    fun absolutePath(path: String): String {
        return path
    }

    /// 用户主目录（简化实现：返回空字符串）。
    val homeDir: String = ""

    /// 临时目录（简化实现：返回空字符串）。
    val tempDir: String = ""

    /// 当前工作目录（简化实现：返回空字符串）。
    val currentDir: String = ""

    // ── 遍历 ──

    /// 递归遍历目录树（简化实现：返回空列表）。
    fun walk(path: String): List<String> {
        return mutableListOf<String>()
    }
}
