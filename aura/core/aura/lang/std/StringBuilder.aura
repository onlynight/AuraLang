// aura:///aura/lang/std/StringBuilder.aura
package aura.lang.std
// 标准库模块，不可修改
//
// 原生可变字符串缓冲区（mutable string buffer）。
//
// 实现策略：
// - 全部以 Aura 编写，不使用 extern "C" 或 Rust cffi。
// - 使用 aura.lang.native.Memory 和 aura.lang.native.memory.Allocator 管理缓冲区。
// - 句柄（Long）指向堆内存地址，append 操作就地修改。
//
// 语义：句柄指向同一缓冲区；对同一句柄的 append/appendChar/appendInt
// 会**就地修改**内容（因此是「可变字符串」），length 反映当前长度。
// finish 交出内容后原句柄失效（如需继续使用请 reset）。
//
// 使用前需 import：
// ```aura
// import aura.lang.std.StringBuilder
// ```
//
// @since 0.1

import aura.lang.native.Memory
import aura.lang.native.memory.Allocator

/// 可变字符串缓冲区（纯 Aura 实现）。
object StringBuilder {

    // ═══════════════════════════════════════════════════════════════
    // 常量
    // ═══════════════════════════════════════════════════════════════

    /// 默认初始容量。
    const val DEFAULT_CAPACITY: Long = 64

    /// 增长因子（2 倍）。
    const val GROWTH_FACTOR: Long = 2

    // ═══════════════════════════════════════════════════════════════
    // 内部辅助
    // ═══════════════════════════════════════════════════════════════

    /// 确保缓冲区有足够的剩余空间（至少 extra 字节）。
    /// 返回新句柄（可能重新分配）。
    fun ensureCapacity(handle: Long, extra: Long): Long {
        if (handle == 0) { return 0 }
        val used: Long = Memory.read64(handle + 0)
        val capacity: Long = Memory.read64(handle + 8)
        if (used + extra <= capacity) {
            return handle
        }
        var newCap: Long = capacity * GROWTH_FACTOR
        while (newCap < used + extra) {
            newCap = newCap * GROWTH_FACTOR
        }
        val newHandle: Long = Allocator.malloc(newCap + 16)
        if (newHandle == 0) { return 0 }
        // 复制旧内容
        Memory.copy(newHandle + 16, handle + 16, used)
        // 更新元数据
        Memory.write64(newHandle + 0, used)
        Memory.write64(newHandle + 8, newCap)
        Allocator.free(handle)
        return newHandle
    }

    /// 获取当前使用长度。
    fun getLength(handle: Long): Long {
        if (handle == 0) { return 0 }
        return Memory.read64(handle + 0)
    }

    // ═══════════════════════════════════════════════════════════════
    // 公共 API
    // ═══════════════════════════════════════════════════════════════

    /// 新建缓冲区，返回句柄（0 表示失败）。
    fun create(): Long {
        val handle: Long = Allocator.malloc(DEFAULT_CAPACITY + 16)
        if (handle == 0) { return 0 }
        Memory.write64(handle + 0, 0)  // used = 0
        Memory.write64(handle + 8, DEFAULT_CAPACITY)  // capacity
        Memory.write(handle + 16, 0)  // NUL terminator
        return handle
    }

    /// 追加字符串（返回新句柄，可能重新分配）。
    fun append(handle: Long, text: String): Long {
        if (handle == 0) { return 0 }
        val newHandle: Long = ensureCapacity(handle, text.length + 1)
        if (newHandle == 0) { return 0 }
        val used: Long = Memory.read64(newHandle + 0)
        var i: Int = 0
        while (i < text.length) {
            Memory.write(newHandle + 16 + used + i, text.charCodeAt(i))
            i = i + 1
        }
        val newUsed: Long = used + text.length as Long
        Memory.write(newHandle + 16 + newUsed, 0)  // NUL terminator
        Memory.write64(newHandle + 0, newUsed)
        return newHandle
    }

    /// 追加单字符。
    fun appendChar(handle: Long, ch: Char): Long {
        if (handle == 0) { return 0 }
        val newHandle: Long = ensureCapacity(handle, 2)
        if (newHandle == 0) { return 0 }
        val used: Long = Memory.read64(newHandle + 0)
        Memory.write(newHandle + 16 + used, ch as Int)
        val newUsed: Long = used + 1
        Memory.write(newHandle + 16 + newUsed, 0)
        Memory.write64(newHandle + 0, newUsed)
        return newHandle
    }

    /// 追加十进制整数（不产生中间字符串）。
    fun appendInt(handle: Long, value: Int): Long {
        if (handle == 0) { return 0 }
        // 先转换为字符串
        var text: String = ""
        var v: Int = value
        if (v < 0) {
            text = "-"
            v = 0 - v
        }
        if (v == 0) {
            text = text + "0"
        } else {
            while (v > 0) {
                val digit: Int = v % 10
                text = String.fromCharCode(48 + digit) + text
                v = v / 10
            }
        }
        return append(handle, text)
    }

    /// 当前长度（字节）。
    fun length(handle: Long): Int {
        return getLength(handle) as Int
    }

    /// 结束并交出内容（转移缓冲区所有权）；原句柄失效。
    fun finish(handle: Long): String {
        if (handle == 0) { return "" }
        val used: Long = Memory.read64(handle + 0)
        var result: String = ""
        var i: Long = 0
        while (i < used) {
            val c: Byte = Memory.read(handle + 16 + i)
            result = result + String.fromCharCode(c)
            i = i + 1
        }
        Allocator.free(handle)
        return result
    }

    /// 清空（保留容量），返回句柄。
    fun reset(handle: Long): Long {
        if (handle == 0) { return 0 }
        Memory.write64(handle + 0, 0)  // used = 0
        Memory.write(handle + 16, 0)  // NUL terminator
        return handle
    }
}
