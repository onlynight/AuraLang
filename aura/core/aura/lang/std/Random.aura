// aura:///aura/lang/std/Random.aura
package aura.lang.std

/// 随机数生成器（有状态实例）。
///
/// 使用前需 import：
/// ```aura
/// import aura.lang.std.Random
/// ```
///
/// @since 0.2
/// 说明：构造参数用 **`init(...)` 块**表达（语言既有惯例），而不是
/// `class Random(seed: Long = 0)` —— 后者是「主构造器参数」语法，AST 中没有
/// 这个概念（`ClassDecl.constructors` 才是构造器），写出来会直接报
/// `parse error: Expected Arrow, got LBrace`。
class Random {

    /// 内部状态（XorShift64）。
    private var state: Long = 12345L

    /// 默认种子。
    init() {
        this.state = 12345L
    }

    /// 指定种子；`0` 视为使用默认种子。
    init(seed: Long) {
        if (seed != 0L) {
            this.state = seed
        } else {
            this.state = 12345L
        }
    }
    
    // ── 核心随机数生成（XorShift64）──
    
    fun nextLong(): Long {
        state = state xor (state shl 13)
        state = state xor (state shr 7)
        state = state xor (state shl 17)
        return state
    }
    
    fun nextInt(): Int {
        return (nextLong() as Long) % 2147483647L as Int
    }
    
    fun nextFloat(): Float {
        val v: Int = nextInt()
        return (v and 0x7FFFFFFF) / 2147483647f
    }
    
    fun nextDouble(): Double {
        val v: Long = nextLong()
        return (v and 0x7FFFFFFFFFFFFFFFL) / 9223372036854775807.0
    }
    
    fun nextBool(): Boolean {
        return nextInt() % 2 == 0
    }
    
    // ── 范围随机（纯逻辑）──
    
    fun nextIntRange(min: Int, max: Int): Int {
        if (max <= min) { return min }
        val span: Int = max - min
        val raw: Int = absInt(nextInt())
        return min + raw % span
    }
    
    fun nextLongRange(min: Long, max: Long): Long {
        if (max <= min) { return min }
        val span: Long = max - min
        return min + absLong(nextLong()) % span
    }
    
    fun nextFloatRange(min: Float, max: Float): Float {
        if (max <= min) { return min }
        return min + nextFloat() * (max - min)
    }
    
    fun nextIntBelow(bound: Int): Int {
        return nextIntRange(0, bound)
    }
    
    // ── 概率 ──
    
    fun chance(probability: Float): Boolean {
        if (probability <= 0.0f) { return false }
        if (probability >= 1.0f) { return true }
        return nextFloat() < probability
    }
    
    // ── 集合操作 ──
    
    fun choice(list: List<Any>): Any {
        if (list.size == 0) { return null }
        return list[nextIntRange(0, list.size)]
    }
    
    fun choiceOf(vararg items: Any): Any {
        if (items.size == 0) { return null }
        return items[nextIntRange(0, items.size)]
    }
    
    fun shuffle(list: List<Any>): List<Any> {
        val result: List<Any> = mutableListOf<Any>()
        var i: Int = 0
        while (i < list.size) {
            result.add(list[i])
            i = i + 1
        }
        var j: Int = result.size - 1
        while (j > 0) {
            val k: Int = nextIntRange(0, j + 1)
            val tmp: Any = result[j]
            result[j] = result[k]
            result[k] = tmp
            j = j - 1
        }
        return result
    }
    
    fun sample(list: List<Any>, count: Int): List<Any> {
        val shuffled: List<Any> = shuffle(list)
        if (count >= shuffled.size) { return shuffled }
        val result: List<Any> = mutableListOf<Any>()
        var i: Int = 0
        val limit: Int = if (count > 0) { count } else { 0 }
        while (i < limit) {
            result.add(shuffled[i])
            i = i + 1
        }
        return result
    }
    
    fun nextIndex(list: List<Any>): Int {
        if (list.size == 0) { return -1 }
        return nextIntRange(0, list.size)
    }
    
    // ── 内部工具 ──
    
    private fun absInt(value: Int): Int {
        if (value < 0) { return 0 - value }
        return value
    }
    
    private fun absLong(value: Long): Long {
        if (value < 0L) { return 0L - value }
        return value
    }
}
