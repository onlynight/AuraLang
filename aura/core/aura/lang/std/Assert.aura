// aura:///aura/lang/std/Assert.aura
package aura.lang.std
// 标准库模块，不可修改
// 实现：纯逻辑模块，全部以 Aura 编写（失败时以 Aura 的 throw 抛出字符串）
// (package 声明由编译器自动注入，无需显式声明)
/// 通用断言模块。
///
/// 使用前需 import：
/// ```aura
/// import aura.lang.std.Assert
/// ```
///
/// 断言失败时通过 `throw` 抛出带有说明的文字，由调用方的
/// `try / catch (e: String)` 捕获。与 `aura.lang.std.Test` 的区别：
/// 本模块用于生产代码中的前置/后置条件检查，`Test` 用于测试框架中的断言。
///
/// @see Test
/// @since 0.1
internal object Assert {

    // ── 条件断言（纯逻辑，Aura 实现）──

    /// 通用断言——条件为 true 则通过，否则抛出异常。
    ///
    /// 通过时返回 `"OK: <message>"`。
    fun assert(condition: Any, message: String): String {
        if (toBool(condition)) {
            return "OK: " + message
        }
        throw "Assertion failed: " + message
    }

    /// 断言条件为 true。
    fun assertTrue(condition: Any, message: String): String {
        if (toBool(condition)) {
            return "OK: " + message
        }
        throw "Assertion failed (expected true): " + message
    }

    /// 断言条件为 false。
    fun assertFalse(condition: Any, message: String): String {
        if (!toBool(condition)) {
            return "OK: " + message
        }
        throw "Assertion failed (expected false): " + message
    }

    // ── 相等断言（纯逻辑，Aura 实现）──

    /// 断言两个值相等（按字符串表示比较）。
    fun assertEq(a: Any, b: Any, message: String): String {
        if (toStr(a) == toStr(b)) {
            return "OK: " + message
        }
        throw "Assertion failed (values not equal): " + message + " — got " + toStr(a) + ", expected " + toStr(b)
    }

    /// 断言两个值不相等。
    fun assertNotEq(a: Any, b: Any, message: String): String {
        if (toStr(a) != toStr(b)) {
            return "OK: " + message
        }
        throw "Assertion failed (values are equal): " + message + " — both are " + toStr(a)
    }

    // ── 空值断言（纯逻辑，Aura 实现）──

    /// 断言值不为 null。
    fun assertNotNull(value: Any, message: String): String {
        if (!isNull(value)) {
            return "OK: " + message
        }
        throw "Assertion failed (expected non-null): " + message
    }

    /// 断言值为 null。
    fun assertNull(value: Any, message: String): String {
        if (isNull(value)) {
            return "OK: " + message
        }
        throw "Assertion failed (expected null): " + message + " — got " + toStr(value)
    }

    // ── 数值断言（纯逻辑，Aura 实现）──

    /// 断言 a > b。
    fun assertGt(a: Float, b: Float, message: String): String {
        if (a > b) {
            return "OK: " + message
        }
        throw "Assertion failed (expected " + toStr(a) + " > " + toStr(b) + "): " + message
    }

    /// 断言 a >= b。
    fun assertGte(a: Float, b: Float, message: String): String {
        if (a >= b) {
            return "OK: " + message
        }
        throw "Assertion failed (expected " + toStr(a) + " >= " + toStr(b) + "): " + message
    }

    /// 断言 a < b。
    fun assertLt(a: Float, b: Float, message: String): String {
        if (a < b) {
            return "OK: " + message
        }
        throw "Assertion failed (expected " + toStr(a) + " < " + toStr(b) + "): " + message
    }

    /// 断言 a <= b。
    fun assertLte(a: Float, b: Float, message: String): String {
        if (a <= b) {
            return "OK: " + message
        }
        throw "Assertion failed (expected " + toStr(a) + " <= " + toStr(b) + "): " + message
    }

    /// 断言浮点数近似相等（误差不超过 delta）。
    fun assertApprox(a: Float, b: Float, delta: Float, message: String): String {
        val diff: Float = if (a > b) a - b else b - a
        if (diff <= delta) {
            return "OK: " + message
        }
        throw "Assertion failed (|" + toStr(a) + " - " + toStr(b) + "| > " + toStr(delta) + "): " + message
    }

    // ── 调试断言（纯逻辑，Aura 实现）──

    /// 调试断言（保留 `debugAssert` 名称以兼容旧代码）。
    fun debugAssert(condition: Any, message: String): String {
        return assert(condition, message)
    }
}
