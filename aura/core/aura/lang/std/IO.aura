// aura:///aura/lang/std/IO.aura
// 标准库模块，不可修改
// 实现：syscall 邻近模块。Aura 侧只声明签名，实现位于引导层（Layer 0-A / FFI），
//       因为标准输入输出必须经由操作系统，无法用纯 Aura 表达
// (package 声明由编译器自动注入，无需显式声明)
/// 标准输入输出模块。
///
/// 使用前需 import：
/// ```aura
/// import aura.io.*
/// ```
///
/// 架构说明：
/// - Layer 2（C FFI）：当前通过 Rust native 实现
/// - 未来：通过 `extern "c" "libc"` 直连 printf/fgets/fread 等 syscall
///
/// @since 0.1
internal object IO {

    // ── 输出（通过 libc printf/puts 实现）──

    /// 输出字符串（带换行）。
    /// 未来实现：`extern "c" "libc" fun printf(format: String, ...): Int`
    fun println(msg: String): Unit

    /// 输出字符串（不带换行）。
    fun print(msg: String): Unit

    // ── 输入（通过 libc fgets/fread 实现）──

    /// 从标准输入读取一行。
    /// 未来实现：`extern "c" "libc" fun fgets(buf: Pointer, size: Int, stream: Pointer): Pointer`
    val readLine: String

    /// 从标准输入读取全部。
    val readAll: String

    // ── 刷新 ──

    /// 刷新标准输出缓冲区。
    fun flush(): Unit

    // ── 文件操作（通过 libc fopen/fread/fwrite 实现）──

    /// 读取文件内容。
    fun fileRead(path: String): String

    /// 写入文件内容。
    fun fileWrite(path: String, content: String): Unit

    /// 检查文件是否存在。
    fun fileExists(path: String): Boolean

    /// 写入文件（fileWrite 别名）。
    fun writeFile(path: String, content: String): Unit

    /// 读取文件（fileRead 别名）。
    fun readFile(path: String): String
}