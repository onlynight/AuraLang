// aura:///aura/lang/std/IO.aura
package aura.lang.std
// ------------------------------------------------------------------
// 标准输入输出模块 — 纯 Aura 实现
//
// 本模块仅负责 stdin/stdout 转发，不做文件操作。
// 文件操作请使用 `File` 或 `Files`。
//
// 使用前需 import：
// ```aura
// import aura.lang.std.IO
// ```
//
// @since 0.1
// ------------------------------------------------------------------

import aura.lang.std.io.StreamImpl

/// 标准输入输出模块。
///
/// 本模块仅负责 stdin/stdout 转发。
/// 文件操作请使用 `File` 或 `Files`。
///
/// ```aura
/// IO.println("Hello")
/// IO.print("World")
/// val line: String = IO.readLine()
/// ```
///
/// @since 0.1
object IO {

    // ── 输出 ──

    /// 输出字符串（带换行）。
    fun println(msg: String): Unit {
        StreamImpl.defaultStdout().println(msg)
    }

    /// 输出字符串（不带换行）。
    fun print(msg: String): Unit {
        StreamImpl.defaultStdout().print(msg)
    }

    // ── 输入 ──

    /// 从标准输入读取一行。
    fun readLine(): String {
        return StreamImpl.defaultStdin().readLine()
    }

    /// 从标准输入读取全部。
    fun readAll(): String {
        return StreamImpl.defaultStdin().readAll()
    }

    // ── 刷新 ──

    /// 刷新标准输出缓冲区。
    fun flush(): Unit {
        StreamImpl.defaultStdout().flush()
    }
}
