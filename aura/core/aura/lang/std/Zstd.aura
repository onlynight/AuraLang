// aura:///aura/lang/std/Zstd.aura
package aura.lang.std
// ------------------------------------------------------------------
// Zstd 压缩/解压 — 纯 Aura 接口
//
// 注意：Zstd 是性能敏感组件，其完整的 zstd 格式压缩/解压无法在纯 Aura
// 中高效实现（需要复杂的 Huffman 编码、LZ 匹配等算法）。
//
// 当前实现：
// - 提供纯 Aura 接口（无 extern "C" 或 Rust cffi）。
// - 压缩/解压函数返回空字符串（表示不支持），ZstdUtils 会报告失败。
// - 如需实际 zstd 支持，请在 native 包中添加 @native(N) 系统调用封装
//   或提供独立的 native 实现。
//
// @since 0.3
// ------------------------------------------------------------------

import aura.lang.std.String
import aura.lang.std.IO

// ═══════════════════════════════════════════════════════════════
// Zstd 压缩/解压接口（纯 Aura 存根）
// ═══════════════════════════════════════════════════════════════

/// 压缩数据（level 1-22，默认 3）。
/// 纯 Aura 存根：返回空字符串表示不支持。
fun zstd_compress(data: String, level: Int): String {
    return ""
}

/// 解压数据。
/// 纯 Aura 存根：返回空字符串表示不支持。
fun zstd_decompress(data: String): String {
    return ""
}

/// 压缩数据（便捷函数，默认 level 3）。
fun zstd_compress_default(data: String): String {
    return zstd_compress(data, 3)
}

/// 获取压缩后数据大小（估算）。
fun zstd_estimate_size(data: String, level: Int): Int {
    return data.length
}

/// 获取解压后数据大小（从压缩数据）。
fun zstd_decompressed_size(data: String): Int {
    return 0
}

/// 检查是否为有效的 Zstd 数据。
fun zstd_is_valid(data: String): Boolean {
    return false
}

// ═══════════════════════════════════════════════════════════════
// Zstd 配置与结果
// ═══════════════════════════════════════════════════════════════

/// Zstd 压缩配置。
class ZstdConfig {
    /// 压缩级别（1-22）。
    var level: Int = ZstdUtils.ZSTD_LEVEL_DEFAULT

    fun ZstdConfig() {
    }

    fun ZstdConfig(level: Int) {
        if (level < ZstdUtils.ZSTD_LEVEL_MIN) {
            this.level = ZstdUtils.ZSTD_LEVEL_MIN
        }
        if (level > ZstdUtils.ZSTD_LEVEL_MAX) {
            this.level = ZstdUtils.ZSTD_LEVEL_MAX
        }
        this.level = level
    }

    /// 使用默认配置。
    fun default(): ZstdConfig {
        return ZstdConfig(ZstdUtils.ZSTD_LEVEL_DEFAULT)
    }
}

/// 压缩结果。
class ZstdResult {
    /// 压缩后的数据。
    var data: String = ""

    /// 原始数据大小。
    var originalSize: Int = 0

    /// 压缩后大小。
    var compressedSize: Int = 0

    /// 是否成功。
    var success: Boolean = false

    /// 错误信息。
    var error: String = ""

    fun ZstdResult() {
    }

    /// 压缩率。
    fun ratio(): Double {
        if (originalSize == 0) {
            return 0.0
        }
        return (compressedSize as Double) / (originalSize as Double)
    }

    /// 压缩节省的字节数。
    fun savedBytes(): Int {
        return originalSize - compressedSize
    }
}

// ═══════════════════════════════════════════════════════════════
// Zstd 工具
// ═══════════════════════════════════════════════════════════════

/// Zstd 压缩/解压工具。
object ZstdUtils {
    /// Zstd 魔数（4 字节：0x28 0xB5 0x2F 0xFD）。
    val ZSTD_MAGIC: String = String.fromCharCode(0x28) + String.fromCharCode(0xB5) + String.fromCharCode(0x2F) + String.fromCharCode(0xFD)

    /// 默认压缩级别。
    const val ZSTD_LEVEL_DEFAULT: Int = 3

    /// 最低压缩级别。
    const val ZSTD_LEVEL_MIN: Int = 1

    /// 最高压缩级别。
    const val ZSTD_LEVEL_MAX: Int = 22

    /// 压缩字符串数据（指定级别）。
    fun zstdCompressWithLevel(data: String, level: Int): ZstdResult {
        val result = ZstdResult()
        result.originalSize = data.length

        if (data == "") {
            result.success = false
            result.error = "empty input"
            return result
        }

        // 调用压缩（纯 Aura 存根返回空）
        val compressed: String = zstd_compress(data, level)

        if (compressed == "") {
            result.success = false
            result.error = "compression not supported in pure Aura mode"
            return result
        }

        result.data = compressed
        result.compressedSize = compressed.length
        result.success = true
        return result
    }

    /// 解压字符串数据。
    fun zstdDecompress(data: String): ZstdResult {
        val result = ZstdResult()

        if (data == "") {
            result.success = false
            result.error = "empty input"
            return result
        }

        // 检查魔数
        if (!zstdIsMagic(data)) {
            result.success = false
            result.error = "invalid zstd magic"
            return result
        }

        // 调用解压（纯 Aura 存根返回空）
        val decompressed: String = zstd_decompress(data)

        if (decompressed == "") {
            result.success = false
            result.error = "decompression not supported in pure Aura mode"
            return result
        }

        result.data = decompressed
        result.originalSize = decompressed.length
        result.compressedSize = data.length
        result.success = true
        return result
    }

    /// 压缩文件（指定级别）。
    fun zstdCompressFileWithLevel(inputPath: String, outputPath: String, level: Int): Boolean {
        val data: String = IO.readFile(inputPath)
        if (data == "") {
            return false
        }

        val result: ZstdResult = zstdCompressWithLevel(data, level)
        if (!result.success) {
            return false
        }

        IO.writeFile(outputPath, result.data)
        return true
    }

    /// 解压文件。
    fun zstdDecompressFile(inputPath: String, outputPath: String): Boolean {
        val data: String = IO.readFile(inputPath)
        if (data == "") {
            return false
        }

        val result: ZstdResult = zstdDecompress(data)
        if (!result.success) {
            return false
        }

        IO.writeFile(outputPath, result.data)
        return true
    }

    /// 检查数据是否为有效的 Zstd 格式（检查魔数）。
    fun zstdIsMagic(data: String): Boolean {
        if (data.length < 4) {
            return false
        }

        val b0: Int = data.charCodeAt(0)
        val b1: Int = data.charCodeAt(1)
        val b2: Int = data.charCodeAt(2)
        val b3: Int = data.charCodeAt(3)

        return b0 == 0x28 && b1 == 0xB5 && b2 == 0x2F && b3 == 0xFD
    }

    /// 获取压缩后数据大小（估算，指定级别）。
    fun zstdEstimateSizeWithLevel(data: String, level: Int): Int {
        if (data == "") {
            return 0
        }
        return zstd_estimate_size(data, level)
    }

    /// 获取解压后数据大小。
    fun zstdDecompressedSize(data: String): Int {
        if (data == "" || !zstdIsMagic(data)) {
            return 0
        }
        return zstd_decompressed_size(data)
    }

    /// 检查是否为有效的 Zstd 数据。
    fun zstdIsValid(data: String): Boolean {
        return zstd_is_valid(data)
    }

    /// 压缩（便捷函数）。
    fun zstdCompressFast(data: String): String {
        val result: ZstdResult = zstdCompressWithLevel(data, ZSTD_LEVEL_DEFAULT)
        if (result.success) {
            return result.data
        }
        return ""
    }

    /// 解压（便捷函数）。
    fun zstdDecompressFast(data: String): String {
        val result: ZstdResult = zstdDecompress(data)
        if (result.success) {
            return result.data
        }
        return ""
    }

    /// 压缩文件到 .zst。
    fun zstdPackFile(inputPath: String): String {
        val outputPath: String = inputPath + ".zst"
        if (zstdCompressFileWithLevel(inputPath, outputPath, ZSTD_LEVEL_DEFAULT)) {
            return outputPath
        }
        return ""
    }

    /// 解压 .zst 文件。
    fun zstdUnpackFile(inputPath: String): String {
        if (inputPath.endsWith(".zst")) {
            val outputPath: String = inputPath.substring(0, inputPath.length - 4)
            if (zstdDecompressFile(inputPath, outputPath)) {
                return outputPath
            }
        }
        return ""
    }
}
