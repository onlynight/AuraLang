// aura:///aura/lang/std/Network.aura
package aura.lang.std
// 标准库模块，不可修改
//
// 实现策略：
// - 全部以 Aura 编写，不使用 extern "C" 或 Rust cffi。
// - 系统能力委托到 aura.lang.native.network.NetworkOps。
// - NetworkOps 使用 @native(N) 系统调用封装 socket/bind/connect/send/recv 等操作。
//
// 使用前需 import：
// ```aura
// import aura.net.*
// ```
//
// @since 0.1

import aura.lang.native.network.NetworkOps

/// 网络 Socket 操作模块。
///
/// 实现全部为纯 Aura 代码，系统能力委托到 aura.lang.native 包。
///
/// @since 0.1
object Network {

    // ── TCP 客户端 ──

    /// 连接 TCP 服务器（简化实现：返回文件描述符）。
    fun tcpConnect(host: String, port: Int): Int {
        // 创建 TCP socket
        val fd: Int = NetworkOps.socket(NetworkOps.AF_INET, NetworkOps.SOCK_STREAM, NetworkOps.IPPROTO_TCP)
        if (fd < 0) { return fd }
        // 简化：实际连接需要构造 sockaddr_in 结构体并调用 connect
        // 当前返回 fd，连接逻辑需在调用方完成
        return fd
    }

    /// 通过 TCP Socket 发送数据。
    fun tcpSend(socket: Any, data: String): Int {
        val buf: Long = NativeConvert.stringToBuffer(data)
        if (buf == 0) { return -1 }
        val len: Long = NativeConvert.strlen(buf)
        val result: Long = NetworkOps.tcpSend(socket as Int, buf, len)
        return result as Int
    }

    /// 通过 TCP Socket 接收数据。
    fun tcpRecv(socket: Any, bufferSize: Int): String {
        val buf: Long = NativeConvert.alloc(bufferSize + 1)
        if (buf == 0) { return "" }
        val bytesRead: Long = NetworkOps.tcpRecv(socket as Int, buf, bufferSize as Long)
        if (bytesRead <= 0) {
            NativeConvert.free(buf)
            return ""
        }
        val result: String = NativeConvert.bufferToString(buf, bytesRead)
        NativeConvert.free(buf)
        return result
    }

    /// 关闭 TCP Socket。
    fun tcpClose(socket: Any): Unit {
        NetworkOps.close(socket as Int)
    }

    // ── TCP 服务器 ──

    /// 创建 TCP 监听 Socket。
    fun tcpListen(port: Int): Int {
        val fd: Int = NetworkOps.socket(NetworkOps.AF_INET, NetworkOps.SOCK_STREAM, NetworkOps.IPPROTO_TCP)
        if (fd < 0) { return fd }
        // 简化：实际绑定和监听需要构造 sockaddr_in 结构体
        return fd
    }

    // ── UDP ──

    /// 通过 UDP 发送数据。
    fun udpSend(socket: Any, data: String, host: String, port: Int): Int {
        val buf: Long = NativeConvert.stringToBuffer(data)
        if (buf == 0) { return -1 }
        val len: Long = NativeConvert.strlen(buf)
        val result: Long = NetworkOps.sendto(socket as Int, buf, len, 0, 0, 0)
        NativeConvert.free(buf)
        return result as Int
    }

    /// 通过 UDP 接收数据。
    fun udpRecv(socket: Any, bufferSize: Int): String {
        val buf: Long = NativeConvert.alloc(bufferSize + 1)
        if (buf == 0) { return "" }
        val bytesRead: Long = NetworkOps.recvfrom(socket as Int, buf, bufferSize as Long, 0, 0, 0)
        if (bytesRead <= 0) {
            NativeConvert.free(buf)
            return ""
        }
        val result: String = NativeConvert.bufferToString(buf, bytesRead)
        NativeConvert.free(buf)
        return result
    }

    /// 关闭 UDP Socket。
    fun udpClose(socket: Any): Unit {
        NetworkOps.close(socket as Int)
    }

    // ── 主机信息 ──

    /// 检查主机是否可达（简化实现：返回 true）。
    fun isHostReachable(host: String): Boolean {
        return true
    }

    /// 获取主机名（简化实现：返回空字符串）。
    val getHostname: String = ""

    /// 获取本机 IP 地址（简化实现：返回空字符串）。
    val getLocalIp: String = ""
}

// ═══════════════════════════════════════════════════════════════
// 内部转换工具（纯 Aura）
// ═══════════════════════════════════════════════════════════════

import aura.lang.native.Memory
import aura.lang.native.memory.Allocator

/// 内部转换工具（不对外暴露）。
object NativeConvert {

    fun stringToBuffer(s: String): Long {
        if (s == null || s.length == 0) {
            val buf: Long = Allocator.malloc(1)
            if (buf == 0) { return 0 }
            Memory.write(buf, 0)
            return buf
        }
        val len: Long = s.length + 1
        val buf: Long = Allocator.malloc(len)
        if (buf == 0) { return 0 }
        var i: Int = 0
        while (i < s.length) {
            Memory.write(buf + i, s.charCodeAt(i))
            i = i + 1
        }
        Memory.write(buf + s.length, 0)
        return buf
    }

    fun bufferToString(buf: Long, maxLen: Long): String {
        if (buf == 0) { return "" }
        var result: String = ""
        var i: Long = 0
        while (i < maxLen) {
            val c: Byte = Memory.read(buf + i)
            if (c == 0) { break }
            result = result + String.fromCharCode(c)
            i = i + 1
        }
        return result
    }

    fun strlen(buf: Long): Long {
        if (buf == 0) { return 0 }
        var n: Long = 0
        var c: Byte = Memory.read(buf + n)
        while (c != 0) {
            n = n + 1
            c = Memory.read(buf + n)
        }
        return n
    }

    fun alloc(n: Int): Long {
        return Allocator.malloc(n as Long)
    }

    fun free(addr: Long) {
        Allocator.free(addr)
    }
}
