// aura:///aura/lang/Boolean.aura
// 语言内置类型，不可修改

/// 布尔类型，只有 `true` 和 `false` 两个值。
///
/// - 存储：VM 中内联存储为 bool（`Value::Bool`）
/// - 字面量：`true` / `false`（关键字）
///
/// @see Int, String
/// @since 0.1
internal value class Boolean {

    // ── 常量（companion object）──

    companion object {
        /// true 字面量
        const TRUE: Boolean = true

        /// false 字面量
        const FALSE: Boolean = false
    }

    // ── 转换方法 ──

    /// 转换为字符串表示（"true" / "false"）
    override fun toString(): String {
        if (this) return "true"
        return "false"
    }

    /// 转换为整数（true → 1, false → 0）
    fun toInt(): Int {
        if (this) return 1
        return 0
    }

    // ── 逻辑方法 ──

    /// 逻辑非
    fun not(): Boolean {
        if (this) return false
        return true
    }

    /// 与
    fun and(other: Boolean): Boolean {
        if (this and other) return true
        return false
    }

    /// 或
    fun or(other: Boolean): Boolean {
        if (this or other) return true
        return false
    }

    /// 异或
    fun xor(other: Boolean): Boolean {
        if (this and not(other)) return true
        if (not(this) and other) return true
        return false
    }
}
