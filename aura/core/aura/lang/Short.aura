// aura:///aura/lang/Short.aura
package aura.lang
// 语言内置类型，不可修改

/// 16 位有符号短整型。
///
/// - 范围：-32,768 到 32,767
/// - 存储：VM 中内联存储为 i64（`Value::Int`）
///
/// @see Int, Long, Byte
/// @since 0.1
internal value class Short {

    // ── 常量（companion object）──

    companion object {
        /// 16 位短整型最小值
        const MIN_VALUE: Short = -32768

        /// 16 位短整型最大值
        const MAX_VALUE: Short = 32767

        /// 位宽（16 位）
        const BITS: Int = 16

        /// 从字符串解析为短整型
        fun parseInt(text: String): Short {
            var result: Int = 0
            var sign: Int = 1
            var i: Int = 0
            if (i < text.length && text[i] == '-') {
                sign = -1
                i = i + 1
            } else if (i < text.length && text[i] == '+') {
                i = i + 1
            }
            while (i < text.length) {
                val c = text[i]
                if (c >= '0' && c <= '9') {
                    result = result * 10 + (c - '0')
                }
                i = i + 1
            }
            return (result * sign) as Short
        }
    }

    // ── 转换方法 ──

    /// 转换为 32 位整数
    fun toInt(): Int {
        return this as Int
    }

    /// 转换为 64 位长整数
    fun toLong(): Long {
        return this as Long
    }

    /// 转换为 32 位浮点数
    fun toFloat(): Float {
        return this as Float
    }

    /// 转换为字符串表示
    override fun toString(): String {
        return toStr(this)
    }

    // ── 比较方法 ──

    /// 比较两个短整型，返回 -1/0/1
    fun compareTo(other: Short): Int {
        if (this < other) return -1
        if (this > other) return 1
        return 0
    }

    /// 检查两个短整型是否相等
    override fun equals(other: Short): Boolean {
        return this == other
    }

    // ── 算术方法 ──

    /// 绝对值
    fun abs(): Short {
        if (this < 0) return -this
        return this
    }

    /// 取余
    fun mod(other: Short): Short {
        return this % other
    }
}
