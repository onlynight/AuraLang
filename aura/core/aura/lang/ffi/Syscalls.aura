// aura:///aura/lang/ffi/Syscalls.aura
package aura.lang.ffi
// ─────────────────────────────────────────────────────────────
// 系统调用声明 — Phase S1
//
// x86_64 Linux 系统调用（syscall 号来自 arch/x86/entry/syscalls_64.tbl）
//
// 使用 extern object 封装，@native(N) 标注 syscall 号。
//
// ── 常量命名约定 ──
//   SYS_*     : 系统调用号
//   O_*       : open() 文件访问模式
//   PROT_*    : mmap() 内存保护标志
//   MAP_*     : mmap() 映射类型标志
//   SEEK_*    : lseek() 位置偏移基准
//   CLOCK_*   : clock_gettime() 时钟源
//   WNOHANG   : wait4() 非阻塞标志
// ─────────────────────────────────────────────────────────────

// ═══════════════════════════════════════════════════════════════
// 系统调用号（x86_64 Linux）
// ═══════════════════════════════════════════════════════════════

val SYS_READ: Int = 0
val SYS_WRITE: Int = 1
val SYS_OPEN: Int = 2
val SYS_CLOSE: Int = 3
val SYS_FSTAT: Int = 5
val SYS_LSEEK: Int = 6
val SYS_MMAP: Int = 9
val SYS_MUNMAP: Int = 10
val SYS_ACCESS: Int = 21
val SYS_UNLINK: Int = 39
val SYS_EXECVE: Int = 59
val SYS_EXIT_GROUP: Int = 60
val SYS_WAIT4: Int = 61
val SYS_CLOCK_GETTIME: Int = 228
val SYS_GETRANDOM: Int = 272

// ═══════════════════════════════════════════════════════════════
// 文件描述符常量
// ═══════════════════════════════════════════════════════════════

val STDIN: Int = 0
val STDOUT: Int = 1
val STDERR: Int = 2

// ═══════════════════════════════════════════════════════════════
// open() 文件访问模式
// ═══════════════════════════════════════════════════════════════

val O_RDONLY: Int = 0x0000
val O_WRONLY: Int = 0x0001
val O_RDWR: Int = 0x0002
val O_CREAT: Int = 0x0040
val O_EXCL: Int = 0x0080
val O_TRUNC: Int = 0x0200

// ═══════════════════════════════════════════════════════════════
// access() 权限检查标志
// ═══════════════════════════════════════════════════════════════

val F_OK: Int = 0
val W_OK: Int = 2
val R_OK: Int = 4
val X_OK: Int = 1

// ═══════════════════════════════════════════════════════════════
// mmap() 内存保护标志
// ═══════════════════════════════════════════════════════════════

val PROT_NONE: Int = 0x0
val PROT_READ: Int = 0x1
val PROT_WRITE: Int = 0x2
val PROT_EXEC: Int = 0x4

// ═══════════════════════════════════════════════════════════════
// mmap() 映射类型标志
// ═══════════════════════════════════════════════════════════════

val MAP_SHARED: Int = 0x01
val MAP_PRIVATE: Int = 0x02
val MAP_ANONYMOUS: Int = 0x20
val MAP_ANON: Int = MAP_ANONYMOUS

// ═══════════════════════════════════════════════════════════════
// lseek() 位置偏移基准
// ═══════════════════════════════════════════════════════════════

val SEEK_SET: Int = 0
val SEEK_CUR: Int = 1
val SEEK_END: Int = 2

// ═══════════════════════════════════════════════════════════════
// clock_gettime() 时钟源
// ═══════════════════════════════════════════════════════════════

val CLOCK_REALTIME: Int = 0
val CLOCK_MONOTONIC: Int = 1
val CLOCK_PROCESS_CPUTIME_ID: Int = 2
val CLOCK_THREAD_CPUTIME_ID: Int = 3
val CLOCK_MONOTONIC_RAW: Int = 4

// ═══════════════════════════════════════════════════════════════
// wait4() 选项标志
// ═══════════════════════════════════════════════════════════════

val WNOHANG: Int = 0x00000001
val WUNTRACED: Int = 0x00000002

// ═══════════════════════════════════════════════════════════════
// 特殊值
// ═══════════════════════════════════════════════════════════════

val INVALID_FD: Int = -1
val MAP_FAILED: Long = -1

// ═══════════════════════════════════════════════════════════════
// 系统调用声明
// ═══════════════════════════════════════════════════════════════

extern object Syscalls {
    @native(SYS_READ)          fun read(fd: Int, buf: Long, count: Long): Long
    @native(SYS_WRITE)         fun write(fd: Int, buf: Long, count: Long): Long
    @native(SYS_OPEN)          fun open(path: CString, flags: Int): Int
    @native(SYS_CLOSE)         fun close(fd: Int): Int
    @native(SYS_FSTAT)         fun fstat(fd: Int, buf: Long): Long
    @native(SYS_LSEEK)         fun lseek(fd: Int, off: Long, whence: Int): Long
    @native(SYS_MMAP)          fun mmap(addr: Long, len: Long, prot: Int, flags: Int, fd: Int, off: Long): Long
    @native(SYS_MUNMAP)        fun munmap(addr: Long, len: Long): Long
    @native(SYS_ACCESS)        fun access(path: CString, mode: Int): Int
    @native(SYS_UNLINK)        fun unlink(path: CString): Int
    @native(SYS_EXECVE)        fun execve(path: CString, args: Long, env: Long): Long
    @native(SYS_EXIT_GROUP)    fun exitGroup(code: Int)
    @native(SYS_WAIT4)         fun wait4(pid: Int, status: Long, options: Int, rusage: Long): Int
    @native(SYS_CLOCK_GETTIME) fun clockGettime(clock: Int, ts: Long): Long
    @native(SYS_GETRANDOM)     fun getrandom(buf: Long, len: Long, flags: Int): Long
}
