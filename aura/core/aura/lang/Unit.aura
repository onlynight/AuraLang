// aura:///aura/lang/Unit.aura
package aura.lang
// 语言内置类型，不可修改

/// 无返回值类型——表示函数不返回有意义的值。
///
/// Unit 等价于 Java 的 `void`、Python 的 `None`。
/// 函数返回 Unit 时可省略返回类型声明：
/// ```aura
/// fun hello(): Unit = println("hello")
/// fun hello() = println("hello")  // 等价，返回类型推断为 Unit
/// ```
///
/// Unit 是单例值类型——只有一个实例 `Unit`。
///
/// @see Nothing, Any
/// @since 0.1
internal value class Unit {

    // ── 常量（companion object）──

    companion object {
        /// Unit 单例实例
        const INSTANCE: Unit = Unit()
    }

    // ── 构造 ──

    /// 构造 Unit 实例（通常直接使用 `Unit.INSTANCE`）
    constructor() {
        return Unit.INSTANCE
    }

    // ── 方法（重写 Any 基类方法）──

    /// 返回 Unit 的可读表示
    override fun toString(): String {
        return "Unit"
    }

    /// Unit 实例之间始终相等
    override fun equals(other: Any): Boolean {
        return other is Unit
    }

    /// Unit 的哈希码（固定值）
    override fun hashCode(): Int {
        return 0
    }
}
