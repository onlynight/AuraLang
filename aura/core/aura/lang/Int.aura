// aura:///aura/lang/Int.aura
package aura.lang
// 语言内置类型，不可修改

/// 32 位有符号整数类型。
///
/// - 范围：-2,147,483,648 到 2,147,483,647
/// - 存储：VM 中内联存储为 i64（`Value::Int`），AOT 中映射为 `i32`
/// - 性能：零开销，无堆分配，无 ARC 引用计数
///
/// 基本类型不参与 Any 类层级。
/// 使用 `is Int` 通过 Value tag 匹配判断。
///
/// @see Any, Long, Float, Double
/// @since 0.1
internal value class Int {

    // ── 常量（companion object）──

    companion object {
        /// 32 位整数最小值
        const val MIN_VALUE: Int = -2147483648

        /// 32 位整数最大值
        const val MAX_VALUE: Int = 2147483647

        /// 位宽（32 位）
        const val BITS: Int = 32

        /// 字节大小（4 字节）
        const val SIZE: Int = 32

        /// 64 位长整数最小值
        const val MIN_LONG: Long = -9223372036854775808L

        /// 64 位长整数最大值
        const val MAX_LONG: Long = 9223372036854775807L

        /// 从字符串解析为整数
        fun parseInt(text: String): Int {
            var result: Int = 0
            var sign: Int = 1
            var i: Int = 0
            if (i < text.length and text[i] == '-') {
                sign = -1
                i = i + 1
            } else if (i < text.length and text[i] == '+') {
                i = i + 1
            }
            while (i < text.length) {
                val c = text[i]
                if (c >= '0' and c <= '9') {
                    result = result * 10 + (c - '0')
                }
                i = i + 1
            }
            return result * sign
        }
    }

    // ── 转换方法 ──

    /// 转换为 64 位长整数
    fun toLong(): Long {
        return this as Long
    }

    /// 转换为 32 位浮点数
    fun toFloat(): Float {
        return this as Float
    }

    /// 转换为 64 位双精度浮点数
    fun toDouble(): Double {
        return this as Double
    }

    /// 转换为字符串表示
    override fun toString(): String {
        return toStr(this)
    }

    /// 转换为布尔值（非零为 true）
    fun toBoolean(): Boolean {
        return this != 0
    }

    /// 转换为字符（取最低 16 位）
    fun toChar(): Char {
        return (this and 0xFFFF) as Char
    }

    /// 转换为字节（取最低 8 位）
    fun toByte(): Byte {
        return (this and 0xFF) as Byte
    }

    /// 转换为短整型（取最低 16 位）
    fun toShort(): Short {
        return (this and 0xFFFF) as Short
    }

    // ── 比较方法 ──

    /// 比较两个整数，返回 -1/0/1
    fun compareTo(other: Int): Int {
        if (this < other) return -1
        if (this > other) return 1
        return 0
    }

    /// 检查两个整数是否相等
    override fun equals(other: Int): Boolean {
        return this == other
    }

    // ── 算术方法 ──

    /// 绝对值
    fun abs(): Int {
        if (this < 0) return -this
        return this
    }

    /// 返回两个整数中的最大值
    fun max(other: Int): Int {
        if (this > other) return this
        return other
    }

    /// 返回两个整数中的最小值
    fun min(other: Int): Int {
        if (this < other) return this
        return other
    }

    /// 取余
    fun mod(other: Int): Int {
        return this % other
    }

    // ── 位操作方法 ──

    /// 按位与
    fun and(other: Int): Int {
        return this & other
    }

    /// 按位或
    fun or(other: Int): Int {
        return this | other
    }

    /// 按位异或
    fun xor(other: Int): Int {
        return this ^ other
    }

    /// 左移
    fun shl(bits: Int): Int {
        return this << bits
    }

    /// 右移（算术右移，保留符号位）
    fun shr(bits: Int): Int {
        return this >> bits
    }

    /// 无符号右移
    fun ushr(bits: Int): Int {
        return (this as Int) >>> bits
    }

    // ── 数学方法 ──

    /// 计算幂
    fun pow(exp: Int): Int {
        var result: Int = 1
        var base: Int = this
        var e: Int = if (exp < 0) -exp else exp
        while (e > 0) {
            if (e % 2 == 1) {
                result = result * base
            }
            base = base * base
            e = e / 2
        }
        if (exp < 0) {
            return 0  // 负指数返回 0（整数幂）
        }
        return result
    }

    /// 转换为字符串（指定基数）
    fun toRadixString(radix: Int): String {
        if (radix < 2 or radix > 36) return ""
        var value = this
        if (value == 0) return "0"
        var result: String = ""
        var negative = value < 0
        if (negative) {
            value = -value
        }
        while (value > 0) {
            var digit = value % radix
            val c = if (digit < 10) ('0' + digit) else ('a' + (digit - 10))
            result = c + result
            value = value / radix
        }
        if (negative) {
            result = "-" + result
        }
        return result
    }
}
