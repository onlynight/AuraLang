// aura:///aura/lang/errors/IOException.aura
package aura.lang.errors

/// IO 异常基类
open class IOException : Exception() {
    var _phantom: Int = 0
    constructor(message: String) : super(message) { }
    constructor(message: String, cause: Throwable?) : super(message, cause) { }
}

/// 文件未找到异常
open class FileNotFoundException : IOException() {
    /// 文件路径
    var path: String = ""

    constructor(message: String) : super(message) { }
    constructor(message: String, cause: Throwable?) : super(message, cause) { }
    constructor(message: String, path: String) : super(message) {
        this.path = path
    }
}

/// 超时异常
open class TimeoutException : IOException() {
    var _phantom: Int = 0
    constructor(message: String) : super(message) { }
    constructor(message: String, cause: Throwable?) : super(message, cause) { }
}
