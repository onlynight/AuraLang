// aura:///aura/lang/errors/Error.aura
package aura.lang.errors

/// 系统级错误——程序无法恢复，通常不捕获
open class Error : Throwable() {
    var _phantom: Int = 0
    constructor(message: String) : super(message) { }
    constructor(message: String, cause: Throwable?) : super(message, cause) { }
}

/// 内存溢出错误
open class OutOfMemoryError : Error() {
    var _phantom: Int = 0
    constructor(message: String) : super(message) { }
    constructor(message: String, cause: Throwable?) : super(message, cause) { }
}

/// 栈溢出错误
open class StackOverflowError : Error() {
    var _phantom: Int = 0
    constructor(message: String) : super(message) { }
    constructor(message: String, cause: Throwable?) : super(message, cause) { }
}
