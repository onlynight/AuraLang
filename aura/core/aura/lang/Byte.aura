// aura:///aura/lang/Byte.aura
package aura.lang
// 语言内置类型，不可修改

/// 8 位有符号字节类型。
///
/// - 范围：-128 到 127
/// - 存储：VM 中内联存储为 i64（`Value::Int`）
///
/// @see Int, Long, Short
/// @since 0.1
internal value class Byte {

    // ── 常量（companion object）──

    companion object {
        /// 8 位字节最小值
        const MIN_VALUE: Byte = -128

        /// 8 位字节最大值
        const MAX_VALUE: Byte = 127

        /// 位宽（8 位）
        const BITS: Int = 8

        /// 从字符串解析为字节
        fun parseInt(text: String): Byte {
            var result: Int = 0
            var sign: Int = 1
            var i: Int = 0
            if (i < text.length && text[i] == '-') {
                sign = -1
                i = i + 1
            } else if (i < text.length && text[i] == '+') {
                i = i + 1
            }
            while (i < text.length) {
                val c = text[i]
                if (c >= '0' && c <= '9') {
                    result = result * 10 + (c - '0')
                }
                i = i + 1
            }
            return (result * sign) as Byte
        }
    }

    // ── 转换方法 ──

    /// 转换为 32 位整数
    fun toInt(): Int {
        return this as Int
    }

    /// 转换为 64 位长整数
    fun toLong(): Long {
        return this as Long
    }

    /// 转换为 32 位浮点数
    fun toFloat(): Float {
        return this as Float
    }

    /// 转换为字符串表示
    override fun toString(): String {
        return toStr(this)
    }

    // ── 比较方法 ──

    /// 比较两个字节，返回 -1/0/1
    fun compareTo(other: Byte): Int {
        if (this < other) return -1
        if (this > other) return 1
        return 0
    }

    /// 检查两个字节是否相等
    override fun equals(other: Byte): Boolean {
        return this == other
    }

    // ── 算术方法 ──

    /// 绝对值
    fun abs(): Byte {
        if (this < 0) return -this
        return this
    }
}
