// aura:///aura/lang/Any.aura
package aura.lang
// 语言内置类型，不可修改

/// 顶级类型 + 运行时基类——所有类型（包括 null）都可以赋值给 Any。
///
/// Any 是类型格（type lattice）的顶级类型：
/// - 任意类型可赋值给 Any（`can_assign_to: 任意类型 → Any`）
/// - null 可赋值给 Any
/// - Any 类型的变量可引用任何值
///
/// Any 同时是所有 `class` 的隐式基类，提供：
/// - `toString()`: 返回对象的可读表示
/// - `equals(other)`: 值相等检查（默认身份相等）
/// - `hashCode()`: 哈希码
/// - `typeOf()`: 返回运行时类对象（反射）
///
/// 语义规则：
/// - `class` 类型隐式继承 Any（不写 `: Any()`）
/// - Any 的所有方法都是 open 的（可重写）
/// - `value class` / `enum` / 基本类型不继承 Any
/// - `object` 单例也隐式继承 Any
/// - 使用 `is Any` 永远返回 true（所有值都是 Any）
///
/// @see Nothing, Type
/// @since 0.1
open class Any {

    /// 返回对象的可读表示。
    ///
    /// 默认实现返回 `"<ClassName@handle>"`（如 `"<Dog@0x1a2b3c>"`）。
    /// 用户可重写以提供自定义表示。
    ///
    /// @return 对象的可读字符串表示
    /// @since 0.5
    open fun toString(): String {
        if (this == null) return "null"
        // 值 → 字符串统一走运行时转换（`toStr`）。
        //
        // 原实现用 `typeof(this)` 做类型分派，但 AOT 后端**没有** `typeof` 的运行时
        // 实现（只有编译期按静态类型折叠的 `typeOf`），任何链接了 `Any` 的程序都会
        // 在链接期报 `undefined symbol: typeof`。`toStr` 在 VM 与 AOT 两侧都是
        // 「给定值 → 可读字符串」的规范入口（AOT 侧即 `aura_to_str_any`），
        // 语义与原先的分派结果一致。
        return toStr(this)
    }

    /// 检查两个对象是否值相等。
    ///
    /// 默认实现是身份相等（`===` 等价），即两个引用指向同一对象时返回 true。
    /// 用户可重写以实现值相等语义。
    ///
    /// @param other 要比较的对象
    /// @return 相等返回 true
    /// @since 0.5
    open fun equals(other: Any): Boolean {
        if (this == null) return other == null
        if (other == null) return false
        // 按「值的规范字符串形式」比较（见 toString 的说明：AOT 侧无 `typeof`）。
        // 对 Int / Long / Boolean / String / Char 等可哈希键，相等值必得相等字符串，
        // 与 VM 的值分派结果一致；类实例则退化为表示相等。
        return toStr(this) == toStr(other)
    }

    /// 返回对象的哈希码。
    ///
    /// 默认实现基于身份哈希。用户重写 `equals` 时必须同时重写 `hashCode`。
    ///
    /// @return 哈希码（Int）
    /// @since 0.5
    open fun hashCode(): Int {
        if (this == null) return 0
        // 31 进制字符串散列（见 toString 的说明：AOT 侧无 `typeof`）。
        // 与 `equals` 用同一规范形式，保证「相等 ⇒ 同哈希」；
        // 对 Int / Long / Boolean / String 等键，散列分布与 VM 的值分派等价。
        val s: String = toStr(this)
        var hash: Int = 0
        var i: Int = 0
        while (i < s.length) {
            hash = hash * 31 + s.charCodeAt(i)
            i = i + 1
        }
        return hash
    }

    // ── 反射（暂缺） ──
    //
    // `open fun typeOf(): Type` 曾在此声明，其实现为 `Type.forName(typeof(this))`，
    // 但存在两处硬伤：
    //   1. `Type.forName` 在标准库（`aura/lang/Type.aura`）中**并不存在**；
    //   2. `typeof` 在 AOT 后端没有运行时实现（AOT 只有编译期按静态类型折叠的
    //      `typeOf`），而 `Type(...)` 的构造在 AOT 下也尚无符号落地。
    // 结果是任何链接 `Any` 的程序都会在链接期报 `undefined symbol: typeof / Type`。
    // 由于该方法当前无任何调用点（仅 `Type.aura` 的文档注释提及），选择暂不声明，
    // 待 AOT 引入 RTTI + `Type` 构造路径后恢复。
    //
    // /// 返回运行时类对象（反射）。等价于 Java 的 `this.getClass()`。
    // open fun typeOf(): Type { ... }
}
