// aura:///aura/lang/Any.aura
// 语言内置类型，不可修改

/// 顶级类型 + 运行时基类——所有类型（包括 null）都可以赋值给 Any。
///
/// Any 是类型格（type lattice）的顶级类型：
/// - 任意类型可赋值给 Any（`can_assign_to: 任意类型 → Any`）
/// - null 可赋值给 Any
/// - Any 类型的变量可引用任何值
///
/// Any 同时是所有 `class` 的隐式基类，提供：
/// - `toString()`: 返回对象的可读表示
/// - `equals(other)`: 值相等检查（默认身份相等）
/// - `hashCode()`: 哈希码
/// - `typeOf()`: 返回运行时类对象（反射）
///
/// 语义规则：
/// - `class` 类型隐式继承 Any（不写 `: Any()`）
/// - Any 的所有方法都是 open 的（可重写）
/// - `value class` / `enum` / 基本类型不继承 Any
/// - `object` 单例也隐式继承 Any
/// - 使用 `is Any` 永远返回 true（所有值都是 Any）
///
/// @see Nothing, Type
/// @since 0.1
internal open class Any {

    /// 返回对象的可读表示。
    ///
    /// 默认实现返回 `"<ClassName@handle>"`（如 `"<Dog@0x1a2b3c>"`）。
    /// 用户可重写以提供自定义表示。
    ///
    /// @return 对象的可读字符串表示
    /// @since 0.5
    open fun toString(): String {
        if (this == null) return "null"
        val type = typeof(this)
        if (type == "Int") return toStr(this as Int)
        if (type == "Float") return toStr(this as Float)
        if (type == "Double") return toStr(this as Double)
        if (type == "Boolean") return if (this as Boolean) "true" else "false"
        if (type == "String") return this as String
        if (type == "Long") return toStr(this as Long)
        if (type == "Char") return toStr(this as Char)
        if (type == "Byte") return toStr(this as Byte)
        if (type == "Short") return toStr(this as Short)
        if (type == "List") return "List(" + (this as List<Any>).size + ")"
        if (type == "Map") return "Map(" + (this as Map<Any, Any>).size + ")"
        if (type == "Array") return "Array(" + (this as Array<Any>).size + ")"
        return "<" + type + "@" + hashCode() + ">"
    }

    /// 检查两个对象是否值相等。
    ///
    /// 默认实现是身份相等（`===` 等价），即两个引用指向同一对象时返回 true。
    /// 用户可重写以实现值相等语义。
    ///
    /// @param other 要比较的对象
    /// @return 相等返回 true
    /// @since 0.5
    open fun equals(other: Any): Boolean {
        if (this == null) return other == null
        if (other == null) return false
        // 基本类型值相等
        val thisType = typeof(this)
        val otherType = typeof(other)
        if (thisType != otherType) return false
        if (thisType == "Int") return (this as Int) == (other as Int)
        if (thisType == "Float") return (this as Float) == (other as Float)
        if (thisType == "Double") return (this as Double) == (other as Double)
        if (thisType == "Boolean") return (this as Boolean) == (other as Boolean)
        if (thisType == "String") return (this as String) == (other as String)
        if (thisType == "Long") return (this as Long) == (other as Long)
        if (thisType == "Char") return (this as Char) == (other as Char)
        if (thisType == "Byte") return (this as Byte) == (other as Byte)
        if (thisType == "Short") return (this as Short) == (other as Short)
        // 对象身份相等
        return this === other
    }

    /// 返回对象的哈希码。
    ///
    /// 默认实现基于身份哈希。用户重写 `equals` 时必须同时重写 `hashCode`。
    ///
    /// @return 哈希码（Int）
    /// @since 0.5
    open fun hashCode(): Int {
        if (this == null) return 0
        val type = typeof(this)
        if (type == "Int") return (this as Int) * 31
        if (type == "Float") return ((this as Float).toInt()) * 31
        if (type == "Double") return ((this as Double).toInt()) * 31
        if (type == "Boolean") return if (this as Boolean) 1231 else 1237
        if (type == "String") {
            var hash: Int = 0
            val str = this as String
            var i: Int = 0
            while (i < str.length) {
                hash = hash * 31 + str.charCodeAt(i)
                i = i + 1
            }
            return hash
        }
        if (type == "Long") return ((this as Long).toInt()) * 31
        if (type == "Char") return (this as Char) * 31
        if (type == "Byte") return (this as Byte) * 31
        if (type == "Short") return (this as Short) * 31
        // 对象身份哈希（基于指针地址）
        return hashCodeImpl(this)
    }

    /// 返回运行时类对象（反射）。
    ///
    /// 等价于 Java 的 `this.getClass()`。
    ///
    /// @return 运行时类对象
    /// @since 0.5
    open fun typeOf(): Type {
        return Type.forName(typeof(this))
    }

    // ── 内部辅助方法 ──

    /// 对象身份哈希码（基于 VM handle）。
    /// 实际实现由 VM 提供，此处为 Aura 占位。
    private fun hashCodeImpl(obj: Any): Int {
        return 0
    }
}
