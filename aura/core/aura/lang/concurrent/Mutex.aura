// aura:///aura/lang/concurrent/Mutex.aura
package aura.lang.concurrent
// 互斥锁（Mutex）—— 纯 Aura 实现（自旋锁），不依赖 Rust 运行库。
//
// 实现说明：
//   * 句柄是一段 8 字节堆内存的地址（`Memory.alloc`），存放锁字。
//   * 加锁/解锁使用 `Memory.atomicAdd`（内联汇编 `lock xaddq`）这一原生原子操作，
//     Aura 侧只负责自旋与状态管理——因此实现是纯 Aura，只有最底层的
//     原子指令走 `@native`。
//   * 锁字语义：`0` 表示未持有；`>0` 表示持有者数量（含正在探测的线程）。
//     只有 `fetch_add(1)` 返回旧值 `0` 的调用者才算真正获取到锁。
//
// 句柄必须是 **Long**（64 位），不能是 Int：
//   `Memory.alloc` 返回的地址来自 `.data` 段的 `heapArena`，在 PE 里形如
//   `0x0000000140xxxxxx`（> 2^32）。若用 `Int` 承载再 `as Long` 还原，
//   高位字节已被截断，还原出的地址落在未映射区，`lock xadd` 直接
//   访问违规（0xC0000005）。P4 的 `07_mutex_ops` / `test_thread`
//   就是这样挂在 `mutex.lock()` 上的。
//
// 原子操作走 `Memory.atomicAdd` 而不是 `Cpu.atomicAdd`：
//   `extern interface Cpu` 的 `@native(asm = ...)` 成员目前无法进入
//   `singletonCsv`，调用点的接收者不会被丢弃（实参整体错位一位，
//   `atomicAdd` 变成 4 个参数）。`Memory` 是稳定注册的单例。
//
// @since 0.6
import aura.lang.native.Memory
object Mutex {

    /// 创建新的互斥锁
    ///
    /// - 返回：互斥锁 ID（64 位堆地址）
    ///
    /// ⚠️ **不能**写成 `val addr = Memory.alloc(8L); Memory.write64(addr, 0L); return addr`：
    ///   当前代码生成把局部量放在 `%rdi`（caller-saved），`write64` 这一 call 会把
    ///   `%rdi` 踩掉，`return addr` 返回的就是垃圾值。`Memory.alloc` 本身已经
    ///   零初始化整段内存（`runtime_emitObjectAlloc` 的 zero loop），所以这里
    ///   不需要显式清零。
    fun new(): Long {
        return Memory.alloc(8L)
    }

    /// 获取互斥锁（阻塞直到可用）
    ///
    /// - 参数：`lock_id` — 互斥锁 ID（64 位堆地址）
    fun lock(lock_id: Long): Unit {
        while (true) {
            if (Memory.atomicAdd(lock_id, 1L) == 0L) {
                return
            }
            // 未获得锁：撤销本次探测
            Memory.atomicAdd(lock_id, 0L - 1L)
        }
    }

    /// 尝试获取互斥锁（非阻塞）
    ///
    /// - 参数：`lock_id` — 互斥锁 ID（64 位堆地址）
    /// - 返回：true 表示获取成功，false 表示锁已被持有
    fun tryLock(lock_id: Long): Boolean {
        if (Memory.atomicAdd(lock_id, 1L) == 0L) {
            return true
        }
        Memory.atomicAdd(lock_id, 0L - 1L)
        return false
    }

    /// 释放互斥锁
    ///
    /// - 参数：`lock_id` — 互斥锁 ID（64 位堆地址）
    fun unlock(lock_id: Long): Unit {
        Memory.atomicAdd(lock_id, 0L - 1L)
    }

    /// 查询互斥锁是否被持有
    ///
    /// - 参数：`lock_id` — 互斥锁 ID（64 位堆地址）
    /// - 返回：true 表示当前锁字非零（已被持有）
    fun isLocked(lock_id: Long): Boolean {
        val v: Long = Memory.read64(lock_id)
        return v != 0L
    }

    /// 销毁互斥锁
    ///
    /// - 参数：`lock_id` — 互斥锁 ID（64 位堆地址）
    fun destroy(lock_id: Long): Unit {
        Memory.free(lock_id)
    }
}
