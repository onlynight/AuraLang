// aura:///aura/lang/concurrent/Coroutine.aura
package aura.lang.concurrent
// 协程（轻量子任务）—— 实例级调度器，每个 VM 独立。
// 实现：Aura 实现（使用回调和状态管理）+ Thread 原语（OS 级线程调度）
// 架构：运行库，提供协程并发模型
//
// 使用前需 import：
// ```aura
// import aura.lang.concurrent.Coroutine.*   // 短名可用：spawn, ask
// import aura.lang.concurrent.Coroutine     // 类式调用：Coroutine.spawn(42)
// ```
//
// 架构说明：
// - 使用 Aura 实现协程模型（轻量级，同线程调度）
// - 使用 Thread 原语实现 OS 级线程调度（heavyweight）
// - 协程状态使用 CoroutineInstance 结构化存储
// - 支持 YIELD 让出执行权（需 VM 配合）
// - 协程结果使用回调管理
//
// @since 0.5
import aura.lang.collection.ArrayList
import aura.lang.collection.HashMap
import aura.lang.concurrent.Thread
import aura.lang.concurrent.Mutex
import aura.lang.concurrent.Atomic
import aura.lang.concurrent.Future
import aura.lang.std.Time
import aura.lang.std.Math

/// 协程实例（结构化数据，替代旧版 Map 存储）。
class CoroutineInstance {
    var id: Int = 0
    var body: () -> Any
    var status: String = "waiting"  // waiting / running / suspended / done
    var result: Any = null
    var yieldValue: Any = null
    var vmState: Map<String, Any> = null

    constructor() {
        this.id = 0
        this.body = null
        this.status = "waiting"
        this.result = null
        this.yieldValue = null
        this.vmState = null
    }

    constructor(id: Int, body: () -> Any) {
        this.id = id
        this.body = body
        this.status = "waiting"
        this.result = null
        this.yieldValue = null
        this.vmState = null
    }
}

/// 协程调度器（实例状态，每个 VM 独立）。
class Coroutine {

    // ── 内部状态（实例级，非全局）──

    var nextId: Int = 1
    var coroutines: ArrayList<CoroutineInstance> = ArrayList<CoroutineInstance>()

    /// 当前运行的协程 ID。
    var activeCoroutine: Int = -1

    /// 协程调度器（由 VM 设置，用于 YIELD 时查找下一协程）。
    var scheduler: Any = null

    init() {
        this.nextId = 1
        this.coroutines = ArrayList<CoroutineInstance>()
        this.activeCoroutine = -1
        this.scheduler = null
    }

    // ── 协程管理（使用回调和状态管理）──

    /// 启动一个新协程
    ///
    /// - 参数：`body` — 要执行的代码块（返回值即协程结果）
    /// - 返回：协程句柄 ID（用于 ask 时匹配）
    ///
    /// ```aura
    /// val co = Coroutine.spawn { 42 }
    /// ```
    fun spawn(body: () -> Any): Int {
        val id = nextId
        nextId = nextId + 1
        val co = CoroutineInstance(id, body)
        coroutines.add(co)
        return id
    }

    /// 阻塞等待并获取协程结果
    ///
    /// - 参数：`co_id` — spawn 返回的协程 ID
    /// - 返回：协程计算结果
    fun ask(co_id: Int): Any {
        if (co_id < 0 || co_id >= coroutines.size) return null
        val co = coroutines.get(co_id)
        if (co.status == "done") {
            return co.result
        }
        // 执行协程（同步模式：直接执行 body）
        val body = co.body
        val result = body()
        co.result = result
        co.status = "done"
        return result
    }

    /// 让出当前协程，返回下一个就绪协程 ID。
    ///
    /// 配合 VM YIELD 指令使用：
    /// 1. VM 遇到 YIELD 指令 → 保存状态 → 调用 schedule()
    /// 2. schedule() 找到下一个 waiting 协程 → 返回其 ID
    /// 3. VM 恢复下一个协程的状态 → 继续执行
    fun schedule(): Int {
        val n = coroutines.size
        var i = 0
        while (i < n) {
            val co = coroutines.get(i)
            if (co.status == "waiting") {
                co.status = "running"
                activeCoroutine = co.id
                return co.id
            }
            i = i + 1
        }
        // 没有 waiting 协程
        activeCoroutine = -1
        return -1
    }

    /// 协程完成（由 VM 或用户代码调用）。
    fun complete(co_id: Int, result: Any): Unit {
        if (co_id < 0 || co_id >= coroutines.size) return
        val co = coroutines.get(co_id)
        co.result = result
        co.status = "done"
    }

    /// 协程挂起（YIELD 后由调度器调用）。
    fun suspendCoroutine(co_id: Int, yieldVal: Any): Unit {
        if (co_id < 0 || co_id >= coroutines.size) return
        val co = coroutines.get(co_id)
        co.status = "suspended"
        co.yieldValue = yieldVal
    }

    /// 恢复挂起的协程。
    fun resumeCoroutine(co_id: Int): Boolean {
        if (co_id < 0 || co_id >= coroutines.size) return false
        val co = coroutines.get(co_id)
        if (co.status == "suspended") {
            co.status = "running"
            return true
        }
        return false
    }

    /// 获取协程数量。
    fun coroutineCount(): Int {
        return coroutines.size
    }

    /// 获取已完成协程数量。
    fun doneCount(): Int {
        var count = 0
        var i = 0
        while (i < coroutines.size) {
            if (coroutines.get(i).status == "done") count = count + 1
            i = i + 1
        }
        return count
    }

    /// 清理已完成的协程，释放闭包引用。
    fun cleanup(): Int {
        var removed = 0
        var i = coroutines.size - 1
        while (i >= 0) {
            if (coroutines.get(i).status == "done") {
                coroutines.remove(i)
                removed = removed + 1
            }
            i = i - 1
        }
        return removed
    }

    // ── Thread 原语调度（OS 级线程）──

    /// 在 OS 线程上执行函数并返回线程 ID
    ///
    /// - 参数：`fn_id` — VM 函数索引
    /// - 参数：`arg` — 传递给线程的初始值
    /// - 返回：线程 ID
    fun spawnThread(fn_id: Int, arg: Int): Int {
        return Thread.spawn(fn_id, arg)
    }

    /// 等待线程完成并返回结果
    ///
    /// - 参数：`thread_id` — 线程 ID
    /// - 返回：线程的返回值
    fun joinThread(thread_id: Int): Int {
        return Thread.join(thread_id)
    }

    /// 休眠指定毫秒数
    ///
    /// - 参数：`ms` — 休眠毫秒数
    fun sleep(ms: Int): Unit {
        Thread.sleep(ms)
    }

    /// 获取当前线程 ID
    fun threadId(): Int {
        return Thread.id()
    }

    /// 获取系统最大并行度
    fun parallelism(): Int {
        return Thread.parallelism()
    }

    /// 获取 CPU 核心数
    fun availableCores(): Int {
        return Thread.availableCores()
    }

    // ── 互斥锁包装 ──

    /// 创建互斥锁
    fun newMutex(): Int {
        return Mutex.new()
    }

    /// 获取互斥锁
    fun lockMutex(lock_id: Int): Unit {
        Mutex.lock(lock_id)
    }

    /// 释放互斥锁
    fun unlockMutex(lock_id: Int): Unit {
        Mutex.unlock(lock_id)
    }

    /// 尝试获取互斥锁（非阻塞）
    fun tryLockMutex(lock_id: Int): Boolean {
        return Mutex.tryLock(lock_id)
    }

    /// 销毁互斥锁
    fun destroyMutex(lock_id: Int): Unit {
        Mutex.destroy(lock_id)
    }

    // ── 原子整数包装 ──

    /// 创建原子整数
    fun newAtomic(initial: Int): Int {
        return Atomic.new(initial)
    }

    /// 原子加载
    fun atomicLoad(atomic_id: Int): Int {
        return Atomic.load(atomic_id)
    }

    /// 原子存储
    fun atomicStore(atomic_id: Int, value: Int): Unit {
        Atomic.store(atomic_id, value)
    }

    /// 原子加法
    fun atomicAdd(atomic_id: Int, delta: Int): Int {
        return Atomic.add(atomic_id, delta)
    }

    /// 原子减法
    fun atomicSub(atomic_id: Int, delta: Int): Int {
        return Atomic.sub(atomic_id, delta)
    }

    /// 原子 CAS
    fun atomicCas(atomic_id: Int, expected: Int, desired: Int): Boolean {
        return Atomic.cas(atomic_id, expected, desired)
    }

    // ── Future 包装 ──

    /// 异步执行函数，返回 Future 句柄
    fun spawnFuture(fn_id: Int, arg: Int): Int {
        return Future.spawn(fn_id, arg)
    }

    /// 等待 Future 完成
    fun awaitFuture(future_id: Int): Int {
        return Future.await(future_id)
    }

    /// 检查 Future 是否完成
    fun isFutureDone(future_id: Int): Boolean {
        return Future.isDone(future_id)
    }

    /// 等待多个 Future 全部完成
    fun awaitAllFuture(future_ids: List<Int>): List<Int> {
        return Future.all(future_ids)
    }

    /// 取消 Future
    fun cancelFuture(future_id: Int): Unit {
        Future.cancel(future_id)
    }

    // ── 并发工具函数 ──

    /// 获取当前时间（毫秒）
    fun currentTimeMillis(): Int {
        return Time.currentTime
    }

    /// 并发执行多个任务（返回 Future 列表）
    fun spawnAll(fn_ids: List<Int>, args: List<Int>): List<Int> {
        val futures = mutableListOf<Int>()
        val n = Math.min(fn_ids.size, args.size)
        for (i in 0..<n) {
            futures.add(Future.spawn(fn_ids[i], args[i]))
        }
        return futures
    }
}
