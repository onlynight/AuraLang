// aura:///aura/lang/concurrent/Condvar.aura
package aura.lang.concurrent
// 条件变量（Condvar）—— 纯 Aura 实现，不依赖 Rust 运行库。
//
// 实现说明：
//   * 句柄指向一段 16 字节堆内存：`w0`=守卫自旋锁，`w1`=代数（generation）计数器。
//   * `wait` 会先记录当前代数，释放互斥锁，自旋等待代数变化，再重新加锁；
//     `signal/broadcast` 都通过递增代数唤醒等待者（唤醒全部，语义保守但正确）。
//   * 守卫自旋锁与互斥锁均基于 `Cpu.atomicAdd`（`lock xaddq`）原生原子指令，
//     等待逻辑在 Aura 中实现。
//
// 使用前需 import：
// ```aura
// import aura.lang.concurrent.Condvar.*   // 短名可用：new, wait, signal, ...
// import aura.lang.concurrent.Condvar     // 类式调用：Condvar.new()
// ```
//
// 使用模式：
// ```aura
// val mutex = Mutex.new()
// val cv = Condvar.new()
// Mutex.lock(mutex)
// if (!condition) {
//     Condvar.wait(cv, mutex)  // 释放锁并等待
// }
// Mutex.unlock(mutex)
// ```
//
// @since 0.6
import aura.lang.native.Memory
import aura.lang.native.Cpu
import aura.lang.concurrent.Mutex

internal object Condvar {

    /// 创建新的条件变量
    ///
    /// - 返回：条件变量 ID（堆地址）
    fun new(): Int {
        val addr: Long = Memory.alloc(16L)
        Memory.write64(addr, 0L)
        Memory.write64(addr + 8L, 0L)
        return addr as Int
    }

    /// 在条件变量上等待（必须持有互斥锁）
    ///
    /// - 参数：`cv_id` — 条件变量 ID
    /// - 参数：`mutex_id` — 要释放并等待的互斥锁 ID
    fun wait(cv_id: Int, mutex_id: Int): Unit {
        val guard: Long = cv_id as Long
        val gen: Long = guard + 8L
        spinAcquire(guard)
        val observed: Long = Memory.read64(gen)
        spinRelease(guard)

        Mutex.unlock(mutex_id)
        while (Memory.read64(gen) == observed) {
            // 自旋等待 signal / broadcast
        }
        Mutex.lock(mutex_id)
    }

    /// 唤醒等待线程
    ///
    /// - 参数：`cv_id` — 条件变量 ID
    fun signal(cv_id: Int): Unit {
        val guard: Long = cv_id as Long
        val gen: Long = guard + 8L
        spinAcquire(guard)
        Memory.write64(gen, Memory.read64(gen) + 1L)
        spinRelease(guard)
    }

    /// 唤醒所有等待线程
    ///
    /// - 参数：`cv_id` — 条件变量 ID
    fun broadcast(cv_id: Int): Unit {
        signal(cv_id)
    }

    /// 销毁条件变量
    ///
    /// - 参数：`cv_id` — 条件变量 ID
    fun destroy(cv_id: Int): Unit {
        Memory.free(cv_id as Long)
    }

    // ── 内部：自旋守卫 ──

    private fun spinAcquire(word: Long): Unit {
        while (true) {
            if (Cpu.atomicAdd(word, 1L) == 0L) {
                return
            }
            Cpu.atomicAdd(word, 0L - 1L)
        }
    }

    private fun spinRelease(word: Long): Unit {
        Cpu.atomicAdd(word, 0L - 1L)
    }
}
