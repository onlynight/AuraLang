// aura:///aura/lang/concurrent/Condvar.aura
package aura.lang.concurrent
// 条件变量（Condvar）—— 纯 Aura 实现，不依赖 Rust 运行库。
//
// 实现说明：
//   * 句柄指向一段 16 字节堆内存：`w0`=守卫自旋锁，`w1`=代数（generation）计数器。
//   * `wait` 会先记录当前代数，释放互斥锁，自旋等待代数变化，再重新加锁；
//     `signal/broadcast` 都通过递增代数唤醒等待者（唤醒全部，语义保守但正确）。
//   * 守卫自旋锁与互斥锁均基于 `Memory.atomicAdd`（`lock xaddq`）原生原子指令，
//     等待逻辑在 Aura 中实现。
//
// ⚠️ 句柄必须是 **Long**（64 位），不能是 Int：`Memory.alloc` 返回的 `.data`
// 段地址形如 `0x0000000140xxxxxx`（> 2^32），`Int` 承载会截断高位，
// `as Long` 还原后落在未映射区 ⇒ `lock xadd` 访问违规（0xC0000005）。
//
// 使用前需 import：
// ```aura
// import aura.lang.concurrent.Condvar.*   // 短名可用：new, wait, signal, ...
// import aura.lang.concurrent.Condvar     // 类式调用：Condvar.new()
// ```
//
// 使用模式：
// ```aura
// val mutex = Mutex.new()
// val cv = Condvar.new()
// Mutex.lock(mutex)
// if (!condition) {
//     Condvar.wait(cv, mutex)  // 释放锁并等待
// }
// Mutex.unlock(mutex)
// ```
//
// @since 0.6
import aura.lang.native.Memory
import aura.lang.concurrent.Mutex
object Condvar {

    /// 创建新的条件变量
    ///
    /// - 返回：条件变量 ID（64 位堆地址，16 字节：`[0]` 守卫自旋锁，`[8]` 代数）
    ///
    /// ⚠️ 不显式清零：`Memory.alloc` 已零初始化整段内存；而且不能写成
    ///   `val addr = ...; Memory.write64(addr, 0); return addr` —— 当前代码生成
    ///   把局部量放在 `%rdi`（caller-saved），`write64` 的 call 会踩掉它。
    fun new(): Long {
        return Memory.alloc(16L)
    }

    /// 在条件变量上等待（必须持有互斥锁）
    ///
    /// - 参数：`cv_id` — 条件变量 ID（64 位堆地址）
    /// - 参数：`mutex_id` — 要释放并等待的互斥锁 ID（64 位堆地址）
    fun wait(cv_id: Long, mutex_id: Long): Unit {
        val guard: Long = cv_id
        val gen: Long = guard + 8L
        spinAcquire(guard)
        val observed: Long = Memory.read64(gen)
        spinRelease(guard)

        Mutex.unlock(mutex_id)
        while (Memory.read64(gen) == observed) {
            // 自旋等待 signal / broadcast
        }
        Mutex.lock(mutex_id)
    }

    /// 唤醒等待线程
    ///
    /// - 参数：`cv_id` — 条件变量 ID（64 位堆地址）
    fun signal(cv_id: Long): Unit {
        val gen: Long = cv_id + 8L
        spinAcquire(cv_id)
        Memory.write64(gen, Memory.read64(gen) + 1L)
        spinRelease(cv_id)
    }

    /// 唤醒所有等待线程
    ///
    /// - 参数：`cv_id` — 条件变量 ID（64 位堆地址）
    fun broadcast(cv_id: Long): Unit {
        signal(cv_id)
    }

    /// 销毁条件变量
    ///
    /// - 参数：`cv_id` — 条件变量 ID（64 位堆地址）
    fun destroy(cv_id: Long): Unit {
        Memory.free(cv_id)
    }

    // ── 内部：自旋守卫 ──

    private fun spinAcquire(word: Long): Unit {
        while (true) {
            if (Memory.atomicAdd(word, 1L) == 0L) {
                return
            }
            Memory.atomicAdd(word, 0L - 1L)
        }
    }

    private fun spinRelease(word: Long): Unit {
        Memory.atomicAdd(word, 0L - 1L)
    }
}
