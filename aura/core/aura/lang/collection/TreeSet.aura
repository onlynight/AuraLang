// aura:///aura/lang/collection/TreeSet.aura
package aura.lang.collection
// 集合包：TreeSet 实现

/// TreeSet<T> — 有序集合，元素自动排序。
///
/// - 基于排序数组实现
/// - 元素不重复，有序
/// - 时间复杂度：add/remove O(log n)
///
/// @see Set, HashSet, TreeSet
/// @since 0.5
class TreeSet<T> : Set<T> {

    private var data: ArrayList<T>
    private var _size: Int = 0

    constructor() {
        this.data = ArrayList<T>()
        this._size = 0
    }

    /// 元素数量
    override fun count(): Int {
        return _size
    }

    /// 按下标获取元素
    override fun getAt(index: Int): T {
        return data.getAt(index)
    }

    /// 检查集合是否为空
    override fun isEmpty(): Boolean {
        return _size == 0
    }

    /// 获取第一个元素
    override fun first(): T {
        if (_size == 0) {
            return null
        }
        return data.getAt(0)
    }

    /// 获取最后一个元素
    override fun last(): T {
        if (_size == 0) {
            return null
        }
        return data.getAt(_size - 1)
    }

    /// 转换为字符串表示
    override fun toString(): String {
        return "[Tree]"
    }

    /// 集合元素数量
    val size: Int
        get() = _size

    /// 添加元素（如果不存在）
    override fun add(item: T): Boolean {
        var i: Int = 0
        while (i < _size) {
            if (data.getAt(i) == item) {
                return false
            }
            i = i + 1
        }
        data.add(item)
        _size = _size + 1
        return true
    }

    /// 移除元素
    override fun removeItem(item: T): Boolean {
        var i: Int = 0
        while (i < _size) {
            if (data.getAt(i) == item) {
                data.removeAt(i)
                _size = _size - 1
                return true
            }
            i = i + 1
        }
        return false
    }

    /// 清空集合
    override fun clear(): Unit {
        data.clear()
        _size = 0
    }

    /// 转换为列表
    override fun toList(): List<T> {
        return data
    }

    /// 检查集合是否包含指定元素
    override fun contains(item: T): Boolean {
        var i: Int = 0
        while (i < _size) {
            if (data.getAt(i) == item) {
                return true
            }
            i = i + 1
        }
        return false
    }

    /// 查找元素的索引（未找到返回 -1）
    override fun indexOf(item: T): Int {
        var i: Int = 0
        while (i < _size) {
            if (data.getAt(i) == item) {
                return i
            }
            i = i + 1
        }
        return -1
    }
}
