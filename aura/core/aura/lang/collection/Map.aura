// aura:///aura/lang/collection/Map.aura
package aura.lang.collection
// 集合包：键值映射接口

/// 键值映射接口 Map<K, V>。
///
/// 由 `HashMap<K, V>` 实现。约定：
///
/// - 值可以为 `null`，因此「键不存在」只能由返回 `null` 表达，`get`
///   的返回类型是可空的 `V?`；需要区分「不存在」与「值为 null」时用
///   `containsKey` 或 `getOrDefault`。
/// - `keys()` / `values()` 返回 `List`，实现类返回其 `ArrayList` 实现。
/// - 遍历顺序不保证与插入顺序一致。
///
/// @see Collection, List, HashMap, ArrayList
/// @since 0.5
interface Map<K, V> {
    /// 映射的条目数量
    fun getSize(): Int

    /// 按键获取值（不存在或已删除返回 null）
    fun get(key: K): V?

    /// 按键获取值，不存在或已删除时返回默认值
    fun getOrDefault(key: K, default: V): V

    /// 按键写入值，返回被替换的旧值（原本不存在返回 null）
    fun put(key: K, value: V): V?

    /// 移除指定键，返回被移除的值（原本不存在返回 null）
    fun remove(key: K): V?

    /// 清空映射
    fun clear(): Unit

    /// 检查映射是否为空
    fun isEmpty(): Boolean

    /// 检查是否包含指定键
    fun containsKey(key: K): Boolean

    /// 检查是否包含指定值
    fun containsValue(value: V): Boolean

    /// 获取所有键
    fun keys(): List<K>

    /// 获取所有值
    fun values(): List<V>

    /// 转换为字符串表示
    fun toString(): String
}
