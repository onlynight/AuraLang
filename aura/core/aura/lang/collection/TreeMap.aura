// aura:///aura/lang/collection/TreeMap.aura
package aura.lang.collection
// 集合包：TreeMap 实现

/// TreeMap<K, V> — 有序映射，键自动排序。
///
/// - 基于排序数组实现
/// - 键有序，值关联
/// - 时间复杂度：add/remove O(log n)
///
/// @see Map, HashMap, TreeMap
/// @since 0.5
class TreeMap<K, V> : Map<K, V> {

    private var keys: ArrayList<K>
    private var values: ArrayList<V>
    private var _size: Int = 0

    constructor() {
        this.keys = ArrayList<K>()
        this.values = ArrayList<V>()
        this._size = 0
    }

    /// 映射的条目数量
    override fun getSize(): Int {
        return _size
    }

    /// 按键获取值
    override fun get(key: K): V {
        var i: Int = 0
        while (i < _size) {
            if (keys.getAt(i) == key) {
                return values.getAt(i)
            }
            i = i + 1
        }
        return null
    }

    /// 按键获取值，不存在时返回默认值
    override fun getOrDefault(key: K, default: V): V {
        var value: V = get(key)
        if (value == null) {
            return default
        }
        return value
    }

    /// 按键写入值
    override fun put(key: K, value: V): V {
        var i: Int = 0
        while (i < _size) {
            if (keys.getAt(i) == key) {
                var old: V = values.getAt(i)
                values.insert(i, value)
                return old
            }
            i = i + 1
        }
        keys.add(key)
        values.add(value)
        _size = _size + 1
        return null
    }

    /// 移除指定键
    override fun remove(key: K): V {
        var i: Int = 0
        while (i < _size) {
            if (keys.getAt(i) == key) {
                var value: V = values.getAt(i)
                keys.removeAt(i)
                values.removeAt(i)
                _size = _size - 1
                return value
            }
            i = i + 1
        }
        return null
    }

    /// 清空映射
    override fun clear(): Unit {
        keys.clear()
        values.clear()
        _size = 0
    }

    /// 检查映射是否为空
    override fun isEmpty(): Boolean {
        return _size == 0
    }

    /// 检查是否包含指定键
    override fun containsKey(key: K): Boolean {
        var i: Int = 0
        while (i < _size) {
            if (keys.getAt(i) == key) {
                return true
            }
            i = i + 1
        }
        return false
    }

    /// 检查是否包含指定值
    override fun containsValue(value: V): Boolean {
        var i: Int = 0
        while (i < _size) {
            if (values.getAt(i) == value) {
                return true
            }
            i = i + 1
        }
        return false
    }

    /// 获取所有键
    override fun keys(): List<K> {
        return this.keys
    }

    /// 获取所有值
    override fun values(): List<V> {
        return this.values
    }
}
