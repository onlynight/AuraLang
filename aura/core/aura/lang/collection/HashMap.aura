// aura:///aura/lang/collection/HashMap.aura
package aura.lang.collection

import aura.lang.collection.Map
// HashMap 的桶链字段是 `ArrayList<...>`：必须显式引入，否则 AOT 侧只用到
// `%struct.ArrayList` 的类型而拿不到其定义（llc: use of undefined type
// named 'struct.ArrayList'）。ArrayList 自身再 import List/Array，链式带入。
import aura.lang.collection.ArrayList

// 集合包：HashMap 实现（哈希分桶 + 链地址法）

/// HashMap<K, V> — 基于哈希分桶与链地址法的映射实现。
///
/// 存储布局：容量 `capacity` 条桶，每条桶链由三条并行列表构成，
/// 三条链下标一一对应——
///
/// ```text
/// bucketKeys[b]   ──► [k0, k1, k2, ...]        键链
/// bucketValues[b] ──► [v0, v1, v2, ...]        值链
/// bucketAlive[b]  ──► [true, true, false, ...] 存活标记链
/// ```
///
/// 第 i 条记录的键为 `bucketKeys[b][i]`，值为 `bucketValues[b][i]`，
/// 是否有效为 `bucketAlive[b][i]`。
///
/// 关键设计：
///
/// - **哈希取模**：桶下标 = `hashKey(key) and (capacity - 1)`，`capacity`
///   恒为 2 的幂，故用按位与代替取模（对负哈希也得到非负结果）。
/// - **哈希混合**：`hashKey` 在 `key.hashCode()` 之上做雪崩混合。VM 的
///   `Int.hashCode()` 是恒等函数，若不混合，`1, 17, 33, ...` 这类等差键
///   会全部撞进同一桶、退化为线性表。
/// - **只追加的桶链**：桶链只追加、不原地改写。`put` 命中已有键时追加一条
///   新记录，`remove` 追加一条标记为失效的记录；查找自链尾向前扫描，
///   最新记录胜出。因此写操作不需要在链中间定位并改写。
/// - **负载阈值扩容**：记录数达到 `capacity * 7 / 10` 时容量翻倍重建，
///   重建过程丢弃失效记录，使链长保持有界。
///
/// 复杂度：get / put / remove / containsKey 均摊 O(1)；
/// containsValue / keys / values / toString 为 O(n)。
/// 空间复杂度：O(n + capacity)。
///
/// 说明：键为 `null` 时 `hashCode` 恒为 0，全部落入 0 号桶——功能正确
/// 但退化为该桶内线性扫描，故不建议用 `null` 作键。
/// 键的相等性由 `equals` 判定；`hashCode` 相同的不同键由 `equals` 区分。
/// 遍历顺序（keys / values / toString）为桶顺序，不保证与插入顺序一致。
///
/// @see Map, ArrayList, HashSet
/// @since 0.5
class HashMap<K, V> : Map<K, V> {

    // ── 内部存储 ──

    /// 桶键链：第 b 个元素是第 b 号桶的键链。
    private var bucketKeys: ArrayList<ArrayList<K>>

    /// 桶值链：与 bucketKeys 的元素、以及各链内部下标对齐。
    private var bucketValues: ArrayList<ArrayList<V>>

    /// 桶存活链：与 bucketKeys 对齐，记录每条记录是否仍有效。
    private var bucketAlive: ArrayList<ArrayList<Boolean>>

    /// 桶数量，始终为 2 的幂。
    private var capacity: Int

    /// 存活条目数（不含失效记录）。
    private var _size: Int

    /// 已追加的记录数（含失效记录），用于判定是否扩容。
    private var _records: Int

    // ── 构造 ──

    /// 创建空映射，初始容量 16。
    ///
    /// 需要预置键值对时使用 `HashMapUtils.mapOf(k, v, k, v, ...)`。
    constructor() {
        this.capacity = 16
        this._size = 0
        this._records = 0
        this.allocBuckets(16)
    }

    // ── 属性 ──

    /// 映射的条目数量。
    val size: Int
        get() = _size

    /// 映射的条目数量（`Map.getSize()` 接口形式）。
    override fun getSize(): Int {
        return _size
    }

    // ── 访问方法 ──

    /// 按键获取值，键不存在或已删除返回 null。
    override fun get(key: K): V? {
        var b: Int = this.bucketIndex(key)
        var ks: ArrayList<K> = this.bucketKeys[b]
        var vs: ArrayList<V> = this.bucketValues[b]
        var fs: ArrayList<Boolean> = this.bucketAlive[b]
        var i: Int = ks.size - 1
        while (i >= 0) {
            if (this.valuesEqual(ks[i], key)) {
                if (fs[i]) { return vs[i] }
                return null
            }
            i = i - 1
        }
        return null
    }

    /// 按键获取值，键不存在或已删除时返回默认值。
    override fun getOrDefault(key: K, default: V): V {
        var b: Int = this.bucketIndex(key)
        var ks: ArrayList<K> = this.bucketKeys[b]
        var vs: ArrayList<V> = this.bucketValues[b]
        var fs: ArrayList<Boolean> = this.bucketAlive[b]
        var i: Int = ks.size - 1
        while (i >= 0) {
            if (this.valuesEqual(ks[i], key)) {
                if (fs[i]) { return vs[i] }
                return default
            }
            i = i - 1
        }
        return default
    }

    /// 检查是否包含指定键。
    ///
    /// 自链尾向前扫描（最新记录优先）。注意循环体必须递减 `i`：漏掉递减时
    /// `while (i >= 0)` 会永久停在同一下标，且每轮都执行 `valuesEqual`
    /// （内部经 `toStr` 分配字符串）→ 死循环 + 内存无上限增长。
    override fun containsKey(key: K): Boolean {
        var b: Int = this.bucketIndex(key)
        var ks: ArrayList<K> = this.bucketKeys[b]
        var fs: ArrayList<Boolean> = this.bucketAlive[b]
        var i: Int = ks.size - 1
        while (i >= 0) {
            if (this.valuesEqual(ks[i], key)) {
                return fs[i]
            }
            i = i - 1
        }
        return false
    }

    /// 检查是否包含指定值。
    ///
    /// 除「存活」外还必须满足 `isLatest`：本实现是追加式历史链，被覆盖或被
    /// `remove` 遮蔽的旧记录仍带 `alive = true`，只看 `fs[i]` 会把「已删除键
    /// 的旧值」也算作存在（`remove("b")` 之后 `containsValue(2)` 仍返回 true）。
    override fun containsValue(value: V): Boolean {
        var b: Int = 0
        while (b < this.capacity) {
            var ks: ArrayList<K> = this.bucketKeys[b]
            var vs: ArrayList<V> = this.bucketValues[b]
            var fs: ArrayList<Boolean> = this.bucketAlive[b]
            var i: Int = 0
            var n: Int = vs.size
            while (i < n) {
                if (fs[i]) {
                    if (this.isLatest(ks, i)) {
                        if (this.valuesEqual(vs[i], value)) { return true }
                    }
                }
                i = i + 1
            }
            b = b + 1
        }
        return false
    }

    // ── 修改方法 ──

    /// 按键写入值，返回被替换的旧值（键原本不存在返回 null）。
    ///
    /// 同一键重复写入时追加一条新记录而不改写历史记录，因此旧值仍可被
    /// 返回；`remove` 同理。扩容重建会丢弃所有被后续记录遮蔽的旧记录。
    override fun put(key: K, value: V): V? {
        var b: Int = this.bucketIndex(key)
        var ks: ArrayList<K> = this.bucketKeys[b]
        var vs: ArrayList<V> = this.bucketValues[b]
        var fs: ArrayList<Boolean> = this.bucketAlive[b]
        var old: V? = null
        var existed: Boolean = false
        var i: Int = ks.size - 1
        while (i >= 0) {
            if (this.valuesEqual(ks[i], key)) {
                if (fs[i]) {
                    old = vs[i]
                    existed = true
                }
                break
            }
            i = i - 1
        }
        ks.add(key)
        vs.add(value)
        fs.add(true)
        this._records = this._records + 1
        if (existed == false) {
            this._size = this._size + 1
        }
        this.checkResize()
        return old
    }

    /// 移除指定键，返回被移除的值（键不存在或已删除返回 null）。
    ///
    /// 实现为追加一条失效标记记录而非回写历史链：历史链无需改写，失效
    /// 记录在扩容重建时统一清除。
    override fun remove(key: K): V? {
        var b: Int = this.bucketIndex(key)
        var ks: ArrayList<K> = this.bucketKeys[b]
        var vs: ArrayList<V> = this.bucketValues[b]
        var fs: ArrayList<Boolean> = this.bucketAlive[b]
        var i: Int = ks.size - 1
        while (i >= 0) {
            if (this.valuesEqual(ks[i], key)) {
                if (fs[i]) {
                    var old: V = vs[i]
                    ks.add(key)
                    vs.add(null)
                    fs.add(false)
                    this._size = this._size - 1
                    this._records = this._records + 1
                    this.checkResize()
                    return old
                }
                return null
            }
            i = i - 1
        }
        return null
    }

    /// 清空映射，保留当前容量。
    override fun clear(): Unit {
        this.allocBuckets(this.capacity)
        this._size = 0
        this._records = 0
    }

    /// 判断映射是否为空。
    override fun isEmpty(): Boolean {
        return _size == 0
    }

    // ── 集合操作 ──

    /// 获取所有键，每个键只出现一次。
    override fun keys(): ArrayList<K> {
        var out: ArrayList<K> = arrayListOf<K>()
        var b: Int = 0
        while (b < this.capacity) {
            var ks: ArrayList<K> = this.bucketKeys[b]
            var fs: ArrayList<Boolean> = this.bucketAlive[b]
            var i: Int = 0
            var n: Int = ks.size
            while (i < n) {
                if (fs[i]) {
                    if (this.isLatest(ks, i)) { out.add(ks[i]) }
                }
                i = i + 1
            }
            b = b + 1
        }
        return out
    }

    /// 获取所有值，顺序与 `keys()` 一一对应。
    override fun values(): ArrayList<V> {
        var out: ArrayList<V> = arrayListOf<V>()
        var b: Int = 0
        while (b < this.capacity) {
            var ks: ArrayList<K> = this.bucketKeys[b]
            var vs: ArrayList<V> = this.bucketValues[b]
            var fs: ArrayList<Boolean> = this.bucketAlive[b]
            var i: Int = 0
            var n: Int = ks.size
            while (i < n) {
                if (fs[i]) {
                    if (this.isLatest(ks, i)) { out.add(vs[i]) }
                }
                i = i + 1
            }
            b = b + 1
        }
        return out
    }

    // ── 转换 ──

    /// 转换为字符串表示，形如 `{a=1, b=2}`。
    override fun toString(): String {
        var ks: ArrayList<K> = this.keys()
        var vs: ArrayList<V> = this.values()
        var result: String = "{"
        var i: Int = 0
        var n: Int = ks.size
        while (i < n) {
            if (i > 0) {
                result = result + ", "
            }
            result = result + ks[i] + "=" + vs[i]
            i = i + 1
        }
        result = result + "}"
        return result
    }

    // ── 内部辅助 ──

    /// 分配 `cap` 条空桶链并写入三个桶数组字段。
    private fun allocBuckets(cap: Int): Unit {
        var bk: ArrayList<ArrayList<K>> = arrayListOf<ArrayList<K>>()
        var bv: ArrayList<ArrayList<V>> = arrayListOf<ArrayList<V>>()
        var ba: ArrayList<ArrayList<Boolean>> = arrayListOf<ArrayList<Boolean>>()
        var i: Int = 0
        while (i < cap) {
            bk.add(arrayListOf<K>())
            bv.add(arrayListOf<V>())
            ba.add(arrayListOf<Boolean>())
            i = i + 1
        }
        this.bucketKeys = bk
        this.bucketValues = bv
        this.bucketAlive = ba
    }

    /// 混合键的哈希值，使低比特也参与扰动。
    ///
    /// VM 的 `Int.hashCode()` 直接返回键本身，先加黄金比例常数打破
    /// `mix(0) == 0` 的不动点，再迭代 FNV-1a 常数，把相邻与等差哈希打散。
    /// 全程只用整数加、乘、移位、异或，不引入浮点。
    ///
    /// 位运算一律使用**符号形式**（`^` / `>>` / `&`）：单词形式 `xor` / `shr` /
    /// `and` 在两个编译器里的处理并不一致（Rust 侧 `and`/`or` 被当作逻辑运算符，
    /// Aura 侧 `binPrec` 不接受单词形式），自举时会把它们降级成未定义调用或
    /// 错误的逻辑指令。符号形式在两个后端都有确定语义。
    private fun hashKey(key: Any): Int {
        var h: Int = key.hashCode()
        h = h + 0x9e3779b9
        h = h ^ (h >> 16)
        h = h * 16777619
        h = h ^ (h >> 13)
        h = h * 16777619
        h = h ^ (h >> 16)
        return h
    }

    /// 计算键的桶下标。`capacity` 是 2 的幂，故用 `& (capacity - 1)`
    /// 取模，对负哈希同样得到 0..capacity-1 范围内的结果。
    private fun bucketIndex(key: Any): Int {
        return this.hashKey(key) & (this.capacity - 1)
    }

    /// 空安全的值相等：任一侧为 null 时按 null 比较，否则委托 `equals`。
    private fun valuesEqual(a: Any, b: Any): Boolean {
        if (a == null) { return b == null }
        return a.equals(b)
    }

    /// 判断桶链中第 `i` 条记录是否为该键的最新记录
    /// （其后不存在同键记录）。
    private fun isLatest(ks: ArrayList<K>, i: Int): Boolean {
        var key: K = ks[i]
        var j: Int = ks.size - 1
        while (j > i) {
            if (this.valuesEqual(ks[j], key)) { return false }
            j = j - 1
        }
        return true
    }

    /// 记录数达到负载阈值（`capacity * 7 / 10`）时扩容重建，
    /// 直到不再超标。
    private fun checkResize(): Unit {
        while (this._records * 10 >= this.capacity * 7) {
            this.rehash(this.capacity * 2)
        }
    }

    /// 按 `newCap` 重建桶数组：有效记录按新容量重新分桶，
    /// 失效记录与被遮蔽的旧记录一并丢弃。
    private fun rehash(newCap: Int): Unit {
        var oldKeys: ArrayList<ArrayList<K>> = this.bucketKeys
        var oldValues: ArrayList<ArrayList<V>> = this.bucketValues
        var oldAlive: ArrayList<ArrayList<Boolean>> = this.bucketAlive
        var oldCap: Int = this.capacity
        this.capacity = newCap
        this.allocBuckets(newCap)
        var b: Int = 0
        while (b < oldCap) {
            var ok: ArrayList<K> = oldKeys[b]
            var ov: ArrayList<V> = oldValues[b]
            var oa: ArrayList<Boolean> = oldAlive[b]
            var n: Int = ok.size
            var i: Int = 0
            while (i < n) {
                if (oa[i]) {
                    // 只搬运「该键在旧链中的最新记录」。
                    //
                    // 被后续记录遮蔽的旧记录必须一并丢弃：`remove` 的实现是往链尾
                    // 追加一条墓碑（`alive=false`），若这里只按 `oa[i]` 判断，
                    // 墓碑被丢弃而**更早的 alive 旧记录被搬到新表** → 已删除的键
                    // 重新暴露（`containsKey`/`get` 误报存在，`keys()` 数量翻倍）。
                    if (this.isLatest(ok, i)) {
                        var key: K = ok[i]
                        var val: V = ov[i]
                        var t: Int = this.bucketIndex(key)
                        var nk: ArrayList<K> = this.bucketKeys[t]
                        var nv: ArrayList<V> = this.bucketValues[t]
                        var na: ArrayList<Boolean> = this.bucketAlive[t]
                        nk.add(key)
                        nv.add(val)
                        na.add(true)
                    }
                }
                i = i + 1
            }
            b = b + 1
        }
        this._records = this._size
    }
}

// ── 工具对象 ──

/// HashMap 工厂函数集合
object HashMapUtils {

    /// 从交替的键值参数创建映射，形如 `mapOf("a", 1, "b", 2)`。
    fun <K, V> mapOf(vararg pairs: Any): HashMap<K, V> {
        var m: HashMap<K, V> = HashMap<K, V>()
        var i: Int = 0
        while (i + 1 < pairs.size) {
            m.put(pairs[i], pairs[i + 1])
            i = i + 2
        }
        return m
    }

    /// 从交替的键值参数创建可变映射。
    fun <K, V> mutableMapOf(vararg pairs: Any): HashMap<K, V> {
        var m: HashMap<K, V> = HashMap<K, V>()
        var i: Int = 0
        while (i + 1 < pairs.size) {
            m.put(pairs[i], pairs[i + 1])
            i = i + 2
        }
        return m
    }

    /// 创建空映射。
    fun <K, V> emptyMap(): HashMap<K, V> {
        return HashMap<K, V>()
    }
}
