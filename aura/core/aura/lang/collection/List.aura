// aura:///aura/lang/collection/List.aura
// 集合包：有序列表接口

/// 有序列表接口 List<T>。
interface List<T> {
    /// 列表元素数量
    fun getSize(): Int

    /// 按下标获取元素
    fun get(index: Int): T

    /// 获取第一个元素
    fun first(): T

    /// 获取最后一个元素
    fun last(): T

    /// 检查列表是否包含指定元素
    fun contains(item: T): Boolean

    /// 查找元素的索引（未找到返回 -1）
    fun indexOf(item: T): Int

    /// 查找元素的最后一个索引（未找到返回 -1）
    fun lastIndexOf(item: T): Int

    /// 按条件过滤
    fun filter(predicate: Any): List<T>

    /// 转换每个元素
    fun map(transform: Any): List<Any>

    /// 获取所有不同元素
    fun distinct(): List<T>

    /// 检查是否所有元素都满足条件
    fun every(predicate: Any): Boolean

    /// 检查是否存在满足条件的元素
    fun any(predicate: Any): Boolean

    /// 取前 n 个元素
    fun take(n: Int): List<T>

    /// 跳过前 n 个元素
    fun skip(n: Int): List<T>

    /// 转换为字符串（逗号分隔）
    fun toString(): String
}
