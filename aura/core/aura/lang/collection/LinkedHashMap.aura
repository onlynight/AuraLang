// aura:///aura/lang/collection/LinkedHashMap.aura
package aura.lang.collection
// 集合包：LinkedHashMap 实现（保持插入顺序）

import aura.lang.collection.ArrayList
import aura.lang.collection.Collections
import aura.lang.collection.HashMap
import aura.lang.collection.Map

/// LinkedHashMap<K, V> — 保持插入顺序的映射。
///
/// - 内部维护顺序列表 + HashMap 双结构
/// - 插入顺序与遍历顺序一致
/// - 支持按插入顺序遍历键和值
/// - 时间复杂度：add/remove/lookup O(1) 均摊
///
/// @see HashMap, Map, LinkedHashMap
/// @since 0.5
class LinkedHashMap<K, V> : Map<K, V> {

    private var map: HashMap<K, V>
    private var keys: ArrayList<K>
    private var values: ArrayList<V>
    private var _size: Int = 0

    constructor() {
        this.map = HashMap<K, V>()
        this.keys = ArrayList<K>()
        this.values = ArrayList<V>()
        this._size = 0
    }

    /// 映射的条目数量
    override fun getSize(): Int {
        return _size
    }

    /// 按键获取值（不存在或已删除返回 null）
    override fun get(key: K): V {
        return map.get(key)
    }

    /// 按键获取值，不存在或已删除时返回默认值
    override fun getOrDefault(key: K, default: V): V {
        return map.getOrDefault(key, default)
    }

    /// 按键写入值，返回被替换的旧值（原本不存在返回 null）
    /// 新插入的键追加到顺序末尾；覆盖已有键时保持原位置
    override fun put(key: K, value: V): V {
        var old: V = null
        var existed: Boolean = map.containsKey(key)
        var existing: V = map.get(key)
        if (existing != null) {
            old = existing
        }
        map.put(key, value)
        if (existed == false) {
            keys.add(key)
            values.add(value)
            _size = _size + 1
        } else {
            // 更新值列表中的对应位置
            var i: Int = keys.indexOf(key)
            if (i >= 0) {
                values.set(i, value)
            }
        }
        return old
    }

    /// 移除指定键，返回被移除的值（原本不存在返回 null）
    /// 同时从顺序列表中移除对应位置
    override fun removeItem(key: K): V {
        var value: V = map.get(key)
        map.removeItem(key)
        if (value != null) {
            var idx: Int = keys.indexOf(key)
            if (idx >= 0) {
                keys.remove(idx)
                values.remove(idx)
                _size = _size - 1
            }
        }
        return value
    }

    /// 清空映射
    override fun clear(): Unit {
        map.clear()
        keys.clear()
        values.clear()
        _size = 0
    }

    /// 检查映射是否为空
    override fun isEmpty(): Boolean {
        return _size == 0
    }

    /// 检查是否包含指定键
    override fun containsKey(key: K): Boolean {
        return map.containsKey(key)
    }

    /// 检查是否包含指定值
    override fun containsValue(value: V): Boolean {
        return map.containsValue(value)
    }

    /// 获取所有键（按插入顺序）
    override fun keys(): List<K> {
        return this.keys
    }

    /// 获取所有值（按插入顺序）
    override fun values(): List<V> {
        return this.values
    }

    /// 按插入顺序获取第一个键
    fun firstKey(): K {
        if (_size == 0) {
            return null
        }
        return keys.getAt(0)
    }

    /// 按插入顺序获取最后一个键
    fun lastKey(): K {
        if (_size == 0) {
            return null
        }
        return keys.getAt(_size - 1)
    }

    /// 按插入顺序获取指定位置的键
    fun keyAt(index: Int): K {
        if (index < 0 || index >= _size) {
            return null
        }
        return keys.getAt(index)
    }

    /// 按插入顺序获取指定位置的值
    fun valueAt(index: Int): V {
        if (index < 0 || index >= _size) {
            return null
        }
        return values.getAt(index)
    }
}
