// aura:///aura/lang/collection/ArrayList.aura
package aura.lang.collection
// 集合包：ArrayList 实现（基于动态数组的 List）

import aura.lang.collection.List
import aura.lang.collection.Collection
import aura.lang.collection.Array

/// ArrayList<T> — 基于动态数组的列表实现。
///
/// - 时间复杂度：get O(1), add O(1) 均摊, remove O(n)
/// - 空间复杂度：O(n)
/// - 随机访问快速，插入删除较慢（需要移动元素）
///
/// @see List, LinkedList, HashMap
/// @since 0.5
class ArrayList<T> : List<T> {

    // ── 内部存储 ──

    // 底层列表存储
    private var data: List<T>

    // 手动跟踪元素数量
    private var _size: Int

    // ── 构造 ──

    /// 创建空列表
    constructor() {
        data = arrayListOf<T>()
        _size = 0
    }

    // ── 属性 ──

    /// 元素数量（属性形式，`xs.size`）
    val size: Int
        get() = this.getSize()

    /// 获取元素数量（Kotlin 风格 getter，供 `size` 属性调用）
    fun getSize(): Int {
        return _size
    }

    // ── Collection 接口实现 ──

    /// 元素数量（Collection 接口）
    override fun count(): Int {
        return _size
    }

    /// 按下标获取元素（Collection 接口）
    override fun getAt(index: Int): T {
        return this.get(index)
    }

    /// 检查列表是否为空（Collection 接口）
    override fun isEmpty(): Boolean {
        return _size == 0
    }

    // ── 访问方法 ──

    /// 按下标获取元素
    fun get(index: Int): T {
        return Collections.listGet(data, index)
    }

    /// 按下标设置元素
    fun set(index: Int, value: T): Unit {
        if (index < 0 || index >= _size) {
            throw "index: $index, size: $_size"
        }
        Collections.listSet(data, index, value)
    }

    /// 获取第一个元素
    override fun first(): T {
        if (_size == 0) throw "list is empty"
        return data[0]
    }

    /// 获取最后一个元素
    override fun last(): T {
        if (_size == 0) throw "list is empty"
        return data[_size - 1]
    }

    // ── 修改方法 ──

    /// 在末尾添加元素
    fun add(item: T): Unit {
        data.add(item)
        _size = _size + 1
    }

    /// 移除指定位置的元素
    ///
    /// 注意：必须**回写 `data` 并递减 `_size`**。旧实现只构造了 `newData` 却
    /// 从未赋值回去（等于删除无效），且返回的是索引处的原值、长度也不变 ——
    /// 实测 `l.remove(0)` 返回 0、`size` 仍为 2。
    fun remove(index: Int): T {
        if (index < 0 || index >= _size) {
            throw "index: $index, size: $_size"
        }
        val item: T = this.get(index)
        // **必须用 `arrayListOf<T>()` 重建**：`data` 字段在运行期始终是
        // 运行期列表**句柄**（`AuraDynList`，由 `Collections.listGet/listAppend` 操作）。
        // 若换成 `ArrayList<T>()`（用户类实例），后续 `get()` 会把类指针当句柄
        // 解引用 —— 实测 `l.remove(1)` 之后 `get(0)` 返回垃圾 `1346554367`。
        val newData = arrayListOf<T>()
        var i: Int = 0
        while (i < _size) {
            if (i != index) {
                newData.add(this.get(i))
            }
            i = i + 1
        }
        data = newData
        _size = _size - 1
        return item
    }

    /// 清空列表
    fun clear(): Unit {
        data = arrayListOf<T>()
        _size = 0
    }

    // ── 查找方法 ──

    /// 检查列表是否包含指定元素
    override fun contains(item: T): Boolean {
        var i: Int = 0
        while (i < _size) {
            if (Collections.listGet(data, i) == item) {
                return true
            }
            i = i + 1
        }
        return false
    }

    /// 查找元素的索引（未找到返回 -1）
    override fun indexOf(item: T): Int {
        var i: Int = 0
        while (i < _size) {
            if (Collections.listGet(data, i) == item) {
                return i
            }
            i = i + 1
        }
        return -1
    }

    /// 查找元素的最后一个索引（未找到返回 -1）
    override fun lastIndexOf(item: T): Int {
        var i: Int = _size - 1
        while (i >= 0) {
            if (Collections.listGet(data, i) == item) {
                return i
            }
            i = i - 1
        }
        return -1
    }

    // ── 过滤与转换 ──

    /// 按条件过滤
    override fun filter(predicate: (T) -> Boolean): List<T> {
        var result = arrayListOf<T>()
        var i: Int = 0
        while (i < _size) {
            if (predicate(this.get(i))) {
                result.add(this.get(i))
            }
            i = i + 1
        }
        return result
    }

    /// 转换每个元素
    override fun map(transform: (T) -> Any): List<Any> {
        var result = arrayListOf<Any>()
        var i: Int = 0
        while (i < _size) {
            result.add(transform(this.get(i)))
            i = i + 1
        }
        return result
    }

    /// 获取所有不同元素
    override fun distinct(): List<T> {
        var result = arrayListOf<T>()
        var i: Int = 0
        while (i < _size) {
            var elem = this.get(i)
            if (!result.contains(elem)) {
                result.add(elem)
            }
            i = i + 1
        }
        return result
    }

    // ── 全量检查 ──

    /// 检查是否所有元素都满足条件
    override fun every(predicate: (T) -> Boolean): Boolean {
        var i: Int = 0
        while (i < _size) {
            if (!predicate(this.get(i))) {
                return false
            }
            i = i + 1
        }
        return true
    }

    /// 检查是否存在满足条件的元素
    override fun any(predicate: (T) -> Boolean): Boolean {
        var i: Int = 0
        while (i < _size) {
            if (predicate(this.get(i))) {
                return true
            }
            i = i + 1
        }
        return false
    }

    // ── 范围操作 ──

    /// 取前 n 个元素
    override fun take(n: Int): List<T> {
        var cnt = minOf(n, _size)
        var result = arrayListOf<T>()
        var i: Int = 0
        while (i < cnt) {
            result.add(this.get(i))
            i = i + 1
        }
        return result
    }

    /// 跳过前 n 个元素
    override fun skip(n: Int): List<T> {
        var start = minOf(n, _size)
        var result = arrayListOf<T>()
        var i: Int = start
        while (i < _size) {
            result.add(this.get(i))
            i = i + 1
        }
        return result
    }

    // ── 聚合方法 ──

    /// Plan A 拆箱：把装箱整数 `(v<<1)|1` 还原为 `Int`。
    ///
    /// `T` 被擦除为 `i8*`，集合里存的是**装箱句柄**（`Elem` 为 Int 时是奇数）。
    /// 直接 `as Int` 拿到的是句柄本身（1 → 3），比较/求和全错 ——
    /// 实测 `sum()` 得 0、`min()` 得 3。
    private fun unboxInt(v: T): Int {
        val bits: Long = v as Long
        return ((bits >> 1) as Int)
    }

    /// 计算所有元素的 sum
    fun sum(): Int {
        var result: Int = 0
        var i: Int = 0
        while (i < _size) {
            result = result + this.unboxInt(this.get(i))
            i = i + 1
        }
        return result
    }

    /// 获取最小值
    fun min(): T {
        if (_size == 0) throw "list is empty"
        var best: T = this.get(0)
        var i: Int = 1
        while (i < _size) {
            val cur: T = this.get(i)
            if (this.unboxInt(cur) < this.unboxInt(best)) {
                best = cur
            }
            i = i + 1
        }
        return best
    }

    /// 获取最大值
    fun max(): T {
        if (_size == 0) throw "list is empty"
        var best: T = this.get(0)
        var i: Int = 1
        while (i < _size) {
            val cur: T = this.get(i)
            if (this.unboxInt(cur) > this.unboxInt(best)) {
                best = cur
            }
            i = i + 1
        }
        return best
    }

    // ── 转换 ──

    /// 转换为字符串（逗号分隔）
    override fun toString(): String {
        var result: String = "["
        var i: Int = 0
        while (i < _size) {
            if (i > 0) {
                result = result + ", "
            }
            result = result + this.get(i)
            i = i + 1
        }
        result = result + "]"
        return result
    }

    // ── 辅助函数 ──

    private fun minOf(a: Int, b: Int): Int {
        if (a < b) return a
        return b
    }
}
