// aura:///aura/lang/native/time/Clock.aura
package aura.lang.native.time
import aura.lang.native.Syscalls
import aura.lang.native.Memory
import aura.lang.native.Cpu

/// Time structure
struct Time {
    var sec: Long = 0
    var nsec: Long = 0

    fun timestamp(): Double {
        return sec + nsec / 1000000000.0
    }
}

/// Time/clock operations - declarations
extern interface Clock {
    const val CLOCK_REALTIME: Int = 0
    const val CLOCK_MONOTONIC: Int = 1
    const val CLOCK_PROCESS_CPUTIME_ID: Int = 2
    const val CLOCK_THREAD_CPUTIME_ID: Int = 3

    @native(SYS_CLOCK_GETTIME) fun clockGettime(clock: Int, ts: Long): Long
}

/// Time/clock operations - implementation
object ClockImpl {
    var tsBuf: Long = 0

    fun init(): Boolean {
        tsBuf = Memory.alloc(16)
        return tsBuf != 0
    }

    fun now(): Time {
        if (tsBuf == 0) { return Time() }
        var t: Time = Time()
        val ret: Long = Clock.clockGettime(0, tsBuf)
        if (ret == 0) {
            t.sec = Memory.read64(tsBuf)
            t.nsec = Memory.read64(tsBuf + 8)
        }
        return t
    }

    fun timeMs(): Long {
        val t: Time = now()
        return t.sec * 1000 + t.nsec / 1000000
    }

    fun timeUs(): Long {
        val t: Time = now()
        return t.sec * 1000000 + t.nsec / 1000
    }

    fun timeNs(): Long {
        val t: Time = now()
        return t.sec * 1000000000 + t.nsec
    }

    fun sleep(ms: Long) {
        if (ms <= 0) { return }
        val startNs: Long = timeNs()
        val endNs: Long = startNs + ms * 1000000
        while (timeNs() < endNs) {
            Cpu.memFence()
        }
    }
}
