package aura.lang.native.arch.aarch64_linux
// ─────────────────────────────────────────────────────────────
// aarch64 Linux 系统调用表 — Phase S3
//
// aarch64 Linux 系统调用号与 x86_64 不同。
// 通过 syscall 指令调用（SVCall）。
// ─────────────────────────────────────────────────────────────

import aura.lang.native.Memory

/// aarch64 Linux 系统调用
extern object Syscalls {

