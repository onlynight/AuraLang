// aura:///aura/lang/native/Runtime.aura
package aura.lang.native
import aura.lang.native.Syscalls
import aura.lang.native.Memory
import aura.lang.native.Cpu
import aura.lang.native.memory.Allocator
import aura.lang.std.string.StringOps
import aura.lang.native.console.Console

/// Runtime - declarations
extern interface Runtime {
    @native(asm = "lock inc qword [rdi]") fun arcIncrement(ptr: Long)
    @native(asm = "lock dec qword [rdi]") fun arcDecrement(ptr: Long): Long
    @native(asm = "nop") fun coroutineYield(ctx: Long)
}

/// Runtime - implementation
object RuntimeImpl {
    const val ARC_COUNT_OFFSET: Long = 0

    var allocTotal: Long = 0
    var allocLive: Long = 0
    var allocCount: Int = 0
    var freeCount: Int = 0

    fun init(): Boolean {
        val ok: Boolean = Allocator.init()
        if (!ok) { return false }
        return true
    }

    fun version(): String {
        return "Aura Runtime 0.1.0 (Phase 1)"
    }

    fun memUsedMb(): Int {
        val used: Long = Allocator.used()
        val mb: Long = used / (1024 * 1024)
        return mb as Int
    }

    fun trackAlloc(size: Long) {
        allocTotal = allocTotal + size
        allocLive = allocLive + size
        allocCount = allocCount + 1
    }

    fun trackFree(size: Long) {
        allocLive = allocLive - size
        freeCount = freeCount + 1
    }
}
