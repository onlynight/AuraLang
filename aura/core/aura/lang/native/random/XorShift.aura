// aura:///aura/lang/native/random/XorShift.aura
package aura.lang.native.random
// ------------------------------------------------------------------
// Random number generation -- Phase S2
//
// Implements XorShift pseudo-random number generator.
// No syscalls needed, pure Aura implementation.
//
// Usage:
//   val rng: XorShift = XorShift.seedTime()
//   val n: Long = rng.next()
// ------------------------------------------------------------------

import aura.lang.native.time.Clock

/// XorShift pseudo-random number generator
struct XorShift {
    var state: Long = 1

    init(seed: Long) {
        state = seed
        if (state == 0) {
            state = 1
        }
    }

    /// Generate next random number
    fun next(): Long {
        var x: Long = state
        x = x ^ (x << 13)
        x = x ^ (x >> 7)
        x = x ^ (x << 17)
        state = x
        return x
    }

    /// Generate random number in range [0, bound)
    fun nextRange(bound: Long): Long {
        if (bound <= 0) { return 0 }
        return next() % bound
    }

    /// Generate float random number [0.0, 1.0)
    fun nextFloat(): Double {
        return (next() & 0xFFFFFFFFL) / 4294967295.0
    }

    /// Seed with current time
    fun seedTime(): XorShift {
        val t: Long = Clock.timeNs()
        return XorShift(t)
    }
}

/// Global random number generator (singleton)
object Random {
    var rng: XorShift = XorShift.seedTime()

    /// Generate next random number
    fun next(): Long {
        return rng.next()
    }

    /// Generate random number in range
    fun nextRange(bound: Long): Long {
        return rng.nextRange(bound)
    }

    /// Generate float random number
    fun nextFloat(): Double {
        return rng.nextFloat()
    }

    /// Re-seed
    fun reseed(seed: Long) {
        rng = XorShift(seed)
    }
}
