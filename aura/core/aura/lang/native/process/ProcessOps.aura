// aura:///aura/lang/native/process/ProcessOps.aura
package aura.lang.native.process
// ------------------------------------------------------------------
// Process management -- Phase S2
//
// Provides process creation, exit, wait operations.
//
// Usage:
//   ProcessOps.exit(0)
//   val pid: Int = ProcessOps.wait(0)
// ------------------------------------------------------------------

import aura.lang.native.Syscalls

/// Process management
extern object ProcessOps {

    // -- Syscall declarations --
    @native(SYS_EXIT_GROUP) fun exitGroup(code: Int)
    @native(SYS_WAIT4)      fun wait4(pid: Int, status: Long, options: Int, rusage: Long): Int
    @native(SYS_EXECVE)     fun execve(path: Long, args: Long, env: Long): Long
    @native(SYS_GETPID)     fun getpid(): Int

    /// Exit program
    fun exit(code: Int) {
        exitGroup(code)
    }

    /// Wait for child process to finish
    fun wait(pid: Int): Int {
        return wait4(pid, 0, 0, 0)
    }

    /// Execute external program (replace current process)
    fun exec(path: Long, args: Long, env: Long): Long {
        return execve(path, args, env)
    }

    /// Get current process ID
    fun getPid(): Int {
        return getpid()
    }
}
