// aura:///aura/lang/native/thread/ThreadOps.aura
package aura.lang.native.thread
// ─────────────────────────────────────────────────────────────────────────────
// 线程桥原语（Layer 0-A）
//
// 这些是「把一段 Aura 函数交给 OS 线程执行」所必需的**最小**运行时桥：
//
//   * create(fn_id, arg)  —— 新建 OS 线程，在**独立 VM 实例**上执行函数表中
//                            下标为 `fn_id` 的函数，并把 `arg` 作为唯一实参；
//                            返回线程句柄（>0 成功）。
//   * join(thread_id)     —— 阻塞等待线程结束并取回其返回值。
//   * sleepMs / currentId / cores —— 休眠、当前线程标识、可用核心数。
//
// 为什么这层**必须**是 native：
//   `create` 需要克隆宿主模块、为新线程建立一整套 VM 执行环境（帧栈 / 常量池 /
//   natives 表 / 线程局部 VM 指针），并在函数返回后把结果回传给 `join`。
//   Aura 源码层既看不到 VM 指针，也没有「建立帧栈」这种能力，因此这一步无法用
//   Aura 表达；它不是业务逻辑，而是执行环境桥接。
//
// 反过来，凡是能表达的逻辑（句柄分配、状态机、Future 的结果槽 / all / any /
// cancel 等）都放在 `aura.lang.concurrent` 的纯 Aura 实现里，本文件只提供上面
// 这几个原子操作，不得再往里塞业务语义。
//
// 实现方：VM / 运行库（与 `aura.lang.native.Memory` 同层）。
// AOT 路径下由运行库直接调用 `aura_thread_create/join/...` C 封装。
// ─────────────────────────────────────────────────────────────────────────────

extern object ThreadOps {

    /// 新建 OS 线程执行函数 `fn_id(arg)`，返回线程句柄（0 表示失败）。
    native fun create(fn_id: Int, arg: Int): Int

    /// 等待线程结束并返回其返回值（线程不存在时返回 0）。
    native fun join(thread_id: Int): Int

    /// 休眠指定毫秒数。
    native fun sleepMs(ms: Int): Unit

    /// 当前线程标识。
    native fun currentId(): Int

    /// 可用 CPU 核心数（并行度）。
    native fun cores(): Int
}
