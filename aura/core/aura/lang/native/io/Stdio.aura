// aura:///aura/lang/native/io/Stdio.aura
package aura.lang.native.io
// ------------------------------------------------------------------
// 高级 I/O — 纯 Aura 实现
//
// 为 Aura String 提供高级 I/O 接口，委托到 native 包的底层系统调用。
//
// 依赖：
//   - aura.lang.native.Memory         内存读写
//   - aura.lang.native.memory.Allocator  内存分配
//   - aura.lang.native.console.Console   控制台输出（底层 write 系统调用）
//   - aura.lang.native.file.FileOps      文件 I/O（底层 syscall）
//   - aura.lang.native.Syscalls           系统调用常量
//
// 字符串与缓冲区转换：
//   - stringToBuffer：Aura String → 内存缓冲区（含 NUL 终止符）
//   - bufferToString：内存缓冲区 → Aura String
//
// @since 0.1
// ------------------------------------------------------------------

import aura.lang.native.Memory
import aura.lang.native.memory.Allocator
import aura.lang.native.console.Console
import aura.lang.native.file.FileOps
import aura.lang.native.Syscalls
import aura.lang.std.string.StringBuilder

/// 高级标准 I/O（纯 Aura 实现，委托到 native 包）
object Stdio {

    /// 换行字节缓冲（懒初始化，全生命周期复用）。
    ///
    /// 不再使用 `Console.getNewlineBuffer()`：`Console` 是 `extern object`，
    /// AOT 前端把其成员**一律按外部 C 符号处理**（只 `declare`、不发射函数体，
    /// 见 `Emit.aura` 的 `fExternFnIds`），而 `getNewlineBuffer` 既没有 C 实现
    /// 也没有 Aura `define` → llc 报
    /// `use of undefined value '@getNewlineBuffer'`。
    /// 这里自建 1 字节缓冲，只依赖普通 Aura 模块（`Allocator`/`Memory`）与
    /// `Console.writeStdout`（`@native` 包装器，可正常发射）。
    var nlBuf: Long = 0

    // ═══════════════════════════════════════════════════════════════
    // String ↔ Buffer 转换
    // ═══════════════════════════════════════════════════════════════

    /// 将 Aura String 复制到内存缓冲区（含 NUL 终止符）。
    /// 返回缓冲区地址，失败返回 0。
    fun stringToBuffer(s: String): Long {
        // ⚠️ 必须先判空再取长度：`s.length` 在 AOT 下是 `strlen`，
        // 对 null 指针调用会直接 0xC0000005（自举编译器崩溃根因）。
        if (s == null) {
            val buf: Long = Allocator.malloc(1)
            if (buf == 0) { return 0 }
            Memory.write(buf, 0)
            return buf
        }
        // `s.length` 在 AOT 下是 `strlen`（O(n)）：必须先取出到局部量，
        // 否则循环条件里的 `s.length` 会让整段退化成 O(n²)。
        val slen: Int = s.length
        if (slen == 0) {
            val buf: Long = Allocator.malloc(1)
            if (buf == 0) { return 0 }
            Memory.write(buf, 0)
            return buf
        }
        val len: Long = slen as Long + 1  // +1 for NUL terminator
        val buf: Long = Allocator.malloc(len)
        if (buf == 0) { return 0 }
        var i: Int = 0
        while (i < slen) {
            Memory.write(buf + i, s.charCodeAt(i))
            i = i + 1
        }
        Memory.write(buf + (slen as Long), 0)  // NUL terminator
        return buf
    }

    /// 将内存缓冲区转换为 Aura String（不包含 NUL 终止符）。
    ///
    /// 缓冲区 → Aura String（遇 NUL 截断）。
    ///
    /// 实现：`StringBuilder.appendByte`（摊销 O(1)，容量倍增）逐字节追加，
    /// 末尾一次 `build()`（`ReadCStr` 独立拷贝，AOT/VM 双后端一致）。
    ///
    /// ⚠ 历史两个坑（都实测过）：
    ///   1. 零拷贝「在 `maxLen` 处补 NUL，返回 `buf` 本身」——AOT 下成立
    ///      （String 就是 `i8*`），但种子 VM 的 String 是 Rust String，
    ///      返回 Long 实测得到「指针值的十进制文本」（R67 前的状态）。
    ///   2. R67 改成「`out = out + String.fromCharCode(c)` 逐字符拼接」——
    ///      语义对了，但每次 `+` 复制整段已累积前缀 → 读 n 字节分配
    ///      ≈ n²/2 字节。自举驱动全量构建读 370KB 的 PhotonRuntime.aura
    ///      需要 ≈68GB，2026-10-15 实测 AURA_MEM_LIMIT_MB=24576 直接 OOM
    ///      （见 build/jit-verify/diag2.txt：单拼接点 23 万次调用 1990MB）。
    ///      本版恢复线性。
    ///
    /// **注意**：返回的 String 是独立内存，与 `buf` 解耦 —— 调用方此后
    /// 可以 `Allocator.free(buf)`（逐字节循环里 `Memory.read` 只读不写）。
    fun bufferToString(buf: Long, maxLen: Long): String {
        if (buf == 0) { return "" }
        if (maxLen <= 0) { return "" }
        val sb: StringBuilder = StringBuilder()
        var i: Long = 0
        while (i < maxLen) {
            val c: Int = Memory.read(buf + i)
            if (c == 0) { break }
            sb.appendByte(c)
            i = i + 1
        }
        return sb.build()
    }

    /// 计算缓冲区中字符串的长度（不含 NUL 终止符）。
    fun strlen(buf: Long): Long {
        if (buf == 0) { return 0 }
        var n: Long = 0
        var c: Byte = Memory.read(buf + n)
        while (c != 0) {
            n = n + 1
            c = Memory.read(buf + n)
        }
        return n
    }

    // ═══════════════════════════════════════════════════════════════
    // 标准输出
    // ═══════════════════════════════════════════════════════════════

    /// 输出字符串（带换行）。
    fun println(msg: String): Unit {
        val buf: Long = stringToBuffer(msg)
        if (buf == 0) { return }
        val len: Long = strlen(buf)
        Console.writeStdout(buf, len)
        // 换行：复用自建的 1 字节缓冲（见 `nlBuf` 字段说明）。
        if (nlBuf == 0) {
            nlBuf = Allocator.malloc(1)
            if (nlBuf != 0) {
                Memory.write(nlBuf, 10)
            }
        }
        if (nlBuf != 0) {
            Console.writeStdout(nlBuf, 1)
        }
    }

    /// 输出字符串（不带换行）。
    fun print(msg: String): Unit {
        val buf: Long = stringToBuffer(msg)
        if (buf == 0) { return }
        val len: Long = strlen(buf)
        Console.writeStdout(buf, len)
    }

    /// 刷新标准输出（无缓冲实现，直接写入）。
    fun flush(): Unit {
        // 无缓冲，无需刷新
    }

    // ═══════════════════════════════════════════════════════════════
    // 标准输入
    // ═══════════════════════════════════════════════════════════════

    /// 从标准输入读取一行（不含换行符）。
    fun readLine(): String {
        val buf: Long = Allocator.malloc(4096)
        if (buf == 0) { return "" }
        // 使用 SYS_READ 读取
        val fd: Int = 0  // stdin
        val bytesRead: Long = FileOps.read(fd, buf, 4096)
        if (bytesRead <= 0) {
            Allocator.free(buf)
            return ""
        }
        // 找到换行符并截断
        var end: Long = bytesRead
        var i: Long = 0
        while (i < bytesRead) {
            val c: Byte = Memory.read(buf + i)
            if (c == 10) {  // '\n'
                end = i
                break
            }
            i = i + 1
        }
        // bufferToString 返回独立字符串，缓冲区可归还
        val line: String = bufferToString(buf, end)
        Allocator.free(buf)
        return line
    }

    /// 从标准输入读取全部（直到 EOF）。
    fun readAll(): String {
        val buf: Long = Allocator.malloc(65536)
        if (buf == 0) { return "" }
        var result: String = ""
        var total: Long = 0
        var bytesRead: Long
        while (true) {
            bytesRead = FileOps.read(0, buf + total, 65536 - total)
            if (bytesRead <= 0) { break }
            total = total + bytesRead
            if (total >= 65536) { break }
        }
        if (total <= 0) {
            Allocator.free(buf)
            return ""
        }
        // bufferToString 返回独立字符串，缓冲区可归还
        val out: String = bufferToString(buf, total)
        Allocator.free(buf)
        return out
    }

    // ═══════════════════════════════════════════════════════════════
    // 文件操作
    // ═══════════════════════════════════════════════════════════════

    /// 读取文件内容（文本）。
    ///
    /// **不依赖 `struct stat` 布局**：早期实现用
    /// `FileOps.fstat(fd, statBuf)` + `Memory.read64(statBuf + 48)` 取 Linux 的
    /// `st_size` 偏移；Windows 上 `fstat` 落到 CRT `_fstat`（写入 `struct _stat`，
    /// 布局不同）→ 读到垃圾长度 → `Allocator.malloc(垃圾)` → 段错误 / 无界分配。
    ///
    /// 现改为「按块 `read` 直到返回 0（EOF）」+ 按需扩容，跨平台无结构体布局依赖。
    fun readFile(path: String): String {
        val pathBuf: Long = stringToBuffer(path)
        if (pathBuf == 0) { return "" }

        val fd: Int = FileOps.open(pathBuf, 0)  // O_RDONLY
        Allocator.free(pathBuf)
        if (fd < 0) {
            return ""
        }

        val chunk: Long = 65536
        var buf: Long = Allocator.malloc(chunk)
        if (buf == 0) {
            FileOps.close(fd)
            return ""
        }
        var cap: Long = chunk
        var total: Long = 0
        while (true) {
            if (total >= cap) {
                // 扩容：新缓冲 + 逐字节拷贝（AOT 下无 realloc 语义保证）
                val ncap: Long = cap * 2
                val nbuf: Long = Allocator.malloc(ncap)
                if (nbuf == 0) { break }
                var k: Long = 0
                while (k < total) {
                    Memory.write(nbuf + k, Memory.read(buf + k))
                    k = k + 1
                }
                Allocator.free(buf)
                buf = nbuf
                cap = ncap
            }
            val n: Long = FileOps.read(fd, buf + total, cap - total)
            if (n <= 0) { break }
            total = total + n
        }
        if (total <= 0) {
            Allocator.free(buf)
            FileOps.close(fd)
            return ""
        }
        // bufferToString 返回独立字符串（见其注释），缓冲区这里归还
        // （旧零拷贝契约「不能再 free」已失效；不 free 会让每个源文件的
        // 缓冲区驻留到进程退出——闭包 6.2MB 全量 ≈ 双倍占用）。
        val content: String = bufferToString(buf, total)
        Allocator.free(buf)
        FileOps.close(fd)
        return content
    }

    /// 写入文件内容。返回是否成功。
    fun writeFile(path: String, content: String): Boolean {
        val pathBuf: Long = stringToBuffer(path)
        if (pathBuf == 0) { return false }

        // 标志位用 **Linux 约定**（Aura 侧唯一真相源，见 `SyscallsUtils.O_*`）：
        // O_WRONLY(1) | O_CREAT(0x40) | O_TRUNC(0x200)。
        // Windows 目标由 AOT 发射器的 CRT 包装器把标志位翻译成 `_O_*`
        //（`_O_CREAT=0x100`；直接透传 0x40 会被 UCRT 判为非法标志 → open 失败）。
        val fd: Int = FileOps.open(pathBuf, 1 | 0x40 | 0x200)
        if (fd < 0) {
            Allocator.free(pathBuf)
            return false
        }

        val contentBuf: Long = stringToBuffer(content)
        if (contentBuf == 0) {
            FileOps.close(fd)
            Allocator.free(pathBuf)
            return false
        }
        val len: Long = strlen(contentBuf)
        var written: Long = 0
        while (written < len) {
            val n: Long = FileOps.write(fd, contentBuf + written, len - written)
            if (n <= 0) { break }
            written = written + n
        }

        FileOps.close(fd)
        Allocator.free(contentBuf)
        Allocator.free(pathBuf)
        return written == len
    }

    /// 检查文件是否存在。
    fun fileExists(path: String): Boolean {
        val pathBuf: Long = stringToBuffer(path)
        if (pathBuf == 0) { return false }
        val result: Int = FileOps.access(pathBuf, 0)  // F_OK
        Allocator.free(pathBuf)
        return result == 0
    }
}
