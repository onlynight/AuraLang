// aura:///aura/lang/native/memory/Allocator.aura
package aura.lang.native.memory
// ------------------------------------------------------------------
// Memory allocator -- Phase S1
//
// 委托到 Memory.alloc / Memory.free（libc malloc/free）。
// 替换旧版 bump allocator（不支持 free，导致内存泄漏）。
//
// Usage:
//   val addr: Long = Allocator.malloc(100)
//   Memory.write(addr, 0x42 as Byte)
//   val v: Byte = Memory.read(addr)
//   Allocator.free(addr)
// ------------------------------------------------------------------

import aura.lang.native.Memory

/// Memory allocator（委托到 libc malloc/free）
object Allocator {

    // -- Constants --
    const val PROT_READ: Int = 1
    const val PROT_WRITE: Int = 2
    const val PROT_EXEC: Int = 4
    const val MAP_PRIVATE: Int = 2
    const val MAP_ANONYMOUS: Int = 0x20
    const val MAP_FAILED: Long = -1

    // -- Internal state --
    var heapPtr: Long = 0
    var heapEnd: Long = 0
    private var heapStart: Long = 0
    private var totalAllocs: Long = 0
    private var totalFrees: Long = 0

    /// Allocate memory (delegates to libc malloc).
    fun malloc(n: Long): Long {
        if (n <= 0) { return 0 }
        val addr: Long = Memory.alloc(n)
        if (addr != 0) {
            totalAllocs = totalAllocs + 1
        }
        return addr
    }

    /// Free memory (delegates to libc free).
    fun free(addr: Long) {
        if (addr == 0) { return }
        Memory.free(addr)
        totalFrees = totalFrees + 1
    }

    /// Reallocate (allocate new space and copy).
    fun realloc(addr: Long, newSize: Long): Long {
        if (addr == 0) {
            return malloc(newSize)
        }
        val newAddr: Long = malloc(newSize)
        if (newAddr == 0) {
            return 0
        }
        // Copy old data to new address
        // Note: oldSize is not tracked; copy up to newSize bytes
        Memory.copy(newAddr, addr, newSize)
        free(addr)
        return newAddr
    }

    /// Map memory (mmap with PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS).
    fun mmap(length: Long, prot: Int, flags: Int): Long {
        val addr: Long = Memory.mmap(0, length, prot, flags, -1, 0)
        if (addr == MAP_FAILED) {
            return 0
        }
        return addr
    }

    /// Unmap memory (munmap).
    fun munmap(addr: Long, length: Long): Int {
        return Memory.munmap(addr, length)
    }

    /// Change memory protection (mprotect).
    fun mprotect(addr: Long, length: Long, prot: Int): Int {
        return Memory.mprotect(addr, length, prot)
    }

    /// Query total allocations.
    fun totalAllocs(): Long {
        return totalAllocs
    }

    /// Query total frees.
    fun totalFrees(): Long {
        return totalFrees
    }
}
