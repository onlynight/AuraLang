// aura:///aura/lang/native/Memory.aura
package aura.lang.native
// ─────────────────────────────────────────────────────────────
// 内存操作声明 + Arena 分配器 — Phase S1 + Phase 4.1
//
// 编译器内置内存操作（直接降低到 LLVM load/store 或 syscall）
// Arena 分配器（使用 mmap 分配大块内存，bump pointer 分配）
//
// 使用 extern interface 封装：
//   - `fun`（无 @native 注解）→ 编译器内置（load/store/alloc/free）
//   - `@native(SYS_MMAP)` / `@native(SYS_MPROTECT)` → 系统调用
//   - `@native(asm = "atomicrmw")` → ARC 原子操作
//
// ─────────────────────────────────────────────────────────────

import aura.lang.native.Syscalls

// 编译器内置内存操作
extern interface Memory {

    // ═══════════════════════════════════════════════════════════
    // 内存读写（编译器内置：直接降低到 LLVM load/store 指令）
    // ═══════════════════════════════════════════════════════════

    fun read(addr: Long): Byte
    fun read16(addr: Long): Short
    fun read32(addr: Long): Int
    fun read64(addr: Long): Long

    /// 原子 `fetch_add`：返回**旧值**，`[addr] ← [addr] + delta`。
    ///
    /// Mutex / Condvar 自旋锁的底座（内联汇编 `lock xaddq`）。
    ///
    /// 声明在 `Memory` 而不是 `Cpu` 是因为 `extern interface Cpu` 的
    /// `@native(asm = ...)` 成员目前无法进入 `singletonCsv`，调用点的
    /// 接收者不会被丢弃（实参整体错位一位）；`Memory` 是稳定注册的单例。
    @native(asm = "lock xaddq") fun atomicAdd(addr: Long, delta: Long): Long
    fun write(addr: Long, v: Byte)
    fun write16(addr: Long, v: Short)
    fun write32(addr: Long, v: Int)
    fun write64(addr: Long, v: Long)
    fun copy(dst: Long, src: Long, n: Long)
    fun set(addr: Long, v: Byte, n: Long)

    // ═══════════════════════════════════════════════════════════
    // 内存分配（编译器内置：调用 libc malloc/free）
    // ═══════════════════════════════════════════════════════════

    fun alloc(n: Long): Long
    fun free(addr: Long)

    // ═══════════════════════════════════════════════════════════
    // 内存映射（系统调用：mmap/mprotect/munmap）
    // ═══════════════════════════════════════════════════════════

    @native(SYS_MMAP) fun mmap(addr: Long, length: Long, prot: Int, flags: Int, fd: Int, offset: Long): Long
    @native(SYS_MUNMAP) fun munmap(addr: Long, length: Long): Int
    @native(SYS_MPROTECT) fun mprotect(addr: Long, length: Long, prot: Int): Int

    // ═══════════════════════════════════════════════════════════
    // ARC 引用计数（原子操作：LLVM atomicrmw）
    // ═══════════════════════════════════════════════════════════

    @native(asm = "lock inc") fun arcIncrement(addr: Long): Long
    @native(asm = "lock dec") fun arcDecrement(addr: Long): Long
}

// ═══════════════════════════════════════════════════════════════
// Arena 内存分配器 — Phase 4.1
// ═══════════════════════════════════════════════════════════════
//
// 使用 mmap 分配大块内存，内部使用 bump pointer 分配。
// 零外部依赖，纯 Aura 实现。
// ═══════════════════════════════════════════════════════════════

/// Arena 内存分配器
/// 使用 mmap 分配大块内存，内部使用 bump pointer 分配
object ArenaAllocator {
    var baseAddr: Long = 0          // 基地址
    var currentPtr: Long = 0        // 当前分配指针
    var totalSize: Long = 0         // 总大小
    var capacity: Long = 0          // 容量
    var usedSize: Long = 0          // 已使用大小

    /// 初始化分配器
    fun init(size: Long): Boolean {
        // PROT_READ=1, PROT_WRITE=2, PROT_READ|PROT_WRITE=3
        // MAP_PRIVATE=2, MAP_ANONYMOUS=0x20=32, MAP_PRIVATE|MAP_ANONYMOUS=34
        this.baseAddr = Memory.mmap(0, size, 3, 34, -1, 0)
        // MAP_FAILED = -1 (0xFFFFFFFFFFFFFFFF)
        if (this.baseAddr == -1) { return false }
        this.currentPtr = this.baseAddr
        this.totalSize = size
        this.capacity = size
        this.usedSize = 0
        return true
    }

    /// 分配内存 (对齐到 8 字节)
    fun alloc(size: Long): Long {
        val alignedSize: Long = (size + 7) / 8 * 8
        if (this.currentPtr + alignedSize > this.baseAddr + this.capacity) {
            return 0  // 内存不足
        }
        val ptr: Long = this.currentPtr
        this.currentPtr = this.currentPtr + alignedSize
        this.usedSize = this.usedSize + alignedSize
        return ptr
    }

    /// 重置分配器 (释放所有内存)
    fun reset(): Unit {
        this.currentPtr = this.baseAddr
        this.usedSize = 0
    }

    /// 释放全部内存 (返回给 OS)
    fun free(): Unit {
        if (this.baseAddr != 0) {
            Memory.munmap(this.baseAddr, this.capacity)
            this.baseAddr = 0
            this.currentPtr = 0
            this.usedSize = 0
        }
    }

    /// 获取已使用内存大小
    fun getUsedSize(): Long {
        return this.usedSize
    }

    /// 获取剩余内存大小
    fun getFreeSize(): Long {
        return this.capacity - this.usedSize
    }
}

/// 全局内存管理器
object MemoryManager {
    /// 唯一状态。
    ///
    /// ⚠️ 不要持有 `ArenaAllocator` 的**实例字段**（`val heap = ArenaAllocator()`）：
    /// `ArenaAllocator` 是 `object`（单例），其方法在 SSA 侧**不注入 `this` 形参**
    /// （见 `SsaBuilder.buildFunction`），于是 `this.heap.alloc(n)` 的接收者会被
    /// 当成第 1 个形参传进去，实参整体错位一位。直接调单例方法即可：
    /// `ArenaAllocator.alloc(n)`（与 `Mutex.lock(m)` 同形）。
    var initialized: Boolean = false

    /// 初始化全局内存管理器
    fun init(size: Long): Boolean {
        if (this.initialized) { return true }
        val result: Boolean = ArenaAllocator.init(size)
        if (result) {
            this.initialized = true
        }
        return result
    }

    /// 分配内存
    fun alloc(size: Long): Long {
        return ArenaAllocator.alloc(size)
    }

    /// 释放全部内存
    fun free(): Unit {
        ArenaAllocator.free()
        this.initialized = false
    }

    /// 重置分配器
    fun reset(): Unit {
        ArenaAllocator.reset()
    }

    /// 获取已使用内存大小
    fun getUsedSize(): Long {
        return ArenaAllocator.getUsedSize()
    }

    /// 获取剩余内存大小
    fun getFreeSize(): Long {
        return ArenaAllocator.getFreeSize()
    }
}

// ═══════════════════════════════════════════════════════════════
// MemoryUtils — 顶层辅助函数
// ═══════════════════════════════════════════════════════════════

object MemoryUtils {
    // ArenaAllocator 是全局单例，无法创建新实例。
    // 请使用 MemoryManager.alloc() 分配内存。
}