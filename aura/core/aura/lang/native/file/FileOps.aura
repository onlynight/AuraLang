// aura:///aura/lang/native/file/FileOps.aura
package aura.lang.native.file
// ------------------------------------------------------------------
// File I/O operations -- Phase S2
//
// Provides file read/write operations, wrapping syscalls.
//
// Usage:
//   val fd: Int = FileOps.open(pathAddr, O_WRONLY | O_CREAT)
//   FileOps.write(fd, bufAddr, bufLen)
//   FileOps.close(fd)
// ------------------------------------------------------------------

import aura.lang.native.Syscalls
import aura.lang.native.Memory

/// File I/O operations
extern object FileOps {

    // -- Constants --
    const val O_RDONLY: Int = 0
    const val O_WRONLY: Int = 1
    const val O_RDWR: Int = 2
    const val O_CREAT: Int = 0x40
    const val O_EXCL: Int = 0x80
    const val O_TRUNC: Int = 0x200
    const val SEEK_SET: Int = 0
    const val SEEK_CUR: Int = 1
    const val SEEK_END: Int = 2
    const val F_OK: Int = 0

    // -- Syscall declarations --
    @native(SYS_OPEN)   fun open(path: Long, flags: Int): Int
    @native(SYS_CLOSE)  fun close(fd: Int): Int
    @native(SYS_READ)   fun read(fd: Int, buf: Long, count: Long): Long
    @native(SYS_WRITE)  fun write(fd: Int, buf: Long, count: Long): Long
    @native(SYS_LSEEK)  fun lseek(fd: Int, off: Long, whence: Int): Long
    @native(SYS_FSTAT)  fun fstat(fd: Int, buf: Long): Long
    @native(SYS_UNLINK) fun unlink(path: Long): Int
    @native(SYS_ACCESS) fun access(path: Long, mode: Int): Int

    /// Open file
    fun openFile(path: Long, flags: Int): Int {
        return open(path, flags)
    }

    /// Close file
    fun closeFile(fd: Int): Int {
        return close(fd)
    }

    /// Read file
    fun readFile(fd: Int, buf: Long, count: Long): Long {
        return read(fd, buf, count)
    }

    /// Write file
    fun writeFile(fd: Int, buf: Long, count: Long): Long {
        return write(fd, buf, count)
    }

    /// Move file pointer
    fun seekFile(fd: Int, offset: Long, whence: Int): Long {
        return lseek(fd, offset, whence)
    }

    /// Get file status
    fun statFile(fd: Int, buf: Long): Long {
        return fstat(fd, buf)
    }

    /// Delete file
    fun deleteFile(path: Long): Int {
        return unlink(path)
    }

    /// Check if file exists
    fun exists(path: Long): Boolean {
        return access(path, F_OK) == 0
    }
}
