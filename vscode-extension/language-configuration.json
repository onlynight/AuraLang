{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "`", "close": "`", "notIn": ["string", "comment"] },
    { "open": "/*", "close": " */", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"],
    ["`", "`"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^.*(\\{|\\(|\\$|do|then|else|when|for|if|while|try|select|catch|finally|extern)",
    "decreaseIndentPattern": "^.*(\\}|\\))"
  },
  "folding": {
    "markers": {
      "start": "^\\s*//\\s*(@region|BEGIN)\\b",
      "end": "^\\s*//\\s*(@endregion|END)\\b"
    },
    "languageFolding": [
      {
        "start": "^\\s*(?:\\w+\\s+)*?(?:struct|class|enum|interface|actor|object|actor|sealed|data|extern)\\b.*\\{",
        "end": "^\\s*\\}",
        "startsAtFirstColumn": true,
        "nestable": true,
        "exclusive": false,
        "expansion": "none",
        "collapsed": true,
        "comment": "fold declarations: struct/class/enum/interface/actor/object/extern blocks"
      },
      {
        "start": "^\\s*(?:\\w+\\s+)*?(?:if|else|when|for|while|do|try|catch|finally|select)\\b.*\\{",
        "end": "^\\s*\\}",
        "startsAtFirstColumn": true,
        "nestable": true,
        "exclusive": false,
        "expansion": "none",
        "collapsed": true,
        "comment": "fold control flow blocks: if/else/when/for/while/do/try/catch/finally/select"
      },
      {
        "start": "^\\s*(?:\\w+\\s+)*?fun\\b.*\\{",
        "end": "^\\s*\\}",
        "startsAtFirstColumn": true,
        "nestable": true,
        "exclusive": false,
        "expansion": "none",
        "collapsed": true,
        "comment": "fold function bodies"
      }
    ]
  },
  "wordPattern": "(-?\\d+\\.\\d*|[a-zA-Z_$][\\w$]*)",
  "onEnterRules": [
    {
      "beforeText": "^\\s*//\\s*[^*/].*$",
      "action": { "indent": "indent", "removeTrailingWhitespace": true }
    },
    {
      "beforeText": "^\\s*//\\s*/\\*(?!/)([^\\*]|\\*(?!/))*$",
      "afterText": "^\\s*\\*/\\s*$",
      "action": { "indent": "indent", "removeTrailingWhitespace": true }
    },
    {
      "beforeText": "^\\s*//\\s*/\\*(?!/)([^\\*]|\\*(?!/))+$",
      "action": { "indent": "none" }
    }
  ]
}
