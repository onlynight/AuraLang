// aura:///aura/lang/std/Builtin.aura
// 标准库模块，不可修改
// 实现：Rust 原生函数 + Aura 扩展方法
// (package 声明由编译器自动注入，无需显式声明)
/// 编译期内置函数模块。
///
/// 使用前需 import：
/// ```aura
/// import aura.builtin.*
/// ```
///
/// @since 0.1
internal object Builtin {

    // ── 类型查询（Rust native 实现，Layer 1 不能上移）──

    /// 返回值的类型名称（"Int"/"Float"/"String"/"Boolean"/"List"/"Map"/"Null"）。
    fun typeof(value: Any): String

    /// 返回值的类型名称（`typeof` 别名）。
    fun typeOf(value: Any): String

    // ── 空值检查（Rust native 实现，Layer 1 不能上移）──

    /// 检查值是否为 null。
    fun isNull(value: Any): Boolean

    /// 检查值是否不为 null。
    fun isNotNull(value: Any): Boolean

    // ── 数值检查（Rust native 实现，Layer 1 不能上移）──

    /// 检查数值是否为零。
    fun isZero(value: Any): Boolean

    /// 检查数值是否为正。
    fun isPositive(value: Any): Boolean

    /// 检查数值是否为负。
    fun isNegative(value: Any): Boolean

    // ── 类型转换（Aura 实现，Layer 1 扩展方法）──

    /// 转换为字符串。
    /// 实现：Rust native（toString 是 Any 核心虚方法，不能上移）
    fun toString(value: Any): String

    /// 转换为整数。
    ///
    /// - Int/Long/Byte/Short → 原值
    /// - Float/Double → 截断取整
    /// - Boolean → true=1, false=0
    /// - String → 解析为整数（失败返回 0）
    /// - Null/其他 → 0
    ///
    /// ```aura
    /// val x = toInt(3.14)    // 3
    /// val y = toInt("42")    // 42
    /// val z = toInt(true)    // 1
    /// ```
    fun toInt(value: Any): Int {
        when {
            isNull(value) → 0
            typeof(value) == "Int" → value
            typeof(value) == "Long" → value
            typeof(value) == "Byte" → value
            typeof(value) == "Short" → value
            typeof(value) == "Float" || typeof(value) == "Double" → (value as Float).toInt()
            typeof(value) == "Boolean" → if (value) 1 else 0
            typeof(value) == "String" → parseStringToInt(value)
            else → 0
        }
    }

    /// 转换为浮点数。
    ///
    /// - Float/Double → 原值
    /// - Int/Long/Byte/Short → 转为浮点
    /// - Boolean → true=1.0, false=0.0
    /// - String → 解析为浮点数（失败返回 0.0）
    /// - Null/其他 → 0.0
    ///
    /// ```aura
    /// val x = toFloat(3)     // 3.0
    /// val y = toFloat("4.2") // 4.2
    /// val z = toFloat(true)  // 1.0
    /// ```
    fun toFloat(value: Any): Float {
        when {
            isNull(value) → 0.0
            typeof(value) == "Float" || typeof(value) == "Double" → value
            typeof(value) == "Int" → (value as Int).toFloat()
            typeof(value) == "Long" → (value as Long).toFloat()
            typeof(value) == "Byte" → (value as Byte).toFloat()
            typeof(value) == "Short" → (value as Short).toFloat()
            typeof(value) == "Boolean" → if (value) 1.0 else 0.0
            typeof(value) == "String" → parseStringToFloat(value)
            else → 0.0
        }
    }

    /// 转换为字符串（toString 别名）。
    ///
    /// ```aura
    /// val x = toStr(42)       // "42"
    /// val y = toStr(3.14)     // "3.14"
    /// val z = toStr(true)     // "true"
    /// ```
    fun toStr(value: Any): String {
        return toString(value)
    }

    /// 转换为布尔值。
    ///
    /// - Boolean → 原值
    /// - Int/Long → 0=false, 非0=true
    /// - Float/Double → 0.0=false, 非0=true
    /// - String → 空串或"false"=false, 其他=true
    /// - Null → false
    ///
    /// ```aura
    /// val x = toBool(1)       // true
    /// val y = toBool(0)       // false
    /// val z = toBool("true")  // true
    /// ```
    fun toBool(value: Any): Boolean {
        when {
            isNull(value) → false
            typeof(value) == "Boolean" → value
            typeof(value) == "Int" || typeof(value) == "Long" → value != 0
            typeof(value) == "Float" || typeof(value) == "Double" → value != 0.0
            typeof(value) == "String" → (value as String) != "" && (value as String) != "false"
            else → true
        }
    }

    // ── 大小与哈希（Rust native 实现，Layer 1 不能上移）──

    /// 获取值的运行时大小（字节）。
    fun sizeOf(value: Any): Int

    /// 计算值的哈希码。
    fun hash(value: Any): Int

    // ── 比较与克隆（Rust native 实现，Layer 1 不能上移）──

    /// 比较两个值，返回 -1/0/1。
    fun compare(a: Any, b: Any): Int

    /// 克隆值（深拷贝）。
    fun clone(value: Any): Any

    /// 恒等函数（返回输入值本身）。
    fun identity(value: Any): Any

    // ── 类型内省高级功能（Aura 实现，Layer 1 扩展方法）──

    /// 获取类型的继承链（从当前类型到 Any）。
    ///
    /// ```aura
    /// val hierarchy = typeHierarchy("Int")  // ["Int", "Number", "Any"]
    /// ```
    fun typeHierarchy(typeName: String): List<String> {
        // 简单的继承链实现
        // 实际实现需要类型系统支持
        val result: List<String> = Collections.emptyList()
        result.add(typeName)
        if (typeName != "Any") {
            result.add("Any")
        }
        return result
    }

    /// 检查 child 类型是否是 parent 类型的子类型。
    ///
    /// ```aura
    /// val isSub = isSubtype("Int", "Number")  // true
    /// val isSame = isSubtype("Int", "Int")    // true
    /// ```
    fun isSubtype(child: String, parent: String): Boolean {
        if (child == parent) return true
        // 简单的子类型检查
        // 实际实现需要类型系统支持
        val hierarchy = typeHierarchy(child)
        return hierarchy.contains(parent)
    }

    /// 检查类型是否实现了指定接口。
    ///
    /// ```aura
    /// val impl = implementsInterface("Int", "Comparable")  // true
    /// ```
    fun implementsInterface(typeName: String, iface: String): Boolean {
        // 简单的接口检查
        // 实际实现需要类型系统支持
        return false
    }

    /// 获取类型的所有方法名。
    ///
    /// ```aura
    /// val methods = getAllMethods("Int")  // ["add", "sub", "toString", ...]
    /// ```
    fun getAllMethods(typeName: String): List<String> {
        // 简单的占位实现
        // 实际实现需要类型系统支持
        return Collections.emptyList()
    }

    /// 获取类型的所有字段名。
    ///
    /// ```aura
    /// val fields = getAllFields("Int")  // ["value", ...]
    /// ```
    fun getAllFields(typeName: String): List<String> {
        // 简单的占位实现
        // 实际实现需要类型系统支持
        return Collections.emptyList()
    }

    /// 获取类型的注解。
    ///
    /// ```aura
    /// val ann = getAnnotation("Int", "deprecated")  // "..."
    /// ```
    fun getAnnotation(typeName: String, name: String): String {
        // 简单的占位实现
        // 实际实现需要类型系统支持
        return ""
    }

    // ── 约束函数（Aura 实现，Layer 1 扩展方法）──

    /// 将值约束在 [min, max] 范围内。
    ///
    /// ```aura
    /// val x = clamp(15, 0, 10)  // 10
    /// val y = clamp(-5, 0, 10)  // 0
    /// val z = clamp(5, 0, 10)   // 5
    /// ```
    fun clamp(value: Any, min: Any, max: Any): Any {
        if (value < min) return min
        if (value > max) return max
        return value
    }

    // ── 辅助函数（私有）──

    /// 解析字符串为整数（辅助函数）
    private fun parseStringToInt(s: String): Int {
        // 简单的字符串转整数实现
        // 实际实现可能需要调用 Rust native 或 FFI
        val trimmed = s.trim()
        if (trimmed.isEmpty()) return 0
        
        val negative = trimmed.startsWith("-")
        val start = if (negative) 1 else 0
        var result = 0
        
        for (i in start..trimmed.length) {
            val c = trimmed[i]
            if (c >= '0' && c <= '9') {
                result = result * 10 + (c - '0')
            }
        }
        
        return if (negative) -result else result
    }

    /// 解析字符串为浮点数（辅助函数）
    private fun parseStringToFloat(s: String): Float {
        // 简单的字符串转浮点数实现
        // 实际实现可能需要调用 Rust native 或 FFI
        val trimmed = s.trim()
        if (trimmed.isEmpty()) return 0.0
        
        val negative = trimmed.startsWith("-")
        val start = if (negative) 1 else 0
        
        var intPart = 0
        var floatPart = 0.0
        var decimalPlace = 1.0
        var hasDecimal = false
        
        for (i in start..trimmed.length) {
            val c = trimmed[i]
            if (c == '.') {
                hasDecimal = true
            } else if (c >= '0' && c <= '9') {
                if (hasDecimal) {
                    floatPart = floatPart * 10.0 + (c - '0')
                    decimalPlace *= 10.0
                } else {
                    intPart = intPart * 10 + (c - '0')
                }
            }
        }
        
        var result = (intPart as Float) + (floatPart / decimalPlace)
        return if (negative) -result else result
    }
}