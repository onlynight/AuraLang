// aura:///aura/lang/std/Path.aura
// 标准库模块，不可修改
// 实现：纯逻辑函数用 Aura 实现，syscall 函数用 Rust native
// (package 声明由编译器自动注入，无需显式声明)
/// 路径操作模块。
///
/// 使用前需 import：
/// ```aura
/// import aura.path.*
/// ```
///
/// @since 0.1
internal object Path {

    // ── 拼接与分割（纯逻辑，Aura 实现）──

    /// 拼接多个路径片段。
    fun join(vararg parts: String): String {
        var result: String = ""
        var i: Int = 0
        while i < parts.size {
            if i > 0 then {
                result = result + "/" + parts[i]
            } else {
                result = parts[i]
            }
            i = i + 1
        }
        return result
    }

    /// 获取目录部分。
    fun dirname(path: String): String {
        if path == "" then return ""
        var lastSlash: Int = -1
        var i: Int = 0
        while i < path.length {
            if path[i] == "/" then lastSlash = i
            i = i + 1
        }
        if lastSlash == -1 then return "."
        if lastSlash == 0 then return "/"
        return path.substring(0, lastSlash)
    }

    /// 获取文件名部分（不含扩展名）。
    fun basename(path: String): String {
        var dir: String = dirname(path)
        if dir == "." then return path
        var name: String = path.substring(dir.length + 1, path.length)
        var lastDot: Int = -1
        var i: Int = 0
        while i < name.length {
            if name[i] == "." then lastDot = i
            i = i + 1
        }
        if lastDot == -1 then return name
        return name.substring(0, lastDot)
    }

    /// 获取扩展名。
    fun extname(path: String): String {
        var lastSlash: Int = -1
        var lastDot: Int = -1
        var i: Int = 0
        while i < path.length {
            if path[i] == "/" then lastSlash = i
            if path[i] == "." and i > lastSlash then lastDot = i
            i = i + 1
        }
        if lastDot == -1 or lastDot == path.length - 1 then return ""
        return path.substring(lastDot, path.length)
    }

    /// 分割路径为列表。
    fun split(path: String): List<String> {
        return String.split(path, "/")
    }

    // ── 规范化（纯逻辑，Aura 实现）──

    /// 规范化路径（处理 "." 和 ".."）。
    fun normalize(path: String): String {
        var parts: List<String> = split(path)
        var normalized: List<String> = Collections.emptyList()
        for part in parts {
            if part == "." or part == "" then continue
            if part == ".." then {
                if normalized.size > 0 then normalized.remove(normalized.size - 1)
            } else {
                normalized.add(part)
            }
        }
        return join(normalized)
    }

    /// 检查是否为绝对路径。
    fun isAbsolute(path: String): Boolean {
        if path.length == 0 then return false
        return path[0] == "/"
    }

    /// 检查是否为相对路径。
    fun isRelative(path: String): Boolean {
        return !isAbsolute(path)
    }

    // ── 分隔符 ──

    /// 路径分隔符。
    val separators: String = "/"

    // ── 平台转换（纯逻辑，Aura 实现）──

    /// Unix 路径转 Windows 路径。
    fun fromUnix(path: String): String {
        return String.replace(path, "/", "\\")
    }

    /// Windows 路径转 Unix 路径。
    fun fromWindows(path: String): String {
        return String.replace(path, "\\", "/")
    }

    // ── 系统相关（Rust native 实现）──

    /// 获取相对路径。
    fun relative(path: String, from: String): String

    /// 解析绝对路径。
    fun resolve(path: String): String
}
