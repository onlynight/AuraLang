// aura:///aura/lang/std/Encoding.aura
// 标准库模块，不可修改
// 实现：纯逻辑函数用 Aura 实现
// (package 声明由编译器自动注入，无需显式声明)
/// 编码与解码模块。
///
/// 使用前需 import：
/// ```aura
/// import aura.encoding.*
/// ```
///
/// @since 0.1
internal object Encoding {

    // ── Base64（纯逻辑，Aura 实现）──

    private const BASE64_CHARS: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

    /// Base64 编码。
    fun base64Encode(text: String): String {
        var result: String = ""
        var i: Int = 0
        while i < text.length {
            var b1: Int = text.charCodeAt(i)
            var b2: Int = if i + 1 < text.length then text.charCodeAt(i + 1) else 0
            var b3: Int = if i + 2 < text.length then text.charCodeAt(i + 2) else 0
            var triplet: Int = (b1 << 16) | (b2 << 8) | b3
            result = result + BASE64_CHARS.charAt((triplet >> 18) & 0x3F)
            result = result + BASE64_CHARS.charAt((triplet >> 12) & 0x3F)
            if i + 1 < text.length then {
                result = result + BASE64_CHARS.charAt((triplet >> 6) & 0x3F)
            } else {
                result = result + "="
            }
            if i + 2 < text.length then {
                result = result + BASE64_CHARS.charAt(triplet & 0x3F)
            } else {
                result = result + "="
            }
            i = i + 3
        }
        return result
    }

    /// Base64 解码。
    fun base64Decode(text: String): String {
        var result: String = ""
        var i: Int = 0
        while i < text.length {
            if text[i] == "=" then i = i + 1
            var b1: Int = BASE64_CHARS.indexOf(text[i])
            if b1 == -1 then i = i + 1
            if i + 1 >= text.length or text[i + 1] == "=" then {
                result = result + String.fromCharCode(b1 << 2)
                i = i + 1
            } else {
                var b2: Int = BASE64_CHARS.indexOf(text[i + 1])
                result = result + String.fromCharCode((b1 << 2) | (b2 >> 4))
                i = i + 2
                if i < text.length and text[i] != "=" then {
                    var b3: Int = BASE64_CHARS.indexOf(text[i])
                    result = result + String.fromCharCode((b2 << 4) | (b3 >> 2))
                    i = i + 1
                    if i < text.length and text[i] != "=" then {
                        var b4: Int = BASE64_CHARS.indexOf(text[i])
                        result = result + String.fromCharCode((b3 << 6) | b4)
                        i = i + 1
                    }
                }
            }
        }
        return result
    }

    // ── Hex（纯逻辑，Aura 实现）──

    private const HEX_CHARS: String = "0123456789abcdef"

    /// 十六进制编码。
    fun hexEncode(text: String): String {
        var result: String = ""
        var i: Int = 0
        while i < text.length {
            var c: Int = text.charCodeAt(i)
            result = result + HEX_CHARS.charAt((c >> 4) & 0x0F)
            result = result + HEX_CHARS.charAt(c & 0x0F)
            i = i + 1
        }
        return result
    }

    /// 十六进制解码。
    fun hexDecode(text: String): String {
        var result: String = ""
        var i: Int = 0
        while i < text.length {
            var hi: Int = hexCharToValue(text[i])
            var lo: Int = hexCharToValue(text[i + 1])
            result = result + String.fromCharCode((hi << 4) | lo)
            i = i + 2
        }
        return result
    }

    private fun hexCharToValue(c: String): Int {
        if c >= "0" and c <= "9" then return c.charCodeAt(0) - "0".charCodeAt(0)
        if c >= "a" and c <= "f" then return c.charCodeAt(0) - "a".charCodeAt(0) + 10
        if c >= "A" and c <= "F" then return c.charCodeAt(0) - "A".charCodeAt(0) + 10
        return 0
    }

    // ── URL（纯逻辑，Aura 实现）──

    /// URL 编码。
    fun urlEncode(text: String): String {
        var result: String = ""
        var i: Int = 0
        while i < text.length {
            var c: String = text[i]
            if c >= "A" and c <= "Z" or c >= "a" and c <= "z" or c >= "0" and c <= "9" or c == "-" or c == "_" or c == "." then {
                result = result + c
            } else if c == " " then {
                result = result + "+"
            } else {
                result = result + "%" + hexEncode(c).toUpperCase()
            }
            i = i + 1
        }
        return result
    }

    /// URL 解码。
    fun urlDecode(text: String): String {
        var result: String = ""
        var i: Int = 0
        while i < text.length {
            if text[i] == "%" then {
                result = result + hexDecode(text.substring(i + 1, i + 3))
                i = i + 3
            } else if text[i] == "+" then {
                result = result + " "
                i = i + 1
            } else {
                result = result + text[i]
                i = i + 1
            }
        }
        return result
    }

    // ── 字节与十六进制（Rust native 实现）──

    /// 字节转十六进制字符串。
    fun byteToHex(byte: Byte): String {
        return HEX_CHARS.charAt((byte & 0xF0) >> 4) + HEX_CHARS.charAt(byte & 0x0F)
    }

    /// 十六进制字符串转字节。
    fun hexToByte(hex: String): Byte {
        var hi: Int = hexCharToValue(hex[0])
        var lo: Int = hexCharToValue(hex[1])
        return ((hi << 4) | lo).toByte()
    }
}
