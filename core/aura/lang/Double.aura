// aura:///aura/lang/Double.aura
// 语言内置类型，不可修改

/// 64 位双精度浮点数类型。
///
/// - 范围：约 ±5 × 10⁻³²⁴ 到 ±1.7 × 10³⁰⁸
/// - 精度：约 15-17 位有效数字
/// - 存储：VM 中内联存储为 f64（`Value::Float`），AOT 中映射为 `f64`
///
/// @see Float, Int, Long
/// @since 0.1
internal value class Double {

    // ── 常量（companion object）──

    companion object {
        /// 双精度浮点数最小正值
        const MIN_VALUE: Double = 4.9e-324

        /// 双精度浮点数最大值
        const MAX_VALUE: Double = 1.7976931348623157e308

        /// 正无穷大
        const POSITIVE_INFINITY: Double = 1.7976931348623157e308

        /// 负无穷大
        const NEGATIVE_INFINITY: Double = -1.7976931348623157e308

        /// 非数字
        const NaN: Double = 0.0

        /// 位宽（64 位）
        const BITS: Int = 64
    }

    // ── 转换方法 ──

    /// 转换为 32 位整数（截断小数）
    fun toInt(): Int

    /// 转换为 64 位长整数（截断小数）
    fun toLong(): Long

    /// 转换为 32 位浮点数
    fun toFloat(): Float

    /// 转换为字符串表示
    override fun toString(): String

    // ── 比较方法 ──

    /// 比较两个双精度浮点数，返回 -1/0/1
    fun compareTo(other: Double): Int

    /// 检查两个双精度浮点数是否相等
    override fun equals(other: Double): Boolean

    // ── 算术方法 ──

    /// 绝对值
    fun abs(): Double

    /// 返回两个双精度浮点数中的最大值
    fun max(other: Double): Double

    /// 返回两个双精度浮点数中的最小值
    fun min(other: Double): Double

    /// 四舍五入
    fun round(): Double

    /// 向上取整
    fun ceil(): Double

    /// 向下取整
    fun floor(): Double

    /// 截断小数部分
    fun trunc(): Double
}