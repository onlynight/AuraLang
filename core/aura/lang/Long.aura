// aura:///aura/lang/Long.aura
// 语言内置类型，不可修改

/// 64 位有符号长整数类型。
///
/// - 范围：-9,223,372,036,854,775,808 到 9,223,372,036,854,775,807
/// - 存储：VM 中内联存储为 i64（`Value::Int`），AOT 中映射为 `i64`
/// - 字面量：以 `L` 或 `l` 后缀标识（如 `42L`）
///
/// @see Int, Float, Double
/// @since 0.1
internal value class Long {

    // ── 常量（companion object）──

    companion object {
        /// 64 位长整数最小值
        const MIN_VALUE: Long = -9223372036854775808L

        /// 64 位长整数最大值
        const MAX_VALUE: Long = 9223372036854775807L

        /// 位宽（64 位）
        const BITS: Long = 64

        /// 字节大小（8 字节）
        const SIZE: Long = 64
    }

    // ── 转换方法 ──

    /// 转换为 32 位整数
    fun toInt(): Int

    /// 转换为 32 位浮点数
    fun toFloat(): Float

    /// 转换为 64 位双精度浮点数
    fun toDouble(): Double

    /// 转换为字符串表示
    override fun toString(): String

    /// 转换为布尔值（非零为 true）
    fun toBoolean(): Boolean

    // ── 比较方法 ──

    /// 比较两个长整数，返回 -1/0/1
    fun compareTo(other: Long): Long

    /// 检查两个长整数是否相等
    override fun equals(other: Long): Boolean

    // ── 算术方法 ──

    /// 绝对值
    fun abs(): Long

    /// 返回两个长整数中的最大值
    fun max(other: Long): Long

    /// 返回两个长整数中的最小值
    fun min(other: Long): Long

    /// 取余
    fun mod(other: Long): Long

    // ── 位操作方法 ──

    /// 按位与
    fun and(other: Long): Long

    /// 按位或
    fun or(other: Long): Long

    /// 按位异或
    fun xor(other: Long): Long

    /// 左移
    fun shl(bits: Int): Long

    /// 右移（算术右移）
    fun shr(bits: Int): Long

    /// 无符号右移
    fun ushr(bits: Int): Long

    // ── 数学方法 ──

    /// 计算幂
    fun pow(exp: Long): Long
}