// aura:///aura/lang/Short.aura
// 语言内置类型，不可修改

/// 16 位有符号短整型。
///
/// - 范围：-32,768 到 32,767
/// - 存储：VM 中内联存储为 i64（`Value::Int`）
///
/// @see Int, Long, Byte
/// @since 0.1
internal value class Short {

    // ── 常量（companion object）──

    companion object {
        /// 16 位短整型最小值
        const MIN_VALUE: Short = -32768

        /// 16 位短整型最大值
        const MAX_VALUE: Short = 32767

        /// 位宽（16 位）
        const BITS: Int = 16
    }

    // ── 转换方法 ──

    /// 转换为 32 位整数
    fun toInt(): Int

    /// 转换为 64 位长整数
    fun toLong(): Long

    /// 转换为 32 位浮点数
    fun toFloat(): Float

    /// 转换为字符串表示
    override fun toString(): String

    // ── 比较方法 ──

    /// 比较两个短整型，返回 -1/0/1
    fun compareTo(other: Short): Int

    /// 检查两个短整型是否相等
    override fun equals(other: Short): Boolean

    // ── 算术方法 ──

    /// 绝对值
    fun abs(): Short

    /// 取余
    fun mod(other: Short): Short
}