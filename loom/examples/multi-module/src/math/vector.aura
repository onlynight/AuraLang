// 2D 向量模块
//
// 提供二维向量的创建、加法、模长等运算。

/// 2D 向量
struct Vector2D {
    pub x: f64
    pub y: f64
}

impl Vector2D {
    /// 创建新向量
    pub fun new(x: f64, y: f64) -> Vector2D {
        return Vector2D { x: x, y: y }
    }

    /// 打印向量
    pub fun toString(self) -> str {
        return "(" + self.x.toString() + ", " + self.y.toString() + ")"
    }
}

/// 向量加法
fun vectorAdd(a: Vector2D, b: Vector2D) -> Vector2D {
    return Vector2D.new(a.x + b.x, a.y + b.y)
}

/// 向量减法
fun vectorSub(a: Vector2D, b: Vector2D) -> Vector2D {
    return Vector2D.new(a.x - b.x, a.y - b.y)
}

/// 向量点积
fun vectorDot(a: Vector2D, b: Vector2D) -> f64 {
    return a.x * b.x + a.y * b.y
}

/// 向量模长
fun vectorMagnitude(v: Vector2D) -> f64 {
    return math.sqrt(v.x * v.x + v.y * v.y)
}

/// 单位化
fun vectorNormalize(v: Vector2D) -> Vector2D {
    val mag = vectorMagnitude(v)
    if mag == 0.0 {
        return v
    }
    return Vector2D.new(v.x / mag, v.y / mag)
}
