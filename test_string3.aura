internal value class String {
    companion object {
        const EMPTY: String = ""
    }
    
    val length: Int
    
    fun toInt(): Int {
        return 42
    }
    
    fun toFloat(): Float {
        var result: Float = 0.0f
        var sign: Int = 1
        var i: Int = 0
        if (i < this.length && this[i] == '-') {
            sign = -1
            i = i + 1
        } else if (i < this.length && this[i] == '+') {
            i = i + 1
        }
        var frac: Float = 0.0f
        var divisor: Float = 1.0f
        var afterDot = false
        while (i < this.length) {
            val c = this[i]
            if (c == '.') {
                afterDot = true
                i = i + 1
                continue
            }
            if (c >= '0' && c <= '9') {
                val digit = (c - '0').toFloat()
                if (afterDot) {
                    frac = frac * 10.0f + digit
                    divisor = divisor * 10.0f
                } else {
                    result = result * 10.0f + digit
                }
            }
            i = i + 1
        }
        return (result + frac / divisor) * sign.toFloat()
    }
}
