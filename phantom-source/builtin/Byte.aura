// aura://builtin/Byte.aura
// 语言内置类型，不可修改

/// 8 位有符号字节类型。
///
/// - 范围：-128 到 127
/// - 存储：VM 中内联存储为 i64（`Value::Int`）
///
/// @see Int, Long, Short
/// @since 0.1
internal value class Byte {

    // ── 常量（companion object）──

    companion object {
        /// 8 位字节最小值
        const MIN_VALUE: Byte = -128

        /// 8 位字节最大值
        const MAX_VALUE: Byte = 127

        /// 位宽（8 位）
        const BITS: Int = 8
    }

    // ── 转换方法 ──

    /// 转换为 32 位整数
    fun toInt(): Int

    /// 转换为 64 位长整数
    fun toLong(): Long

    /// 转换为 32 位浮点数
    fun toFloat(): Float

    /// 转换为字符串表示
    override fun toString(): String

    // ── 比较方法 ──

    /// 比较两个字节，返回 -1/0/1
    fun compareTo(other: Byte): Int

    /// 检查两个字节是否相等
    override fun equals(other: Byte): Boolean

    // ── 算术方法 ──

    /// 绝对值
    fun abs(): Byte
}
