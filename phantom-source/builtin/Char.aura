// aura://builtin/Char.aura
// 语言内置类型，不可修改

/// Unicode 字符类型。
///
/// - 范围：U+0000 到 U+10FFFF（Unicode 基本多文种平面 + 扩展平面）
/// - 存储：VM 中为 `Value::Str(Rc<str>)`（单字符字符串）
/// - 字面量：以单引号标识（如 `'A'`, `'中'`）
/// - 转义：`'\n'`, `'\t'`, `'\''`, `'\\'`, `'\uXXXX'`
///
/// @see String, Int
/// @since 0.1
internal value class Char {

    // ── 转换方法 ──

    /// 转换为字符串
    override fun toString(): String

    /// 转换为 Unicode 码点（Int）
    fun toInt(): Int

    /// 转换为大写
    fun toUpperCase(): Char

    /// 转换为小写
    fun toLowerCase(): Char

    // ── 判断方法 ──

    /// 检查是否为字母
    fun isAlpha(): Boolean

    /// 检查是否为数字
    fun isDigit(): Boolean

    /// 检查是否为字母或数字
    fun isAlphaNumeric(): Boolean

    /// 检查是否为空白字符
    fun isWhitespace(): Boolean

    /// 检查是否为大写字母
    fun isUpper(): Boolean

    /// 检查是否为小写字母
    fun isLower(): Boolean
}
