// aura://builtin/Function.aura
// 语言内置类型，不可修改

/// 函数类型——表示函数签名。
///
/// 函数类型语法：`(参数类型...) -> 返回类型`
///
/// 例：
/// ```aura
/// val add: (Int, Int) -> Int = { a, b -> a + b }
/// val predicate: (Int) -> Boolean = { x -> x > 0 }
/// val unit: () -> Unit = { -> println("hello") }
/// ```
///
/// 函数类型可以作为函数参数、返回值和属性类型。
/// 函数是一等公民——可以赋值、传递、存储。
///
/// @see Type
/// @since 0.1
internal open class Function {

    // ── 调用方法 ──

    /// 调用函数（无参数，无返回值）
    open fun invoke(): Unit

    /// 调用函数（1 个参数，无返回值）
    open fun invoke(p1: Any): Unit

    /// 调用函数（2 个参数，无返回值）
    open fun invoke(p1: Any, p2: Any): Unit

    /// 调用函数（3 个参数，无返回值）
    open fun invoke(p1: Any, p2: Any, p3: Any): Unit

    /// 调用函数（4 个参数，无返回值）
    open fun invoke(p1: Any, p2: Any, p3: Any, p4: Any): Unit

    // ── 链式操作 ──

    /// 组合两个函数：先执行 this，再执行 other
    fun <T> andThen(other: (T) -> T): (Any) -> Any

    /// 反转组合：先执行 other，再执行 this
    fun <T> compose(other: (T) -> T): (Any) -> Any

    // ── 信息（重写 Any 基类方法）──

    /// 获取函数的参数数量
    open fun arity(): Int

    /// 返回函数的可读表示
    override fun toString(): String

    /// 函数身份相等
    override fun equals(other: Any): Boolean

    /// 基于身份的哈希码
    override fun hashCode(): Int

    // ── 常见函数类型别名 ──

    companion object {
        /// 无参数无返回值
        val Unit: () -> Unit

        /// 单参数无返回值（Consumer）
        val Consumer: (Any) -> Unit

        /// 单参数返回 Boolean（Predicate）
        val Predicate: (Any) -> Boolean

        /// 双参数返回 Boolean（BiPredicate）
        val BiPredicate: (Any, Any) -> Boolean

        /// 单参数转换（Function1）
        val Function1: (Any) -> Any

        /// 双参数转换（Function2）
        val Function2: (Any, Any) -> Any
    }
}
