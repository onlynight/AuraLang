// aura://stdlib/aura/math/Math.aura
// 标准库模块，不可修改
// 实现：Rust 原生函数（compiler/src/std/std_math.rs）
// (package 声明由编译器自动注入，无需显式声明)
/// 数学函数与常量模块。
///
/// 使用前需 import：
/// ```aura
/// import aura.math.*
/// ```
///
/// 部分函数也在 prelu 中可用（免 import）：`abs`, `sqrt`, `pow`
///
/// @since 0.1
internal object Math {

    // ── 常量 ──

    /// 圆周率 π
    const PI: Float = 3.14159265f

    /// 自然常数 e
    const E: Float = 2.71828182f

    /// 32 位整数最大值
    const INT_MAX: Int = 2147483647

    /// 32 位整数最小值
    const INT_MIN: Int = -2147483648

    /// 浮点数最大值
    const FLOAT_MAX: Float = 3.4028235e38f

    // ── 基础运算 ──

    /// 返回绝对值。
    ///
    /// 注意：`abs(Int.MIN_VALUE)` 溢出为 `Int.MIN_VALUE` 本身。
    fun abs(x: Int): Int
    fun abs(x: Float): Float

    /// 返回最小值。
    fun min(a: Int, b: Int): Int
    fun min(a: Float, b: Float): Float

    /// 返回最大值。
    fun max(a: Int, b: Int): Int
    fun max(a: Float, b: Float): Float

    // ── 取整 ──

    /// 向上取整。
    fun ceil(x: Float): Float

    /// 向下取整。
    fun floor(x: Float): Float

    /// 四舍五入。
    fun round(x: Float): Float

    /// 截断小数部分。
    fun trunc(x: Float): Float

    // ── 幂与根 ──

    /// 平方根。
    fun sqrt(x: Float): Float

    /// 立方根。
    fun cbrt(x: Float): Float

    /// 幂运算 x^y。
    fun pow(base: Float, exp: Float): Float

    // ── 指数与对数 ──

    /// e 的 x 次方。
    fun exp(x: Float): Float

    /// 自然对数。
    fun log(x: Float): Float

    /// 以 2 为底的对数。
    fun log2(x: Float): Float

    /// 以 10 为底的对数。
    fun log10(x: Float): Float

    // ── 三角函数 ──

    /// 正弦（弧度）。
    fun sin(x: Float): Float

    /// 余弦（弧度）。
    fun cos(x: Float): Float

    /// 正切（弧度）。
    fun tan(x: Float): Float

    /// 反正弦（返回弧度）。
    fun asin(x: Float): Float

    /// 反余弦（返回弧度）。
    fun acos(x: Float): Float

    /// 反正切（返回弧度）。
    fun atan(x: Float): Float

    /// 反反正切 atan2(y, x)（返回弧度）。
    fun atan2(y: Float, x: Float): Float

    // ── 辅助 ──

    /// 符号函数：-1, 0, 1。
    fun sign(x: Float): Float

    /// 限制在 [min, max> 范围内。
    fun clamp(x: Float, min: Float, max: Float): Float
}
