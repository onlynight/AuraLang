// aura://stdlib/aura/builtin/Builtin.aura
// 标准库模块，不可修改
// 实现：Rust 原生函数（compiler/src/std/std_builtin.rs）
// (package 声明由编译器自动注入，无需显式声明)
/// 编译期内置函数模块。
///
/// 使用前需 import：
/// ```aura
/// import aura.builtin.*
/// ```
///
/// @since 0.1
internal object Builtin {

    // ── 类型查询 ──

    /// 返回值的类型名称（"Int"/"Float"/"String"/"Boolean"/"List"/"Map"/"Null"）。
    fun typeof(value: Any): String

    /// 返回值的类型名称（`typeof` 别名）。
    fun typeOf(value: Any): String

    // ── 空值检查 ──

    /// 检查值是否为 null。
    fun isNull(value: Any): Boolean

    /// 检查值是否不为 null。
    fun isNotNull(value: Any): Boolean

    // ── 数值检查 ──

    /// 检查数值是否为零。
    fun isZero(value: Any): Boolean

    /// 检查数值是否为正。
    fun isPositive(value: Any): Boolean

    /// 检查数值是否为负。
    fun isNegative(value: Any): Boolean

    // ── 类型转换 ──

    /// 转换为字符串。
    fun toString(value: Any): String

    /// 转换为整数。
    fun toInt(value: Any): Int

    /// 转换为浮点数。
    fun toFloat(value: Any): Float

    /// 转换为布谷值。
    fun toBool(value: Any): Boolean

    // ── 大小与哈希 ──

    /// 获取值的运行时大小（字节）。
    fun sizeOf(value: Any): Int

    /// 计算值的哈希码。
    fun hash(value: Any): Int

    // ── 比较与克隆 ──

    /// 比较两个值，返回 -1/0/1。
    fun compare(a: Any, b: Any): Int

    /// 克隆值（深拷贝）。
    fun clone(value: Any): Any

    /// 恒等函数（返回输入值本身）。
    fun identity(value: Any): Any
}
