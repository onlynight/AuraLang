// aura://stdlib/aura/string/String.aura
// 标准库模块，不可修改
// 实现：Rust 原生函数（compiler/src/std/std_string.rs）
// (package 声明由编译器自动注入，无需显式声明)
/// 字符串工具模块。
///
/// 使用前需 import：
/// ```aura
/// import aura.string.*
/// ```
///
/// 部分方法也在 `String` 类中可用（免 import）：`contains`, `split`
/// 本模块提供更丰富的字符串操作。
///
/// @since 0.1
internal object StringUtils {

    // ── 检查 ──

    /// 检查字符串是否包含子字符串。
    fun contains(text: String, substring: String): Boolean

    /// 检查字符串是否以指定前缀开头。
    fun startsWith(text: String, prefix: String): Boolean

    /// 检查字符串是否以指定后缀结尾。
    fun endsWith(text: String, suffix: String): Boolean

    // ── 分割与连接 ──

    /// 按分隔符分割字符串。
    fun split(text: String, separator: String): List<String>

    /// 用分隔符连接列表。
    fun join(list: List<String>, separator: String): String

    /// 按行分割字符串。
    fun splitLines(text: String): List<String>

    /// 用换行符连接列表。
    fun joinLines(list: List<String>): String

    // ── 替换与格式化 ──

    /// 替换所有匹配的子字符串。
    fun replace(text: String, target: String, replacement: String): String

    /// 正则替换所有匹配项。
    fun replaceAll(text: String, regex: String, replacement: String): String

    /// 格式化字符串（{0} {1} 占位符）。
    fun format(template: String, vararg args: Any): String

    // ── 大小写 ──

    /// 转换为小写。
    fun toLowerCase(text: String): String

    /// 转换为大写。
    fun toUpperCase(text: String): String

    // ── 修剪 ──

    /// 修剪首尾空白。
    fun trim(text: String): String

    /// 修剪开头空白。
    fun trimStart(text: String): String

    /// 修剪结尾空白。
    fun trimEnd(text: String): String

    // ── 子字符串 ──

    /// 获取子字符串 [from, to)。
    fun substring(text: String, from: Int, to: Int): String

    /// 获取分隔符前的子字符串。
    fun substringBefore(text: String, delimiter: String): String

    /// 获取分隔符后的子字符串。
    fun substringAfter(text: String, delimiter: String): String

    // ── 信息 ──

    /// 获取字符串长度。
    fun length(text: String): Int

    /// 检查是否为空字符串。
    fun isEmpty(text: String): Boolean

    /// 检查是否为空白字符串。
    fun isBlank(text: String): Boolean

    // ── 查找 ──

    /// 查找子字符串首次出现的索引（未找到返回 -1）。
    fun indexOf(text: String, substring: String): Int

    /// 查找子字符串最后出现的索引（未找到返回 -1）。
    fun lastIndexOf(text: String, substring: String): Int

    // ── 填充 ──

    /// 在开头填充字符至指定长度。
    fun padStart(text: String, length: Int, char: String): String

    /// 在结尾填充字符至指定长度。
    fun padEnd(text: String, length: Int, char: String): String

    // ── 重复 ──

    /// 重复字符串 n 次。
    fun repeat(text: String, times: Int): String

    // ── 正则 ──

    /// 检查是否匹配正则表达式。
    fun matches(text: String, regex: String): Boolean

    // ── 字符统计 ──

    /// 统计字符出现次数。
    fun countChar(text: String, char: String): Int

    /// 获取首字符。
    fun first(text: String): String

    /// 获取末字符。
    fun last(text: String): String

    // ── 转义 ──

    /// 转义特殊字符。
    fun escape(text: String): String

    /// 反转义特殊字符。
    fun unescape(text: String): String

    // ── 包含检查 ──

    /// 检查字符串是否包含任一指定字符。
    fun containsAny(text: String, chars: String): Boolean

    /// 检查字符串是否包含所有指定字符。
    fun containsAll(text: String, chars: String): Boolean
}
