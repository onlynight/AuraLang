// aura://stdlib/aura/iter/Iter.aura
// 标准库模块，不可修改
// 实现：Rust 原生函数（compiler/src/std/std_iter.rs）
// (package 声明由编译器自动注入，无需显式声明)
/// 迭代器与函数式工具模块。
///
/// 使用前需 import：
/// ```aura
/// import aura.iter.*
/// ```
///
/// @since 0.1
internal object Iter {

    // ── 聚合 ──

    /// 计算所有元素的和。
    fun sum(list: List<Any>): Any

    /// 计算所有元素的平均值。
    fun avg(list: List<Any>): Float

    /// 获取最小值。
    fun min(list: List<Any>): Any

    /// 获取最大值。
    fun max(list: List<Any>): Any

    /// 计算所有元素的积。
    fun product(list: List<Any>): Any

    // ── 查找 ──

    /// 检查列表是否包含指定元素。
    fun contains(list: List<Any>, item: Any): Boolean

    /// 查找元素的索引（未找到返回 -1）。
    fun indexOf(list: List<Any>, item: Any): Int

    /// 获取元素数量。
    fun count(list: List<Any>): Int

    // ── 全量检查 ──

    /// 检查是否所有元素都满足条件。
    fun every(list: List<Any>, predicate: (Any) -> Boolean): Boolean

    /// 检查是否存在满足条件的元素。
    fun some(list: List<Any>, predicate: (Any) -> Boolean): Boolean

    // ── 转换 ──

    /// 扁平化映射（每个元素映射为列表，然后合并）。
    fun flatMap(list: List<Any>, transform: (Any) -> List<Any>): List<Any>

    /// 与另一个列表配对。
    fun zip(list1: List<Any>, list2: List<Any>): List<Any>

    /// 解配对（将配对的列表拆分为两个列表）。
    fun unzip(paired: List<Any>): List<List<Any>>

    // ── 枚举 ──

    /// 枚举（索引 + 元素）。
    fun enumerate(list: List<Any>): List<Any>

    /// 链接多个列表。
    fun chain(vararg lists: List<Any>): List<Any>

    // ── 范围操作 ──

    /// 取前 n 个元素。
    fun take(list: List<Any>, n: Int): List<Any>

    /// 跳过前 n 个元素。
    fun skip(list: List<Any>, n: Int): List<Any>

    /// 取满足条件的元素（从头开始，遇到不满足即停止）。
    fun dropWhile(list: List<Any>, predicate: (Any) -> Boolean): List<Any>

    /// 取满足条件的元素（从头开始，遇到不满足即停止）。
    fun takeWhile(list: List<Any>, predicate: (Any) -> Boolean): List<Any>

    // ── 去重与分组 ──

    /// 获取所有不同元素。
    fun distinct(list: List<Any>): List<Any>

    /// 按分组键分组。
    fun groupBy(list: List<Any>, keySelector: (Any) -> Any): Map<Any, List<Any>>

    /// 按条件分区为两个列表。
    fun partition(list: List<Any>, predicate: (Any) -> Boolean): List<List<Any>>

    // ── 折叠与扫描 ──

    /// 折叠归约。
    fun fold(list: List<Any>, initial: Any, accumulator: (Any, Any) -> Any): Any

    /// 扫描（运行累计）。
    fun scan(list: List<Any>, initial: Any, accumulator: (Any, Any) -> Any): List<Any>

    // ── 转换 ──

    /// 转换为 Map。
    fun toMap(list: List<Any>): Map<Any, Any>

    /// 转换为列表。
    fun toList(list: List<Any>): List<Any>

    // ── 范围生成 ──

    /// 生成闭区间 [from, to> 的整数列表。
    fun range(from: Int, to: Int): List<Int>

    /// 生成半开区间 [from, to) 的整数列表。
    fun rangeTo(from: Int, to: Int): List<Int>

    /// 生成半开区间 [from, to) 的整数列表（`rangeTo` 别名）。
    fun rangeUntil(from: Int, to: Int): List<Int>

    /// 生成重复 n 次的列表。
    fun repeatN(item: Any, times: Int): List<Any>
}
