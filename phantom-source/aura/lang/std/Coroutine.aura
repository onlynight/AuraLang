// aura:///aura/lang/std/Coroutine.aura
// 协程（轻量子任务）—— 无状态对象，通过 aura.lang.std.Coroutine.<fn> 调用。
// 实现：Rust 原生函数（compiler/src/vm/coroutine.rs）
// 架构：运行库，通过 AOT FFI 直连 libc
//
// 使用前需 import：
// ```aura
// import aura.lang.std.Coroutine.*   // 短名可用：spawn, ask
// import aura.lang.std.Coroutine     // 类式调用：Coroutine.spawn(42)
// import aura.lang.std.*             // 全部 std 类作为模块别名
// ```
//
// 架构说明：
// - Layer 2（C FFI）：当前通过 Rust native 实现
// - 未来：通过 `extern "c"` 调用 aura_coroutine_yield 等运行时函数
//
// @since 0.5
internal object Coroutine {

    // ── 协程管理（通过 aura_coroutine_yield 实现）──

    /// 启动一个新协程
    ///
    /// - 参数：`body` — 要执行的代码块（返回值即协程结果）
    /// - 返回：协程句柄 ID（用于 ask 时匹配）
    ///
    /// 未来实现：通过 `extern "c" fun aura_coroutine_yield(ctx: Pointer): Unit` 调度
    ///
    /// ```aura
    /// val co = Coroutine.spawn { 42 }
    /// ```
    fun spawn(body: () -> Any): Int

    /// 阻塞等待并获取协程结果
    ///
    /// - 参数：`co_id` — spawn 返回的协程 ID
    /// - 返回：协程计算结果
    fun ask(co_id: Int): Any
}
