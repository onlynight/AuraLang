// aura:///aura/lang/std/Env.aura
// 标准库模块，不可修改
// 实现：Rust 原生函数（compiler/src/std/std_env.rs）
// (package 声明由编译器自动注入，无需显式声明)
/// 环境变量模块。
///
/// 使用前需 import：
/// ```aura
/// import aura.env.*
/// ```
///
/// @since 0.1
internal object Env {

    // ── 环境变量操作（Rust native 实现）──

    /// 获取环境变量值，不存在时返回默认值。
    fun get(name: String, default: String): String

    /// 设置环境变量。
    fun set(name: String, value: String): Unit

    /// 删除环境变量。
    fun remove(name: String): Unit

    /// 检查环境变量是否存在。
    fun has(name: String): Boolean

    // ── 环境变量列表（Rust native 实现）──

    /// 获取所有环境变量名。
    val keys: List<String>

    /// 获取所有环境变量的值。
    val values: List<String>

    /// 获取所有环境变量（键值对列表）。
    val all: List<Any>

    // ── 系统路径（Rust native 实现）──

    /// 获取用户主目录。
    val home: String

    /// 获取临时目录。
    val tmp: String

    /// 获取当前工作目录。
    val pwd: String

    // ── 平台信息（Rust native 实现）──

    /// 获取平台名称（"windows"/"linux"/"macos"）。
    val platform: String

    /// 获取操作系统名称（同 platform）。
    val os: String

    /// 获取 CPU 架构（"x86_64"/"aarch64"/"armv7"）。
    val arch: String
}
