// aura:///aura/lang/Map.aura
// 语言内置类型，不可修改

/// 键值映射类型 Map<K, V>。
///
/// - 存储：VM 中为 `Value::Map(HashMap<Value, Value>)`，AOT 中为哈希表
/// - 支持泛型：`Map<String, Int>`, `Map<Any, Any>`
/// - 字面量：`mapOf("key", value, "key2", value2)`
/// - 可变映射：使用 `mutableMapOf("key", value)`
///
/// @see List, Set
/// @since 0.1
internal value class Map<K, V> {

    // ── 构造（companion object）──

    companion object {
        /// 从可变参数创建不可变映射（交替键值参数）
        fun mapOf(vararg pairs: Any): Map<Any, Any>

        /// 从可变参数创建可变映射
        fun mutableMapOf(vararg pairs: Any): Map<Any, Any>

        /// 创建空映射
        fun emptyMap(): Map<K, V>
    }

    // ── 属性 ──

    /// 映射的条目数量
    val size: Int

    // ── 访问方法 ──

    /// 按键获取值
    fun get(key: K): V?

    /// 按键设置值（可变映射）
    fun set(key: K, value: V): Unit

    /// 检查是否包含指定键
    fun containsKey(key: K): Boolean

    /// 检查是否包含指定值
    fun containsValue(value: V): Boolean

    // ── 修改方法（可变映射）──

    /// 移除指定键，返回移除的值
    fun remove(key: K): V?

    /// 清空映射
    fun clear(): Unit

    // ── 集合操作 ──

    /// 获取所有键
    fun keys(): List<K>

    /// 获取所有值
    fun values(): List<V>

    // ── 转换 ──

    /// 转换为字符串表示
    override fun toString(): String
}